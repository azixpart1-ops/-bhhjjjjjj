{%- liquid
  assign s = section.settings
  assign columns = section.blocks.size
  if columns < 1
    assign columns = 1
  endif
-%}

{%- if section.blocks.size > 0 -%}
  {% render 'contrast-override', background_color: s.background_color, section_id: section.id %}
  <div
    class="cc-trust color-custom-{{ section.id }}"
    style="--cc-trust-columns: {{ columns }}; --cc-trust-bg: var(--color-background);"
  >
    <div class="cc-container">
      <div class="cc-trust__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign tag = 'div'
            if block.settings.link != blank
              assign tag = 'a'
            endif
          -%}
          <{{ tag }}
            class="cc-trust__item"
            {% if tag == 'a' %}href="{{ block.settings.link }}"{% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if s.show_icons -%}
              <span class="cc-trust__icon">{% render 'cc-icon', icon: block.settings.icon, size: 22 %}</span>
            {%- endif -%}
            <span class="cc-trust__label">
              {{ block.settings.title }}
              {%- if block.settings.text != blank -%}
                <span class="cc-trust__sub">{{ block.settings.text }}</span>
              {%- endif -%}
            </span>
          </{{ tag }}>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Trust strip",
  "tag": "section",
  "class": "cc-section-trust",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_icons",
      "label": "Show icons",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#fbf8f2"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust point",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Delivery" },
            { "value": "clock", "label": "Time" },
            { "value": "return", "label": "Returns" },
            { "value": "shield", "label": "Guarantee" },
            { "value": "lock", "label": "Secure" },
            { "value": "card", "label": "Payment" },
            { "value": "headset", "label": "Support" },
            { "value": "check-circle", "label": "Tick" },
            { "value": "ruler", "label": "Sizing" },
            { "value": "moon", "label": "Sleep" },
            { "value": "bed", "label": "Bed" },
            { "value": "hand", "label": "Handmade" },
            { "value": "leaf", "label": "Sustainable" },
            { "value": "award", "label": "Award" },
            { "value": "sparkle", "label": "Sparkle" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free UK delivery"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Supporting line",
          "default": "Describe the promise"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust strip",
      "category": "Conversion",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "truck",
            "title": "Free UK mainland delivery",
            "text": "Every bed, no minimum spend"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "clock",
            "title": "Dispatched in 1–4 working days",
            "text": "Tracked, with your delivery day confirmed"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "return",
            "title": "Easy 30-day returns",
            "text": "Unused and in its original packaging"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "lock",
            "title": "Secure checkout",
            "text": "Encrypted payments, UK company"
          }
        }
      ]
    }
  ]
}
{% endschema %}
