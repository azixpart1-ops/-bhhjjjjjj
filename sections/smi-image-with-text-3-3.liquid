{% comment %}#component#["settings/display-settings-2","settings/container-full_width-2","settings/heading","settings/media-settings-3","layout/grid-slider","settings/section-padding","settings/section-margin","blocks/background","settings/slider-dots-v2.with-info","settings/design-mode","settings/animation-settings","settings/image.vars","settings/slider-dots-v2","settings/image"]#endcomponent#{% endcomment %}
{% liquid
    assign object_loop =  section.blocks
    assign exclude = 'color, background'
    assign show_border = false
    assign border_style = 'none'
%}
<style>
    {% if block_color %}
    {% endif %}
    {% assign colorblock = section.blocks | where: 'type', 'color' | first %}
{% if colorblock %}
      #shopify-section-{{ section.id }},
      #shopify-section-{{ section.id }} .smi-color-{{ section.settings.color_scheme }},
      .smi-block-custom-color { 
        --color-background: {{ colorblock.settings.background_color.red }}, {{ colorblock.settings.background_color.green }},{{ colorblock.settings.background_color.blue }};
		--color-background-alpha: {{ colorblock.settings.background_color.alpha | default: 1 }};
        {% if colorblock.settings.background_gradient_color == blank %}
            --gradient-background: {{ colorblock.settings.background_color }};
        {% else %}
            --gradient-background: {{ colorblock.settings.background_gradient_color }};
        {% endif %}
		{% if colorblock.settings.heading_color != blank and colorblock.settings.heading_color != 'rgba(0,0,0,0)' %}
			--color-heading: {{ colorblock.settings.heading_color.red }}, {{ colorblock.settings.heading_color.green }},{{ colorblock.settings.heading_color.blue }};
		{% endif %}	
		--color-foreground-hex: {{ colorblock.settings.text_color }};
        --color-foreground: {{ colorblock.settings.text_color.red }}, {{ colorblock.settings.text_color.green }},{{ colorblock.settings.text_color.blue }};
		--color-subtext: {{ colorblock.settings.subtext_color.red }},{{ colorblock.settings.subtext_color.green }},{{ colorblock.settings.subtext_color.blue }};
        --color-shadow: {{ colorblock.settings.shadow_color.red }}, {{ colorblock.settings.shadow_color.green }},{{ colorblock.settings.shadow_color.blue }};
		--color-text-link: {{ colorblock.settings.link_color.red }}, {{ colorblock.settings.link_color.green }},{{ colorblock.settings.link_color.blue }};
		{% if colorblock.settings.hover_link_color != blank and colorblock.settings.hover_link_color != 'rgba(0,0,0,0)' %}
			--color-hover-link: {{ colorblock.settings.hover_link_color.red }}, {{ colorblock.settings.hover_link_color.green }},{{ colorblock.settings.hover_link_color.blue }};
		{% else %}
			--color-hover-link: {{ colorblock.settings.link_color.red }}, {{ colorblock.settings.link_color.green }},{{ colorblock.settings.link_color.blue }};
		{% endif %}			
		--color-secondary-button-text: {{ colorblock.settings.outline_button_color.red }}, {{ colorblock.settings.outline_button_color.green }},{{ colorblock.settings.outline_button_color.blue }};
		{% if colorblock.settings.outline_button_hover_color != blank and colorblock.settings.outline_button_hover_color != 'rgba(0,0,0,0)' %}
			--color-button-hover-border: {{ colorblock.settings.outline_button_hover_color.red }}, {{ colorblock.settings.outline_button_hover_color.green }},{{ colorblock.settings.outline_button_hover_color.blue }};
		{% else %}
			--color-button-hover-border: {{ colorblock.settings.outline_button_color.red }}, {{ colorblock.settings.outline_button_color.green }},{{ colorblock.settings.outline_button_color.blue }};
		{% endif %}	
    }
{% endif %}
    #shopify-section-{{ section.id }}{
        --section-padding-top: {{ section.settings.padding_top }}px;
--section-padding-bottom: {{ section.settings.padding_bottom }}px;
--section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
--section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
        --heading-alignment: {%- liquid
    case  section.settings.heading_alignment
        when 'left'
         echo 'start'
        when 'right'
         echo 'end'
        else
         echo 'center'
    endcase
-%};
		--section-margin-sides: {{ section.settings.margin_sides }}px;
--section-margin-sides-mobile: {{ section.settings.margin_sides_mobile }}px;
		{% if  section.settings.custom_width == true and section.settings.container_full_width == false %}
--page-width: {{ section.settings.section_width }}px;
{% endif %}
        --content-alignment: {{ section.settings.content_alignment }};
    }
@media screen and (max-width: 767.8px){.smi-display-settings.smi-display-desktop{display:none !important}}@media screen and (min-width: 768px){.smi-display-settings.smi-display-mobile{display:none !important}}.smi-section-image-with-text-3{overflow:hidden}.smi-section-image-with-text-3 .smi-media-wrapper:has(smi-video){transition:all .4s}.smi-section-image-with-text-3 .smi-media-wrapper:has(smi-video):hover{clip-path:polygon(var(--shape-hover))}.smi-section-image-with-text-3 .smi-media-wrapper:has(smi-video):hover smi-video *{clip-path:none !important}.smi-section-image-with-text-3 .smi-media-wrapper-image img,.smi-section-image-with-text-3 .smi-media-wrapper-image svg{aspect-ratio:var(--media-ratio)}.smi-section-image-with-text-3 .smi-text-75{opacity:.75}.smi-section-image-with-text-3 .smi-component-buttons{width:fit-content;width:100%}.smi-section-image-with-text-3 .smi-component-button-left,.smi-section-image-with-text-3 .smi-content-align-left{justify-content:left}.smi-section-image-with-text-3 .smi-component-button-center,.smi-section-image-with-text-3 .smi-content-align-center{justify-content:center;text-align:center}.smi-section-image-with-text-3 .smi-component-button-right,.smi-section-image-with-text-3 .smi-content-align-right{justify-content:right;text-align:right}.smi-section-image-with-text-3 smi-video .smi-bg-image,.smi-section-image-with-text-3 smi-video .smi-cover-image,.smi-section-image-with-text-3 smi-video .smi-upload-video,.smi-section-image-with-text-3 smi-video .smi-video-url{height:calc(100% + 6px)}
</style>
<script src="{{ 'smi-video.min.js' | asset_url }}" defer data-id="smi-video.min.js" data-section-id="smi-{{ section.id }}"></script>
<link rel="stylesheet" type="text/css" href="{{ 'smi-video.min.css' | asset_url }}" media="screen" onload="this.onload=null;this.media='all'">
<div id="smi-{{ section.id }}" class="smi-{{ section.id }} smi-display-settings smi-display-{{ section.settings.display_on }} smi-section__inner smi-gradient smi-section-image-with-text-3 smi-color-{{ section.settings.color_scheme }}" data-section="image-with-text-3" data-name="✧Image with text 3">
    
    {% liquid
    assign background_block = section.blocks | where: 'type', 'background' | first
    if background_block
      render 'smi-background'
    endif
  %}
    <div class="smi-container">
         {%-liquid
    if settings.smi_animations_reveal_on_scroll != nil
        assign animation_scroll = settings.smi_animations_reveal_on_scroll
    else
        assign global_settings = shop.metafields.smind.settings.value
        assign animation_scroll = global_settings.revealOnScroll
    endif
-%}
<div
	class="smi-heading-component smi-heading-component--align-{{ section.settings.heading_alignment }} smi-link-wrapper" {{- block.shopify_attributes -}}
	style="--heading-alignment: {{ section.settings.heading_alignment }}">
	{% liquid
		assign heading = section.settings.heading | strip
		assign sub_heading = section.settings.sub_heading | strip
		assign description = section.settings.description | strip
		assign heading_tags = section.settings.heading_tags | default:'h2'
		assign heading_size = section.settings.heading_size
	%}
	<div class="smi-heading-inner
    {%- if animation_scroll %} smi-scroll-trigger smi-animate--slide-in{% endif -%}
    {%- if heading != blank or sub_heading != blank or description != blank %} smi-mb-xxl{% endif -%}
    ">
		{%- assign sub_heading = section.settings.sub_heading | strip -%}
{%- assign sub_heading_size = blank -%}
{% if section.settings.sub_heading_size != blank %}
	{%- assign sub_heading_size = '-mb ' | append:section.settings.sub_heading_size  | prepend: section.settings.sub_heading_size -%}
{% endif %}
{% if sub_heading != blank %}
    <p class="{% if sub_heading_size != blank %}{{sub_heading_size}}{% else %}smi-text-sub{% endif %} smi-mb-xs smi-heading-component__subheading" smind-key="sub_heading" smind-attributes smind-attr-text>{{- sub_heading -}}</p>
{% endif %}
		{%- assign description = section.settings.description | strip -%}
{%- assign heading = section.settings.heading | strip -%}
{% if heading != blank %}
    <{{heading_tags}} class="{{ heading_size }} {% if description != blank %}smi-mb-sm{% endif %} smi-heading-component__heading" smind-key="heading" smind-attributes smind-attr-text>{{- heading -}}</{{heading_tags}}>
{% endif %}
		{%- assign description = section.settings.description | strip -%}
{%- assign description_size = blank -%}
{% if section.settings.description_size != blank %}
	{%- assign description_size = '-mb ' | append:section.settings.description_size  | prepend: section.settings.description_size -%}
{% endif %}
{% if description != blank %}
    <div class="{% if description_size != blank %}{{description_size}}{% else %}smi-text-md{% endif %} smi-heading-component__description smi-format-content" smind-key="description" smind-attributes smind-attr-text>{{ description }}</div>
{% endif %}
	</div>
</div>
    </div>
    {%-liquid
    if settings.smi_animations_reveal_on_scroll != nil
        assign animation_scroll = settings.smi_animations_reveal_on_scroll
    else
        assign global_settings = shop.metafields.smind.settings.value
        assign animation_scroll = global_settings.revealOnScroll
    endif
-%}
    <div class="smi-section-image-with-text-3__main {% if section.settings.enable_swipe_on_mobile == true %}smi-swipe-on-mobile{% else %}smi-grid-on-mobile{% endif %}">
        <div class="{% if section.settings.container_full_width %}smi-container-fluid{% else %}smi-container{% endif -%} {%- if animation_scroll %} smi-scroll-trigger smi-animate--slide-in smi-animate-order-1{% endif -%}">
{% liquid
  case border_style
    when 'none'
      assign border_classes = ''
    when 'content'
      assign border_classes = ' smi-content-wrapper'
    when 'blog'
      assign border_classes = ' smi-article-card-wrapper'
      if settings.smi_blog_card_style
        assign card_style = settings.smi_blog_card_style
      else
        assign global_settings = shop.metafields.smind.settings.value
        assign card_style = global_settings.blogCardStyle | default: 'standard'
      endif
      if card_style == 'standard'
        assign show_border = false
      endif
    when 'product'
      assign border_classes = ' smi-product-card-wrapper'
      if settings.smi_card_style
        assign card_style = settings.smi_card_style
      else
        assign global_settings = shop.metafields.smind.settings.value
        assign card_style = global_settings.productCardStyle | default: 'standard'
      endif
      if card_style == 'standard'
        assign show_border = false
      endif
    else
      assign border_classes = ' smi-media-wrapper'
  endcase
  if show_border == false and is_standard != false
    assign is_standard = true
  endif
  if enable_spacing_between_items == null
    assign enable_spacing_between_items = section.settings.enable_spacing_between_items
  endif
  if number_of_columns_on_desktop == null
    assign number_of_columns_on_desktop = section.settings.number_of_columns_on_desktop
  endif
  if number_of_columns_on_mobile == null
    assign number_of_columns_on_mobile = section.settings.number_of_columns_on_mobile
  endif
  if enable_swipe_on_mobile == null
    assign enable_swipe_on_mobile = section.settings.enable_swipe_on_mobile
  endif
  if show_view_all == null
    assign show_view_all = false
  endif
  unless view_all_button_style
    assign view_all_button_style = section.settings.view_all_button_style
  endunless
  unless view_all_button_link
    assign view_all_button_link = '#'
  endunless
%}
{% liquid
  unless object_limit
    assign object_limit = object_loop.size
  endunless
  if enable_spacing_between_items == false
    assign space_between_mobile = '0px'
    assign space_between_desktop = '0px'
  else
    assign space_between_mobile = 'var(--grid-mobile-horizontal-spacing)'
    assign space_between_desktop = 'var(--grid-desktop-horizontal-spacing)'
  endif
  assign slides_per_view_desktop = number_of_columns_on_desktop | times: 1 | at_least: 1
  assign slides_per_view_laptop = 3 | at_most: slides_per_view_desktop
  assign slides_per_view_tablet = 2 | at_most: slides_per_view_desktop
  assign slides_per_view_mobile = number_of_columns_on_mobile | times: 1 | at_most: object_limit | at_least: 1
  if enable_swipe_on_mobile == true
    if object_limit > slides_per_view_mobile
      assign offset_swiper_mobile = '30px'
    else
      assign offset_swiper_mobile = '0px'
    endif
  else
    assign offset_swiper_mobile = '0px'
    assign slides_per_view_mobile = number_of_columns_on_mobile | times: 1
  endif
  if object_limit == slides_per_view_mobile
    assign offset_swiper_mobile = '0px'
  endif
  assign item_mobile = slides_per_view_mobile
  assign item_tablet = slides_per_view_tablet
  assign item_desktop = slides_per_view_desktop
%}
{% liquid
    unless image_width
        assign image_width = 1600
    endunless
    unless sizes
        assign percent_item_mobile = 100 | divided_by: item_mobile | default: 100
        assign percent_item_tablet = 100 | divided_by: item_tablet | default: 100
        assign percent_item_desktop = 100 | divided_by: item_desktop | default: 100
        assign sizes = '(max-width: 767px)' | append: percent_item_mobile | append: 'vw, (max-width: 991px) ' | append: percent_item_tablet | append: 'vw, ' | append: percent_item_desktop | append: 'vw'
    endunless
%} 
<style>
  #shopify-section-{{ section.id }} {
      --space-between-mobile: {{ space_between_mobile }};
      --space-between-desktop: {{ space_between_desktop }};
      --item-width-xs: calc((100% - (({{ slides_per_view_mobile | minus: 1 }} * var(--space-between-mobile)) + var(--offset-swiper-mobile,{{ offset_swiper_mobile }})))/ {{ slides_per_view_mobile }});
      --item-width-md: calc((100% - ({{ slides_per_view_tablet | minus: 1 }} * var(--space-between-desktop)))/ {{ slides_per_view_tablet }});
      --item-width-lg: calc((100% - ({{ slides_per_view_laptop | minus: 1 }} * var(--space-between-desktop)))/ {{ slides_per_view_laptop }});
      --item-width-xl: calc((100% - ({{ slides_per_view_desktop | minus: 1 }} * var(--space-between-desktop)))/ {{ slides_per_view_desktop }});
  }
</style>
<link rel="stylesheet" type="text/css" href="{{ 'smi-layout-grid-slider.min.css' | asset_url }}" media="screen" onload="this.onload=null;this.media='all'">
<script src="{{ 'smi-slider-2.min.js' | asset_url }}" defer data-id="smi-slider-2.min.js" data-section-id="smi-{{ section.id }}"></script>
{% if enable_swipe_on_mobile == true %}
  <link rel="stylesheet" type="text/css" href="{{ 'smi-swiper-bundle-v11.min.css' | asset_url }}" media="screen" onload="this.onload=null;this.media='all'">
  <script src="{{ 'smi-swiper-bundle-v11.min.js' | asset_url }}" defer data-id="smi-swiper-bundle-v11.min.js" data-section-id="smi-{{ section.id }}"></script>
{% endif %}
<div
  class="
    {{- 'smi-layout-grid-slider smi-position-relative' -}}
    {%- if enable_swipe_on_mobile == true %} smi-swipe-on-mobile{% else %} smi-grid-on-mobile{% endif -%}
    {%- if is_standard == true %} smi-style-standard{% else %} smi-style-card{% endif -%}
    {%- liquid
            echo border_classes
            if enable_spacing_between_items == false
                echo ' smi-border-radius-0'
                if show_border == false and is_standard != false
                    echo ' smi-gap-0--standard'
                else
                    echo ' smi-gap-0'
                endif
            else
                echo ' smi-gap-1'
            endif
    -%}
    {%- if object_limit <= slides_per_view_mobile %} smi-only-one-row-xs{% endif -%}
    {%- if object_limit <= slides_per_view_tablet %} smi-only-one-row-md{% endif -%}
    {%- if object_limit <= slides_per_view_laptop %} smi-only-one-row-lg{% endif -%}
    {%- if object_limit <= slides_per_view_desktop %} smi-only-one-row-xl{% endif -%}
  "
>
  <div class="smi-swiper">
    <div class="smi-swiper-wrapper">
      {% assign shape_index = 1 %}
      {% for item in object_loop limit: object_limit %}
        {% liquid
          if exclude contains item.type
            continue
          endif
        %}
        <div
          class="smi-swiper-slide {%- unless show_border == false %} smi-border {%- if enable_spacing_between_items != false %} smi-shadow{% endif -%}{% endunless %}"
          data-swiper-slide-index="{{ forloop.index0 }}"
          {{ item.shopify_attributes }}
        >
          {%- liquid
    assign block = item
    assign author_name = block.settings.author_name | strip
    assign author_info = block.settings.author_info | strip
    assign verified_buyer = block.settings.verified_buyer
    assign nation = block.settings.nation
    assign heading = block.settings.heading | strip
    assign description = block.settings.description | strip
    assign image = block.settings.image
    assign product = block.settings.product
    assign has_product = ''
    if product != blank
      assign has_product = 'smi-has-product'
    endif
    assign img_classes = media_classes
    assign shape_index = forloop.index
  -%}
{%-liquid
    assign media_ratio = section.settings.media_ratio
    assign media_shape = section.settings.media_shape
    assign media_classes = 'smi-w-100 smi-object-fit-cover '
    if media_shape != 'default' and media_shape != 'round'
        if shape_index > 6
            assign shape_index = 1
        endif
        if shape_index < 6 
            assign forloop_next = shape_index | plus: 1
        else
            assign forloop_next = 1
        endif
        assign media_classes = media_classes | append: ' smi-shape-blob-' | append: shape_index
        assign shape_index = shape_index | plus: 1
        assign shape_hover = '--shape-blob-' | append: forloop_next
    endif
    if media_ratio == 'auto' 
        assign media_classes = media_classes | append: ' smi-h-auto'
    else
        assign media_classes = media_classes | append: ' smi-h-100 smi-p-absolute'
    endif
    assign media_wrapper_classes = 'smi-media-wrapper smi-border smi-shadow smi-lh-0 smi-overflow-hidden smi-p-relative smi-' | append: media_shape
    if media_shape contains 'blob'
        assign media_wrapper_classes = media_wrapper_classes | append: ' smi-blob-wrapper smi-has-blob'
    endif
-%}
  <div>
    {%- if block.type == 'image_block' -%}
      <div
        class="smi-item__media smi-lh-0 smi-media-wrapper smi-media-wrapper-image smi-media {{ media_wrapper_classes}} {% unless media_shape contains 'blob' %} {{ settings.smi_animations_hover_image | default: shop.metafields.smind.settings.value.imageHoverEffect | default: 'none' | prepend: ' smi-hover-image-' }}{% endunless %}"
        style="--media-ratio: {{ media_ratio }}; --shape-hover: var({{ shape_hover }})"
      >
        {% assign img_classes = media_classes | append: ' smi-default-image' %}
        {%- if image != blank -%}
          {% liquid
            assign image_object = image
            assign image_classes = img_classes
            assign item_mobile = 1
            assign item_tablet = 2
            assign item_desktop = section.settings.number_of_columns_on_desktop
          %}
{% liquid
    unless image_width
        assign image_width = 1600
    endunless
    unless sizes
        assign percent_item_mobile = 100 | divided_by: item_mobile | default: 100
        assign percent_item_tablet = 100 | divided_by: item_tablet | default: 100
        assign percent_item_desktop = 100 | divided_by: item_desktop | default: 100
        assign sizes = '(max-width: 767px)' | append: percent_item_mobile | append: 'vw, (max-width: 991px) ' | append: percent_item_tablet | append: 'vw, ' | append: percent_item_desktop | append: 'vw'
    endunless
%} 
{{
  image_object
  | image_url: width: image_width
  | image_tag: class: image_classes, widths: '400,500,600,700,800,1000,1200,1400,1600,1900,2500', sizes: sizes
}}
        {% else %}
          {% assign media_classes = media_classes | append: ' smi-placeholder-light' %}
          {{ 'image' | placeholder_svg_tag: media_classes }}
        {%- endif -%}
      </div>
    {%- elsif block.type == 'video_block' -%}
      {% liquid
        assign upload_video = block.settings.video
        assign video_url = block.settings.video_url
        assign cover_image = block.settings.cover_image
        assign show_mute = true
        assign autoplay = block.settings.autoplay
        assign preview = false
        assign control = true
        assign video_ratio = section.settings.media_ratio
        assign fit_video = true
        if shape_index == 1
          assign shape_index = 6
        else
          assign shape_index = shape_index | minus: 1
        endif
      %}
      <div
        class="smi-item__media smi-lh-0 smi-media-wrapper smi-media-wrapper-image smi-media {% if media_shape contains 'blob' %} smi-shape-blob-{{ shape_index }} {% endif %} {{ media_wrapper_classes}} {{ settings.smi_animations_hover_image | default: shop.metafields.smind.settings.value.imageHoverEffect | default: 'none' | prepend: ' smi-hover-image-' }}"
        style="--media-ratio: {{ media_ratio }}; --shape-hover: var({{ shape_hover }})"
      >
        {% render 'smi-video',
          upload_video: upload_video,
          video_url: video_url,
          cover_image: cover_image,
          show_mute: show_mute,
          autoplay: autoplay,
          preview: preview,
          control: control,
          video_ratio: video_ratio,
          fit_video: fit_video
        %}
      </div>
    {% endif %}
    <div
      class="smi-content-align-{{ section.settings.content_alignment }} {{- ' smi-item-content' -}}
      {% liquid
        if block.settings.heading != blank or block.settings.content != blank or block.settings.button_label != blank
          echo ' smi-pt-lg'
        endif
        if section.settings.content_alignment == "right"
          echo ' smi-pl-md'
        elsif section.settings.content_alignment == "left"
          echo ' smi-pr-md'
        else
          echo ' smi-px-md'
        endif
      %}"
    >
      {% if block.settings.heading != blank %}
        <h3
          class="smi-item-content-heading {{ block.settings.heading_size }} smi-link-wrapper"
        >
          {{ block.settings.heading }}
        </h3>
      {% endif %}
      {% if block.settings.content != blank %}
		{% assign content_size = '-mb ' | append:block.settings.content_size  | prepend: block.settings.content_size %}
        <div
          class="{% if content_size != blank %}{{content_size}}{% else %}smi-text-md{% endif %} smi-item-content-detail smi-text-75 smi-mt-xxs smi-link-wrapper"
        >
          {{ block.settings.content }}
        </div>
      {% endif %}
      {% if block.settings.button_label != blank %}
        <div class="smi-component-buttons smi-mt-md smi-button-wrapper smi-component-button-{{ section.settings.content_alignment }}">
          <a
            href="{% if block.settings.button_label != blank %} {{ block.settings.button_link }} {% else %}javascript:; {% endif %}"
            class="smi-button smi-text-button smi-button--text {%- if button_style contains 'arrow' %} smi-has-icon{% endif %}
              {{- settings.smi_animations_hover_elements | default: shop.metafields.smind.settings.value.buttonHoverEffect | default: 'none' | prepend: ' smi-hover-' -}}
              {{- ' smi-border smi-shadow' -}}"
          >
            <span>
              {{- block.settings.button_label | escape -}}
            </span>
          </a>
        </div>
      {% endif %}
    </div>
  </div>
        </div>
      {% endfor %}
    </div>
  </div>
  {% if enable_swipe_on_mobile == true %}
    <div class="smi-slider-controls smi-d-flex smi-d-md-none">
      {%- liquid
	if st_pagination == null
		assign st_pagination = section.settings.sticky_page_dot_style
	endif
-%}
{% if st_pagination != 'none' %}
	{%- liquid
		assign pagination_style = 'default'
		if st_pagination contains 'text-style'
			assign pagination_style = 'fraction'
		elsif st_pagination == 'dynamic'
			assign pagination_style = 'dynamic'
		elsif st_pagination == 'scrollbar'
			assign pagination_style = 'scrollbar'
		endif
	-%}
	<div class="smi-slider-dot-container smi-pt-xl smi-w-100" data-pagination="{{ pagination_style }}">
		{%- if st_pagination contains 'text-style' -%}
			<div class="smi-component-sticky-page-dot">
				<div class="smi-slider-action">
					<div class="smi-arrows {{ st_pagination }}" smind-key="sticky_page_dot_style,pagination_alignment" smind-attributes smind-attr-pagination>
						<div data-control="textPrevSlide" class="smi-arrow dot-arrow-slider smi-text-sm">
							{% render 'smi-icons', icon: 'arrow-left' %}
						</div>
						<div class="text-pagination smi-pagination smi-slider-pagination smi-text-sm smi-arrow"></div>
						<div data-control="textNextSlide" class="smi-arrow dot-arrow-slider smi-text-sm">
							{% render 'smi-icons', icon: 'arrow-right' %}
						</div>
					</div>
				</div>
			</div>
		{%- elsif st_pagination == 'scrollbar' -%}
			<div class="smi-swiper-scrollbar" smind-key="sticky_page_dot_style,pagination_alignment" smind-attributes smind-attr-pagination></div>
		{%- elsif st_pagination == 'dynamic' -%}
			<div class="smi-pagination" smind-key="sticky_page_dot_style,pagination_alignment" smind-attributes smind-attr-pagination></div>
		{%- else -%}
			<div class="dot-container {{ st_pagination }}">
				<div
					class="smi-swiper-pagination smi-pagination"
					{% if st_pagination == 'dot-style-4' %}
						style="display: flex;"
					{% endif %}
					smind-key="sticky_page_dot_style,pagination_alignment" smind-attributes smind-attr-pagination
				></div>
			</div>
		{%- endif -%}
	</div>
{% endif %}
    </div>
  {% endif %}
  {%- if show_view_all != false and view_all_button_style != 'none' and object_loop.size > 0 -%}
