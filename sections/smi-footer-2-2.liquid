  <div class="smi-weight-content smi-pt-md smi-pb-md heading-collapsible_{{ forloop.index }}_{{ section.id }}">
    <h3 class="heading-detail {{ heading_size }} {% if block.settings.enable_collapsible_content_on_mobile %} heading-detail-collap {% endif %}"
