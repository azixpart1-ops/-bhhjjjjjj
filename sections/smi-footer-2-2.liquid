{% assign hero_logo_block = section.blocks | where: 'type', 'hero_logo' | first %}
{% if hero_logo_block %}
	{% liquid
	assign block = hero_logo_block
	case block.settings.hero_height
        when 'adapt_to_image'
			assign aspect_ratio_md = section.settings.image.aspect_ratio | default: 1.77
			assign aspect_ratio_xs = section.settings.mobile_image_optional.aspect_ratio | default: aspect_ratio_md
			assign slide_height = '100%'
			assign slide_height_mobile = '100%'
        when 'x_small'
            assign slide_height = '400px'
            assign slide_height_mobile = '244px'
        when 'small'
            assign slide_height = '512px'
            assign slide_height_mobile = '320px'
        when 'medium'
            assign slide_height = '576px'
            assign slide_height_mobile = '400px'
        when 'large'
            assign slide_height = '672px'
            assign slide_height_mobile = '480px'
        when 'fit_screen'
            assign slide_height = '100vh'
            assign slide_height_mobile = '100vh'
    endcase
  	assign background_image_class = ''
  	assign background_image = block.settings.image
  	assign background_image_mobile = block.settings.mobile_image_optional
%}
<style>
	#smi-{{ block.id }} {
		--slide-height: {{ slide_height }};
		--left-right-padding: {{ block.settings.left_right_padding_desktop }}px;
		--top-bottom-padding: {{ block.settings.top_bottom_padding_desktop }}px;
		--text-font: var(--font-{{ block.settings.font_type }}-family);
		--text-font-weight: var(--font-{{ block.settings.font_type }}-weight);
		--text-font-style: var(--font-{{ block.settings.font_type }}-style);
		--text-case: {{ block.settings.text_case }};
		{% if block.settings.outline_text %}
			--outline-text-thickness: {{ block.settings.outline_text_thickness }}px;
		{% endif %}	
		--text-line-height-scale: {{ block.settings.text_line_height_scale | divided_by: 100.0 }};
		--heading-letter-spacing: {{ block.settings.heading_letter_spacing }}px;
		--logo-width-scale: {{ block.settings.logo_width_scale_desktop }}%;
		--logo-opacity: {{ block.settings.logo_opacity | divided_by: 100.0 }};
		--text-color: {{ block.settings.text_color }};
		{% if block.settings.image_gradient_overlay != blank %}
			--image-overlay: {{ block.settings.image_gradient_overlay }};
		{% else %}
			--image-overlay: rgba({{ block.settings.image_overlay.red }},{{ block.settings.image_overlay.green }},{{ block.settings.image_overlay.blue }},{{ block.settings.overlay_opacity | divided_by: 100.0 }});
		{% endif %}
		{% if block.settings.enable_background_blur %}
			--background-blur: {{ block.settings.background_blur | divided_by: 10.0}}px;
		{% endif %}			
		{% if block.settings.hero_height == 'adapt_to_image' %}
            --aspect-ratio: {{ aspect_ratio_md }};
        {% else %}
            --aspect-ratio: 'unset';
        {% endif %}
	}
	@media(max-width:767px) {
		#smi-{{ block.id }} {
			--slide-height: {{ slide_height_mobile }};
			--left-right-padding: {{ block.settings.left_right_padding_mobile }}px;
			--top-bottom-padding: {{ block.settings.top_bottom_padding_mobile }}px;
			--logo-width-scale: {{ block.settings.logo_width_scale_mobile }}%;
			{% if block.settings.hero_height == 'adapt_to_image' %}
				--aspect-ratio: {{ aspect_ratio_xs }};
			{% else %}
				--aspect-ratio: 'unset';
			{% endif %}
		}
	}
</style>
<div id="smi-{{ block.id }}" class="smi-hero-logo-wrapper  }} smi-reveal-scroll-{{ block.settings.enable_hero_reveal_on_scroll }} smi-hero-block-{{ section.id }}">
	<div class="smi-hero-logo-content smi-justify-content-{{ block.settings.logo_position }}">
		<div class="smi-logo-content smi-p-relative">
			{% if block.settings.logo_image != blank %}
				{% liquid
					assign image_object = block.settings.logo_image 
					assign image_classes = 'smi-logo-image'
				%}
{% liquid
    unless image_width
        assign image_width = 1600
    endunless
    unless sizes
        assign percent_item_mobile = 100 | divided_by: item_mobile | default: 100
        assign percent_item_tablet = 100 | divided_by: item_tablet | default: 100
        assign percent_item_desktop = 100 | divided_by: item_desktop | default: 100
        assign sizes = '(max-width: 767px)' | append: percent_item_mobile | append: 'vw, (max-width: 991px) ' | append: percent_item_tablet | append: 'vw, ' | append: percent_item_desktop | append: 'vw'
    endunless
%} 
{{
  image_object
  | image_url: width: image_width
  | image_tag: class: image_classes, widths: '400,500,600,700,800,1000,1200,1400,1600,1900,2500', sizes: sizes
}}
			{% else %}
				<div class="smi-shop-name smi-text-{{ block.settings.logo_position }} {% if block.settings.outline_text %} smi-outline-text {% endif %}">
					Smind
				</div>		
			{% endif %}
		</div>
		{%- if background_image != blank or  background_image_mobile != blank -%}
			<div class="smi-hero-background smi-absolute-full">
				<picture>
					{%- if background_image_mobile != blank -%}
						<source media="(max-width:460px)" srcset="{{ background_image_mobile | image_url: width : 700 }}">
						<source media="(max-width:767px)" srcset="{{ background_image_mobile | image_url: width : 1100 }}">
					{%- endif -%}
					{%- if background_image != blank -%}
						{% if background_image_mobile == blank %}
							<source media="(max-width:460px)" srcset="{{ background_image | image_url: width : 700 }}">
							<source media="(max-width:767px)" srcset="{{ background_image | image_url: width : 1100 }}">
						{% endif %}
						{% assign background_image_class = background_image_class | append: ' smi-background-image-desktop' %}
						{{ background_image | image_url: width : 1920 | image_tag: class: background_image_class }}
					{%- elsif background_image_mobile != blank -%}
						{% assign background_image_class = background_image_class | append: ' smi-background-image-mobile' %}
						{{ background_image_mobile | image_url: width : 767 | image_tag: class: background_image_class }}
					{%- endif -%}
				</picture>
			</div>
		{% endif %}
	</div>
</div>
{% endif %}	{%comment%}#includeFile#assets/smi-email-signup.min.css#endIncludeFile#{%endcomment%}
