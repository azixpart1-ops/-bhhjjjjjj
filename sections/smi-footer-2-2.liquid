	}
</style>
<div class="smi-d-none smi-basico-item">&nbsp; </div>
<link rel="stylesheet" type="text/css" href="{{ 'smi-email-signup.min.css' | asset_url }}" media="screen" onload="this.onload=null;this.media='all'">
{%-liquid
    if settings.smi_animations_reveal_on_scroll != nil
        assign animation_scroll = settings.smi_animations_reveal_on_scroll
    else
        assign global_settings = shop.metafields.smind.settings.value
        assign animation_scroll = global_settings.revealOnScroll
    endif
-%}
<div id="smi-{{ section.id }}"
     class="smi-{{ section.id }} smi-display-settings smi-display-{{ section.settings.display_on }} smi-section__inner smi-gradient smi-section-footer-2 smi-color-{{ section.settings.color_scheme }}"
     data-section="footer-2"
     data-name="✧Footer 2">
    
    {% liquid
		assign background_block = section.blocks | where: 'type', 'background' | first
		if background_block
		render 'smi-background'
		endif
	%}
    <div class="relative-smi-container smi-container{%- if section.settings.container_full_width -%}-fluid{%- endif -%}">
		<div
		class="smi-footer-content smi-mb-lg smi-footer-content-detail-item-{{ section.id }}"
		data-load='{"size": "{{ section.blocks.size }}"}'
		>
			{% liquid
				assign notCollapseItems = ''
				for block in section.blocks
				unless block.settings.enable_collapsible_content_on_mobile
					assign checkIndex = forloop.index | minus: 1
					assign notCollapseItems = notCollapseItems | append: ' x' | append: checkIndex
				endunless
				endfor
				capture icon_arrow_up
				render 'smi-icons', icon: 'arrow-up'
				endcapture
				capture icon_arrow_down
				render 'smi-icons', icon: 'arrow-down'
				endcapture
			%}
			{% assign lastCollaps = 0 %}
			{% for block in section.blocks %}
				{% if block.type != 'color' and block.type != 'background' and block.type != 'hero_logo' %}
				<div
					class="item-footer smi-footer-{{ block.type }} {{- ' item-footer-detail' -}}
					{% liquid
					if forloop.index == section.  blocks.size
						echo ' last-item-footer-detail'
					endif
					if block.settings.enable_collapsible_content_on_mobile
						assign lastCollaps = forloop.index 
						if block.type != 'menu'
						echo ' collapsible-item-footer collapsible-item-footer-'| append: forloop.index | append: '-' | append: section.id
						echo ' collapsible-item-footer-' | append: section.id
						else
						if block.settings.menu != blank or block.settings.heading != blank
							echo ' collapsible-item-footer collapsible-item-footer-'| append: forloop.index | append: '-' | append: section.id
							echo ' collapsible-item-footer-' | append: section.id
						endif
						endif
					endif
					%}"
				>
					{% if block.type == 'email_form_footer' %}
    <div id="item_footer_detail_{{ forloop.index }}_{{ section.id }}" 
        class="smi-footer_{{ block.type }}" {{- block.shopify_attributes -}}>
		{% assign heading_size =  block.settings.heading_size | default: 'smi-h5' %}
        {% liquid
  for block in section.blocks
    if block.type == 'email_form_footer'
      assign style_email_signup = block.settings.style_email_signup | times: 1
    endif
  endfor
  capture icon_success
    render 'smi-icons', icon: 'success'
  endcapture
  capture icon_error
    render 'smi-icons', icon: 'error'
  endcapture
  assign form_success = 'smind.form.form_email_success' | t
  assign form_error = 'smind.form.form_error' | t
  assign field_invalid = 'smind.form.field_invalid' | t : field : "Email"
  assign field_required = 'smind.form.field_required' | t : field : "Email"
%}
<style>
	body .smi-section #item_footer_detail_{{ forloop.index }}_{{ section.id }} {
		{% if block.settings.enable_custom_input_form %}
				--input-padding-horizontal-desktop: {{ block.settings.input_padding_horizontal_desktop }}px;
				--input-padding-vertical-desktop: {{ block.settings.input_padding_vertical_desktop }}px;
				--input-padding-horizontal-mobile: {{ block.settings.input_padding_horizontal_mobile }}px;
				--input-padding-vertical-mobile: {{ block.settings.input_padding_vertical_mobile }}px;
				--inputs-radius: {{ block.settings.inputs_radius }}px;
				--inputs-border-width: {{ block.settings.inputs_border_thickness }}px;
				--inputs-border-opacity: {{ block.settings.inputs_border_opacity | divided_by: 100.0 }};
				--inputs-shadow-opacity: {{ block.settings.inputs_shadow_opacity | divided_by: 100.0 }};
				{% if block.settings.custom_inputs_shadow %}
				--inputs-shadow-horizontal-offset: {{ block.settings.inputs_shadow_position_x }}px;
				--inputs-margin-offset: {% if block.settings.inputs_shadow_position_y != 0 and block.settings.inputs_shadow_opacity > 0 %}{{ block.settings.inputs_shadow_position_y | abs }}{% else %}0{% endif %}px;
				--inputs-shadow-vertical-offset: {{ block.settings.inputs_shadow_position_y }}px;
				--inputs-shadow-blur-radius: {{ block.settings.inputs_shadow_blur }}px;
				{% else %}
				{% assign smi_inputs_shadow = block.settings.inputs_shadow | split: "," %}
				--inputs-shadow-horizontal-offset: {{ smi_inputs_shadow[0] }}px;
				--inputs-margin-offset: {% if smi_inputs_shadow[1] != 0 and block.settings.inputs_shadow_opacity > 0 %}{{ smi_inputs_shadow[1] | abs }}{% else %}0{% endif %}px;
				--inputs-shadow-vertical-offset: {{ smi_inputs_shadow[1] }}px;
				--inputs-shadow-blur-radius: {{ smi_inputs_shadow[2] }}px;
				{% endif %}
				--inputs-radius-outset: {% if block.settings.inputs_radius > 0 %}{{ block.settings.inputs_radius | plus: block.settings.inputs_border_thickness }}{% else %}0{% endif %}px;
				@media (max-width: 768px) {
					--inputs-radius: {{ block.settings.inputs_radius_mobile }}px;
					--inputs-radius-outset: {% if block.settings.inputs_radius_mobile > 0 %}{{ block.settings.inputs_radius_mobile | plus: block.settings.inputs_border_thickness }}{% else %}0{% endif %}px;
				}
				--inputs-shadow-visible: {% if block.settings.inputs_shadow_opacity > 0 and block.settings.inputs_shadow != '0,0,0' %}1{% else %}0{% endif %};
		{% endif %}	
	}
</style>
<div class="email-container style-{{style_email_signup}} smi-d-block smi-align-items-center smi-column-gap-xs" {{- block.shopify_attributes -}}>
	{% liquid
	  unless heading_size != blank
		assign heading_size =  section.settings.heading_size | default: 'smi-h5'
	  endunless
	%}	
  {% assign heading_content = block.settings.heading | strip %}
