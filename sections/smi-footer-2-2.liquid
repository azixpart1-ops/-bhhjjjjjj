<style>
    {% if block_color %}
    {% endif %}
    {% assign block_color = section.blocks | where: 'type', 'color' | first %}
{% if block_color %}
    #shopify-section-{{ section.id }} .smi-color-{{ section.settings.color_scheme }}{
        --color-background: {{ block_color.settings.background_color.red }}, {{ block_color.settings.background_color.green }},{{ block_color.settings.background_color.blue }};
        {% if block_color.settings.background_gradient_color == blank %}
            --gradient-background: {{ block_color.settings.background_color }};
        {% else %}
            --gradient-background: {{ block_color.settings.background_gradient_color }};
        {% endif %}
		--color-heading: {{ block_color.settings.heading_color.red }}, {{ block_color.settings.heading_color.green }},{{ block_color.settings.heading_color.blue }};
        --color-foreground: {{ block_color.settings.text_color.red }}, {{ block_color.settings.text_color.green }},{{ block_color.settings.text_color.blue }};
		--color-subtext: {{ block_color.settings.subtext_color.red }},{{ block_color.settings.subtext_color.green }},{{ block_color.settings.subtext_color.blue }};
        --color-shadow: {{ block_color.settings.shadow_color.red }}, {{ block_color.settings.shadow_color.green }},{{ block_color.settings.shadow_color.blue }};
		--color-text-link: {{ block_color.settings.link_color.red }}, {{ block_color.settings.link_color.green }},{{ block_color.settings.link_color.blue }};
		{% if block_color.settings.hover_link_color != blank and block_color.settings.hover_link_color != 'rgba(0,0,0,0)' %}
			--color-hover-link: {{ block_color.settings.hover_link_color.red }}, {{ block_color.settings.hover_link_color.green }},{{ block_color.settings.hover_link_color.blue }};
		{% else %}
			--color-hover-link: {{ block_color.settings.link_color.red }}, {{ block_color.settings.link_color.green }},{{ block_color.settings.link_color.blue }};
		{% endif %}		
		--color-button: {{ block_color.settings.solid_background_button_color.red }}, {{ block_color.settings.solid_background_button_color.green }},{{ block_color.settings.solid_background_button_color.blue }};
		--color-button-text: {{ block_color.settings.solid_button_label_color.red }}, {{ block_color.settings.solid_button_label_color.green }},{{ block_color.settings.solid_button_label_color.blue }};
		{% if block_color.settings.solid_background_button_hover_color != blank and block_color.settings.solid_background_button_hover_color != 'rgba(0,0,0,0)' %}
			--color-button-hover: {{ block_color.settings.solid_background_button_hover_color.red }}, {{ block_color.settings.solid_background_button_hover_color.green }},{{ block_color.settings.solid_background_button_hover_color.blue }};
		{% else %}
			--color-button-hover: {{ block_color.settings.solid_background_button_color.red }}, {{ block_color.settings.solid_background_button_color.green }},{{ block_color.settings.solid_background_button_color.blue }};
		{% endif %}		
		{% if block_color.settings.solid_button_label_hover_color != blank and block_color.settings.solid_button_label_hover_color != 'rgba(0,0,0,0)' %}
			--color-button-hover-text: {{ block_color.settings.solid_button_label_hover_color.red }}, {{ block_color.settings.solid_button_label_hover_color.green }},{{ block_color.settings.solid_button_label_hover_color.blue }};
		{% else %}
			--color-button-hover-text: {{ block_color.settings.solid_button_label_color.red }}, {{ block_color.settings.solid_button_label_color.green }},{{ block_color.settings.solid_button_label_color.blue }};
		{% endif %}		
		--color-secondary-button-text: {{ block_color.settings.outline_button_color.red }}, {{ block_color.settings.outline_button_color.green }},{{ block_color.settings.outline_button_color.blue }};
		{% if block_color.settings.outline_button_hover_color != blank and block_color.settings.outline_button_hover_color != 'rgba(0,0,0,0)' %}
			--color-button-hover-border: {{ block_color.settings.outline_button_hover_color.red }}, {{ block_color.settings.outline_button_hover_color.green }},{{ block_color.settings.outline_button_hover_color.blue }};
		{% else %}
			--color-button-hover-border: {{ block_color.settings.outline_button_color.red }}, {{ block_color.settings.outline_button_color.green }},{{ block_color.settings.outline_button_color.blue }};
		{% endif %}
		{% if block_color.settings.input_background_color != blank and block_color.settings.input_background_color != 'rgba(0,0,0,0)' %}
			--color-input-background: {{ block_color.settings.input_background_color.red }}, {{ block_color.settings.input_background_color.green }},{{ block_color.settings.input_background_color.blue }};
		{% endif %}
		{% if block_color.settings.input_color != blank and block_color.settings.input_color != 'rgba(0,0,0,0)' %}
			--color-input-color: {{ block_color.settings.input_color.red }}, {{ block_color.settings.input_color.green }},{{ block_color.settings.input_color.blue }};
		{% endif %}
		{% if block_color.settings.input_border_color != blank and block_color.settings.input_border_color != 'rgba(0,0,0,0)' %}
			--color-input-border: {{ block_color.settings.input_border_color.red }}, {{ block_color.settings.input_border_color.green }},{{ block_color.settings.input_border_color.blue }};
		{% else %}	
			--color-input-border: {{ block_color.settings.text_color.red }}, {{ block_color.settings.text_color.green }},{{ block_color.settings.text_color.blue }};
		{% endif %}
		{% if block_color.settings.input_border_hover_color != blank and block_color.settings.input_border_hover_color != 'rgba(0,0,0,0)' %}
			--color-input-border-hover: {{ block_color.settings.input_border_hover_color.red }},{{ block_color.settings.input_border_hover_color.green }},{{ block_color.settings.input_border_hover_color.blue }};
		{% else %}
			--color-input-border-hover: {{ block_color.settings.text_color.red }}, {{ block_color.settings.text_color.green }},{{ block_color.settings.text_color.blue }};
		{% endif %}		
    }
{% endif %}
    #shopify-section-{{ section.id }} {
        --section-padding-top: {{ section.settings.padding_top }}px;
--section-padding-bottom: {{ section.settings.padding_bottom }}px;
--section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
--section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
		--section-margin-sides: {{ section.settings.margin_sides }}px;
--section-margin-sides-mobile: {{ section.settings.margin_sides_mobile }}px;
		{% if  section.settings.custom_width == true and section.settings.container_full_width == false %}
--page-width: {{ section.settings.section_width }}px;
{% endif %}
		--divider-opacity: {{ section.settings.divider_opacity | divided_by: 100.0 }};
		--spacing-elements: {{ section.settings.vertical_gap_scale_desktop | divided_by: 100.0 }};
		--menu-item-gap-scale: {{ section.settings.menu_item_gap_scale_desktop | divided_by: 100.0 }};
    }
	@media (max-width: 767px) {
		#shopify-section-{{ section.id }}{
			--spacing-elements: {{ section.settings.vertical_gap_scale_mobile | divided_by: 100.0 }};
			--menu-item-gap-scale: {{ section.settings.menu_item_gap_scale_mobile | divided_by: 100.0 }};
		}
		#shopify-section-{{ section.id }} .smi-footer-content  .item-footer > div {
			--spacing-elements: {{ section.settings.menu_item_gap_scale_mobile | divided_by: 100.0 }};
