{{ 'modulo-section-trust-bar.css' | asset_url | stylesheet_tag }}

{%- liquid
  # ─── Header (optional — off by default)
  assign show_header      = section.settings.show_header
  assign eyebrow          = section.settings.eyebrow
  assign heading          = section.settings.heading
  assign subheading       = section.settings.subheading
  assign header_alignment = section.settings.header_alignment | default: 'left'

  # ─── Layout
  assign layout_style   = section.settings.layout_style | default: 'cards'
  assign icon_position  = section.settings.icon_position | default: 'left'
  assign columns        = section.settings.columns | default: 'auto'
  assign card_gap       = section.settings.card_gap | default: 14
  assign card_radius    = section.settings.card_radius | default: 16

  # ─── Icon
  assign icon_size      = section.settings.icon_size | default: 22
  assign icon_color     = section.settings.icon_color | default: '#1A1A2E'
  assign show_icon_tile = section.settings.show_icon_tile
  assign icon_tile_color = section.settings.icon_tile_color | default: '#F4F4F5'

  # ─── Typography
  assign label_size = section.settings.label_size | default: 15
  assign sub_size   = section.settings.sub_size | default: 13

  # ─── Colors
  assign bg = section.settings.bg_color | default: '#FFF8F0'
  if section.settings.bg_transparent
    assign bg = 'transparent'
  endif
  assign card_bg      = section.settings.card_bg | default: '#FFFFFF'
  assign card_border  = section.settings.card_border | default: '#E5E7EB'
  assign text_color   = section.settings.text_color | default: '#1A1A2E'
  assign muted_color  = section.settings.muted_color | default: '#9CA3AF'
  assign divider_color = section.settings.divider_color | default: '#E5E7EB'
  assign accent_color = section.settings.accent_color | default: '#6366F1'

  # ─── Width & spacing
  assign section_width = section.settings.section_width | default: 'page'
  assign container_width = section.settings.container_width | default: 'standard'
  assign section_outer_radius = section.settings.section_outer_radius | default: 24
  assign padding_top    = section.settings.padding_top | default: 24
  assign padding_bottom = section.settings.padding_bottom | default: 24

  case container_width
    when 'wide'
      assign container_max = 1440
    else
      assign container_max = 1200
  endcase

  # ─── Root class
  assign root_class = 'modulo-section modulo-tb modulo-tb--style-' | append: layout_style | append: ' modulo-tb--icon-' | append: icon_position | append: ' modulo-tb--cols-' | append: columns | append: ' modulo-tb--width-' | append: section_width | append: ' modulo-tb--container-' | append: container_width | append: ' modulo-tb--header-' | append: header_alignment
  if show_icon_tile
    assign root_class = root_class | append: ' modulo-tb--tile'
  endif
-%}

<section
  class="{{ root_class }}"
  style="
    --modulo-tb-bg:{{ bg }};
    --modulo-tb-card-bg:{{ card_bg }};
    --modulo-tb-card-border:{{ card_border }};
    --modulo-tb-text:{{ text_color }};
    --modulo-tb-muted:{{ muted_color }};
    --modulo-tb-divider:{{ divider_color }};
    --modulo-tb-accent:{{ accent_color }};
    --modulo-tb-icon-color:{{ icon_color }};
    --modulo-tb-icon-size:{{ icon_size }}px;
    --modulo-tb-tile:{{ icon_tile_color }};
    --modulo-tb-label-size:{{ label_size }}px;
    --modulo-tb-sub-size:{{ sub_size }}px;
    --modulo-tb-gap:{{ card_gap }}px;
    --modulo-tb-radius:{{ card_radius }}px;
    --modulo-tb-container-max:{{ container_max }}px;
    --modulo-tb-outer-radius:{{ section_outer_radius }}px;
    --modulo-tb-pad-top:{{ padding_top }}px;
    --modulo-tb-pad-bottom:{{ padding_bottom }}px;
  "
>
  <div class="modulo-tb__container">

    {%- if show_header and heading != blank -%}
      <div class="modulo-tb__header">
        {%- if eyebrow != blank -%}
          <p class="modulo-tb__eyebrow">{{ eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="modulo-tb__heading">{{ heading }}</h2>
        {%- if subheading != blank -%}
          <p class="modulo-tb__subheading">{{ subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="modulo-tb__grid">
        {%- for block in section.blocks -%}
          {%- capture icon_markup -%}
            {%- if block.settings.custom_icon != blank -%}
              <img class="modulo-tb__icon-img" src="{{ block.settings.custom_icon | image_url: width: 96 }}" alt="" width="48" height="48" loading="lazy">
            {%- else -%}
              {%- render 'modulo-icons', name: block.settings.icon -%}
            {%- endif -%}
          {%- endcapture -%}
          {%- capture item_inner -%}<span class="modulo-tb__icon">{{ icon_markup }}</span><span class="modulo-tb__body">{%- if block.settings.label != blank -%}<b class="modulo-tb__label">{{ block.settings.label | escape }}</b>{%- endif -%}{%- if block.settings.text != blank -%}<span class="modulo-tb__sub">{{ block.settings.text | escape }}</span>{%- endif -%}</span>{%- endcapture -%}
          {%- if block.settings.link != blank -%}
            <a class="modulo-tb__item modulo-tb__item--link" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ item_inner }}</a>
          {%- else -%}
            <div class="modulo-tb__item" {{ block.shopify_attributes }}>{{ item_inner }}</div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Modulo: Trust Bar",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Section header (optional)" },
    { "type": "checkbox", "id": "show_header", "label": "Show a header above the badges", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "visible_if": "{{ section.settings.show_header }}" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Bold any word(s) to highlight them in the accent color.", "visible_if": "{{ section.settings.show_header }}" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "visible_if": "{{ section.settings.show_header }}" },
    {
      "type": "select", "id": "header_alignment", "label": "Header alignment", "default": "left",
      "visible_if": "{{ section.settings.show_header }}",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },

    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "layout_style", "label": "Style", "default": "cards",
      "options": [
        { "value": "cards",    "label": "Cards" },
        { "value": "plain",    "label": "Plain (no card)" },
        { "value": "dividers", "label": "Dividers" }
      ]
    },
    {
      "type": "select", "id": "icon_position", "label": "Icon position", "default": "left",
      "options": [
        { "value": "left", "label": "Left of text" },
        { "value": "top",  "label": "Above text (centered)" }
      ]
    },
    {
      "type": "select", "id": "columns", "label": "Columns (desktop)", "default": "auto",
      "info": "Auto fits as many as comfortably fit per row.",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ]
    },
    { "type": "range", "id": "card_gap", "label": "Gap", "min": 6, "max": 32, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "card_radius", "label": "Card corner radius", "min": 0, "max": 28, "step": 2, "unit": "px", "default": 16, "visible_if": "{{ section.settings.layout_style == 'cards' }}" },

    { "type": "header", "content": "Icon" },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 16, "max": 40, "step": 1, "unit": "px", "default": 22 },
    { "type": "color", "id": "icon_color", "label": "Icon color", "default": "#1A1A2E" },
    { "type": "checkbox", "id": "show_icon_tile", "label": "Show tile behind icon", "default": true },
    { "type": "color", "id": "icon_tile_color", "label": "Icon tile color", "default": "#F4F4F5", "visible_if": "{{ section.settings.show_icon_tile }}" },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "label_size", "label": "Label size", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "sub_size", "label": "Subtext size", "min": 11, "max": 18, "step": 1, "unit": "px", "default": 13 },

    { "type": "header", "content": "Colors" },
    { "type": "checkbox", "id": "bg_transparent", "label": "Transparent section background", "default": true },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#FFF8F0", "visible_if": "{{ section.settings.bg_transparent == false }}" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#FFFFFF", "visible_if": "{{ section.settings.layout_style == 'cards' }}" },
    { "type": "color", "id": "card_border", "label": "Card border", "default": "#E5E7EB", "visible_if": "{{ section.settings.layout_style == 'cards' }}" },
    { "type": "color", "id": "text_color", "label": "Label color", "default": "#1A1A2E" },
    { "type": "color", "id": "muted_color", "label": "Subtext color", "default": "#9CA3AF" },
    { "type": "color", "id": "divider_color", "label": "Divider color", "default": "#E5E7EB", "visible_if": "{{ section.settings.layout_style == 'dividers' }}" },
    { "type": "color", "id": "accent_color", "label": "Link hover / focus", "default": "#6366F1" },

    { "type": "header", "content": "Section width & spacing" },
    {
      "type": "select", "id": "section_width", "label": "Section width", "default": "page",
      "options": [
        { "value": "page",  "label": "Page" },
        { "value": "boxed", "label": "Boxed (rounded, centered)" }
      ]
    },
    {
      "type": "select", "id": "container_width", "label": "Content width", "default": "standard",
      "visible_if": "{{ section.settings.section_width == 'page' }}",
      "options": [
        { "value": "standard", "label": "Standard" },
        { "value": "wide",     "label": "Wide" },
        { "value": "full",     "label": "Full width" }
      ]
    },
    { "type": "range", "id": "section_outer_radius", "label": "Outer corner radius", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 24, "visible_if": "{{ section.settings.section_width == 'boxed' }}" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust badge",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "truck",
          "options": [
            { "value": "truck", "label": "Truck (shipping)" },
            { "value": "package", "label": "Package" },
            { "value": "refresh", "label": "Returns" },
            { "value": "lock", "label": "Lock (secure)" },
            { "value": "shield", "label": "Shield" },
            { "value": "verified", "label": "Verified" },
            { "value": "check", "label": "Check" },
            { "value": "credit_card", "label": "Credit card" },
            { "value": "wallet", "label": "Wallet" },
            { "value": "headset", "label": "Headset (support)" },
            { "value": "award", "label": "Award" },
            { "value": "percent", "label": "Percent (deals)" },
            { "value": "globe", "label": "Globe" },
            { "value": "gift", "label": "Gift" },
            { "value": "leaf", "label": "Leaf (eco)" },
            { "value": "recycle", "label": "Recycle" },
            { "value": "clock", "label": "Clock" },
            { "value": "bolt", "label": "Bolt (fast)" },
            { "value": "star", "label": "Star" },
            { "value": "heart", "label": "Heart" },
            { "value": "sparkle", "label": "Sparkle" }
          ]
        },
        { "type": "image_picker", "id": "custom_icon", "label": "Custom icon", "info": "Overrides the icon above. Use a small square PNG/SVG." },
        { "type": "text", "id": "label", "label": "Label", "default": "Free shipping" },
        { "type": "text", "id": "text", "label": "Subtext", "default": "On all orders over $50" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Modulo: Trust Bar",
      "blocks": [
        { "type": "badge", "settings": { "icon": "truck", "label": "Free shipping", "text": "On all orders over $50" } },
        { "type": "badge", "settings": { "icon": "refresh", "label": "Easy 30-day returns", "text": "No questions asked" } },
        { "type": "badge", "settings": { "icon": "lock", "label": "Secure checkout", "text": "SSL-encrypted payments" } },
        { "type": "badge", "settings": { "icon": "headset", "label": "Here to help", "text": "Support 7 days a week" } }
      ]
    }
  ]
}
{% endschema %}
