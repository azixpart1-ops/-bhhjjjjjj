{% comment %}#component#["settings/display-settings-2","settings/container-width-new","settings/product-card","settings/slider-arrows","settings/slider-dots-v2","settings/section-padding","settings/section-margin","settings/media-settings-3","settings/design-mode","settings/image.picture","settings/animation-settings","settings/heading.highlight","settings/buttons"]#endcomponent#{% endcomment %}
<link rel="stylesheet" type="text/css" href="{{ 'smi-swiper-bundle-v11.min.css' | asset_url }}" media="screen" onload="this.onload=null;this.media='all'">
<script src="{{ 'smi-swiper-bundle-v11.min.js' | asset_url }}" defer data-id="smi-swiper-bundle-v11.min.js" data-section-id="smi-{{ section.id }}"></script>
<script src="{{ 'smi-slideshow.min.js' | asset_url }}" defer data-id="smi-slideshow.min.js" data-section-id="smi-{{ section.id }}"></script>
<link rel="stylesheet" type="text/css" href="{{ 'smi-product-card.min.css' | asset_url }}" media="screen" onload="this.onload=null;this.media='all'">
<script src="{{ 'smi-product-card.min.js' | asset_url }}" defer data-id="smi-product-card.min.js" data-section-id="smi-{{ section.id }}"></script>
{% liquid
	assign control_color = 'smi-color-' | append: section.settings.control_color_scheme
	assign color_block = section.blocks | where: 'type', 'color' | first
	if color_block
		assign control_color = 'smi-custom-control-color'
		assign content_color  = 'smi-slide-content--background'
	else
		assign content_color = 'smi-color-' | append: section.settings.content_color_scheme
	endif
	assign slider_blocks = section.blocks | where: 'type', 'slider'
	assign block_media_size = slider_blocks.size
%}
{% liquid
	case section.settings.slide_height
		when 'adapt_to_first_image'
			assign first_block = section.blocks[0]
			case first_block.settings.media_type
				when 'image'
					assign aspect_ratio_md = first_block.settings.image.aspect_ratio | default: 2.22
					assign aspect_ratio_xs = first_block.settings.image_mobile.aspect_ratio | default: aspect_ratio_md
				when 'video'
					assign aspect_ratio_md = first_block.settings.video.aspect_ratio | default: 2.22
					assign aspect_ratio_xs = first_block.settings.mobile_video.aspect_ratio | default: aspect_ratio_md
			endcase
			if aspect_ratio_md and aspect_ratio_xs
				assign slide_height = 'fit-content'
				assign slide_height_mobile = 'fit-content'
			else
				assign slide_height = '480px'
				assign slide_height_mobile = '330px'
			endif
		when 'x_small'
			assign slide_height = '420px'
			assign slide_height_mobile = '260px'
		when 'small'
			assign slide_height = '480px'
			assign slide_height_mobile = '330px'
		when 'medium'
			assign slide_height = '560px'
			assign slide_height_mobile = '410px'
		when 'large'
			assign slide_height = '680px'
			assign slide_height_mobile = '490px'
		when 'fit_screen'
			assign slide_height = '100vh'
			assign slide_height_mobile = '550px'
	endcase
	assign image_width = 2500
	assign sizes = '100vw'
%}
