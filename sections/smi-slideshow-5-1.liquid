<div class="smi-d-none smi-pods-item">&nbsp; </div>
<div
	id="smi-{{ section.id }}"
	class="smi-{{ section.id }} smi-display-settings smi-display-{{ section.settings.display_on }} smi-section__inner smi-gradient smi-slideshow-5 smi-color-{{ section.settings.color_scheme }}"
	data-section="slideshow-5"
	data-name="✧Slideshow 5"
>
	
	<div
		class="smi-section-wrapper smi-{{ section.settings.full_width }} {%- if animation_scroll %} smi-scroll-trigger smi-animate--slide-in smi-animate-order-1{% endif -%} {% if section.settings.full_width != "container-fluid-no-padding" %}smi-media-wrapper smi-border smi-shadow{% endif %}">
		<div
			class="smi-slideshow-base-1 smi-swiper"
			{%- if section.settings.auto_rotate_slides %}
				data-swiper-autoplay--delay="{{- section.settings.change_slides_every | times: 1000 -}}"
			{% endif -%}
			data-swiper-effect="{{- section.settings.transition_effect -}}"
		>
			<div class="smi-swiper-wrapper">
				{% for block in slider_blocks %}
{% liquid
	assign position_y = block.settings.desktop_content_position | split: '_' | first
	assign position_x = block.settings.desktop_content_position | split: '_' | last
	capture position_content
		echo ' smi-justify-content-center smi-align-items-' | append: block.settings.mobile_content_position
		if block.settings.desktop_content_position
			echo ' smi-justify-content-md-' | append: position_x | append: ' smi-align-items-md-' | append: position_y
		endif
	endcapture
	assign card_position_y = block.settings.desktop_card_position | split: '_' | first
	assign card_position_x = block.settings.desktop_card_position | split: '_' | last
	capture card_position_content
		echo ' smi-justify-content-center smi-align-items-' | append: block.settings.mobile_card_position
		if block.settings.desktop_card_position
			echo ' smi-justify-content-md-' | append: card_position_x | append: ' smi-align-items-md-' | append: card_position_y
		endif
	endcapture
	assign image_object = block.settings.image
	assign image_object_mobile = block.settings.image_mobile
	if forloop.first and section.index < 3
		assign lazy_loading = false
		assign fetchpriority = 'high'
	else
		assign lazy_loading = 'lazy'
		assign fetchpriority = 'low'
	endif
%}
{% capture properties %}
	--content-max-width: {{ block.settings.content_max_width }}px;
	--content-background-opacity: {{ block.settings.content_background_opacity | divided_by: 100.0 }};
	--image-overlay: {{ block.settings.image_overlay }};
{% endcapture %}
<div
	id="smi-slide-{{ block.id }}"
	class="smi-swiper-slide"
	style="{{ properties | strip_newlines | remove: '   ' }}"
	{{ block.shopify_attributes }}
>
	<div class="smi-slide-inner">
		{% assign block_scrolling = section.blocks | where: 'type', 'scrolling' %}
		{% if block_scrolling.size > 0 %}
			<div class="smi-scrolling-wrapper">
				{% for scrolling_item in block_scrolling %}
					<style>
						#shopify-section-{{ section.id }} #smi-{{ scrolling_item.id }} {
							--font-heading-scale: {{ scrolling_item.settings.text_scale_desktop | divided_by: 100.0 }};
							--smi-text-color: {{ scrolling_item.settings.custom_text_color }};
							--smi-item-gap: {{ scrolling_item.settings.text_gap }}px;
							--smi-item-opacity: {{ scrolling_item.settings.opacity | divided_by: 100.0 }};
							--smi-rotate: {{ scrolling_item.settings.rotate_desktop }}deg;
							--smi-scrolling-offset-y: {{ scrolling_item.settings.vertical_offset }}%;
							--smi-scrolling-offset-x: {{ scrolling_item.settings.horizontal_offset }}%;
						}
						#shopify-section-{{ section.id }} #smi-{{ scrolling_item.id }} .smi-outline-text {
							--color-foreground: {{ scrolling_item.settings.custom_outline_color.rgb }};
						}
						@media (max-width: 767px) {
							#shopify-section-{{ section.id }} #smi-{{ scrolling_item.id }} {
								--smi-rotate: {{ scrolling_item.settings.rotate_mobile }}deg;
								--font-heading-scale: {{ scrolling_item.settings.text_scale_mobile | divided_by: 100.0 }};
								--smi-scrolling-offset-y: {{ scrolling_item.settings.vertical_offset_mobile }}%;
								--smi-scrolling-offset-x: {{ scrolling_item.settings.horizontal_offset_mobile }}%;
							{% if scrolling_item.settings.hide_scrolling_on_mobile %} display: none !important;
							{% endif %}
							}
						}
					</style>
					<smi-scrolling-text-2 id="smi-{{ scrolling_item.id }}"
										  speed="{{ scrolling_item.settings.scrolling_speed }}">
						<div
							class="__smi-item {{ scrolling_item.settings.scrolling_direction | prepend: '__smi-animation-' }}" {{ block.shopify_attributes }}>
							{% if scrolling_item.settings.text_1 != empty %}
								<div
									class="__smi-item__text {{ scrolling_item.settings.text_size }} {% if scrolling_item.settings.outline_text_1 %}smi-outline-text{% endif %}" {{ block.shopify_attributes }}>
									{{ scrolling_item.settings.text_1 }}
								</div>
							{% endif %}
							{% if scrolling_item.settings.image != blank %}
								<div
									class="__smi-item__image smi-media-wrapper {{ settings.smi_animations_hover_image | default: shop.metafields.smind.settings.value.imageHoverEffect | default: 'none' | prepend: ' smi-hover-image-' }}"
									style=" --image-width:{{ scrolling_item.settings.image_width }}px">
									{{ scrolling_item.settings.image | image_url: width: scrolling_item.settings.image_width | image_tag: class: img_classes, widths: '200,300,400,500' }}
								</div>
							{% endif %}
							{% if scrolling_item.settings.text_2 != empty %}
								<div
									class="__smi-item__text {{ scrolling_item.settings.text_size }} {% if scrolling_item.settings.outline_text_2 %}smi-outline-text{% endif %}" {{ block.shopify_attributes }}>
									{{ scrolling_item.settings.text_2 }}
								</div>
							{% endif %}
						</div>
					</smi-scrolling-text-2>
				{% endfor %}
			</div>
		{% endif %}
		<div
			class="smi-slide-background smi-absolute-full {%- if block.settings.video_url %} smi-background-block{% endif -%}">
			<div class="smi-overlay" style="--smi-overlay-color: {{ block.settings.content_overlay_color }}"></div>
			{% if block.settings.media_type == 'image' %}
				{% assign placeholder_class = 'smi-placeholder-dark' %}
{% assign image_width = image_width | default: 2500 %}
{% assign placeholder_name = placeholder_name | default: "lifestyle-1" %}
{% assign placeholder_class = placeholder_class | default: "smi-placeholder-light" %}
<picture>
  {% if image_object_mobile != blank %}
    <source
      media="(max-width:767px)"
      srcset="
        {%- if image_object_mobile.width >= 400 -%}{{ image_object_mobile | image_url: width: 400 }} 400w,{%- endif -%}
        {%- if image_object_mobile.width >= 500 -%}{{ image_object_mobile | image_url: width: 500 }} 500w,{%- endif -%}
        {%- if image_object_mobile.width >= 600 -%}{{ image_object_mobile | image_url: width: 500 }} 600w,{%- endif -%}
        {%- if image_object_mobile.width >= 700 -%}{{ image_object_mobile | image_url: width: 500 }} 700w,{%- endif -%}
        {%- if image_object_mobile.width >= 800 -%}{{ image_object_mobile | image_url: width: 500 }} 800w,{%- endif -%}
        {%- if image_object_mobile.width >= 1000 -%}{{ image_object_mobile | image_url: width: 500 }} 1000w,{%- endif -%}
        {{ image_object_mobile | image_url }} {{ image_object_mobile.width }}w
      "
    >
  {% endif %}
  {% if image_object != blank %}
    {{
      image_object
      | image_url: width: image_width
      | image_tag:
        widths: '400,500,600,700,800,1000,1200,1400,1600,1920,2500',
        sizes: sizes,
        loading: lazy_loading,
        fetchpriority: fetchpriority,
        class: image_classes
    }}
  {% else %}
    {% if image_object_mobile == blank %}
      {{ placeholder_name | placeholder_svg_tag: placeholder_class }}
    {% else %}
      {% assign svg_class = 'smi-d-none smi-d-md-block ' | append: placeholder_class %}
      {{ placeholder_name | placeholder_svg_tag: svg_class }}
      <img
        class="smi-d-block smi-d-md-none"
        src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs="
        alt="placeholder"
      >
    {% endif %}
