<script type="text/javascript">
	(function() {
		const initializeSlider = () => {
			const containerEl = document.getElementById("smi-{{ section.id }}");
			containerEl.addEventListener("smi:slideshow:options", e => {
				const { options } = e.detail;
				options.speed = {{ section.settings.transition_duration | default: 600 }};
			});
			const slideshow = new SMI_Slideshow(containerEl);
		};
		if (Shopify.designMode) {
			if (document.readyState === "complete") {
				function check(counter = 0) {
					if (typeof SMI_Slideshow !== "undefined") return initializeSlider();
					if (counter < 10) setTimeout(check, 250, counter + 1);
				}
				check();
			}
			document.addEventListener("smiReloadSection", initializeSlider);
		}
		document.addEventListener("DOMContentLoaded", initializeSlider);
	})();
