<style>
  .blocko-footer3-{{ section.id }} {
    {% if section.settings.container_width == 'custom' %}
      width: {{ section.settings.custom_width_px }}px;
    {% else %}
      width: 100%;
    {% endif %}
    display: flex;
        margin:0 auto;
    max-width:100%;
    flex-direction: column;
    gap:{{ section.settings.gap }}px;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding: var(--blocko-footer-padding-y) var(--blocko-footer-padding-x);
    {% if section.settings.layout_type == 'image' and section.settings.layout_image != blank %}
      background-image: url({{ section.settings.layout_image | image_url }});
      background-size: cover;
      background-position: center;
    {% else %}
      background-color: {{ section.settings.layout_color }};
    {% endif %}
  }

  @media (max-width: 768px) {
    .blocko-footer3-{{ section.id }} {
      padding: var(--blocko-footer-padding-y-mb, var(--blocko-footer-padding-y)) var(--blocko-footer-padding-x-mb, var(--blocko-footer-padding-x));
    }
  }
</style>

<div
  class="blocko-footer3-{{ section.id }}"
  style="
    --blocko-footer-padding-x: {{ section.settings.horizontal_padding }}px;
    --blocko-footer-padding-y: {{ section.settings.vertical_padding }}px;
    --blocko-footer-padding-x-mb: {{ section.settings.horizontal_padding_mb }}px;
    --blocko-footer-padding-y-mb: {{ section.settings.vertical_padding_mb }}px;
  "
>
  {% content_for 'blocks' %}
</div>

