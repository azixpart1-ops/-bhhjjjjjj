<div class="smi-d-none smi-nro-item">&nbsp; </div>
{% schema %}
{
	"name": "✧Featured collection 6-7",
	"tag": "section",
	"class": "smi-section smi-profesyonel-item smi-featured-collection-6",
	"disabled_on": {
		"groups": [
			"header",
			"footer",
			"aside"
		]
	},
	"settings": [
		{
			"type": "select",
			"id": "display_on",
			"label": "Display on",
			"options": [
				{
					"value": "desktop",
					"label": "Desktop only"
				},
				{
					"value": "mobile",
					"label": "Mobile only"
				},
				{
					"value": "all",
					"label": "All device"
				}
			],
			"default": "all"
		},
		{
			"type": "checkbox",
			"id": "full_width",
			"label": "Container full-width",
			"default": false
		},
		{
			"type": "checkbox",
			"id": "custom_width",
			"label": "Custom width",
			"default": false,
			"visible_if": "{{ section.settings.full_width == false }}"
		},
		{
			"type": "range",
			"id": "section_width",
			"label": "Section width",
			"min": 800,
			"max": 2000,
			"step": 20,
			"unit": "px",
			"default": 1200,
			"visible_if": "{{ section.settings.full_width == false and section.settings.custom_width == true }}"
		},
		{
			"type": "checkbox",
			"id": "enable_spacing",
			"label": "Enable spacing between items",
			"default": true
		},
		{
			"type": "range",
			"id": "number_items",
			"min": 2,
			"max": 24,
			"step": 1,
			"label": "Maximum items to show",
			"default": 10
		},
		{
			"type": "paragraph",
			"content": "Advanced font controls are available in Smind Style. [Learn more](https://docs.smind.io/guides/configuring-typography)"
		},
		{
			"type": "inline_richtext",
			"id": "sub_heading",
			"label": "Subheading",
			"default": "URNA CRAS MAURIS"
		},
		{
			"type": "select",
			"id": "sub_heading_size",
			"label": "Subheading size",
			"options": [
				{
					"value": "smi-text-sub",
					"label": "XS"
				},
				{
					"value": "smi-text-sub-sm",
					"label": "S"
				}
			],
			"default": "smi-text-sub"
		},
		{
			"type": "inline_richtext",
			"id": "heading",
			"label": "Heading",
			"default": "Happy Customers Say"
		},
		{
			"type": "select",
			"id": "heading_tags",
			"label": "Heading tags",
			"options": [
				{
					"value": "h1",
					"label": "H1"
				},
				{
					"value": "h2",
					"label": "H2"
				},
				{
					"value": "h3",
					"label": "H3"
				},
				{
					"value": "h4",
					"label": "H4"
				},
				{
					"value": "h5",
					"label": "H5"
				},
				{
					"value": "h6",
					"label": "H6"
				}
			],
			"default": "h2"
		},
		{
			"type": "select",
			"id": "heading_size",
			"label": "Heading size",
			"options": [
				{
					"value": "smi-h4",
					"label": "S"
				},
				{
					"value": "smi-h3",
					"label": "M"
				},
				{
