{%- liquid
  assign s = section.settings
-%}

{% render 'contrast-override', background_color: s.background_color, section_id: section.id %}

<div class="cc-section cc-section--flush" style="padding-block: clamp(2rem, 4vw, 3.5rem);">
  <div class="cc-container">
    <div class="cc-guarantee color-custom-{{ section.id }}" data-cc-reveal>
      <span class="cc-guarantee__seal">{% render 'cc-icon', icon: s.icon, size: 96 %}</span>

      <div>
        {%- if s.eyebrow != blank -%}
          <span class="cc-eyebrow" style="color: inherit; opacity: 0.7;">{{ s.eyebrow }}</span>
        {%- endif -%}
        {%- if s.heading != blank -%}<h2 class="cc-guarantee__title h3">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<p class="cc-guarantee__text">{{ s.text }}</p>{%- endif -%}
      </div>

      {%- if s.button_label != blank -%}
        <div>
          <a
            href="{{ s.button_link | default: '#' }}"
            class="button button-secondary"
            style="--color-secondary-button-text: currentColor; --color-secondary-button-border: currentColor;"
          >
            {{ s.button_label }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Guarantee band",
  "tag": "section",
  "class": "cc-section-guarantee",
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "shield", "label": "Shield" },
        { "value": "moon", "label": "Sleep" },
        { "value": "award", "label": "Award" },
        { "value": "return", "label": "Returns" },
        { "value": "hand", "label": "Handmade" }
      ],
      "default": "moon"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Risk-free" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sleep on it for 100 nights" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "A bed is not something you can judge in a showroom. Live with yours for 100 nights — if it isn't right, we collect it and refund you in full. No restocking fee, no need to keep the box."
    },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Read the promise" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#2f3d34"
    }
  ],
  "presets": [
    {
      "name": "Guarantee band",
      "category": "Conversion"
    }
  ]
}
{% endschema %}
