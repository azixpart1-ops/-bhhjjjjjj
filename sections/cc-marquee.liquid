{%- liquid
  assign s = section.settings
-%}

{%- if section.blocks.size > 0 -%}
  {% render 'contrast-override', background_color: s.background_color, section_id: section.id %}

  <div class="cc-marquee color-custom-{{ section.id }}" style="--cc-marquee-duration: {{ s.duration }}s;">
    <div class="cc-marquee__track" data-cc-marquee>
      {%- for block in section.blocks -%}
        <span class="cc-marquee__item" {{ block.shopify_attributes }}>
          {%- if s.show_icons -%}{% render 'cc-icon', icon: block.settings.icon, size: 16 %}{%- endif -%}
          {{ block.settings.text }}
        </span>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "USP marquee",
  "tag": "section",
  "class": "cc-section-marquee",
  "settings": [
    { "type": "checkbox", "id": "show_icons", "label": "Show icons", "default": true },
    {
      "type": "range",
      "id": "duration",
      "label": "Scroll duration",
      "min": 15,
      "max": 90,
      "step": 5,
      "unit": "s",
      "default": 45
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#2f3d34"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Message",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Delivery" },
            { "value": "clock", "label": "Time" },
            { "value": "return", "label": "Returns" },
            { "value": "shield", "label": "Guarantee" },
            { "value": "lock", "label": "Secure" },
            { "value": "card", "label": "Payment" },
            { "value": "headset", "label": "Support" },
            { "value": "check-circle", "label": "Tick" },
            { "value": "ruler", "label": "Sizing" },
            { "value": "moon", "label": "Sleep" },
            { "value": "bed", "label": "Bed" },
            { "value": "hand", "label": "Handmade" },
            { "value": "leaf", "label": "Sustainable" },
            { "value": "award", "label": "Award" },
            { "value": "sparkle", "label": "Sparkle" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Free UK mainland delivery" }
      ]
    }
  ],
  "presets": [
    {
      "name": "USP marquee",
      "category": "Conversion",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "text": "Free UK mainland delivery" } },
        { "type": "item", "settings": { "icon": "clock", "text": "Dispatched in 1–4 working days" } },
        { "type": "item", "settings": { "icon": "return", "text": "Easy 30-day returns" } },
        { "type": "item", "settings": { "icon": "lock", "text": "Secure checkout" } },
        { "type": "item", "settings": { "icon": "headset", "text": "UK support, Mon–Fri 9am–5pm" } }
      ]
    }
  ]
}
{% endschema %}
