{{ 'modulo-section-announcement-icons.css' | asset_url | stylesheet_tag }}

{%- liquid
  # ─── Messages
  assign message_count = section.blocks.size

  # ─── Ticker
  assign enable_ticker  = section.settings.enable_ticker
  assign ticker_speed   = section.settings.ticker_speed | default: 30
  assign ticker_dir     = section.settings.ticker_direction | default: 'left'
  assign pause_on_hover  = section.settings.pause_on_hover

  # ─── Position
  assign sticky      = section.settings.sticky
  assign full_width  = section.settings.full_width
  assign content_max = section.settings.content_max_width | default: 1200
  assign pad_top     = section.settings.padding_top | default: 12
  assign pad_bottom  = section.settings.padding_bottom | default: 12

  # ─── Icons
  assign icon_size  = section.settings.icon_size | default: 18
  assign icon_color = section.settings.icon_color | default: '#1C1D17'
  assign icon_gap   = section.settings.icon_gap | default: 10

  # ─── Text
  assign uppercase   = section.settings.uppercase
  assign text_weight = section.settings.text_weight | default: '600'
  assign size_d      = section.settings.text_size_desktop | default: 13
  assign size_m      = section.settings.text_size_mobile | default: 12
  assign use_custom_font = section.settings.use_custom_font
  assign font        = section.settings.font
  assign use_font    = false
  if use_custom_font and font != blank
    assign use_font = true
  endif

  # ─── Dividers + edges
  assign show_dividers = section.settings.show_dividers
  assign divider_style = section.settings.divider_style | default: 'dot'
  assign fade_edges    = section.settings.fade_edges

  assign divider_glyph = '●'
  case divider_style
    when 'sparkle'
      assign divider_glyph = '✦'
    when 'slash'
      assign divider_glyph = '/'
    when 'pipe'
      assign divider_glyph = '|'
  endcase

  # ─── Gap: wider when the icon separates items, tighter when a divider glyph does
  assign gap_px = 44
  if show_dividers
    assign gap_px = 22
  endif

  # ─── Colors
  assign bg_style   = section.settings.bg_style | default: 'solid'
  assign bg_color   = section.settings.bg_color | default: '#F6F7F1'
  assign bg_glow    = section.settings.bg_color_glow | default: '#363643'
  assign text_color = section.settings.text_color | default: '#1C1D17'
  assign accent     = section.settings.accent_color | default: '#B23B12'

  assign bg_value = bg_color
  if bg_style == 'gradient'
    assign bg_value = 'radial-gradient(120% 200% at 50% 50%, ' | append: bg_glow | append: ' 0%, ' | append: bg_color | append: ' 80%)'
  endif

  # ─── Ticker only makes sense with 2+ messages
  assign ticker_on = false
  if enable_ticker and message_count > 1
    assign ticker_on = true
  endif

  # ─── Root class
  assign root_class = 'modulo-ai'
  if sticky
    assign root_class = root_class | append: ' modulo-ai--sticky'
  endif
  if ticker_on
    assign root_class = root_class | append: ' modulo-ai--ticker'
    if ticker_dir == 'right'
      assign root_class = root_class | append: ' modulo-ai--dir-right'
    else
      assign root_class = root_class | append: ' modulo-ai--dir-left'
    endif
    if pause_on_hover
      assign root_class = root_class | append: ' modulo-ai--pausable'
    endif
  endif
  if fade_edges
    assign root_class = root_class | append: ' modulo-ai--fade'
  endif
  if uppercase
    assign root_class = root_class | append: ' modulo-ai--upper'
  endif
  unless full_width
    assign root_class = root_class | append: ' modulo-ai--boxed'
  endunless
-%}

{%- if use_font -%}
  <style>{{ font | font_face: font_display: 'swap' }}</style>
{%- endif -%}

{%- if message_count > 0 -%}
  <div
    class="{{ root_class }}"
    role="region"
    aria-label="Announcements"
    style="
      --modulo-ai-bg:{{ bg_value }};
      --modulo-ai-text:{{ text_color }};
      --modulo-ai-accent:{{ accent }};
      --modulo-ai-icon:{{ icon_color }};
      --modulo-ai-icon-size:{{ icon_size }}px;
      --modulo-ai-icon-gap:{{ icon_gap }}px;
      --modulo-ai-size-d:{{ size_d }}px;
      --modulo-ai-size-m:{{ size_m }}px;
      --modulo-ai-weight:{{ text_weight }};
      --modulo-ai-pad-top:{{ pad_top }}px;
      --modulo-ai-pad-bottom:{{ pad_bottom }}px;
      --modulo-ai-gap:{{ gap_px }}px;
      --modulo-ai-max-w:{{ content_max }}px;
      --modulo-ai-speed:{{ ticker_speed }}s;
      {%- if use_font %}--modulo-ai-font:{{ font.family }}, {{ font.fallback_families }};{% endif %}
    "
  >
    <div class="modulo-ai__viewport"{% if ticker_on %} data-modulo-fs{% endif %}>
      <div class="modulo-ai__track{% unless ticker_on %} modulo-ai__track--static{% endunless %}"{% if ticker_on %} data-modulo-fs-track{% endif %}>
        {%- for block in section.blocks -%}
          {%- liquid
            assign src = block.settings.icon_source | default: 'icon'
            assign item_class = 'modulo-ai__item'
            if block.settings.animate and src == 'icon'
              assign item_class = item_class | append: ' modulo-ai__item--drive'
            endif
            assign has_link = false
            if block.settings.link != blank
              assign has_link = true
            endif
          -%}
          {%- if block.settings.text != blank -%}
            {%- capture glyph -%}
              {%- case src -%}
                {%- when 'icon' -%}{%- if block.settings.icon != blank -%}<span class="modulo-ai__icon" aria-hidden="true">{%- render 'modulo-icons', name: block.settings.icon -%}</span>{%- endif -%}
                {%- when 'emoji' -%}{%- if block.settings.emoji != blank -%}<span class="modulo-ai__emoji" aria-hidden="true">{{ block.settings.emoji | escape }}</span>{%- endif -%}
                {%- when 'image' -%}{%- if block.settings.custom_icon != blank -%}<span class="modulo-ai__icon" aria-hidden="true"><img class="modulo-ai__icon-img" src="{{ block.settings.custom_icon | image_url: width: 96 }}" alt="" width="48" height="48" loading="lazy"></span>{%- endif -%}
              {%- endcase -%}
            {%- endcapture -%}
            {%- if has_link -%}
              <a class="{{ item_class }} modulo-ai__item--link" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ glyph }}<span class="modulo-ai__text">{{ block.settings.text }}</span></a>
            {%- else -%}
              <span class="{{ item_class }}" {{ block.shopify_attributes }}>{{ glyph }}<span class="modulo-ai__text">{{ block.settings.text }}</span></span>
            {%- endif -%}
            {%- if show_dividers -%}
              {%- if ticker_on or forloop.last == false -%}
                <span class="modulo-ai__divider" aria-hidden="true">{{ divider_glyph }}</span>
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="modulo-ai modulo-ai--empty" role="region" aria-label="Announcements">
    <span class="modulo-ai__text">Add a message block in the theme editor →</span>
  </div>
{%- endif -%}

{%- if ticker_on -%}
  <script src="{{ 'modulo-section-feature-scroll.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Modulo: Icon Ticker",
  "tag": "div",
  "class": "modulo-ai-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "header", "content": "Ticker" },
    { "type": "checkbox", "id": "enable_ticker", "label": "Scroll messages (ticker)", "default": true, "info": "Scrolls messages across the bar in a seamless loop. With a single message it stays static and centered." },
    { "type": "range", "id": "ticker_speed", "label": "Speed", "min": 10, "max": 80, "step": 2, "unit": "s", "default": 30, "info": "Seconds per loop. Lower = faster.", "visible_if": "{{ section.settings.enable_ticker }}" },
    {
      "type": "select", "id": "ticker_direction", "label": "Direction", "default": "left",
      "options": [
        { "value": "left",  "label": "Right to left" },
        { "value": "right", "label": "Left to right" }
      ],
      "visible_if": "{{ section.settings.enable_ticker }}"
    },
    { "type": "checkbox", "id": "pause_on_hover", "label": "Pause on hover / focus", "default": true, "visible_if": "{{ section.settings.enable_ticker }}" },

    { "type": "header", "content": "Position" },
    { "type": "checkbox", "id": "sticky", "label": "Stick to top on scroll", "default": true, "info": "Keeps the bar visible as customers scroll. Turn off if your theme header is already sticky (avoids overlap)." },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": true, "info": "Bar background spans the full screen. Turn off to constrain content to a max width." },
    { "type": "range", "id": "content_max_width", "label": "Max content width", "min": 600, "max": 1600, "step": 20, "unit": "px", "default": 1200, "visible_if": "{{ section.settings.full_width == false }}" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 4, "max": 32, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 4, "max": 32, "step": 1, "unit": "px", "default": 12 },

    { "type": "header", "content": "Icons" },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 18 },
    { "type": "color", "id": "icon_color", "label": "Icon color", "default": "#1C1D17" },
    { "type": "range", "id": "icon_gap", "label": "Gap between icon and text", "min": 4, "max": 16, "step": 1, "unit": "px", "default": 10 },

    { "type": "header", "content": "Text" },
    { "type": "checkbox", "id": "uppercase", "label": "Uppercase", "default": false },
    {
      "type": "select", "id": "text_weight", "label": "Weight", "default": "600",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Heavy" }
      ]
    },
    { "type": "range", "id": "text_size_desktop", "label": "Text size (desktop)", "min": 11, "max": 22, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "text_size_mobile", "label": "Text size (mobile)", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 12 },
    { "type": "checkbox", "id": "use_custom_font", "label": "Use a custom font", "default": false, "info": "Off = use your theme's font." },
    { "type": "font_picker", "id": "font", "label": "Font", "default": "assistant_n4", "visible_if": "{{ section.settings.use_custom_font }}" },

    { "type": "header", "content": "Dividers & edges" },
    { "type": "checkbox", "id": "show_dividers", "label": "Show a divider between messages", "default": false, "info": "The icon already separates each message — add a glyph too if you like." },
    {
      "type": "select", "id": "divider_style", "label": "Divider style", "default": "dot",
      "options": [
        { "value": "dot",     "label": "Dot ●" },
        { "value": "sparkle", "label": "Sparkle ✦" },
        { "value": "slash",   "label": "Slash /" },
        { "value": "pipe",    "label": "Pipe |" }
      ],
      "visible_if": "{{ section.settings.show_dividers }}"
    },
    { "type": "checkbox", "id": "fade_edges", "label": "Soft faded edges", "default": true, "info": "Fades the left and right edges of the bar." },

    { "type": "header", "content": "Colors" },
    {
      "type": "select", "id": "bg_style", "label": "Background style", "default": "solid",
      "options": [
        { "value": "solid",    "label": "Solid" },
        { "value": "gradient", "label": "Gradient (center glow)" }
      ]
    },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F6F7F1" },
    { "type": "color", "id": "bg_color_glow", "label": "Center glow", "default": "#FFFFFF", "info": "The centre of the gradient. Keep it close to your background so text stays readable.", "visible_if": "{{ section.settings.bg_style == 'gradient' }}" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1C1D17" },
    { "type": "color", "id": "accent_color", "label": "Accent (bold words + dividers)", "default": "#B23B12" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "select", "id": "icon_source", "label": "Icon", "default": "icon",
          "options": [
            { "value": "icon",  "label": "Icon library" },
            { "value": "emoji", "label": "Emoji" },
            { "value": "image", "label": "Custom image" },
            { "value": "none",  "label": "No icon" }
          ]
        },
        {
          "type": "select", "id": "icon", "label": "Icon (Google Material)", "default": "local_shipping",
          "visible_if": "{{ block.settings.icon_source == 'icon' }}",
          "options": [
            { "value": "local_shipping",        "label": "Truck — shipping" },
            { "value": "delivery_truck_speed",  "label": "Truck — fast delivery" },
            { "value": "package_2",             "label": "Package" },
            { "value": "autorenew",             "label": "Returns / exchange" },
            { "value": "support_agent",         "label": "Support agent" },
            { "value": "headset",               "label": "Headset" },
            { "value": "encrypted",             "label": "Secure — encrypted" },
            { "value": "lock",                  "label": "Lock" },
            { "value": "verified_solid",        "label": "Verified seal" },
            { "value": "shield",                "label": "Shield" },
            { "value": "local_fire_department", "label": "Hot deal — fire" },
            { "value": "sell",                  "label": "Discount tag" },
            { "value": "bolt",                  "label": "Lightning" },
            { "value": "redeem",                "label": "Free gift" },
            { "value": "celebration",           "label": "Celebrate" },
            { "value": "percent",               "label": "Percent" },
            { "value": "savings",               "label": "Savings" },
            { "value": "star",                  "label": "Star" },
            { "value": "globe",                 "label": "Worldwide" },
            { "value": "leaf",                  "label": "Eco" },
            { "value": "credit_card",           "label": "Payment" },
            { "value": "award",                 "label": "Award" }
          ]
        },
        { "type": "text", "id": "emoji", "label": "Emoji", "info": "A single emoji, e.g. 🔥", "visible_if": "{{ block.settings.icon_source == 'emoji' }}" },
        { "type": "image_picker", "id": "custom_icon", "label": "Custom image", "info": "A small square PNG/SVG.", "visible_if": "{{ block.settings.icon_source == 'image' }}" },
        { "type": "checkbox", "id": "animate", "label": "Animate this icon", "default": false, "info": "Subtle drive-bob — best on the delivery truck. Respects reduced-motion.", "visible_if": "{{ block.settings.icon_source == 'icon' }}" },
        { "type": "inline_richtext", "id": "text", "label": "Message", "info": "Bold any word(s) to highlight them in the accent colour. Select text to add an inline link — but not if you also set the whole-message Link below.", "default": "Free shipping on orders over $100" },
        { "type": "url", "id": "link", "label": "Link (optional)", "info": "Makes the whole message tappable. If you use this, don't also link words inside the message." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Modulo: Icon Ticker",
      "blocks": [
        { "type": "message", "settings": { "icon_source": "icon", "icon": "local_shipping", "text": "Free shipping on orders over <b>$100</b>" } },
        { "type": "message", "settings": { "icon_source": "icon", "icon": "autorenew", "text": "30 day return policy" } },
        { "type": "message", "settings": { "icon_source": "icon", "icon": "support_agent", "text": "24/7 customer support" } },
        { "type": "message", "settings": { "icon_source": "icon", "icon": "encrypted", "text": "Secure checkout" } }
      ]
    }
  ]
}
{% endschema %}
