d):before{content:"";width:3px;height:3px;border-radius:3px;background:rgba(var(--color-foreground), 0.75);position:absolute;left:0;top:50%;transform:translateY(-50%)}.smi-section-blog-page-1 .smi-block-recent-post .item-list__content ._title{width:100%;color:rgba(var(--color-foreground), 1)}.smi-section-blog-page-1 .smi-block-recent-post .item-list__content ._details{width:100%;color:rgba(var(--color-foreground), 1)}.smi-section-blog-page-1 .smi-block-recent-post .item-list__content ._details span{display:inline-block;font-size:14px;margin-right:4px}.smi-section-blog-page-1 .smi-block-popular-product .item-list{margin-right:0;padding:0;gap:16px;display:flex;flex-wrap:wrap}.smi-section-blog-page-1 .smi-block-popular-product .item-list>li{gap:12px;width:100%}.smi-section-blog-page-1 .smi-block-popular-product .item-list__thumb{flex:0 0 70px;width:70px}.smi-section-blog-page-1 .smi-block-popular-product .item-list__thumb a{display:block;height:auto;aspect-ratio:var(--image-ratio, auto)}.smi-section-blog-page-1 .smi-block-popular-product .item-list__thumb img,.smi-section-blog-page-1 .smi-block-popular-product .item-list__thumb svg{width:100%;height:100%;object-fit:cover}.smi-section-blog-page-1 .smi-block-popular-product .item-list__content ._title{width:100%;color:rgba(var(--color-foreground), 1)}.smi-section-blog-page-1 .smi-block-popular-product .item-list__content ._price-max{color:rgba(var(--color-foreground), 0.55);text-decoration:line-through;margin-right:8px}.smi-blog-page-1-main{display:flex;column-gap:36px}.smi-blog-page-1-main .smi-article--standard .smi-article-detail-content{background:rgba(0,0,0,0) !important}@media screen and (max-width: 767.8px){.smi-blog-page-1-main{flex-wrap:wrap;row-gap:48px}}.smi-blog-page-1-main .smi-product-wrap{flex:1 1 auto;--color-border-section: var(--color-foreground);--color-shadow-section: var(--color-shadow)}@media screen and (max-width: 767.8px){.smi-blog-page-1-main .smi-product-wrap{width:100%;flex:1 1 100%;padding-left:0}}
</style>
<div
  id="smi-{{ section.id }}"
  class="smi-{{ section.id }} smi-display-settings smi-display-{{ section.settings.display_on }} smi-section__inner smi-gradient smi-section-blog-page-1 smi-color-{{ section.settings.color_scheme }}"
  data-section="blog-page-1"
  data-name="✧Blog page 1"
>
  
  {% liquid
    assign background_block = section.blocks | where: 'type', 'background' | first
    if background_block
      render 'smi-background'
    endif
  %}
  <div
    id="smi_collection_page_{{ section.id }}"
    class="
      {% liquid
          echo ' smi-blog-page-1-main'
          if section.settings.container_full_width == true
          echo ' smi-container-fluid'
          else
              echo ' smi-container'
          endif
      %}
    "
  >
    <aside
      class="
        smi-sidebar smi-order-3
        {%- if st.show_sidebar_on_mobile == false %} smi-d-none smi-d-md-flex{% endif -%}
        {%- if st.sidebar_position == 'left' %} smi-order-md-1{% else %} smi-order-md-3{% endif -%}
      "
    >
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'categories' %}
            <div class="smi-block-categories smi-sb-widget {%- if st.enable_collapsible_sidebar_on_mobile %} smi-sb-widget--hide{% endif -%}" {{ block.shopify_attributes }}>
    <div class="smi-sb-widget__title smi-sb-widget__click-area {{ section.settings.heading_size }}">
        <span class="smi-link-wrapper">{{ block.settings.heading }}</span>
        <div class="smi-sb-widget__btn">
            {% render 'smi-icons', icon: 'minus' %}
            {% render 'smi-icons', icon: 'minus' %}
        </div>
    </div>
    <div class="smi-sb-widget__content">
        <ul>
            {% assign menu = block.settings.menu %}
            {% for link in menu.links -%}
                <li class="smi-mb-sm {% if link.active %} active{% endif %}">
                    {{ link.title | link_to: link.url }}
                </li>
            {% else %}
                <li class="smi-mb-sm">
                    <a href="#" title="">Example category link</a>
                </li>
            {%- endfor %}
        </ul>
    </div>
</div>
          {% when 'gallery' %}
            {% assign imageHoverClasses = settings.smi_animations_hover_image | default: shop.metafields.smind.settings.value.imageHoverEffect | default: 'none' |  prepend: ' smi-hover-image-' %}
<div class="smi-block-gallery smi-sb-widget {%- if st.enable_collapsible_sidebar_on_mobile %} smi-sb-widget--hide{% endif -%}" {{ block.shopify_attributes }}>
    <div class="smi-sb-widget__title smi-sb-widget__click-area {{ section.settings.heading_size }}">
        <span class="smi-link-wrapper">{{ block.settings.heading }}</span>
        <div class="smi-sb-widget__btn">
            {% render 'smi-icons', icon: 'minus' %}
            {% render 'smi-icons', icon: 'minus' %}
        </div>
    </div>
    <div class="smi-sb-widget__content
            {%- if block.settings.use_media_style_from_theme_settings %} smi-media-wrapper{% endif -%}">
        {% assign check = 0 %}
        {% for i in (1..6) %}
            {% liquid
                assign imgKey = 'image_' | append: i
                assign linkKey = 'link_' | append: i
            %}
            {% if block.settings[imgKey] != blank %}
                {% assign check = 1 %}
                <a href="{{ block.settings[linkKey] | default: '#' }}" aria-label="{{ 'Image gallery' }}"
                    {% if block.settings.open_link_in_new_tab %}target="_blank"{% endif %}
                    class="{%- if block.settings.use_media_style_from_theme_settings %} smi-border smi-shadow{% endif -%} {{ imageHoverClasses }}">
					{% if is_reference %}
						{{ images[block.settings[imgKey]] | image_url: width: 150 | image_tag: loading: 'lazy'}}
					{% else %}
						{{ block.settings[imgKey] | image_url: width: 150 | image_tag: loading: 'lazy'}}
					{% endif %}                    
                </a>
            {% endif %}
        {% endfor %}
        {% if check == 0 %}
            <a href="#">
                {{ 'image' | placeholder_svg_tag: 'smi-placeholder smi-w-100 smi-h-auto smi-placeholder-light' }}
            </a>
        {% endif %}
    </div>
</div>
          {% when 'social_media' %}
<div class="smi-block-social smi-sb-widget {%- if st.enable_collapsible_sidebar_on_mobile %} smi-sb-widget--hide{% endif -%}" {{ block.shopify_attributes }}>
    <div class="smi-sb-widget__title smi-sb-widget__click-area {{ section.settings.heading_size }}">
        <span class="smi-link-wrapper">{{ block.settings.heading }}</span>
        <div class="smi-sb-widget__btn">
            {% render 'smi-icons', icon: 'minus' %}
            {% render 'smi-icons', icon: 'minus' %}
        </div>
    </div>
    <div class="smi-sb-widget__content">
        <div class="smi-d-flex smi-flex-wrap smi-column-gap-sm smi-row-gap-sm">
            {% assign arr = "facebook,instagram,youtube,tiktok,twitter,spanchat,pinterest,tumblr,vimeo" | split: ',' %}
            {% for i in arr %}
                {% liquid
                    assign optionKey = "smi_social_" | append: i | append: "_link"
                    assign optionKey = "smi_social_" | append: i | append: "_link"
                    if settings[optionKey]
                        assign url = settings[optionKey] | strip
                    else
                        assign url = shop.metafields.smind.settings.value.socialMedia[i] | strip
                    endif
                %}
                {% if url != blank %}
                    <a target="_blank"
                       href="{{ url }}"
                       aria-label="{{ i }}"
                       class="smi-social2-item smi-social2-item--{{ block.settings.icon_style }}"
                       style="--social2-size: {{ block.settings.icon_size }}px"
                    >
                        {% render 'smi-icons', icon: i %}
                    </a>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</div>
          {% when 'image_banner' %}
            {% assign imageHoverClasses = settings.smi_animations_hover_image | default: shop.metafields.smind.settings.value.imageHoverEffect | default: 'none' |  prepend: ' smi-hover-image-' %}
<div class="smi-block-image-banner smi-sb-widget" {{ block.shopify_attributes }}>
    <div class="smi-sb-widget__content smi-lh-0 smi-overflow-hidden {%- if block.settings.use_media_style_from_theme_settings %} smi-media-wrapper smi-border smi-shadow{% endif -%}">
        <a href="{{ block.settings.link | default: '#' }}" aria-label="banner"
           {% if block.settings.open_link_in_new_tab %}target="_blank"{% endif %}
           class="{{ imageHoverClasses }} smi-d-block">
            {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'smi-h-auto'}}
            {% else %}
                {{ 'image' | placeholder_svg_tag: 'smi-placeholder smi-w-100 smi-h-auto smi-placeholder-light' }}
            {%- endif -%}
        </a>
    </div>   
</div>
          {% when 'tags' %}
            <div class="smi-block-tags smi-block-tags--{{ block.settings.style }} smi-sb-widget {%- if st.enable_collapsible_sidebar_on_mobile %} smi-sb-widget--hide{% endif -%}" {{ block.shopify_attributes }}>
    <div class="smi-sb-widget__title smi-sb-widget__click-area {{ section.settings.heading_size }}">
        <span class="smi-link-wrapper">{{ block.settings.heading }}</span>
        <div class="smi-sb-widget__btn">
            {% render 'smi-icons', icon: 'minus' %}
            {% render 'smi-icons', icon: 'minus' %}
        </div>
    </div>
    <div class="smi-sb-widget__content">
        <ul>
            {% for tag in blog.all_tags limit: 12 %}
                {% if current_tags contains tag %}
                    <li class="active">
                        <span>{{ tag }}</span>
                    </li>
                {% else %}
                    <li>
                        <a href="{{ blog.url }}/tagged/{{ tag | handle }}" rel="tag"><span>{{ tag | remove : 'blog_' | strip }}</span></a>
                    </li>
                {% endif %}
            {% endfor %}
        </ul>
    </div>
</div>
          {% when 'recent_post' %}
            {% assign media_style = block.settings.use_media_style_from_theme_settings %}
<div class="smi-block-recent-post smi-sb-widget {%- if st.enable_collapsible_sidebar_on_mobile %} smi-sb-widget--hide{% endif -%}" {{ block.shopify_attributes }}>
    <div class="smi-sb-widget__title smi-sb-widget__click-area {{ section.settings.heading_size }}">
        <span class="smi-link-wrapper">{{ block.settings.heading }}</span>
        <div class="smi-sb-widget__btn">
            {% render 'smi-icons', icon: 'minus' %}
            {% render 'smi-icons', icon: 'minus' %}
        </div>
    </div>
    <div class="smi-sb-widget__content">
        <ul class="item-list smi-d-flex smi-flex-wrap {% if media_style %} smi-media-wrapper{% endif %}">
            {% for article in block.settings.blog.articles limit: block.settings.maximum_items_to_show %}
                <li class="smi-d-flex">
                    {% if block.settings.show_thumbnail %}
                        <a class="item-list__thumb {% if media_style %} smi-border smi-shadow{% endif %}" href="{{ article.url }}">
                            {{ article.image | image_url: width: 120 | image_tag }}
                        </a>
                    {% endif %}
                    <div class="item-list__content">
                        {% if block.settings.show_tags %}
                        <div class="_tags">
                            <ul>
                                {% for tag in article.tags limit: 2 %}
                                    <li>{{ tag }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                        {% endif %}
                        <a class="_title smi-h5" href="{{ article.url }}">
                            {{ article.title }}
                        </a>
                        {% if block.settings.show_author or block.settings.show_date %}
                            <div class="_details">
                                {% if block.settings.show_author %}
                                    <span class="smi-color-text-75">by</span>
                                    <span class="_author">
                                        {{- article.author -}}
                                    </span>
                                {% endif %}
                                {% if block.settings.show_date %}
                                    <span class="smi-color-text-75">on</span>
                                    <span class="_date">
                                        <time datetime="{{- article.published_at | date: '%b %d %Y' -}}">
                                            {{- article.published_at | date: '%b %d %Y' -}}
                                        </time>
                                    </span>
                                {% endif %}
                            </div>
                        {% endif %}
                    </div>
                </li>
            {% else %}
                <li class="smi-d-flex">
                    <a aria-label="image" class="item-list__thumb" href="#">
                        {{ 'image' | placeholder_svg_tag: 'smi-placeholder smi-wh-100 smi-placeholder-light' }}
                    </a>
                    <div class="item-list__content">
                        <div class="_tags">
                            <ul>
                                <li>Cotton</li>
                                <li>Summer</li>
                            </ul>
                        </div>
                        <a class="_title" href="#">
                            Example blog post title
                        </a>
                        <div class="_details">
                            <span class="smi-color-text-75">by</span>
                            <span class="_author">Admin</span>
                            <span class="smi-color-text-75">on</span>
                            <span class="_date">
                                  <time datetime="Mar 27 2024">Mar 27 2024</time>
                            </span>
                        </div>
                    </div>
                </li>
            {% endfor %}
        </ul>
    </div>
</div>
          {% when 'popular_product' %}
            <div
  class="smi-block-popular-product smi-sb-widget {%- if st.enable_collapsible_sidebar_on_mobile %} smi-sb-widget--hide{% endif -%}"
  {{ block.shopify_attributes }}
>
  <div class="smi-sb-widget__title smi-sb-widget__click-area {{ section.settings.heading_size }}">
    <span class="smi-link-wrapper">{{ block.settings.heading }}</span>
    <div class="smi-sb-widget__btn">
      {% render 'smi-icons', icon: 'minus' %}
      {% render 'smi-icons', icon: 'minus' %}
    </div>
  </div>
  <div class="smi-sb-widget__content">
    <ul class="item-list">
		{% for _product in block.settings.products %}
			{% if is_reference %}
				{% assign product = all_products[_product] %}
			{% else %}
				{% assign product = _product %}
			{% endif %}
        <li class="smi-d-flex">
          <div
            class="item-list__thumb smi-lh-0 smi-overflow-hidden {%- if block.settings.use_media_style_from_theme_settings %} smi-media-wrapper smi-border smi-shadow{% endif -%}"
            style="--image-ratio:{{ block.settings.media_ratio }}"
          >
            <a class="smi-lh-0" href="{{ product.url }}">
              {{ product.featured_image | image_url: width: 150 | image_tag: loading: 'lazy' }}
            </a>
          </div>
          <div class="item-list__content">
            <a
              class="_title smi-h5"
              href="{{ product.url }}"
            >
              {{ product.title }}
            </a>
            <div class="_details">
              {% liquid
                assign target = product.selected_or_first_available_variant
                assign compare_at_price = target.compare_at_price
                assign price = target.price
                assign currency_code_enabled = settings.smi_currency_code_enabled | default: shop.metafields.smind.settings.value.showCurrencyCode | default: false
                if currency_code_enabled
                  assign money_price = price | money_with_currency
                else
                  assign money_price = price | money
                endif
                if target == product and product.price_varies
                  assign money_price = 'products.product.price.from_price_html' | t: price: money_price
                endif
              %}
              <span class="_price">
                {%- unless product.price_varies == false and product.compare_at_price_varies %}
                  {%- if compare_at_price != blank and compare_at_price > price -%}
                    <span class="_price-max">
                      {% if currency_code_enabled %}
                        {{ compare_at_price | money_with_currency }}
                      {% else %}
                        {{ compare_at_price | money }}
                      {% endif %}
                    </span>
                  {%- endif -%}
                {%- endunless -%}
                <span class="_current-price">{{ money_price }}</span>
              </span>
            </div>
          </div>
        </li>
      {% else %}
        <li class="smi-d-flex">
          <div class="item-list__thumb" style="--image-ratio:3/4">
            <a href="#">
              {{ 'product-1' | placeholder_svg_tag: 'smi-placeholder smi-w-100 smi-placeholder-light' }}
            </a>
          </div>
          <div class="item-list__content">
            <a class="_title" href="#"> Example product title </a>
            <div class="_details">
              <span class="_price">
                <span class="_current-price">$96</span>
              </span>
            </div>
          </div>
        </li>
      {% endfor %}
    </ul>
  </div>
</div>
        {% endcase %}
      {% endfor %}
    </aside>
    <div class="smi-product-wrap smi-order-2" smind-key="blogs_per_page,default_pagination_style" smind-attributes smind-attr-content>
      <div
        class="
          {%- liquid
              echo ' smi-layout-grid'
              echo ' smi-article-card-wrapper'
              if section.settings.number_of_columns_on_desktop == '1'
                  echo ' smi-layout-grid--list'
              endif
              if section.settings.enable_spacing_between_items == false
                  echo ' smi-layout-grid--gap-0'
              endif
                if settings.smi_blog_card_style
                    assign card_type = settings.smi_blog_card_style
                else
                    assign global_settings = shop.metafields.smind.settings.value
                    assign card_type = global_settings.blogCardStyle | default: 'standard'
                endif
              echo ' smi-layout-grid--' | append: card_type
          -%}
        "
        style="--col-md:{{- section.settings.number_of_columns_on_desktop -}};--col-xs:{{ section.settings.number_of_columns_on_mobile }}"
      >
        {% paginate blog.articles by section.settings.blogs_per_page %}
          {% for article in blog.articles %}
            <div class="smi-item smi-col-item">
                {%-liquid
    assign media_ratio = section.settings.media_ratio
    assign media_shape = section.settings.media_shape
    assign media_classes = 'smi-w-100 smi-object-fit-cover '
    assign media_wrapper_classes = 'smi-media-wrapper smi-lh-0 smi-overflow-hidden smi-p-relative smi-' | append: media_shape
    if media_shape != 'default'
        if shape_index > 6 or shape_index == undefined
            assign shape_index = 1
        endif
        if shape_index < 6 
            assign forloop_next = shape_index | plus: 1
        else
            assign forloop_next = 1
        endif
        assign media_classes = media_classes | append: ' smi-shape-blob-' | append: shape_index
        if media_shape contains 'blob'
            assign media_wrapper_classes = media_wrapper_classes | append: ' smi-blob-wrapper smi-has-blob' |  append: ' smi-shape-blob-' | append: shape_index
        endif
        assign shape_index = shape_index | plus: 1
        assign shape_hover = '--shape-blob-' | append: forloop_next
    endif
    if media_ratio == 'auto' 
        assign media_classes = media_classes | append: ' smi-h-auto'
    else
        assign media_classes = media_classes | append: ' smi-h-100 smi-p-absolute'
    endif
-%}
                {% assign media_classes = media_classes | append: ' ariticle-image' %}
                {% render 'smi-article-card',
                        article: article,
                        media_ratio: media_ratio,
                        media_wrapper_classes: media_wrapper_classes,
                        media_classes: media_classes,
                        classes_position_content: classes_position_content,
                        button_style: section.settings.button_style,
                        shape_hover: shape_hover,
                        card_style: card_type,
                        blog_color: blog_color,
                        image_width: image_width,
                        sizes: sizes
                %}
            </div>
          {% endfor %}
        {% endpaginate %}
      </div>
      {% if blog.articles.size > section.settings.blogs_per_page %}
    <div class="smi-pagination smi-mt-xl smi-d-flex smi-justify-content-center">
        {% paginate blog.articles by section.settings.blogs_per_page %}
            {% case section.settings.pagination %}
                {% when "default" %}
                    <smi-cp-pagination class="smi-pagination-default smi-visibility-hidden
                    {{- ' smi-dps-' | append: section.settings.default_pagination_style -}}">
                        <div class="smi-d-none smi-data-next-arrow">{% render 'smi-icons', icon: 'arrow-right' %}</div>
                        {{ paginate | default_pagination }}
                    </smi-cp-pagination>
                {% when "load_more"%}
                    <smi-cp-pagination class="smi-pagination-load-more">
                        <a href="{{ paginate.next.url }}" class="smi-text-button">
                            <span>{{- 'smind.general.load_more' | t -}}</span>
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M17.9236 12.2976C17.5257 13.6699 16.7782 14.9153 15.7543 15.9119C14.7304 16.9085 13.4652 17.6221 12.0826 17.9828C10.7001 18.3435 9.24755 18.3389 7.86729 17.9696C6.48703 17.6002 5.22636 16.8787 4.20874 15.8757C3.19112 14.8727 2.45144 13.6226 2.06213 12.2478C1.67283 10.8731 1.64724 9.42075 1.98789 8.03312C2.32854 6.64549 3.02373 5.37012 4.0054 4.33191C4.98706 3.2937 6.22154 2.52823 7.58794 2.11049" stroke="#1F1F21" stroke-width="2" stroke-linecap="round" stroke-linejoin="bevel"/>
                            </svg>
                        </a>
