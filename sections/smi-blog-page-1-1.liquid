{% comment %}#component#["settings/display-settings-2","settings/container-full_width-2","settings/blog-card-2","settings/section-padding","settings/section-margin","blocks/background","settings/design-mode","settings/media-settings-5"]#endcomponent#{% endcomment %}
{% liquid
  	assign colorblock = section.blocks | where: 'type', 'color' | first
	assign blog_color = ' smi-color-' | append: section.settings.blog_color_scheme
  	assign st = section.settings
	if section.settings.content_alignment == 'left'
        assign classes_position_content = 'smi-justify-content-start content-text-alignment-left'
      elsif section.settings.content_alignment == 'right'
        assign classes_position_content = 'smi-justify-content-end content-text-alignment-right'
      else
        assign classes_position_content = 'smi-justify-content-center content-text-alignment-center'
      endif
%}
{% liquid
    unless image_width
        assign image_width = 1600
    endunless
    unless sizes
        assign percent_item_mobile = 100 | divided_by: section.settings.number_of_columns_on_mobile | default: 100
        assign percent_item_desktop = 100 | divided_by: section.settings.number_of_columns_on_desktop | default: 100
        assign percent_item_desktop = percent_item_desktop | at_most: 50
        assign sizes = '(max-width: 767px)' | append: percent_item_mobile | append: 'vw, (max-width: 991px) 50vw, ' | append: percent_item_desktop | append: 'vw'
    endunless
%}
