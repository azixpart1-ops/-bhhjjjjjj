{
	"name": "✧Rich content 1-5",
	"tag": "section",
	"class": "smi-section smi-basico-item smi-rich-content-1",
	"disabled_on": {
		"groups": [
			"header",
			"footer",
			"aside"
		]
	},
	"settings": [
		{
			"type": "select",
			"id": "display_on",
			"label": "Display on",
			"options": [
				{
					"value": "desktop",
					"label": "Desktop only"
				},
				{
					"value": "mobile",
					"label": "Mobile only"
				},
				{
					"value": "all",
					"label": "All device"
				}
			],
			"default": "all"
		},
		{
			"type": "select",
			"id": "full_width",
			"label": "Layout",
			"options": [
				{
					"value": "container",
					"label": "Boxed"
				},
				{
					"value": "container-fluid",
					"label": "Full width"
				},
				{
					"value": "container-fluid-no-padding",
					"label": "Full width (no padding)"
				}
			],
			"default": "container"
		},
		{
			"type": "checkbox",
			"id": "custom_width",
			"label": "Custom width",
			"default": false,
			"visible_if": "{{ section.settings.full_width == 'container' }}"
		},
		{
			"type": "range",
			"id": "section_width",
			"label": "Section width",
			"min": 800,
			"max": 2000,
			"step": 20,
			"unit": "px",
			"default": 1200,
			"visible_if": "{{ section.settings.custom_width == true and section.settings.full_width == 'container' }}"
		},
		{
			"type": "header",
			"content": "Media settings"
		},
		{
			"type": "image_picker",
			"id": "upload_image",
			"label": "Image"
		},
		{
			"type": "select",
			"id": "desktop_media_width",
			"label": "Desktop media width",
			"options": [
				{
					"value": "40",
					"label": "S"
				},
				{
					"value": "50",
					"label": "M"
				},
				{
					"value": "60",
					"label": "L"
				}
			],
			"default": "50"
		},
		{
			"type": "select",
			"id": "desktop_media_position",
			"label": "Desktop media position",
			"options": [
				{
