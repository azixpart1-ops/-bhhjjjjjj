<div class="smi-d-none smi-pods-item">&nbsp; </div>
{%- liquid
  assign media_height = section.settings.media_height
  assign collapse_index = 0
  assign media_shape = section.settings.media_shape
  assign content_position = section.settings.content_position
  assign content_alignment = section.settings.content_alignment
  assign color_pos = 0
  assign bkg_pos = 0
  for block in section.blocks
  if block.type == 'color'
  assign color_pos = forloop.index
  endif
  if block.type == 'background'
  assign bkg_pos = forloop.index
  endif
endfor
-%}
{%-liquid
    assign media_ratio = section.settings.media_ratio
    assign media_shape = section.settings.media_shape
    if media_shape == 'none'
        assign media_shape = 'hidden'
    endif
    assign media_classes = 'smi-w-100 smi-object-fit-cover '
    if media_shape != 'default' and media_shape != 'round'
        assign media_classes = media_classes | append: media_shape
    endif
    if media_ratio == 'auto' 
        assign media_classes = media_classes | append: ' smi-h-auto'
    else
        assign media_classes = media_classes | append: ' smi-h-100 smi-p-absolute'
    endif
    assign media_wrapper_classes = 'smi-media-wrapper smi-border smi-shadow smi-lh-0 smi-overflow-hidden smi-p-relative smi-' | append: media_shape
    if media_shape contains 'blob'
        assign media_wrapper_classes = media_wrapper_classes | append: ' smi-blob-wrapper smi-has-blob'
    endif
-%}
<script src="{{ 'smi-countdown-timer-new-2.min.js' | asset_url }}" defer data-id="smi-countdown-timer-new-2.min.js" data-section-id="smi-{{ section.id }}"></script>
<link rel="stylesheet" type="text/css" href="{{ 'smi-email-signup.min.css' | asset_url }}" media="screen" onload="this.onload=null;this.media='all'">
<div
  id="smi-{{ section.id }}"
  class="smi-{{ section.id }} smi-display-settings smi-display-{{ section.settings.display_on }} smi-section__inner smi-gradient smi-section-rich-content-1 smi-color-{{ section.settings.color_scheme }} smi-content-settings"
  data-section="rich-content-1" data-name="✧Rich content 1">
  
  {% liquid
    assign background_block = section.blocks | where: 'type', 'background' | first
    if background_block
      render 'smi-background'
    endif
  %}
  <input type="hidden" value="" id="interval_countdown_{{ section.id }}">
  <div class="smi-p-relative smi-{{ section.settings.full_width }}">
    <div class="smi-container-detail smi-d-flex smi-align-items-center smi-content-position-{{ section.settings.content_position }}">
        {%-liquid
    if settings.smi_animations_reveal_on_scroll != nil
        assign animation_scroll = settings.smi_animations_reveal_on_scroll
    else
        assign global_settings = shop.metafields.smind.settings.value
        assign animation_scroll = global_settings.revealOnScroll
    endif
-%}
      <div class="smi-section-block-{{ section.id }} smi-content-detail-padding-{{ section.settings.desktop_media_position }} smi-rich-content-detail smi-w-100 smi-rich-content-{{ 100 | minus: section.settings.desktop_media_width }} smi-w-md-{{ 100 | minus: section.settings.desktop_media_width }} smi-rich-content-load1-{{ section.id }} content-detail-{{ section.settings.full_width }}
        {%- if animation_scroll %} smi-scroll-trigger smi-animate--slide-in smi-animate-order-1 {% endif -%}"
        data-load='
          {
            "size": "{{ section.blocks.size }}"
          }
        '
        data-block='{
          "color_pos": "{{ color_pos }}", 
          "bkg_pos": "{{ bkg_pos }}",
          "all_block": {{ section.blocks.size }}
        }'
      >
        <div class="smi-content-max-width smi-d-flex smi-flex-wrap smi-rich-content-position-{{ section.settings.content_position }}">
        {% for block in section.blocks %}
          <div class="content-alignment-{{ section.settings.content_alignment }} smi-block-postion-{{ forloop.index }}-{{ section.id }} {% if block.type == "icon_with_text" %} smi-rich-content-half-{{ block.settings.half_width_on_large_screen }}{% endif %} smi-block-{{ block.type }} smi-block-type-{{ block.type }} smi-block-type-{{ block.type }}-{{ section.id }} {{- ' smi-rich-content smi-w-100' -}}
            {% liquid
              if block.type != 'color' and block.type != 'background'
                if block.type == 'button'
                  if forloop.index < section.blocks.size
                    echo ' smi-mb-md'
                  endif
                else
                  if forloop.index < section.blocks.size
                    echo '  smi-mb-lg'
                  endif
                endif
              endif
            %}
            "
            {{ block.shopify_attributes }} 
          >
            {% if block.type == 'heading' %}
              {%-liquid
    if settings.smi_animations_reveal_on_scroll != nil
        assign animation_scroll = settings.smi_animations_reveal_on_scroll
    else
        assign global_settings = shop.metafields.smind.settings.value
        assign animation_scroll = global_settings.revealOnScroll
    endif
-%}
<div
	class="smi-heading-component smi-heading-component--align-{{ block.settings.heading_alignment }} smi-link-wrapper" {{- block.shopify_attributes -}}
	{% if block.settings.heading_alignment  %} style="--heading-alignment: {{ block.settings.heading_alignment }}" {% endif %}>
	{% liquid
		assign heading = block.settings.heading | strip
		assign sub_heading = block.settings.sub_heading | strip
		assign description = block.settings.description | strip
		assign heading_tags = block.settings.heading_tags | default:'h2'
		assign heading_size = block.settings.heading_size
	%}
	<div class="smi-heading-inner
    {%- if animation_scroll %} smi-scroll-trigger smi-animate--slide-in{% endif -%}
    {%- if heading != blank or sub_heading != blank or description != blank %} smi-mb-xxl{% endif -%}
    ">
		{%- assign sub_heading = block.settings.sub_heading | strip -%}
{%- assign sub_heading_size = blank -%}
{% if block.settings.sub_heading_size != blank %}
	{%- assign sub_heading_size = '-mb ' | append:block.settings.sub_heading_size  | prepend: block.settings.sub_heading_size -%}
{% endif %}
{% if sub_heading != blank %}
    <p class="{% if sub_heading_size != blank %}{{sub_heading_size}}{% else %}smi-text-sub{% endif %} smi-mb-xs smi-heading-component__subheading" smind-key="sub_heading" smind-attributes smind-attr-text>{{- sub_heading -}}</p>
{% endif %}
		{%- assign description = block.settings.description | strip -%}
{%- assign heading = block.settings.heading | strip -%}
{% if heading != blank %}
    <{{heading_tags}} class="{{ heading_size }} {% if description != blank %}smi-mb-sm{% endif %} smi-heading-component__heading" smind-key="heading" smind-attributes smind-attr-text>{{- heading -}}</{{heading_tags}}>
{% endif %}
		{%- assign description = block.settings.description | strip -%}
{%- assign description_size = blank -%}
{% if block.settings.description_size != blank %}
	{%- assign description_size = '-mb ' | append:block.settings.description_size  | prepend: block.settings.description_size -%}
{% endif %}
{% if description != blank %}
    <div class="{% if description_size != blank %}{{description_size}}{% else %}smi-text-md{% endif %} smi-heading-component__description smi-format-content" smind-key="description" smind-attributes smind-attr-text>{{ description }}</div>
{% endif %}
	</div>
</div>
            {% endif %}
            {% if block.type == 'collapsible_content' %}
              {% assign collapse_index = collapse_index | plus: 1 %}
<div class="smi-component-blocks-collapsible-content">
{% if block.settings.heading != blank %}
  <div
    class="{{- 'collapsible-click default-collapsible collapsible-content-general ' -}}
    {% liquid
     if section.settings.collapsible_type ==  "1"
      echo ' smi-py-xs'
     elsif section.settings.collapsible_type == "2"
      echo ' smi-py-md smi-px-md'
     else
      echo ' smi-py-sm'
     endif
     if section.settings.collapsible_type == blank or section.settings.collapsible_type == ''
      echo ' default-collapsible-3'
     else
      echo ' default-collapsible-' | append: section.settings.collapsible_type
     endif
    %}
    "
    id="collapsible_detail_container_{{ forloop.index }}_{{ section.id }}"
  >
    <div class="collapse-heading collapse-content-{{ forloop.index }} collapse-content-heading-{{ forloop.index }}-{{ section.id }}">
      <div class="collapse-description-arrow">
        <span
          id="collapse_down_arr_{{ forloop.index }}_{{ section.id }}"
          class="collapse-desc-arr smi-mr-xs {% if collapse_index == 1 and section.settings.open_first_collapsible_row != false %} {% else %} collapse-desc-arr-show {% endif %}"
        >
          {% render 'smi-icons', icon: 'plus' %}
        </span>
        <span
          id="collapse_up_arr_{{ forloop.index }}_{{section.id}}"
          class="collapse-desc-arr smi-mr-xs {% if collapse_index == 1 and section.settings.open_first_collapsible_row != false %} collapse-desc-arr-show {% endif %}"
        >
          {% render 'smi-icons', icon: 'minus' %}
        </span>
      </div>
      <h3 class="collapse-title {{ block.settings.heading_size }} smi-link-wrapper">
        {{ block.settings.heading }}
      </h3>
    </div>
    {% if block.settings.content != blank or block.settings.collapse_content_page != blank %}
      <div
        class="collapse-desc-content smi-format-content smi-link-wrapper {% if collapse_index == 1 and section.settings.open_first_collapsible_row != false %} collapse-desc-content-show collapse-desc-content-first-{{ section.id }} {% endif %} {% if section.settings.collapsible_type == "1" %} smi-pt-xs {% else %} smi-pt-md {% endif %} smi-text-md smi-color-text-75"
        id="collapse_content_{{ forloop.index }}_{{ section.id }}"
      >
        {{ block.settings.content }}
        {% if block.settings.collapse_content_page != blank %}
          <br>
          {{ block.settings.collapse_content_page.content }}
        {% endif %}
      </div>
    {% endif %}
  </div>
{% endif %}
</div>
            {% endif %}
            {% if block.type == 'text' %}
              <div class="smi-component-blocks-text smi-text-md" {{- block.shopify_attributes -}}>
    <div class="smi-color-text-75 smi-link-wrapper {% if block.settings.content_size != blank %}{{ block.settings.content_size }} {{ block.settings.content_size }}-mb{% else %}smi-text-md{% endif %}">{{ block.settings.text | newline_to_br }}</div>
</div>
            {% endif %}
