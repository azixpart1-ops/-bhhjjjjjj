{%- liquid
  assign s = section.settings
  assign text_class = 'cc-hero--dark'
  if s.text_color == 'dark'
    assign text_class = 'cc-hero--light'
  endif
  assign hero_alt = s.image.alt | default: s.heading | escape
-%}

<div
  class="cc-hero {{ text_class }} cc-hero--{{ s.content_position }} cc-hero--{{ s.content_alignment }}"
  style="
    --cc-hero-height: {{ s.height }}svh;
    --cc-hero-height-mobile: {{ s.height_mobile }}svh;
    --cc-hero-text: {% if s.text_color == 'dark' %}var(--color-foreground){% else %}#fff{% endif %};
  "
>
  <div class="cc-hero__media">
    {%- if s.image != blank -%}
      {{
        s.image
        | image_url: width: 3200
        | image_tag:
          widths: '600,900,1200,1600,2000,2600,3200',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          decoding: 'async',
          alt: hero_alt,
          class: 'cc-hero__image'
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'cc-hero__image placeholder-svg' }}
    {%- endif -%}
  </div>

  {%- if s.overlay_opacity > 0 -%}
    {%- comment -%}
      Darkened at both ends, not just the bottom: the header sits transparent
      over the top of this section, so the top band is what keeps the
      navigation legible on a light photograph.
    {%- endcomment -%}
    {%- liquid
      assign scrim_bottom = s.overlay_opacity | divided_by: 100.0
      assign scrim_middle = s.overlay_opacity | times: 0.3 | divided_by: 100.0
      assign scrim_top = s.overlay_opacity | times: 0.65 | divided_by: 100.0
    -%}
    <div
      class="cc-hero__scrim"
      style="background: linear-gradient(to top, rgb(0 0 0 / {{ scrim_bottom }}) 0%, rgb(0 0 0 / {{ scrim_middle }}) 45%, rgb(0 0 0 / {{ scrim_middle }}) 70%, rgb(0 0 0 / {{ scrim_top }}) 100%);"
    ></div>
  {%- endif -%}

  <div class="cc-hero__inner cc-container">
    <div class="cc-hero__content">
      {%- if s.eyebrow != blank -%}
        <span class="cc-eyebrow">{{ s.eyebrow }}</span>
      {%- endif -%}

      {%- if s.heading != blank -%}
        <h1 class="cc-hero__title h1">{{ s.heading }}</h1>
      {%- endif -%}

      {%- if s.text != blank -%}
        <p class="cc-hero__text">{{ s.text }}</p>
      {%- endif -%}

      {%- if s.button_label != blank or s.button_2_label != blank -%}
        <div class="cc-hero__actions">
          {%- if s.button_label != blank -%}
            <a href="{{ s.button_link | default: '#' }}" class="button">{{ s.button_label }}</a>
          {%- endif -%}
          {%- if s.button_2_label != blank -%}
            <a
              href="{{ s.button_2_link | default: '#' }}"
              class="button button-secondary"
              {% if s.text_color == 'light' %}
                style="--color-secondary-button-text:#fff;--color-secondary-button-border:rgb(255 255 255 / 0.7);--color-secondary-button-hover-text:var(--color-foreground);--color-secondary-button-hover-background:#fff;--color-secondary-button-hover-border:#fff;"
              {% endif %}
            >
              {{ s.button_2_label }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if s.show_rating or section.blocks.size > 0 -%}
        <div class="cc-hero__proof">
          {%- if s.show_rating -%}
            <div class="cc-hero__proof-item">
              {% render 'cc-rating', rating: s.rating_value, text: s.rating_caption, size: 15 %}
            </div>
          {%- endif -%}

          {%- for block in section.blocks -%}
            <span class="cc-hero__proof-item" {{ block.shopify_attributes }}>
              {% render 'cc-icon', icon: block.settings.icon, size: 17 %}
              {{ block.settings.text }}
            </span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "cc-section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Free UK mainland delivery"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More storage. Less bedroom."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subheading",
      "default": "Ottoman and divan beds that put a wardrobe's worth of space under the mattress."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button",
      "default": "Shop all beds"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary button",
      "default": "How delivery works"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Social proof"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "default": false
    },
    {
      "type": "range",
      "id": "rating_value",
      "label": "Rating",
      "min": 1,
      "max": 5,
      "step": 0.1,
      "default": 4.8
    },
    {
      "type": "text",
      "id": "rating_caption",
      "label": "Rating caption",
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Vertical position",
      "options": [
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "bottom"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "Text colour",
      "options": [
        { "value": "light", "label": "Light (on imagery)" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "light"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    {
      "type": "range",
      "id": "height",
      "label": "Height (desktop)",
      "min": 50,
      "max": 100,
      "step": 2,
      "unit": "vh",
      "default": 88
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Height (mobile)",
      "min": 50,
      "max": 100,
      "step": 2,
      "unit": "vh",
      "default": 78
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Trust point",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Delivery" },
            { "value": "clock", "label": "Time" },
            { "value": "return", "label": "Returns" },
            { "value": "shield", "label": "Guarantee" },
            { "value": "lock", "label": "Secure" },
            { "value": "card", "label": "Payment" },
            { "value": "headset", "label": "Support" },
            { "value": "check-circle", "label": "Tick" },
            { "value": "ruler", "label": "Sizing" },
            { "value": "moon", "label": "Sleep" },
            { "value": "bed", "label": "Bed" },
            { "value": "hand", "label": "Handmade" },
            { "value": "leaf", "label": "Sustainable" },
            { "value": "award", "label": "Award" },
            { "value": "sparkle", "label": "Sparkle" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free UK mainland delivery"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "category": "Conversion",
      "blocks": [
        { "type": "point", "settings": { "icon": "truck", "text": "Free UK mainland delivery" } },
        { "type": "point", "settings": { "icon": "clock", "text": "Dispatched in 1–4 working days" } },
        { "type": "point", "settings": { "icon": "return", "text": "Easy 30-day returns" } }
      ]
    }
  ]
}
{% endschema %}
