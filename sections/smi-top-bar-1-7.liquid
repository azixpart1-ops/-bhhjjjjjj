<link href="{{ 'smi-top-bar-1.min.css' | asset_url }}" rel="stylesheet" type="text/css" media="screen" onload="this.onload=null;this.media='all'">
{% comment %}#component#["settings/display-settings-2","settings/container-full_width-2","settings/social-media","settings/color-scheme","settings/section-padding","settings/section-margin","blocks/color-announcement","blocks/background","settings/design-mode","blocks/announcement","settings/slider-arrows","settings/icon-setting","settings/custom-icons"]#endcomponent#{% endcomment %}
<link rel="stylesheet" type="text/css" href="{{ 'smi-swiper-bundle-v11.min.css' | asset_url }}" media="screen" onload="this.onload=null;this.media='all'">
<script src="{{ 'smi-swiper-bundle-v11.min.js' | asset_url }}" defer data-id="smi-swiper-bundle-v11.min.js" data-section-id="smi-{{ section.id }}"></script>
<script src="{{ 'smi-slider-2.min.js' | asset_url }}" defer data-id="smi-slider-2.min.js" data-section-id="smi-{{ section.id }}"></script>
<style>
    {% if block_color %}
    {% endif %}
    {% assign color_announcement_block = section.blocks | where: 'type', 'color' | first %}
{% if color_announcement_block %}
      #shopify-section-{{ section.id }},
      #shopify-section-{{ section.id }} .smi-color-{{ section.settings.color_scheme }},
      #shopify-section-{{ section.id }} .smi-block-custom-color , #shopify-section-{{ section.id }} .color-announcement {
	{% if color_announcement_block.settings.background_gradient_color == blank %}
		--gradient-background: {{ color_announcement_block.settings.background_color }};
	{% else %}
		--gradient-background: {{ color_announcement_block.settings.background_gradient_color }};
	{% endif %}
	--color-foreground: {{ color_announcement_block.settings.text_color.red }}, {{ color_announcement_block.settings.text_color.green }},{{ color_announcement_block.settings.text_color.blue }};
	--color-text-link: {{ color_announcement_block.settings.link_color.red }}, {{ color_announcement_block.settings.link_color.green }},{{ color_announcement_block.settings.link_color.blue }};
	{% if color_announcement_block.settings.hover_link_color != blank and color_announcement_block.settings.hover_link_color != 'rgba(0,0,0,0)' %}
		--color-hover-link: {{ color_announcement_block.settings.hover_link_color.red }}, {{ color_announcement_block.settings.hover_link_color.green }},{{ color_announcement_block.settings.hover_link_color.blue }};
	{% else %}
		--color-hover-link: {{ color_announcement_block.settings.link_color.red }}, {{ color_announcement_block.settings.link_color.green }},{{ color_announcement_block.settings.link_color.blue }};
	{% endif %}
    }	
{% endif %}
    #shopify-section-{{ section.id }}{
        {% if  section.settings.custom_width == true and section.settings.container_full_width == false %}
--page-width: {{ section.settings.section_width }}px;
{% endif %}
        --section-padding-top: {{ section.settings.padding_top }}px;
--section-padding-bottom: {{ section.settings.padding_bottom }}px;
--section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
--section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
        --section-margin-sides: {{ section.settings.margin_sides }}px;
--section-margin-sides-mobile: {{ section.settings.margin_sides_mobile }}px;
    }
    #shopify-section-{{ section.id }} .smi-dropdown--style{
        {% assign background_block = section.blocks | where: 'type', 'background' | first %}
        {% if background_block != blank %}
            {% if background_block.settings.background_gradient_color == blank %}
                --gradient-background: {{ background_block.settings.background_simple }};
            {% endif %}
        {% endif %}
    }
</style>
<div id="smi-{{ section.id }}" class="smi-{{ section.id }} smi-display-settings smi-display-{{ section.settings.display_on }} {%- if section.settings.show_bottom_divider %} border-bottom {%- endif %} smi-section__inner smi-gradient smi-section-top-bar-slider smi-section-top-bar-1 smi-color-{{ section.settings.color_scheme }}" data-section="top-bar-1" data-name="✧Topbar 1">
    
    {% liquid
    assign background_block = section.blocks | where: 'type', 'background' | first
    if background_block
      render 'smi-background'
    endif
  %}
    <div class="{% if section.settings.container_full_width %}smi-container-fluid{% else %}smi-container{% endif -%}">
        <div class="smi-content-topbar-1 smi-d-flex smi-align-items-center smi-justify-content-between smi-column-gap-xxl">
            <div class="smi-section-top-bar-1-social-media smi-d-none smi-d-lg-block" smind-key="show_icon_on_desktop,icon_size" smind-attributes smind-attr-social>
                {% if section.settings.show_icon_on_desktop != blank %}
                    {% liquid
  assign show_icon_on_desktop = section.settings.show_icon_on_desktop
%}
{% liquid
  if settings.smi_social_facebook_link and settings.smi_social_instagram_link
    assign hasFB = settings.smi_social_facebook_link
    assign hasIS = settings.smi_social_instagram_link
    assign hasYTube = settings.smi_social_youtube_link
    assign hasTikTok = settings.smi_social_tiktok_link
    assign hasTW = settings.smi_social_twitter_link
    assign hasSChat = settings.smi_social_snapchat_link
    assign hasPT = settings.smi_social_pinterest_link
    assign hasTumblr = settings.smi_social_tumblr_link
    assign hasVM = settings.smi_social_vimeo_link
  else
  assign hasFB = settings.smi_social_facebook_link | default: shop.metafields.smind.settings.value.socialMedia.facebook | default: "" | strip
  assign hasIS = settings.smi_social_instagram_link | default: shop.metafields.smind.settings.value.socialMedia.instagram | default: "" | strip
  assign hasYTube = settings.smi_social_youtube_link | default: shop.metafields.smind.settings.value.socialMedia.youtube | default: "" | strip
  assign hasTikTok = settings.smi_social_tiktok_link | default: shop.metafields.smind.settings.value.socialMedia.tiktok | default: "" | strip
  assign hasTW = settings.smi_social_twitter_link | default: shop.metafields.smind.settings.value.socialMedia.twitter | default: "" | strip
  assign hasSChat = settings.smi_social_snapchat_link | default: shop.metafields.smind.settings.value.socialMedia.snapchat | default: "" | strip
  assign hasPT = settings.smi_social_pinterest_link | default: shop.metafields.smind.settings.value.socialMedia.pinterest | default: "" | strip
  assign hasTumblr = settings.smi_social_tumblr_link | default: shop.metafields.smind.settings.value.socialMedia.tumblr | default: "" | strip
  assign hasVM = settings.smi_social_vimeo_link | default: shop.metafields.smind.settings.value.socialMedia.vimeo | default: "" | strip
  endif
%}
{% if 
  hasFB != blank
  or hasFB != ''
  or hasIS != blank
  or hasIS != ''
  or hasYTube != blank
  or hasYTube != ''
  or hasTikTok != blank
  or hasTikTok != ''
  or hasTW != blank
  or hasTW != ''
  or hasSChat != blank
  or hasSChat != ''
  or hasPT != blank
  or hasPT != ''
  or hasTumblr != blank
  or hasTumblr != ''
  or hasVM != blank
  or hasVM != ''
%}
  <div
    class="smi-component-blocks-social-media {% if show_icon_on_desktop == false or show_icon_on_desktop == true %}smi-hide-social-icon-on-sm {%if show_icon_on_desktop == true %} smi-show-social-icon-on-desktop{% endif %}{% endif %}"
    {{- block.shopify_attributes -}}
  >
    <div class="smi-social-media-icon social-icon-size-{{ section.id }}-{{ block.id }}">
      <style>
        .smi-social-media-icon.social-icon-size-{{ section.id }}-{{ block.id }} .{% if section.settings.icon_style != "1" %} a-href-icon {% endif %}{
          width: calc({{ section.settings.icon_size }}px + 16px);
          height: calc({{ section.settings.icon_size }}px + 16px);
        }
        .smi-social-media-icon.social-icon-size-{{ section.id }}-{{ block.id }} svg{
            width: {{ section.settings.icon_size }}px;
            height: {{ section.settings.icon_size }}px;
        }
      </style>
      {% if hasFB != blank and hasFB != '' %}
        <a
          target="_blank" aria-label="social-media"
          href="{{ hasFB }}"
          aria-label="Facebook"
          class=" share-facebook {% if section.settings.icon_style != "1" %} a-href-icon {% endif %} product-share-icon-{{ section.settings.icon_style }}"
        >
          {% render 'smi-icons', icon: 'facebook' %}
        </a>
      {% endif %}
      {% if hasIS != blank and hasIS != '' %}
        <a
          target="_blank"
          aria-label="Instagram"
          href="{{ hasIS }}"
          class=" share-instagram {% if section.settings.icon_style != "1" %} a-href-icon {% endif %} product-share-icon-{{ section.settings.icon_style }}"
        >
          {% render 'smi-icons', icon: 'instagram' %}
        </a>
      {% endif %}
      {% if hasYTube != blank and hasYTube != '' %}
        <a
          target="_blank"
          aria-label="Youtube"
          href="{{ hasYTube }}"
          class=" share-youtube {% if section.settings.icon_style != "1" %} a-href-icon {% endif %} product-share-icon-{{ section.settings.icon_style }}"
        >
          {% render 'smi-icons', icon: 'youtube' %}
        </a>
      {% endif %}
      {% if hasTikTok != blank and hasTikTok != '' %}
        <a
          target="_blank"
          aria-label="Tiktok"
          href="{{ hasTikTok }}"
          class=" share-tiktok {% if section.settings.icon_style != "1" %} a-href-icon {% endif %} product-share-icon-{{ section.settings.icon_style }}"
        >
          {% render 'smi-icons', icon: 'tiktok' %}
        </a>
      {% endif %}
      {% if hasTW != blank and hasTW != '' %}
        <a
          target="_blank"
          aria-label="Twitter"
          href="{{ hasTW }}"
          class=" share-twitter {% if section.settings.icon_style != "1" %} a-href-icon {% endif %} product-share-icon-{{ section.settings.icon_style }}"
        >
          {% render 'smi-icons', icon: 'twitter' %}
        </a>
      {% endif %}
      {% if hasSChat != blank and hasSChat != '' %}
        <a
          target="_blank"
          aria-label="Snapchat"
          href="{{ hasSChat }}"
          class=" share-snapchat {% if section.settings.icon_style != "1" %} a-href-icon {% endif %} product-share-icon-{{ section.settings.icon_style }}"
        >
          {% render 'smi-icons', icon: 'snapchat' %}
        </a>
      {% endif %}
      {% if hasPT != blank and hasPT != '' %}
        <a
          target="_blank"
          aria-label="Pinterest"
          href="{{ hasPT }}"
          class=" share-pinterest {% if section.settings.icon_style != "1" %} a-href-icon {% endif %} product-share-icon-{{ section.settings.icon_style }}"
        >
          {% render 'smi-icons', icon: 'pinterest' %}
        </a>
      {% endif %}
      {% if hasTumblr != blank and hasTumblr != '' %}
        <a
          target="_blank"
          aria-label="Tumblr"
          href="{{ hasTumblr }}"
          class=" share-tumblr {% if section.settings.icon_style != "1" %} a-href-icon {% endif %} product-share-icon-{{ section.settings.icon_style }}"
        >
          {% render 'smi-icons', icon: 'tumblr' %}
        </a>
      {% endif %}
      {% if hasVM != blank and hasVM != '' %}
        <a
          target="_blank"
          aria-label="vimeo"
          href="{{ hasVM }}"
          class=" share-vimeo {% if section.settings.icon_style != "1" %} a-href-icon {% endif %} product-share-icon-{{ section.settings.icon_style }}"
        >
          {% render 'smi-icons', icon: 'vimeo' %}
        </a>
      {% endif %}
    </div>
  </div>
{% endif %}
                {% endif %}
            </div>
            {% assign announcement_blocks = section.blocks | where: 'type', 'announcement'
            %}
            {% liquid
                if announcement_blocks.size > 1
                    assign loop = false
                else
                    assign loop = false
                endif  
            %}
            <div class="smi-content-announcement-wrapper">
                <div class="swiper smi-swiper smi-announcement-wrapper"
                    {%- if section.settings.auto_rotate_slides %}
                        data-swiper-autoplay--delay="{{ section.settings.change_slides_every | times: 1000 }}"
                    {%- endif -%}
                    data-swiper-loop="{{ loop }}"
                >
                    <div class="smi-swiper-wrapper">
                        {% for block in section.blocks %}
                            {% if block.type == 'announcement' %}
                                <div class="smi-swiper-slide"  {{ block.shopify_attributes }}>
<div class="smi-component-blocks-announcement">
    <div class="smi-component-blocks-announcement__content smi-format-content smi-text-sm smi-link-wrapper smi-d-flex smi-justify-content-center smi-align-items-center smi-link-wrapper">
        {% if block.settings.icon != blank and block.settings.icon != 'none' %}
            {% if block.settings.upload_icon != blank or block.settings.icon != 'none' %}
<div class="smi-component-settings-icon-setting- smi-component-settings-icon-setting-{{ block.id }} ">
    <style>
        .smi-component-settings-icon-setting-{{ block.id }} span,
        .smi-component-settings-icon-setting-{{ block.id }} img {
            width: {{ block.settings.icon_size }}px;
            height: {{ block.settings.icon_size }}px;
            object-fit: cover;
        }
        .smi-component-settings-icon-setting-{{ block.id }} svg {
            width: {{ block.settings.icon_size }}px;
            height: {{ block.settings.icon_size }}px;
            object-fit: cover;
        }
    </style>
    <span class="smi-d-block">
        {%- if block.settings.upload_icon != blank -%}
            {{ block.settings.upload_icon | image_url: width: 750, height: 750 | image_tag: loading: 'eager' }}
        {%- else -%}
            {% if block.settings.icon != 'none' and block.settings.icon != "" %}
                {%- render 'smi-custom-icons', icon: block.settings.icon -%}
            {% endif %}
        {%- endif -%}
    </span>
    </div>
{% endif %}
        {% endif %}
        {{block.settings.content}}
    </div>
</div>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
                {% if announcement_blocks.size > 1 %}
                    <div class="smi-swiper-controls">
                        <div class="smi-swiper-navigation">
                                {% liquid
  unless st_navigation
    assign st_navigation = section.settings.arrow_style
  endunless
%}
{% if st_navigation != 'none' %}
  {% liquid
    case st_navigation
      when 'arr-style-2' or 'arr-square-style-4' or 'arr-square-style-5' or 'arr-square-style-6' or 'arr-circle-style-4' or 'arr-circle-style-5' or 'arr-rounded-rectangle-bg' or 'arr-rounded-rectangle'
        capture st_navigation_left
          render 'smi-icons', icon: 'arrow-left-2'
        endcapture
      else
        capture st_navigation_left
          render 'smi-icons', icon: 'arrow-left'
        endcapture
    endcase
  %}
  <div class="smi-component-arrow-slider">
    <div class="arrow-slider-content">
      <div class="{{ st_navigation }} arrow-icon arrow-slider-left smi-cursor-pointer" smind-key="arrow_style" smind-attributes smind-attr-arrow>
        {{ st_navigation_left }}
      </div>
      <div class="{{ st_navigation }} arrow-icon arrow-icon--flip arrow-slider-right smi-cursor-pointer" smind-key="arrow_style" smind-attributes smind-attr-arrow>
            {{ st_navigation_left }}
      </div>
    </div>
  </div>
{% endif %}
                        </div>
                    </div>
                {% endif %}
            </div>
            <div class="smi-section-top-bar-1-social-action smi-d-none smi-d-lg-flex smi-align-items-center smi-column-gap-sm{% if section.settings.container_full_width %} smi-dropdown-right{% endif %}" smind-key="enable_language,enable_country" smind-attributes smind-attr-language>
                {% if section.settings.enable_language %} {%- render 'smi-header-language', enabled: section.settings.enable_language, show_divider: section.settings.show_divider -%} {% endif %}
                {% if section.settings.enable_country %}{%- render 'smi-header-country', enabled: section.settings.enable_country, show_divider: section.settings.show_divider -%} {% endif %}
            </div>
        </div>
    </div>
</div>{%comment%}#includeFile#assets/smi-swiper-bundle-v11.min.css,assets/smi-swiper-bundle-v11.min.js,assets/smi-slider-2.min.js,snippets/smi-header-language.liquid,snippets/smi-header-country.liquid#endIncludeFile#{%endcomment%}
<div class="smi-d-none smi-pods-item">&nbsp; </div>
{% schema %}
{
	"name": "✧Topbar 1-7-7",
	"tag": "section",
	"class": "smi-section smi-basico-item smi-top-bar-1",
	"disabled_on": {
		"groups": [
			"footer",
			"aside"
		]
	},
	"settings": [
		{
			"type": "select",
			"id": "display_on",
			"label": "Display on",
			"options": [
				{
					"value": "desktop",
					"label": "Desktop only"
				},
				{
					"value": "mobile",
					"label": "Mobile only"
				},
				{
					"value": "all",
					"label": "All device"
				}
			],
			"default": "all"
		},
		{
			"type": "checkbox",
			"id": "container_full_width",
			"label": "Container full-width",
			"default": false
		},
		{
			"type": "checkbox",
			"id": "custom_width",
			"label": "Custom width",
			"default": false,
			"visible_if": "{{ section.settings.container_full_width == false }}"
		},
		{
			"type": "range",
			"id": "section_width",
			"label": "Section width",
			"min": 800,
			"max": 2000,
			"step": 20,
			"unit": "px",
			"default": 1200,
			"visible_if": "{{ section.settings.container_full_width == false and section.settings.custom_width == true }}"
		},
		{
			"type": "checkbox",
			"id": "show_bottom_divider",
			"label": "Show bottom divider",
			"default": true
		},
		{
			"type": "header",
			"content": "Social media icons"
		},
		{
			"type": "checkbox",
			"label": "Show social media on desktop",
			"id": "show_icon_on_desktop",
			"info": "How to add social media icons. [Learn more](https://docs.smind.io/guides/showing-social-media-icons)",
			"default": false
		},
		{
			"type": "select",
			"id": "icon_style",
			"label": "Icon style",
			"options": [
				{
					"value": "1",
					"label": "1"
				},
				{
					"value": "2",
					"label": "2"
				},
				{
					"value": "3",
					"label": "3"
				}
			],
			"default": "1"
		},
		{
			"type": "range",
			"id": "icon_size",
			"min": 16,
			"max": 150,
			"step": 2,
			"label": "Icon size",
			"default": 24
		},
		{
			"type": "checkbox",
			"id": "enable_language",
			"label": "Enable language selector",
			"default": true,
			"info": "To add a language, go to your [language settings.](/admin/settings/languages)"
		},
		{
			"type": "checkbox",
			"id": "enable_country",
			"label": "Enable country/region selector",
			"default": true,
			"info": "To add a country/region, go to your [market settings.](/admin/settings/markets)"
		},
		{
			"type": "header",
			"content": "Announcements"
		},
		{
			"type": "checkbox",
			"id": "auto_rotate_slides",
			"label": "Auto-rotate announcements",
			"default": false
		},
		{
			"type": "range",
			"id": "change_slides_every",
			"min": 1,
			"max": 20,
			"step": 1,
			"unit": "s",
			"label": "Change slides every",
			"default": 5
		},
		{
			"type": "header",
			"content": "Color"
		},
		{
			"type": "select",
            "options": [
                {
                    "value": "scheme_1",
                    "label": "Scheme 1"
                },
                {
                    "value": "scheme_2",
                    "label": "Scheme 2"
                },
                {
                    "value": "scheme_3",
                    "label": "Scheme 3"
                },
                {
                    "value": "scheme_4",
                    "label": "Scheme 4"
                },
                {
                    "value": "scheme_5",
                    "label": "Scheme 5"
                },
                {
                    "value": "scheme_6",
                    "label": "Scheme 6"
                },
                {
                    "value": "scheme_7",
                    "label": "Scheme 7"
                },
                {
                    "value": "scheme_8",
                    "label": "Scheme 8"
                },
                {
                    "value": "scheme_9",
                    "label": "Scheme 9"
                },
                {
                    "value": "scheme_10",
                    "label": "Scheme 10"
                }
            ],
			"id": "color_scheme",
			"label": "Color Scheme",
			"info": "To use color scheme: Step 1: Hide color block in section. Step 2: Customize colors in color block of “✧Styles” section in global area. [Learn more](https://docs.smind.io/guides/color-block-and-color-scheme)"
		},
		{
			"type": "header",
			"content": "Section padding"
		},
		{
			"type": "range",
			"id": "padding_top",
			"min": 0,
			"max": 200,
			"step": 2,
			"unit": "px",
			"label": "Top padding - desktop",
			"default": 50
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 0,
			"max": 200,
			"step": 2,
			"unit": "px",
			"label": "Bottom padding - desktop",
			"default": 50
		},
		{
			"type": "range",
			"id": "padding_top_mobile",
			"min": 0,
			"max": 200,
			"step": 2,
			"unit": "px",
			"label": "Top padding - mobile",
			"default": 50
		},
		{
			"type": "range",
			"id": "padding_bottom_mobile",
			"min": 0,
			"max": 200,
			"step": 2,
			"unit": "px",
			"label": "Bottom padding - mobile",
			"default": 50
		},
		{
			"type": "header",
			"content": "Section margin"
		},
		{
			"type": "range",
			"id": "margin_sides",
			"min": 0,
			"max": 200,
			"step": 2,
			"unit": "px",
			"label": "Margin sides - desktop",
			"default": 0
		},
		{
			"type": "range",
			"id": "margin_sides_mobile",
			"min": 0,
			"max": 50,
			"step": 1,
			"unit": "px",
			"label": "Margin sides - mobile",
			"default": 0
		}
	],
	"blocks": [
		{
			"name": "Color",
			"limit": 1,
			"type": "color",
			"settings": [
				{
					"type": "paragraph",
					"content": "How to use “Custom color block” and “Color scheme”. [Learn more](https://docs.smind.io/guides/color-block-and-color-scheme)"
				},
				{
					"type": "color",
					"id": "background_color",
					"default": "#F3F3F3",
					"label": "Background"
				},
				{
					"type": "color_background",
					"id": "background_gradient_color",
					"label": "Background gradient",
					"info": "Background gradient replaces background where possible."
				},
				{
					"type": "color",
					"id": "text_color",
					"default": "#121212",
					"label": "Text"
				},
				{
					"type": "color",
