<div class="smi-d-none smi-pods-item">&nbsp; </div>
{% liquid
  assign content_alignment = "smi-justify-content-" | append: section.settings.content_alignment | default: "left"
  assign content_position = "smi-justify-content-" | append: section.settings.content_position | default: "left"
%}
<script src="{{ 'smi-countdown-timer-new-2.min.js' | asset_url }}" defer data-id="smi-countdown-timer-new-2.min.js" data-section-id="smi-{{ section.id }}"></script> 
<div
  id="smi-{{ section.id }}"
  class="smi-{{ section.id }} smi-display-settings smi-display-{{ section.settings.display_on }} smi-section__inner smi-gradient smi-section-countdown-2 smi-color-{{ section.settings.color_scheme }} smi-content-settings"
  data-section="countdown-2" data-name="✧Countdown timer 2">
  
  <input type="hidden" value="" id="interval_countdown_{{ section.id }}">
  {% liquid
    assign background_block = section.blocks | where: 'type', 'background' | first
    if background_block
      render 'smi-background'
    endif
  %}
  <div class="smi-p-relative smi-container{%- if section.settings.full_width -%}-fluid{%- endif -%}">
    <div
      class="smi-section-block-{{ section.id }} smi-d-flex {{ content_position }} smi-container-detail"
    >
    {%-liquid
    if settings.smi_animations_reveal_on_scroll != nil
        assign animation_scroll = settings.smi_animations_reveal_on_scroll
    else
        assign global_settings = shop.metafields.smind.settings.value
        assign animation_scroll = global_settings.revealOnScroll
    endif
-%}
      <div class="smi-rich-text-detail smi-content-max-width smi-content-wrapper smi-border smi-shadow smi-content-max-width smi-py-xxl {{- ' smi-px-xxl' -}}
        {%  liquid 
          if animation_scroll
            echo ' smi-scroll-trigger smi-animate--slide-in'
          endif
        %}"
      >
        {% for block in section.blocks %}
          {% if block.type != "color" and block.type != 'background' %}
            <div
              class="smi-w-100 smi-d-flex {{ content_alignment }} smi-block-{{ block.type }} {{- ' smi-countdown-block' -}}
              {% liquid
                if block.type != 'color' and block.type != 'background'
                  if block.type == 'button'
                    echo ' smi-mb-md'
                  else
                    echo ' smi-mb-lg'
                  endif
                endif
              %}"
              {{ block.shopify_attributes }}
            >
              {% if block.type == 'heading' %}
                {%-liquid
    if settings.smi_animations_reveal_on_scroll != nil
        assign animation_scroll = settings.smi_animations_reveal_on_scroll
    else
        assign global_settings = shop.metafields.smind.settings.value
        assign animation_scroll = global_settings.revealOnScroll
    endif
-%}
<div
	class="smi-heading-component smi-heading-component--align-{{ block.settings.heading_alignment }} smi-link-wrapper" {{- block.shopify_attributes -}}
	style="--heading-alignment: {{ block.settings.heading_alignment }}">
	{% liquid
		assign heading = block.settings.heading | strip
		assign sub_heading = block.settings.sub_heading | strip
		assign description = block.settings.description | strip
		assign heading_tags = block.settings.heading_tags | default:'h2'
		assign heading_size = block.settings.heading_size
	%}
	<div class="smi-heading-inner
    {%- if animation_scroll %} smi-scroll-trigger smi-animate--slide-in{% endif -%}
    {%- if heading != blank or sub_heading != blank or description != blank %} smi-mb-xxl{% endif -%}
    ">
		{%- assign sub_heading = block.settings.sub_heading | strip -%}
{%- assign sub_heading_size = blank -%}
{% if block.settings.sub_heading_size != blank %}
	{%- assign sub_heading_size = '-mb ' | append:block.settings.sub_heading_size  | prepend: block.settings.sub_heading_size -%}
{% endif %}
{% if sub_heading != blank %}
    <p class="{% if sub_heading_size != blank %}{{sub_heading_size}}{% else %}smi-text-sub{% endif %} smi-mb-xs smi-heading-component__subheading" smind-key="sub_heading" smind-attributes smind-attr-text>{{- sub_heading -}}</p>
{% endif %}
		{%- assign description = block.settings.description | strip -%}
{%- assign heading = block.settings.heading | strip -%}
{% if heading != blank %}
    <{{heading_tags}} class="{{ heading_size }} {% if description != blank %}smi-mb-sm{% endif %} smi-heading-component__heading" smind-key="heading" smind-attributes smind-attr-text>{{- heading -}}</{{heading_tags}}>
{% endif %}
		{%- assign description = block.settings.description | strip -%}
{%- assign description_size = blank -%}
{% if block.settings.description_size != blank %}
	{%- assign description_size = '-mb ' | append:block.settings.description_size  | prepend: block.settings.description_size -%}
{% endif %}
{% if description != blank %}
    <div class="{% if description_size != blank %}{{description_size}}{% else %}smi-text-md{% endif %} smi-heading-component__description smi-format-content" smind-key="description" smind-attributes smind-attr-text>{{ description }}</div>
{% endif %}
	</div>
</div>
              {% endif %}
              {% if block.type == 'heading_content' %}
                {%-liquid
    if settings.smi_animations_reveal_on_scroll != nil
        assign animation_scroll = settings.smi_animations_reveal_on_scroll
    else
        assign global_settings = shop.metafields.smind.settings.value
        assign animation_scroll = global_settings.revealOnScroll
    endif
-%}
<div class="smi-heading-component smi-heading-component--align-{{block.settings.heading_alignment}} smi-link-wrapper" {{- block.shopify_attributes -}}    >
  {% liquid
    assign heading = block.settings.heading | strip
    assign sub_heading = block.settings.sub_heading | strip
    assign description = block.settings.description | strip
	assign heading_tags = block.settings.heading_tags | default:'h2'
	assign heading_size = block.settings.heading_size
  %}
  <div class="smi-heading-inner
    {%- if animation_scroll %} smi-scroll-trigger smi-animate--slide-in{% endif -%}
    {%- if heading != blank or sub_heading != blank or description != blank %} smi-mb-xxl{% endif -%}
    ">
        {%- assign description = block.settings.description | strip -%}
{%- assign heading = block.settings.heading | strip -%}
{% if heading != blank %}
    <{{heading_tags}} class="{{ heading_size }} {% if description != blank %}smi-mb-sm{% endif %} smi-heading-component__heading" smind-key="heading" smind-attributes smind-attr-text>{{- heading -}}</{{heading_tags}}>
{% endif %}
        {%- assign description = block.settings.content | strip -%}
{%- assign content_size = blank -%}
{% if block.settings.content_size != blank %}
	{%- assign content_size = '-mb ' | append:block.settings.content_size  | prepend: block.settings.content_size -%}
{% endif %}
{% if description != blank %}
    <div class="{% if content_size != blank %}{{content_size}}{% else %}smi-text-md{% endif %} smi-heading-component__description smi-format-content" smind-key="content" smind-attributes smind-attr-text>{{ description }}</div>
{% endif %}
    </div>
</div>
              {% endif %}
              {% if block.type == 'button' %}
                <div class="smi-component-buttons smi-button-wrapper
	{% if block.settings.second_button_style contains 'only_arrow' or block.settings.first_button_style contains 'only_arrow' %} smi-has-only-icon{% endif %}
    {% if block.settings.button_full_width == true %} smi-component-buttons-full-width{% endif %}
    {% unless block.settings.first_button_style contains 'text' or block.settings.second_button_style contains 'text' %} smi-component-buttons--same-width{% endunless %}" smind-key="first_button_label,first_button_link,second_button_label,second_button_link,button_full_width,button_size_mobile,second_button_style" smind-attributes smind-attr-button>
    {% liquid
    assign button_label = block.settings.first_button_label
    assign button_style = block.settings.first_button_style
    assign button_link = block.settings.first_button_link
%}
{% if button_label != blank %}
    <a
            href="{{- button_link -}}"
            class="smi-button smi-button--first smi-text-button smi-button--{{ button_style | split: '_' | first -}}
                {%- if button_style contains 'arrow' %} smi-has-icon{% endif %}
				{%- if button_style contains 'only_arrow' %} smi-only-icon{% endif %}
                {{- settings.smi_animations_hover_elements | default: shop.metafields.smind.settings.value.buttonHoverEffect | default: 'none' | prepend: ' smi-hover-' -}}
                {{- ' smi-border smi-shadow' -}}">
			{% unless  button_style contains 'only_arrow' %}	
				<span>
					{{- button_label | escape -}}
				</span>
			{% endunless %}
        {% if button_style contains 'arrow' %}
            <div class="smi-d-flex smi-align-content-center">
                {% render 'smi-icons', icon: 'arrow-right-2' %}
            </div>
        {% endif %}
    </a>
{% endif %}
    {% liquid
    assign button_label = block.settings.second_button_label
    assign button_style = block.settings.second_button_style
    assign button_link = block.settings.second_button_link
%}
{% if button_label != blank %}
    <a
		href="{{- button_link -}}"
		class="smi-button smi-button--second smi-text-button smi-button--{{ button_style | split: '_' | first -}}
			{%- if button_style contains 'arrow' %} smi-has-icon{% endif %}
			{%- if button_style contains 'only_arrow' %} smi-only-icon{% endif %}
			{{- settings.smi_animations_hover_elements | default: shop.metafields.smind.settings.value.buttonHoverEffect | default: 'none' | prepend: ' smi-hover-' -}}
			{{- ' smi-border smi-shadow' -}}">
		{% unless  button_style contains 'only_arrow' %}	
			<span>
				{{- button_label | escape -}}
			</span>
		{% endunless %}
        {% if button_style contains 'arrow' %}
            <div class="smi-d-flex smi-align-content-center">
                {% render 'smi-icons', icon: 'arrow-right-2' %}
            </div>
        {% endif %}
    </a>
{% endif %}
</div>
              {% endif %}
              {% if block.type == 'countdown_timer' %}
                <div class="smi-countdown-timer-container smi-countdown-timer-container-style-{{ block.settings.countdown_style }} smi-d-flex smi-flex-wrap smi-timer-{{ section.id }}"
	data-block-id="{{ section.id }}"
	data-smi-timer="{{ block.settings.end_date_time }}"
	data-countdown-type="{{ block.settings.countdown_type }}"
	data-expire-message="{{ block.settings.countdown_expire_message }}"
    data-smi-timer-style="{{ block.settings.countdown_style }}"
    data-hide-expires="{{ block.settings.hide_expires }}"
    data-timezone="{{ block.settings.timezone }}"
	data-smi-start="{{ block.settings.start_date_time }}"
    data-smi-end="{{ block.settings.end_date_time }}"
	data-smi-minute-count="{{ block.settings.minutes_count }}"
	data-smi-weekday="{{ block.settings.weekday }}"
	data-smi-start-date-daily="{{ block.settings.start_date_daily }}"
	data-smi-end-date-daily="{{ block.settings.end_date_daily }}"
	data-smi-start-time-daily="{{ block.settings.start_time_daily }}"
	data-smi-end-time-daily="{{ block.settings.end_time_daily }}"
	data-smi-action-expired-fixed="{{ block.settings.action_expired_fixed }}"
	data-smi-action-expired-daily="{{ block.settings.action_expired_daily }}"
>
{%  liquid
        assign cls_count_ele = ''
        assign cls_count = ''
        assign cls_unit = ''
        assign cls_count_solid2 = ''
		if block.settings.font_type == 'body'
			assign number_size = 'smi-text-md'
		else 
			assign number_size = block.settings.number_size
		endif
		if number_size == 'smi-h4'
			assign _cr = '110'
			assign _cr_xy = '55'
			assign _cr_r = '48'
			assign _pir = '302'
		elsif number_size == 'smi-h3'
			assign _cr = '120'
			assign _cr_xy = '60'
			assign _cr_r = '54'
			assign _pir = '339'
		elsif number_size == 'smi-h2'
			assign _cr = '130'
			assign _cr_xy = '65'
			assign _cr_r = '58'
			assign _pir = '364'
		elsif number_size == 'smi-h1'
			assign _cr = '140'
			assign _cr_xy = '70'
			assign _cr_r = '64'
			assign _pir = '402'
		elsif number_size == 'smi-text-md'
			assign _cr = '90'
			assign _cr_xy = '46'
			assign _cr_r = '38'
			assign _pir = '255'
		endif
        if block.settings.countdown_style == 'classic_2' or block.settings.countdown_style == 'border' or block.settings.countdown_style == 'border_radius'
            assign cls_count_ele = cls_count_ele | append: ' smi-px-lg'
            assign cls_unit = cls_unit | append: "smi-unit"
            if block.settings.countdown_style != 'classic_2'
            assign cls_count_ele = cls_count_ele | append: ' smi-py-xs'
            endif
        endif
        if block.settings.countdown_style contains 'solid_1'
            assign cls_count =  cls_count | append: 'smi-py-sm'
        endif
        if block.settings.countdown_style contains 'solid_2'
            assign cls_count = cls_count | append: " smi-d-flex smi-column-gap-xxs"
            assign cls_count_solid2 = 'smi-px-xs smi-py-xxs smi-num-unit'
            if block.settings.countdown_style == 'solid_2_radius'
            	assign cls_count_solid2 = cls_count_solid2 | append: ' smi-num-unit__border'
            endif
        endif
    %}
    <div class="smi-invalid smi-d-none smi-text-md">{{ 'smind.general.invalid_date_format' | t }}</div>
    <div class="smi-countdown-style-main smi-countdown-font-{{ block.settings.font_type }} {% if block.settings.countdown_style == "text" %}smi-custom-countdown-style-{{ block.settings.customize_countdown_style }} smi-button-wrapper smi-button smi-button--solid smi-border smi-shadow smi-align-items-center{% else %} smi-align-content-stretch{% endif %} smi-w-100 smi-countdown-style-{{ block.settings.countdown_style }} smi-countdown-main-size-{{ number_size }} smi-d-flex {{- ' smi-coutdown-container' -}}
        {% liquid
		 	if block.settings.countdown_style == 'text'
                echo ' smi-column-gap-xs'
            elsif block.settings.countdown_style == 'classic_1'
                echo ' smi-column-gap-lg'
			elsif block.settings.countdown_style == 'circular'
				echo ' smi-column-gap-xxs'
            else
                if block.settings.countdown_style != 'classic_2' and block.settings.countdown_style != 'border' and block.settings.countdown_style != 'border_radius'
                    echo ' smi-column-gap-md'
                endif
            endif
        %}"
			style="
				--number-font: var(--font-{{ block.settings.font_type }}-family);
				--number-font-weight: var(--font-{{ block.settings.font_type }}-weight);
				--number-font-style: var(--font-{{ block.settings.font_type }}-style);
				{% if block.settings.countdown_style == 'text' and block.settings.customize_countdown_style == true %}
					--border-radius: {{ block.settings.countdown_radius }}px;
					--border-width: {{ block.settings.countdown_thickness }}px;
					--border-opacity: {{ block.settings.countdown_opacity |  divided_by: 100.0 }};
					--shadow-horizontal-offset: {{ block.settings.countdown_shadow | split: "," |  slice: 0  }}px;
					--shadow-vertical-offset: {{ block.settings.countdown_shadow | split: "," |  slice: 1  }}px;
					--shadow-blur-radius: {{ block.settings.countdown_shadow | split: "," |  slice: 2  }}px;
					--shadow-opacity: {{ block.settings.countdown_shadow_opacity | divided_by: 100.0 }};
				{% endif %}
			"
    >
    {%  liquid 
        assign unitCount = 'd,h,m,s' | split: ","
    %}
    {% for unit in unitCount %}
        <div class="smi-inner {{- cls_count_ele -}} {% if block.settings.countdown_style == 'circular' %} smi-inner-circular {{ number_size }}-size {% endif %}">
			{% if block.settings.countdown_style == 'circular' %}
				<svg class="circle circle-{{ unit }}" style="--pir: {{ _pir }};"
				width="{{ _cr }}"
				height="{{ _cr }}">
					<circle class="bg" cx="{{ _cr_xy }}" cy="{{ _cr_xy }}" r="{{ _cr_r }}" />
					<circle class="progress" cx="{{ _cr_xy }}" cy="{{ _cr_xy }}" r="{{ _cr_r }}" />
				  </svg>
			{% endif %}
			<div class="smi-inner-countdown {% if block.settings.countdown_style == 'text' %}smi-d-flex smi-align-items-center{% endif %}">
				<div class="smi-num-{{ unit }} smi-d-flex smi-justify-content-center smi-num {% if number_font_type == 'heading' %} smi-h1 {% endif %} {% if block.settings.font_type != 'body' %} smi-num-size {% else %} smi-num-size-body {% endif %} {{ cls_count }}" id="smi_count_days_{{ section.id }}" style="margin: auto;">
					{% if block.settings.countdown_style contains 'solid_2' %}
						<span class="{{ cls_count_solid2 }}"><span class="smi-unit-label">{{ unit | upcase }}</span><span class="smi-expired-label smi-d-none">0</span></span>
						<span class="{{ cls_count_solid2 }}"><span class="smi-unit-label">{{ unit | upcase }}</span><span class="smi-expired-label smi-d-none">0</span></span>
					{% else %}
						<span class="smi-unit-label">{{unit | upcase }}{{ unit | upcase}}</span><span class="smi-expired-label smi-d-none">00</span>
					{% endif %}
				</div>
				{% assign text_size = text_size | default: "smi-text-md" %}
				<div class="{{ cls_unit }} {% unless block.settings.countdown_style == 'text' %}{{ text_size }} smi-color-text-75{% else %}{% if block.settings.font_type != 'body' %} smi-num-size {% else %} smi-num-size-body {% endif %}{% endunless %}">
					{% if unit == 'd' %}
						{% if block.settings.countdown_style == 'text' %}{{ 'smind.general.days_short' | t }}{% else %}{{ 'smind.general.days' | t }}{% endif %}
					{% elsif unit == 'h' %}
						{% if block.settings.countdown_style == 'text' %}{{ 'smind.general.hours_short' | t }}{% else %}{{ 'smind.general.hours' | t }}{% endif %}
					{% elsif unit == 'm' %}
						{% if block.settings.countdown_style == 'text' %}{{ 'smind.general.minutes_short' | t }}{% else %}{{ 'smind.general.minutes' | t }}{% endif %}
					{% elsif unit == 's' %}
						{% if block.settings.countdown_style == 'text' %}{{ 'smind.general.seconds_short' | t }}{% else %}{{ 'smind.general.seconds' | t }}{% endif %}
					{% endif %}
				</div>
			</div>
        </div>
        {% if forloop.index < unitCount.size and block.settings.countdown_style != 'circular' %}
            <div class="smi-colon smi-d-flex smi-align-items-center {% if block.settings.font_type == 'body' %} smi-num-size {% else %} smi-num-size-body {% endif %}">:</div>
        {% endif %}
    {% endfor %}
    </div>  
	<h2 class="smi-mgs-noti smi-w-100 smi-pt-md {{ block.settings.message_size }} smi-d-none smi-expired-message" style="color: {{ block.settings.message_color }};">
		{{ block.settings.countdown_expire_message }}
	</h2>
	<h2 class="smi-mgs-noti smi-w-100 smi-text-center smi-pt-md smi-h3 smi-d-none smi-err-condition">
		{{ 'smind.general.err_condition_countdown_daily' | t }}
	</h2>
</div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>{%comment%}#includeFile#assets/smi-countdown-timer-new-2.min.js#endIncludeFile#{%endcomment%}
