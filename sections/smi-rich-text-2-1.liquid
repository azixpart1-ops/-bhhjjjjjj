<link href="{{ 'smi-rich-text-2.min.css' | asset_url }}" rel="stylesheet" type="text/css" media="screen" onload="this.onload=null;this.media='all'">
{% comment %}#component#["settings/display-settings-2","settings/heading","settings/content-width","settings/section-padding","settings/section-margin","settings/rich-content-heading","settings/text","settings/buttons","blocks/color","blocks/background","settings/design-mode","settings/animation-settings","settings/image"]#endcomponent#{% endcomment %}
<style>
    {% if block_color %}
    {% endif %}
  {% assign colorblock = section.blocks | where: 'type', 'color' | first %}
{% if colorblock %}
	.smi-quick-view-1-modal-{{ section.id }}, #shopify-section-{{ section.id }},
      #shopify-section-{{ section.id }} .smi-color-{{ section.settings.color_scheme }},
      .smi-block-custom-color {
		--color-background: {{ colorblock.settings.background_color.red }}, {{ colorblock.settings.background_color.green }},{{ colorblock.settings.background_color.blue }};
		--color-background-alpha: {{ colorblock.settings.background_color.alpha | default: 1 }};
        {% if colorblock.settings.background_gradient_color == blank %}
            --gradient-background: {{ colorblock.settings.background_color }};
        {% else %}
            --gradient-background: {{ colorblock.settings.background_gradient_color }};
        {% endif %}
		{% if colorblock.settings.heading_color != blank and colorblock.settings.heading_color != 'rgba(0,0,0,0)' %}
			--color-heading: {{ colorblock.settings.heading_color.red }}, {{ colorblock.settings.heading_color.green }},{{ colorblock.settings.heading_color.blue }};
		{% endif %}	
		--color-foreground-hex: {{ colorblock.settings.text_color }};
        --color-foreground: {{ colorblock.settings.text_color.red }}, {{ colorblock.settings.text_color.green }},{{ colorblock.settings.text_color.blue }};
		--color-subtext: {{ colorblock.settings.subtext_color.red }},{{ colorblock.settings.subtext_color.green }},{{ colorblock.settings.subtext_color.blue }};
        --color-shadow: {{ colorblock.settings.shadow_color.red }}, {{ colorblock.settings.shadow_color.green }},{{ colorblock.settings.shadow_color.blue }};
		--color-text-link: {{ colorblock.settings.link_color.red }}, {{ colorblock.settings.link_color.green }},{{ colorblock.settings.link_color.blue }};
		{% if colorblock.settings.hover_link_color != blank and colorblock.settings.hover_link_color != 'rgba(0,0,0,0)' %}
			--color-hover-link: {{ colorblock.settings.hover_link_color.red }}, {{ colorblock.settings.hover_link_color.green }},{{ colorblock.settings.hover_link_color.blue }};
		{% else %}
			--color-hover-link: {{ colorblock.settings.link_color.red }}, {{ colorblock.settings.link_color.green }},{{ colorblock.settings.link_color.blue }};
		{% endif %}		
		--color-button: {{ colorblock.settings.solid_background_button_color.red }}, {{ colorblock.settings.solid_background_button_color.green }},{{ colorblock.settings.solid_background_button_color.blue }};
		--color-button-text: {{ colorblock.settings.solid_button_label_color.red }}, {{ colorblock.settings.solid_button_label_color.green }},{{ colorblock.settings.solid_button_label_color.blue }};
		{% if colorblock.settings.solid_background_button_hover_color != blank and colorblock.settings.solid_background_button_hover_color != 'rgba(0,0,0,0)' %}
			--color-button-hover: {{ colorblock.settings.solid_background_button_hover_color.red }}, {{ colorblock.settings.solid_background_button_hover_color.green }},{{ colorblock.settings.solid_background_button_hover_color.blue }};
		{% else %}
			--color-button-hover: {{ colorblock.settings.solid_background_button_color.red }}, {{ colorblock.settings.solid_background_button_color.green }},{{ colorblock.settings.solid_background_button_color.blue }};
		{% endif %}		
		{% if colorblock.settings.solid_button_label_hover_color != blank and colorblock.settings.solid_button_label_hover_color != 'rgba(0,0,0,0)' %}
			--color-button-hover-text: {{ colorblock.settings.solid_button_label_hover_color.red }}, {{ colorblock.settings.solid_button_label_hover_color.green }},{{ colorblock.settings.solid_button_label_hover_color.blue }};
		{% else %}
			--color-button-hover-text: {{ colorblock.settings.solid_button_label_color.red }}, {{ colorblock.settings.solid_button_label_color.green }},{{ colorblock.settings.solid_button_label_color.blue }};
		{% endif %}		
		--color-secondary-button-text: {{ colorblock.settings.outline_button_color.red }}, {{ colorblock.settings.outline_button_color.green }},{{ colorblock.settings.outline_button_color.blue }};
		{% if colorblock.settings.outline_button_hover_color != blank and colorblock.settings.outline_button_hover_color != 'rgba(0,0,0,0)' %}
			--color-button-hover-border: {{ colorblock.settings.outline_button_hover_color.red }}, {{ colorblock.settings.outline_button_hover_color.green }},{{ colorblock.settings.outline_button_hover_color.blue }};
		{% else %}
			--color-button-hover-border: {{ colorblock.settings.outline_button_color.red }}, {{ colorblock.settings.outline_button_color.green }},{{ colorblock.settings.outline_button_color.blue }};
		{% endif %}		
		{% comment %} Inputs ────────── {% endcomment %}
		{% comment %} {% if colorblock.settings.input_background_color != blank and colorblock.settings.input_background_color != 'rgba(0,0,0,0)' %}
			--color-input-background: {{ colorblock.settings.input_background_color.red }}, {{ colorblock.settings.input_background_color.green }},{{ colorblock.settings.input_background_color.blue }};
		{% endif %}
		{% if colorblock.settings.input_color != blank and colorblock.settings.input_color != 'rgba(0,0,0,0)' %}
			--color-input-color: {{ colorblock.settings.input_color.red }}, {{ colorblock.settings.input_color.green }},{{ colorblock.settings.input_color.blue }};
		{% endif %}
		{% if colorblock.settings.input_border_color != blank and colorblock.settings.input_border_color != 'rgba(0,0,0,0)' %}
			--color-input-border: {{ colorblock.settings.input_border_color.red }}, {{ colorblock.settings.input_border_color.green }},{{ colorblock.settings.input_border_color.blue }};
		{% endif %}
		{% if colorblock.settings.input_border_hover_color != blank and colorblock.settings.input_border_hover_color != 'rgba(0,0,0,0)' %}
			--color-input-border-hover: {{ colorblock.settings.input_border_hover_color.red }},{{ colorblock.settings.input_border_hover_color.green }},{{ colorblock.settings.input_border_hover_color.blue }};
		{% else %}
			--color-input-border-hover: {{ colorblock.settings.input_border_color.red }},{{ colorblock.settings.input_border_color.green }},{{ colorblock.settings.input_border_color.blue }};
		{% endif %}	
		 {% endcomment %}
    }
{% endif %}
    #shopify-section-{{ section.id }}{
    }
    #smi-{{ section.id }}, #shopify-section-{{ section.id }} {
      --section-padding-top: {{ section.settings.padding_top }}px;
--section-padding-bottom: {{ section.settings.padding_bottom }}px;
--section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
--section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
;
      --section-margin-sides: {{ section.settings.margin_sides }}px;
--section-margin-sides-mobile: {{ section.settings.margin_sides_mobile }}px;
;
      --content-max-width: {{ section.settings.content_max_width }}px;;
      --content-alignment: {{ section.settings.content_alignment }};
      {% if section.settings.padding_bottom == 0 %}
        --no-padding-bottom: 36px;
        {% else %}
        --no-padding-bottom: 0px;
      {% endif %}
      {% if section.settings.padding_top == 0 %}
        --no-padding-top: 36px;
        {% else %}
        --no-padding-top: 0px;
      {% endif %}
    }
</style>
{% liquid
    assign has_heading = false
    if section.settings.sub_heading != "" or section.settings.sub_heading != blank or section.settings.heading != "" or section.settings.heading != blank or section.settings.description != "" or section.settings.description != blank
    assign has_heading = true
    endif
    assign content_alignment = section.settings.content_alignment
    assign color_pos = 0
    assign bkg_pos = 0
    for block in section.blocks
    if block.type == 'color'
    assign color_pos = forloop.index
    endif
    if block.type == 'background'
    assign bkg_pos = forloop.index
    endif
  endfor
%}
<div id="smi-{{ section.id }}" class="smi-{{ section.id }} smi-display-settings smi-display-{{ section.settings.display_on }} smi-section__inner smi-gradient smi-section-rich-text-2 smi-color-{{ section.settings.color_scheme }} smi-content-settings" data-section="rich-text-2" data-name="✧Rich text 2">
    
  {% liquid
    assign background_block = section.blocks | where: 'type', 'background' | first
    if background_block
      render 'smi-background'
    endif
  %}
  <input type="hidden" value="" id="interval_countdown_{{ section.id }}">
  <div class="smi-container-relative smi-container{%- if section.settings.full_width -%}-fluid{%- endif -%}">
    <div class="smi-container-detail ">
      {% if has_heading == true %}
          <div class="smi-w-100 smi-heading smi-w-md-{{ 100 | minus: section.settings.desktop_content_width }}">
            {%-liquid
    if settings.smi_animations_reveal_on_scroll != nil
        assign animation_scroll = settings.smi_animations_reveal_on_scroll
    else
        assign global_settings = shop.metafields.smind.settings.value
        assign animation_scroll = global_settings.revealOnScroll
    endif
-%}
<div
	class="smi-heading-component smi-heading-component--align-{{ section.settings.heading_alignment }} smi-link-wrapper" {{- block.shopify_attributes -}}
	style="--heading-alignment: {{ section.settings.heading_alignment }}">
	{% liquid
		assign heading = section.settings.heading | strip
		assign sub_heading = section.settings.sub_heading | strip
		assign description = section.settings.description | strip
		assign heading_tags = section.settings.heading_tags | default:'h2'
		assign heading_size = section.settings.heading_size
	%}
	<div class="smi-heading-inner
    {%- if animation_scroll %} smi-scroll-trigger smi-animate--slide-in{% endif -%}
    {%- if heading != blank or sub_heading != blank or description != blank %} smi-mb-xxl{% endif -%}
    ">
		{%- assign sub_heading = section.settings.sub_heading | strip -%}
{%- assign sub_heading_size = blank -%}
{% if section.settings.sub_heading_size != blank %}
	{%- assign sub_heading_size = '-mb ' | append:section.settings.sub_heading_size  | prepend: section.settings.sub_heading_size -%}
{% endif %}
{% if sub_heading != blank %}
    <p class="{% if sub_heading_size != blank %}{{sub_heading_size}}{% else %}smi-text-sub{% endif %} smi-mb-xs smi-heading-component__subheading" smind-key="sub_heading" smind-attributes smind-attr-text>{{- sub_heading -}}</p>
{% endif %}
		{%- assign description = section.settings.description | strip -%}
{%- assign heading = section.settings.heading | strip -%}
{% if heading != blank %}
    <{{heading_tags}} class="{{ heading_size }} {% if description != blank %}smi-mb-sm{% endif %} smi-heading-component__heading" smind-key="heading" smind-attributes smind-attr-text>{{- heading -}}</{{heading_tags}}>
{% endif %}
		{%- assign description = section.settings.description | strip -%}
{%- assign description_size = blank -%}
{% if section.settings.description_size != blank %}
	{%- assign description_size = '-mb ' | append:section.settings.description_size  | prepend: section.settings.description_size -%}
{% endif %}
{% if description != blank %}
    <div class="{% if description_size != blank %}{{description_size}}{% else %}smi-text-md{% endif %} smi-heading-component__description smi-format-content" smind-key="description" smind-attributes smind-attr-text>{{ description }}</div>
{% endif %}
	</div>
</div>
          </div>
      {% endif %}
      {%-liquid
    if settings.smi_animations_reveal_on_scroll != nil
        assign animation_scroll = settings.smi_animations_reveal_on_scroll
    else
        assign global_settings = shop.metafields.smind.settings.value
        assign animation_scroll = global_settings.revealOnScroll
    endif
-%}
      <div class="smi-rich-content-detail smi-w-100 smi-section-block-{{ section.id }} smi-rich-content-{{ 100 | minus: section.settings.desktop_content_width }} smi-w-md-{{ section.settings.desktop_content_width }} {%- if animation_scroll %} smi-scroll-trigger smi-animate--slide-in smi-animate-order-1 {% endif -%}"
        data-block='{
          "color_pos": "{{ color_pos }}",
          "bkg_pos": "{{ bkg_pos }}",
          "all_block": {{ section.blocks.size }}
        }'
      >
        {% for block in section.blocks %}
            <div
              class="smi-block-postion-{{ forloop.index }}-{{ section.id }} content-alignment-{{ section.settings.content_alignment }} {% if block.type == "icon_with_text" %} smi-rich-content-half-{{ block.settings.half_width_on_large_screen }} {% endif %} smi-block-type-{{ block.type }} {{- ' smi-rich-content' -}}
              {% liquid
                if block.type != 'color' and block.type != 'background'
                  if block.type == 'button'
                    if forloop.index < section.blocks.size
                      echo ' smi-mb-md'
                    endif
                  else
                    if forloop.index < section.blocks.size
                      echo ' smi-mb-lg'
                    endif
                  endif
                endif
              %}"
              {{ block.shopify_attributes }}
            >
              {% if block.type == 'heading' %}
                <div class="smi-d-flex smi-flex-wrap smi-component-blocks-heading content-alignment-{{ content_alignment }}">
  <div class="heading-only heading-only-{{ content_alignment }}">
    <p class="smi-text-sub smi-d-flex heading-only-{{ content_alignment }} smi-w-100 smi- smi-mb-xxs sub-heading smi-link-wrapper" >{{ block.settings.sub_heading }}</p>
    <h2 class="smi-w-100 smi-d-flex heading-only-{{ content_alignment }} {{ block.settings.heading_size }} 
        {% if block.settings.description != blank or block.settings.description != ""%} smi-mb-sm {% endif %} smi-link-wrapper" >{{ block.settings.heading}}</h2>
    <div class="smi-text-md smi-d-flex heading-only-{{ content_alignment }} smi-w-100 smi-color-text-75 description smi-link-wrapper"  >{{ block.settings.description }}</div>
</div>  
</div>
              {% endif %}
              {% if block.type == 'text' %}
                <div class="smi-component-blocks-text smi-text-md" {{- block.shopify_attributes -}}>
    <div class="smi-color-text-75 smi-link-wrapper {% if block.settings.content_size != blank %}{{ block.settings.content_size }} {{ block.settings.content_size }}-mb{% else %}smi-text-md{% endif %}">{{ block.settings.text | newline_to_br }}</div>
</div>
              {% endif %}
              {% if block.type == 'heading_content' %}
                <div class="smi-d-flex smi-flex-wrap smi-component-blocks-heading content-alignment-{{ content_alignment }}">
  <div class="heading-content">
    <h2 class="{{ block.settings.heading_size }} smi-d-flex heading-only-{{ content_alignment }} smi-w-100 smi-mb-xxs smi-link-wrapper" >{{ block.settings.heading }}</h2>
    <div class="smi-d-flex heading-only-{{ content_alignment }} smi-w-100 description smi-text-md smi-color-text-75 smi-link-wrapper"  >
    {{ block.settings.content }}
    </div>
</div>
</div>
              {% endif %}
              {% if block.type == 'button' %}
                <div class="smi-component-buttons smi-button-wrapper
	{% if block.settings.second_button_style contains 'only_arrow' or block.settings.first_button_style contains 'only_arrow' %} smi-has-only-icon{% endif %}
    {% if block.settings.button_full_width == true %} smi-component-buttons-full-width{% endif %}
    {% unless block.settings.first_button_style contains 'text' or block.settings.second_button_style contains 'text' %} smi-component-buttons--same-width{% endunless %}" smind-key="first_button_label,first_button_link,second_button_label,second_button_link,button_full_width,button_size_mobile,second_button_style" smind-attributes smind-attr-button>
    {% liquid
    assign button_label = block.settings.first_button_label
    assign button_style = block.settings.first_button_style
    assign button_link = block.settings.first_button_link
%}
{% if button_label != blank %}
    <a
            href="{{- button_link -}}"
            class="smi-button smi-button--first smi-text-button smi-button--{{ button_style | split: '_' | first -}}
                {%- if button_style contains 'arrow' %} smi-has-icon{% endif %}
				{%- if button_style contains 'only_arrow' %} smi-only-icon{% endif %}
                {{- settings.smi_animations_hover_elements | default: shop.metafields.smind.settings.value.buttonHoverEffect | default: 'none' | prepend: ' smi-hover-' -}}
                {{- ' smi-border smi-shadow' -}}">
			{% unless  button_style contains 'only_arrow' %}	
				<span>
					{{- button_label | escape -}}
				</span>
			{% endunless %}
        {% if button_style contains 'arrow' %}
            <div class="smi-d-flex smi-align-content-center">
                {% render 'smi-icons', icon: 'arrow-right-2' %}
            </div>
        {% endif %}
    </a>
{% endif %}
    {% liquid
    assign button_label = block.settings.second_button_label
    assign button_style = block.settings.second_button_style
    assign button_link = block.settings.second_button_link
%}
{% if button_label != blank %}
    <a
		href="{{- button_link -}}"
		class="smi-button smi-button--second smi-text-button smi-button--{{ button_style | split: '_' | first -}}
			{%- if button_style contains 'arrow' %} smi-has-icon{% endif %}
			{%- if button_style contains 'only_arrow' %} smi-only-icon{% endif %}
			{{- settings.smi_animations_hover_elements | default: shop.metafields.smind.settings.value.buttonHoverEffect | default: 'none' | prepend: ' smi-hover-' -}}
			{{- ' smi-border smi-shadow' -}}">
		{% unless  button_style contains 'only_arrow' %}	
			<span>
				{{- button_label | escape -}}
			</span>
		{% endunless %}
        {% if button_style contains 'arrow' %}
            <div class="smi-d-flex smi-align-content-center">
                {% render 'smi-icons', icon: 'arrow-right-2' %}
            </div>
        {% endif %}
    </a>
{% endif %}
</div>
              {% endif %}
              {% if block.type == 'image' %}
                {% assign img_width = block.settings.image_width %}
                {%- liquid
                  assign img_classes = 'smi-media-wrapper '
                  assign content_img = block.settings.heading | strip
                  if block.settings.use_media_settings
                  assign img_classes = img_classes | append: " smi-media-settings smi-border smi-shadow "
                  endif
                  assign placeholder_img_classes = img_classes | append: ' placeholder-img'
                -%}
                <div class="smi-component-blocks-image smi-component-blocks-image-{{ block.id }}  {{ settings.smi_animations_hover_image | default: shop.metafields.smind.settings.value.imageHoverEffect | default: 'none' |  prepend: ' smi-hover-image-'  }}">
                  {% if block.settings.heading != blank and block.settings.heading != "" and block.settings.heading != " " %}
                    <p class="smi-text-md smi-color-text-75 {% if block.settings.upload_checkout != blank %} smi-mb-xs {% endif %}">
                      {{ block.settings.heading }}
                    </p>
                {% endif %}
                  <style>
                    .smi-component-blocks-image-{{ block.id }} {
                      --media-width: {{ img_width }}px;
                    }
                  </style>
                  <div class="{{ img_classes }} block-image-container" >
                    {%- if block.settings.upload_checkout != blank -%}
                      {% liquid
                        assign image_object = block.settings.upload_checkout
                        assign image_width = img_width
                        assign item_mobile = 1
                        assign item_tablet = 2
                        assign item_desktop = 2
                        assign image_classes = settings.smi_animations_hover_image | default: shop.metafields.smind.settings.value.imageHoverEffect | default: 'none' |  prepend: ' smi-hover-image-'
                      %}
{{
  image_object
  | image_url: width: image_width
  | image_tag: class: image_classes, widths: '400,500,600,700,800,1000,1200,1400,1600,1900,2500', sizes: sizes
}}
                    {%- else -%}
                      {{ 'image' | placeholder_svg_tag: 'smi-placeholder-light' }}
                    {%- endif -%}
                  </div>
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
    </div>
  </div>
</div>
<div class="smi-d-none smi-pods-item">&nbsp; </div>
{% schema %}
{
	"name": "✧Rich text 2-1",
	"tag": "section",
	"class": "smi-section smi-basico-item smi-rich-text-2",
	"disabled_on": {
		"groups": [
			"header",
			"footer",
			"aside"
		]
	},
	"settings": [
		{
			"type": "select",
			"id": "display_on",
			"label": "Display on",
			"options": [
				{
					"value": "desktop",
					"label": "Desktop only"
				},
				{
					"value": "mobile",
					"label": "Mobile only"
				},
				{
					"value": "all",
					"label": "All device"
				}
			],
			"default": "all"
		},
		{
			"type": "paragraph",
			"content": "Advanced font controls are available in Smind Style. [Learn more](https://docs.smind.io/guides/configuring-typography)"
		},
		{
			"type": "inline_richtext",
			"id": "sub_heading",
			"label": "Subheading",
			"default": "URNA CRAS MAURIS"
		},
		{
			"type": "select",
			"id": "sub_heading_size",
			"label": "Subheading size",
			"options": [
				{
					"value": "smi-text-sub",
					"label": "XS"
				},
				{
					"value": "smi-text-sub-sm",
					"label": "S"
				}
			],
			"default": "smi-text-sub"
		},
		{
			"type": "inline_richtext",
			"id": "heading",
			"label": "Heading",
			"default": "Happy Customers Say"
		},
		{
			"type": "select",
			"id": "heading_tags",
			"label": "Heading tags",
			"options": [
				{
					"value": "h1",
					"label": "H1"
				},
				{
					"value": "h2",
					"label": "H2"
				},
				{
					"value": "h3",
					"label": "H3"
				},
				{
					"value": "h4",
					"label": "H4"
				},
				{
					"value": "h5",
					"label": "H5"
				},
				{
					"value": "h6",
					"label": "H6"
				}
			],
			"default": "h2"
		},
		{
			"type": "select",
			"id": "heading_size",
			"label": "Heading size",
			"options": [
				{
					"value": "smi-h4",
					"label": "S"
				},
				{
					"value": "smi-h3",
					"label": "M"
				},
				{
					"value": "smi-h2",
					"label": "L"
				},
				{
					"value": "smi-h1",
					"label": "XL"
				}
			],
			"default": "smi-h2"
		},
		{
			"type": "richtext",
			"id": "description",
			"label": "Description",
			"default": "<p>Commodo lorem morbi aliquam dui turpis. Iaculis pretium posuere nulla tincidunt blandit. A at elementum faucibus integer.</p>"
		},
		{
			"type": "select",
			"id": "description_size",
			"label": "Description size",
			"options": [
				{
					"value": "smi-text-xs",
					"label": "XS"
				},
				{
					"value": "smi-text-sm",
					"label": "S"
				},
				{
					"value": "smi-text-md",
					"label": "M"
				},
				{
					"value": "smi-text-lg",
					"label": "L"
				}
			],
			"default": "smi-text-md"
		},
		{
			"type": "text_alignment",
			"id": "heading_alignment",
			"label": "Heading alignment",
			"default": "center"
		},
		{
