{%- liquid
  assign s = section.settings
  assign form_id = 'cc-signup-' | append: section.id
-%}

{% render 'contrast-override', background_color: s.background_color, section_id: section.id %}

<div class="cc-section color-custom-{{ section.id }}">
  <div class="cc-container">
    <div class="cc-signup" data-cc-reveal>
      <div>
        {%- if s.eyebrow != blank -%}
          <span class="cc-eyebrow" style="color: inherit; opacity: 0.7;">{{ s.eyebrow }}</span>
        {%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h2" style="margin: 0 0 1rem;">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}
          <p style="margin: 0; line-height: 1.65; opacity: 0.82; max-width: 46ch;">{{ s.text }}</p>
        {%- endif -%}
      </div>

      <div>
        {%- form 'customer', id: form_id, class: 'cc-signup__formwrap' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">

          {%- if form.posted_successfully? -%}
            <p class="cc-signup__success">{{ s.success_text }}</p>
          {%- else -%}
            <div class="cc-signup__form">
              <label class="visually-hidden" for="{{ form_id }}-email">{{ s.placeholder }}</label>
              <input
                id="{{ form_id }}-email"
                type="email"
                name="contact[email]"
                placeholder="{{ s.placeholder | escape }}"
                autocomplete="email"
                required
                value="{{ form.email }}"
              >
              <button type="submit" class="button">{{ s.button_label }}</button>
            </div>

            {%- if form.errors -%}
              <p class="cc-signup__success" role="alert">{{ form.errors.messages.email }}</p>
            {%- endif -%}

            {%- if s.note != blank -%}
              <p class="cc-signup__note">{{ s.note }}</p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Email capture",
  "tag": "section",
  "class": "cc-section-signup",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stay in touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New arrivals and offers, once a month" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "One email a month when we add a product or run a sale. We never pass your address to anyone."
    },
    { "type": "text", "id": "placeholder", "label": "Field placeholder", "default": "Your email address" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Sign up" },
    {
      "type": "text",
      "id": "note",
      "label": "Small print",
      "default": "Unsubscribe in one click, any time."
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "You're subscribed — thanks."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ede5d6"
    }
  ],
  "presets": [
    {
      "name": "Email capture",
      "category": "Conversion"
    }
  ]
}
{% endschema %}
