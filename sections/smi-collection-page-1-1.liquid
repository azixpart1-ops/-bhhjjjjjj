{% comment %}#component#["settings/display-settings-2","settings/container-full_width-2","settings/product-card","settings/section-padding","settings/section-margin","blocks/background","settings/media-settings-3","settings/design-mode"]#endcomponent#{% endcomment %}
<link rel="stylesheet" type="text/css" href="{{ 'smi-product-card.min.css' | asset_url }}" media="screen" onload="this.onload=null;this.media='all'"> <script src="{{ 'smi-product-card.min.js' | asset_url }}" defer data-id="smi-product-card.min.js" data-section-id="smi-{{ section.id }}"></script>
<link rel="stylesheet" type="text/css" href="{{ 'smi-layout-grid.min.css' | asset_url }}" media="screen" onload="this.onload=null;this.media='all'">
<script src="{{ 'smi-layout-grid.min.js' | asset_url }}" defer data-id="smi-layout-grid.min.js" data-section-id="smi-{{ section.id }}"></script>
<link rel="stylesheet" type="text/css" href="{{ 'smi-product-listing-page.min.css' | asset_url }}" media="screen" onload="this.onload=null;this.media='all'">
<script src="{{ 'smi-product-listing-page.min.js' | asset_url }}" defer data-id="smi-product-listing-page.min.js" data-section-id="smi-{{ section.id }}"></script>
{% liquid
  assign product_color_schema = section.settings.product_color_scheme
  assign st = section.settings
  assign showToolbar = true
  if st.show_total_results == false and st.show_columns_switcher == false and st.enable_sorting == false
    assign showToolbar = false
  endif
  assign product_color_schema = section.settings.product_color_scheme
  assign global_settings = shop.metafields.smind.settings.value
  if settings.smi_card_style
    assign card_type = settings.smi_card_style
  else
    assign card_type = global_settings.productCardStyle | default: 'standard'
  endif
%}
<style>
    {% if block_color %}
    {% endif %}
  {% assign colorblock = section.blocks | where: 'type', 'color' | first %}
{% if colorblock %}
      #shopify-section-{{ section.id }},
      #shopify-section-{{ section.id }} .smi-color-{{ section.settings.color_scheme }},
      #shopify-section-{{ section.id }} .smi-block-custom-color {
        --color-background: {{ colorblock.settings.background_color.red }}, {{ colorblock.settings.background_color.green }},{{ colorblock.settings.background_color.blue }};        
        {% if colorblock.settings.background_gradient_color == blank %}
            --gradient-background: {{ colorblock.settings.background_color }};
        {% else %}
            --gradient-background: {{ colorblock.settings.background_gradient_color }};
        {% endif %}
		{% if colorblock.settings.heading_color != blank and colorblock.settings.heading_color != 'rgba(0,0,0,0)' %}
			--color-heading: {{ colorblock.settings.heading_color.red }}, {{ colorblock.settings.heading_color.green }},{{ colorblock.settings.heading_color.blue }};
		{% endif %}	
        --color-foreground: {{ colorblock.settings.text_color.red }}, {{ colorblock.settings.text_color.green }},{{ colorblock.settings.text_color.blue }};
		--color-shadow: {{ colorblock.settings.shadow_color.red }}, {{ colorblock.settings.shadow_color.green }},{{ colorblock.settings.shadow_color.blue }};
        --color-button: {{ colorblock.settings.solid_background_button_color.red }}, {{ colorblock.settings.solid_background_button_color.green }},{{ colorblock.settings.solid_background_button_color.blue }};
        --color-button-text: {{ colorblock.settings.solid_button_label_color.red }}, {{ colorblock.settings.solid_button_label_color.green }},{{ colorblock.settings.solid_button_label_color.blue }};
		{% if colorblock.settings.solid_background_button_hover_color != blank and colorblock.settings.solid_background_button_hover_color != 'rgba(0,0,0,0)' %}
			--color-button-hover: {{ colorblock.settings.solid_background_button_hover_color.red }}, {{ colorblock.settings.solid_background_button_hover_color.green }},{{ colorblock.settings.solid_background_button_hover_color.blue }};
		{% else %}
			--color-button-hover: {{ colorblock.settings.solid_background_button_color.red }}, {{ colorblock.settings.solid_background_button_color.green }},{{ colorblock.settings.solid_background_button_color.blue }};
		{% endif %}		
		{% if colorblock.settings.solid_button_label_hover_color != blank and colorblock.settings.solid_button_label_hover_color != 'rgba(0,0,0,0)' %}
			--color-button-hover-text: {{ colorblock.settings.solid_button_label_hover_color.red }}, {{ colorblock.settings.solid_button_label_hover_color.green }},{{ colorblock.settings.solid_button_label_hover_color.blue }};
		{% else %}
			--color-button-hover-text: {{ colorblock.settings.solid_button_label_color.red }}, {{ colorblock.settings.solid_button_label_color.green }},{{ colorblock.settings.solid_button_label_color.blue }};
		{% endif %}	
        --color-shadow-product: {{ colorblock.settings.shadow_color.red }}, {{ colorblock.settings.shadow_color.green }},{{ colorblock.settings.shadow_color.blue }};
        --color-border-product: {{ colorblock.settings.text_color.red }}, {{ colorblock.settings.text_color.green }},{{ colorblock.settings.text_color.blue }};
    }
    #shopify-section-{{ section.id }} .smi-product-card-wrapper .smi-color-{{ section.settings.product_color_scheme }} {
        --color-background: {{ colorblock.settings.product_background_color.red }}, {{ colorblock.settings.product_background_color.green }},{{ colorblock.settings.product_background_color.blue }};        
        {% if colorblock.settings.product_background_gradient_color == blank %}
            --gradient-background: {{ colorblock.settings.product_background_color }};
        {% else %}
            --gradient-background: {{ colorblock.settings.product_background_gradient_color }};
        {% endif %}
		{% if colorblock.settings.product_heading_color != blank and colorblock.settings.product_heading_color != 'rgba(0,0,0,0)' %}
			--color-heading: {{ colorblock.settings.product_heading_color.red }}, {{ colorblock.settings.product_heading_color.green }},{{ colorblock.settings.product_heading_color.blue }};
		{% endif %}
        --color-foreground: {{ colorblock.settings.product_text_color.red }}, {{ colorblock.settings.product_text_color.green }},{{ colorblock.settings.product_text_color.blue }};
        --color-button: {{ colorblock.settings.product_solid_background_button_color.red }}, {{ colorblock.settings.product_solid_background_button_color.green }},{{ colorblock.settings.product_solid_background_button_color.blue }};
        --color-button-text: {{ colorblock.settings.product_solid_button_label_color.red }}, {{ colorblock.settings.product_solid_button_label_color.green }},{{ colorblock.settings.product_solid_button_label_color.blue }};
		{% if colorblock.settings.product_solid_background_button_hover_color != blank and colorblock.settings.product_solid_background_button_hover_color != 'rgba(0,0,0,0)' %}
			--color-button-hover: {{ colorblock.settings.product_solid_background_button_hover_color.red }}, {{ colorblock.settings.product_solid_background_button_hover_color.green }},{{ colorblock.settings.product_solid_background_button_hover_color.blue }};
		{% else %}
			--color-button-hover: {{ colorblock.settings.product_solid_background_button_color.red }}, {{ colorblock.settings.product_solid_background_button_color.green }},{{ colorblock.settings.product_solid_background_button_color.blue }};
		{% endif %}		
		{% if colorblock.settings.product_solid_button_label_hover_color != blank and colorblock.settings.product_solid_button_label_hover_color != 'rgba(0,0,0,0)' %}
			--color-button-hover-text: {{ colorblock.settings.product_solid_button_label_hover_color.red }}, {{ colorblock.settings.product_solid_button_label_hover_color.green }},{{ colorblock.settings.product_solid_button_label_hover_color.blue }};
		{% else %}
			--color-button-hover-text: {{ colorblock.settings.product_solid_button_label_color.red }}, {{ colorblock.settings.product_solid_button_label_color.green }},{{ colorblock.settings.product_solid_button_label_color.blue }};
		{% endif %}
        --color-shadow: {{ colorblock.settings.product_shadow_color.red }}, {{ colorblock.settings.product_shadow_color.green }},{{ colorblock.settings.product_shadow_color.blue }};
    }
    #shopify-section-{{ section.id }} .smi-badges {
        --color-badge-foreground: {{ colorblock.settings.badge_sale_text_color.red }}, {{ colorblock.settings.badge_sale_text_color.green }},{{ colorblock.settings.badge_sale_text_color.blue }};
		--color-badge-border-sale: {{ colorblock.settings.sale_badge_border_color.red }},{{ colorblock.settings.sale_badge_border_color.green }},{{ colorblock.settings.sale_badge_border_color.blue }};
		--color-badge-background: {{ colorblock.settings.badge_sale_background_color.red }}, {{ colorblock.settings.badge_sale_background_color.green }},{{ colorblock.settings.badge_sale_background_color.blue }};
		{% if colorblock.settings.sale_badge_background_gradient != blank %}
			--color-badge-background-gradient: {{ colorblock.settings.sale_badge_background_gradient }};
			{% else %}
			--color-badge-background-gradient: rgba(var(--color-badge-background), 1);
		{% endif %}
    }
    #shopify-section-{{ section.id }} .smi-badges--sold-out {
        --color-badge-foreground: {{ colorblock.settings.badge_sold_out_text_color.red }}, {{ colorblock.settings.badge_sold_out_text_color.green }},{{ colorblock.settings.badge_sold_out_text_color.blue }};
		--color-sold-badge-border: {{ colorblock.settings.sale_badge_sold_out_border_color.red }},{{ colorblock.settings.sale_badge_sold_out_border_color.green }},{{ colorblock.settings.sale_badge_sold_out_border_color.blue }};
		--color-sold-badge-background: {{ colorblock.settings.badge_sold_out_background_color.red }}, {{ colorblock.settings.badge_sold_out_background_color.green }},{{ colorblock.settings.badge_sold_out_background_color.blue }};
		{% if colorblock.settings.sold_out_badge_background_gradient != blank %}
			--color-sold-badge-background-gradient: {{ colorblock.settings.sold_out_badge_background_gradient }};
			{%  else %}
			--color-sold-badge-background-gradient: rgba(var(--color-sold-badge-background), 1);
		{% endif %}
    }
{% endif %}
  #shopify-section-{{ section.id }}{
      --section-padding-top: {{ section.settings.padding_top }}px;
--section-padding-bottom: {{ section.settings.padding_bottom }}px;
--section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
--section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
	  --section-margin-sides: {{ section.settings.margin_sides }}px;
--section-margin-sides-mobile: {{ section.settings.margin_sides_mobile }}px;
	  {% if  section.settings.custom_width == true and section.settings.container_full_width == false %}
--page-width: {{ section.settings.section_width }}px;
{% endif %}
      --col-md: {{ section.settings.number_of_columns_on_desktop }};
      --col-xs: {{ section.settings.number_of_columns_on_mobile }};
      --sidebar-size: {{ section.settings.sidebar_size }};
      --widget-height: {% if section.settings.limit_filter_widget_height %}275px{% else %}unset{% endif %};
  }
  #shopify-section-{{ section.id }} .smi-product-card-wrapper {
      --color-shadow-section: var(--color-shadow);
      --color-border-section: var(--color-foreground);
  }
@media screen and (max-width: 767.8px){.smi-display-settings.smi-display-desktop{display:none !important}}@media screen and (min-width: 768px){.smi-display-settings.smi-display-mobile{display:none !important}}
</style>
<div class="smi-d-none smi-profesyonel-item">&nbsp; </div>
<div
  id="smi-{{ section.id }}"
  class="smi-{{ section.id }} smi-display-settings smi-display-{{ section.settings.display_on }} smi-section__inner smi-nro-item smi-gradient smi-product-listing-page smi-product-listing-page--filter-default smi-section-collection-page-1 smi-color-{{ section.settings.color_scheme }}"
  data-section="collection-page-1"
  data-name="✧Collection page 1"
>
  
  {% liquid
    assign background_block = section.blocks | where: 'type', 'background' | first
    if background_block
      render 'smi-background'
    endif
  %}
  <div
    class="
      smi-collection-page-1-main smi-position-relative
      {%- if section.settings.container_full_width == true %} smi-container-fluid {%- else %} smi-container {%- endif -%}
    "
  >
    <div class="smi-loading-overlay"></div>
    <aside class="smi-sidebar smi-d-lazy {% if section.blocks.size == 0 %}smi-d-none{% endif %}">
        {% assign filter_block = section.blocks | where: 'type', 'filter' | first %}
        {% liquid
            if filter_block != blank
                assign show_filter = true
            else
                assign show_filter = false
                assign hidden_classes = ' smi-d-none'
            endif
            assign filter_classes = hidden_classes | append: ' smi-filter--vertical'
        %}
        {% liquid
  assign color_options = settings.smi_color_variant_name | default: shop.metafields.smind.settings.value.colorVariantName | downcase | replace: ', ', ',' | replace: ' , ', ',' | replace: ' ,', ',' | split: ','
  if color_options == blank
    assign color_options = 'color, colour, colors, colours, couleur, farbe' | downcase | replace: ', ', ',' | replace: ' , ', ',' | replace: ' ,', ',' | split: ','
  endif
  assign tag_heading = block.settings.tag_heading | default: section.settings.tag_heading
  assign tag_options = tag_heading | downcase | replace: ', ', ',' | replace: ' , ', ',' | replace: ' ,', ',' | split: ','
%}
{% capture icon_minus %}
  {% render 'smi-icons', icon: 'minus' %}
{% endcapture %}
{% capture icon_arrow_down %}
  {% render 'smi-icons', icon: 'arrow-down' %}
{% endcapture %}
{% capture icon_close %}
  {% render 'smi-icons', icon: 'close' %}
{% endcapture %}
<smi-cp-filter
  class="smi-w-100 {{- filter_classes -}}"
  sort-by="{{ collection.sort_by | default: collection.default_sort_by }}"
  {%- if section.settings.pagination == 'default' %}
    pagination-default
  {% endif -%}
  {{ filter_block.shopify_attributes }}
>
  <div class="smi-filter-heading smi-d-flex smi-justify-content-between smi-py-md smi-px-lg smi-d-lg-none">
    <span class="smi-h4">Filter</span>
    {{ icon_close }}
  </div>
  {%- for filter in collection.filters -%}
    {%- liquid
      assign tag_style = block.settings.tag_style | default: section.settings.tag_style
      assign is_color = false
      assign is_tags = false
      assign f_name = filter.label | downcase
      assign filter_attribute = ''
      if color_options contains f_name or filter.presentation == 'swatch'
        assign presentation = filter.presentation
        assign is_color = true
        assign filter_attribute = 'smi-sb-widget--scroll smi-filter-item--swatch smi-variant-wrapper'
        assign color_config = settings.smi_color_configuration | default: shop.metafields.smind.settings.value.variantValue | downcase | remove: " " | newline_to_br | split: '<br />'
        assign color_metaobjects = shop.metaobjects.shopify--color-pattern.values
      elsif tag_options contains f_name and tag_style != 'default'
        assign is_tags = true
        assign filter_attribute = 'smi-sb-widget--scroll smi-filter-item--tags smi-filter-item--tags-' | append: tag_style
      else
        assign filter_attribute = 'smi-sb-widget--scroll'
      endif
    -%}
    <div class="smi-filter-item smi-sb-widget {{ filter_item_classes }} {{ filter_attribute }}">
      <div class="smi-filter-title smi-sb-widget__title smi-sb-widget__click-area {{ filter_title_classes }} {{ section.settings.heading_size | default: "smi-h5" }}">
        <span>{{ filter.label }}</span>
        <div class="smi-sb-widget__btn">
          {{ icon_minus }}
          {{ icon_minus }}
        </div>
        <div class="smi-sb-widget__btn-arrow">
          {{ icon_arrow_down }}
        </div>
      </div>
      <div class="smi-filter-content smi-sb-widget__content">
        {%- case filter.type -%}
          {%- when 'boolean' -%}
            <ul>
              <li>
                <label for="Filter-{{ filter.param_name }}-{{ filter.true_value.value }}">
                  <input
                    type="checkbox"
                    name="{{ filter.param_name }}"
                    value="{{ filter.true_value.value }}"
                    id="Filter-{{ filter.param_name }}"
                    {% if filter.true_value.active -%}
                      checked
                    {%- endif %}
                    {% if filter.true_value.count == 0 and filter.true_value.active == false -%}
                      disabled
                    {%- endif -%}
                  >
                  {{- filter.true_value.label -}}
                </label>
              </li>
              <li>
                <label for="Filter-{{ filter.param_name }}-{{ filter.false_value.value }}">
                  <input
                    type="checkbox"
                    name="{{ filter.param_name }}"
                    value="{{ filter.false_value.value }}"
                    id="Filter-{{ filter.param_name }}"
                    {% if filter.false_value.active -%}
                      checked
                    {%- endif %}
                    {% if filter.false_value.count == 0 and filter.false_value.active == false -%}
                      disabled
                    {%- endif %}
                  >
                  {{- filter.false_value.label -}}
                </label>
              </li>
            </ul>
            <div>
              <input type="submit" value="Apply">
            </div>
          {%- when 'list' -%}
            <ul class="smi-filter--list">
              {%- for filter_value in filter.values -%}
                <li class="smi-mb-sm">
                  <label for="Filter-{{ filter.param_name }}-{{ forloop.index }}">
                    <input
                      type="checkbox"
                      name="{{ filter_value.param_name }}"
                      value="{{ filter_value.value }}"
                      id="Filter-{{ filter.param_name }}-{{ forloop.index }}"
                      {% if filter_value.active -%}
                        checked
                      {%- endif %}
                      {% if filter_value.count == 0 and filter_value.active == false -%}
                        disabled
                      {%- endif %}
                    >
                    {%- if is_color -%}
                      {% liquid
  assign image_filename = null
  assign color_code = null
  assign image_object = null
  case filter.presentation
    when 'text'
      if color_config.size > 0
        comment
          reference by color config settings
        endcomment
        assign color_label = filter_value.label | downcase | strip | remove: ' ' | escape
        assign file_type = 'jpg,JPG,png,PNG,gif,GIF,jpeg' | split: ','
        for cc in color_config
          assign cc_key = cc | split: ':' | first | strip | escape
          assign cc_value = cc | split: ':' | last | strip
          if cc_key == color_label and cc_value != blank
            assign file_extension = false
            assign file_extension = cc_value | split: '.' | last
            if file_type contains file_extension
              assign image_filename = cc_value
              break
            else
              assign color_code = cc_value
              break
            endif
          endif
        endfor
      endif
      unless color_code and image_filename
        comment
          reference by color shopify metaobject
        endcomment
        for entry in color_metaobjects
          if entry.label == filter_value.label
            assign image_object = entry.image.value
            assign color_code = entry.color
            break
          endif
        endfor
        assign color_label = filter_value.label | remove: ' '
      endunless
    when 'swatch'
      assign image_object = filter_value.swatch.image
      assign color_code = filter_value.swatch.color
  endcase
%}
<span class="smi-swatch-label" data-smi-tooltip="{{- filter_value.label -}}">
  {% if image_filename %}
    <span class="__s-image smi-d-block smi-wh-100 smi-p-relative smi-overflow-hidden">
      <img
        src="{{ image_filename | file_img_url: 'icon' }}"
        alt="{{ image_filename }}"
        width="32"
        height="32"
        loading="lazy"
        class="smi-wh-100 smi-object-fit-cover smi-p-absolute"
      >
    </span>
  {% elsif image_object %}
    <span class="__s-image smi-d-block smi-wh-100 smi-p-relative smi-overflow-hidden">
      {{
        image_object
        | image_url: width: 32, height: 32
        | image_tag: class: 'smi-wh-100 smi-object-fit-cover smi-p-absolute', loading: 'lazy'
      }}
    </span>
  {% else %}
    <span class="__s-color" style="background: {{ color_code | default: color_label }}"></span>
  {% endif %}
</span>
                    {% elsif is_tags %}
                      <span class="smi-label">{{ filter_value.label }}</span>
                      {% if section.settings.show_count %}
                        <span class="smi-count"> ({{ filter_value.count }})</span>
                      {% endif %}
                    {%- else -%}
                      <span class="smi-checkbox-label"></span>
                      <span class="smi-label smi-pl-sm">{{ filter_value.label }}</span>
                      {% if section.settings.show_count %}
                        <span class="smi-count smi-ms-auto">{{ filter_value.count }}</span>
                      {% endif %}
                    {%- endif -%}
                  </label>
                </li>
              {%- endfor -%}
            </ul>
          {%- when 'price_range' -%}
            <div class="smi-filter-price-range">
  {%- liquid
    assign min_value = filter.min_value.value | default: 0 | divided_by: 100.0
    assign max_value = filter.max_value.value | default: filter.range_max | divided_by: 100.0
    assign step_value = 1
    assign min_value_ceil = min_value | ceil
    assign max_value_ceil = max_value | ceil
    assign range_max_ceil = filter.range_max | divided_by: 100.0 | ceil
  -%}
  <div class="slider">
    <div class="progress"></div>
  </div>
  <div class="range-input">
    <input
      type="range"
      class="range-min"
      aria-label="Range min"
      min="0"
      max="{{ range_max_ceil }}"
      step="{{ step_value }}"
      value="{% if filter.min_value.value %}{{ min_value_ceil }}{% else %}0{% endif %}"
    >
    <input
      type="range"
      aria-label="Range max"
      class="range-max"
      min="0"
      max="{{ range_max_ceil }}"
      step="{{ step_value }}"
      value="{% if filter.max_value.value %}{{ max_value_ceil }}{% else %}{{ range_max_ceil }}{% endif %}"
    >
  </div>
  <div class="price-input">
    <div class="field smi-inputs-wrapper">
      <span>{{ cart.currency.symbol }}</span>
      <input
        type="number"
        aria-label="Price min"
        class="input-min"
        name="filter.v.price.gte"
        inputmode="numeric"
        type="number"
        min="0"
        max="{{ range_max_ceil }}"
        {%- if filter.min_value.value %}
          value="{{ min_value_ceil }}"
        {% else %}
          placeholder="0"
        {% endif -%}
      >
    </div>
    <div class="separator smi-color-text-75">{{ 'smind.collection.to' | t | downcase }}</div>
    <div class="field smi-inputs-wrapper">
      <span>{{ cart.currency.symbol }}</span>
      <input
        type="number"
        aria-label="price max"
        class="input-max"
        name="filter.v.price.lte"
        inputmode="numeric"
        min="0"
        max="{{ range_max_ceil }}"
        {%- if filter.max_value.value %}
          value="{{ max_value_ceil }}"
        {% else %}
          placeholder="{{ range_max_ceil }}"
        {% endif -%}
      >
    </div>
  </div>
</div>
        {%- endcase -%}
      </div>
    </div>
  {%- endfor -%}
</smi-cp-filter>
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'categories' -%}
            <div class="smi-block-categories smi-sb-widget smi-mw-100" {{ block.shopify_attributes }}>
    <div class="smi-sb-widget__title smi-sb-widget__click-area {{ section.settings.heading_size }}">
        <span class="smi-link-wrapper" smind-key="heading" smind-attributes smind-attr-text>{{ block.settings.heading }}</span>
        <div class="smi-sb-widget__btn">
            {% render 'smi-icons', icon: 'minus' %}
            {% render 'smi-icons', icon: 'minus' %}
        </div>
    </div>
    <div class="smi-sb-widget__content">
        <ul>
            {% assign menu = block.settings.menu %}
            {% for link in menu.links -%}
                <li class="smi-mb-sm {% if link.active %} active{% endif %}">
                    {{ link.title | link_to: link.url }}
                </li>
            {% else %}
                <li class="smi-mb-sm">
                    <a href="#" title="">Example category link</a>
                </li>
            {%- endfor %}
        </ul>
    </div>
</div>
          {%- when 'gallery' -%}
            {% assign imageHoverClasses = settings.smi_animations_hover_image | default: shop.metafields.smind.settings.value.imageHoverEffect | default: 'none' |  prepend: ' smi-hover-image-' %}
<div class="smi-block-gallery smi-sb-widget {%- if st.enable_collapsible_sidebar_on_mobile %} smi-sb-widget--hide{% endif -%}" {{ block.shopify_attributes }}>
