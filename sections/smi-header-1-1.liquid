		{% else %}
			--color-button-hover-text: {{ colorblock.settings.transparent_solid_button_label_color.red }}, {{ colorblock.settings.transparent_solid_button_label_color.green }},{{ colorblock.settings.transparent_solid_button_label_color.blue }};
