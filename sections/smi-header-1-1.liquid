</style>
{%-liquid
    if search.terms == "lazyer"
        assign lazyer = false
    else 
        assign lazyer = true
    endif
    assign header_classes = ''    
    if section.settings.show_divider
        assign header_classes = ' smi-section-header-1--divider'    
    endif
    if section.settings.show_shadow
        assign header_classes = header_classes | append: ' smi-section-header-1--shadow'  
    endif
    assign color_schema = section.settings.color_scheme
    assign is_transparent = false
    if section.settings.header_style == 'transparent' and request.page_type == 'index'
        assign is_transparent = true
        assign header_classes = header_classes | append: ' smi-section-header-1--transparent'
        assign color_schema_transparent = section.settings.transparent_color_scheme
    endif
    assign desktop_layout = section.settings.desktop_layout
    assign header_classes = header_classes | append: ' smi-header-sticky-' | append: section.settings.sticky_header | append: ' smi-section-header-1--' | append: desktop_layout
    capture icon_search
        render 'smi-icons', icon: 'search'
    endcapture
    capture icon_close
        render 'smi-icons', icon: 'close'
    endcapture
    capture icon_arrow_down
        render 'smi-icons', icon: 'arrow-down'
    endcapture
    capture icon_minus
        render 'smi-icons', icon: 'minus'
    endcapture
-%}
{% capture component_account %}
    {%- if shop.customer_accounts_enabled and section.settings.enable_account -%}
    <div class="smi-actions__account smi-lh-0">
        <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="smi-text-md smi-d-flex smi-align-items-center smi-column-gap-xs" aria-label="Account icon">
            {%- render 'smi-icons', icon: 'account' -%} <span class="smi-color-text-75">{{- 'smind.general.login' | t -}}</span>
        </a>
    </div>
{%- endif -%}
{%  endcapture %}
{% capture component_language %}
    {%- render 'smi-header-language', enabled: section.settings.enable_language, show_divider: section.settings.show_divider -%}
{%  endcapture %}
{% capture component_country %}
    {%- render 'smi-header-country', enabled: section.settings.enable_country, show_divider: section.settings.show_divider -%}
{%  endcapture %}
{% capture component_menu %}
    {%-liquid
    assign mega_items = ''
    for block in section.blocks
        if block.type == 'mega_classic' or block.type == 'mega_collection' or block.type == 'mega_banner' or block.type == 'mega_product' or block.type == 'mega_product_tab'
            assign menu_items = block.settings.menu_item | strip
            assign menu_items = menu_items | split: ','
            if menu_items.size > 0
                assign menu_items_revert = ''
                for menu_item in menu_items
                    assign menu_item_temp = menu_item | strip
                    assign mega_data_item = menu_item_temp | append: '|' | append: block.id
                    assign mega_items = mega_items | append: mega_data_item | append: '||'
                endfor
            endif
        endif
    endfor
    assign mega_items = mega_items | remove_last: '||' | split: '||'
    assign menu_mobile_type = 'drawer'
    if section.settings.dropdown_menu == true
        assign menu_mobile_type = 'dropdown'
    endif
    capture arrow_down
        if menu_mobile_type == 'drawer'
			echo '<span class="smi-btn-toggle-drawer smi-lh-0">'
            	echo icon_arrow_down
			echo '</span>'
        else 
            echo '<span class="smi-btn-toggle-pc">'
            echo icon_arrow_down
            echo '</span>'
            echo '<span class="smi-btn-toggle smi-btn-toggle-drawer">'
                echo icon_minus
                echo icon_minus
            echo '</span>'
        endif
    endcapture
-%}
<div class="smi-color-{{ color_schema }} smi-menu smi-d-flex smi-align-items-center smi-menu--divider-{{section.settings.show_divider}} smi-menu--{{- menu_mobile_type -}}">
    <button class="smi-menu__close smi-align-items-center smi-cursor-pointer smi-d-none" aria-label="Close menu">
        {{- icon_close -}}
    </button>
    {%- if section.settings.menu != blank -%}
        <ul class="smi-dropdown-popup-wrapper smi-menu__list smi-d-block smi-d-lg-flex smi-align-items-center smi-column-gap-lg smi-px-0">
            {%- for link in section.settings.menu.links -%}
                {%-liquid
                    assign has_mega = false
                    assign mega_column = 4
                    for mega_item in mega_items
                        assign mega_item_data = mega_item | split: '|'
                        assign mega_item_title = mega_item_data[0] | downcase | strip
                        assign link_title = link.title | downcase | strip
                        if mega_item_title == link_title
                            assign has_mega = true
                            assign mega_block = section.blocks | where: 'id', mega_item_data[1] | first
                            assign block = mega_block
                        endif                        
                    endfor
                    assign menu_loop = forloop.index
                -%}      
                <li 
                    id="smi-menu-item-{{ link.handle }}"
                    class="smi-menu-item smi-menu-item--depth-1 smi-menu-item--main smi-list-style-none {% if has_mega %}smi-menu-item--mega {% endif %} {% if link.current or link.child_active %} smi-menu-item--active {% endif %} smi-p-relative smi-d-flex smi-align-items-center"
                >
                    <a href="{{ link.url }}" class="smi-h-100 smi-d-flex smi-align-items-baseline smi-column-gap-xxs smi-p-relative smi-text-menu smi-color-text-75" aria-expanded="false">
                        <span class="smi-d-flex smi-align-items-center">{{- link.title -}}</span>
                        {%- if link.links != blank or has_mega -%} {{ arrow_down }} {%- endif -%}
                    </a>
                    {% if has_mega and mega_block %} 
                        {%-liquid
                            assign mega_name = mega_block.type | replace: 'mega_', '' | replace: '_', '-'
                            assign show_divider = section.settings.show_divider
                            assign mega_lazy_classes = 'smi-menu-child smi-mega smi-lazyer smi-mega--' | append: mega_name | append: ' smi-dropdown--style smi-mega--divider-' | append: show_divider | append: ' smi-color-' | append: color_schema
                        -%}
                        <div class="{{- mega_lazy_classes }} smi-mega--dropdown-{{ section.settings.dropdown_menu }}" id="smi-lazyer-{{mega_block.id}}-{{menu_loop}}" hidden aria-expanded="false">
                            {%- if lazyer -%}
                                <div class="smi-lazyer-loader smi-d-flex smi-align-items-center smi-justify-content-center">
                                    <div class="smi-loader-1 smi-loader-1--2x"></div>
                                </div>
                            {%- else -%}
                                {%- case mega_block.type -%}
                                    {%- when 'mega_classic' -%}
                                        {%-liquid
    assign number_column = mega_block.settings.number_column | times: 1
    if number_column > link.links.size
        assign number_column = link.links.size
    endif
    assign no_childlink = true
    assign menu_class = 'smi-text-md smi-color-text-75'
    if link.links != blank
        for childlink in link.links
            if childlink.links != blank
                assign no_childlink = false
                assign menu_class = 'smi-text-menu'
                break
            endif
        endfor
    endif
-%}
<div class="smi-mega__outer smi-w-100" style="--column-gap: {{ number_column }}">
    <div class="smi-container{%- if section.settings.full_width -%}-fluid{%- endif -%}">
        <div class="smi-mega__inner smi-d-block smi-d-lg-flex smi-py-xl smi-mega--column-{{number_column}} smi-g-columm smi-g-row smi-flex-wrap">
            <span tabindex="0" role="button" class="smi-menu-back smi-d-flex smi-d-lg-none smi-align-items-center smi-column-gap-xs smi-cursor-pointer smi-mt-sm smi-text-menu" aria-label="Go back">{{ arrow_down }} {{- link.title -}}</span>
            {%- if link.links != blank -%}
                    {%- assign loop_index = 1 -%}
                    {%- for childlink in link.links -%}
                        {%-liquid
                            if no_childlink == false
                                if link.links.size > 40
                                    assign divider_10 = forloop.index0 | divided_by: 12 
                                    if forloop.index0 > 0 and divider_10 == loop_index and forloop.index0 != 0
                                        assign loop_index = loop_index | plus: 1
                                    endif
                                else
                                    if link.links.size > 8
                                        assign divider_2 = forloop.index0 | divided_by: 3
                                        if forloop.index0 > 0 and divider_2 == loop_index and forloop.index0 != 0
                                            assign loop_index = loop_index | plus: 1
                                        endif
                                    else
                                        assign loop_index = forloop.index0
                                    endif
                                endif                                    
                            else
                                assign divider_6 = forloop.index0 | divided_by: 6 
                                if forloop.index0 > 0 and divider_6 == loop_index and forloop.index0 != 0
                                    assign loop_index = loop_index | plus: 1
                                endif
                            endif                                
                        -%}
                        <div
                            id="smi-menu-item-{{ link.handle }}-{{ childlink.handle }}"
                            class="smi-menu-item smi-menu-item--depth-2 {% if childlink.current %} smi-menu-item--active {% endif %} {% if no_childlink %} smi-menu-item--no-childlink {% endif %}"
                            style="--index: {{- loop_index -}};"
                        >
                            <a href="{{ childlink.url }}" class="smi-d-flex smi-align-items-center smi-justify-content-between smi-color-text {{ menu_class -}}">
                                <span class="smi-d-flex smi-align-items-center">{{ childlink.title }}</span>
                                {%- if childlink.links != blank -%} 
                                    <span class=" smi-d-block smi-d-lg-none">{{ arrow_down }}</span>
                                {%- endif -%}
                            </a>
                            {%- if childlink.links != blank -%}
                                <ul class="smi-menu-child smi-sub-mega-menu smi-px-0 smi-d-block smi-d-lg-flex smi-flex-column smi-row-gap-xs  smi-mt-sm">
                                    <span class="smi-menu-back smi-d-flex smi-d-lg-none smi-align-items-center smi-column-gap-xs smi-cursor-pointer smi-mt-sm smi-text-menu">{{ arrow_down }} {{- childlink.title -}}</span>
                                    {%- for grandchildlink in childlink.links -%}
                                        <li
                                            id="smi-menu-item-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                            class="smi-menu-item smi-menu-item--depth-3 smi-list-style-none {% if grandchildlink.current %} smi-menu-item--active {% endif %}"
                                        >
                                            <a href="{{ grandchildlink.url }}" class="smi-d-flex smi-align-items-center smi-justify-content-between smi-text-md smi-color-text-75"><span class="smi-d-flex smi-align-items-center">{{ grandchildlink.title }}</span></a>
                                        </li>
                                    {%- endfor -%}
                                </ul>
                            {%- endif -%}
                        </div>
                    {%- endfor -%}
            {%- endif -%}
        </div>
    </div>
</div> 
                                    {%- when 'mega_collection' -%}
                                        {%- assign number_column = mega_block.settings.number_column | times: 1 -%}
<div class="smi-mega__outer smi-w-100" style="--column-gap: {{ number_column }}">
    <div class="smi-container{%- if section.settings.full_width -%}-fluid{%- endif -%}">
        <div class="smi-mega__inner smi-d-block smi-d-lg-flex smi-py-xl smi-mega--column-{{number_column}} smi-g-columm smi-g-row smi-flex-wrap">
