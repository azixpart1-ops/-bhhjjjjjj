{%- liquid
  assign s = section.settings
-%}

{% render 'contrast-override', background_color: s.background_color, section_id: section.id %}

<div class="cc-section color-custom-{{ section.id }}">
  <div class="cc-container cc-container--reading">
    <div class="cc-head{% if s.align == 'center' %} cc-head--center{% endif %}" data-cc-reveal>
      <div>
        {%- if s.eyebrow != blank -%}<span class="cc-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="cc-head__title h2">{{ s.heading }}</h2>{%- endif -%}
      </div>
    </div>

    <div class="cc-faq" data-cc-reveal="80">
      {%- for block in section.blocks -%}
        <details class="cc-faq__item" {% if forloop.first and s.open_first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>
            <span>{{ block.settings.question }}</span>
            <span class="cc-faq__sign" aria-hidden="true"></span>
          </summary>
          <div class="cc-faq__answer rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>

    {%- if s.footer_text != blank or s.button_label != blank -%}
      <div style="margin-block-start: 2.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem;">
        {%- if s.footer_text != blank -%}
          <p class="cc-lede" style="margin: 0;">{{ s.footer_text }}</p>
        {%- endif -%}
        {%- if s.button_label != blank -%}
          <a href="{{ s.button_link | default: '#' }}" class="button button-secondary">{{ s.button_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- comment -%}
  FAQPage markup. Google only honours it when the questions and answers are
  visible on the page, which they are — the accordions render their content
  in the DOM regardless of open state.
{%- endcomment -%}
{%- if s.enable_schema and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | strip_html | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | strip_newlines | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "cc-section-faq",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Before you buy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The questions we get asked most" },
    {
      "type": "select",
      "id": "align",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "left"
    },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": true },
    {
      "type": "checkbox",
      "id": "enable_schema",
      "label": "Add FAQ structured data",
      "info": "Helps these answers appear directly in Google. Only enable on one section per page.",
      "default": true
    },
    { "type": "header", "content": "Footer" },
    { "type": "text", "id": "footer_text", "label": "Text", "default": "Anything else? Get in touch." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Contact us" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f7f3ec"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does delivery take?" },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Answer with your real policy. Copy the wording from your shipping and refund policy pages so the two can never contradict each other.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "category": "Conversion",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "How long will my bed take to arrive?",
            "answer": "<p>Express Dispatch beds are delivered within 1–3 working days of your order; everything else arrives within 1–4 working days. Working days are Monday to Friday, excluding bank holidays. The service for your item is shown at checkout, and we email tracking as soon as it's on its way.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What does delivery cost?",
            "answer": "<p>Nothing, to any UK mainland address. There's no minimum spend and no delivery charge — the price you see is the price you pay. For Northern Ireland, the Scottish Highlands and UK islands, email us before ordering and we'll confirm your postcode and any additional cost, so there are no surprises afterwards.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How is a bed actually delivered?",
            "answer": "<p>By a specialist large-item courier, to your front door. They'll contact you in advance with your delivery day, and someone over 18 needs to be in to receive it. Beds arrive flat-packed in protective packaging with clear assembly instructions and all fittings included.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Can I return it if it's not right?",
            "answer": "<p>Yes — you have 30 days from delivery. The item needs to be unused, in its original condition and original packaging, so keep the packaging until you're sure. We'll quote the collection cost before you confirm anything and deduct it from your refund, or you're welcome to arrange your own tracked courier. Refunds are issued within 14 days of the bed reaching us.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What if it arrives damaged?",
            "answer": "<p>Check your delivery on arrival. If any packaging or parts are damaged, email azixparz@outlook.com within 48 hours with photos and your order number. We'll put it right with a replacement part, a full replacement or a full refund — and for faulty or damaged goods, collection is arranged and paid for by us.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Can I cancel before it ships?",
            "answer": "<p>Any time. Email or call us before your order has been dispatched and we'll cancel it with a full and immediate refund — nothing to return and nothing to pay.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
