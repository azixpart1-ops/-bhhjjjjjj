{%- unless use_theme_font -%}
  <style>
    {{ section.settings.wordmark_font | font_face: font_display: 'swap' }}
    {{ section.settings.text_font | font_face: font_display: 'swap' }}
  </style>
{%- endunless -%}

<section
  class="{{ root_class }}"
  style="
    --modulo-fst-page-bg:{{ page_bg }};
    --modulo-fst-card-bg:{{ card_bg }};
    --modulo-fst-ink:{{ ink }};
    --modulo-fst-accent:{{ accent }};
    --modulo-fst-input-bg:{{ input_bg }};
    --modulo-fst-input-text:{{ input_text }};
    --modulo-fst-border-width:{{ border_width }}px;
    --modulo-fst-border-color:{{ border_color }};
    --modulo-fst-container-max:{{ container_max }}px;
    --modulo-fst-radius-card:{{ corner_radius }}px;
    --modulo-fst-field-radius:{{ field_radius }}px;
    --modulo-fst-pad-top:{{ pad_top }}px;
    --modulo-fst-pad-bottom:{{ pad_bottom }}px;
    --modulo-fst-pad-top-m:{{ pad_top_m }}px;
    --modulo-fst-pad-bottom-m:{{ pad_bottom_m }}px;
    --modulo-fst-line-height:{{ line_height }};
    --modulo-fst-link-size:{{ link_size }}px;
    --modulo-fst-wm-align:{{ wordmark_align }};
    --modulo-fst-font-wordmark:{{ font_wordmark }};
    --modulo-fst-font-text:{{ font_text }};
  "
>
  <div class="modulo-fst__card">

    {%- comment -%} ─── Region 1: wordmark hero ─── {%- endcomment -%}
    {%- if show_wordmark -%}
      <div class="modulo-fst__hero">
        {%- if wordmark_image != blank -%}
          <img class="modulo-fst__wordmark-img" src="{{ wordmark_image | image_url: width: 2400 }}" alt="{{ shop.name | escape }}" width="{{ wordmark_image.width }}" height="{{ wordmark_image.height }}" loading="lazy">
        {%- else -%}
          <h2 class="modulo-fst__wordmark">{{ wordmark_text | escape }}</h2>
        {%- endif -%}
      </div>
      <hr class="modulo-fst__rule">
    {%- endif -%}

    {%- comment -%} ─── Region 2: columns ─── {%- endcomment -%}
    <div class="modulo-fst__grid">

      {%- if show_newsletter -%}
        <div class="modulo-fst__col modulo-fst__col--news">
          {%- if ns_subheading != blank -%}
            <p class="modulo-fst__lede">{{ ns_subheading | escape }}</p>
          {%- endif -%}

          {%- form 'customer', class: 'modulo-fst__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="modulo-fst__vh" for="FooterStudioEmail-{{ section.id }}">Email address</label>
            <div class="modulo-fst__field">
              <input
                type="email"
                name="contact[email]"
                id="FooterStudioEmail-{{ section.id }}"
                class="modulo-fst__input"
                placeholder="{{ ns_placeholder | escape }}"
                autocomplete="email"
                required
              >
              <button type="submit" class="modulo-fst__submit">{{ ns_cta_label | escape }}</button>
            </div>
            {%- if form.posted_successfully? -%}
              <p class="modulo-fst__status modulo-fst__status--ok">Thanks — you're on the list.</p>
            {%- elsif form.errors -%}
              <p class="modulo-fst__status modulo-fst__status--err">{{ form.errors | default_errors }}</p>
            {%- endif -%}
          {%- endform -%}

          {%- if show_consent -%}
            <p class="modulo-fst__fine">
              {%- if consent_text != blank -%}
                {{ consent_text | escape }}
              {%- else -%}
                By signing up, you agree to our <a href="{{ privacy_url }}">Privacy Policy</a>*.
              {%- endif -%}
            </p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} Menu 1 — merchant menu, or polished fallback on first install ─── {%- endcomment -%}
      <nav class="modulo-fst__col" aria-label="{{ menu_1_title | escape }}">
        {%- if menu_1_title != blank -%}
          <h3 class="modulo-fst__label">{{ menu_1_title | escape }}</h3>
        {%- endif -%}
        <ul class="modulo-fst__links">
          {%- if menu_1 != blank -%}
            {%- for link in menu_1.links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/collections/all">Shop all</a></li>
            <li><a href="/collections/all">New arrivals</a></li>
            <li><a href="/pages/about">About us</a></li>
            <li><a href="/blogs/news">Journal</a></li>
            <li><a href="/pages/contact">Contact</a></li>
          {%- endif -%}
        </ul>
      </nav>

      {%- if menu_2 != blank -%}
        <nav class="modulo-fst__col" aria-label="{{ menu_2_title | default: 'Footer menu' | escape }}">
          {%- if menu_2_title != blank -%}
            <h3 class="modulo-fst__label">{{ menu_2_title | escape }}</h3>
          {%- endif -%}
          <ul class="modulo-fst__links">
            {%- for link in menu_2.links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      {%- comment -%} Socials — filled URLs, or polished fallback on first install ─── {%- endcomment -%}
      <div class="modulo-fst__col">
        <h3 class="modulo-fst__label">{{ socials_title | escape }}</h3>
        <ul class="modulo-fst__socials">
          {%- comment -%} Each link's visible <span> supplies its accessible name — no aria-label (avoids WCAG 2.5.3 label-in-name mismatch). {%- endcomment -%}
          {%- if has_any_social -%}
            {%- if social_instagram != blank -%}<li><a class="modulo-fst__social" href="{{ social_instagram }}" rel="noopener" target="_blank">{{ ic_instagram }}<span>Instagram</span></a></li>{%- endif -%}
            {%- if social_facebook != blank -%}<li><a class="modulo-fst__social" href="{{ social_facebook }}" rel="noopener" target="_blank">{{ ic_facebook }}<span>Facebook</span></a></li>{%- endif -%}
            {%- if social_x != blank -%}<li><a class="modulo-fst__social" href="{{ social_x }}" rel="noopener" target="_blank">{{ ic_x }}<span>Twitter</span></a></li>{%- endif -%}
            {%- if social_linkedin != blank -%}<li><a class="modulo-fst__social" href="{{ social_linkedin }}" rel="noopener" target="_blank">{{ ic_linkedin }}<span>Linkedin</span></a></li>{%- endif -%}
            {%- if social_tiktok != blank -%}<li><a class="modulo-fst__social" href="{{ social_tiktok }}" rel="noopener" target="_blank">{{ ic_tiktok }}<span>Tiktok</span></a></li>{%- endif -%}
            {%- if social_youtube != blank -%}<li><a class="modulo-fst__social" href="{{ social_youtube }}" rel="noopener" target="_blank">{{ ic_youtube }}<span>YouTube</span></a></li>{%- endif -%}
            {%- if social_pinterest != blank -%}<li><a class="modulo-fst__social" href="{{ social_pinterest }}" rel="noopener" target="_blank">{{ ic_pinterest }}<span>Pinterest</span></a></li>{%- endif -%}
          {%- else -%}
            <li><a class="modulo-fst__social" href="#">{{ ic_instagram }}<span>Instagram</span></a></li>
            <li><a class="modulo-fst__social" href="#">{{ ic_facebook }}<span>Facebook</span></a></li>
            <li><a class="modulo-fst__social" href="#">{{ ic_x }}<span>Twitter</span></a></li>
            <li><a class="modulo-fst__social" href="#">{{ ic_linkedin }}<span>Linkedin</span></a></li>
            <li><a class="modulo-fst__social" href="#">{{ ic_tiktok }}<span>Tiktok</span></a></li>
          {%- endif -%}
        </ul>
      </div>

      {%- if render_support -%}
        <div class="modulo-fst__col modulo-fst__col--support">
          <h3 class="modulo-fst__label">{{ support_title | escape }}</h3>
          {%- if support_line_1 != blank -%}
            <p class="modulo-fst__support">{{ support_line_1 | escape }}</p>
          {%- endif -%}
          {%- if support_email != blank -%}
            <p class="modulo-fst__support">
              {%- if support_line_2 != blank -%}{{ support_line_2 | escape }}<br>{%- endif -%}
              <a class="modulo-fst__email" href="mailto:{{ support_email | escape }}">{{ support_email | escape }}</a>
            </p>
          {%- endif -%}
          {%- if support_link_label != blank -%}
            <a class="modulo-fst__mini" href="{{ support_link_url | default: '#' }}">{{ support_link_label | escape }}</a>
          {%- endif -%}
          {%- if show_copyright and copy_text != blank -%}
            <p class="modulo-fst__copy">{{ copy_text | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Modulo: Footer Studio",
  "tag": "section",
  "class": "modulo-section-wrapper",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "header", "content": "Wordmark" },
    { "type": "checkbox", "id": "show_wordmark", "label": "Show wordmark", "default": true },
    { "type": "text", "id": "wordmark_text", "label": "Wordmark text", "info": "Your brand name. Leave blank to use your store name." },
    { "type": "image_picker", "id": "wordmark_image", "label": "Wordmark image", "info": "Overrides the text when set." },
    {
      "type": "select", "id": "wordmark_size", "label": "Wordmark size", "default": "large",
      "options": [
        { "value": "small",  "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large",  "label": "Large" },
        { "value": "huge",   "label": "Huge" }
      ]
    },
    {
      "type": "select", "id": "wordmark_align", "label": "Wordmark alignment", "default": "center",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },

    { "type": "header", "content": "Text & fonts" },
    { "type": "checkbox", "id": "use_theme_font", "label": "Use theme font", "default": true, "info": "On = inherit your theme's typography (recommended). Turn off to pick custom fonts." },
    { "type": "font_picker", "id": "wordmark_font", "label": "Wordmark font", "default": "helvetica_n7", "visible_if": "{{ section.settings.use_theme_font == false }}" },
    { "type": "font_picker", "id": "text_font", "label": "Body font", "default": "helvetica_n4", "visible_if": "{{ section.settings.use_theme_font == false }}" },
    { "type": "range", "id": "body_line_height", "label": "Line height", "min": 12, "max": 20, "step": 1, "default": 15, "info": "Tens (12 = 1.2, 15 = 1.5)." },
    { "type": "range", "id": "col_link_size", "label": "Link text size", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 15 },

    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter", "default": true },
    { "type": "textarea", "id": "ns_subheading", "label": "Text", "default": "Subscribe to our newsletter for weekly updates, exclusive content, and special offers delivered straight to your inbox." },
    { "type": "text", "id": "ns_placeholder", "label": "Input placeholder", "default": "Email Address" },
    { "type": "text", "id": "ns_cta_label", "label": "Button label", "default": "Subscribe" },
    {
      "type": "select", "id": "button_style", "label": "Button style", "default": "attached",
      "options": [
        { "value": "attached", "label": "Attached (inside the field)" },
        { "value": "stacked",  "label": "Stacked (full-width below)" },
        { "value": "outline",  "label": "Outline (below)" }
      ]
    },
    { "type": "range", "id": "field_radius", "label": "Field corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 30 },
    { "type": "checkbox", "id": "show_consent", "label": "Show privacy line", "default": true },
    { "type": "text", "id": "consent_text", "label": "Privacy text", "info": "Leave blank for the default 'By signing up…' line with a Privacy Policy link." },
    { "type": "url", "id": "privacy_url", "label": "Privacy policy link", "info": "Defaults to your store's privacy policy." },

