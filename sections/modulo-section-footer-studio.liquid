    { "type": "url", "id": "social_youtube",   "label": "YouTube URL" },
    { "type": "url", "id": "social_pinterest", "label": "Pinterest URL" },

    { "type": "header", "content": "Support column" },
    { "type": "text", "id": "support_title", "label": "Column title", "default": "Support" },
