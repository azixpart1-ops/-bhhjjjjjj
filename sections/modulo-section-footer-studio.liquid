{{ 'modulo-section-footer-studio.css' | asset_url | stylesheet_tag }}

{%- liquid
  # ─── Zone toggles
  assign show_wordmark   = section.settings.show_wordmark
  assign show_newsletter = section.settings.show_newsletter
  assign show_copyright  = section.settings.show_copyright

  # ─── Wordmark
  assign wordmark_text = section.settings.wordmark_text
  if wordmark_text == blank
    assign wordmark_text = shop.name
  endif
  assign wordmark_image = section.settings.wordmark_image
  assign wordmark_size  = section.settings.wordmark_size | default: 'large'
  assign wordmark_align = section.settings.wordmark_align | default: 'center'

  # ─── Typography / font
  assign use_theme_font = section.settings.use_theme_font
  assign line_height    = section.settings.body_line_height | default: 15
  assign line_height    = line_height | divided_by: 10.0
  assign link_size      = section.settings.col_link_size | default: 15

  # ─── Newsletter
  assign ns_subheading = section.settings.ns_subheading
  assign ns_placeholder = section.settings.ns_placeholder | default: 'Email Address'
  assign ns_cta_label   = section.settings.ns_cta_label | default: 'Subscribe'
  assign button_style   = section.settings.button_style | default: 'attached'
  assign show_consent   = section.settings.show_consent
  assign consent_text   = section.settings.consent_text
  assign privacy_url    = section.settings.privacy_url
  if privacy_url == blank
    assign privacy_url = shop.privacy_policy.url
  endif
  if privacy_url == blank
    assign privacy_url = '/policies/privacy-policy'
  endif

  # ─── Menus (link_list — empty = column hidden, fallback for menu 1)
  assign menu_1_title = section.settings.menu_1_title | default: 'Navigate'
  assign menu_1       = section.settings.menu_1
  assign menu_2_title = section.settings.menu_2_title
  assign menu_2       = section.settings.menu_2

  # ─── Socials
  assign socials_title    = section.settings.socials_title | default: 'Socials'
  assign social_instagram = section.settings.social_instagram
  assign social_facebook  = section.settings.social_facebook
  assign social_tiktok    = section.settings.social_tiktok
  assign social_x         = section.settings.social_x
  assign social_youtube   = section.settings.social_youtube
  assign social_linkedin  = section.settings.social_linkedin
  assign social_pinterest = section.settings.social_pinterest
  assign has_any_social   = false
  if social_instagram != blank or social_facebook != blank or social_tiktok != blank or social_x != blank or social_youtube != blank or social_linkedin != blank or social_pinterest != blank
    assign has_any_social = true
  endif

  # ─── Support
  assign support_title       = section.settings.support_title | default: 'Support'
  assign support_line_1      = section.settings.support_line_1
  assign support_line_2      = section.settings.support_line_2
  assign support_email       = section.settings.support_email
  assign support_link_label  = section.settings.support_link_1_label
  assign support_link_url    = section.settings.support_link_1_url
  assign copy_text = section.settings.copy_text
  if copy_text == blank
    assign current_year = 'now' | date: '%Y'
    assign copy_text = '© ' | append: current_year | append: ' ' | append: shop.name
  endif
  assign render_support = false
  if support_line_1 != blank or support_email != blank or support_link_label != blank or show_copyright
    assign render_support = true
  endif

  # ─── Column count (newsletter + menu1 + socials + menu2 + support)
  assign col_count = 0
  if show_newsletter
    assign col_count = col_count | plus: 1
  endif
  # menu 1 always renders (fallback), socials always render (fallback)
  assign col_count = col_count | plus: 2
  if menu_2 != blank
    assign col_count = col_count | plus: 1
  endif
  if render_support
    assign col_count = col_count | plus: 1
  endif

  # ─── Colors (compute every value — never inject an empty CSS var)
  assign bg_transparent = section.settings.bg_transparent
  assign bg_style   = section.settings.bg_style | default: 'solid'
  assign card_bg    = section.settings.card_bg_color | default: '#F4F4F5'
  if bg_style == 'gradient'
    assign grad_start = section.settings.grad_start | default: '#F7F7FB'
    assign grad_end   = section.settings.grad_end | default: '#EAEAF6'
    assign grad_angle = section.settings.grad_angle | default: 165
    assign card_bg = 'linear-gradient(' | append: grad_angle | append: 'deg, ' | append: grad_start | append: ', ' | append: grad_end | append: ')'
  endif
  if bg_transparent
    assign card_bg = 'transparent'
  endif
  assign page_bg    = section.settings.page_bg_color | default: '#FFFFFF'
  assign ink        = section.settings.ink_color | default: '#1A1A2E'
  assign accent     = section.settings.accent_color | default: '#6366F1'
  assign input_bg   = section.settings.input_bg_color | default: '#FFFFFF'
  assign input_text = section.settings.input_text_color
  if input_text == blank
    assign input_text = ink
  endif

  # ─── Layout / spacing
  assign section_width  = section.settings.section_width | default: 'boxed'
  assign container_max  = section.settings.container_max | default: 1480
  assign corner_radius  = section.settings.corner_radius | default: 22
  assign border_width   = section.settings.border_width | default: 0
  assign border_color   = section.settings.border_color | default: '#E5E7EB'
  assign field_radius   = section.settings.field_radius | default: 30
  assign pad_top        = section.settings.padding_top | default: 56
  assign pad_bottom     = section.settings.padding_bottom | default: 56
  assign pad_top_m      = section.settings.padding_top_mobile | default: 32
  assign pad_bottom_m   = section.settings.padding_bottom_mobile | default: 32

  # ─── Modifiers
  assign hover_effect = section.settings.link_hover_effect | default: 'underline'

  assign root_class = 'modulo-section modulo-fst'
  assign root_class = root_class | append: ' modulo-fst--width-' | append: section_width
  assign root_class = root_class | append: ' modulo-fst--wm-' | append: wordmark_size
  assign root_class = root_class | append: ' modulo-fst--btn-' | append: button_style
  assign root_class = root_class | append: ' modulo-fst--hover-' | append: hover_effect
  assign root_class = root_class | append: ' modulo-fst--cols-' | append: col_count
  if bg_transparent
    assign root_class = root_class | append: ' modulo-fst--transparent'
  endif

  # ─── Font families (theme font is the default; font_picker is opt-in)
  assign font_wordmark = 'inherit'
  assign font_text     = 'inherit'
  unless use_theme_font
    assign font_wordmark = section.settings.wordmark_font.family | append: ', ' | append: section.settings.wordmark_font.fallback_families
    assign font_text     = section.settings.text_font.family | append: ', ' | append: section.settings.text_font.fallback_families
  endunless
-%}

