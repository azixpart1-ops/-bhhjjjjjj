    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#6366F1", "info": "Subscribe button, focus rings, link hover." },
    {
      "type": "select", "id": "link_hover_effect", "label": "Link hover", "default": "underline",
      "options": [
        { "value": "underline", "label": "Underline" },
        { "value": "color",     "label": "Color shift" },
        { "value": "none",      "label": "None" }
      ]
    },
    { "type": "color", "id": "input_bg_color", "label": "Input background", "default": "#FFFFFF" },
    { "type": "color", "id": "input_text_color", "label": "Input text", "info": "Text in the email field + Subscribe label. Blank = inherit ink." }
  ],
  "presets": [
    { "name": "Modulo: Footer Studio" }
