{%- liquid
  assign s = section.settings
-%}

{% render 'contrast-override', background_color: s.background_color, section_id: section.id %}

<div class="cc-section color-custom-{{ section.id }}">
  <div class="cc-container">
    <div class="cc-head cc-head--center" data-cc-reveal>
      <div>
        {%- if s.eyebrow != blank -%}<span class="cc-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="cc-head__title h2">{{ s.heading }}</h2>{%- endif -%}
      </div>
    </div>

    {%- if s.show_summary -%}
      <div class="cc-reviews__summary" data-cc-reveal="60">
        {% render 'cc-rating', rating: s.rating_value, size: 18, text: s.summary_text %}
        {%- if s.summary_note != blank -%}
          <span class="cc-rating__text">{{ s.summary_note }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="cc-reviews__grid" data-cc-reveal="120">
      {%- for block in section.blocks -%}
        <figure class="cc-review" {{ block.shopify_attributes }}>
          {% render 'cc-rating', rating: block.settings.rating, size: 14, hide_text: true %}
          {%- if block.settings.headline != blank -%}
            <p class="cc-review__quote">{{ block.settings.headline }}</p>
          {%- endif -%}
          <blockquote class="cc-review__body">{{ block.settings.quote }}</blockquote>
          <figcaption class="cc-review__meta">
            <span class="cc-review__author">{{ block.settings.author }}</span>
            {%- if block.settings.location != blank -%}
              <span>· {{ block.settings.location }}</span>
            {%- endif -%}
            {%- if block.settings.verified -%}
              <span class="cc-review__verified">
                {% render 'cc-icon', icon: 'check-circle', size: 15 %}
                Verified
              </span>
            {%- endif -%}
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer reviews",
  "tag": "section",
  "class": "cc-section-reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Verified reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "2,400 bedrooms and counting" },
    { "type": "header", "content": "Summary" },
    { "type": "checkbox", "id": "show_summary", "label": "Show rating summary", "default": true },
    {
      "type": "range",
      "id": "rating_value",
      "label": "Average rating",
      "min": 1,
      "max": 5,
      "step": 0.1,
      "default": 4.8
    },
    { "type": "text", "id": "summary_text", "label": "Summary text", "default": "4.8 out of 5 · 2,412 reviews" },
    { "type": "text", "id": "summary_note", "label": "Supporting note", "default": "96% would buy from us again" },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#fbf8f2"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Review",
      "limit": 9,
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        { "type": "text", "id": "headline", "label": "Headline", "default": "Worth every penny" },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review",
          "default": "The storage is a game changer in a small room and the velvet still looks new a year on. Delivery team built it in twenty minutes and took the packaging away."
        },
        { "type": "text", "id": "author", "label": "Name", "default": "Hannah W." },
        { "type": "text", "id": "location", "label": "Location", "default": "Leeds" },
        { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer reviews",
      "category": "Conversion",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "headline": "Finally, storage that hides everything",
            "quote": "We swapped a divan for the ottoman and gained an entire wardrobe of space. The gas lift is effortless — I can open it one-handed.",
            "author": "Hannah W.",
            "location": "Leeds"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "headline": "It looks like the photos",
            "quote": "Ordered swatches first, which I'd recommend. The bouclé is exactly the shade shown and the frame feels genuinely solid, not flat-pack.",
            "author": "Marcus T.",
            "location": "Bristol"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "headline": "Delivery made the difference",
            "quote": "Two-man team carried it upstairs, assembled it and took the boxes. After a bad experience elsewhere, this was the reason I'd buy again.",
            "author": "Priya S.",
            "location": "London"
          }
        }
      ]
    }
  ]
}
{% endschema %}
