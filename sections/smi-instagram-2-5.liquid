<link href="{{ 'smi-instagram-2.min.css' | asset_url }}" rel="stylesheet" type="text/css" media="screen" onload="this.onload=null;this.media='all'">
{% comment %}#component#["settings/display-settings-2","settings/container-full_width-2","settings/heading","settings/media-settings-3","settings/slider-arrows","settings/slider-dots","settings/slides","settings/section-padding","settings/section-margin","blocks/background","settings/design-mode","settings/animation-settings"]#endcomponent#{% endcomment %}
<link rel="stylesheet" type="text/css" href="{{ 'smi-swiper-bundle.min.css' | asset_url }}" media="screen" onload="this.onload=null;this.media='all'">
<script src="{{ 'smi-swiper-bundle.min.js' | asset_url }}" defer data-id="smi-swiper-bundle.min.js" data-section-id="smi-{{ section.id }}"></script>
{% liquid
  if section.settings.enable_spacing_between_items == false
    assign space_between_mobile = '0px'
    assign space_between_desktop = '0px'
  else
    assign space_between_mobile = 'var(--grid-mobile-horizontal-spacing)'
    assign space_between_desktop = 'var(--grid-desktop-horizontal-spacing)'
  endif
  assign custom_blocks = section.blocks | where: 'type', 'image'
  assign block_length = custom_blocks | size
  assign slides_per_view_desktop = section.settings.number_of_columns_on_desktop | at_most: block_length
  assign slides_per_view_laptop = 3 | at_most: slides_per_view_desktop
  assign slides_per_view_tablet = 2 | at_most: slides_per_view_desktop
  assign slides_per_view_mobile = section.settings.number_of_columns_on_mobile | at_most: block_length
  if block_length == slides_per_view_mobile
    assign offset_swiper_mobile = 0
  else
    if section.settings.enable_spacing_between_items == false
      assign offset_swiper_mobile = '(30px + var(--media-border-width))'
    else
      assign offset_swiper_mobile = '30px'
    endif
  endif
  if section.settings.auto_rotate_slides == true
    assign delay = section.settings.change_slides_every | times: 1000
    assign autoplay = '{ "delay": ' | append: delay | append: '}'
  else
    assign autoplay = false
  endif
  assign block_color_length = section.blocks | where: 'type', 'color' | size
  if block_color_length == 1
    assign content_color = 'smi-content-color'
  else
    assign content_color = 'smi-color-' | append: section.settings.content_color_scheme
  endif
%}
<style>
    {% if block_color %}
    {% endif %}
  {% assign block_color = section.blocks | where: 'type', 'color' | first %}
{% if block_color %}
    #shopify-section-{{ section.id }} .smi-color-{{ section.settings.color_scheme }}{
        --color-background: {{ block_color.settings.background_color.red }}, {{ block_color.settings.background_color.green }},{{ block_color.settings.background_color.blue }};
		--color-background-alpha: {{ block_color.settings.background_color.alpha | default: 1 }};
        {% if block_color.settings.background_gradient_color == blank %}
            --gradient-background: {{ block_color.settings.background_color }};
        {% else %}
            --gradient-background: {{ block_color.settings.background_gradient_color }};
        {% endif %}
		{% if block_color.settings.heading_color != blank and block_color.settings.heading_color != 'rgba(0,0,0,0)' %}
			--color-heading: {{ block_color.settings.heading_color.red }}, {{ block_color.settings.heading_color.green }},{{ block_color.settings.heading_color.blue }};
		{% endif %}	
		--color-foreground-hex: {{ block_color.settings.text_color }};
        --color-foreground: {{ block_color.settings.text_color.red }}, {{ block_color.settings.text_color.green }},{{ block_color.settings.text_color.blue }};
		--color-subtext: {{ block_color.settings.subtext_color.red }},{{ block_color.settings.subtext_color.green }},{{ block_color.settings.subtext_color.blue }};
        --color-shadow: {{ block_color.settings.shadow_color.red }}, {{ block_color.settings.shadow_color.green }},{{ block_color.settings.shadow_color.blue }};
		--color-text-link: {{ block_color.settings.link_color.red }}, {{ block_color.settings.link_color.green }},{{ block_color.settings.link_color.blue }};
		{% if block_color.settings.hover_link_color != blank and block_color.settings.hover_link_color != 'rgba(0,0,0,0)' %}
			--color-hover-link: {{ block_color.settings.hover_link_color.red }}, {{ block_color.settings.hover_link_color.green }},{{ block_color.settings.hover_link_color.blue }};
		{% else %}
			--color-hover-link: {{ block_color.settings.link_color.red }}, {{ block_color.settings.link_color.green }},{{ block_color.settings.link_color.blue }};
		{% endif %}	
    }
{% endif %}
  #shopify-section-{{ section.id }}{
      --section-padding-top: {{ section.settings.padding_top }}px;
--section-padding-bottom: {{ section.settings.padding_bottom }}px;
--section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
--section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
      --heading-alignment: {%- liquid
    case  section.settings.heading_alignment
        when 'left'
         echo 'start'
        when 'right'
         echo 'end'
        else
         echo 'center'
    endcase
-%};
		--section-margin-sides: {{ section.settings.margin_sides }}px;
--section-margin-sides-mobile: {{ section.settings.margin_sides_mobile }}px;
		{% if  section.settings.custom_width == true and section.settings.container_full_width == false %}
--page-width: {{ section.settings.section_width }}px;
{% endif %}
      --space-between-mobile : {{ space_between_mobile }};
      --space-between-desktop : {{ space_between_desktop }};
      --item-width-xs: {{ slides_per_view_mobile | minus: 1 | prepend: 'calc((100% - ((' | append: ' * var(--space-between-mobile)) + ' | append: offset_swiper_mobile | append: '))/' | append: slides_per_view_mobile | append: ')' }};
      --item-width-md: {{ slides_per_view_tablet | minus: 1 | prepend: 'calc((100% - (' | append: ' * var(--space-between-desktop)))/' | append: slides_per_view_tablet | append: ')' }};
      --item-width-lg: {{ slides_per_view_laptop | minus: 1 | prepend: 'calc((100% - (' | append: ' * var(--space-between-desktop)))/' | append: slides_per_view_laptop | append: ')' }};
      --item-width-xl: {{ slides_per_view_desktop | minus: 1 | prepend: 'calc((100% - (' | append: ' * var(--space-between-desktop)))/' | append: slides_per_view_desktop | append: ')' }};
  }
</style>
<div
  id="smi-{{ section.id }}"
  class="smi-{{ section.id }} smi-display-settings smi-display-{{ section.settings.display_on }} smi-section__inner smi-gradient smi-section-instagram-2 smi-color-{{ section.settings.color_scheme }}"
  data-section="instagram-2"
  data-name="✧Instagram 2"
>
  
  {% liquid
    assign background_block = section.blocks | where: 'type', 'background' | first
    if background_block
      render 'smi-background'
    endif
  %}
  <div class="smi-container">{%-liquid
    if settings.smi_animations_reveal_on_scroll != nil
        assign animation_scroll = settings.smi_animations_reveal_on_scroll
    else
        assign global_settings = shop.metafields.smind.settings.value
        assign animation_scroll = global_settings.revealOnScroll
    endif
-%}
<div
	class="smi-heading-component smi-heading-component--align-{{ section.settings.heading_alignment }} smi-link-wrapper" {{- block.shopify_attributes -}}
	style="--heading-alignment: {{ section.settings.heading_alignment }}">
	{% liquid
		assign heading = section.settings.heading | strip
		assign sub_heading = section.settings.sub_heading | strip
		assign description = section.settings.description | strip
		assign heading_tags = section.settings.heading_tags | default:'h2'
		assign heading_size = section.settings.heading_size
	%}
	<div class="smi-heading-inner
    {%- if animation_scroll %} smi-scroll-trigger smi-animate--slide-in{% endif -%}
    {%- if heading != blank or sub_heading != blank or description != blank %} smi-mb-xxl{% endif -%}
    ">
		{%- assign sub_heading = section.settings.sub_heading | strip -%}
{%- assign sub_heading_size = blank -%}
{% if section.settings.sub_heading_size != blank %}
	{%- assign sub_heading_size = '-mb ' | append:section.settings.sub_heading_size  | prepend: section.settings.sub_heading_size -%}
{% endif %}
{% if sub_heading != blank %}
    <p class="{% if sub_heading_size != blank %}{{sub_heading_size}}{% else %}smi-text-sub{% endif %} smi-mb-xs smi-heading-component__subheading" smind-key="sub_heading" smind-attributes smind-attr-text>{{- sub_heading -}}</p>
{% endif %}
		{%- assign description = section.settings.description | strip -%}
{%- assign heading = section.settings.heading | strip -%}
{% if heading != blank %}
    <{{heading_tags}} class="{{ heading_size }} {% if description != blank %}smi-mb-sm{% endif %} smi-heading-component__heading" smind-key="heading" smind-attributes smind-attr-text>{{- heading -}}</{{heading_tags}}>
{% endif %}
		{%- assign description = section.settings.description | strip -%}
{%- assign description_size = blank -%}
{% if section.settings.description_size != blank %}
	{%- assign description_size = '-mb ' | append:section.settings.description_size  | prepend: section.settings.description_size -%}
{% endif %}
{% if description != blank %}
    <div class="{% if description_size != blank %}{{description_size}}{% else %}smi-text-md{% endif %} smi-heading-component__description smi-format-content" smind-key="description" smind-attributes smind-attr-text>{{ description }}</div>
{% endif %}
	</div>
</div>
</div>
  <div
    class="{%- if section.settings.media_shape == 'default' %}smi-media-shape-default {% endif -%}
      smi-section-instagram-2__main smi-media-wrapper-clone
      {%- if section.settings.slider_overflow == true %} smi-slide-overflow{% endif -%}
      {%- if section.settings.enable_spacing_between_items == false %} smi-content-gap-0{% endif -%}
    "
  >
    {%-liquid
    if settings.smi_animations_reveal_on_scroll != nil
        assign animation_scroll = settings.smi_animations_reveal_on_scroll
    else
        assign global_settings = shop.metafields.smind.settings.value
        assign animation_scroll = global_settings.revealOnScroll
    endif
-%}
    <div
      class="
        {% if section.settings.container_full_width %}smi-container-fluid{% else %}smi-container{% endif -%}
        {%- if animation_scroll %} smi-scroll-trigger smi-animate--slide-in smi-animate-order-1{% endif -%}
      "
    >
      <div class="smi-swiper-wrap">
        <div
          class="swiper smi-swiper"
          data-swiper-options='{"autoplay":{{ autoplay }},"pageDotStyle":"{{- section.settings.sticky_page_dot_style -}}"}'
        >
          <div class="swiper-wrapper">
            {% assign shape_index = 1 %}
            {% for block in custom_blocks %}
{%-liquid
    assign media_ratio = section.settings.media_ratio
    assign media_shape = section.settings.media_shape
    assign media_classes = 'smi-w-100 smi-object-fit-cover '
    if media_shape != 'default' and media_shape != 'round'
        if shape_index > 6
            assign shape_index = 1
        endif
        if shape_index < 6 
            assign forloop_next = shape_index | plus: 1
        else
            assign forloop_next = 1
        endif
        assign media_classes = media_classes | append: ' smi-shape-blob-' | append: shape_index
        assign shape_index = shape_index | plus: 1
        assign shape_hover = '--shape-blob-' | append: forloop_next
    endif
    if media_ratio == 'auto' 
        assign media_classes = media_classes | append: ' smi-h-auto'
    else
        assign media_classes = media_classes | append: ' smi-h-100 smi-p-absolute'
    endif
    assign media_wrapper_classes = 'smi-media-wrapper smi-border smi-shadow smi-lh-0 smi-overflow-hidden smi-p-relative smi-' | append: media_shape
    if media_shape contains 'blob'
        assign media_wrapper_classes = media_wrapper_classes | append: ' smi-blob-wrapper smi-has-blob'
    endif
-%}
              <div class="swiper-slide" data-swiper-slide-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                  {% liquid
  assign placeholder_image = 'image'
  if block.settings.link != blank
    assign link = block.settings.link
  else
    assign link = null
  endif
%}
<div
  class="
    {{- 'smi-card-collection smi-overflow-hidden' -}}
    {%- if section.settings.media_shape != 'shape-blob' -%}
      {{- ' smi-media-wrapper smi-border' -}}
      {%- if section.settings.enable_spacing_between_items == true %} smi-shadow{% endif -%}
    {%- endif -%}
    {%- if section.settings.media_shape == 'round' %} smi-round{% endif -%}
  "
>
  <a
    href="{{ link | default: '#' }}"
    target="_blank"
    {% unless link != blank -%}
      onclick="return false;"
    {%- endunless %}
    class="
      {{- media_wrapper_classes -}}
        {{- ' smi-d-block' -}}
        {%- if section.settings.media_shape != 'shape-blob' -%}
          {{- settings.smi_animations_hover_image
      | default: shop.metafields.smind.settings.value.imageHoverEffect
      | default: 'none'
      | prepend: ' smi-hover-image-'
      -}}
        {%- endif -%}
    "
    style="--media-ratio: {{ media_ratio }}; --shape-hover: var({{ shape_hover }})"
    data-type="item-image"
    aria-label="{{ block.id }}"
  >
    {% assign img_classes = media_classes | append: ' __smi-collection-image' %}
    {% assign svg_classes = media_classes | append: ' smi-placeholder-svg' %}
    {% if block.settings.image != blank %}
      {{
        block.settings.image
        | image_url: width: 1200
        | image_tag:
          class: img_classes,
          widths: '200,300,400,600,800,1000,1200',
          sizes: '(max-width: 460px) calc(100vw/2)',
          loading: 'lazy'
      }}
    {% else %}
      {% assign svg_classes = svg_classes | append: ' smi-placeholder-light' %}	
      {{ placeholder_image | placeholder_svg_tag: svg_classes }}
    {% endif %}
    <div class="_overlay">
      {%- render 'smi-icons', icon: 'instagram' -%}
    </div>
  </a>
</div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
      <div class="smi-swiper-controls">
        <div class="smi-swiper-navigation">{% liquid
  unless st_navigation
    assign st_navigation = section.settings.arrow_style
  endunless
%}
{% if st_navigation != 'none' %}
  {% liquid
    case st_navigation
      when 'arr-style-2' or 'arr-square-style-4' or 'arr-square-style-5' or 'arr-square-style-6' or 'arr-circle-style-4' or 'arr-circle-style-5' or 'arr-rounded-rectangle-bg' or 'arr-rounded-rectangle'
        capture st_navigation_left
          render 'smi-icons', icon: 'arrow-left-2'
        endcapture
      else
        capture st_navigation_left
          render 'smi-icons', icon: 'arrow-left'
        endcapture
    endcase
  %}
  <div class="smi-component-arrow-slider">
    <div class="arrow-slider-content">
      <div class="{{ st_navigation }} arrow-icon arrow-slider-left smi-cursor-pointer" smind-key="arrow_style" smind-attributes smind-attr-arrow>
        {{ st_navigation_left }}
      </div>
      <div class="{{ st_navigation }} arrow-icon arrow-icon--flip arrow-slider-right smi-cursor-pointer" smind-key="arrow_style" smind-attributes smind-attr-arrow>
            {{ st_navigation_left }}
      </div>
    </div>
  </div>
{% endif %}
</div>
        {% if section.settings.sticky_page_dot_style != 'none' %}
          <div class="smi-swiper-pagination smi-pt-xl smi-mw-100">{% if section.settings.sticky_page_dot_style != 'none' %}
  <div class="smi-slider-dot-container">
    {%- if section.settings.sticky_page_dot_style == 'text-style-1'
      or section.settings.sticky_page_dot_style == 'text-style-2'
      or section.settings.sticky_page_dot_style == 'text-style-3'
    -%}
      <div class="smi-component-sticky-page-dot">
        <div class="smi-slider-action">
          <div class="smi-arrows {{ section.settings.sticky_page_dot_style }}" smind-key="sticky_page_dot_style,pagination_alignment" smind-attributes smind-attr-pagination>
            <div data-control="textPrevSlide" class="smi-arrow dot-arrow-slider smi-text-sm">{% render 'smi-icons', icon: 'arrow-left' %}</div>
            <div class="text-pagination smi-pagination smi-slider-pagination smi-text-sm smi-arrow"></div>
            <div data-control="textNextSlide" class="smi-arrow dot-arrow-slider smi-text-sm">{% render 'smi-icons', icon: 'arrow-right' %}</div>
          </div>
        </div>
      </div>
    {%- else -%}
      <div class="dot-container {{ section.settings.sticky_page_dot_style }}">
        <div
          class="swiper-pagination smi-pagination"
          {% if section.settings.sticky_page_dot_style == 'dot-style-4' %}
            style="display: flex;"
          {% endif %}
        ></div>
      </div>
    {%- endif -%}
  </div>
{% endif %}
</div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
<div class="smi-d-none smi-basico-item">&nbsp; </div>
{% schema %}
{
	"name": "✧Instagram 2-5",
	"tag": "section",
	"class": "smi-section smi-pods-item smi-instagram-2",
	"disabled_on": {
		"groups": [
			"header",
			"footer",
			"aside"
		]
	},
	"settings": [
		{
			"type": "select",
			"id": "display_on",
			"label": "Display on",
			"options": [
				{
					"value": "desktop",
					"label": "Desktop only"
				},
				{
					"value": "mobile",
					"label": "Mobile only"
				},
				{
					"value": "all",
					"label": "All device"
				}
			],
			"default": "all"
		},
		{
			"type": "checkbox",
			"id": "container_full_width",
			"label": "Container full-width",
			"default": false
		},
		{
			"type": "checkbox",
			"id": "custom_width",
			"label": "Custom width",
			"default": false,
			"visible_if": "{{ section.settings.container_full_width == false }}"
		},
		{
			"type": "range",
			"id": "section_width",
			"label": "Section width",
			"min": 800,
			"max": 2000,
			"step": 20,
			"unit": "px",
			"default": 1200,
			"visible_if": "{{ section.settings.container_full_width == false and section.settings.custom_width == true }}"
		},
		{
			"type": "checkbox",
			"id": "enable_spacing_between_items",
			"label": "Enable spacing between items",
			"default": true
		},
		{
			"type": "paragraph",
			"content": "Advanced font controls are available in Smind Style. [Learn more](https://docs.smind.io/guides/configuring-typography)"
		},
		{
			"type": "inline_richtext",
			"id": "sub_heading",
			"label": "Subheading",
			"default": "URNA CRAS MAURIS"
		},
		{
			"type": "select",
			"id": "sub_heading_size",
			"label": "Subheading size",
			"options": [
				{
					"value": "smi-text-sub",
					"label": "XS"
				},
				{
					"value": "smi-text-sub-sm",
					"label": "S"
				}
			],
			"default": "smi-text-sub"
		},
		{
			"type": "inline_richtext",
			"id": "heading",
			"label": "Heading",
			"default": "Happy Customers Say"
		},
		{
			"type": "select",
			"id": "heading_tags",
			"label": "Heading tags",
			"options": [
				{
					"value": "h1",
					"label": "H1"
				},
				{
					"value": "h2",
					"label": "H2"
				},
				{
					"value": "h3",
					"label": "H3"
				},
				{
					"value": "h4",
					"label": "H4"
				},
				{
					"value": "h5",
					"label": "H5"
				},
				{
					"value": "h6",
					"label": "H6"
				}
			],
			"default": "h2"
		},
		{
			"type": "select",
			"id": "heading_size",
			"label": "Heading size",
			"options": [
				{
					"value": "smi-h4",
					"label": "S"
				},
				{
					"value": "smi-h3",
					"label": "M"
				},
				{
					"value": "smi-h2",
					"label": "L"
				},
				{
					"value": "smi-h1",
					"label": "XL"
				}
			],
			"default": "smi-h2"
		},
		{
			"type": "richtext",
			"id": "description",
			"label": "Description",
			"default": "<p>Commodo lorem morbi aliquam dui turpis. Iaculis pretium posuere nulla tincidunt blandit. A at elementum faucibus integer.</p>"
		},
		{
			"type": "select",
			"id": "description_size",
			"label": "Description size",
			"options": [
				{
					"value": "smi-text-xs",
					"label": "XS"
				},
				{
					"value": "smi-text-sm",
					"label": "S"
				},
				{
					"value": "smi-text-md",
					"label": "M"
				},
				{
					"value": "smi-text-lg",
					"label": "L"
				}
			],
			"default": "smi-text-md"
		},
		{
			"type": "text_alignment",
			"id": "heading_alignment",
			"label": "Heading alignment",
			"default": "center"
		},
		{
			"type": "header",
			"content": "Media settings"
		},
		{
			"type": "select",
			"id": "media_ratio",
			"label": "Media ratio",
			"options": [
				{
					"value": "auto",
					"label": "Adapt"
				},
				{
					"value": "3/2",
					"label": "Landscape"
				},
				{
					"value": "1/1",
					"label": "Square"
				},
				{
					"value": "3/4",
					"label": "Portrait"
				}
			],
			"default": "3/4"
		},
		{
			"type": "select",
			"id": "media_shape",
			"label": "Media shape",
			"options": [
				{
					"value": "default",
					"label": "Default"
				},
				{
					"value": "round",
					"label": "Round"
				},
				{
					"value": "shape-blob",
					"label": "Blob"
				}
			],
			"default": "default",
			"info": "Media theme settings don't apply to the \"Blob\" shape."
		},
		{
			"type": "header",
			"content": "Navigation"
		},
		{
			"type": "select",
			"id": "arrow_style",
			"label": "Arrow",
			"options": [
				{
					"value": "none",
					"label": "None"
				},
				{
					"value": "arr-style-1",
					"label": "Style 1"
				},
				{
					"value": "arr-style-2",
					"label": "Style 2"
				},
				{
					"value": "arr-square-style-1",
					"label": "Square style 1"
				},
				{
					"value": "arr-square-style-2",
					"label": "Square style 2"
				},
				{
