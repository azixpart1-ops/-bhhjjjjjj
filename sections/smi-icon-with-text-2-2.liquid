{% comment %}#component#["settings/display-settings-2","settings/container-full_width-2","settings/heading","layout/grid-slider","settings/section-padding","settings/section-margin","settings/icon-with-text-3","blocks/background","settings/slider-dots-v2.with-info","settings/custom-icons.default-value","settings/design-mode","settings/animation-settings","settings/image.vars","settings/slider-dots-v2","settings/custom-icons"]#endcomponent#{% endcomment %}
{% liquid
  assign object_loop = section.blocks | where: 'type', 'icon_with_text'
  assign show_border = false
  assign icon_position = section.settings.icon_position
  assign content_alignment = section.settings.content_alignment
  assign content_color = section.settings.content_color_scheme
  assign block_color = section.blocks | where: 'type', 'color' | first
  if block_color
  	assign content_color = "content"
  endif
  if section.settings.content_alignment == 'left'
        assign classes_position_button = 'smi-justify-content-start'
    elsif section.settings.content_alignment == 'right'
        assign classes_position_button = 'smi-justify-content-end'
    else
        assign classes_position_button = 'smi-justify-content-center'
    endif
%}
<style>
    {% if block_color %}
    {% endif %}
  {% assign block_color = section.blocks | where: 'type', 'color' | first %}
{% if block_color %}
    #shopify-section-{{ section.id }} .smi-color-{{ section.settings.color_scheme }}{
        --color-background: {{ block_color.settings.section_background_color.red }}, {{ block_color.settings.section_background_color.green }},{{ block_color.settings.section_background_color.blue }};        
        --color-background-alpha: {{ block_color.settings.section_background_color.alpha | default: 1 }};
        {% if block_color.settings.section_background_gradient_color == blank %}
            --gradient-background: {{ block_color.settings.section_background_color }};
        {% else %}
            --gradient-background: {{ block_color.settings.section_background_gradient_color }};
        {% endif %}
        --color-foreground-hex: {{ block_color.settings.section_text_color }};
		{% if block_color.settings.section_heading_color != blank and block_color.settings.section_heading_color != 'rgba(0,0,0,0)' %}
			--color-heading: {{ block_color.settings.section_heading_color.red }}, {{ block_color.settings.section_heading_color.green }},{{ block_color.settings.section_heading_color.blue }};
		{% endif %}	
        --color-foreground: {{ block_color.settings.section_text_color.red }}, {{ block_color.settings.section_text_color.green }},{{ block_color.settings.section_text_color.blue }};
        --color-subtext: {{ block_color.settings.section_subtext_color.red }},{{ block_color.settings.section_subtext_color.green }},{{ block_color.settings.section_subtext_color.blue }};
		--color-text-link: {{ block_color.settings.section_link_color.red }}, {{ block_color.settings.section_link_color.green }},{{ block_color.settings.section_link_color.blue }};
		{% if block_color.settings.section_hover_link_color != blank and block_color.settings.section_hover_link_color != 'rgba(0,0,0,0)' %}
			--color-hover-link: {{ block_color.settings.section_hover_link_color.red }}, {{ block_color.settings.section_hover_link_color.green }},{{ block_color.settings.section_hover_link_color.blue }};
		{% else %}
			--color-hover-link: {{ block_color.settings.section_link_color.red }}, {{ block_color.settings.section_link_color.green }},{{ block_color.settings.section_link_color.blue }};
		{% endif %}
		--color-shadow: {{ block_color.settings.section_shadow_color.red }}, {{ block_color.settings.section_shadow_color.green }},{{ block_color.settings.section_shadow_color.blue }};
    }
    #shopify-section-{{ section.id }} .smi-color-content  {
        --color-background: {{ block_color.settings.blog_background_color.red }}, {{ block_color.settings.blog_background_color.green }},{{ block_color.settings.blog_background_color.blue }};
        {% if block_color.settings.blog_background_gradient_color == blank %}
            --gradient-background: {{ block_color.settings.blog_background_color }};
        {% else %}
            --gradient-background: {{ block_color.settings.blog_background_gradient_color }};
        {% endif %}
		{% if block_color.settings.blog_heading_color != blank and block_color.settings.blog_heading_color != 'rgba(0,0,0,0)' %}
			--color-heading: {{ block_color.settings.blog_heading_color.red }}, {{ block_color.settings.blog_heading_color.green }},{{ block_color.settings.blog_heading_color.blue }};
		{% endif %}
        --color-foreground: {{ block_color.settings.blog_text_color.red }}, {{ block_color.settings.blog_text_color.green }},{{ block_color.settings.blog_text_color.blue }};
		--color-text-link: {{ block_color.settings.blog_link_color.red }}, {{ block_color.settings.blog_link_color.green }},{{ block_color.settings.blog_link_color.blue }};
		{% if block_color.settings.blog_hover_link_color != blank and block_color.settings.blog_hover_link_color != 'rgba(0,0,0,0)' %}
			--color-hover-link: {{ block_color.settings.blog_hover_link_color.red }}, {{ block_color.settings.blog_hover_link_color.green }},{{ block_color.settings.blog_hover_link_color.blue }};
		{% else %}
			--color-hover-link: {{ block_color.settings.blog_link_color.red }}, {{ block_color.settings.blog_link_color.green }},{{ block_color.settings.blog_link_color.blue }};
		{% endif %}
        --color-secondary-button-text: {{ block_color.settings.blog_outline_button_color.red }}, {{ block_color.settings.blog_outline_button_color.green }},{{ block_color.settings.blog_outline_button_color.blue }};
        {% if block_color.settings.blog_outline_button_hover_color != blank and block_color.settings.blog_outline_button_hover_color != 'rgba(0,0,0,0)' %}
			--color-button-hover-border: {{ block_color.settings.blog_outline_button_hover_color.red }}, {{ block_color.settings.blog_outline_button_hover_color.green }},{{ block_color.settings.blog_outline_button_hover_color.blue }};
		{% else %}
			--color-button-hover-border: {{ block_color.settings.blog_outline_button_color.red }}, {{ block_color.settings.blog_outline_button_color.green }},{{ block_color.settings.blog_outline_button_color.blue }};
		{% endif %}		
    }
{% endif %}
  #shopify-section-{{ section.id }}{
      --section-padding-top: {{ section.settings.padding_top }}px;
--section-padding-bottom: {{ section.settings.padding_bottom }}px;
--section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
--section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
      --heading-alignment: {%- liquid
    case  section.settings.heading_alignment
        when 'left'
         echo 'start'
        when 'right'
         echo 'end'
        else
         echo 'center'
    endcase
-%};
	  --section-margin-sides: {{ section.settings.margin_sides }}px;
--section-margin-sides-mobile: {{ section.settings.margin_sides_mobile }}px;
		{% if  section.settings.custom_width == true and section.settings.container_full_width == false %}
--page-width: {{ section.settings.section_width }}px;
{% endif %}
      --content-alignment: {{ section.settings.content_alignment }};
      --media-padding: {{ section.settings.media_padding }}px;
  }  
.smi-component-settings-icon-with-text-2{height:100%}.smi-component-settings-icon-with-text-2 .icon-with-text-style-2-container{height:100%}.smi-component-settings-icon-with-text-2 .content-right-padding{width:100%}.smi-component-settings-icon-with-text-2 .content-right{width:calc(100% - var(--icon-size))}.smi-component-settings-icon-with-text-2 .icon-size{border-radius:500px}.smi-component-settings-icon-with-text-2 img,.smi-component-settings-icon-with-text-2 svg{width:var(--icon-size);height:var(--icon-size);object-fit:cover}.smi-component-settings-icon-with-text-2 .icon-size-normal{width:var(--icon-size);height:var(--icon-size);border-radius:var(--media-radius)}.smi-component-settings-icon-with-text-2 .icon-size-bg{padding:12px;width:calc(var(--icon-size) + 24px);height:calc(var(--icon-size) + 24px);overflow:hidden;background:var(--icon-background)}.smi-component-settings-icon-with-text-2 h4 a{margin-left:3px}.smi-component-settings-icon-with-text-2 .text-content{display:flex !important}.smi-component-settings-icon-with-text-2 .text-content p{letter-spacing:var(--body-letter-spacing-scale, 0)}.smi-component-settings-icon-with-text-2 .text-content .content{width:100%}.smi-component-settings-icon-with-text-2 .text-content .smi-content{margin-bottom:0px !important}.smi-component-settings-icon-with-text-2 .content-alignment-left{text-align:left}.smi-component-settings-icon-with-text-2 .content-alignment-right{text-align:right}.smi-component-settings-icon-with-text-2 .content-alignment-center{text-align:center}.smi-component-settings-icon-with-text-2 .icon-align-left{margin:auto auto auto 0px}.smi-component-settings-icon-with-text-2 .icon-align-center{margin:auto}.smi-component-settings-icon-with-text-2 .icon-align-right{margin:auto 0px auto auto}@media screen and (max-width: 768px){.smi-component-settings-icon-with-text-half-width{max-width:100%}}@media screen and (max-width: 767.8px){.smi-display-settings.smi-display-desktop{display:none !important}}@media screen and (min-width: 768px){.smi-display-settings.smi-display-mobile{display:none !important}}.smi-section-icon-wth-text-2 .smi-button--text{color:rgba(var(--color-secondary-button-text), 1) !important;border-bottom:1px solid rgba(var(--color-secondary-button-text), 1) !important}.smi-section-icon-wth-text-2 .icon-with-text-style-2{overflow:hidden}@media(min-width: 768px){.smi-section-icon-wth-text-2 .smi-layout-grid-slider.smi-style-standard .smi-swiper-wrapper{row-gap:var(--grid-desktop-vertical-spacing)}}
</style>
<script src="{{ 'smi-video.min.js' | asset_url }}" defer data-id="smi-video.min.js" data-section-id="smi-{{ section.id }}"></script>
<link rel="stylesheet" type="text/css" href="{{ 'smi-video.min.css' | asset_url }}" media="screen" onload="this.onload=null;this.media='all'">
<div
  id="smi-{{ section.id }}"
  class="smi-{{ section.id }} smi-display-settings smi-display-{{ section.settings.display_on }} smi-section__inner smi-gradient smi-section-icon-wth-text-2 smi-color-{{ section.settings.color_scheme }}"
  data-section="icon-with-text-2"
  data-name="✧Icon with text 2"
>
  
  {% liquid
    assign background_block = section.blocks | where: 'type', 'background' | first
    if background_block
      render 'smi-background'
    endif
  %}
  <div class="smi-container">{%-liquid
    if settings.smi_animations_reveal_on_scroll != nil
        assign animation_scroll = settings.smi_animations_reveal_on_scroll
    else
        assign global_settings = shop.metafields.smind.settings.value
        assign animation_scroll = global_settings.revealOnScroll
    endif
-%}
<div
	class="smi-heading-component smi-heading-component--align-{{ section.settings.heading_alignment }} smi-link-wrapper" {{- block.shopify_attributes -}}
	style="--heading-alignment: {{ section.settings.heading_alignment }}">
	{% liquid
		assign heading = section.settings.heading | strip
		assign sub_heading = section.settings.sub_heading | strip
		assign description = section.settings.description | strip
		assign heading_tags = section.settings.heading_tags | default:'h2'
		assign heading_size = section.settings.heading_size
	%}
	<div class="smi-heading-inner
    {%- if animation_scroll %} smi-scroll-trigger smi-animate--slide-in{% endif -%}
    {%- if heading != blank or sub_heading != blank or description != blank %} smi-mb-xxl{% endif -%}
    ">
		{%- assign sub_heading = section.settings.sub_heading | strip -%}
{%- assign sub_heading_size = blank -%}
{% if section.settings.sub_heading_size != blank %}
	{%- assign sub_heading_size = '-mb ' | append:section.settings.sub_heading_size  | prepend: section.settings.sub_heading_size -%}
{% endif %}
{% if sub_heading != blank %}
    <p class="{% if sub_heading_size != blank %}{{sub_heading_size}}{% else %}smi-text-sub{% endif %} smi-mb-xs smi-heading-component__subheading" smind-key="sub_heading" smind-attributes smind-attr-text>{{- sub_heading -}}</p>
{% endif %}
		{%- assign description = section.settings.description | strip -%}
{%- assign heading = section.settings.heading | strip -%}
{% if heading != blank %}
    <{{heading_tags}} class="{{ heading_size }} {% if description != blank %}smi-mb-sm{% endif %} smi-heading-component__heading" smind-key="heading" smind-attributes smind-attr-text>{{- heading -}}</{{heading_tags}}>
{% endif %}
		{%- assign description = section.settings.description | strip -%}
{%- assign description_size = blank -%}
{% if section.settings.description_size != blank %}
	{%- assign description_size = '-mb ' | append:section.settings.description_size  | prepend: section.settings.description_size -%}
{% endif %}
{% if description != blank %}
    <div class="{% if description_size != blank %}{{description_size}}{% else %}smi-text-md{% endif %} smi-heading-component__description smi-format-content" smind-key="description" smind-attributes smind-attr-text>{{ description }}</div>
{% endif %}
	</div>
</div>
</div>
  <div class="smi-section-icon-with-text-2__main smi-overflow-x-clip">
    <div
      class="{% if section.settings.container_full_width %}smi-container-fluid{% else %}smi-container{% endif -%}"
    >
{% liquid
  case border_style
    when 'none'
      assign border_classes = ''
    when 'content'
      assign border_classes = ' smi-content-wrapper'
    when 'blog'
      assign border_classes = ' smi-article-card-wrapper'
      if settings.smi_blog_card_style
        assign card_style = settings.smi_blog_card_style
      else
        assign global_settings = shop.metafields.smind.settings.value
        assign card_style = global_settings.blogCardStyle | default: 'standard'
      endif
      if card_style == 'standard'
        assign show_border = false
      endif
    when 'product'
      assign border_classes = ' smi-product-card-wrapper'
      if settings.smi_card_style
        assign card_style = settings.smi_card_style
      else
        assign global_settings = shop.metafields.smind.settings.value
        assign card_style = global_settings.productCardStyle | default: 'standard'
      endif
      if card_style == 'standard'
        assign show_border = false
      endif
    else
      assign border_classes = ' smi-media-wrapper'
  endcase
  if show_border == false and is_standard != false
    assign is_standard = true
  endif
  if enable_spacing_between_items == null
    assign enable_spacing_between_items = section.settings.enable_spacing_between_items
  endif
  if number_of_columns_on_desktop == null
    assign number_of_columns_on_desktop = section.settings.number_of_columns_on_desktop
  endif
  if number_of_columns_on_mobile == null
    assign number_of_columns_on_mobile = section.settings.number_of_columns_on_mobile
  endif
  if enable_swipe_on_mobile == null
    assign enable_swipe_on_mobile = section.settings.enable_swipe_on_mobile
  endif
  if show_view_all == null
    assign show_view_all = false
  endif
  unless view_all_button_style
    assign view_all_button_style = section.settings.view_all_button_style
  endunless
  unless view_all_button_link
    assign view_all_button_link = '#'
  endunless
%}
{% liquid
  unless object_limit
    assign object_limit = object_loop.size
  endunless
  if enable_spacing_between_items == false
    assign space_between_mobile = '0px'
    assign space_between_desktop = '0px'
  else
    assign space_between_mobile = 'var(--grid-mobile-horizontal-spacing)'
    assign space_between_desktop = 'var(--grid-desktop-horizontal-spacing)'
  endif
  assign slides_per_view_desktop = number_of_columns_on_desktop | times: 1 | at_least: 1
  assign slides_per_view_laptop = 3 | at_most: slides_per_view_desktop
  assign slides_per_view_tablet = 2 | at_most: slides_per_view_desktop
  assign slides_per_view_mobile = number_of_columns_on_mobile | times: 1 | at_most: object_limit | at_least: 1
  if enable_swipe_on_mobile == true
    if object_limit > slides_per_view_mobile
      assign offset_swiper_mobile = '30px'
    else
      assign offset_swiper_mobile = '0px'
    endif
  else
    assign offset_swiper_mobile = '0px'
    assign slides_per_view_mobile = number_of_columns_on_mobile | times: 1
  endif
  if object_limit == slides_per_view_mobile
    assign offset_swiper_mobile = '0px'
  endif
  assign item_mobile = slides_per_view_mobile
  assign item_tablet = slides_per_view_tablet
  assign item_desktop = slides_per_view_desktop
%}
{% liquid
    unless image_width
        assign image_width = 1600
    endunless
    unless sizes
        assign percent_item_mobile = 100 | divided_by: item_mobile | default: 100
        assign percent_item_tablet = 100 | divided_by: item_tablet | default: 100
        assign percent_item_desktop = 100 | divided_by: item_desktop | default: 100
        assign sizes = '(max-width: 767px)' | append: percent_item_mobile | append: 'vw, (max-width: 991px) ' | append: percent_item_tablet | append: 'vw, ' | append: percent_item_desktop | append: 'vw'
    endunless
%} 
<style>
  #shopify-section-{{ section.id }} {
      --space-between-mobile: {{ space_between_mobile }};
      --space-between-desktop: {{ space_between_desktop }};
      --item-width-xs: calc((100% - (({{ slides_per_view_mobile | minus: 1 }} * var(--space-between-mobile)) + var(--offset-swiper-mobile,{{ offset_swiper_mobile }})))/ {{ slides_per_view_mobile }});
      --item-width-md: calc((100% - ({{ slides_per_view_tablet | minus: 1 }} * var(--space-between-desktop)))/ {{ slides_per_view_tablet }});
      --item-width-lg: calc((100% - ({{ slides_per_view_laptop | minus: 1 }} * var(--space-between-desktop)))/ {{ slides_per_view_laptop }});
      --item-width-xl: calc((100% - ({{ slides_per_view_desktop | minus: 1 }} * var(--space-between-desktop)))/ {{ slides_per_view_desktop }});
  }
</style>
<link rel="stylesheet" type="text/css" href="{{ 'smi-layout-grid-slider.min.css' | asset_url }}" media="screen" onload="this.onload=null;this.media='all'">
<script src="{{ 'smi-slider-2.min.js' | asset_url }}" defer data-id="smi-slider-2.min.js" data-section-id="smi-{{ section.id }}"></script>
{% if enable_swipe_on_mobile == true %}
  <link rel="stylesheet" type="text/css" href="{{ 'smi-swiper-bundle-v11.min.css' | asset_url }}" media="screen" onload="this.onload=null;this.media='all'">
  <script src="{{ 'smi-swiper-bundle-v11.min.js' | asset_url }}" defer data-id="smi-swiper-bundle-v11.min.js" data-section-id="smi-{{ section.id }}"></script>
{% endif %}
<div
  class="
    {{- 'smi-layout-grid-slider smi-position-relative' -}}
    {%- if enable_swipe_on_mobile == true %} smi-swipe-on-mobile{% else %} smi-grid-on-mobile{% endif -%}
    {%- if is_standard == true %} smi-style-standard{% else %} smi-style-card{% endif -%}
    {%- liquid
            echo border_classes
            if enable_spacing_between_items == false
                echo ' smi-border-radius-0'
                if show_border == false and is_standard != false
                    echo ' smi-gap-0--standard'
                else
                    echo ' smi-gap-0'
                endif
            else
                echo ' smi-gap-1'
            endif
    -%}
    {%- if object_limit <= slides_per_view_mobile %} smi-only-one-row-xs{% endif -%}
    {%- if object_limit <= slides_per_view_tablet %} smi-only-one-row-md{% endif -%}
    {%- if object_limit <= slides_per_view_laptop %} smi-only-one-row-lg{% endif -%}
    {%- if object_limit <= slides_per_view_desktop %} smi-only-one-row-xl{% endif -%}
  "
>
  <div class="smi-swiper">
    <div class="smi-swiper-wrapper">
      {% assign shape_index = 1 %}
      {% for item in object_loop limit: object_limit %}
        {% liquid
          if exclude contains item.type
            continue
          endif
        %}
        <div
          class="smi-swiper-slide {%- unless show_border == false %} smi-border {%- if enable_spacing_between_items != false %} smi-shadow{% endif -%}{% endunless %}"
          data-swiper-slide-index="{{ forloop.index0 }}"
          {{ item.shopify_attributes }}
        >
          {% assign block = item %}
<div class="icon-with-text-style-2 smi-component-settings-icon-with-text-2  smi-component-settings-icon-with-text-{{ block.id }} smi-content-wrapper smi-border smi-shadow"
>
  {% liquid
    assign button_label = block.settings.button_label
    assign button_label_strip = block.settings.button_label | strip
    assign button_link = block.settings.link1
	if block.settings.content_size != blank
		assign content_size = '-mb ' | append:block.settings.content_size  | prepend: block.settings.content_size
	endif
  %}
  <div class="icon-with-text-style-2-container smi-py-xl smi-px-lg smi-color-{{ content_color }} smi-gradient">
  <style>
    .smi-component-settings-icon-with-text-{{ block.id }}{
      --icon-size: {{ block.settings.icon_size }}px;
      {% if block.settings.icon_bg %}
        --icon-background: {{ block.settings.icon_bg }};
      {% endif %}
    }
  </style>
  {% if icon_position == 'top' %}
    {% if block.settings.upload_icon != blank %}
      <div class="icon-top smi-mb-sm">
        <div class="{% if block.settings.icon_bg != blank and block.settings.icon_bg != "rgba(0,0,0,0)" %} icon-size-bg {% else %} icon-size-normal {% endif %} icon-size icon-align-{{ content_alignment }}">
          {{
            block.settings.upload_icon
            | image_url: width: 300
            | image_tag: class: 'heading-feature-icon'
          }}
        </div>
      </div>
    {% else %}
      {% if block.settings.icon != "none" %}
        <div class="icon-top smi-mb-sm">
          <div class="{% if block.settings.icon_bg != blank and block.settings.icon_bg != "rgba(0,0,0,0)" %} icon-size-bg {% else %} icon-size-normal {% endif %} icon-size icon-align-{{ content_alignment }}">{%- render 'smi-custom-icons', icon: block.settings.icon -%}</div>
        </div>
      {% endif %}
    {% endif %}
  {% endif %}
  <div class="text-content content-alignment-{{ content_alignment }}">
    {% if icon_position == 'left' %}
      {% if block.settings.upload_icon != blank %}
        <div class="icon-left {% if block.settings.icon_bg != blank and block.settings.icon_bg != "rgba(0,0,0,0)" %} icon-size-bg {% else %} icon-size-normal {% endif %} icon-size smi-mr-sm">
          {{
            block.settings.upload_icon
            | image_url: width: 300
            | image_tag: class: 'heading-feature-icon'
          }}
        </div>
      {% else %}
        {% if block.settings.icon != "none" %}
          <div class="icon-left smi-mr-sm">
            <div class="{% if block.settings.icon_bg != blank and block.settings.icon_bg != "rgba(0,0,0,0)" %} icon-size-bg {% else %} icon-size-normal {% endif %} icon-size">{%- render 'smi-custom-icons', icon: block.settings.icon -%}</div>
          </div>
        {% endif %}
      {% endif %}
    {% endif %}
    <div
      class="{% liquid
        if icon_position == 'top'
          echo 'content'
        else
          if block.settings.icon_bg != blank and block.settings.icon_bg != "rgba(0,0,0,0)"
            echo 'content-right-padding'
          else
            echo 'content-right'
          endif
        endif
      %}
      "
    >
      <h3 class="{{ block.settings.heading_size }} icon-with-text-heading smi-mb-xxs smi-link-wrapper">{{ block.settings.heading }}</h3>
      <div class="{% if content_size != blank %}{{content_size}}{% else %}smi-text-md{% endif %} smi-content smi-color-text-75 icon-with-text-content smi-format-content smi-link-wrapper">{{ block.settings.content }}</div>
      {% if button_label != blank and button_label_strip != '' %}
        <div class="smi-button-wrapper icon-with-text-button smi-mt-md content-alignment-{{ content_alignment }}">
          <a
            href="{{- button_link -}}"
            class="smi-button smi-text-button smi-button--text smi-border smi-shadow smi-hover-{{- settings.smi_animations_hover_elements | default: shop.metafields.smind.settings.value.buttonHoverEffect | default: 'none' }}"
          >
            <span>
              {{- button_label | escape -}}
            </span>
          </a>
