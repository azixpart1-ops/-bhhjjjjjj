{%- liquid
  assign s = section.settings
-%}

{% render 'contrast-override', background_color: s.background_color, section_id: section.id %}

<div class="cc-section color-custom-{{ section.id }}">
  <div class="cc-container cc-container--reading">
    <div class="cc-head cc-head--center" data-cc-reveal>
      <div>
        {%- if s.eyebrow != blank -%}<span class="cc-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="cc-head__title h2">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}
          <p class="cc-lede cc-lede--center" style="margin-block-start: 1rem;">{{ s.text }}</p>
        {%- endif -%}
      </div>
    </div>

    <div class="cc-compare__wrap" data-cc-reveal="80">
      <table class="cc-compare">
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">Feature</span></th>
            <th scope="col" class="cc-compare__col--us">{{ s.us_label }}</th>
            <th scope="col">{{ s.them_label }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.feature }}</th>
              <td class="cc-compare__col--us">
                {%- if block.settings.us_text != blank -%}
                  {{ block.settings.us_text }}
                {%- else -%}
                  <span class="cc-compare__mark cc-compare__mark--yes">
                    {% render 'cc-icon', icon: 'check', size: 20 %}
                  </span>
                  <span class="visually-hidden">Yes</span>
                {%- endif -%}
              </td>
              <td>
                {%- if block.settings.them_text != blank -%}
                  {{ block.settings.them_text }}
                {%- else -%}
                  <span class="cc-compare__mark cc-compare__mark--no">
                    {% render 'cc-icon', icon: 'cross', size: 20 %}
                  </span>
                  <span class="visually-hidden">No</span>
                {%- endif -%}
              </td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    {%- if s.button_label != blank -%}
      <div style="margin-block-start: 2.5rem; text-align: center;">
        <a href="{{ s.button_link | default: '#' }}" class="button">{{ s.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Comparison table",
  "tag": "section",
  "class": "cc-section-compare",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "An honest comparison" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How we compare" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Only fill this in with differences you can evidence. Naming a competitor means you have to be able to prove every row."
    },
    { "type": "text", "id": "us_label", "label": "Your column heading", "default": "Comfort Crest" },
    { "type": "text", "id": "them_label", "label": "Comparison heading", "default": "Elsewhere" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop all beds" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ede5d6"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Feature you can evidence" },
        { "type": "text", "id": "us_text", "label": "Your value", "info": "Leave empty for a tick." },
        { "type": "text", "id": "them_text", "label": "Comparison value", "info": "Leave empty for a cross." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison table",
      "category": "Conversion",
      "blocks": [
        { "type": "row", "settings": {} },
        { "type": "row", "settings": {} },
        { "type": "row", "settings": {} }
      ]
    }
  ]
}
{% endschema %}
