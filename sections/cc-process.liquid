{%- liquid
  assign s = section.settings
-%}

{% render 'contrast-override', background_color: s.background_color, section_id: section.id %}

<div class="cc-section color-custom-{{ section.id }}">
  <div class="cc-container">
    <div class="cc-head{% if s.align == 'center' %} cc-head--center{% endif %}" data-cc-reveal>
      <div>
        {%- if s.eyebrow != blank -%}<span class="cc-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="cc-head__title h2">{{ s.heading }}</h2>{%- endif -%}
      </div>
      {%- if s.link_label != blank -%}
        <a href="{{ s.link_url | default: '#' }}" class="cc-link">
          {{ s.link_label }}
          {% render 'cc-icon', icon: 'arrow-right', size: 14 %}
        </a>
      {%- endif -%}
    </div>

    <ol class="cc-steps" style="list-style: none; margin: 0; padding: 0;">
      {%- for block in section.blocks -%}
        <li class="cc-step" data-cc-reveal="{{ forloop.index0 | times: 70 }}" {{ block.shopify_attributes }}>
          <h3 class="cc-step__title">{{ block.settings.title }}</h3>
          <p class="cc-step__text">{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</div>

{% schema %}
{
  "name": "How it works",
  "tag": "section",
  "class": "cc-section-process",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From cart to bedroom" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What happens after you order" },
    {
      "type": "select",
      "id": "align",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "link_label", "label": "Header link", "default": "Delivery & returns" },
    { "type": "url", "id": "link_url", "label": "Header link URL" },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#fbf8f2"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Order free swatches" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Pick up to five fabrics. Posted first class the same day, free."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "category": "Conversion",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Order free swatches",
            "text": "Choose up to five fabrics and we post them first class the same day, at no cost."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Book your delivery slot",
            "text": "Pick a day that suits you at checkout. We text a two-hour window the night before."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "We build it in the room",
            "text": "Two of our team carry it up, assemble it where you want it and take the packaging away."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Sleep on it for 100 nights",
            "text": "If it isn't right, we collect and refund in full. Ten-year guarantee on every frame."
          }
        }
      ]
    }
  ]
}
{% endschema %}
