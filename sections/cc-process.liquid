{%- liquid
  assign s = section.settings
-%}

{% render 'contrast-override', background_color: s.background_color, section_id: section.id %}

<div class="cc-section color-custom-{{ section.id }}">
  <div class="cc-container">
    <div class="cc-head{% if s.align == 'center' %} cc-head--center{% endif %}" data-cc-reveal>
      <div>
        {%- if s.eyebrow != blank -%}<span class="cc-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="cc-head__title h2">{{ s.heading }}</h2>{%- endif -%}
      </div>
      {%- if s.link_label != blank -%}
        <a href="{{ s.link_url | default: '#' }}" class="cc-link">
          {{ s.link_label }}
          {% render 'cc-icon', icon: 'arrow-right', size: 14 %}
        </a>
      {%- endif -%}
    </div>

    <ol class="cc-steps" style="list-style: none; margin: 0; padding: 0;">
      {%- for block in section.blocks -%}
        <li class="cc-step" data-cc-reveal="{{ forloop.index0 | times: 70 }}" {{ block.shopify_attributes }}>
          <h3 class="cc-step__title">{{ block.settings.title }}</h3>
          <p class="cc-step__text">{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</div>

{% schema %}
{
  "name": "How it works",
  "tag": "section",
  "class": "cc-section-process",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From cart to bedroom" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What happens after you order" },
    {
      "type": "select",
      "id": "align",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "link_label", "label": "Header link", "default": "Delivery policy" },
    { "type": "url", "id": "link_url", "label": "Header link URL" },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#fbf8f2"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Order online" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Free delivery to any UK mainland address, with no minimum spend."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "category": "Conversion",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Order online",
            "text": "Free delivery to any UK mainland address, with no minimum spend."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "We dispatch in 1–4 working days",
            "text": "You get tracking by email as soon as your order leaves us."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "A courier brings it to your door",
            "text": "A specialist large-item courier confirms your delivery day in advance. Someone over 18 needs to be in."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "30 days to be sure",
            "text": "Beds arrive flat-packed with all fittings. If it isn't right, tell us within 30 days."
          }
        }
      ]
    }
  ]
}
{% endschema %}
