{% comment %}#component#["settings/display-settings-2","settings/container-width-new","settings/section-margin","settings/design-mode"]#endcomponent#{% endcomment %}
<style>
    {% if block_color %}
    {% endif %}
	#shopify-section-{{ section.id }} {
		--section-margin-sides: {{ section.settings.margin_sides }}px;
--section-margin-sides-mobile: {{ section.settings.margin_sides_mobile }}px;
		{% if  section.settings.custom_width == true and section.settings.full_width == 'container' %}
--page-width: {{ section.settings.section_width }}px;
{% endif %}
	}
    #shopify-section-{{ section.id }} .smi-section-divider-1 {
        --divider-height: {{section.settings.divider_height}}px;
        margin-top: calc(-1 * var(--divider-height));
        z-index: 2;
    }
    #shopify-section-{{ section.id }} .smi-divider-line {
        background: {{ section.settings.divider_color }};
        height:  {{ section.settings.divider_height }}px;
    }
@media screen and (max-width: 767.8px){.smi-display-settings.smi-display-desktop{display:none !important}}@media screen and (min-width: 768px){.smi-display-settings.smi-display-mobile{display:none !important}}
</style>
<div id="smi-{{ section.id }}"
     class="smi-{{ section.id }} smi-display-settings smi-display-{{ section.settings.display_on }} smi-section__inner  smi-section-divider-1"
     data-section="divider-1"
     data-name="✧Divider 1">
    
    <div class="smi-{{ section.settings.full_width }}" smind-key="full_width,divider_color" smind-attributes smind-attr-divider>
        <div class="smi-divider-line">&nbsp;</div>
    </div>
</div>
<div class="smi-d-none smi-pods-item">&nbsp; </div>
{% schema %}
{
	"name": "✧Divider 1-1",
	"tag": "section",
	"class": "smi-section smi-basico-item smi-divider-1",
	"disabled_on": {
		"groups": [
			"aside"
		]
	},
	"settings": [
		{
			"type": "select",
			"id": "display_on",
			"label": "Display on",
			"options": [
				{
					"value": "desktop",
					"label": "Desktop only"
				},
				{
					"value": "mobile",
					"label": "Mobile only"
				},
				{
					"value": "all",
					"label": "All device"
				}
			],
			"default": "all"
		},
		{
			"type": "select",
			"id": "full_width",
			"label": "Layout",
			"options": [
				{
					"value": "container",
					"label": "Boxed"
				},
				{
					"value": "container-fluid",
					"label": "Full width"
				},
				{
					"value": "container-fluid-no-padding",
					"label": "Full width (no padding)"
				}
			],
			"default": "container"
		},
		{
			"type": "checkbox",
			"id": "custom_width",
			"label": "Custom width",
			"default": false,
			"visible_if": "{{ section.settings.full_width == 'container' }}"
		},
		{
			"type": "range",
			"id": "section_width",
			"label": "Section width",
			"min": 800,
			"max": 2000,
			"step": 20,
			"unit": "px",
			"default": 1200,
			"visible_if": "{{ section.settings.custom_width == true and section.settings.full_width == 'container' }}"
		},
		{
			"type": "range",
			"id": "divider_height",
			"min": 1,
			"max": 10,
			"step": 1,
			"label": "Height",
			"default": 4
		},
		{
			"type": "color",
			"id": "divider_color",
			"label": "Color",
			"default": "#EBEBEB"
		},
		{
			"type": "header",
			"content": "Section margin"
		},
		{
			"type": "range",
			"id": "margin_sides",
			"min": 0,
			"max": 200,
			"step": 2,
			"unit": "px",
			"label": "Margin sides - desktop",
			"default": 0
		},
		{
			"type": "range",
			"id": "margin_sides_mobile",
			"min": 0,
			"max": 50,
			"step": 1,
			"unit": "px",
			"label": "Margin sides - mobile",
			"default": 0
		}
	],
	"blocks": [],
	"presets": [
		{
			"name": "✧Divider 1-1",
			"settings": {
				"full_width": "container",
				"divider_height": 1,
				"divider_color": "#000000"
			},
			"blocks": []
		}
	]
}
{% endschema %}

