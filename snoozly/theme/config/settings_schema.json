[
  {
    "name": "theme_info",
    "theme_name": "Snoozly",
    "theme_version": "1.0.0",
    "theme_author": "Snoozly",
    "theme_documentation_url": "https://snoozly.co.uk",
    "theme_support_url": "https://snoozly.co.uk/pages/contact"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "text",
        "id": "brand_name",
        "label": "Brand name",
        "default": "Snoozly",
        "info": "Used in the wordmark, page titles and structured data. Also rename the store under Settings → General so emails and checkout match."
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image",
        "info": "Optional. Without one, the Snoozly wordmark with its moon mark is drawn in the brand typeface."
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 80,
        "max": 240,
        "step": 4,
        "unit": "px",
        "default": 132
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "32 × 32px PNG. Without one, a moon mark is used."
      },
      {
        "type": "text",
        "id": "brand_tagline",
        "label": "Tagline",
        "default": "Sleep, beautifully."
      },
      {
        "type": "header",
        "content": "Homepage search listing"
      },
      {
        "type": "text",
        "id": "home_title",
        "label": "Homepage title",
        "default": "Dog Beds UK: Orthopaedic, Calming & Large Beds | Snoozly",
        "info": "Used while the store name is still the default. Keep under 60 characters."
      },
      {
        "type": "textarea",
        "id": "home_description",
        "label": "Homepage description",
        "default": "Orthopaedic, calming and extra-large dog beds, sorted by how your dog sleeps, with every size explained. Free UK delivery on orders over £50."
      }
    ]
  },
  {
    "name": "Colours",
    "settings": [
      {
        "type": "header",
        "content": "Colour schemes"
      },
      {
        "type": "paragraph",
        "content": "Every section picks one of these schemes. The five sleep-need schemes (Calm, Support, Cool, Cosy, Stretch) colour-code their collections, badges and quiz results. Each pair has been checked to WCAG AA contrast — re-check if you change them."
      },
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "Background",
            "default": "#FBF8F3"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "Background gradient",
            "info": "Overrides the solid background where a section supports it."
          },
          {
            "type": "color",
            "id": "surface",
            "label": "Cards and panels",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "text",
            "label": "Text",
            "default": "#1A1838"
          },
          {
            "type": "color",
            "id": "muted",
            "label": "Secondary text",
            "default": "#55527A"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "Accent (eyebrows, icons, highlights)",
            "default": "#5B4FC4"
          },
          {
            "type": "color",
            "id": "button",
            "label": "Button",
            "default": "#1A1838"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "Button label",
            "default": "#FBF8F3"
          },
          {
            "type": "color",
            "id": "secondary_button_label",
            "label": "Outline button and links",
            "default": "#1A1838"
          }
        ],
        "role": {
          "text": "text",
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "links": "secondary_button_label",
          "icons": "accent",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "secondary_button_label",
          "secondary_button_border": "secondary_button_label"
        }
      },
      {
        "type": "header",
        "content": "Signal colours"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Sale price and badge",
        "default": "#B0304A"
      },
      {
        "type": "color",
        "id": "color_star",
        "label": "Stars",
        "default": "#BF8212"
      },
      {
        "type": "color",
        "id": "color_success",
        "label": "In stock and success",
        "default": "#2F6247"
      },
      {
        "type": "color",
        "id": "color_moon",
        "label": "Moon gold (brand highlight)",
        "default": "#F5C35C"
      }
    ]
  },
  {
    "name": "Sleep needs",
    "settings": [
      {
        "type": "paragraph",
        "content": "The colour-coded system that runs through the whole store. A product joins a need through a tag — need:calm, need:support, need:cool, need:cosy or need:stretch — or, if it has none, through the words in its title (orthopaedic, memory foam, cooling, bolster, box bed and so on). The first match in the order below sets its colour."
      },
      {
        "type": "header",
        "content": "Cool — hot sleepers"
      },
      {
        "type": "text",
        "id": "need_cool_label",
        "label": "Name",
        "default": "Cool"
      },
      {
        "type": "text",
        "id": "need_cool_for",
        "label": "Who it is for",
        "default": "For hot sleepers"
      },
      {
        "type": "textarea",
        "id": "need_cool_why",
        "label": "Why it helps",
        "default": "Breathable fabrics and raised or gel surfaces let heat move away from the body, so they settle instead of shifting to the cold kitchen floor."
      },
      {
        "type": "collection",
        "id": "need_cool_collection",
        "label": "Collection"
      },
      {
        "type": "color",
        "id": "need_cool_tint",
        "label": "Tint",
        "default": "#E3F1F7"
      },
      {
        "type": "color",
        "id": "need_cool_deep",
        "label": "Deep",
        "default": "#1C5E7B"
      },
      {
        "type": "header",
        "content": "Support — joints and big dogs"
      },
      {
        "type": "text",
        "id": "need_support_label",
        "label": "Name",
        "default": "Support"
      },
      {
        "type": "text",
        "id": "need_support_for",
        "label": "Who it is for",
        "default": "For older joints and bigger dogs"
      },
      {
        "type": "textarea",
        "id": "need_support_why",
        "label": "Why it helps",
        "default": "Memory and orthopaedic foam spread their weight evenly, so hips, elbows and shoulders are cushioned instead of pressed against the floor."
      },
      {
        "type": "collection",
        "id": "need_support_collection",
        "label": "Collection"
      },
      {
        "type": "color",
        "id": "need_support_tint",
        "label": "Tint",
        "default": "#FCF1DC"
      },
      {
        "type": "color",
        "id": "need_support_deep",
        "label": "Deep",
        "default": "#8A5A0B"
      },
      {
        "type": "header",
        "content": "Calm — nervous nappers"
      },
      {
        "type": "text",
        "id": "need_calm_label",
        "label": "Name",
        "default": "Calm"
      },
      {
        "type": "text",
        "id": "need_calm_for",
        "label": "Who it is for",
        "default": "For nervous nappers"
      },
      {
        "type": "textarea",
        "id": "need_calm_why",
        "label": "Why it helps",
        "default": "Raised, bolstered sides give them something to lean into and a wall at their back. It feels like a den, and that helps them switch off."
      },
      {
        "type": "collection",
        "id": "need_calm_collection",
        "label": "Collection"
      },
      {
        "type": "color",
        "id": "need_calm_tint",
        "label": "Tint",
        "default": "#EEEBFB"
      },
      {
        "type": "color",
        "id": "need_calm_deep",
        "label": "Deep",
        "default": "#4A3FB0"
      },
      {
        "type": "header",
        "content": "Cosy — curlers and cats"
      },
      {
        "type": "text",
        "id": "need_cosy_label",
        "label": "Name",
        "default": "Cosy"
      },
      {
        "type": "text",
        "id": "need_cosy_for",
        "label": "Who it is for",
        "default": "For curl-up sleepers and cats"
      },
      {
        "type": "textarea",
        "id": "need_cosy_why",
        "label": "Why it helps",
        "default": "Soft, deep, enclosed shapes hold in warmth and let them tuck into a tight ball, which is how curlers sleep most soundly."
      },
      {
        "type": "collection",
        "id": "need_cosy_collection",
        "label": "Collection"
      },
      {
        "type": "color",
        "id": "need_cosy_tint",
        "label": "Tint",
        "default": "#FBE9E4"
      },
      {
        "type": "color",
        "id": "need_cosy_deep",
        "label": "Deep",
        "default": "#9A3D2C"
      },
      {
        "type": "header",
        "content": "Stretch — sprawlers"
      },
      {
        "type": "text",
        "id": "need_stretch_label",
        "label": "Name",
        "default": "Stretch"
      },
      {
        "type": "text",
        "id": "need_stretch_for",
        "label": "Who it is for",
        "default": "For sprawlers and flat-out sleepers"
      },
      {
        "type": "textarea",
        "id": "need_stretch_why",
        "label": "Why it helps",
        "default": "Flat, open sleeping areas and low fronts give them room to stretch every leg out, without hanging off the edge at 3am."
      },
      {
        "type": "collection",
        "id": "need_stretch_collection",
        "label": "Collection"
      },
      {
        "type": "color",
        "id": "need_stretch_tint",
        "label": "Tint",
        "default": "#E6F0E8"
      },
      {
        "type": "color",
        "id": "need_stretch_deep",
        "label": "Deep",
        "default": "#2F6247"
      },
      {
        "type": "checkbox",
        "id": "show_need_badges",
        "label": "Show sleep-need badges on product cards",
        "default": true
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "checkbox",
        "id": "use_brand_fonts",
        "label": "Use the Snoozly brand fonts",
        "default": true,
        "info": "Fraunces (soft) for headings and Figtree for body, self-hosted so no third-party requests. Untick to use the pickers below instead."
      },
      {
        "type": "font_picker",
        "id": "type_header_font",
        "label": "Heading font (when brand fonts are off)",
        "default": "assistant_n4"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font (when brand fonts are off)",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Heading size",
        "min": 80,
        "max": 120,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "checkbox",
        "id": "italic_accents",
        "label": "Italic accent words in headings",
        "default": true,
        "info": "Wrap words in *asterisks* in a heading to set them in the italic accent style."
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1100,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1320
      },
      {
        "type": "select",
        "id": "corner_style",
        "label": "Corner style",
        "options": [
          { "value": "pillow", "label": "Pillow (soft, rounded)" },
          { "value": "soft", "label": "Soft" },
          { "value": "square", "label": "Square" }
        ],
        "default": "pillow"
      },
      {
        "type": "select",
        "id": "button_shape",
        "label": "Button shape",
        "options": [
          { "value": "pill", "label": "Pill" },
          { "value": "rounded", "label": "Rounded" },
          { "value": "square", "label": "Square" }
        ],
        "default": "pill"
      },
      {
        "type": "checkbox",
        "id": "reveal_on_scroll",
        "label": "Reveal sections on scroll",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "night_sky",
        "label": "Star field on midnight sections",
        "default": true
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Image shape",
        "options": [
          { "value": "square", "label": "Square" },
          { "value": "portrait", "label": "Portrait 4:5" },
          { "value": "natural", "label": "Natural" }
        ],
        "default": "square"
      },
      {
        "type": "select",
        "id": "card_image_fit",
        "label": "Image fit",
        "options": [
          { "value": "contain", "label": "Whole product (contain)" },
          { "value": "cover", "label": "Fill the frame (cover)" }
        ],
        "default": "contain",
        "info": "Supplier photos come in every shape. Contain shows the whole bed on a soft ground."
      },
      {
        "type": "checkbox",
        "id": "card_second_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Show brand",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "card_quick_add",
        "label": "Quick add for single-option products",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_sizes",
        "label": "Show available sizes",
        "default": true
      },
      {
        "type": "textarea",
        "id": "title_remove",
        "label": "Remove from displayed product titles",
        "default": "by The North East Pet Shop",
        "info": "One phrase per line. Tidies supplier boilerplate from cards and product pages; the real title still drives search and checkout."
      },
      {
        "type": "range",
        "id": "sale_badge_min",
        "label": "Only show 'Save x%' at or above",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "%",
        "default": 5,
        "info": "Tiny supplier markdowns (2–4%) read as cheap rather than generous. Below this, the old price is still shown, without the badge."
      },
      {
        "type": "checkbox",
        "id": "available_first",
        "label": "List in-stock products before sold-out ones",
        "default": true,
        "info": "Within each page of a collection, search results and product rows."
      }
    ]
  },
  {
    "name": "Delivery, returns and trust",
    "settings": [
      {
        "type": "paragraph",
        "content": "These figures appear in the cart, the product page and the trust blocks. Keep them in step with Settings → Shipping and your refund policy."
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free UK delivery from (£)",
        "default": 50,
        "info": "Matches the free Standard rate in your General shipping profile. Set 0 to hide the progress bar."
      },
      {
        "type": "text",
        "id": "shipping_standard_price",
        "label": "Standard UK delivery price",
        "default": "£4.99"
      },
      {
        "type": "text",
        "id": "shipping_express_price",
        "label": "Express UK delivery price",
        "default": "£6.99"
      },
      {
        "type": "range",
        "id": "delivery_min_days",
        "label": "Delivery estimate — earliest (working days)",
        "min": 1,
        "max": 30,
        "step": 1,
        "default": 3
      },
      {
        "type": "range",
        "id": "delivery_max_days",
        "label": "Delivery estimate — latest (working days)",
        "min": 1,
        "max": 40,
        "step": 1,
        "default": 6,
        "info": "Override per product with a tag such as delivery:14-21."
      },
      {
        "type": "range",
        "id": "returns_days",
        "label": "Returns window (days)",
        "min": 14,
        "max": 100,
        "step": 1,
        "default": 14,
        "info": "UK law gives online shoppers at least 14 days to cancel, so 14 is always true. Raise it to match your refund policy — 30 days is the premium norm."
      },
      {
        "type": "range",
        "id": "low_stock_threshold",
        "label": "Show 'only a few left' at or below",
        "min": 0,
        "max": 20,
        "step": 1,
        "default": 5,
        "info": "Driven by real inventory. 0 turns it off."
      },
      {
        "type": "text",
        "id": "support_email",
        "label": "Customer care email",
        "default": "hello@snoozly.co.uk"
      },
      {
        "type": "text",
        "id": "support_hours",
        "label": "Customer care hours",
        "default": "Mon–Fri, 9am–5pm"
      },
      {
        "type": "textarea",
        "id": "description_cut_markers",
        "label": "Remove supplier notes from product descriptions",
        "default": "Check in-store availability",
        "info": "One phrase per line. A description is cut from the block that contains the phrase — used to hide supplier boxes such as another shop's in-store stock notes."
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "When something is added",
        "options": [
          { "value": "drawer", "label": "Open the basket drawer" },
          { "value": "page", "label": "Go to the basket page" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_upsell",
        "label": "Show 'complete their setup' suggestions",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cart_note",
        "label": "Allow an order note",
        "default": true
      }
    ]
  },
  {
    "name": "Search",
    "settings": [
      {
        "type": "checkbox",
        "id": "predictive_search",
        "label": "Show results as you type",
        "default": true
      },
      {
        "type": "text",
        "id": "search_suggestions",
        "label": "Popular searches",
        "default": "orthopaedic, memory foam, cat bed, box bed, bolster",
        "info": "Comma separated."
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram", "info": "https://instagram.com/…" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok" },
      { "type": "text", "id": "social_facebook", "label": "Facebook" },
      { "type": "text", "id": "social_pinterest", "label": "Pinterest" },
      { "type": "text", "id": "social_youtube", "label": "YouTube" }
    ]
  },
  {
    "name": "Share image",
    "settings": [
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Default share image",
        "info": "Shown when a page without its own image is shared. 1200 × 630px."
      }
    ]
  }
]
