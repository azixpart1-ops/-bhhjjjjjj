    {%- when 'need-cool' -%}<path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9"/><path d="m9.5 4.5 2.5 2 2.5-2M9.5 19.5l2.5-2 2.5 2"/>
    {%- when 'need-support' -%}<rect x="3.5" y="14.5" width="17" height="4.5" rx="1.5"/><rect x="5" y="9.5" width="14" height="5" rx="1.5"/><path d="M8.5 9.5c0-2.2 1.6-4 3.5-4s3.5 1.8 3.5 4"/>
    {%- when 'need-calm' -%}<path d="M3.5 13.5c0 4 3.8 6.5 8.5 6.5s8.5-2.5 8.5-6.5"/><path d="M3.5 13.5c0-1.6 1-2.5 2.5-2.5h12c1.5 0 2.5.9 2.5 2.5"/><path d="M12 9.5s-3-1.8-3-3.8A1.7 1.7 0 0 1 12 5a1.7 1.7 0 0 1 3 .7c0 2-3 3.8-3 3.8z"/>
    {%- when 'need-cosy' -%}<path d="M18.5 15.5A7.5 7.5 0 1 1 11 5.5a6 6 0 0 0 7.5 10z"/><path d="M16 4.5h3l-3 3.5h3"/>
    {%- when 'need-stretch' -%}<path d="M3.5 16.5h17v3h-17z"/><path d="M7 12.5H3.5l2-2M3.5 12.5l2 2M17 12.5h3.5l-2-2M20.5 12.5l-2 2M7.5 12.5h9"/>
    {%- when 'instagram' -%}<rect x="4" y="4" width="16" height="16" rx="4.5"/><circle cx="12" cy="12" r="3.75"/><path d="M16.8 7.2v.1"/>
    {%- when 'facebook' -%}<path d="M14.5 8H16V4.5h-2.5A3.5 3.5 0 0 0 10 8v2.5H8V14h2v6.5h3.5V14H16l.5-3.5h-3V8.8c0-.5.4-.8 1-.8z"/>
    {%- when 'tiktok' -%}<path d="M14.5 4v10.5a3.5 3.5 0 1 1-3.5-3.5M14.5 4c.4 2.6 2 4 4.5 4.2"/>
    {%- when 'pinterest' -%}<circle cx="12" cy="12" r="8.5"/><path d="M11 9.5 8.5 20M10.3 12.4c.4 1.2 1.3 1.8 2.5 1.8 2 0 3.2-1.7 3.2-3.8 0-2.3-1.8-3.9-4.2-3.9-2.8 0-4.3 2-4.3 3.8 0 .9.3 1.6.9 2"/>
    {%- when 'youtube' -%}<rect x="3" y="6" width="18" height="12" rx="4"/><path d="m10.5 9.5 4 2.5-4 2.5z"/>
