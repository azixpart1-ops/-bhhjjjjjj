{%- comment -%}
  Inline icon set. One stroke weight, one grid (24px), so every icon on the
  site reads as one family. Usage: {% render 'icon', name: 'truck', size: 20 %}
{%- endcomment -%}
{%- liquid
  assign s = size | default: 20
  assign cls = class | default: ''
-%}
<svg class="icon icon--{{ name }} {{ cls }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'arrow-right' -%}<path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'arrow-left' -%}<path d="M19 12H5M11 18l-6-6 6-6"/>
    {%- when 'chevron-down' -%}<path d="m6 9 6 6 6-6"/>
    {%- when 'chevron-right' -%}<path d="m9 6 6 6-6 6"/>
    {%- when 'chevron-left' -%}<path d="m15 6-6 6 6 6"/>
    {%- when 'close' -%}<path d="M6 6l12 12M18 6 6 18"/>
    {%- when 'menu' -%}<path d="M4 7h16M4 12h16M4 17h10"/>
    {%- when 'search' -%}<circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/>
    {%- when 'user' -%}<circle cx="12" cy="8.5" r="3.75"/><path d="M4.75 20c.9-3.6 3.8-5.5 7.25-5.5s6.35 1.9 7.25 5.5"/>
    {%- when 'bag' -%}<path d="M5.5 8.5h13l-1 11.25a1.5 1.5 0 0 1-1.5 1.25H8a1.5 1.5 0 0 1-1.5-1.25z"/><path d="M9 8.5V7a3 3 0 0 1 6 0v1.5"/>
    {%- when 'check' -%}<path d="m5 12.5 4.5 4.5L19 7.5"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}<path d="M5 12h14"/>
    {%- when 'trash' -%}<path d="M4.5 7h15M9.5 7V5.5h5V7M6.5 7l.8 12a1.5 1.5 0 0 0 1.5 1.4h6.4a1.5 1.5 0 0 0 1.5-1.4l.8-12"/>
    {%- when 'truck' -%}<path d="M3 6.5h11v9H3zM14 9.5h3.8l3.2 3.3v2.7h-7"/><circle cx="7" cy="17.5" r="1.75"/><circle cx="17.5" cy="17.5" r="1.75"/>
    {%- when 'return' -%}<path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/>
