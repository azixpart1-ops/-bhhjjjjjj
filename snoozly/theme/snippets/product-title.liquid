{%- comment -%}
  Display title: the product title with supplier boilerplate removed (for
  example "by The North East Pet Shop"). The real title still drives SEO,
  structured data and the checkout.
{%- endcomment -%}
{%- liquid
  assign t = product.title
  assign cuts = settings.title_remove | newline_to_br | split: '<br />'
  for c in cuts
    assign c = c | strip
    if c != blank
      assign t = t | remove: c
    endif
  endfor
  assign t = t | strip
-%}
{{- t | escape -}}
