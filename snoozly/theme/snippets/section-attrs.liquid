{%- comment -%}
  Attributes for a section's outer element: id, scheme class, spacing and a
  data-dark flag the stylesheet uses for the night sky and inverted details.
  Usage: <section {% render 'section-attrs', section: section, class: 'hero' %}>
{%- endcomment -%}
{%- liquid
  assign scheme = section.settings.color_scheme
  assign dark = 'false'
  if scheme
    assign lum = scheme.settings.background | color_brightness
    if lum < 110
      assign dark = 'true'
    endif
  endif
  assign pt = section.settings.padding_top | default: 96
  assign pb = section.settings.padding_bottom | default: 96
  if section.settings.padding_top == 0
    assign pt = 0
  endif
  if section.settings.padding_bottom == 0
    assign pb = 0
  endif
-%}
id="s-{{ section.id }}" class="sz-section{% if scheme %} color-{{ scheme.id }}{% endif %}{% if class %} {{ class }}{% endif %}" style="--pt: {{ pt }}; --pb: {{ pb }};{{ style }}" data-dark="{{ dark }}"
