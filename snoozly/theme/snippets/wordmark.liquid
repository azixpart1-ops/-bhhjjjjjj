{%- comment -%}
  The Snoozly wordmark: moon mark + name in the display face. Used wherever no
  logo image has been uploaded, so the brand is consistent from day one.
{%- endcomment -%}
{%- assign brand = settings.brand_name | default: shop.name -%}
<span class="wordmark{% if class %} {{ class }}{% endif %}">
  <svg class="wordmark__mark" viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" focusable="false">
    <path d="M21.5 5.2a11.5 11.5 0 1 0 5.3 17.7A9.4 9.4 0 1 1 21.5 5.2z" fill="currentColor"/>
    <path class="wordmark__star" d="M25.2 6.4c.3 2 1 2.7 3 3-2 .3-2.7 1-3 3-.3-2-1-2.7-3-3 2-.3 2.7-1 3-3z"/>
  </svg>
  <span class="wordmark__name">{{ brand | escape }}</span>
</span>
