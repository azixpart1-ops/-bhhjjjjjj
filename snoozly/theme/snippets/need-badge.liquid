{%- comment -%}
  Colour-coded sleep-need chip.
  need    key (cool | support | calm | cosy | stretch)
  style   'chip' (tint + deep text, default) | 'solid' | 'dot'
  long    true to show "Calm · For nervous nappers"
{%- endcomment -%}
{%- if need != blank -%}
  {%- liquid
    assign label_key = 'need_' | append: need | append: '_label'
    assign for_key = 'need_' | append: need | append: '_for'
    assign icon_name = 'need-' | append: need
    assign st = style | default: 'chip'
  -%}
  <span class="need-badge need-badge--{{ st }} need--{{ need }}">
    {%- if st == 'dot' -%}
      <span class="need-badge__dot" aria-hidden="true"></span>
    {%- else -%}
      {% render 'icon', name: icon_name, size: 14 %}
    {%- endif -%}
    <span>{{ settings[label_key] | escape }}{% if long %}<span class="need-badge__for"> · {{ settings[for_key] | escape }}</span>{% endif %}</span>
  </span>
{%- endif -%}
