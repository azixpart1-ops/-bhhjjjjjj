{%- comment -%}
  Responsive image in a fixed-ratio frame, or the Snoozly placeholder when no
  image has been chosen yet — so an empty slot still looks designed.

  image      image object (optional)
  ratio      CSS aspect-ratio, e.g. '4 / 5', or 'natural'
  sizes      sizes attribute
  priority   true for the LCP image (eager + high fetch priority)
  fit        'cover' (default) or 'contain'
  label      what the placeholder asks for, shown in the theme editor only
  tone       placeholder tone: need key (calm/support/cool/cosy/stretch) or blank
  class      extra classes on the frame
  alt        alt text override
{%- endcomment -%}
{%- liquid
  assign r = ratio | default: '4 / 5'
  assign f = fit | default: 'cover'
  assign sz = sizes | default: '(min-width: 990px) 50vw, 100vw'
  if priority
    assign load = 'eager'
    assign fp = 'high'
  else
    assign load = 'lazy'
    assign fp = 'auto'
  endif
-%}
{%- if image != blank -%}
  {%- liquid
    if r == 'natural'
      assign frame_ratio = image.aspect_ratio
    else
      assign frame_ratio = r
    endif
    assign alt_text = alt | default: image.alt | escape
  -%}
  <div class="media media--{{ f }} {{ class }}" style="--ratio: {{ frame_ratio }};">
    {{
      image
      | image_url: width: 2400
      | image_tag:
        widths: '360, 540, 720, 960, 1200, 1600, 2000',
        sizes: sz,
        loading: load,
        fetchpriority: fp,
        alt: alt_text,
        class: 'media__img'
    }}
  </div>
{%- else -%}
  {%- if r == 'natural' -%}{%- assign r = '4 / 5' -%}{%- endif -%}
  {% render 'placeholder', ratio: r, label: label, tone: tone, class: class %}
{%- endif -%}
