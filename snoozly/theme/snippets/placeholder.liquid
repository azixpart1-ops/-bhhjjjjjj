{%- comment -%}
  Branded empty-image slot: a soft night-sky wash with the moon mark. Reads as
  intentional art direction on the live site; in the theme editor it also says
  which photo belongs here.
{%- endcomment -%}
{%- assign r = ratio | default: '4 / 5' -%}
<div class="media ph{% if tone != blank %} ph--{{ tone }}{% endif %} {{ class }}" style="--ratio: {{ r }};" role="presentation">
  <svg class="ph__art" viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <path class="ph__moon" d="M292 96a58 58 0 1 0 36 102 48 48 0 1 1-36-102z"/>
    <g class="ph__stars">
      <path d="M96 92c1.6 11 5.4 14.8 16.4 16.4-11 1.6-14.8 5.4-16.4 16.4-1.6-11-5.4-14.8-16.4-16.4 11-1.6 14.8-5.4 16.4-16.4z"/>
      <path d="M170 168c1 6.6 3.2 8.8 9.8 9.8-6.6 1-8.8 3.2-9.8 9.8-1-6.6-3.2-8.8-9.8-9.8 6.6-1 8.8-3.2 9.8-9.8z"/>
      <path d="M332 262c1 6.6 3.2 8.8 9.8 9.8-6.6 1-8.8 3.2-9.8 9.8-1-6.6-3.2-8.8-9.8-9.8 6.6-1 8.8-3.2 9.8-9.8z"/>
      <circle cx="232" cy="72" r="2.4"/><circle cx="60" cy="210" r="2"/><circle cx="252" cy="330" r="2.2"/><circle cx="130" cy="300" r="1.6"/>
    </g>
    <path class="ph__hill" d="M-10 330c70-40 150-52 230-34s130 12 190-12v126H-10z"/>
  </svg>
  {%- if request.design_mode and label != blank -%}
    <span class="ph__label">{% render 'icon', name: 'sparkle', size: 14 %} {{ label }}</span>
  {%- endif -%}
</div>
