{%- comment -%}
  Size guide drawer contents. Uses the page chosen in the section if there is
  one; otherwise the breed-by-breed guide below, which is general guidance
  that suits almost every bed we sell.
{%- endcomment -%}
{%- if page_override != blank -%}
  <div class="rte">{{ page_override.content }}</div>
{%- else -%}
  <div class="sizeguide">
    <p class="sizeguide__intro">{{ 'products.size_guide.intro' | t }}</p>
    <ol class="sizeguide__steps" role="list">
      <li><span>1</span>{{ 'products.size_guide.step1' | t }}</li>
      <li><span>2</span>{{ 'products.size_guide.step2' | t }}</li>
      <li><span>3</span>{{ 'products.size_guide.step3' | t }}</li>
    </ol>
    <div class="sizeguide__table" role="table" aria-label="{{ 'products.size_guide.title' | t }}">
      <div class="sizeguide__row sizeguide__row--head" role="row">
        <span role="columnheader">{{ 'products.size_guide.size' | t }}</span>
        <span role="columnheader">{{ 'products.size_guide.weight' | t }}</span>
        <span role="columnheader">{{ 'products.size_guide.bed' | t }}</span>
      </div>
      <div class="sizeguide__row" role="row"><span role="cell"><strong>Small</strong><small>Dachshund, Jack Russell, Pug, Cavapoo, most cats</small></span><span role="cell">up to 10kg</span><span role="cell">60–75cm</span></div>
      <div class="sizeguide__row" role="row"><span role="cell"><strong>Medium</strong><small>Cocker Spaniel, Beagle, Staffie, Border Collie</small></span><span role="cell">10–25kg</span><span role="cell">75–90cm</span></div>
      <div class="sizeguide__row" role="row"><span role="cell"><strong>Large</strong><small>Labrador, Golden Retriever, Boxer, Dalmatian</small></span><span role="cell">25–40kg</span><span role="cell">90–110cm</span></div>
      <div class="sizeguide__row" role="row"><span role="cell"><strong>Extra large</strong><small>German Shepherd, Great Dane, Bernese, Newfoundland</small></span><span role="cell">40kg+</span><span role="cell">110cm+</span></div>
    </div>
    <p class="sizeguide__tip">{% render 'icon', name: 'info', size: 16 %}<span>{{ 'products.size_guide.tip' | t }}</span></p>
  </div>
{%- endif -%}
