{%- comment -%}
  Headline with *italic accent* support. Words wrapped in asterisks are set in
  the italic display cut — the Snoozly signature for the emotional word.
  text   the heading text
  tag    h1–h6 or p (default h2)
  class  classes for the element
{%- endcomment -%}
{%- assign t = tag | default: 'h2' -%}
{%- assign parts = text | escape | split: '*' -%}
<{{ t }} class="{{ class | default: 'h2' }}">
  {%- for p in parts -%}
    {%- assign odd = forloop.index0 | modulo: 2 -%}
    {%- if odd == 1 and settings.italic_accents -%}<em>{{ p }}</em>{%- else -%}{{ p }}{%- endif -%}
  {%- endfor -%}
</{{ t }}>
