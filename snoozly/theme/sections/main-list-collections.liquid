{%- assign s = section.settings -%}
<section {% render 'section-attrs', section: section, class: 'lc' %}>
  <div class="container">
    <div class="section-head" data-reveal>
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{% render 'icon', name: 'sparkle', size: 14 %}{{ s.eyebrow | escape }}</p>{%- endif -%}
      {% render 'heading', text: s.heading, tag: 'h1', class: 'h1' %}
    </div>
    <ul class="lc__grid" role="list">
      {%- for c in collections -%}
        {%- if c.products_count > 0 and c.handle != 'frontpage' -%}
          {%- liquid
            assign cneed = ''
            assign need_keys = 'calm,support,cool,cosy,stretch' | split: ','
            for k in need_keys
              assign ck = 'need_' | append: k | append: '_collection'
              if settings[ck].handle == c.handle
                assign cneed = k
              endif
            endfor
            assign img = c.featured_image | default: c.products.first.featured_media.preview_image
          -%}
          <li data-reveal style="--i: {{ forloop.index | modulo: 6 }};">
            <a class="lc__card{% if cneed != blank %} need--{{ cneed }}{% endif %}" href="{{ c.url }}">
              <span class="lc__media">
                {%- if img -%}
                  {{ img | image_url: width: 800 | image_tag: widths: '360, 540, 720', sizes: '(min-width: 990px) 30vw, 50vw', loading: 'lazy', alt: '', class: 'lc__img' }}
                {%- else -%}
                  {% render 'placeholder', ratio: '4 / 3', tone: cneed %}
                {%- endif -%}
              </span>
              <span class="lc__body">
                {%- if cneed != blank -%}{% render 'need-badge', need: cneed %}{%- endif -%}
                <span class="h4 lc__title">{{ c.title | split: '|' | first | strip | escape }}</span>
                <span class="lc__count">{{ 'collections.count' | t: count: c.products_count }}{% render 'icon', name: 'arrow-right', size: 16 %}</span>
              </span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "All collections",
  "tag": "div",
  "class": "section-lc",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "moonlight" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Browse" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every way to find *their bed.*" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ]
}
{% endschema %}
