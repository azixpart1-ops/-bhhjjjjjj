{%- assign s = section.settings -%}
<section {% render 'section-attrs', section: section, class: 'richtext' %}>
  <div class="container container--{{ s.width }} richtext__inner richtext--{{ s.align }}" data-reveal>
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'eyebrow' -%}
          <p class="eyebrow" {{ block.shopify_attributes }}>{% render 'icon', name: 'sparkle', size: 14 %}{{ block.settings.text | escape }}</p>
        {%- when 'heading' -%}
          <div {{ block.shopify_attributes }}>{% render 'heading', text: block.settings.heading, tag: block.settings.tag, class: block.settings.size %}</div>
        {%- when 'text' -%}
          <div class="rte{% if block.settings.lead %} lead{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}
          <div class="btn-row" {{ block.shopify_attributes }}>
            <a class="btn{% if block.settings.style == 'secondary' %} btn--secondary{% elsif block.settings.style == 'moon' %} btn--moon{% endif %}" href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.label | escape }}{% render 'icon', name: 'arrow-right', size: 18 %}</a>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "tag": "div",
  "class": "section-richtext",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "moonlight" },
    { "type": "select", "id": "align", "label": "Alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" } ], "default": "center" },
    { "type": "select", "id": "width", "label": "Width", "options": [ { "value": "narrow", "label": "Narrow" }, { "value": "medium", "label": "Medium" } ], "default": "narrow" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Eyebrow", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Snoozly" } ] },
    {
      "type": "heading", "name": "Heading",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Sleep, *beautifully.*" },
        { "type": "select", "id": "tag", "label": "Level", "options": [ { "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" } ], "default": "h2" },
        { "type": "select", "id": "size", "label": "Size", "options": [ { "value": "h1", "label": "Large" }, { "value": "h2", "label": "Medium" }, { "value": "h3", "label": "Small" } ], "default": "h2" }
      ]
    },
    {
      "type": "text", "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Share something about your brand.</p>" },
        { "type": "checkbox", "id": "lead", "label": "Larger intro style", "default": false }
      ]
    },
    {
      "type": "button", "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop all beds" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "style", "label": "Style", "options": [ { "value": "primary", "label": "Primary" }, { "value": "secondary", "label": "Outline" }, { "value": "moon", "label": "Moon gold" } ], "default": "primary" }
      ]
    }
  ],
  "presets": [ { "name": "Rich text", "blocks": [ { "type": "heading" }, { "type": "text" } ] } ]
}
{% endschema %}
