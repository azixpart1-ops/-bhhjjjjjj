{%- assign s = section.settings -%}
<section {% render 'section-attrs', section: section, class: 'compare' %}>
  <div class="container container--medium">
    <div class="section-head section-head--center" data-reveal>
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{% render 'icon', name: 'sparkle', size: 14 %}{{ s.eyebrow | escape }}</p>{%- endif -%}
      {% render 'heading', text: s.heading, class: 'h2' %}
      {%- if s.text != blank -%}<div class="lead">{{ s.text }}</div>{%- endif -%}
    </div>

    <div class="compare__table" role="table" aria-label="{{ s.heading | remove: '*' | escape }}" data-reveal>
      <div class="compare__row compare__row--head" role="row">
        <span role="columnheader"><span class="visually-hidden">{{ 'sections.compare.feature' | t }}</span></span>
        <span role="columnheader" class="compare__us">{% render 'wordmark' %}</span>
        <span role="columnheader" class="compare__them">{{ s.them_label | escape }}</span>
      </div>
      {%- for block in section.blocks -%}
        <div class="compare__row" role="row" {{ block.shopify_attributes }}>
          <span role="rowheader" class="compare__feature">{{ block.settings.feature | escape }}</span>
          <span role="cell" class="compare__us">
            <span class="compare__mark compare__mark--yes">{% render 'icon', name: 'check', size: 16 %}</span>
            <span>{{ block.settings.us | escape }}</span>
          </span>
          <span role="cell" class="compare__them">
            <span class="compare__mark compare__mark--no">{% render 'icon', name: 'close', size: 14 %}</span>
            <span>{{ block.settings.them | escape }}</span>
          </span>
        </div>
      {%- endfor -%}
    </div>

    {%- if s.cta_label != blank -%}
      <div class="compare__cta" data-reveal>
        <a class="btn btn--lg" href="{{ s.cta_link | default: routes.all_products_collection_url }}">{{ s.cta_label | escape }}{% render 'icon', name: 'arrow-right', size: 18 %}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Comparison",
  "tag": "div",
  "class": "section-compare",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "moonlight" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Snoozly" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not just a bed. *The right bed.*" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "them_label", "label": "Comparison column", "default": "A typical pet-shop bed" },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Find their bed" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Chosen for how they sleep" },
        { "type": "text", "id": "us", "label": "Snoozly", "default": "Every bed sorted by sleep need" },
        { "type": "text", "id": "them", "label": "Typical", "default": "One shape for every pet" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison",
      "blocks": [
        { "type": "row", "settings": { "feature": "Chosen for how they sleep", "us": "Every bed sorted by sleep need", "them": "One shape for every pet" } },
        { "type": "row", "settings": { "feature": "Sizing help", "us": "Breed-by-breed guide and the Sleep Match", "them": "S, M, L — and a guess" } }
      ]
    }
  ]
}
{% endschema %}
