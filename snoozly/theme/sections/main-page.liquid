{%- assign s = section.settings -%}
<section {% render 'section-attrs', section: section, class: 'page' %}>
  <div class="container container--{{ s.width }}">
    <header class="page__head{% if s.align == 'center' %} page__head--center{% endif %}" data-reveal>
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{% render 'icon', name: 'moon', size: 14 %}{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h1 class="h1 page__title">{{ page.title | escape }}</h1>
      {%- if s.subtitle != blank -%}<p class="lead">{{ s.subtitle | escape }}</p>{%- endif -%}
    </header>
    {%- if page.content != blank -%}
      <div class="rte page__content" data-reveal style="--i: 2;">
        {{ page.content | replace: '[free_threshold]', settings.free_shipping_threshold | replace: '[returns_days]', settings.returns_days | replace: '[standard_price]', settings.shipping_standard_price | replace: '[express_price]', settings.shipping_express_price | replace: '[min_days]', settings.delivery_min_days | replace: '[max_days]', settings.delivery_max_days | replace: '[support_email]', settings.support_email | replace: '[support_hours]', settings.support_hours }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page content",
  "tag": "div",
  "class": "section-main-page",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "moonlight" },
    { "type": "select", "id": "width", "label": "Width", "options": [ { "value": "narrow", "label": "Narrow (best for reading)" }, { "value": "medium", "label": "Medium" } ], "default": "narrow" },
    { "type": "select", "id": "align", "label": "Heading alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" } ], "default": "left" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "subtitle", "label": "Subtitle" },
    { "type": "paragraph", "content": "Page text can use [free_threshold], [returns_days], [standard_price], [express_price], [min_days], [max_days], [support_email] and [support_hours] — they're filled in from Theme settings, so policy figures stay consistent everywhere." },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ]
}
{% endschema %}
