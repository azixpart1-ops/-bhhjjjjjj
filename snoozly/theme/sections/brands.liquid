{%- comment -%}
  "Makers we stock" — borrowed authority from the brands in the catalogue.
  Names as type by default (no logo files needed); a logo image replaces the
  name when one is added.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section {% render 'section-attrs', section: section, class: 'brands' %}>
  <div class="container brands__inner">
    <p class="brands__intro" data-reveal>{{ s.intro | escape }}</p>
    <ul class="brands__list" role="list" data-reveal>
      {%- for block in section.blocks -%}
        <li class="brands__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
          {%- if block.settings.logo != blank -%}
            {{ block.settings.logo | image_url: width: 320 | image_tag: loading: 'lazy', alt: block.settings.name, class: 'brands__logo' }}
          {%- else -%}
            <span class="brands__name">{{ block.settings.name | escape }}</span>
          {%- endif -%}
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Makers we stock",
  "tag": "div",
  "class": "section-brands",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "moonlight" },
    { "type": "text", "id": "intro", "label": "Intro", "default": "Beds from makers we trust" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Danish Design" },
        { "type": "image_picker", "id": "logo", "label": "Logo (optional)" },
        { "type": "url", "id": "link", "label": "Link", "info": "e.g. a search or collection for this brand" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Makers we stock",
      "blocks": [
        { "type": "brand", "settings": { "name": "Danish Design" } },
        { "type": "brand", "settings": { "name": "Banbury & Co" } },
        { "type": "brand", "settings": { "name": "Trixie" } },
        { "type": "brand", "settings": { "name": "Red Hamper" } }
      ]
    }
  ]
}
{% endschema %}
