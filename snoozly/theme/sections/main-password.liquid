<section class="pw color-midnight night-sky" data-dark="true">
  <div class="pw__inner">
    <div class="pw__brand">{% render 'wordmark' %}</div>
    <div class="cta__moon pw__moon" aria-hidden="true"></div>
    <p class="eyebrow">{% render 'icon', name: 'moon', size: 14 %}{{ 'general.password.eyebrow' | t }}</p>
    <h1 class="h1">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}<p class="lead">{{ shop.password_message }}</p>{%- else -%}<p class="lead">{{ section.settings.text | escape }}</p>{%- endif -%}
    {%- form 'customer', class: 'club-form pw__form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success">{% render 'icon', name: 'check', size: 18 %}{{ 'general.password.thanks' | t }}</p>
      {%- else -%}
        <div class="club-form__row">
          <label class="visually-hidden" for="pw-email">{{ 'sections.newsletter.email' | t }}</label>
          <input class="input club-form__input" id="pw-email" type="email" name="contact[email]" required placeholder="{{ 'sections.newsletter.email' | t }}">
          <button class="btn btn--moon club-form__btn" type="submit">{{ 'general.password.notify' | t }}</button>
        </div>
        {{ form.errors | default_errors }}
      {%- endif -%}
    {%- endform -%}
    <details class="pw__owner">
      <summary>{{ 'general.password.owner' | t }}</summary>
      {%- form 'storefront_password', class: 'pw__owner-form' -%}
        {{ form.errors | default_errors }}
        <label class="visually-hidden" for="pw-pass">{{ 'customer.password' | t }}</label>
        <input class="input" id="pw-pass" type="password" name="password" autocomplete="current-password" placeholder="{{ 'customer.password' | t }}">
        <button class="btn btn--secondary" type="submit">{{ 'general.password.enter' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something cosy is coming." },
    { "type": "text", "id": "text", "label": "Text", "default": "Premium beds for dogs and cats, chosen for how they sleep. Leave your email and we'll tell you the moment we open." }
  ]
}
{% endschema %}
