{%- assign s = section.settings -%}
<section {% render 'section-attrs', section: section, class: 'sgpage' %}>
  <div class="container container--medium sgpage__grid">
    <div class="sgpage__copy" data-reveal>
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{% render 'icon', name: 'ruler', size: 14 %}{{ s.eyebrow | escape }}</p>{%- endif -%}
      {% render 'heading', text: s.heading, tag: s.heading_tag, class: 'h1' %}
      {%- if s.text != blank -%}<div class="lead">{{ s.text }}</div>{%- endif -%}
      <div class="sgpage__media">{% render 'media', image: s.image, ratio: '4 / 3', sizes: '(min-width: 990px) 40vw, 100vw', label: 'Measuring a sleeping dog, nose to tail', tone: 'stretch' %}</div>
    </div>
    <div class="sgpage__guide" data-reveal style="--i: 2;">
      {% render 'size-guide' %}
      <a class="btn btn--block btn--lg sgpage__cta" href="/pages/sleep-match">{% render 'icon', name: 'moon', size: 18 %}{{ 'products.size_guide.quiz' | t }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Size guide",
  "tag": "div",
  "class": "section-size-guide",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "moonlight" },
    { "type": "select", "id": "heading_tag", "label": "Heading level", "options": [ { "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" } ], "default": "h1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Size guide" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get the size right *first time.*" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Too small and they hang off the edge. Too big and a nervous dog feels exposed. Two minutes with a tape measure fixes both.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "presets": [ { "name": "Size guide" } ]
}
{% endschema %}
