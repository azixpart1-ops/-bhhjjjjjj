{%- assign s = section.settings -%}
<section {% render 'section-attrs', section: section, class: 'imgtext' %}>
  <div class="container imgtext__grid imgtext--{{ s.media_side }}">
    <div class="imgtext__media imgtext__media--{{ s.shape }}" data-reveal>
      {% render 'media', image: s.image, ratio: s.ratio, sizes: '(min-width: 990px) 50vw, 100vw', label: s.image_label, tone: s.placeholder_tone %}
    </div>
    <div class="imgtext__copy" data-reveal style="--i: 2;">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{% render 'icon', name: 'sparkle', size: 14 %}{{ s.eyebrow | escape }}</p>{%- endif -%}
      {% render 'heading', text: s.heading, class: 'h2', tag: s.heading_tag %}
      {%- if s.text != blank -%}<div class="rte imgtext__text">{{ s.text }}</div>{%- endif -%}
      {%- assign points = section.blocks | where: 'type', 'point' -%}
      {%- if points.size > 0 -%}
        <ul class="ticks" role="list">
          {%- for block in points -%}<li {{ block.shopify_attributes }}>{% render 'icon', name: 'check', size: 18 %}<span>{{ block.settings.text | escape }}</span></li>{%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if s.quote != blank -%}
        <blockquote class="imgtext__quote">
          <p>{{ s.quote | escape }}</p>
          {%- if s.quote_by != blank -%}<cite>— {{ s.quote_by | escape }}</cite>{%- endif -%}
        </blockquote>
      {%- endif -%}
      {%- if s.cta_label != blank -%}
        <div class="btn-row"><a class="btn" href="{{ s.cta_link | default: routes.all_products_collection_url }}">{{ s.cta_label | escape }}{% render 'icon', name: 'arrow-right', size: 18 %}</a></div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "tag": "div",
  "class": "section-imgtext",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "moonlight" },
    { "type": "select", "id": "media_side", "label": "Image side", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "select", "id": "shape", "label": "Image shape", "options": [ { "value": "pillow", "label": "Pillow" }, { "value": "arch", "label": "Arch" }, { "value": "circle", "label": "Circle" } ], "default": "pillow" },
    { "type": "select", "id": "ratio", "label": "Image ratio", "options": [ { "value": "4 / 5", "label": "Portrait" }, { "value": "1 / 1", "label": "Square" }, { "value": "5 / 4", "label": "Landscape" } ], "default": "4 / 5" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_label", "label": "Placeholder note", "default": "Lifestyle photo" },
    { "type": "select", "id": "placeholder_tone", "label": "Placeholder tone", "options": [ { "value": "", "label": "Scheme" }, { "value": "calm", "label": "Calm" }, { "value": "support", "label": "Support" }, { "value": "cosy", "label": "Cosy" }, { "value": "stretch", "label": "Stretch" }, { "value": "cool", "label": "Cool" } ], "default": "" },
    { "type": "select", "id": "heading_tag", "label": "Heading level", "options": [ { "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" } ], "default": "h2" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We started with *one question.*" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Why do we spend so long choosing our own mattress, and thirty seconds choosing theirs?</p>" },
    { "type": "text", "id": "quote", "label": "Pull quote" },
    { "type": "text", "id": "quote_by", "label": "Quote by" },
    { "type": "text", "id": "cta_label", "label": "Button" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    { "type": "point", "name": "Tick point", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Chosen for how they sleep" } ] }
  ],
  "presets": [ { "name": "Image with text" } ]
}
{% endschema %}
