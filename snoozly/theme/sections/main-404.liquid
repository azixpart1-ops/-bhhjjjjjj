{%- assign need_keys = 'calm,support,cool,cosy,stretch' | split: ',' -%}
<section {% render 'section-attrs', section: section, class: 'nf night-sky' %}>
  <div class="container nf__inner">
    <div class="nf__moon" aria-hidden="true">{% render 'icon', name: 'zzz', size: 40 %}</div>
    <p class="eyebrow">{{ 'general.404.eyebrow' | t }}</p>
    <h1 class="h1">{{ 'general.404.title' | t }}</h1>
    <p class="lead">{{ 'general.404.text' | t }}</p>
    <form action="{{ routes.search_url }}" method="get" role="search" class="searchbar nf__search">
      <label class="visually-hidden" for="nf-search">{{ 'sections.header.search' | t }}</label>
      {% render 'icon', name: 'search', size: 20 %}
      <input class="searchbar__input" id="nf-search" type="search" name="q" placeholder="{{ 'sections.search.placeholder' | t }}">
      <button type="submit" class="btn btn--sm btn--moon">{{ 'sections.search.submit' | t }}</button>
    </form>
    <ul class="psearch__chips nf__needs" role="list">
      {%- for k in need_keys -%}
        {%- liquid
          assign ck = 'need_' | append: k | append: '_collection'
          assign c = settings[ck]
          assign lk = 'need_' | append: k | append: '_label'
          assign ni = 'need-' | append: k
        -%}
        {%- if c != blank and c.products_count > 0 -%}<li><a class="chip need-chip need--{{ k }}" href="{{ c.url }}">{% render 'icon', name: ni, size: 16 %}{{ settings[lk] | escape }}</a></li>{%- endif -%}
      {%- endfor -%}
    </ul>
    <div class="btn-row nf__ctas">
      <a class="btn btn--moon btn--lg" href="/pages/sleep-match">{% render 'icon', name: 'sparkle', size: 18 %}{{ 'cart.empty_quiz' | t }}</a>
      <a class="btn btn--secondary btn--lg" href="{{ routes.root_url }}">{{ 'general.404.home' | t }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "tag": "div",
  "class": "section-404",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "midnight" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 136 }
  ]
}
{% endschema %}
