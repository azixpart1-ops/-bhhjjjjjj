{%- assign s = section.settings -%}
<section {% render 'section-attrs', section: section, class: 'cta night-sky' %}>
  {%- if s.image != blank -%}
    <div class="cta__bg" style="--scrim: {{ s.scrim | divided_by: 100.0 }};">
      {% render 'media', image: s.image, ratio: 'natural', sizes: '100vw' %}
    </div>
  {%- endif -%}
  <div class="container cta__inner cta--{{ s.align }}">
    <div class="cta__moon" aria-hidden="true"></div>
    {%- if s.eyebrow != blank -%}<p class="eyebrow" data-reveal>{% render 'icon', name: 'moon', size: 14 %}{{ s.eyebrow | escape }}</p>{%- endif -%}
    <div data-reveal style="--i: 1;">{% render 'heading', text: s.heading, class: 'h1 cta__title' %}</div>
    {%- if s.text != blank -%}<div class="lead cta__text" data-reveal style="--i: 2;">{{ s.text }}</div>{%- endif -%}
    <div class="btn-row cta__btns" data-reveal style="--i: 3;">
      {%- if s.cta1_label != blank -%}<a class="btn btn--lg btn--moon" href="{{ s.cta1_link | default: '/pages/sleep-match' }}">{% render 'icon', name: 'sparkle', size: 18 %}{{ s.cta1_label | escape }}</a>{%- endif -%}
      {%- if s.cta2_label != blank -%}<a class="btn btn--lg btn--secondary" href="{{ s.cta2_link | default: routes.all_products_collection_url }}">{{ s.cta2_label | escape }}</a>{%- endif -%}
    </div>
    {%- if s.note != blank -%}<p class="cta__note" data-reveal style="--i: 4;">{{ s.note | escape }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Closing call to action",
  "tag": "div",
  "class": "section-cta",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "midnight" },
    { "type": "select", "id": "align", "label": "Alignment", "options": [ { "value": "center", "label": "Centre" }, { "value": "left", "label": "Left" } ], "default": "center" },
    { "type": "image_picker", "id": "image", "label": "Background image (optional)" },
    { "type": "range", "id": "scrim", "label": "Darken image", "min": 60, "max": 95, "step": 5, "unit": "%", "default": 80, "info": "Floor of 60% keeps text readable over any photo." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Tonight could be the night" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Give them the best sleep of *their whole life.*" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>They'd never ask. That's exactly why it's worth getting right.</p>" },
    { "type": "text", "id": "cta1_label", "label": "First button", "default": "Take the Sleep Match" },
    { "type": "url", "id": "cta1_link", "label": "First button link" },
    { "type": "text", "id": "cta2_label", "label": "Second button", "default": "Shop all beds" },
    { "type": "url", "id": "cta2_link", "label": "Second button link" },
    { "type": "text", "id": "note", "label": "Small print" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 128 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 128 }
  ],
  "presets": [ { "name": "Closing call to action" } ]
}
{% endschema %}
