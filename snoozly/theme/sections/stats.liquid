{%- comment -%}
  Big-number reframe. The point: a bed is the most-used thing a pet owns, so
  its price is best read per night. Numbers are general facts or arithmetic
  shown with its basis — never invented performance claims.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section {% render 'section-attrs', section: section, class: 'stats night-sky' %}>
  <div class="container">
    <div class="section-head section-head--center" data-reveal>
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{% render 'icon', name: 'moon', size: 14 %}{{ s.eyebrow | escape }}</p>{%- endif -%}
      {% render 'heading', text: s.heading, class: 'h2' %}
      {%- if s.text != blank -%}<div class="lead">{{ s.text }}</div>{%- endif -%}
    </div>
    <ul class="stats__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="stat" {{ block.shopify_attributes }} data-reveal style="--i: {{ forloop.index }};">
          <p class="stat__value">{{ block.settings.value | escape }}</p>
          <p class="stat__label">{{ block.settings.label | escape }}</p>
          {%- if block.settings.note != blank -%}<p class="stat__note">{{ block.settings.note | escape }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    {%- if s.cta_label != blank -%}
      <div class="stats__cta" data-reveal><a class="btn btn--moon btn--lg" href="{{ s.cta_link | default: '/pages/sleep-match' }}">{% render 'icon', name: 'sparkle', size: 18 %}{{ s.cta_label | escape }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Big numbers",
  "tag": "div",
  "class": "section-stats",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "midnight" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why the bed matters" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Their bed is the most-used thing *they own.*" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Find the right one" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 104 }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Number",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Number", "default": "12–14 hrs" },
        { "type": "text", "id": "label", "label": "Label", "default": "The average adult dog's daily sleep" },
        { "type": "text", "id": "note", "label": "Small print" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Big numbers",
      "blocks": [
        { "type": "stat", "settings": { "value": "12–14 hrs", "label": "The average adult dog's daily sleep" } },
        { "type": "stat", "settings": { "value": "Up to 16", "label": "Hours a cat can spend asleep each day" } },
        { "type": "stat", "settings": { "value": "Under 1p", "label": "An hour, for a £90 bed used 13 hours a day for two years", "note": "£90 ÷ (13 hrs × 730 days) = 0.95p" } }
      ]
    }
  ]
}
{% endschema %}
