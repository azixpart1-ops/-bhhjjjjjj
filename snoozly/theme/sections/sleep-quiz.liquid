{%- comment -%}
  THE SLEEP MATCH
  Four questions → one colour-coded sleep need → the beds for it, pulled live
  from that need's collection (in-stock first, the right size pre-selected).
  Nothing here is hard-coded to a product: add beds to a collection and the
  quiz recommends them the same day.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign need_keys = 'calm,support,cool,cosy,stretch' | split: ','
-%}
<section {% render 'section-attrs', section: section, class: 'quiz' %}>
  <div class="container quiz__wrap quiz__wrap--{{ s.layout }}">
    <div class="quiz__head" data-reveal>
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{% render 'icon', name: 'moon', size: 14 %}{{ s.eyebrow | escape }}</p>{%- endif -%}
      {% render 'heading', text: s.heading, class: 'h2', tag: s.heading_tag %}
      {%- if s.text != blank -%}<div class="lead">{{ s.text }}</div>{%- endif -%}
      <ul class="quiz__promises" role="list">
        <li>{% render 'icon', name: 'clock', size: 16 %}{{ 'sections.quiz.promise_time' | t }}</li>
        <li>{% render 'icon', name: 'mail', size: 16 %}{{ 'sections.quiz.promise_email' | t }}</li>
        <li>{% render 'icon', name: 'ruler', size: 16 %}{{ 'sections.quiz.promise_size' | t }}</li>
      </ul>
    </div>

    <sleep-quiz class="quiz__card" id="sleep-match-{{ section.id }}" data-reveal style="--i: 2;">
      <div class="quiz__bar">
        <span class="quiz__step-label" data-quiz-label>{{ 'sections.quiz.step' | t: step: 1, total: 4 }}</span>
        <button type="button" class="quiz__back" data-quiz-back hidden>{% render 'icon', name: 'arrow-left', size: 16 %}{{ 'general.back' | t }}</button>
      </div>
      <div class="quiz__progress" aria-hidden="true"><span data-quiz-progress style="--p: 25%;"></span></div>

      <div class="quiz__steps" data-quiz-steps>
        <fieldset class="quiz__step is-active" data-step="pet">
          <legend class="h3 quiz__q">{{ s.q1 | escape }}</legend>
          <div class="quiz__opts quiz__opts--2">
            <button type="button" class="quiz__opt" data-answer="dog">{% render 'icon', name: 'paw', size: 28 %}<span class="quiz__opt-label">{{ s.q1_dog | escape }}</span></button>
            <button type="button" class="quiz__opt" data-answer="cat">{% render 'icon', name: 'need-cosy', size: 28 %}<span class="quiz__opt-label">{{ s.q1_cat | escape }}</span></button>
          </div>
        </fieldset>

        <fieldset class="quiz__step" data-step="style" hidden>
          <legend class="h3 quiz__q">{{ s.q2 | escape }}</legend>
          <div class="quiz__opts">
            <button type="button" class="quiz__opt" data-answer="curl">{% render 'icon', name: 'need-cosy', size: 26 %}<span class="quiz__opt-label">{{ s.q2_curl | escape }}</span><span class="quiz__opt-sub">{{ s.q2_curl_sub | escape }}</span></button>
            <button type="button" class="quiz__opt" data-answer="sprawl">{% render 'icon', name: 'need-stretch', size: 26 %}<span class="quiz__opt-label">{{ s.q2_sprawl | escape }}</span><span class="quiz__opt-sub">{{ s.q2_sprawl_sub | escape }}</span></button>
            <button type="button" class="quiz__opt" data-answer="lean">{% render 'icon', name: 'need-calm', size: 26 %}<span class="quiz__opt-label">{{ s.q2_lean | escape }}</span><span class="quiz__opt-sub">{{ s.q2_lean_sub | escape }}</span></button>
            <button type="button" class="quiz__opt" data-answer="burrow">{% render 'icon', name: 'moon', size: 26 %}<span class="quiz__opt-label">{{ s.q2_burrow | escape }}</span><span class="quiz__opt-sub">{{ s.q2_burrow_sub | escape }}</span></button>
          </div>
        </fieldset>

        <fieldset class="quiz__step" data-step="concern" hidden>
          <legend class="h3 quiz__q">{{ s.q3 | escape }}</legend>
          <div class="quiz__opts">
            <button type="button" class="quiz__opt need--support" data-answer="joints">{% render 'icon', name: 'need-support', size: 26 %}<span class="quiz__opt-label">{{ s.q3_joints | escape }}</span></button>
            <button type="button" class="quiz__opt need--calm" data-answer="anxious">{% render 'icon', name: 'need-calm', size: 26 %}<span class="quiz__opt-label">{{ s.q3_anxious | escape }}</span></button>
            <button type="button" class="quiz__opt need--cool" data-answer="hot">{% render 'icon', name: 'need-cool', size: 26 %}<span class="quiz__opt-label">{{ s.q3_hot | escape }}</span></button>
            <button type="button" class="quiz__opt" data-answer="none">{% render 'icon', name: 'heart', size: 26 %}<span class="quiz__opt-label">{{ s.q3_none | escape }}</span></button>
          </div>
        </fieldset>

        <fieldset class="quiz__step" data-step="size" hidden>
          <legend class="h3 quiz__q">{{ s.q4 | escape }}</legend>
          <div class="quiz__opts">
            <button type="button" class="quiz__opt quiz__opt--size" data-answer="small"><span class="quiz__opt-label">{{ s.q4_small | escape }}</span><span class="quiz__opt-sub">{{ s.q4_small_sub | escape }}</span></button>
            <button type="button" class="quiz__opt quiz__opt--size" data-answer="medium"><span class="quiz__opt-label">{{ s.q4_medium | escape }}</span><span class="quiz__opt-sub">{{ s.q4_medium_sub | escape }}</span></button>
            <button type="button" class="quiz__opt quiz__opt--size" data-answer="large"><span class="quiz__opt-label">{{ s.q4_large | escape }}</span><span class="quiz__opt-sub">{{ s.q4_large_sub | escape }}</span></button>
            <button type="button" class="quiz__opt quiz__opt--size" data-answer="giant"><span class="quiz__opt-label">{{ s.q4_giant | escape }}</span><span class="quiz__opt-sub">{{ s.q4_giant_sub | escape }}</span></button>
          </div>
          <p class="quiz__measure">{% render 'icon', name: 'ruler', size: 16 %}{{ s.measure_tip | escape }}</p>
        </fieldset>
      </div>

      <div class="quiz__result" data-quiz-result hidden tabindex="-1" aria-live="polite"></div>

      <noscript>
        <p class="quiz__noscript">{{ 'sections.quiz.noscript' | t }} <a href="{{ routes.all_products_collection_url }}">{{ 'cart.empty_shop' | t }}</a></p>
      </noscript>

      <script type="application/json" data-quiz-data>
        {
          "labels": {
            "match": {{ 'sections.quiz.your_match' | t | json }},
            "why": {{ 'sections.quiz.why' | t | json }},
            "size": {{ 'sections.quiz.size_advice' | t | json }},
            "shopAll": {{ 'sections.quiz.shop_all' | t | json }},
            "restart": {{ 'sections.quiz.restart' | t | json }},
            "alsoTry": {{ 'sections.quiz.also_try' | t | json }},
            "inSize": {{ 'sections.quiz.in_your_size' | t | json }},
            "backSoon": {{ 'products.back_soon' | t | json }},
            "view": {{ 'sections.quiz.view_bed' | t | json }},
            "none": {{ 'sections.quiz.no_products' | t | json }},
            "step": {{ 'sections.quiz.step' | t: step: '[step]', total: '[total]' | json }},
            "top": {{ 'sections.quiz.top_pick' | t | json }}
          },
          "sizes": {
            "small": {{ s.q4_small_advice | json }},
            "medium": {{ s.q4_medium_advice | json }},
            "large": {{ s.q4_large_advice | json }},
            "giant": {{ s.q4_giant_advice | json }},
            "cat": {{ s.cat_advice | json }}
          },
          "allUrl": {{ routes.all_products_collection_url | json }},
          "needs": {
            {%- for k in need_keys -%}
              {%- liquid
                assign ck = 'need_' | append: k | append: '_collection'
                assign c = settings[ck]
                assign lk = 'need_' | append: k | append: '_label'
                assign fk = 'need_' | append: k | append: '_for'
                assign wk = 'need_' | append: k | append: '_why'
              -%}
              {{ k | json }}: {
                "label": {{ settings[lk] | json }},
                "for": {{ settings[fk] | json }},
                "why": {{ settings[wk] | json }},
                "url": {% if c != blank %}{{ c.url | json }}{% else %}null{% endif %},
                "products": [
                  {%- if c != blank -%}
                    {%- assign first_written = false -%}
                    {%- for pass in (1..2) -%}
                      {%- for p in c.products limit: 24 -%}
                        {%- if pass == 1 and p.available == false -%}{%- continue -%}{%- endif -%}
                        {%- if pass == 2 and p.available -%}{%- continue -%}{%- endif -%}
                        {%- if first_written -%},{%- endif -%}
                        {%- assign first_written = true -%}
                        {%- capture t -%}{% render 'product-title', product: p %}{%- endcapture -%}
                        {%- capture price_html -%}{% if p.price_varies %}{{ 'products.from' | t }} {% endif %}{{ p.price_min | money }}{%- endcapture -%}
                        {
                          "title": {{ t | strip | json }},
                          "url": {{ p.url | json }},
                          "price": {{ price_html | strip_html | strip | json }},
                          "image": {% if p.featured_media %}{{ p.featured_media.preview_image | image_url: width: 480 | json }}{% else %}null{% endif %},
                          "available": {{ p.available | json }},
                          "variants": [
                            {%- for v in p.variants limit: 30 -%}
                              {"id": {{ v.id }}, "t": {{ v.title | downcase | json }}, "a": {{ v.available | json }}}{% unless forloop.last %},{% endunless %}
                            {%- endfor -%}
                          ]
                        }
                      {%- endfor -%}
                    {%- endfor -%}
                  {%- endif -%}
                ]
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          }
        }
      </script>
    </sleep-quiz>
  </div>
</section>

{% schema %}
{
  "name": "Sleep Match quiz",
  "tag": "div",
  "class": "section-quiz",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "midnight" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [ { "value": "split", "label": "Heading beside the quiz" }, { "value": "stack", "label": "Heading above the quiz" } ], "default": "split" },
    { "type": "select", "id": "heading_tag", "label": "Heading level", "options": [ { "value": "h1", "label": "H1 (when the quiz is the page)" }, { "value": "h2", "label": "H2" } ], "default": "h2" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Sleep Match" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tell us how they sleep. *We'll find the bed.*" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Four questions, sixty seconds. You'll get the sleep need that fits them, the size to look for, and the beds we'd choose — in stock and ready to go.</p>" },
    { "type": "header", "content": "Question 1" },
    { "type": "text", "id": "q1", "label": "Question", "default": "Who's the bed for?" },
    { "type": "text", "id": "q1_dog", "label": "Dog", "default": "A dog" },
    { "type": "text", "id": "q1_cat", "label": "Cat", "default": "A cat" },
    { "type": "header", "content": "Question 2" },
    { "type": "text", "id": "q2", "label": "Question", "default": "How do they usually sleep?" },
    { "type": "text", "id": "q2_curl", "label": "Curled", "default": "Curled in a tight ball" },
    { "type": "text", "id": "q2_curl_sub", "label": "Curled — detail", "default": "Nose tucked into tail" },
    { "type": "text", "id": "q2_sprawl", "label": "Sprawled", "default": "Stretched out flat" },
    { "type": "text", "id": "q2_sprawl_sub", "label": "Sprawled — detail", "default": "Legs everywhere, takes up the room" },
    { "type": "text", "id": "q2_lean", "label": "Leaning", "default": "Head resting on something" },
    { "type": "text", "id": "q2_lean_sub", "label": "Leaning — detail", "default": "The sofa arm, a cushion, your leg" },
    { "type": "text", "id": "q2_burrow", "label": "Burrowing", "default": "Burrowed under blankets" },
    { "type": "text", "id": "q2_burrow_sub", "label": "Burrowing — detail", "default": "Only the ears are visible" },
    { "type": "header", "content": "Question 3" },
    { "type": "text", "id": "q3", "label": "Question", "default": "Anything we should know?" },
    { "type": "text", "id": "q3_joints", "label": "Joints", "default": "Getting older, or a little stiff" },
    { "type": "text", "id": "q3_anxious", "label": "Anxious", "default": "Nervous or easily unsettled" },
    { "type": "text", "id": "q3_hot", "label": "Hot", "default": "Runs hot and pants at night" },
    { "type": "text", "id": "q3_none", "label": "None", "default": "Nothing — they're just brilliant" },
    { "type": "header", "content": "Question 4 (dogs)" },
    { "type": "text", "id": "q4", "label": "Question", "default": "How big are they?" },
    { "type": "text", "id": "q4_small", "label": "Small", "default": "Small" },
    { "type": "text", "id": "q4_small_sub", "label": "Small — breeds", "default": "Dachshund, Jack Russell, Pug · up to 10kg" },
    { "type": "textarea", "id": "q4_small_advice", "label": "Small — size advice", "default": "Look for a bed around 60–75cm long — usually a Small or Medium." },
    { "type": "text", "id": "q4_medium", "label": "Medium", "default": "Medium" },
    { "type": "text", "id": "q4_medium_sub", "label": "Medium — breeds", "default": "Cocker, Beagle, Staffie · 10–25kg" },
    { "type": "textarea", "id": "q4_medium_advice", "label": "Medium — size advice", "default": "Look for a bed around 75–90cm long — usually a Medium or Large." },
    { "type": "text", "id": "q4_large", "label": "Large", "default": "Large" },
    { "type": "text", "id": "q4_large_sub", "label": "Large — breeds", "default": "Labrador, Retriever, Boxer · 25–40kg" },
    { "type": "textarea", "id": "q4_large_advice", "label": "Large — size advice", "default": "Look for a bed around 90–110cm long — usually a Large or Extra Large." },
    { "type": "text", "id": "q4_giant", "label": "Giant", "default": "Extra large" },
    { "type": "text", "id": "q4_giant_sub", "label": "Giant — breeds", "default": "German Shepherd, Great Dane · 40kg+" },
    { "type": "textarea", "id": "q4_giant_advice", "label": "Giant — size advice", "default": "Look for a bed 110cm or longer — an Extra Large, or the biggest size a bed comes in." },
    { "type": "textarea", "id": "cat_advice", "label": "Cat — size advice", "default": "Most cats sleep best in a bed around 45–60cm across — snug enough to feel held." },
    { "type": "text", "id": "measure_tip", "label": "Measuring tip", "default": "Most accurate: measure nose to base of tail while they're asleep and stretched out, then add 15–20cm." },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 104 }
  ],
  "presets": [ { "name": "Sleep Match quiz" } ]
}
{% endschema %}
