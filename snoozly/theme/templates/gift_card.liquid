{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    {%- assign gc_value = gift_card.initial_value | money -%}
    <title>{{ 'gift_card.title' | t: value: gc_value }} — {{ settings.brand_name | default: shop.name }}</title>
    {% render 'css-variables' %}
    {{ 'snoozly.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="template-gift-card">
    <main class="gc color-midnight night-sky" data-dark="true">
      <div class="gc__inner">
        <div class="gc__brand">{% render 'wordmark' %}</div>
        <p class="eyebrow">{% render 'icon', name: 'gift', size: 14 %}{{ 'gift_card.eyebrow' | t }}</p>
        {%- assign initial = gift_card.initial_value | money -%}
        <h1 class="h1">{{ 'gift_card.heading' | t: value: initial }}</h1>
        {%- if gift_card.expired or gift_card.enabled == false -%}
          <p class="form-message form-message--error">{{ 'gift_card.disabled' | t }}</p>
        {%- else -%}
          {%- assign balance = gift_card.balance | money -%}
          <p class="lead">{{ 'gift_card.balance' | t: value: balance }}</p>
        {%- endif -%}
        <div class="gc__card">
          <p class="gc__label">{{ 'gift_card.code' | t }}</p>
          <p class="gc__code" id="gc-code">{{ gift_card.code | format_code }}</p>
          <div class="gc__qr" id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
          {%- if gift_card.expires_on -%}{%- assign gc_exp = gift_card.expires_on | date: '%-d %B %Y' -%}<p class="muted xs">{{ 'gift_card.expires' | t: date: gc_exp }}</p>{%- endif -%}
        </div>
        <div class="btn-row gc__ctas">
          <a class="btn btn--moon btn--lg" href="{{ shop.url }}">{{ 'gift_card.shop' | t }}</a>
          <button class="btn btn--secondary btn--lg" type="button" onclick="navigator.clipboard && navigator.clipboard.writeText(document.getElementById('gc-code').textContent.trim())">{{ 'gift_card.copy' | t }}</button>
          {%- if gift_card.pass_url -%}<a href="{{ gift_card.pass_url }}" class="gc__wallet"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_card.apple_wallet' | t }}" loading="lazy"></a>{%- endif -%}
        </div>
      </div>
    </main>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
