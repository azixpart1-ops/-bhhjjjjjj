{%- doc -%}
  The shared heading group for PawLunova sections: eyebrow, heading, lede.

  @param {string} [eyebrow] - small uppercase line above the heading
  @param {string} heading - the heading text (plain text; line breaks respected)
  @param {string} [lede] - supporting sentence
  @param {string} [align] - 'start' (default) or 'center'
  @param {string} [tag] - heading tag, default h2
  @param {string} [size] - heading class, default h2
{%- enddoc -%}
{%- liquid
  assign h_tag = tag | default: 'h2'
  assign h_size = size | default: 'h2'
-%}
<div class="pl-head{% if align == 'center' %} pl-head--center{% endif %}">
  {%- if eyebrow != blank -%}
    <p class="pl-eyebrow">{{ eyebrow }}</p>
  {%- endif -%}
  {%- if heading != blank -%}
    <{{ h_tag }} class="pl-head__heading {{ h_size }}">{{ heading | newline_to_br }}</{{ h_tag }}>
  {%- endif -%}
  {%- if lede != blank -%}
    <p class="pl-lede">{{ lede }}</p>
  {%- endif -%}
</div>
