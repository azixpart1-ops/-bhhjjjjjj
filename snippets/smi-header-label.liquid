{%- assign labelblock = section.blocks | where: 'type', 'label' | first -%}
{%- if labelblock -%}
    {%-liquid
        assign label1 = labelblock.settings.label_text1 | strip
        assign menu1 = labelblock.settings.menu_name1 | strip
        assign label2 = labelblock.settings.label_text2 | strip
        assign menu2 = labelblock.settings.menu_name2 | strip
        assign label3 = labelblock.settings.label_text3 | strip
        assign menu3 = labelblock.settings.menu_name3 | strip
        assign label4 = labelblock.settings.label_text4 | strip
        assign menu4 = labelblock.settings.menu_name4 | strip
        assign label5 = labelblock.settings.label_text5 | strip
        assign menu5 = labelblock.settings.menu_name5 | strip
    -%}
    <script class="smi-data-labels" type="application/json">
        [
            {%- if label1 != '' and menu1 != '' -%}
                {
                    "text": "{{- label1 -}}",
                    "background": "{{- labelblock.settings.background_color1 | default: "#D01717" -}}",
                    "color": "{{- labelblock.settings.text_color1 | default: "#FFFFFF" -}}",
                    "menu": "{{- menu1 -}}",
                    "classes": "smi-menu-label smi-text-center smi-menu-label--style-1 {{ labelblock.settings.animation1 -}}"
                }
            {%- endif -%}
            {%- if label2 != '' and menu2 != '' -%}
                ,{
                    "text": "{{- label2 -}}",
                    "background": "{{- labelblock.settings.background_color2 | default: "#D01717" -}}",
                    "color": "{{- labelblock.settings.text_color2 | default: "#FFFFFF" -}}",
                    "menu": "{{- menu2 -}}", 
                    "classes": "smi-menu-label smi-text-center smi-menu-label--style-2 {{ labelblock.settings.animation2 -}}"
                }
            {%- endif -%}
            {%- if label3 != '' and menu3 != '' -%}
                ,{
                    "text": "{{- label3 -}}",
                    "background": "{{- labelblock.settings.background_color3 | default: "#D01717" -}}",
                    "color": "{{- labelblock.settings.text_color3 | default: "#FFFFFF" -}}",
                    "menu": "{{- menu3 -}}",
                    "classes": "smi-menu-label smi-text-center smi-menu-label--style-3 {{ labelblock.settings.animation3 -}}"
                }
            {%- endif -%}
            {%- if label4 != '' and menu4 != '' -%}
                ,{
                    "text": "{{- label4 -}}",
                    "background": "{{- labelblock.settings.background_color4 | default: "#D01717" -}}",
                    "color": "{{- labelblock.settings.text_color4 | default: "#FFFFFF" -}}",
                    "menu": "{{- menu4 -}}",
                    "classes": "smi-menu-label smi-text-center smi-menu-label--style-4 {{ labelblock.settings.animation4 -}}"
                }
            {%- endif -%}
            {%- if label5 != '' and menu5 != '' -%}
                ,{
                    "text": "{{- label5 -}}",
                    "background": "{{- labelblock.settings.background_color5 | default: "#D01717" -}}",
                    "color": "{{- labelblock.settings.text_color5 | default: "#FFFFFF" -}}",
                    "menu": "{{- menu5 -}}",
                    "classes": "smi-menu-label smi-text-center smi-menu-label--style-5 {{ labelblock.settings.animation5 -}}"
                }
            {%- endif -%}
        ]    
    </script>
    <style>
        {%- if label1 != '' and menu1 != '' -%}
            .smi-menu-label--style-1 {
                --label-background: {{- labelblock.settings.background_color1 | default: "#D01717" -}};
                --label-color: {{- labelblock.settings.text_color1 | default: "#FFFFFF" -}};
            }
        {%- endif -%}
        {%- if label2 != '' and menu2 != '' -%}
            .smi-menu-label--style-2 {
                --label-background: {{- labelblock.settings.background_color2 | default: "#D01717" -}};
                --label-color: {{- labelblock.settings.text_color2 | default: "#FFFFFF" -}};
            }
        {%- endif -%}
        {%- if label3 != '' and menu3 != '' -%}
            .smi-menu-label--style-3 {
                --label-background: {{- labelblock.settings.background_color3 | default: "#D01717" -}};
                --label-color: {{- labelblock.settings.text_color3 | default: "#FFFFFF" -}};
            }
        {%- endif -%}
        {%- if label4 != '' and menu4 != '' -%}
            .smi-menu-label--style-4 {
                --label-background: {{- labelblock.settings.background_color4 | default: "#D01717" -}};
                --label-color: {{- labelblock.settings.text_color4 | default: "#FFFFFF" -}};
            }
        {%- endif -%}
        {%- if label5 != '' and menu5 != '' -%}
            .smi-menu-label--style-5 {
                --label-background: {{- labelblock.settings.background_color5 | default: "#D01717" -}};
                --label-color: {{- labelblock.settings.text_color5 | default: "#FFFFFF" -}};
            }
        {%- endif -%}
    </style>
{%- endif -%}{%comment%}#includeFile##endIncludeFile#{%endcomment%}