{%- doc -%}
  PawLunova inline icons: 20x20 strokes in currentColor, so they sit in any colour context.

  @param {string} name - paw, moon, shield, truck, chat, ruler, leaf, check, info, arrow, bed, layers, home, clock, heart, return, lock, star, whatsapp, close, chevron, sparkle, drop, wash, step, dog, scale
  @param {string} [class] - extra classes
{%- enddoc -%}
{%- liquid
  assign c = 'pl-icon'
  if class != blank
    assign c = c | append: ' ' | append: class
  endif
-%}
<svg class="{{ c }}" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'paw' -%}
      <circle cx="6" cy="7" r="1.6"/><circle cx="14" cy="7" r="1.6"/><circle cx="3.6" cy="11" r="1.4"/><circle cx="16.4" cy="11" r="1.4"/><path d="M10 10.5c-2.6 0-4.6 2.3-4.6 4.4 0 1.3.9 2.1 2.1 2.1.9 0 1.6-.5 2.5-.5s1.6.5 2.5.5c1.2 0 2.1-.8 2.1-2.1 0-2.1-2-4.4-4.6-4.4z"/>
    {%- when 'moon' -%}
      <path d="M16.5 12.2A6.8 6.8 0 0 1 7.8 3.5a6.8 6.8 0 1 0 8.7 8.7z"/>
    {%- when 'shield' -%}
      <path d="M10 2.5 4 4.8v4.7c0 3.6 2.6 6.4 6 7.5 3.4-1.1 6-3.9 6-7.5V4.8L10 2.5z"/><path d="m7.5 9.8 1.8 1.8 3.4-3.6"/>
    {%- when 'truck' -%}
      <path d="M2.5 5.5h9v8h-9zM11.5 8.5h3.2l2.8 2.9v2.1h-6z"/><circle cx="5.5" cy="14.5" r="1.5"/><circle cx="14" cy="14.5" r="1.5"/>
    {%- when 'chat' -%}
      <path d="M3.5 4.5h13v8.5h-7l-3.5 3v-3h-2.5z"/>
    {%- when 'ruler' -%}
      <path d="m3 13.5 10.5-10.5 3.5 3.5L6.5 17z"/><path d="m6.2 10.3 1.6 1.6M8.6 7.9l1.6 1.6M11 5.5l1.6 1.6"/>
    {%- when 'leaf' -%}
      <path d="M16.5 3.5c-7 0-11.5 3.5-12 10.5 3 .2 6.5-.5 8.8-2.8 2.2-2.2 3.2-5 3.2-7.7z"/><path d="M4.5 15.5c2-3.5 5-6 8.5-8"/>
    {%- when 'check' -%}
      <path d="m4.5 10.5 3.5 3.5 7.5-8"/>
    {%- when 'info' -%}
      <circle cx="10" cy="10" r="7.2"/><path d="M10 9v5M10 6.4v.2"/>
    {%- when 'arrow' -%}
      <path d="M3.5 10h13M11.5 5l5 5-5 5"/>
    {%- when 'bed' -%}
      <path d="M2.5 15.5V8.3a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v7.2"/><path d="M2.5 12.5h15"/><path d="M5.5 6.3V4.8h9v1.5"/>
    {%- when 'layers' -%}
      <path d="m10 3.5 7 3.5-7 3.5-7-3.5z"/><path d="m3 10.5 7 3.5 7-3.5M3 13.5l7 3.5 7-3.5"/>
    {%- when 'home' -%}
      <path d="m3 9.5 7-6 7 6v7.5H3z"/><path d="M8 17v-5h4v5"/>
    {%- when 'clock' -%}
      <circle cx="10" cy="10" r="7.2"/><path d="M10 5.8V10l2.8 1.8"/>
    {%- when 'heart' -%}
      <path d="M10 16.5s-6.5-4-6.5-8.3A3.4 3.4 0 0 1 10 6.3a3.4 3.4 0 0 1 6.5 1.9c0 4.3-6.5 8.3-6.5 8.3z"/>
    {%- when 'return' -%}
      <path d="M7 4.5 3.5 8l3.5 3.5"/><path d="M3.5 8h8.5a4 4 0 0 1 0 8H8"/>
    {%- when 'lock' -%}
      <rect x="4.5" y="8.5" width="11" height="8.5" rx="1.6"/><path d="M7 8.5V6.5a3 3 0 0 1 6 0v2"/>
    {%- when 'star' -%}
      <path d="m10 3 2.2 4.5 4.9.7-3.6 3.4.9 4.9L10 14.2l-4.4 2.3.9-4.9L2.9 8.2l4.9-.7z"/>
    {%- when 'whatsapp' -%}
      <path d="M3.5 16.5l1-3.3a6.8 6.8 0 1 1 2.6 2.4z"/><path d="M7.6 7.3c.2-.5.5-.5.8-.5h.4c.2 0 .3.1.4.4l.6 1.3c.1.2 0 .4-.1.5l-.4.5c-.1.1-.1.3 0 .4.6 1 1.4 1.7 2.4 2.2.2.1.3 0 .4-.1l.5-.5c.2-.2.3-.2.5-.1l1.3.6c.3.1.4.2.4.4v.4c0 .3-.1.6-.5.8-.4.3-.9.4-1.4.3a7 7 0 0 1-4.6-4.3c-.2-.6 0-1.2.3-1.6z"/>
    {%- when 'close' -%}
      <path d="m5 5 10 10M15 5 5 15"/>
    {%- when 'chevron' -%}
      <path d="m5 7.5 5 5 5-5"/>
    {%- when 'sparkle' -%}
      <path d="M10 3v4M10 13v4M3 10h4M13 10h4M5.5 5.5l2 2M12.5 12.5l2 2M14.5 5.5l-2 2M7.5 12.5l-2 2"/>
    {%- when 'drop' -%}
      <path d="M10 3s-5 5.4-5 8.6a5 5 0 0 0 10 0C15 8.4 10 3 10 3z"/>
    {%- when 'wash' -%}
      <rect x="3.5" y="3" width="13" height="14" rx="1.6"/><circle cx="10" cy="11" r="3.5"/><path d="M6.5 5.5h.2M9 5.5h.2"/>
    {%- when 'step' -%}
      <path d="M3 17h4v-4h4V9h4V5h2"/>
    {%- when 'dog' -%}
      <path d="M4 8.5 5.5 5h3l1.5 2h4.5l2 2.5-1.5 1v3.5l-1 3H6.5l-1-3V10z"/><circle cx="12.8" cy="9.3" r=".5"/>
    {%- when 'scale' -%}
      <path d="M10 3.5v13M4 7.5h12"/><path d="m4 7.5-2 5a2.2 2.2 0 0 0 4 0zM16 7.5l-2 5a2.2 2.2 0 0 0 4 0z"/>
    {%- else -%}
      <circle cx="10" cy="10" r="7"/>
  {%- endcase -%}
</svg>
