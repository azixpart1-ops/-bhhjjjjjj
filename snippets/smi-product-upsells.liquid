								{% else %}
									{{- current_product.selected_or_first_available_variant.price | json | money -}}
								{% endif %}
							{% endif %}
						</div>
					{% else %}
						<div class="smi-compare--price smi-text-price-md {% if product.selected_or_first_available_variant.compare_at_price and product.selected_or_first_available_variant.price > product.selected_or_first_available_variant.compare_at_price %}smi-d-none{% endif %}">
						</div>
						<div class="smi--price smi-text-price-lg">
							{{ 'smind.product.sold_out' | t }}
						</div>
					{% endif %}
				</div>
				{% if use_add_to_cart %}
					<div class="smi-upsells-atc-btn">
