{
  "current": {
    "logo_height": 40,
    "logo_height_mobile": 30,
    "page_text_color": "{{ settings.color_palette.foreground }}",
    "page_background_color": "{{ settings.color_palette.background }}",
    "page_width": "wide",
    "page_transition_enabled": false,
    "transition_to_main_product": false,

    "type_body_font": "dm_sans_n4",
    "type_subheading_font": "jost_n5",
    "type_heading_font": "playfair_display_n5",
    "type_accent_font": "jost_n5",

    "type_size_paragraph": "16",
    "type_line_height_paragraph": "body-loose",

    "type_font_h1": "heading",
    "type_size_h1": "64",
    "type_line_height_h1": "display-tight",
    "type_letter_spacing_h1": "heading-tight",
    "type_case_h1": "none",

    "type_font_h2": "heading",
    "type_size_h2": "44",
    "type_line_height_h2": "display-tight",
    "type_letter_spacing_h2": "heading-tight",
    "type_case_h2": "none",

    "type_font_h3": "heading",
    "type_size_h3": "30",
    "type_line_height_h3": "display-normal",
    "type_letter_spacing_h3": "heading-normal",
    "type_case_h3": "none",

    "type_font_h4": "heading",
    "type_size_h4": "22",
    "type_line_height_h4": "display-tight",

    "type_font_h5": "subheading",
    "type_size_h5": "13",
    "type_line_height_h5": "display-loose",

    "type_font_h6": "subheading",
    "type_size_h6": "12",
    "type_line_height_h6": "display-loose",

    "card_hover_effect": "none",

    "badge_position": "top-left",
    "badge_corner_radius": 2,
    "badge_sale_background_color": "#8C2F39",
    "badge_sale_text_color": "#FFFDF9",
    "badge_sold_out_background_color": "#E3DBCE",
    "badge_sold_out_text_color": "#171C22",
    "badge_text_transform": "uppercase",

    "palette_primary_button_background": "{{ settings.color_palette.foreground }}",
    "palette_primary_button_text": "{{ settings.color_palette.background }}",
    "palette_primary_button_border": "{{ settings.color_palette.foreground }}",
    "primary_button_border_width": 1,
    "button_border_radius_primary": 2,

    "palette_secondary_button_background": "rgba(0,0,0,0)",
    "palette_secondary_button_text": "{{ settings.color_palette.foreground }}",
    "palette_secondary_button_border": "{{ settings.color_palette.foreground }}",
    "secondary_button_border_width": 1,
    "button_border_radius_secondary": 2,

    "cart_type": "drawer",
    "cart_price_font": "subheading",
    "show_cart_note": false,
    "show_add_discount_code": true,
    "drawer_background_color": "{{ settings.color_palette.background }}",
    "drawer_text_color": "{{ settings.color_palette.foreground }}",
    "drawer_border_color": "{{ settings.color_palette.color2 }}",

    "icon_stroke": "default",

    "palette_input_background": "#FFFDF9",
    "palette_input_text": "{{ settings.color_palette.color1 }}",
    "palette_input_border": "{{ settings.color_palette.color2 }}",
    "input_border_width": 1,
    "inputs_border_radius": 2,

    "popover_background_color": "#FFFDF9",
    "popover_text_color": "{{ settings.color_palette.foreground }}",
    "popover_border_radius": 2,
    "popover_border_color": "{{ settings.color_palette.color2 }}",
    "popover_border_width": 1,

    "currency_code_enabled_product_pages": false,
    "currency_code_enabled_product_cards": false,
    "currency_code_enabled_cart_items": false,

    "quick_add_background": "#FFFDF9",
    "quick_add_text": "{{ settings.color_palette.foreground }}",

    "product_corner_radius": 3,
    "card_corner_radius": 3,

    "show_variant_image": false,
    "variant_swatch_width": 34,
    "variant_swatch_height": 34,
    "variant_swatch_radius": 32,
    "palette_variant_background": "#FFFDF9",
    "palette_variant_text": "{{ settings.color_palette.foreground }}",
    "palette_variant_border": "{{ settings.color_palette.color2 }}",
    "palette_selected_variant_background": "{{ settings.color_palette.foreground }}",
    "palette_selected_variant_text": "{{ settings.color_palette.background }}",
    "palette_selected_variant_border": "{{ settings.color_palette.foreground }}",
    "variant_button_border_width": 1,
    "variant_button_radius": 2,
    "variant_button_width": "equal-width-buttons",

    "cc_finance_months": 12,

    "color_palette": {
      "background": "#FAF7F2",
      "foreground": "#171C22",
      "color1": "#5B6670",
      "color2": "#E3DBCE",
      "color3": "#E3DBCE",
      "color4": "#F2ECE2"
    }
  }
