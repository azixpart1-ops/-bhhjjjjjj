{%- comment -%}
  The promises that sit directly under Add to basket.

  This is the last thing read before the click, so it answers the three
  objections that stop a bed sale: how long it takes, who carries it in, and
  what happens if it is wrong.
{%- endcomment -%}
{%- render 'cc-assets' -%}

<ul class="cc cc-pdp-usps" {{ block.shopify_attributes }}>
  {%- assign lines = block.settings.items | newline_to_br | split: '<br />' -%}
  {%- for line in lines -%}
    {%- assign clean = line | strip_newlines | strip -%}
    {%- if clean != blank -%}
      {%- assign parts = clean | split: '|' -%}
      <li>
        {%- assign icon_name = parts[1] | default: 'check' | strip -%}
                {%- render 'cc-icon', name: icon_name -%}
        <span>{{ parts[0] | strip }}</span>
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>

{% stylesheet %}
  .cc-pdp-usps {
    list-style: none; margin: 0; padding: 1.25rem 0 0; display: grid; gap: 0.85rem;
    border-top: 1px solid var(--cc-stone);
  }
  .cc-pdp-usps li {
    display: grid; grid-template-columns: auto 1fr; gap: 0.7rem; align-items: start;
    font-size: var(--cc-t-small); color: var(--cc-slate); line-height: 1.5;
    font-family: var(--cc-font-body);
  }
  .cc-pdp-usps svg { width: 18px; height: 18px; color: var(--cc-brass); flex: none; margin-top: 0.1rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "CC Promises",
  "tag": null,
  "settings": [
    {
      "type": "textarea", "id": "items", "label": "One per line",
      "info": "Add an icon after a vertical bar, e.g. Free delivery|truck. Icons: check, truck, shield, hammer, card, moon, refresh, leaf, spring, swatch, clock, lock, phone, flag-uk.",
      "default": "Made to order in our own workshop|hammer\nFree two-person delivery to your room of choice|truck\nTen-year guarantee on the frame|shield\n14-day returns on standard fabrics|refresh"
    }
  ],
  "presets": [ { "name": "CC Promises", "category": "Product" } ]
}
{% endschema %}
