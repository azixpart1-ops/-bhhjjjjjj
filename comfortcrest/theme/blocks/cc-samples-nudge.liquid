{%- comment -%}
  Fabric samples prompt, placed with the variant options.

  On an upholstered bed the colour is the decision people stall on, because a
  screen cannot show them what the cloth looks like on their own wall. Offering
  the swatch at the exact moment they are picking a finish turns a stall into
  an email address rather than a closed tab.
{%- endcomment -%}
{%- render 'cc-assets' -%}

<div class="cc cc-nudge" {{ block.shopify_attributes }}>
  <span class="cc-nudge__icon">{%- render 'cc-icon', name: 'swatch' -%}</span>
  <div class="cc-nudge__body">
    <p class="cc-nudge__text">{{ block.settings.text }}</p>
    <a class="cc-link cc-nudge__link" href="{{ block.settings.link | default: '/pages/fabric-samples' }}">
      {{ block.settings.cta }}{%- render 'cc-icon', name: 'arrow-right' -%}
    </a>
  </div>
</div>

{% stylesheet %}
  .cc-nudge {
    display: grid; grid-template-columns: auto 1fr; gap: 0.85rem; align-items: start;
    padding: 0.95rem 1.1rem; border-radius: var(--cc-radius);
    background: var(--cc-brass-wash);
  }
  .cc-nudge__icon { color: var(--cc-brass-deep); }
  .cc-nudge__icon svg { width: 19px; height: 19px; }
  .cc-nudge__text {
    margin: 0 0 0.5rem; font-size: var(--cc-t-small); color: var(--cc-ink);
    line-height: 1.5; font-family: var(--cc-font-body);
  }
  .cc-nudge__link { font-size: var(--cc-t-micro); color: var(--cc-brass-deep); }
  .cc-nudge__link::after { background: rgba(138, 101, 56, 0.3); }
{% endstylesheet %}

{% schema %}
{
  "name": "CC Samples prompt",
  "tag": null,
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Not sure about the colour? Screens never get fabric quite right." },
    { "type": "text", "id": "cta", "label": "Link text", "default": "Order free swatches" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [ { "name": "CC Samples prompt", "category": "Product" } ]
}
{% endschema %}
