{%- comment -%}
  Shared stylesheet and script for every ComfortCrest section.

  Rendered by each cc-* section rather than from layout/theme.liquid, so a
  section keeps working when it is reordered, duplicated, or dropped onto a
  template that has no other cc-* section on it. The browser fetches each URL
  once; cc-app.js guards against evaluating twice.
{%- endcomment -%}
{{ 'cc-core.css' | asset_url | stylesheet_tag }}
{{ 'cc-components.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cc-app.js' | asset_url }}" defer></script>
