{%- comment -%}
  ComfortCrest icon set.

  Usage: {% render 'cc-icon', name: 'shield' %}
  24x24 viewBox, stroke-based, inherits currentColor. Sized by the caller's
  CSS — never by width/height attributes here, so one icon can be a 15px
  ticker glyph and a 30px trust mark without a second copy.

  Decorative by default. Pass a `label` when the icon is the only thing
  carrying the meaning, and it becomes an img role with that name.
{%- endcomment -%}
{%- liquid
  assign a11y = 'aria-hidden="true" focusable="false"'
  if label != blank
    assign a11y = 'role="img" aria-label="' | append: label | append: '"'
  endif
-%}
<svg class="cc-icon cc-icon--{{ name }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" {{ a11y }}>
  {%- case name -%}
    {%- when 'shield' -%}
      <path d="M12 2.75 4.75 6v5.5c0 4.4 3 8.1 7.25 9.75 4.25-1.65 7.25-5.35 7.25-9.75V6z"/><path d="m9 12 2.25 2.25L15.5 10"/>
    {%- when 'truck' -%}
      <path d="M1.75 6.75h11.5v8.5H1.75z"/><path d="M13.25 9.75h4l3 3v2.5h-7z"/><circle cx="6.25" cy="17.75" r="1.75"/><circle cx="16.75" cy="17.75" r="1.75"/><path d="M8 17.75h7"/>
    {%- when 'crown' -%}
      <path d="M3 8.5 6.5 12 12 5l5.5 7L21 8.5l-1.75 10.75H4.75z"/><path d="M4.75 19.25h14.5"/>
    {%- when 'hammer' -%}
      <path d="m13.5 6.5 4-4 4 4-4 4z"/><path d="m11.75 8.25 4 4-8.5 8.5a2.83 2.83 0 0 1-4-4z"/>
    {%- when 'leaf' -%}
      <path d="M20.5 3.5c-9 0-14.5 3.5-14.5 10a6.5 6.5 0 0 0 6.5 6.5c6.5 0 8-5.5 8-16.5z"/><path d="M4 20.5c3-6.5 7-9.5 12-11"/>
    {%- when 'star' -%}
      <path d="m12 3 2.75 5.75 6.25.85-4.5 4.4 1.05 6.25L12 17.3 6.45 20.25 7.5 14 3 9.6l6.25-.85z" fill="currentColor" stroke="none"/>
    {%- when 'moon' -%}
      <path d="M20.5 14.25A8.5 8.5 0 0 1 9.75 3.5a8.75 8.75 0 1 0 10.75 10.75z"/>
    {%- when 'ruler' -%}
      <path d="m2.75 15.5 12.75-12.75 5.75 5.75L8.5 21.25z"/><path d="m7 11 2 2M10.25 7.75l2 2M13.5 4.5l2 2"/>
    {%- when 'box' -%}
      <path d="M3.25 7.5 12 3l8.75 4.5v9L12 21l-8.75-4.5z"/><path d="M3.25 7.5 12 12l8.75-4.5M12 12v9"/>
    {%- when 'card' -%}
      <rect x="2.75" y="5.25" width="18.5" height="13.5" rx="2"/><path d="M2.75 10.25h18.5M6.5 14.75h3"/>
    {%- when 'chat' -%}
      <path d="M20.75 12.25a7.75 7.75 0 0 1-11.35 6.87L3.25 20.75l1.63-6.15A7.75 7.75 0 1 1 20.75 12.25z"/>
    {%- when 'lock' -%}
      <rect x="4.75" y="10.25" width="14.5" height="10" rx="2"/><path d="M8.25 10.25V7a3.75 3.75 0 0 1 7.5 0v3.25"/>
    {%- when 'refresh' -%}
      <path d="M20.25 11.5a8.25 8.25 0 1 1-2.5-5.9"/><path d="M20.75 3.5v5h-5"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9.25"/><path d="M12 6.75V12l3.5 2.25"/>
    {%- when 'check' -%}
      <path d="m4.75 12.5 4.75 4.75 9.75-10.5"/>
    {%- when 'check-circle' -%}
      <circle cx="12" cy="12" r="9.25"/><path d="m8 12.25 2.75 2.75 5.25-6"/>
    {%- when 'arrow-right' -%}
      <path d="M4.75 12h14.5"/><path d="m13.5 6.25 5.75 5.75-5.75 5.75"/>
    {%- when 'chevron-down' -%}
      <path d="m5.75 9 6.25 6.25L18.25 9"/>
    {%- when 'flag-uk' -%}
      <rect x="2.75" y="5.25" width="18.5" height="13.5" rx="1.5"/><path d="M2.75 5.25 21.25 18.75M21.25 5.25 2.75 18.75M12 5.25v13.5M2.75 12h18.5"/>
    {%- when 'sparkle' -%}
      <path d="M12 3.25 13.9 9.1 19.75 11l-5.85 1.9L12 18.75 10.1 12.9 4.25 11 10.1 9.1z"/>
    {%- when 'spring' -%}
      <path d="M6 3.75h12M6 20.25h12"/><path d="M18 3.75 6 8.25l12 3.5-12 3.5 12 4.5"/>
    {%- when 'phone' -%}
      <path d="M8 3.75H5.5a2 2 0 0 0-2 2.15C4.1 13.5 10.5 19.9 18.1 20.5a2 2 0 0 0 2.15-2v-2.5l-4.25-1.5-2 2a13.5 13.5 0 0 1-4.5-4.5l2-2z"/>
    {%- when 'swatch' -%}
      <rect x="3.25" y="3.25" width="8" height="8" rx="1"/><rect x="12.75" y="3.25" width="8" height="8" rx="1"/><rect x="3.25" y="12.75" width="8" height="8" rx="1"/><rect x="12.75" y="12.75" width="8" height="8" rx="1"/>
    {%- else -%}
      <circle cx="12" cy="12" r="9.25"/>
  {%- endcase -%}
</svg>
