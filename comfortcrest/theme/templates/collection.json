{
  "sections": {
    "banner": {
      "type": "cc-collection-head",
      "settings": {
        "ground": "paper",
        "eyebrow": "ComfortCrest",
        "marks": "Made to order in our British workshop|hammer\nFree two-person delivery and assembly|truck\nTen-year guarantee on every frame|shield\n0% finance over 12 months|card"
      }
    },
    "main": {
      "type": "main-collection",
      "blocks": {
        "filters": {
          "type": "filters",
          "static": true,
          "settings": {
            "enable_filtering": true,
            "filter_style": "horizontal",
            "filter_width": "centered",
            "text_label_case": "default",
            "show_swatch_label": true,
            "show_filter_label": true,
            "enable_sorting": true,
            "enable_grid_density": true,
            "padding-block-start": 8,
            "padding-block-end": 16,
            "padding-inline-start": 0,
            "padding-inline-end": 0,
            "facets_margin_bottom": 8,
            "facets_margin_right": 20
          },
          "blocks": {}
        },
        "product-card": {
          "type": "_product-card",
          "static": true,
          "settings": {
            "product_card_gap": 6,
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "card-gallery": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "4 / 3",
                "border": "none",
                "border_width": 1,
                "border_opacity": 100,
                "border_radius": 3,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "title": {
              "type": "product-title",
              "name": "Title",
              "settings": {
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "rte",
                "font": "var(--font-heading--family)",
                "font_size": "1.0625rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 8,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "price": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "show_installments": false,
                "show_tax_info": false,
                "type_preset": "paragraph",
                "width": "100%",
                "alignment": "left",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "padding-block-start": 2,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            }
          },
          "block_order": [
            "card-gallery",
            "title",
            "price"
          ]
        }
      },
      "settings": {
        "layout_type": "grid",
        "product_card_size": "medium",
        "mobile_product_card_size": "small",
        "product_grid_width": "centered",
        "full_width_on_mobile": false,
        "columns_gap_horizontal": 20,
        "columns_gap_vertical": 36,
        "padding-inline-start": 0,
        "padding-inline-end": 0,
        "background_color": "#FAF7F2",
        "padding-block-start": 0,
        "padding-block-end": 48
      }
    },
    "finder": {
      "type": "cc-finder",
      "blocks": {
        "t1": {
          "type": "type",
          "settings": {
            "label": "Ottoman storage",
            "note": "Lifts to a full-size store",
            "collection": "ottoman-storage-beds"
          }
        },
        "t2": {
          "type": "type",
          "settings": {
            "label": "Bed frame",
            "note": "No storage",
            "collection": "bed-frames"
          }
        },
        "t3": {
          "type": "type",
          "settings": {
            "label": "Divan",
            "note": "Drawers underneath",
            "collection": "divan-beds"
          }
        },
        "t4": {
          "type": "type",
          "settings": {
            "label": "TV bed",
            "note": "Screen in the footboard",
            "collection": "tv-beds"
          }
        },
        "b1": {
          "type": "budget",
          "settings": {
            "label": "Under £700",
            "query": "filter.v.price.lte=700"
          }
        },
        "b2": {
          "type": "budget",
          "settings": {
            "label": "£700 to £1,400",
            "query": "filter.v.price.gte=700&filter.v.price.lte=1400"
          }
        },
        "b3": {
          "type": "budget",
          "settings": {
            "label": "£1,400 and up",
            "query": "filter.v.price.gte=1400"
          }
        }
      },
      "block_order": [
        "t1",
        "t2",
        "t3",
        "t4",
        "b1",
        "b2",
        "b3"
      ],
      "settings": {
        "ground": "linen",
        "eyebrow": "Narrow it down",
        "heading": "Not the right shelf?",
        "body": "<p>Tell us what you are after and we will point you at it.</p>",
        "q1": "What kind of bed?",
        "q2": "What size?",
        "sizes": "Single, Small Double, Double, King, Super King",
        "q3": "Roughly what budget?",
        "cta_text": "Show me these beds",
        "default_url": "/collections/all",
        "empty_note": "Answer as many as you like",
        "anchor": "bed-finder"
      }
    },
    "delivery": {
      "type": "cc-delivery",
      "blocks": {
        "d1": {
          "type": "step",
          "settings": {
            "when": "Day 1",
            "title": "Order confirmed",
            "text": "We confirm your size and fabric by email the same working day."
          }
        },
        "d2": {
          "type": "step",
          "settings": {
            "when": "Week 1–2",
            "title": "Made for you",
            "text": "Cut, sprung and upholstered to order in our workshop."
          }
        },
        "d3": {
          "type": "step",
          "settings": {
            "when": "Week 2",
            "title": "Slot booked",
            "text": "We call to agree a day and give you a two-hour window the night before."
          }
        },
        "d4": {
          "type": "step",
          "settings": {
            "when": "Delivery day",
            "title": "Carried in and set up",
            "text": "Two people, to your room of choice, packaging taken away."
          }
        }
      },
      "block_order": [
        "d1",
        "d2",
        "d3",
        "d4"
      ],
      "settings": {
        "ground": "paper",
        "align": "center",
        "eyebrow": "Getting it to you",
        "heading": "From our workshop to your bedroom",
        "body": "",
        "note": "Free delivery to most of mainland UK. Some Scottish highland, island and Northern Ireland postcodes carry a surcharge, shown at checkout before you pay."
      }
    }
  },
  "order": [
    "banner",
    "main",
    "finder",
    "delivery"
  ]
}
