      "settings": {
        "ground": "linen",
        "align": "left",
        "eyebrow": "Check before you order",
        "heading": "Will it fit?",
        "body": "<p>This bed is made to standard UK sizes. Measure the room, and the route into it, before you choose.</p>",
        "note": "Allow 70cm at the side you get in and out of, and check the turn at the top of your stairs. If you are unsure, send us the measurements and we will tell you.",
