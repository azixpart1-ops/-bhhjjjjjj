    "faq": {
      "type": "cc-faq",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "question": "How long will this bed take?",
            "answer": "<p>Around 14 working days from order to delivery, because it is made for you rather than picked off a shelf. We call to book a slot once your frame is finished.</p>"
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "question": "Will you build it for me?",
            "answer": "<p>Yes. Two people carry it to the room of your choice, assemble it, and take all the packaging away with them. It is included in the delivery price.</p>"
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "question": "Can I get the fabric first?",
            "answer": "<p>We post up to six swatches free, first class, with no obligation. Order them before you commit — a screen will not tell you what the cloth actually looks like in your room.</p>"
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "question": "What if it is not right?",
            "answer": "<p>Beds in our standard fabrics can be returned within 14 days of delivery under the Consumer Contracts Regulations. Tell us as soon as you can and we will arrange collection.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4"
