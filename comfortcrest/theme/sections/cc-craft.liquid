{%- comment -%}
  How the bed is made. Copy on one side, numbered build steps on the other.

  This is the section that justifies the price. It works on ink by default —
  the one dark block on the page, placed where a shopper has seen the range
  and is deciding whether it is worth the money.
{%- endcomment -%}
{%- render 'cc-assets' -%}

<section class="cc cc-section cc-ground--{{ section.settings.ground }}">
  <div class="cc-wrap cc-wrap--wide">
    <div class="cc-split{% if section.settings.reverse %} cc-split--reverse{% endif %}">
      <div class="cc-split__copy cc-reveal">
        {%- if section.settings.eyebrow != blank -%}
          <p class="cc-eyebrow cc-eyebrow--rule">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="cc-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.body != blank -%}
          <div class="cc-lede">{{ section.settings.body }}</div>
        {%- endif -%}
        {%- if section.settings.cta_text != blank -%}
          <div class="cc-actions cc-craft__cta">
            <a class="cc-btn {% if section.settings.ground == 'ink' %}cc-btn--solid-light{% else %}cc-btn--ghost{% endif %}"
               href="{{ section.settings.cta_link | default: '/pages/our-workshop' }}">{{ section.settings.cta_text }}</a>
          </div>
        {%- endif -%}
      </div>

      <div class="cc-split__media cc-reveal" style="--cc-delay:120ms">
        {%- if section.settings.image != blank -%}
          <div class="cc-media cc-media--zoom cc-craft__img">
            {{ section.settings.image | image_url: width: 1200 | image_tag:
                 loading: 'lazy', widths: '400,600,800,1200',
                 sizes: '(min-width: 901px) 46vw, 92vw',
                 alt: section.settings.image.alt | default: section.settings.heading | escape }}
          </div>
        {%- endif -%}
        <ol class="cc-steps">
          {%- for block in section.blocks -%}
            <li class="cc-steps__item" {{ block.shopify_attributes }}>
              <span class="cc-steps__num" aria-hidden="true"></span>
              <div>
                <h3 class="cc-steps__title">{{ block.settings.title }}</h3>
                <p class="cc-p">{{ block.settings.text }}</p>
              </div>
            </li>
          {%- endfor -%}
        </ol>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .cc-craft__cta { margin-top: 2rem; }
  .cc-craft__img { aspect-ratio: 3 / 2; margin-bottom: 2rem; }
  .cc-split__copy .cc-lede { margin-top: 1.35rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "CC Craft story",
  "class": "cc-section-craft",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select", "id": "ground", "label": "Background", "default": "ink",
      "options": [
        { "value": "ink", "label": "Ink" },
        { "value": "paper", "label": "Alabaster" },
        { "value": "linen", "label": "Linen" }
      ]
    },
    { "type": "checkbox", "id": "reverse", "label": "Put the steps on the left", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it is made" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four weeks of work, and a bed that outlasts the room" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>A ComfortCrest bed is not flat-packed in a factory and shipped from a warehouse. It is cut, sprung, upholstered and finished by the same small team, in the same workshop, for one order at a time.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "cta_text", "label": "Button", "default": "Inside the workshop" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "The frame" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Kiln-dried hardwood, corner-blocked and screwed rather than stapled." }
      ]
    }
  ],
  "presets": [
    {
      "name": "CC Craft story",
      "blocks": [
        { "type": "step", "settings": { "title": "The frame", "text": "Kiln-dried hardwood, corner-blocked and screwed rather than stapled. It is the part nobody sees and the reason the bed does not creak in year three." } },
        { "type": "step", "settings": { "title": "The base", "text": "Sprung slats on flexible beech, not a flat board. They take the load off the mattress and add years to it." } },
        { "type": "step", "settings": { "title": "The upholstery", "text": "High-density foam over the frame, then fabric cut, pinned and hand-finished on the piece itself. Every seam is pulled true by hand." } },
        { "type": "step", "settings": { "title": "The finish", "text": "Legs turned and stained to match, fixings bagged and labelled, and the whole bed checked over before it is wrapped." } }
      ]
    }
  ]
}
{% endschema %}
