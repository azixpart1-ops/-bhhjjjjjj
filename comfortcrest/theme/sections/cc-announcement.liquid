{%- comment -%}
  Announcement / trust ticker.

  Three short promises above the header. On a phone there is no room for
  three, so cc-app.js rotates them through one slot — the CSS decides which
  layout applies, the JS only drives the rotation.
{%- endcomment -%}
{%- render 'cc-assets' -%}

<div class="cc cc-ticker" data-cc-ticker>
  <div class="cc-wrap cc-wrap--wide">
    <div class="cc-ticker__wrap">
      {%- for block in section.blocks -%}
        <span class="cc-ticker__item{% if forloop.first %} is-on{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            {%- render 'cc-icon', name: block.settings.icon -%}
          {%- endif -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            {{ block.settings.text }}
          {%- endif -%}
        </span>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CC Announcement bar",
  "class": "cc-section-announcement",
  "max_blocks": 5,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free delivery to most of the UK" },
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "truck",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Delivery" },
            { "value": "shield", "label": "Guarantee" },
            { "value": "flag-uk", "label": "Union flag" },
            { "value": "card", "label": "Finance" },
            { "value": "star", "label": "Star" },
            { "value": "hammer", "label": "Handmade" },
            { "value": "moon", "label": "Sleep trial" },
            { "value": "phone", "label": "Phone" }
          ]
        },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CC Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Free delivery to most of the UK", "icon": "truck" } },
        { "type": "message", "settings": { "text": "Handmade in Britain", "icon": "flag-uk" } },
        { "type": "message", "settings": { "text": "0% finance available", "icon": "card" } }
      ]
    }
  ]
}
{% endschema %}
