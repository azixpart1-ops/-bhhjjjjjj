{%- comment -%}
  UK bed size guide.

  Beds get returned because someone ordered a King when their room takes a
  Double. A plain table of the five UK sizes — in both metric and imperial,
  because half the country still shops in feet — costs one section and saves
  the returns. It also earns the "uk bed sizes" search that brings people in
  before they have picked a retailer.
{%- endcomment -%}
{%- render 'cc-assets' -%}

<section class="cc cc-section cc-ground--{{ section.settings.ground }}" id="{{ section.settings.anchor | default: 'bed-sizes' }}">
  <div class="cc-wrap">
    <div class="cc-head{% if section.settings.align == 'center' %} cc-head--center{% endif %} cc-sizes__head cc-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="cc-eyebrow cc-eyebrow--rule">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="cc-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <div class="cc-lede">{{ section.settings.body }}</div>
      {%- endif -%}
    </div>

    <div class="cc-sizes cc-reveal">
      <table>
        <thead>
          <tr>
            <th scope="col">Size</th>
            <th scope="col">Metric</th>
            <th scope="col">Imperial</th>
            <th scope="col">Best for</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td>
                <span class="cc-sizes__name">{{ block.settings.name }}</span>
                {%- if block.settings.also != blank -%}
                  <span class="cc-sizes__alt">Also called {{ block.settings.also }}</span>
                {%- endif -%}
              </td>
              <td class="cc-sizes__dim">
                {{ block.settings.metric }}
                {%- if block.settings.room != blank -%}<small>Room from {{ block.settings.room }}</small>{%- endif -%}
              </td>
              <td class="cc-sizes__dim">{{ block.settings.imperial }}</td>
              <td class="cc-sizes__for">{{ block.settings.best_for }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    {%- if section.settings.note != blank or section.settings.cta_text != blank -%}
      <div class="cc-sizes__foot cc-reveal">
        {%- if section.settings.note != blank -%}
          <p class="cc-sizes__note">{%- render 'cc-icon', name: 'ruler' -%}<span>{{ section.settings.note }}</span></p>
        {%- endif -%}
        {%- if section.settings.cta_text != blank -%}
          <a class="cc-btn cc-btn--ghost cc-btn--sm" href="{{ section.settings.cta_link | default: '/collections/all' }}">{{ section.settings.cta_text }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .cc-sizes__head { margin-bottom: clamp(2rem, 1.4rem + 1.6vw, 3rem); }
  .cc-sizes__foot {
    margin-top: 1.75rem; display: flex; align-items: center; justify-content: space-between;
    gap: 1.25rem; flex-wrap: wrap;
  }
  .cc-sizes__note {
    margin: 0; display: flex; align-items: flex-start; gap: 0.6rem;
    font-size: var(--cc-t-small); color: var(--cc-slate); max-width: 52ch;
  }
  .cc-sizes__note svg { width: 18px; height: 18px; color: var(--cc-brass); flex: none; margin-top: 0.15rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "CC Size guide",
  "class": "cc-section-sizes",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select", "id": "ground", "label": "Background", "default": "paper",
      "options": [
        { "value": "paper", "label": "Alabaster" },
        { "value": "linen", "label": "Linen" },
        { "value": "cream", "label": "Cream" }
      ]
    },
    {
      "type": "select", "id": "align", "label": "Header alignment", "default": "left",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Centred" } ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Measure once" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "UK bed sizes, in plain numbers" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Every ComfortCrest bed is made to standard UK sizes, so your existing mattress and bedding will fit.</p>" },
    { "type": "text", "id": "note", "label": "Footnote", "default": "Measure your room before you order — allow 70cm at the side you get in and out of, and check the turn at the top of your stairs." },
    { "type": "text", "id": "cta_text", "label": "Button" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "bed-sizes" }
  ],
  "blocks": [
    {
      "type": "size",
      "name": "Size",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Double" },
        { "type": "text", "id": "also", "label": "Also called" },
        { "type": "text", "id": "metric", "label": "Metric", "default": "135 × 190 cm" },
        { "type": "text", "id": "imperial", "label": "Imperial", "default": "4'6\" × 6'3\"" },
        { "type": "text", "id": "room", "label": "Minimum room size" },
        { "type": "text", "id": "best_for", "label": "Best for", "default": "Two adults in an average UK bedroom" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CC Size guide",
      "blocks": [
        { "type": "size", "settings": { "name": "Single", "also": "3'0\"", "metric": "90 × 190 cm", "imperial": "3'0\" × 6'3\"", "room": "2.1 × 2.6 m", "best_for": "Children, guest rooms and box rooms" } },
        { "type": "size", "settings": { "name": "Small Double", "also": "Queen, 4'0\"", "metric": "120 × 190 cm", "imperial": "4'0\" × 6'3\"", "room": "2.4 × 2.6 m", "best_for": "One adult with room to spread out, or a snug second bedroom" } },
        { "type": "size", "settings": { "name": "Double", "also": "4'6\"", "metric": "135 × 190 cm", "imperial": "4'6\" × 6'3\"", "room": "2.6 × 2.6 m", "best_for": "Two adults in an average UK bedroom" } },
        { "type": "size", "settings": { "name": "King", "also": "5'0\"", "metric": "150 × 200 cm", "imperial": "5'0\" × 6'6\"", "room": "2.8 × 2.8 m", "best_for": "Couples who want space, and anyone over six foot" } },
        { "type": "size", "settings": { "name": "Super King", "also": "6'0\"", "metric": "180 × 200 cm", "imperial": "6'0\" × 6'6\"", "room": "3.1 × 2.8 m", "best_for": "Master bedrooms, and sleeping undisturbed beside a restless partner" } }
      ]
    }
  ]
}
{% endschema %}
