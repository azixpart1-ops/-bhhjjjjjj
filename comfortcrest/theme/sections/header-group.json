            "drawer_accordion": true,
            "drawer_accordion_expand_first": false,
            "drawer_dividers": true
          },
          "blocks": {}
        }
      },
      "settings": {
        "logo_position": "left",
        "menu_position": "center",
        "menu_row": "top",
        "show_search": true,
        "search_position": "right",
        "search_row": "top",
        "show_country": false,
        "country_selector_style": false,
        "show_language": false,
        "localization_font": "subheading",
        "localization_font_size": "0.75rem",
