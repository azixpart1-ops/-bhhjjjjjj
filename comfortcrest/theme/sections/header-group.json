{
  "type": "header",
  "name": "Header",
  "sections": {
    "cc_ticker": {
      "type": "cc-announcement",
      "blocks": {
        "m1": {
          "type": "message",
          "settings": {
            "text": "Free delivery to most of the UK",
            "icon": "truck"
          }
        },
        "m2": {
          "type": "message",
          "settings": {
            "text": "Handmade in Britain",
            "icon": "flag-uk"
          }
        },
        "m3": {
          "type": "message",
          "settings": {
            "text": "0% finance available",
            "icon": "card"
          }
        },
        "m4": {
          "type": "message",
          "settings": {
            "text": "Free fabric samples",
            "icon": "swatch",
            "link": "/pages/fabric-samples"
          }
        }
      },
      "block_order": [
        "m1",
        "m2",
        "m3",
        "m4"
      ],
      "settings": {}
    },
    "header_section": {
      "type": "header",
      "blocks": {
        "header-logo": {
          "type": "_header-logo",
          "static": true,
          "settings": {
            "hide_logo_on_home_page": false,
            "padding-block-start": 0,
            "padding-block-end": 0
          },
          "blocks": {}
        },
        "header-menu": {
          "type": "_header-menu",
          "static": true,
          "settings": {
            "menu": "main-menu",
            "type_font_primary_size": "0.8125rem",
            "menu_font_style": "inverse",
            "type_font_primary_link": "subheading",
            "type_case_primary_link": "uppercase",
            "menu_style": "featured_collections",
            "featured_products_aspect_ratio": "4 / 5",
            "featured_collections_aspect_ratio": "16 / 9",
