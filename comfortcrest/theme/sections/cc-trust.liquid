{%- comment -%}
  Trust strip. Sits directly under the hero, where the shopper's first
  objection ("is this lot legitimate?") lands. Kept to one line of promises
  with no imagery, so it reads as fact rather than marketing.
{%- endcomment -%}
{%- render 'cc-assets' -%}
{%- assign n = section.blocks.size -%}
{%- if n > 5 -%}{%- assign n = 5 -%}{%- endif -%}
{%- if n < 3 -%}{%- assign n = 3 -%}{%- endif -%}

<section class="cc cc-section cc-section--flush cc-ground--{{ section.settings.ground }}">
  <div class="cc-wrap cc-wrap--wide">
    <div class="cc-trust cc-trust--{{ n }}">
      {%- for block in section.blocks -%}
        <div class="cc-trust__item cc-reveal" style="--cc-delay:{{ forloop.index0 | times: 60 }}ms" {{ block.shopify_attributes }}>
          <span class="cc-trust__icon">{%- render 'cc-icon', name: block.settings.icon -%}</span>
          <span class="cc-trust__title">{{ block.settings.title }}</span>
          {%- if block.settings.note != blank -%}
            <span class="cc-trust__note">{{ block.settings.note }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CC Trust strip",
  "class": "cc-section-trust",
  "max_blocks": 5,
  "settings": [
    {
      "type": "select", "id": "ground", "label": "Background", "default": "paper",
      "options": [
        { "value": "paper", "label": "Alabaster" },
        { "value": "linen", "label": "Linen" },
        { "value": "cream", "label": "Cream" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Handmade in Britain" },
        { "type": "text", "id": "note", "label": "Note", "default": "Built to order in our own workshop" },
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "flag-uk",
          "options": [
            { "value": "flag-uk", "label": "Union flag" },
            { "value": "shield", "label": "Guarantee" },
            { "value": "truck", "label": "Delivery" },
            { "value": "card", "label": "Finance" },
            { "value": "hammer", "label": "Handmade" },
            { "value": "moon", "label": "Sleep trial" },
            { "value": "refresh", "label": "Returns" },
            { "value": "leaf", "label": "Sustainable" },
            { "value": "spring", "label": "Sprung base" },
            { "value": "swatch", "label": "Fabric samples" },
            { "value": "phone", "label": "Support" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CC Trust strip",
      "blocks": [
        { "type": "promise", "settings": { "title": "Handmade in Britain", "note": "Built to order in our own workshop", "icon": "flag-uk" } },
        { "type": "promise", "settings": { "title": "10-year guarantee", "note": "On every frame we make", "icon": "shield" } },
        { "type": "promise", "settings": { "title": "Free UK delivery", "note": "Two people, to your room of choice", "icon": "truck" } },
        { "type": "promise", "settings": { "title": "0% finance", "note": "Spread the cost over 12 months", "icon": "card" } },
        { "type": "promise", "settings": { "title": "Free fabric samples", "note": "Posted first class, no charge", "icon": "swatch" } }
      ]
    }
  ]
}
{% endschema %}
