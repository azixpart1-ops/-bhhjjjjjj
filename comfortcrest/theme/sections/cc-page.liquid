{%- comment -%}
  Branded page content.

  Horizon's default page template drops the body into unstyled prose, which
  makes every policy and guide page look like a different website from the
  one that sold the bed. This wraps page.content in the ComfortCrest type
  scale and gives it a proper masthead.
{%- endcomment -%}
{%- render 'cc-assets' -%}
{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = page.title
  endif
-%}

<section class="cc cc-section cc-ground--{{ section.settings.ground }}">
  <div class="cc-wrap">
    <div class="cc-pagehead cc-reveal">
      <nav class="cc-crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="{{ routes.root_url }}">Home</a></li>
          <li aria-current="page">{{ page.title | default: heading }}</li>
        </ol>
      </nav>
      {%- if section.settings.eyebrow != blank -%}
        <p class="cc-eyebrow cc-eyebrow--rule">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="cc-h1">{{ heading }}</h1>
      {%- if section.settings.lede != blank -%}
        <div class="cc-lede">{{ section.settings.lede }}</div>
      {%- endif -%}
    </div>

    <div class="cc-prose cc-reveal">
      {{ page.content }}
    </div>

    {%- if section.settings.cta_text != blank -%}
      <div class="cc-actions cc-page__cta">
        <a class="cc-btn cc-btn--brass" href="{{ section.settings.cta_link | default: '/collections/all' }}">{{ section.settings.cta_text }}</a>
        {%- if section.settings.cta2_text != blank -%}
          <a class="cc-btn cc-btn--ghost" href="{{ section.settings.cta2_link | default: '/pages/contact' }}">{{ section.settings.cta2_text }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .cc-pagehead {
    max-width: 46rem; padding-bottom: clamp(1.75rem, 1.2rem + 2vw, 3rem);
    margin-bottom: clamp(1.75rem, 1.2rem + 2vw, 3rem);
    border-bottom: 1px solid var(--cc-stone);
  }
  .cc-pagehead .cc-lede { margin-top: 1.15rem; }

  /* Long-form copy. Measure is capped so a policy page stays readable. */
  .cc-prose { max-width: 68ch; color: var(--cc-slate); font-size: var(--cc-t-body-l); line-height: 1.75; }
  .cc-prose > :first-child { margin-top: 0; }
  .cc-prose > :last-child { margin-bottom: 0; }
  .cc-prose p { margin: 0 0 1.35rem; text-wrap: pretty; }
  .cc-prose :is(h2, h3, h4) {
    font-family: var(--cc-font-display); color: var(--cc-ink); font-weight: 500;
    letter-spacing: -0.012em; text-wrap: balance;
  }
  .cc-prose h2 { font-size: var(--cc-t-h3); line-height: 1.2; margin: 2.75rem 0 1rem; }
  .cc-prose h3 { font-size: var(--cc-t-h4); line-height: 1.3; margin: 2.25rem 0 0.75rem; }
  .cc-prose h4 { font-size: 1.0625rem; margin: 1.75rem 0 0.6rem; }
  .cc-prose :is(ul, ol) { margin: 0 0 1.35rem; padding-left: 1.35rem; }
  .cc-prose li { margin-bottom: 0.6rem; }
  .cc-prose li::marker { color: var(--cc-brass); }
  .cc-prose a { color: var(--cc-brass-deep); text-decoration: underline; text-underline-offset: 2px; }
  .cc-prose a:hover { color: var(--cc-ink); }
  .cc-prose strong { color: var(--cc-ink); font-weight: 500; }
  .cc-prose blockquote {
    margin: 2rem 0; padding: 0 0 0 1.5rem; border-left: 2px solid var(--cc-brass);
    font-family: var(--cc-font-display); font-size: var(--cc-t-h4); line-height: 1.5;
    color: var(--cc-ink);
  }
  .cc-prose hr { border: 0; height: 1px; background: var(--cc-stone); margin: 2.5rem 0; }
  .cc-prose table { width: 100%; border-collapse: collapse; margin: 0 0 1.5rem; font-size: var(--cc-t-small); }
  .cc-prose th {
    text-align: left; padding: 0 1rem 0.75rem 0; border-bottom: 1px solid var(--cc-ink);
    font-family: var(--cc-font-label); font-size: var(--cc-t-micro);
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--cc-ink);
  }
  .cc-prose td { padding: 0.85rem 1rem 0.85rem 0; border-bottom: 1px solid var(--cc-stone); }
  .cc-prose img { border-radius: var(--cc-radius-lg); }
  .cc-page__cta { margin-top: 2.5rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "CC Page content",
  "class": "cc-section-page",
  "settings": [
    {
      "type": "select", "id": "ground", "label": "Background", "default": "paper",
      "options": [
        { "value": "paper", "label": "Alabaster" },
        { "value": "linen", "label": "Linen" },
        { "value": "cream", "label": "Cream" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading override", "info": "Defaults to the page title." },
    { "type": "richtext", "id": "lede", "label": "Standfirst" },
    { "type": "text", "id": "cta_text", "label": "Button" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "cta2_text", "label": "Second button" },
    { "type": "url", "id": "cta2_link", "label": "Second button link" }
  ],
  "presets": [ { "name": "CC Page content" } ]
}
{% endschema %}
