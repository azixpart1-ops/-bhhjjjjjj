{%- comment -%}
  Split feature — one product idea argued properly.

  Built for the ottoman storage pitch, which is the highest-margin category
  and the one that needs explaining: shoppers do not picture the volume under
  the bed until someone puts a number on it. The stat blocks do that.
{%- endcomment -%}
{%- render 'cc-assets' -%}

<section class="cc cc-section cc-ground--{{ section.settings.ground }}">
  <div class="cc-wrap cc-wrap--wide">
    <div class="cc-split{% if section.settings.reverse %} cc-split--reverse{% endif %}">
      <div class="cc-split__media cc-reveal">
        {%- if section.settings.image != blank -%}
          <div class="cc-media cc-media--zoom cc-feature__img">
            {{ section.settings.image | image_url: width: 1200 | image_tag:
                 loading: 'lazy', widths: '400,600,800,1200',
                 sizes: '(min-width: 901px) 46vw, 92vw',
                 alt: section.settings.image.alt | default: section.settings.heading | escape }}
          </div>
        {%- else -%}
          <div class="cc-media cc-feature__img cc-ratio" style="--cc-ar:4/3">
            <div class="cc-media__ph"><span>{{ section.settings.placeholder_label | default: section.settings.heading }}</span></div>
          </div>
        {%- endif -%}
      </div>

      <div class="cc-split__copy cc-reveal" style="--cc-delay:120ms">
        {%- if section.settings.eyebrow != blank -%}
          <p class="cc-eyebrow cc-eyebrow--rule">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="cc-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.body != blank -%}
          <div class="cc-lede">{{ section.settings.body }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="cc-feature__stats">
            {%- for block in section.blocks -%}
              <div class="cc-feature__stat" {{ block.shopify_attributes }}>
                <span class="cc-feature__figure">{{ block.settings.figure }}</span>
                <span class="cc-feature__label">{{ block.settings.label }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.cta_text != blank -%}
          <div class="cc-actions cc-feature__cta">
            <a class="cc-btn {% if section.settings.ground == 'ink' %}cc-btn--solid-light{% else %}cc-btn--ghost{% endif %}"
               href="{{ section.settings.cta_link | default: '/collections/all' }}">{{ section.settings.cta_text }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .cc-feature__img { aspect-ratio: 4 / 3; }
  .cc-feature__stats {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 1px; background: var(--cc-stone); border: 1px solid var(--cc-stone);
    border-radius: var(--cc-radius-lg); overflow: hidden; margin-top: 2rem;
  }
  .cc-ground--ink .cc-feature__stats { background: var(--cc-ink-3); border-color: var(--cc-ink-3); }
  .cc-feature__stat { background: var(--cc-alabaster); padding: 1.25rem 1rem; text-align: center; }
  .cc-ground--linen .cc-feature__stat { background: var(--cc-linen); }
  .cc-ground--cream .cc-feature__stat { background: var(--cc-cream); }
  .cc-ground--ink .cc-feature__stat { background: var(--cc-ink); }
  .cc-feature__figure {
    display: block; font-family: var(--cc-font-display); font-weight: 500;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.125rem); color: var(--cc-ink);
    line-height: 1; letter-spacing: -0.02em;
  }
  .cc-ground--ink .cc-feature__figure { color: var(--cc-cream); }
  .cc-feature__label {
    display: block; margin-top: 0.5rem; font-family: var(--cc-font-label);
    font-size: var(--cc-t-micro); letter-spacing: 0.11em; text-transform: uppercase;
    color: var(--cc-slate-light); line-height: 1.4;
  }
  .cc-feature__cta { margin-top: 2rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "CC Feature",
  "class": "cc-section-feature",
  "max_blocks": 4,
  "settings": [
    {
      "type": "select", "id": "ground", "label": "Background", "default": "linen",
      "options": [
        { "value": "paper", "label": "Alabaster" },
        { "value": "linen", "label": "Linen" },
        { "value": "cream", "label": "Cream" },
        { "value": "ink", "label": "Ink" }
      ]
    },
    { "type": "checkbox", "id": "reverse", "label": "Put the image on the right", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ottoman storage" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A wardrobe's worth of space, under the bed" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Gas struts lift the whole base on one hand, and hold it. Underneath is the full footprint of the bed — deep enough for a winter duvet, spare pillows, a suitcase and the Christmas decorations, all out of sight.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "placeholder_label", "label": "Placeholder caption", "info": "Shown in the image slot until a photograph is added." },
    { "type": "text", "id": "cta_text", "label": "Button", "default": "Shop ottoman beds" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Figure",
      "settings": [
        { "type": "text", "id": "figure", "label": "Figure", "default": "1,100 L" },
        { "type": "text", "id": "label", "label": "Label", "default": "Storage in a King" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CC Feature",
      "blocks": [
        { "type": "stat", "settings": { "figure": "1,100 L", "label": "Storage in a King" } },
        { "type": "stat", "settings": { "figure": "One hand", "label": "To lift and hold" } },
        { "type": "stat", "settings": { "figure": "80 kg", "label": "Rated gas struts" } }
      ]
    }
  ]
}
{% endschema %}
