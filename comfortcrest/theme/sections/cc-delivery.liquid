{%- comment -%}
  Delivery promise, as a timeline.

  "When will it actually arrive, and who carries it upstairs" is the last
  question before checkout on a piece of furniture this size. Answering it on
  the page, in order, removes the reason to abandon and go and ask.
{%- endcomment -%}
{%- render 'cc-assets' -%}

<section class="cc cc-section cc-ground--{{ section.settings.ground }}">
  <div class="cc-wrap cc-wrap--wide">
    <div class="cc-head{% if section.settings.align == 'center' %} cc-head--center{% endif %} cc-delivery__head cc-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="cc-eyebrow cc-eyebrow--rule">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="cc-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <div class="cc-lede{% if section.settings.align == 'center' %} cc-lede--center{% endif %}">{{ section.settings.body }}</div>
      {%- endif -%}
    </div>

    <div class="cc-timeline cc-reveal">
      {%- for block in section.blocks -%}
        <div class="cc-timeline__step" {{ block.shopify_attributes }}>
          <div class="cc-timeline__bar"><span class="cc-timeline__dot"></span></div>
          <p class="cc-timeline__when">{{ block.settings.when }}</p>
          <h3 class="cc-timeline__title">{{ block.settings.title }}</h3>
          <p class="cc-p cc-timeline__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.note != blank -%}
      <p class="cc-delivery__note">{%- render 'cc-icon', name: 'truck' -%}<span>{{ section.settings.note }}</span></p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .cc-delivery__head { margin-bottom: clamp(2.5rem, 1.6rem + 2.4vw, 4rem); }
  .cc-timeline__text { font-size: var(--cc-t-small); }
  .cc-delivery__note {
    margin: clamp(2rem, 1.4rem + 1.6vw, 3rem) 0 0; padding-top: 1.5rem;
    border-top: 1px solid var(--cc-stone);
    display: flex; align-items: flex-start; gap: 0.7rem;
    font-size: var(--cc-t-small); color: var(--cc-slate);
  }
  .cc-delivery__note svg { width: 19px; height: 19px; color: var(--cc-brass); flex: none; margin-top: 0.1rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "CC Delivery",
  "class": "cc-section-delivery",
  "max_blocks": 5,
  "settings": [
    {
      "type": "select", "id": "ground", "label": "Background", "default": "cream",
      "options": [
        { "value": "paper", "label": "Alabaster" },
        { "value": "linen", "label": "Linen" },
        { "value": "cream", "label": "Cream" },
        { "value": "ink", "label": "Ink" }
      ]
    },
    {
      "type": "select", "id": "align", "label": "Header alignment", "default": "center",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Centred" } ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Getting it to you" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From our workshop to your bedroom" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Two people, a booked slot, and the bed carried to the room you want it in.</p>" },
    { "type": "text", "id": "note", "label": "Footnote", "default": "Free delivery to most of mainland UK. Some Scottish highland, island and Northern Ireland postcodes carry a surcharge shown at checkout before you pay." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "when", "label": "When", "default": "Day 1" },
        { "type": "text", "id": "title", "label": "Title", "default": "Order confirmed" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "We confirm your fabric and size by email the same working day." }
      ]
    }
  ],
  "presets": [
    {
      "name": "CC Delivery",
      "blocks": [
        { "type": "step", "settings": { "when": "Day 1", "title": "Order confirmed", "text": "We confirm your size and fabric by email the same working day, so nothing is cut until you have checked it." } },
        { "type": "step", "settings": { "when": "Week 1–2", "title": "Made for you", "text": "Your frame is cut, sprung and upholstered to order in our workshop. Nothing sits in a warehouse waiting." } },
        { "type": "step", "settings": { "when": "Week 2", "title": "Slot booked", "text": "We call to agree a delivery day and give you a two-hour window the night before." } },
        { "type": "step", "settings": { "when": "Delivery day", "title": "Carried in and set up", "text": "Two people bring it to your room of choice, assemble it and take every scrap of packaging away with them." } }
      ]
    }
  ]
}
{% endschema %}
