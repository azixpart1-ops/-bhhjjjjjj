{%- comment -%}
  Fabric and finish range, with the free-sample offer beside it.

  Each swatch is drawn from its colour value with a woven texture laid over it
  in CSS, so the range is browsable before any photography exists — and the
  samples CTA turns the one thing you genuinely cannot show on a screen
  (how the cloth feels) into a reason to give an address.
{%- endcomment -%}
{%- render 'cc-assets' -%}

<section class="cc cc-section cc-ground--{{ section.settings.ground }}">
  <div class="cc-wrap cc-wrap--wide">
    <div class="cc-head-row">
      <div class="cc-head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="cc-eyebrow cc-eyebrow--rule">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="cc-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.body != blank -%}
          <div class="cc-lede">{{ section.settings.body }}</div>
        {%- endif -%}
      </div>
    </div>

    <div class="cc-swatch-layout">
      <div class="cc-swatches cc-reveal">
        {%- for block in section.blocks -%}
          {%- if block.settings.url != blank -%}
            <a class="cc-swatch" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
          {%- else -%}
            <div class="cc-swatch" {{ block.shopify_attributes }}>
          {%- endif -%}
            <span class="cc-swatch__chip" style="background:{{ block.settings.colour }}"></span>
            <span class="cc-swatch__name">{{ block.settings.name }}</span>
            {%- if block.settings.fabric != blank -%}
              <span class="cc-swatch__type">{{ block.settings.fabric }}</span>
            {%- endif -%}
          {%- if block.settings.url != blank -%}</a>{%- else -%}</div>{%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.sample_heading != blank -%}
        <aside class="cc-samples cc-reveal" style="--cc-delay:140ms">
          <span class="cc-samples__mark">{%- render 'cc-icon', name: 'swatch' -%}</span>
          <h3 class="cc-h3 cc-samples__title">{{ section.settings.sample_heading }}</h3>
          {%- if section.settings.sample_body != blank -%}
            <div class="cc-p">{{ section.settings.sample_body }}</div>
          {%- endif -%}
          <a class="cc-btn cc-btn--brass cc-btn--block" href="{{ section.settings.sample_link | default: '/pages/fabric-samples' }}">
            {{ section.settings.sample_cta | default: 'Order free samples' }}
          </a>
          {%- if section.settings.sample_note != blank -%}
            <p class="cc-samples__note">{{ section.settings.sample_note }}</p>
          {%- endif -%}
        </aside>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .cc-swatch-layout {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, 340px);
    gap: clamp(2rem, 1.2rem + 3vw, 4rem); align-items: start;
  }
  .cc-samples {
    background: var(--cc-cream); border: 1px solid var(--cc-stone);
    border-radius: var(--cc-radius-lg); padding: clamp(1.5rem, 1.2rem + 1.6vw, 2.25rem);
    position: sticky; top: 1.5rem;
  }
  .cc-samples__mark {
    display: grid; place-items: center; width: 42px; height: 42px;
    border: 1px solid var(--cc-brass); border-radius: 50%; color: var(--cc-brass);
    margin-bottom: 1.25rem;
  }
  .cc-samples__mark svg { width: 20px; height: 20px; }
  .cc-samples__title { margin-bottom: 0.75rem; font-size: var(--cc-t-h4); }
  .cc-samples .cc-btn { margin-top: 1.5rem; }
  .cc-samples__note {
    margin: 1rem 0 0; font-size: var(--cc-t-micro); color: var(--cc-slate-light);
    line-height: 1.6; text-align: center;
  }
  a.cc-swatch { text-decoration: none; display: block; }
  @media (max-width: 900px) {
    .cc-swatch-layout { grid-template-columns: minmax(0, 1fr); }
    .cc-samples { position: static; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CC Fabric swatches",
  "class": "cc-section-swatches",
  "max_blocks": 16,
  "settings": [
    {
      "type": "select", "id": "ground", "label": "Background", "default": "paper",
      "options": [
        { "value": "paper", "label": "Alabaster" },
        { "value": "linen", "label": "Linen" },
        { "value": "cream", "label": "Cream" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Fabrics and finishes" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose the cloth first" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Every frame is made in the fabric you pick. Colours shift under a screen — order the swatches and hold them against your walls before you decide.</p>" },
    { "type": "header", "content": "Samples panel" },
    { "type": "text", "id": "sample_heading", "label": "Heading", "default": "Free fabric samples" },
    { "type": "richtext", "id": "sample_body", "label": "Body", "default": "<p>Up to six swatches, posted first class, no charge and no obligation. Most arrive within two working days.</p>" },
    { "type": "text", "id": "sample_cta", "label": "Button", "default": "Order free samples" },
    { "type": "url", "id": "sample_link", "label": "Button link" },
    { "type": "text", "id": "sample_note", "label": "Note", "default": "No card details needed" }
  ],
  "blocks": [
    {
      "type": "swatch",
      "name": "Swatch",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Oatmeal" },
        { "type": "color", "id": "colour", "label": "Colour", "default": "#D8CDBB" },
        { "type": "text", "id": "fabric", "label": "Fabric", "default": "Soft weave" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CC Fabric swatches",
      "blocks": [
        { "type": "swatch", "settings": { "name": "Oatmeal", "colour": "#D8CDBB", "fabric": "Soft weave" } },
        { "type": "swatch", "settings": { "name": "Pebble", "colour": "#BFB8AE", "fabric": "Soft weave" } },
        { "type": "swatch", "settings": { "name": "Slate", "colour": "#6E767D", "fabric": "Soft weave" } },
        { "type": "swatch", "settings": { "name": "Charcoal", "colour": "#3B4048", "fabric": "Soft weave" } },
        { "type": "swatch", "settings": { "name": "Ivory Bouclé", "colour": "#EFE7D9", "fabric": "Bouclé" } },
        { "type": "swatch", "settings": { "name": "Almond Bouclé", "colour": "#DCCEBB", "fabric": "Bouclé" } },
        { "type": "swatch", "settings": { "name": "Moss", "colour": "#5E6B57", "fabric": "Brushed velvet" } },
        { "type": "swatch", "settings": { "name": "Petrol", "colour": "#2F4A54", "fabric": "Brushed velvet" } },
        { "type": "swatch", "settings": { "name": "Claret", "colour": "#6E2F38", "fabric": "Brushed velvet" } },
        { "type": "swatch", "settings": { "name": "Chestnut", "colour": "#7A5236", "fabric": "Grained leather" } }
      ]
    }
  ]
}
{% endschema %}
