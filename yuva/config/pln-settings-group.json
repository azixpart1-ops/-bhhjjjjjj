{
  "name": "PawLunova promises",
  "settings": [
    {
      "type": "header",
      "content": "Every store-wide claim lives here. Sections read these; nothing is hard-coded. Blank a field and the claim disappears everywhere."
    },
    {
      "type": "header",
      "content": "Where it's made"
    },
    {
      "type": "checkbox",
      "id": "pln_origin_enable",
      "label": "Show the origin line",
      "default": true
    },
    {
      "type": "text",
      "id": "pln_origin_line",
      "label": "Origin line",
      "default": "Made in Yorkshire",
      "info": "Shown in the hero sub-line, trust bar, story section, footer strip and the Organization structured data. Must be true for every product it appears next to."
    },
    {
      "type": "text",
      "id": "pln_origin_region",
      "label": "Region for structured data",
      "default": "Yorkshire"
    },
    {
      "type": "text",
      "id": "pln_origin_town",
      "label": "Town (optional)"
    },
    {
      "type": "header",
      "content": "100-night trial"
    },
    {
      "type": "checkbox",
      "id": "pln_trial_enable",
      "label": "Trial is on",
      "default": true
    },
    {
      "type": "range",
      "id": "pln_trial_nights",
      "label": "Nights",
      "min": 15,
      "max": 365,
      "step": 5,
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "pln_trial_free_collection",
      "label": "We collect returns free (UK mainland)",
      "default": true
    },
    {
      "type": "textarea",
      "id": "pln_trial_excluded",
      "label": "Not covered by the trial (one product type or tag per line)",
      "default": "Dog Houses\nPersonalised\nDog car seat"
    },
    {
      "type": "url",
      "id": "pln_trial_url",
      "label": "Trial page",
      "info": "/pages/100-night-trial"
    },
    {
      "type": "header",
      "content": "Guarantee"
    },
    {
      "type": "checkbox",
      "id": "pln_guarantee_enable",
      "label": "Foam guarantee is on",
      "default": true
    },
    {
      "type": "range",
      "id": "pln_guarantee_years",
      "label": "Years",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "text",
      "id": "pln_guarantee_short",
      "label": "Short wording",
      "default": "5-year foam guarantee"
    },
    {
      "type": "header",
      "content": "Delivery (the dates the site promises)"
    },
    {
      "type": "range",
      "id": "pln_free_delivery_threshold",
      "label": "Free UK delivery from (£)",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 40
    },
    {
      "type": "text",
      "id": "pln_standard_price",
      "label": "Standard delivery price under the threshold",
      "default": "4.99"
    },
    {
      "type": "range",
      "id": "pln_dispatch_min",
      "label": "Dispatch, working days (min)",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "pln_dispatch_max",
      "label": "Dispatch, working days (max)",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "pln_transit_min",
      "label": "Standard transit, working days (min)",
      "min": 1,
      "max": 14,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "pln_transit_max",
      "label": "Standard transit, working days (max)",
      "min": 1,
      "max": 14,
      "step": 1,
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "pln_express_enable",
      "label": "Offer express",
      "default": true
    },
    {
      "type": "text",
      "id": "pln_express_price",
      "label": "Express price",
      "default": "6.99"
    },
    {
      "type": "range",
      "id": "pln_express_min",
      "label": "Express transit (min)",
      "min": 1,
      "max": 7,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "pln_express_max",
      "label": "Express transit (max)",
      "min": 1,
      "max": 7,
      "step": 1,
      "default": 3
    },
    {
      "type": "textarea",
      "id": "pln_holidays",
      "label": "Bank holidays (YYYY-MM-DD, one per line)",
      "default": "2026-12-25\n2026-12-28\n2027-01-01\n2027-03-26\n2027-03-29\n2027-05-03\n2027-05-31\n2027-08-30\n2027-12-27\n2027-12-28"
    },
    {
      "type": "header",
      "content": "Who answers"
    },
    {
      "type": "text",
      "id": "pln_owner_name",
      "label": "Owner's first name",
      "default": "Abbas"
    },
    {
      "type": "image_picker",
      "id": "pln_owner_photo",
      "label": "Owner photo (optional)"
    },
    {
      "type": "text",
      "id": "pln_contact_email",
      "label": "Email"
    },
    {
      "type": "text",
      "id": "pln_contact_phone",
      "label": "Phone (optional)"
    },
    {
      "type": "text",
      "id": "pln_whatsapp",
      "label": "WhatsApp number, digits only (optional)"
    },
    {
      "type": "text",
      "id": "pln_contact_hours",
      "label": "Hours",
      "default": "Monday to Friday, 9am to 5pm"
    },
    {
      "type": "header",
      "content": "Vet-informed content"
    },
    {
      "type": "paragraph",
      "content": "Only switch this on with a practising vet's written consent. Their name and RCVS number then appear on vet notes and in Article structured data as the reviewer."
    },
    {
      "type": "checkbox",
      "id": "pln_vet_enable",
      "label": "Show vet attribution",
      "default": false
    },
    {
      "type": "text",
      "id": "pln_vet_name",
      "label": "Vet's name"
    },
    {
      "type": "text",
      "id": "pln_vet_rcvs",
      "label": "RCVS number"
    },
    {
      "type": "text",
      "id": "pln_vet_practice",
      "label": "Practice (optional)"
    },
    {
      "type": "image_picker",
      "id": "pln_vet_photo",
      "label": "Vet photo (optional)"
    },
    {
      "type": "header",
      "content": "Social proof (real only)"
    },
    {
      "type": "checkbox",
      "id": "pln_show_ratings",
      "label": "Show product star ratings",
      "default": false,
      "info": "Only once a reviews app holds genuine buyer reviews. Stars never show under 5 reviews."
    },
    {
      "type": "text",
      "id": "pln_store_rating",
      "label": "Store rating, e.g. 4.8 (blank hides)"
    },
    {
      "type": "text",
      "id": "pln_store_review_count",
      "label": "Store review count (blank hides)"
    },
    {
      "type": "header",
      "content": "Current offer (mirror the automatic discount exactly)"
    },
    {
      "type": "paragraph",
      "content": "The theme only describes the offer; the automatic discount in Discounts is what takes it off at checkout. Keep type, figure, minimum and end date identical to it, or the line promises something the checkout does not do."
    },
    {
      "type": "checkbox",
      "id": "pln_offer_enable",
      "label": "Offer is on",
      "default": false
    },
    {
      "type": "text",
      "id": "pln_offer_label",
      "label": "Name",
      "default": "Cosy Season Saving"
    },
    {
      "type": "select",
      "id": "pln_offer_type",
      "label": "Type",
      "options": [
        {
          "value": "amount",
          "label": "£ off orders over a minimum"
        },
        {
          "value": "percent",
          "label": "% off each product"
        }
      ],
      "default": "amount"
    },
    {
      "type": "number",
      "id": "pln_offer_percent",
      "label": "% off",
      "default": 10,
      "info": "Used when Type is % off. The product page prints the price the shopper pays for the selected size."
    },
    {
      "type": "number",
      "id": "pln_offer_amount",
      "label": "£ off",
      "default": 15,
      "info": "Used when Type is £ off."
    },
    {
      "type": "number",
      "id": "pln_offer_min",
      "label": "On orders over £ (0 means every order)",
      "default": 129
    },
    {
      "type": "text",
      "id": "pln_offer_ends",
      "label": "Ends (YYYY-MM-DD HH:MM, store time)"
    },
    {
      "type": "text",
      "id": "pln_offer_note",
      "label": "Small print",
      "default": "No code needed. Can't be combined with other discounts."
    },
    {
      "type": "header",
      "content": "Sizing"
    },
    {
      "type": "textarea",
      "id": "pln_size_hints",
      "label": "Size hints (value | label | weight | breeds)",
      "default": "XS | Extra small | Up to 5kg | Chihuahua, Yorkshire Terrier, Pomeranian\nS | Small | 5 to 10kg | Jack Russell, Dachshund, Pug, French Bulldog\nM | Medium | 10 to 25kg | Cocker, Springer, Border Collie, Staffie, Cockapoo\nL | Large | 25 to 40kg | Labrador, Retriever, Boxer, Pointer\nXL | Extra large | 40kg and over | German Shepherd, Bernese, Great Dane"
    }
  ]
}
