{%- doc -%}
  A "Media with text" hotspot of Shop the look (sections/yv-shop-the-look.liquid): a pulsing marker
  at (pos_x %, pos_y %) of the image that opens a card with a video (muted loop), an image or an icon,
  then a heading and a description. With a link the whole card is a link. On mobile the card opens
  as a bottom sheet.
{%- enddoc -%}

{%- liquid
  assign side = 'right'
  if block.settings.pos_x > 60
    assign side = 'left'
  endif

  assign card_heading = block.settings.heading
  assign card_label = 'yv.shop_the_look.show' | t: title: card_heading
  if card_heading == blank
    assign card_label = ''
  endif

  assign card_tag = 'div'
  if block.settings.link != blank
    assign card_tag = 'a'
  endif
-%}

{%- capture card -%}
  <{{ card_tag }}
    class="yv-look-media"
    {% if block.settings.link != blank %}
      href="{{ block.settings.link }}"
    {% endif %}
  >
    {%- if block.settings.video != blank -%}
      <span class="yv-look-media__media yv-look-media__media--video">
        {{
          block.settings.video
          | video_tag:
            image_size: '600x',
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            playsinline: true,
            preload: 'metadata',
            class: 'yv-look-media__video'
        }}
      </span>
    {%- elsif block.settings.image != blank -%}
      <span class="yv-look-media__media">
        {{
          block.settings.image
          | image_url: width: 600
          | image_tag:
            widths: '280, 420, 560, 600',
            sizes: '280px',
            loading: 'lazy',
            alt: block.settings.image.alt,
            class: 'yv-look-media__image'
        }}
      </span>
    {%- elsif block.settings.icon != blank and block.settings.icon != 'none' -%}
      <span
        class="yv-look-media__icon"
        aria-hidden="true"
      >
        {%- render 'yv-icon', name: block.settings.icon, size: 32 -%}
      </span>
    {%- endif -%}
    {%- if card_heading != blank -%}
      <span class="yv-look-media__heading">{{ card_heading | escape }}</span>
    {%- endif -%}
    {%- if block.settings.description != blank -%}
      <span class="yv-look-media__text rte">{{ block.settings.description }}</span>
    {%- endif -%}
  </{{ card_tag }}>
{%- endcapture -%}

{% render 'yv-hotspot',
  id: block.id,
  x: block.settings.pos_x,
  y: block.settings.pos_y,
  content: card,
  label: card_label,
  variant: 'marker',
  color: block.settings.hotspot_color,
  side: side,
  mobile_action: 'sheet',
  attributes: block.shopify_attributes
%}

