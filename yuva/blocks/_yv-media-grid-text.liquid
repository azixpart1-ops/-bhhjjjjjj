{%- doc -%}
  A text tile of the Media grid (sections/yv-media-grid.liquid): a heading, a short description and an
  optional text link over a solid colour (Yuva's black cards) or over an image with an overlay.
  Content sits at the top, middle or bottom of the tile; the tile grows its grid row when the text
  needs more room than the row's minimum height.
{%- enddoc -%}

{%- liquid
  assign columns = section.settings.columns_desktop | default: 6
  assign columns_mobile = section.settings.columns_mobile | default: 2
  assign col = block.settings.column_span | default: 1 | at_most: columns
  assign col_mobile = block.settings.column_span_mobile | default: 1 | at_most: columns_mobile
  assign row = block.settings.row_span | default: 1
  assign row_mobile = block.settings.row_span_mobile | default: 1

  assign width_desktop = col | times: 100 | divided_by: columns
  assign width_mobile = col_mobile | times: 100 | divided_by: columns_mobile
  assign sizes = '(min-width: 750px) ' | append: width_desktop | append: 'vw, ' | append: width_mobile | append: 'vw'

  assign media_loading = 'lazy'
  if section.index <= 2 or settings.yv_enable_lazyload == false
    assign media_loading = 'eager'
  endif

  assign position = block.settings.content_position | default: 'center'
  assign alignment = block.settings.text_alignment | default: 'left'
  assign heading_size = block.settings.heading_size | default: 'h5'
-%}

<div
  class="yv-media-grid-tile yv-media-grid-text yv-media-grid-text--pos-{{ position }} yv-media-grid-text--align-{{ alignment }}"
  style="--yv-mg-col: {{ col }}; --yv-mg-row-span: {{ row }}; --yv-mg-col-m: {{ col_mobile }}; --yv-mg-row-span-m: {{ row_mobile }}; --yv-mg-text-bg: {{ block.settings.background_color }}; --yv-mg-text-heading: {{ block.settings.heading_color }}; --yv-mg-text-color: {{ block.settings.text_color }};"
  data-yv-reveal
  {{ block.shopify_attributes }}
>
  <div class="yv-media-grid-tile__media yv-media-grid-text__background">
    {%- if block.settings.image != blank -%}
      {%- liquid
        assign focal = block.settings.image.presentation.focal_point | default: 'center'
        assign focal_style = 'object-position: ' | append: focal | append: ';'
      -%}
      {{
        block.settings.image
        | image_url: width: 1400
        | image_tag:
          widths: '300, 450, 600, 800, 1000, 1400',
          sizes: sizes,
          loading: media_loading,
          style: focal_style,
          alt: ''
      }}
      <span
        class="yv-overlay"
        style="--yv-overlay-color: {{ block.settings.overlay_color }}; --yv-overlay-opacity: {{ block.settings.overlay_opacity }};"
      ></span>
    {%- endif -%}
  </div>

  <div class="yv-media-grid-text__content">
    {%- if block.settings.heading != blank -%}
      <h3 class="yv-media-grid-text__heading {{ heading_size }}">{{ block.settings.heading | escape }}</h3>
    {%- endif -%}
    {%- if block.settings.description != blank -%}
      <div class="yv-media-grid-text__description rte">{{ block.settings.description }}</div>
    {%- endif -%}
    {% render 'yv-button',
      label: block.settings.button_label,
      link: block.settings.button_link,
      variant: 'link',
      text: block.settings.heading_color,
      class: 'yv-media-grid-text__button'
    %}
  </div>
</div>

{% stylesheet %}
  .yv-media-grid-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--yv-mg-pad, 15px);
    color: var(--yv-mg-text-color, #b2b1b1);
  }

  @media screen and (min-width: 1200px) {
    .yv-media-grid-tile.yv-media-grid-text {
      --yv-mg-pad: 30px;
    }
  }

  .yv-media-grid-text--pos-top {
    justify-content: flex-start;
  }

  .yv-media-grid-text--pos-bottom {
    justify-content: flex-end;
  }

  .yv-media-grid-text--align-center {
    text-align: center;
  }

  .yv-media-grid-text--align-right {
    text-align: end;
  }

  .yv-media-grid-text__background {
    background-color: var(--yv-mg-text-bg, #000);
  }

  .yv-media-grid-text__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .yv-media-grid-text--align-center .yv-media-grid-text__content {
    align-items: center;
  }

  .yv-media-grid-text--align-right .yv-media-grid-text__content {
    align-items: flex-end;
  }

  .yv-media-grid-text .yv-media-grid-text__heading {
    margin: 0;
    color: var(--yv-mg-text-heading, #fff);
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .yv-media-grid-text__description {
    font-size: var(--yv-text-base, 0.84rem);
    line-height: 1.4;
    color: inherit;
  }

  .yv-media-grid-text__button {
    margin-block-start: 4px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:yv.names.media_grid_text",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:yv.media_grid.settings.background_image",
      "info": "t:yv.media_grid.settings.background_image_info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:yv.common.settings.heading",
      "default": "Air Purifiers"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:yv.common.settings.heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:yv.common.options.h2"
        },
        {
          "value": "h3",
          "label": "t:yv.common.options.h3"
        },
        {
          "value": "h4",
          "label": "t:yv.common.options.h4"
        },
        {
          "value": "h5",
          "label": "t:yv.common.options.h5"
        },
        {
          "value": "h6",
          "label": "t:yv.common.options.h6"
        }
      ],
      "default": "h5"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:yv.common.settings.description",
      "default": "<p>Modern air purifiers for cleaner, fresher spaces every day with effortless smart performance.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:yv.common.settings.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:yv.common.settings.button_link",
      "info": "t:yv.common.settings.button_info"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:yv.media_grid.settings.content_position",
      "options": [
        {
          "value": "top",
          "label": "t:yv.common.options.top"
        },
        {
          "value": "center",
          "label": "t:yv.common.options.center"
        },
        {
          "value": "bottom",
          "label": "t:yv.common.options.bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:yv.common.settings.text_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:yv.common.options.left"
        },
        {
          "value": "center",
          "label": "t:yv.common.options.center"
        },
        {
          "value": "right",
          "label": "t:yv.common.options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:yv.common.content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:yv.common.settings.background_color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:yv.common.settings.heading_color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:yv.common.settings.text_color",
      "default": "#B2B1B1"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:yv.common.settings.overlay_color",
      "default": "#000000",
      "visible_if": "{{ block.settings.image != blank }}"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:yv.common.settings.overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 30,
      "visible_if": "{{ block.settings.image != blank }}"
    },
    {
      "type": "header",
      "content": "t:yv.media_grid.content.desktop_layout"
    },
    {
      "type": "range",
      "id": "column_span",
      "label": "t:yv.media_grid.settings.column_span",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "row_span",
      "label": "t:yv.media_grid.settings.row_span",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 1
    },
    {
      "type": "header",
      "content": "t:yv.media_grid.content.mobile_layout"
    },
    {
      "type": "range",
      "id": "column_span_mobile",
      "label": "t:yv.media_grid.settings.column_span",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "row_span_mobile",
      "label": "t:yv.media_grid.settings.row_span",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 1
    }
  ],
  "presets": [
    {
      "name": "t:yv.names.media_grid_text"
    }
  ]
}
{% endschema %}
