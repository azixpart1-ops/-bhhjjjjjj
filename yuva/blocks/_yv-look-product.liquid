{%- doc -%}
  A "Look" hotspot of Shop the look (sections/yv-shop-the-look.liquid): a pulsing marker at
  (pos_x %, pos_y %) of the image that opens a product card (shared snippet yv-hotspot). Without a
  product it renders only in the theme editor.
{%- enddoc -%}

{%- liquid
  assign look_product = block.settings.product
  assign side = 'right'
  if block.settings.pos_x > 60
    assign side = 'left'
  endif
-%}

{% render 'yv-hotspot',
  id: block.id,
  x: block.settings.pos_x,
  y: block.settings.pos_y,
  product: look_product,
  layout: block.settings.layout,
  variant: 'marker',
  color: block.settings.hotspot_color,
  side: side,
  attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "t:yv.names.look",
  "tag": null,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:settings.layout",
      "options": [
        {
          "value": "horizontal",
          "label": "t:options.horizontal"
        },
        {
          "value": "vertical",
          "label": "t:options.vertical"
        }
      ],
      "default": "horizontal"
    },
    {
      "type": "header",
      "content": "t:yv.shop_the_look.content.hotspot"
    },
    {
      "type": "range",
      "id": "pos_x",
      "label": "t:settings.x_position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "pos_y",
      "label": "t:settings.y_position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "color",
      "id": "hotspot_color",
      "label": "t:settings.color",
      "default": "#FFFFFF"
    }
  ]
}
{% endschema %}
