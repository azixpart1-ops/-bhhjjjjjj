{%- doc -%}
  Yuva "Mega menu with products & gallery": two collections (title + top four products as rows)
  beside two linked image tiles.
  Matched to a first-level menu item by its "Menu label" (case-insensitive) and rendered into that
  item by blocks/_header-menu.liquid (snippets/yv-mega-menu.liquid). This file only outputs a hidden
  marker so the theme editor can select the block (assets/yv-header.js opens the matching item).
{%- enddoc -%}

<div
  class="yv-header-block-marker"
  data-yv-menu-label="{{ block.settings.menu_label | strip | downcase | escape }}"
  data-yv-block-kind="mega"
  {{ block.shopify_attributes }}
></div>

{% schema %}
{
  "name": "t:yv.names.mega_menu_products_gallery",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "menu_label",
      "label": "t:yv.header.settings.menu_label",
      "info": "t:yv.header.settings.menu_label_info"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "t:yv.header.settings.collection_1"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "t:yv.header.settings.collection_2"
    },
    {
      "type": "header",
      "content": "t:yv.header.content.content_1"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "t:yv.common.settings.image",
      "info": "t:yv.header.settings.gallery_image_info"
    },
    {
      "type": "text",
      "id": "heading_1",
      "label": "t:yv.common.settings.heading"
    },
    {
      "type": "text",
      "id": "subheading_1",
      "label": "t:yv.common.settings.subheading"
    },
    {
      "type": "url",
      "id": "link_1",
      "label": "t:yv.common.settings.link"
    },
    {
      "type": "header",
      "content": "t:yv.header.content.content_2"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "t:yv.common.settings.image",
      "info": "t:yv.header.settings.gallery_image_info"
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "t:yv.common.settings.heading"
    },
    {
      "type": "text",
      "id": "subheading_2",
      "label": "t:yv.common.settings.subheading"
    },
    {
      "type": "url",
      "id": "link_2",
      "label": "t:yv.common.settings.link"
    }
  ],
  "presets": [
    {
      "name": "t:yv.names.mega_menu_products_gallery",
      "settings": {
        "menu_label": "Catalog"
      }
    }
  ]
}
{% endschema %}
