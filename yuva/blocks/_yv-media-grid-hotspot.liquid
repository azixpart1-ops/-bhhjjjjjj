{%- doc -%}
  A shoppable hotspot on a Media grid image tile (blocks/_yv-media-grid-media.liquid): a pulsing
  18px ring placed by x/y % of the tile (separate positions below 750px). On desktop, hovering or
  clicking it opens a small product card beside the dot ("View product" opens quick view); on phones
  a tap opens the product's quick view directly. The dot colour comes from the section.
  Without a product it shows a placeholder card, on desktop pointers only outside the theme editor.
{%- enddoc -%}

{%- liquid
  assign pos_x = block.settings.pos_x | default: 50
  assign pos_y = block.settings.pos_y | default: 50
  assign pos_x_mobile = block.settings.pos_x_mobile | default: pos_x
  assign pos_y_mobile = block.settings.pos_y_mobile | default: pos_y
  assign hotspot_color = section.settings.hotspot_color | default: '#ffffff'
-%}

{% render 'yv-hotspot',
  id: block.id,
  x: pos_x,
  y: pos_y,
  x_mobile: pos_x_mobile,
  y_mobile: pos_y_mobile,
  product: block.settings.product,
  variant: 'ring',
  color: hotspot_color,
  side: block.settings.card_side,
  attributes: block.shopify_attributes,
  class: 'yv-media-grid-hotspot'
%}

{% schema %}
{
  "name": "t:yv.names.media_grid_hotspot",
  "tag": null,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:yv.common.settings.product"
    },
    {
      "type": "select",
      "id": "card_side",
      "label": "t:yv.media_grid.settings.card_side",
      "options": [
        {
          "value": "right",
          "label": "t:yv.common.options.right"
        },
        {
          "value": "left",
          "label": "t:yv.common.options.left"
        }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "t:yv.common.content.desktop"
    },
    {
      "type": "range",
      "id": "pos_x",
      "label": "t:yv.media_grid.settings.pos_x",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "pos_y",
      "label": "t:yv.media_grid.settings.pos_y",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "t:yv.common.content.mobile"
    },
    {
      "type": "range",
      "id": "pos_x_mobile",
      "label": "t:yv.media_grid.settings.pos_x",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "pos_y_mobile",
      "label": "t:yv.media_grid.settings.pos_y",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "t:yv.names.media_grid_hotspot"
    }
  ]
}
{% endschema %}
