{%- doc -%}
  Yuva "Mega menu with tabs": collections as vertical tabs (left) switching a product grid
  (right), with a "Browse all products" bar.
  Matched to a first-level menu item by its "Menu label" (case-insensitive) and rendered into that
  item by blocks/_header-menu.liquid (snippets/yv-mega-menu.liquid). This file only outputs a hidden
  marker so the theme editor can select the block (assets/yv-header.js opens the matching item).
{%- enddoc -%}

<div
  class="yv-header-block-marker"
  data-yv-menu-label="{{ block.settings.menu_label | strip | downcase | escape }}"
  data-yv-block-kind="mega"
  {{ block.shopify_attributes }}
></div>

{% schema %}
{
  "name": "t:yv.names.mega_menu_tabs",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "menu_label",
      "label": "t:yv.header.settings.menu_label",
      "info": "t:yv.header.settings.menu_label_info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:yv.header.settings.tabs_heading",
      "default": "t:yv.header.defaults.tabs_heading"
    },
    {
      "type": "text",
      "id": "products_heading",
      "label": "t:yv.header.settings.products_heading",
      "default": "t:yv.header.defaults.products_heading"
    },
    {
      "type": "range",
      "id": "product_count",
      "label": "t:yv.header.settings.product_count",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 10
    },
    {
      "type": "header",
      "content": "t:yv.header.content.collections"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "t:yv.header.settings.collection_1"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "t:yv.header.settings.collection_2"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "t:yv.header.settings.collection_3"
    },
    {
      "type": "collection",
      "id": "collection_4",
      "label": "t:yv.header.settings.collection_4"
    },
    {
      "type": "collection",
      "id": "collection_5",
      "label": "t:yv.header.settings.collection_5"
    },
    {
      "type": "collection",
      "id": "collection_6",
      "label": "t:yv.header.settings.collection_6"
    },
    {
      "type": "header",
      "content": "t:yv.header.content.browse_bar"
    },
    {
      "type": "text",
      "id": "browse_label",
      "label": "t:yv.common.settings.text",
      "default": "t:yv.header.defaults.browse_label"
    },
    {
      "type": "url",
      "id": "browse_link",
      "label": "t:yv.common.settings.link",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "t:yv.names.mega_menu_tabs",
      "settings": {
        "menu_label": "Shop"
      }
    }
  ]
}
{% endschema %}
