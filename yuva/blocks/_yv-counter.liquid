{%- doc -%}
  One statistic of the Promotional banner (sections/yv-promotional-banner.liquid): a large number that
  counts up from 0 once when it scrolls into view (`<yv-counter>`, assets/yv-counter.js, loaded by the
  section), a unit set beside it at 70% size ("K+", "%"), an uppercase heading and a short description.
  The final number is in the markup, so it reads correctly without JavaScript, for assistive tech and
  under reduced motion. Items are divided by hairlines (vertical from 750px, horizontal on phones).
{%- enddoc -%}

{%- liquid
  assign counter_number = block.settings.number | default: 0 | at_least: 0 | round
  assign counter_unit = block.settings.unit | strip
  assign counter_text = counter_number | append: counter_unit

  assign counter_index = 0
  for item in section.blocks
    if item.id == block.id
      assign counter_index = forloop.index0
      break
    endif
  endfor
  assign reveal_delay = counter_index | times: 100 | at_most: 1000
-%}

<div
  class="yv-counter-item"
  data-yv-reveal
  style="--yv-reveal-delay: {{ reveal_delay }}ms;"
  {{ block.shopify_attributes }}
>
  <div class="yv-counter-item__inner">
    <p class="yv-counter-item__number">
      <yv-counter
        class="yv-counter yv-counter-item__value-wrap"
        data-to="{{ counter_number }}"
        data-duration="2000"
      >
        <span
          class="yv-counter__value yv-counter-item__value"
          ref="value"
          aria-hidden="true"
        >
          {{- counter_number -}}
        </span>
        <span class="visually-hidden">{{ counter_text | escape }}</span>
      </yv-counter>
      {%- if counter_unit != blank -%}
        <span
          class="yv-counter-item__unit"
          aria-hidden="true"
        >
          {{- counter_unit | escape -}}
        </span>
      {%- endif -%}
    </p>
    {%- if block.settings.heading != blank -%}
      <p class="yv-counter-item__heading h6">{{ block.settings.heading | escape }}</p>
    {%- endif -%}
    {%- if block.settings.description != blank -%}
      <p class="yv-counter-item__text">{{ block.settings.description | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .yv-counter-item {
    display: flex;
    justify-content: center;
    min-width: 0;
    padding: 20px;
    text-align: center;
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10, 0.1));
  }

  .yv-counter-item:last-child {
    border-block-end: 0;
  }

  @media screen and (min-width: 750px) {
    .yv-counter-item {
      border-block-end: 0;
      border-inline-end: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10, 0.1));
    }

    .yv-counter-item:last-child {
      border-inline-end: 0;
    }
  }

  .yv-counter-item__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: 100%;
    max-width: 98%;
    min-width: 0;
  }

  @media screen and (min-width: 750px) {
    .yv-counter-item__inner {
      max-width: 90%;
    }
  }

  @media screen and (min-width: 1200px) {
    .yv-counter-item__inner {
      max-width: 80%;
    }
  }

  .yv-counter-item__number {
    --_size: calc(var(--yv-promotional-banner-number-size, 80px) * 0.625);

    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: var(--_size);
    line-height: 1.1;
    letter-spacing: var(--font-h1--letter-spacing, -0.025em);
    color: var(--yv-heading-color, var(--color-foreground));
    font-variant-numeric: tabular-nums;
  }

  @media screen and (min-width: 750px) {
    .yv-counter-item__number {
      --_size: calc(var(--yv-promotional-banner-number-size, 80px) * 0.875);
    }
  }

  @media screen and (min-width: 1200px) {
    .yv-counter-item__number {
      --_size: var(--yv-promotional-banner-number-size, 80px);
    }
  }

  .yv-counter-item__unit {
    font-size: 0.7em;
    line-height: 1;
  }

  .yv-counter-item .yv-counter-item__heading {
    margin: 0;
    text-transform: uppercase;
  }

  .yv-counter-item__text {
    margin: 0;
    max-width: 280px;
    font-size: var(--yv-text-base, 0.84rem);
    line-height: var(--line-height--body-normal, 1.4);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:yv.names.promotional_counter",
  "tag": null,
  "settings": [
    {
      "type": "number",
      "id": "number",
      "label": "t:yv.promotional_banner.settings.number",
      "info": "t:yv.promotional_banner.settings.number_info",
      "default": 50
    },
    {
      "type": "text",
      "id": "unit",
      "label": "t:yv.promotional_banner.settings.unit",
      "default": "K+"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:yv.common.settings.heading",
      "default": "Happy customers"
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:yv.common.settings.description",
      "info": "t:yv.promotional_banner.settings.counter_description_info",
      "default": "Trusted by thousands of satisfied shoppers."
    }
  ],
  "presets": [
    {
      "name": "t:yv.names.promotional_counter"
    }
  ]
}
{% endschema %}
