{%- doc -%}
  An image or video tile of the Media grid (sections/yv-media-grid.liquid). The media fills the tile
  (cover); the tile spans the chosen number of columns and rows, separately on desktop and mobile.
  Child blocks `_yv-media-grid-hotspot` place shoppable hotspots over it.

  Video: a Shopify-hosted video either plays as a muted loop (assets/yv-autoplay-video.js, paused
  off screen, poster only under reduced motion) or shows a play button that starts it inline with
  sound (Horizon `video` snippet / deferred-media). The tile links only when a link is set and the
  video does not need its own play button.
{%- enddoc -%}

{%- liquid
  assign columns = section.settings.columns_desktop | default: 6
  assign columns_mobile = section.settings.columns_mobile | default: 2
  assign col = block.settings.column_span | default: 1 | at_most: columns
  assign col_mobile = block.settings.column_span_mobile | default: 1 | at_most: columns_mobile
  assign row = block.settings.row_span | default: 1
  assign row_mobile = block.settings.row_span_mobile | default: 1

  assign width_desktop = col | times: 100 | divided_by: columns
  assign width_mobile = col_mobile | times: 100 | divided_by: columns_mobile
  assign px_desktop = width_desktop | times: 13
  assign sizes = '(min-width: 1440px) ' | append: px_desktop | append: 'px, (min-width: 750px) ' | append: width_desktop | append: 'vw, ' | append: width_mobile | append: 'vw'

  assign media_loading = 'lazy'
  if section.index <= 2 or settings.yv_enable_lazyload == false
    assign media_loading = 'eager'
  endif

  assign image = block.settings.image
  assign mobile_image = block.settings.mobile_image
  assign video = block.settings.video
  assign autoplay = block.settings.video_autoplay

  assign media_tag = 'div'
  if block.settings.link != blank
    assign media_tag = 'a'
    if video != blank and autoplay == false
      assign media_tag = 'div'
    endif
  endif

  assign placeholder_index = 1
  for item in section.blocks
    if item.id == block.id
      assign placeholder_index = forloop.index0 | modulo: 2 | plus: 1
      break
    endif
  endfor
  assign placeholder_name = 'lifestyle-' | append: placeholder_index
-%}

<div
  class="yv-media-grid-tile yv-media-grid-media"
  style="--yv-mg-col: {{ col }}; --yv-mg-row-span: {{ row }}; --yv-mg-col-m: {{ col_mobile }}; --yv-mg-row-span-m: {{ row_mobile }};"
  data-yv-reveal
  {{ block.shopify_attributes }}
>
  <{{ media_tag }}
    class="yv-media-grid-tile__media"
    {% if media_tag == 'a' %}
      href="{{ block.settings.link }}"
    {% endif %}
  >
    {%- if video != blank -%}
      {%- assign poster = image | default: video.preview_image -%}
      {%- if autoplay -%}
        <yv-autoplay-video-component class="yv-media-grid__video">
          <video
            ref="video"
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
            {% if poster != blank %}
              poster="{{ poster | image_url: width: 1400 }}"
            {% endif %}
          >
            {%- for source in video.sources -%}
              <source
                data-src="{{ source.url }}"
                type="{{ source.mime_type }}"
              >
            {%- endfor -%}
          </video>
        </yv-autoplay-video-component>
      {%- else -%}
        {% render 'video',
          video: video,
          video_autoplay: false,
          video_loop: true,
          video_preview_image: poster,
          video_class: 'yv-media-grid__player',
          sizes: sizes,
          widths: '300, 450, 600, 800, 1000, 1400',
          loading: media_loading
        %}
      {%- endif -%}
    {%- elsif image != blank -%}
      <picture>
        {%- if mobile_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_image | image_url: width: 300 }} 300w,
              {{ mobile_image | image_url: width: 450 }} 450w,
              {{ mobile_image | image_url: width: 600 }} 600w,
              {{ mobile_image | image_url: width: 800 }} 800w
            "
            sizes="{{ width_mobile }}vw"
            width="{{ mobile_image.width }}"
            height="{{ mobile_image.height }}"
          >
        {%- endif -%}
        {%- liquid
          assign focal = image.presentation.focal_point | default: 'center'
          assign focal_style = 'object-position: ' | append: focal | append: ';'
        -%}
        {{
          image
          | image_url: width: 1400
          | image_tag:
            widths: '300, 450, 600, 800, 1000, 1400',
            sizes: sizes,
            loading: media_loading,
            alt: image.alt,
            style: focal_style,
            class: 'yv-media-grid-media__image'
        }}
      </picture>
    {%- else -%}
      {{ placeholder_name | placeholder_svg_tag: 'yv-media-grid-media__image yv-placeholder' }}
    {%- endif -%}
  </{{ media_tag }}>
  <div class="yv-media-grid-media__spots">
    {%- content_for 'blocks' -%}
  </div>
</div>

{% stylesheet %}
  /* Hotspots sit over the media but outside the (possibly linked, clipped) media box, so their cards can overflow the tile. */
  .yv-media-grid-media__spots {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .yv-media-grid-media__spots > * {
    pointer-events: auto;
  }

{% endstylesheet %}

{% schema %}
{
  "name": "t:yv.names.media_grid_media",
  "tag": null,
  "blocks": [
    {
      "type": "_yv-media-grid-hotspot"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:yv.common.settings.image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:yv.common.settings.mobile_image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:yv.media_grid.settings.video",
      "info": "t:yv.media_grid.settings.video_info"
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "t:yv.media_grid.settings.video_autoplay",
      "info": "t:yv.media_grid.settings.video_autoplay_info",
      "default": true
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:yv.common.settings.link"
    },
    {
      "type": "header",
      "content": "t:yv.media_grid.content.desktop_layout"
    },
    {
      "type": "range",
      "id": "column_span",
      "label": "t:yv.media_grid.settings.column_span",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "row_span",
      "label": "t:yv.media_grid.settings.row_span",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "t:yv.media_grid.content.mobile_layout"
    },
    {
      "type": "range",
      "id": "column_span_mobile",
      "label": "t:yv.media_grid.settings.column_span",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "row_span_mobile",
      "label": "t:yv.media_grid.settings.row_span",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 1
    }
  ],
  "presets": [
    {
      "name": "t:yv.names.media_grid_media"
    }
  ]
}
{% endschema %}
