{%- doc -%}
  One item of the Gallery carousel (sections/yv-gallery-carousel.liquid): an image box (or an
  original line icon when no image is set) with a heading and an optional bold subheading under it.
  When a link is set the whole item is one link named by the heading.
  The box shape, size, fit, background and hover come from the section settings.
{%- enddoc -%}

{%- liquid
  assign image = block.settings.image
  assign link = block.settings.link
  assign heading = block.settings.heading
  assign image_style = section.settings.image_style | default: 'square'
  assign image_size = section.settings.image_size | default: 'medium'
  assign contain = section.settings.actual_size
  if image_style == 'no_crop'
    assign contain = true
  endif

  case image_size
    when 'large'
      assign sizes = '(min-width: 750px) 350px, 245px'
    when 'medium'
      assign sizes = '(min-width: 750px) 300px, 210px'
    when 'small'
      assign sizes = '(min-width: 750px) 200px, 175px'
    else
      assign sizes = '(min-width: 750px) 170px, 130px'
  endcase

  assign image_loading = 'lazy'
  if section.index <= 2 or settings.yv_enable_lazyload == false
    assign image_loading = 'eager'
  endif

  assign placeholder_index = 1
  for item in section.blocks
    if item.id == block.id
      assign placeholder_index = forloop.index0 | modulo: 6 | plus: 1
      break
    endif
  endfor
  assign placeholder_name = 'collection-' | append: placeholder_index

  assign item_tag = 'div'
  if link != blank
    assign item_tag = 'a'
  endif

  assign box_class = 'yv-gallery-item__box'
  if image == blank and block.settings.icon != 'none'
    assign box_class = box_class | append: ' yv-gallery-item__box--icon'
  endif
  if contain
    assign box_class = box_class | append: ' yv-gallery-item__box--contain'
  endif
-%}

<div
  class="yv-gallery-item"
  {{ block.shopify_attributes }}
>
  <{{ item_tag }}
    class="yv-gallery-item__link"
    {% if link != blank %}
      href="{{ link }}"
      {% if heading != blank %}
        aria-label="{{ heading | escape }}"
      {% endif %}
    {% endif %}
  >
    <span class="{{ box_class }}">
      {%- if image != blank -%}
        {%- liquid
          comment
            The heading is shown as text next to the image (and names the link), so the image is
            decorative then.
          endcomment
          assign image_alt = image.alt
          if heading != blank
            assign image_alt = ''
          endif
          assign focal = image.presentation.focal_point | default: 'center'
          assign intrinsic_style = 'object-position: ' | append: focal | append: ';'
          if section.settings.actual_size
            assign intrinsic_style = intrinsic_style | append: ' max-width: min(100%, ' | append: image.width | append: 'px);'
          endif
        -%}
        {{
          image
          | image_url: width: 700
          | image_tag:
            widths: '150, 200, 300, 400, 500, 600, 700',
            sizes: sizes,
            loading: image_loading,
            alt: image_alt,
            class: 'yv-gallery-item__image',
            style: intrinsic_style
        }}
      {%- elsif block.settings.icon != 'none' -%}
        {% render 'yv-gallery-icon', name: block.settings.icon, size: 40, class: 'yv-gallery-item__icon' %}
      {%- else -%}
        {{ placeholder_name | placeholder_svg_tag: 'yv-gallery-item__image yv-placeholder' }}
      {%- endif -%}
    </span>
    {%- if heading != blank or block.settings.subheading != blank -%}
      <span class="yv-gallery-item__text">
        {%- if heading != blank -%}
          <span class="yv-gallery-item__heading">{{ heading | escape }}</span>
        {%- endif -%}
        {%- if block.settings.subheading != blank -%}
          <span class="yv-gallery-item__subheading">{{ block.settings.subheading | escape }}</span>
        {%- endif -%}
      </span>
    {%- endif -%}
  </{{ item_tag }}>
</div>

