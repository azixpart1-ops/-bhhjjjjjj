{%- doc -%}
  One square tile of the Social media gallery (sections/yv-social-media-gallery.liquid): an image or a
  muted looping video (the image is its poster), with a hover/focus overlay showing the section's
  social icon and the tile's caption. With a link the tile opens the post in a new tab.
{%- enddoc -%}

{%- liquid
  assign link = block.settings.link
  assign caption = block.settings.heading
  assign video = block.settings.video
  assign media_icon = section.settings.media_icon | default: 'instagram'

  assign tile_tag = 'div'
  if link != blank
    assign tile_tag = 'a'
  endif

  assign position = 1
  for item in section.blocks
    if item.id == block.id
      assign position = forloop.index
      break
    endif
  endfor
  assign placeholder_index = position | modulo: 2 | plus: 1
  assign placeholder_name = 'lifestyle-' | append: placeholder_index
  assign reveal_delay = position | minus: 1 | times: 50

  assign image_loading = 'lazy'
  if settings.yv_enable_lazyload == false
    assign image_loading = 'eager'
  endif

  assign link_label = caption
  if link_label == blank
    assign link_label = 'yv.social_gallery.view_post' | t
  endif

  comment
    A linked tile is named by its aria-label, so its image is decorative; otherwise the image
    carries the caption.
  endcomment
  assign image_alt = ''
  if link == blank
    assign image_alt = block.settings.image.alt | default: caption | strip_html
  endif
-%}

<div
  class="yv-social-item"
  style="--yv-reveal-delay: {{ reveal_delay }}ms;"
  data-yv-reveal
  {{ block.shopify_attributes }}
>
  <{{ tile_tag }}
    class="yv-social-item__tile"
    {% if link != blank %}
      href="{{ link }}"
      target="_blank"
      rel="noopener"
      aria-label="{{ link_label | escape }} ({{ 'yv.common.opens_new_window' | t | escape }})"
    {% endif %}
  >
    {%- if video != blank -%}
      {%- assign poster = block.settings.image | default: video.preview_image -%}
      <yv-autoplay-video-component class="yv-social-item__video">
        <video
          ref="video"
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
          {% if poster != blank %}
            poster="{{ poster | image_url: width: 600 }}"
          {% endif %}
        >
          {%- for source in video.sources -%}
            <source
              data-src="{{ source.url }}"
              type="{{ source.mime_type }}"
            >
          {%- endfor -%}
        </video>
      </yv-autoplay-video-component>
    {%- elsif block.settings.image != blank -%}
      {{
        block.settings.image
        | image_url: width: 800
        | image_tag:
          widths: '200, 300, 400, 500, 600, 800',
          sizes: '(min-width: 990px) 16vw, (min-width: 750px) 33vw, 50vw',
          loading: image_loading,
          alt: image_alt,
          class: 'yv-social-item__image'
      }}
    {%- else -%}
      {{ placeholder_name | placeholder_svg_tag: 'yv-social-item__image yv-placeholder' }}
    {%- endif -%}
    <span
      class="yv-social-item__overlay"
      aria-hidden="true"
    >
      <span class="yv-social-item__icon">
        {%- render 'yv-icon', name: media_icon, size: 40 -%}
      </span>
      {%- if caption != blank -%}
        <span class="yv-social-item__caption">{{ caption | escape }}</span>
      {%- endif -%}
    </span>
  </{{ tile_tag }}>
</div>

{% stylesheet %}
  .yv-social-item {
    min-width: 0;
  }

  .yv-social-item__tile {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    background-color: var(--yv-image-bg);
    border-radius: var(--yv-layout-radius, 10px);
  }

  .yv-social-item__tile > :is(img, svg),
  .yv-social-item__video,
  .yv-social-item__video video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .yv-social-item__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px;
    color: var(--yv-social-gallery-overlay-text, #fff);
    text-align: center;
    opacity: 0;
    pointer-events: none;
  }

  .yv-social-item__overlay::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--yv-social-gallery-overlay, #000);
    opacity: var(--yv-social-gallery-overlay-opacity, 0.5);
  }

  .yv-social-item__icon,
  .yv-social-item__caption {
    position: relative;
  }

  .yv-social-item__icon {
    display: flex;
    width: 40px;
    height: 40px;
  }

  .yv-social-item__icon svg {
    width: 100%;
    height: 100%;
  }

  .yv-social-item__caption {
    font-size: var(--yv-text-md, 0.84rem);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  @media (hover: hover) {
    .yv-social-item__tile:hover .yv-social-item__overlay {
      opacity: 1;
    }
  }

  .yv-social-item__tile:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .yv-social-item__tile:focus-visible .yv-social-item__overlay {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .yv-social-item__overlay {
      transition: opacity 0.3s linear;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:yv.names.social_item",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:yv.common.settings.image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:yv.media_grid.settings.video",
      "info": "t:yv.social_gallery.settings.video_info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:yv.common.settings.heading",
      "info": "t:yv.social_gallery.settings.heading_info"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:yv.common.settings.link"
    }
  ],
  "presets": [
    {
      "name": "t:yv.names.social_item"
    }
  ]
}
{% endschema %}
