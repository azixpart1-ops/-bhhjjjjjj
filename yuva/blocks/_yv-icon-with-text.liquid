{% doc %}
  Yuva "Icon with text" row: a line icon on the left, a short title and a description to its
  right. Used in the content column of Image with text (and any Yuva section that lists it).
  Renders nothing when the title and the description are both blank (an empty, selectable
  row in the theme editor).

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{%- liquid
  assign has_content = false
  if block.settings.heading != blank or block.settings.description != blank
    assign has_content = true
  endif
  assign icon_name = block.settings.icon | replace: '_', '-'
-%}

{%- if has_content or request.design_mode -%}
  <div
    class="yv-icon-with-text{% unless has_content %} yv-icon-with-text--empty{% endunless %}"
    {{ block.shopify_attributes }}
  >
    {%- if block.settings.icon != 'none' -%}
      <span class="yv-icon-with-text__icon">
        {%- if block.settings.icon == 'thumbs_up' -%}
          <svg
            class="yv-icon yv-icon--thumbs-up"
            viewBox="0 0 24 24"
            width="40"
            height="40"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M3.5 10.5h3v9.5h-3z"/>
            <path d="M6.5 11.2 10 4.6c.3-.6 1-.9 1.6-.7 1 .3 1.6 1.4 1.3 2.4l-.9 3.4h5.6c1.3 0 2.3 1.2 2 2.5l-1.4 6.2c-.2 1-1.1 1.6-2.1 1.6H6.5"/>
          </svg>
        {%- else -%}
          {% render 'yv-icon', name: icon_name, size: 40, stroke: 1 %}
        {%- endif -%}
      </span>
    {%- endif -%}
    <div class="yv-icon-with-text__body">
      {%- if block.settings.heading != blank -%}
        <p class="yv-icon-with-text__title">{{ block.settings.heading | escape }}</p>
      {%- endif -%}
      {%- if block.settings.description != blank -%}
        <div class="yv-icon-with-text__text rte">{{ block.settings.description }}</div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .yv-icon-with-text {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    min-width: 0;
    width: 100%;
  }

  .yv-icon-with-text--empty {
    min-height: 40px;
  }

  .yv-icon-with-text__icon {
    display: inline-flex;
    flex: none;
    width: 40px;
    height: 40px;
    color: var(--yv-icon-with-text-icon-color, currentColor);
  }

  /* The line icons leave about 3 of their 24 units as air around the drawing; draw the svg 1.3× and
     pull it back by the same amount, so the glyph itself fills the 40px (30px) icon box as in Yuva. */
  .yv-icon-with-text__icon svg {
    flex: none;
    width: 130%;
    max-width: none;
    height: 130%;
    margin: -15%;
  }

  .yv-icon-with-text__body {
    flex: 1 1 auto;
    min-width: 0;
  }

  .yv-icon-with-text__title {
    margin: 0 0 10px;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: var(--yv-text-xl, 17.28px);
    line-height: 1.1;
    letter-spacing: var(--font-h6--letter-spacing, -0.025em);
    color: var(--yv-heading-color, currentColor);
    overflow-wrap: anywhere;
  }

  .yv-icon-with-text__title:last-child {
    margin-block-end: 0;
  }

  .yv-icon-with-text__text {
    font-size: var(--yv-text-lg, 15.36px);
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .yv-icon-with-text__text > :first-child {
    margin-block-start: 0;
  }

  .yv-icon-with-text__text > :last-child {
    margin-block-end: 0;
  }

  @media screen and (max-width: 1199px) {
    .yv-icon-with-text__icon {
      width: 30px;
      height: 30px;
    }
  }

  @media screen and (max-width: 989px) {
    .yv-icon-with-text {
      gap: 15px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:yv.names.icon_with_text",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "t:yv.icon_with_text.settings.icon",
      "options": [
        { "value": "none", "label": "t:yv.common.options.none" },
        { "value": "truck", "label": "t:yv.icon_with_text.options.truck" },
        { "value": "shield_check", "label": "t:yv.icon_with_text.options.shield_check" },
        { "value": "heart", "label": "t:yv.icon_with_text.options.heart" },
        { "value": "headset", "label": "t:yv.icon_with_text.options.headset" },
        { "value": "chat_bubble", "label": "t:yv.icon_with_text.options.chat_bubble" },
        { "value": "return", "label": "t:yv.icon_with_text.options.return" },
        { "value": "lock", "label": "t:yv.icon_with_text.options.lock" },
        { "value": "credit_card", "label": "t:yv.icon_with_text.options.credit_card" },
        { "value": "gift", "label": "t:yv.icon_with_text.options.gift" },
        { "value": "price_tag", "label": "t:yv.icon_with_text.options.price_tag" },
        { "value": "star", "label": "t:yv.icon_with_text.options.star" },
        { "value": "leaf", "label": "t:yv.icon_with_text.options.leaf" },
        { "value": "box", "label": "t:yv.icon_with_text.options.box" },
        { "value": "plane", "label": "t:yv.icon_with_text.options.plane" },
        { "value": "stopwatch", "label": "t:yv.icon_with_text.options.stopwatch" },
        { "value": "globe", "label": "t:yv.icon_with_text.options.globe" },
        { "value": "money_back", "label": "t:yv.icon_with_text.options.money_back" },
        { "value": "search", "label": "t:yv.icon_with_text.options.search" },
        { "value": "thumbs_up", "label": "t:yv.icon_with_text.options.thumbs_up" }
      ],
      "default": "heart"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:yv.common.settings.heading",
      "default": "Feature title"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:yv.common.settings.description",
      "default": "<p>Describe the feature in a sentence.</p>"
    }
  ],
  "presets": [
    {
      "name": "t:yv.names.icon_with_text"
    }
  ]
}
{% endschema %}
