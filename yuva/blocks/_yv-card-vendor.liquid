{%- doc -%}
  Product card vendor line (Yuva "Show vendor", Theme settings > Product grid). A child of the static
  `_product-card` block; reads `closest.product`. 11.52px, muted, one line with an ellipsis.
  Renders nothing when the theme setting is off or the product has no vendor.
{%- enddoc -%}

{%- liquid
  assign card_product = closest.product
  assign vendor_text = card_product.vendor
  if card_product == blank
    assign vendor_text = 'yv.product_card.vendor_placeholder' | t
  endif
-%}

{%- if settings.yv_grid_vendor != false and vendor_text != blank -%}
  <p
    class="yv-card__vendor"
    {{ block.shopify_attributes }}
  >
    {{- vendor_text | escape -}}
  </p>
{%- endif -%}

{% schema %}
{
  "name": "t:yv.names.card_vendor",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:yv.product_card.vendor_info"
    }
  ],
  "presets": [
    {
      "name": "t:yv.names.card_vendor",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
