{%- doc -%}
  One row of the Tabbed collage accordion built from a product. The section shows the product's
  featured media (image, or the preview image of a video or 3D model) in its media column; this block
  renders the row: optional icon, title (falls back to the product title) and subtitle in a toggle
  button, and a collapsible panel with the price, the description (falls back to the product
  description) and a button (its link falls back to the product page).
{%- enddoc -%}

{%- liquid
  assign row_product = block.settings.product
  assign row_title = block.settings.heading | default: row_product.title
  if row_title == blank and request.design_mode
    assign row_title = 'placeholders.product_title' | t
  endif

  assign row_description = block.settings.description
  if row_description == blank and row_product.description != blank
    assign row_description = row_product.description | strip_html | truncatewords: 30
    assign row_description = '<p>' | append: row_description | append: '</p>'
  endif

  assign row_link = block.settings.button_link
  if row_link == blank and row_product != blank
    assign row_link = row_product.url
  endif
-%}

{%- if row_product != blank or request.design_mode -%}
  {% render 'yv-tabbed-collage-row',
    block: block,
    title: row_title,
    subtitle: block.settings.subheading,
    description: row_description,
    button_text: block.settings.button_text,
    button_link: row_link,
    product: row_product
  %}
{%- endif -%}

