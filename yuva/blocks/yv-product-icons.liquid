{%- doc -%}
  Yuva product icons / trust badges: up to three items in a
  bordered box, each an icon (Horizon icon list) or an image, then a short heading, separated by
  1px lines. Items without icon, image and heading are skipped; the block hides when all are empty.
{%- enddoc -%}

{%- liquid
  assign item_count = 0
  for i in (1..3)
    assign icon_key = 'icon_' | append: i
    assign image_key = 'image_' | append: i
    assign heading_key = 'heading_' | append: i
    if block.settings[icon_key] != 'none' or block.settings[image_key] != blank or block.settings[heading_key] != blank
      assign item_count = item_count | plus: 1
    endif
  endfor
-%}

{%- if item_count > 0 -%}
  <ul
    class="yv-product-icons"
    role="list"
    style="--yv-product-icons-count: {{ item_count }};"
    {{ block.shopify_attributes }}
  >
    {%- for i in (1..3) -%}
      {%- liquid
        assign icon_key = 'icon_' | append: i
        assign image_key = 'image_' | append: i
        assign heading_key = 'heading_' | append: i
        assign icon = block.settings[icon_key]
        assign image = block.settings[image_key]
        assign heading = block.settings[heading_key]
        if icon == 'none' and image == blank and heading == blank
          continue
        endif
      -%}
      <li class="yv-product-icons__item">
        {%- if image != blank -%}
          {{
            image
            | image_url: width: 96
            | image_tag: loading: 'lazy', alt: '', class: 'yv-product-icons__image', sizes: '32px', widths: '48, 64, 96'
          }}
        {%- elsif icon != 'none' -%}
          {% render 'icon-or-image', icon: icon, image_upload: image, width: 28, class_name: 'yv-product-icons__icon' %}
        {%- endif -%}
        {%- if heading != blank -%}
          <span class="yv-product-icons__heading">{{ heading | escape }}</span>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
{%- elsif request.design_mode -%}
  <div {{ block.shopify_attributes }}></div>
{%- endif -%}

{% stylesheet %}
  .yv-product-icons {
    display: grid;
    grid-template-columns: repeat(var(--yv-product-icons-count, 3), minmax(0, 1fr));
    margin: 0;
    padding: 16px 0;
    list-style: none;
    border: 1px solid var(--yv-border-color, rgb(0 0 0 / 0.1));
    border-radius: var(--yv-radius, 10px);
  }

  .yv-product-icons__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    min-width: 0;
    padding-inline: 10px;
    text-align: center;
  }

  .yv-product-icons__item + .yv-product-icons__item {
    border-inline-start: 1px solid var(--yv-border-color, rgb(0 0 0 / 0.1));
  }

  .yv-product-icons__icon {
    width: 28px;
    height: 28px;
  }

  .yv-product-icons__image {
    width: auto;
    max-width: 100%;
    height: 32px;
    object-fit: contain;
  }

  .yv-product-icons__heading {
    font-size: var(--yv-text-sm, 0.75rem);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
{% endstylesheet %}

