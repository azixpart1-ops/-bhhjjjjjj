{% doc %}
  Yuva map subheading (Map section content box): a small uppercase line above the heading.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{%- if block.settings.subheading != blank or request.design_mode -%}
  <p
    class="yv-map-subheading"
    {{ block.shopify_attributes }}
  >
    {{- block.settings.subheading | escape -}}
  </p>
{%- endif -%}

{% stylesheet %}
  .yv-map-subheading {
    min-width: 0;
    margin: 0;
    font-size: var(--yv-text-sm, 12px);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .yv-map-subheading:empty {
    min-height: 1em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:yv.names.map_subheading",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "t:yv.common.settings.subheading",
      "default": "t:yv.map.defaults.subheading"
    }
  ]
}
{% endschema %}
