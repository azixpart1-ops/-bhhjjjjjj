{%- doc -%}
  One Yuva announcement: an optional icon, a message (inline rich text), an optional sale
  countdown (DD/MM/YYYY) and an optional small button. Rendered by sections/yv-announcement-bar.liquid
  as a carousel slide or as a marquee item; the button colours come from the section.

  An expired countdown hides the whole announcement on the storefront (the theme editor keeps it
  visible with a notice so it can still be edited).
{%- enddoc -%}

{%- liquid
  assign icon_name = block.settings.icon | default: 'none'
  if icon_name == 'lightning_bolt'
    assign icon_name = 'lightning'
  endif

  assign countdown_status = 'blank'
  if block.settings.countdown_date != blank
    capture countdown_status
      render 'yv-countdown-timer', end_date: block.settings.countdown_date, date_format: 'dmy', output: 'status'
    endcapture
    assign countdown_status = countdown_status | strip
  endif

  assign show_button = false
  if block.settings.button_text != blank and block.settings.button_link != blank
    assign show_button = true
  endif
-%}

<div
  class="yv-announcement"
  data-yv-countdown-block
  {% if countdown_status == 'expired' and request.design_mode == false %}
    hidden
  {% endif %}
  {{ block.shopify_attributes }}
>
  <div class="yv-announcement__inner">
    {%- if icon_name != 'none' -%}
      <span class="yv-announcement__icon">{% render 'yv-icon', name: icon_name, size: 16 %}</span>
    {%- endif -%}

    {%- if block.settings.heading != blank -%}
      <p class="yv-announcement__text">{{ block.settings.heading }}</p>
    {%- endif -%}

    {%- if block.settings.countdown_date != blank -%}
      {% render 'yv-countdown-timer',
        end_date: block.settings.countdown_date,
        date_format: 'dmy',
        variant: 'inline',
        size: 'small',
        on_expire: 'hide_block',
        class: 'yv-announcement__countdown'
      %}
    {%- endif -%}

    {%- if show_button -%}
      <a
        href="{{ block.settings.button_link }}"
        class="yv-announcement__button"
      >
        {{- block.settings.button_text | escape -}}
      </a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .yv-announcement {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
  }

  .yv-announcement[hidden] {
    display: none;
  }

  .yv-announcement__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 4px 8px;
    min-width: 0;
    max-width: 100%;
  }

  .yv-announcement__icon {
    display: inline-flex;
    flex-shrink: 0;
    color: currentColor;
  }

  .yv-announcement__icon svg {
    width: 16px;
    height: 16px;
  }

  .yv-announcement__text {
    margin: 0;
    padding-block: 3px;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .yv-announcement__text a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .yv-announcement__countdown {
    --yv-countdown-digit-color: currentColor;
    --yv-countdown-label-color: currentColor;

    font-variant-numeric: tabular-nums;
  }

  .yv-announcement__button {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 4px 12px;
    border: 1px solid var(--yv-announcement-button-border, currentColor);
    border-radius: var(--style-border-radius-buttons-primary, 2px);
    background: var(--yv-announcement-button-bg, transparent);
    color: var(--yv-announcement-button-text, currentColor);
    font-size: 11px;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity var(--animation-speed, 0.2s) var(--animation-easing, ease);
  }

  .yv-announcement__button:hover {
    opacity: 0.85;
  }
{% endstylesheet %}

