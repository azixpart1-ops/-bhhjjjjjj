{%- doc -%}
  One hotspot of the Spotlight section (sections/yv-spotlight.liquid): a pulsing dot placed by x/y %
  over the image (separate positions below 750px) that opens a product card beside it on desktop
  (hover or click; "View product" opens quick view) and the product's quick view on a tap on phones.
  Rendered with the shared `yv-hotspot` snippet; the dot colour and card layout come from the section.
  Without a product the hotspot only shows in the theme editor (as a placeholder card).
{%- enddoc -%}

{%- liquid
  assign pos_x = block.settings.pos_x | default: 50
  assign pos_y = block.settings.pos_y | default: 50
  assign pos_x_mobile = block.settings.pos_x_mobile | default: pos_x
  assign pos_y_mobile = block.settings.pos_y_mobile | default: pos_y
  assign card_layout = section.settings.card_layout | default: 'horizontal'
  assign hotspot_color = section.settings.hotspot_color | default: '#ffffff'
-%}

{% render 'yv-hotspot',
  id: block.id,
  x: pos_x,
  y: pos_y,
  x_mobile: pos_x_mobile,
  y_mobile: pos_y_mobile,
  product: block.settings.product,
  layout: card_layout,
  color: hotspot_color,
  side: block.settings.card_side,
  attributes: block.shopify_attributes,
  class: 'yv-spotlight-hotspot'
%}

{% schema %}
{
  "name": "t:yv.names.spotlight_hotspot",
  "tag": null,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:yv.common.settings.product"
    },
    {
      "type": "select",
      "id": "card_side",
      "label": "t:yv.spotlight.settings.card_side",
      "options": [
        {
          "value": "right",
          "label": "t:yv.common.options.right"
        },
        {
          "value": "left",
          "label": "t:yv.common.options.left"
        }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "t:yv.common.content.desktop"
    },
    {
      "type": "range",
      "id": "pos_x",
      "label": "t:yv.spotlight.settings.pos_x",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "pos_y",
      "label": "t:yv.spotlight.settings.pos_y",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "t:yv.common.content.mobile"
    },
    {
      "type": "range",
      "id": "pos_x_mobile",
      "label": "t:yv.spotlight.settings.pos_x",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "pos_y_mobile",
      "label": "t:yv.spotlight.settings.pos_y",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "t:yv.names.spotlight_hotspot"
    }
  ]
}
{% endschema %}
