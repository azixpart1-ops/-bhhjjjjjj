{%- doc -%}
  Collection list of the Yuva side drawer (sections/yv-side-drawer.liquid): a heading and up to
  eight collection cards (square featured image and title), four per row on desktop and two on
  phones. Placeholder cards show while no collection is chosen.
{%- enddoc -%}

{%- liquid
  assign heading_tag = block.settings.heading_tag | default: 'h3'
  unless heading_tag == 'h1' or heading_tag == 'h2' or heading_tag == 'h3' or heading_tag == 'h4' or heading_tag == 'h5' or heading_tag == 'h6' or heading_tag == 'p'
    assign heading_tag = 'h3'
  endunless
  assign collections = block.settings.collections
  assign image_loading = 'lazy'
-%}

<div
  class="yv-drawer-collections"
  style="--yv-drawer-block-text: {{ block.settings.color_text | default: 'currentColor' }};"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.heading != blank -%}
    <{{ heading_tag }} class="yv-side-drawer__heading">{{ block.settings.heading | escape }}</{{ heading_tag }}>
  {%- endif -%}

  <ul
    class="yv-drawer-collections__grid list-unstyled"
    role="list"
  >
    {%- if collections != blank -%}
      {%- for collection in collections limit: 8 -%}
        <li class="yv-drawer-collections__item">
          <a
            class="yv-drawer-collections__card"
            href="{{ collection.url }}"
          >
            <span class="yv-drawer-collections__media yv-hover-zoom">
              {%- assign collection_image = collection.featured_image -%}
              {%- if collection_image != blank -%}
                {{
                  collection_image
                  | image_url: width: 600
                  | image_tag:
                    widths: '200, 300, 400, 600',
                    sizes: '(min-width: 990px) 280px, (min-width: 750px) 22vw, 45vw',
                    loading: image_loading,
                    alt: collection.title,
                    class: 'yv-drawer-collections__image'
                }}
              {%- else -%}
                {%- assign placeholder_index = forloop.index0 | modulo: 6 | plus: 1 -%}
                {{ 'collection-' | append: placeholder_index | placeholder_svg_tag: 'yv-drawer-collections__image yv-placeholder' }}
              {%- endif -%}
            </span>
            <span class="yv-drawer-collections__title">{{ collection.title | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <li class="yv-drawer-collections__item">
          <span class="yv-drawer-collections__card">
            <span class="yv-drawer-collections__media">
              {{ 'collection-' | append: i | placeholder_svg_tag: 'yv-drawer-collections__image yv-placeholder' }}
            </span>
            <span class="yv-drawer-collections__title">{{ 'yv.side_drawer.collection_title' | t }}</span>
          </span>
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
</div>

{% stylesheet %}
  .yv-drawer-collections {
    min-width: 0;
    color: var(--yv-drawer-block-text, currentColor);
  }

  .yv-drawer-collections__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
  }

  .yv-drawer-collections__card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: inherit;
    text-decoration: none;
  }

  .yv-drawer-collections__media {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--yv-layout-radius, 10px);
    background-color: var(--yv-image-bg);
  }

  .yv-drawer-collections__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .yv-drawer-collections__title {
    font-size: 15px;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  a.yv-drawer-collections__card:hover .yv-drawer-collections__title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media screen and (min-width: 750px) {
    .yv-drawer-collections__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:yv.names.drawer_collections",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Shop by collection"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:yv.common.settings.heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:yv.common.options.h1"
        },
        {
          "value": "h2",
          "label": "t:yv.common.options.h2"
        },
        {
          "value": "h3",
          "label": "t:yv.common.options.h3"
        },
        {
          "value": "h4",
          "label": "t:yv.common.options.h4"
        },
        {
          "value": "h5",
          "label": "t:yv.common.options.h5"
        },
        {
          "value": "h6",
          "label": "t:yv.common.options.h6"
        },
        {
          "value": "p",
          "label": "t:yv.common.options.paragraph"
        }
      ],
      "default": "h3"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "t:settings.collection_list",
      "info": "t:yv.side_drawer.settings.collections_info",
      "limit": 8
    },
    {
      "type": "header",
      "content": "t:yv.common.content.color"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:yv.common.settings.text_color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "t:yv.names.drawer_collections"
    }
  ]
}
{% endschema %}
