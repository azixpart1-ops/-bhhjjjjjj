{%- doc -%}
  One link of a Yuva header link row (child of blocks/_yv-header-utility.liquid): a label with an
  optional line icon. Renders nothing until the label is filled in.
{%- enddoc -%}

{%- if block.settings.label != blank -%}
  {%- liquid
    assign link_url = block.settings.link | default: '#'
    assign is_current = false
    if block.settings.link != blank and block.settings.link == request.path
      assign is_current = true
    endif
  -%}
  <li
    class="yv-header-utility__item"
    {{ block.shopify_attributes }}
  >
    <a
      href="{{ link_url }}"
      class="yv-header-link"
      {% if is_current %}
        aria-current="page"
      {% endif %}
    >
      {%- if block.settings.icon != 'none' -%}
        <span
          class="yv-header-link__icon"
          aria-hidden="true"
        >
          {%- render 'yv-icon', name: block.settings.icon, size: 14 -%}
        </span>
      {%- endif -%}
      <span class="yv-header-link__label">{{ block.settings.label | escape }}</span>
    </a>
  </li>
{%- endif -%}

