{%- doc -%}
  A content card of the Media grid (sections/yv-media-grid.liquid): a bordered tile holding an image
  or a video beside, above or below a heading, a short description and an optional text link
  (Yuva's "Must-Have Accessories" and "Sporty & Stylish Gym Wear" tiles). The video plays inline from
  a round play button (Horizon `video` snippet) or loops muted (assets/yv-autoplay-video.js).
{%- enddoc -%}

{%- liquid
  assign columns = section.settings.columns_desktop | default: 6
  assign columns_mobile = section.settings.columns_mobile | default: 2
  assign col = block.settings.column_span | default: 1 | at_most: columns
  assign col_mobile = block.settings.column_span_mobile | default: 1 | at_most: columns_mobile
  assign row = block.settings.row_span | default: 1
  assign row_mobile = block.settings.row_span_mobile | default: 1

  assign layout = block.settings.layout | default: 'media_left'
  assign media_share = 100
  if layout == 'media_left' or layout == 'media_right'
    assign media_share = block.settings.media_width
  endif
  assign width_desktop = col | times: media_share | divided_by: columns
  assign width_mobile = col_mobile | times: media_share | divided_by: columns_mobile
  assign sizes = '(min-width: 750px) ' | append: width_desktop | append: 'vw, ' | append: width_mobile | append: 'vw'

  assign media_loading = 'lazy'
  if section.index <= 2 or settings.yv_enable_lazyload == false
    assign media_loading = 'eager'
  endif

  assign text_first = false
  if layout == 'text_top' or layout == 'media_right'
    assign text_first = true
  endif

  assign image = block.settings.image
  assign video = block.settings.video
  assign heading_size = block.settings.heading_size | default: 'h3'
-%}

{%- capture media_markup -%}
  <div class="yv-media-grid-content__media">
    {%- if video != blank -%}
      {%- assign poster = image | default: video.preview_image -%}
      {%- if block.settings.video_autoplay -%}
        <yv-autoplay-video-component class="yv-media-grid__video">
          <video
            ref="video"
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
            {% if poster != blank %}
              poster="{{ poster | image_url: width: 1200 }}"
            {% endif %}
          >
            {%- for source in video.sources -%}
              <source
                data-src="{{ source.url }}"
                type="{{ source.mime_type }}"
              >
            {%- endfor -%}
          </video>
        </yv-autoplay-video-component>
      {%- else -%}
        {% render 'video',
          video: video,
          video_autoplay: false,
          video_loop: true,
          video_preview_image: poster,
          video_class: 'yv-media-grid__player',
          sizes: sizes,
          widths: '300, 450, 600, 800, 1000, 1200',
          loading: media_loading
        %}
      {%- endif -%}
    {%- elsif image != blank -%}
      {%- liquid
        assign focal = image.presentation.focal_point | default: 'center'
        assign focal_style = 'object-position: ' | append: focal | append: ';'
      -%}
      {{
        image
        | image_url: width: 1200
        | image_tag:
          widths: '200, 300, 450, 600, 800, 1000, 1200',
          sizes: sizes,
          loading: media_loading,
          alt: image.alt,
          style: focal_style
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'yv-placeholder' }}
    {%- endif -%}
  </div>
{%- endcapture -%}

{%- capture text_markup -%}
  {%- if block.settings.heading != blank or block.settings.description != blank or block.settings.button_label != blank -%}
    <div class="yv-media-grid-content__text">
      {%- if block.settings.heading != blank -%}
        <h3 class="yv-media-grid-content__heading {{ heading_size }}">{{ block.settings.heading | escape }}</h3>
      {%- endif -%}
      {%- if block.settings.description != blank -%}
        <div class="yv-media-grid-content__description rte">{{ block.settings.description }}</div>
      {%- endif -%}
      {% render 'yv-button',
        label: block.settings.button_label,
        link: block.settings.button_link,
        variant: 'link',
        class: 'yv-media-grid-content__button'
      %}
    </div>
  {%- endif -%}
{%- endcapture -%}

<div
  class="yv-media-grid-tile yv-media-grid-content yv-media-grid-content--{{ layout }}"
  style="--yv-mg-col: {{ col }}; --yv-mg-row-span: {{ row }}; --yv-mg-col-m: {{ col_mobile }}; --yv-mg-row-span-m: {{ row_mobile }}; --yv-mg-media-width: {{ block.settings.media_width }}%; --yv-mg-card-bg: {{ block.settings.background_color }}; --yv-mg-card-border: {{ block.settings.border_color }}; --yv-mg-card-heading: {{ block.settings.heading_color }}; --yv-mg-card-text: {{ block.settings.text_color }};"
  data-yv-reveal
  {{ block.shopify_attributes }}
>
  <div class="yv-media-grid-content__body">
    {%- if text_first -%}
      {{ text_markup }}
      {{ media_markup }}
    {%- else -%}
      {{ media_markup }}
      {{ text_markup }}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  /* The card is a size container, so a narrow card stacks its media and text (see below). */
  .yv-media-grid-content {
    container: yv-mg-card / inline-size;
    display: flex;
    padding: var(--yv-mg-pad, 15px);
    color: var(--yv-mg-card-text, inherit);
    background-color: var(--yv-mg-card-bg, #fff);
    border: 1px solid var(--yv-mg-card-border, #e9e9e9);
  }

  .yv-media-grid-content__body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
  }

  .yv-media-grid-content--media_left .yv-media-grid-content__body,
  .yv-media-grid-content--media_right .yv-media-grid-content__body {
    flex-direction: row;
    align-items: center;
  }

  .yv-media-grid-content__media {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
    min-height: 140px;
    overflow: hidden;
    background-color: var(--yv-image-bg);
    border-radius: var(--yv-mg-tile-radius, 10px);
  }

  .yv-media-grid-content--media_left .yv-media-grid-content__media,
  .yv-media-grid-content--media_right .yv-media-grid-content__media {
    flex: 0 0 var(--yv-mg-media-width, 40%);
    align-self: stretch;
    min-height: 120px;
  }

  .yv-media-grid-content__media > :is(img, svg),
  .yv-media-grid-content__media .yv-media-grid__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .yv-media-grid-content__text {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .yv-media-grid-content--media_left .yv-media-grid-content__text,
  .yv-media-grid-content--media_right .yv-media-grid-content__text {
    flex: 1 1 0;
  }

  .yv-media-grid-content .yv-media-grid-content__heading {
    margin: 0;
    color: var(--yv-mg-card-heading, var(--yv-heading-color, inherit));
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .yv-media-grid-content__description {
    font-size: var(--yv-text-base, 0.84rem);
    line-height: 1.5;
  }

  /* Media beside the text needs room: in a card whose content box is under 300px (tablets, small desktops,
     2-column phone grids) the media sits above or below the text instead, so words never split. */
  @container yv-mg-card (max-width: 299px) {
    .yv-media-grid-content--media_left .yv-media-grid-content__body,
    .yv-media-grid-content--media_right .yv-media-grid-content__body {
      flex-direction: column;
      align-items: stretch;
    }

    .yv-media-grid-content--media_left .yv-media-grid-content__media,
    .yv-media-grid-content--media_right .yv-media-grid-content__media {
      flex: 1 1 auto;
      min-height: 140px;
    }

    .yv-media-grid-content--media_left .yv-media-grid-content__text,
    .yv-media-grid-content--media_right .yv-media-grid-content__text {
      flex: 0 0 auto;
    }
  }

  @media screen and (max-width: 749px) {
    .yv-media-grid-content__body {
      gap: 15px;
    }

    .yv-media-grid-content .yv-media-grid-content__heading {
      font-size: min(var(--font-h4--size, 22px), 22px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:yv.names.media_grid_content",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "t:yv.media_grid.settings.layout",
      "options": [
        {
          "value": "media_left",
          "label": "t:yv.media_grid.options.media_left"
        },
        {
          "value": "media_right",
          "label": "t:yv.media_grid.options.media_right"
        },
        {
          "value": "text_top",
          "label": "t:yv.media_grid.options.text_top"
        },
        {
          "value": "media_top",
          "label": "t:yv.media_grid.options.media_top"
        }
      ],
      "default": "media_left"
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "t:yv.media_grid.settings.media_width",
      "min": 20,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 40,
      "visible_if": "{{ block.settings.layout == 'media_left' or block.settings.layout == 'media_right' }}"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:yv.common.settings.image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:yv.media_grid.settings.video",
      "info": "t:yv.media_grid.settings.video_info"
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "t:yv.media_grid.settings.video_autoplay",
      "info": "t:yv.media_grid.settings.video_autoplay_info",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:yv.common.settings.heading",
      "default": "Sporty & Stylish Gym Wear"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:yv.common.settings.heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:yv.common.options.h2"
        },
        {
          "value": "h3",
          "label": "t:yv.common.options.h3"
        },
        {
          "value": "h4",
          "label": "t:yv.common.options.h4"
        },
        {
          "value": "h5",
          "label": "t:yv.common.options.h5"
        },
        {
          "value": "h6",
          "label": "t:yv.common.options.h6"
        }
      ],
      "default": "h3"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:yv.common.settings.description"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:yv.common.settings.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:yv.common.settings.button_link",
      "info": "t:yv.common.settings.button_info"
    },
    {
      "type": "header",
      "content": "t:yv.common.content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:yv.common.settings.background_color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:yv.media_grid.settings.border_color",
      "default": "#E9E9E9"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:yv.common.settings.heading_color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:yv.common.settings.text_color",
      "default": "#484848"
    },
    {
      "type": "header",
      "content": "t:yv.media_grid.content.desktop_layout"
    },
    {
      "type": "range",
      "id": "column_span",
      "label": "t:yv.media_grid.settings.column_span",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "row_span",
      "label": "t:yv.media_grid.settings.row_span",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "t:yv.media_grid.content.mobile_layout"
    },
    {
      "type": "range",
      "id": "column_span_mobile",
      "label": "t:yv.media_grid.settings.column_span",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "row_span_mobile",
      "label": "t:yv.media_grid.settings.row_span",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 2
    }
  ],
  "presets": [
    {
      "name": "t:yv.names.media_grid_content",
      "settings": {
        "description": "<p>Stay comfortable and stylish with our premium gym wear, designed for maximum performance.</p>"
      }
    }
  ]
}
{% endschema %}
