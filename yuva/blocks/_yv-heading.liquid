{% doc %}
  Yuva heading block: a heading with highlight runs (bold text switches to the highlight
  font and colour) and optional rotating words. Shared by Image with text, Multi images
  with text, Rich text and Map. Alignment follows the parent section's alignment setting
  (`text_alignment`, `content_alignment` or `alignment`).

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{%- liquid
  assign align = section.settings.text_alignment | default: section.settings.content_alignment | default: section.settings.alignment | default: 'left'
  if align contains 'center'
    assign align = 'center'
  elsif align contains 'right'
    assign align = 'right'
  else
    assign align = 'left'
  endif
-%}

<div
  class="yv-heading-block"
  {{ block.shopify_attributes }}
>
  {%- render 'yv-heading',
    text: block.settings.heading,
    tag: block.settings.heading_tag,
    size: block.settings.heading_size,
    highlight_font: block.settings.highlight_font,
    highlight_color: block.settings.highlight_color,
    rotating_text: block.settings.rotating_text,
    alignment: align,
    reveal: settings.yv_enable_animation
  -%}
</div>

{% stylesheet %}
  .yv-heading-block {
    min-width: 0;
    width: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:yv.names.heading_block",
  "tag": null,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:yv.common.settings.heading",
      "info": "t:yv.common.settings.heading_info",
      "default": "Image with <strong>text</strong>"
    },
    {
      "type": "select",
      "id": "highlight_font",
      "label": "t:yv.common.settings.highlight_font",
      "options": [
        { "value": "heading", "label": "t:yv.common.options.heading" },
        { "value": "body", "label": "t:yv.common.options.body" },
        { "value": "accent", "label": "t:yv.common.options.accent" }
      ],
      "default": "heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:yv.common.settings.heading_size",
      "options": [
        { "value": "small", "label": "t:yv.common.options.small" },
        { "value": "medium", "label": "t:yv.common.options.medium" },
        { "value": "large", "label": "t:yv.common.options.large" },
        { "value": "h1", "label": "t:yv.common.options.h1" },
        { "value": "h2", "label": "t:yv.common.options.h2" },
        { "value": "h3", "label": "t:yv.common.options.h3" },
        { "value": "h4", "label": "t:yv.common.options.h4" },
        { "value": "h5", "label": "t:yv.common.options.h5" },
        { "value": "h6", "label": "t:yv.common.options.h6" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:yv.common.settings.heading_tag",
      "info": "t:yv.common.settings.heading_tag_info",
      "options": [
        { "value": "h1", "label": "t:yv.common.options.h1" },
        { "value": "h2", "label": "t:yv.common.options.h2" },
        { "value": "h3", "label": "t:yv.common.options.h3" },
        { "value": "h4", "label": "t:yv.common.options.h4" },
        { "value": "h5", "label": "t:yv.common.options.h5" },
        { "value": "h6", "label": "t:yv.common.options.h6" },
        { "value": "p", "label": "t:yv.common.options.paragraph" }
      ],
      "default": "h2"
    },
    {
      "type": "color_background",
      "id": "highlight_color",
      "label": "t:yv.common.settings.highlight_color",
      "info": "t:yv.common.settings.highlight_color_info",
      "default": "linear-gradient(90deg, rgba(166, 120, 200, 1) 0%, rgba(113, 140, 199, 1) 48%, rgba(99, 154, 71, 1) 100%)"
    },
    {
      "type": "text",
      "id": "rotating_text",
      "label": "t:yv.common.settings.rotating_text",
      "info": "t:yv.common.settings.rotating_text_info"
    }
  ],
  "presets": [
    {
      "name": "t:yv.names.heading_block"
    }
  ]
}
{% endschema %}
