{%- doc -%}
  Yuva "Mega menu with product list": up to twelve collections as columns, each listing its first
  products as text links.
  Matched to a first-level menu item by its "Menu label" (case-insensitive) and rendered into that
  item by blocks/_header-menu.liquid (snippets/yv-mega-menu.liquid). This file only outputs a hidden
  marker so the theme editor can select the block (assets/yv-header.js opens the matching item).
{%- enddoc -%}

<div
  class="yv-header-block-marker"
  data-yv-menu-label="{{ block.settings.menu_label | strip | downcase | escape }}"
  data-yv-block-kind="mega"
  {{ block.shopify_attributes }}
></div>

{% schema %}
{
  "name": "t:yv.names.mega_menu_product_list",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "menu_label",
      "label": "t:yv.header.settings.menu_label",
      "info": "t:yv.header.settings.menu_label_info"
    },
    {
      "type": "range",
      "id": "product_count",
      "label": "t:yv.header.settings.product_count",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 7
    },
    {
      "type": "header",
      "content": "t:yv.header.content.collections"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "t:yv.header.settings.collection_1"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "t:yv.header.settings.collection_2"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "t:yv.header.settings.collection_3"
    },
    {
      "type": "collection",
      "id": "collection_4",
      "label": "t:yv.header.settings.collection_4"
    },
    {
      "type": "collection",
      "id": "collection_5",
      "label": "t:yv.header.settings.collection_5"
    },
    {
      "type": "collection",
      "id": "collection_6",
      "label": "t:yv.header.settings.collection_6"
    },
    {
      "type": "collection",
      "id": "collection_7",
      "label": "t:yv.header.settings.collection_7"
    },
    {
      "type": "collection",
      "id": "collection_8",
      "label": "t:yv.header.settings.collection_8"
    },
    {
      "type": "collection",
      "id": "collection_9",
      "label": "t:yv.header.settings.collection_9"
    },
    {
      "type": "collection",
      "id": "collection_10",
      "label": "t:yv.header.settings.collection_10"
    },
    {
      "type": "collection",
      "id": "collection_11",
      "label": "t:yv.header.settings.collection_11"
    },
    {
      "type": "collection",
      "id": "collection_12",
      "label": "t:yv.header.settings.collection_12"
    }
  ],
  "presets": [
    {
      "name": "t:yv.names.mega_menu_product_list",
      "settings": {
        "menu_label": "New products"
      }
    }
  ]
}
{% endschema %}
