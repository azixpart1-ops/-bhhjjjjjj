{% doc %}
  Yuva map heading (Map section content box): a plain-text heading at the h3 type preset with a
  merchant-chosen tag for SEO.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{%- assign map_heading = block.settings.heading | escape -%}
<div
  class="yv-map-heading"
  {{ block.shopify_attributes }}
>
  {%- render 'yv-heading', text: map_heading, tag: block.settings.heading_tag, size: 'medium', alignment: 'left' -%}
</div>

{% stylesheet %}
  .yv-map-heading {
    min-width: 0;
    width: 100%;
  }

  .yv-map-heading .yv-heading__title {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:yv.names.map_heading",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:yv.common.settings.heading",
      "default": "Visit our store"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:yv.common.settings.heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:yv.common.options.h1"
        },
        {
          "value": "h2",
          "label": "t:yv.common.options.h2"
        },
        {
          "value": "h3",
          "label": "t:yv.common.options.h3"
        },
        {
          "value": "h4",
          "label": "t:yv.common.options.h4"
        },
        {
          "value": "h5",
          "label": "t:yv.common.options.h5"
        },
        {
          "value": "h6",
          "label": "t:yv.common.options.h6"
        },
        {
          "value": "p",
          "label": "t:yv.common.options.paragraph"
        }
      ],
      "default": "h2",
      "info": "t:yv.common.settings.heading_tag_info"
    }
  ]
}
{% endschema %}
