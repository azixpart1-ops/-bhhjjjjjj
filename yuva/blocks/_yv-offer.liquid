{%- doc -%}
  One offer of the Yuva Sidebar offer panel (sections/yv-sidebar-offer.liquid), shown as one slide:
  an image in a dashed coupon frame (40%) beside the highlighted text (for example "10% off"), the
  heading and the link text (60%). With a link the whole slide is a link.
{%- enddoc -%}

{%- liquid
  assign link = block.settings.link
  assign offer_tag = 'div'
  if link != blank
    assign offer_tag = 'a'
  endif
  assign image = block.settings.image
-%}

<{{ offer_tag }}
  class="yv-offer"
  {% if link != blank %}
    href="{{ link }}"
  {% endif %}
  {{ block.shopify_attributes }}
>
  <span class="yv-offer__media">
    <span class="yv-offer__frame">
      {%- if image != blank -%}
        {%- assign image_alt = image.alt | default: '' -%}
        {{
          image
          | image_url: width: 400
          | image_tag:
            widths: '150, 200, 300, 400',
            sizes: '150px',
            loading: 'lazy',
            alt: image_alt,
            class: 'yv-offer__image'
        }}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'yv-offer__image yv-placeholder' }}
      {%- endif -%}
    </span>
  </span>
  <span class="yv-offer__body">
    {%- if block.settings.highlighted_text != blank -%}
      <span class="yv-offer__highlight">{{ block.settings.highlighted_text | escape }}</span>
    {%- endif -%}
    {%- if block.settings.heading != blank -%}
      <span class="yv-offer__heading">{{ block.settings.heading | escape }}</span>
    {%- endif -%}
    {%- if block.settings.link_text != blank -%}
      <span class="yv-offer__link">{{ block.settings.link_text | escape }}</span>
    {%- endif -%}
  </span>
</{{ offer_tag }}>

{% stylesheet %}
  .yv-offer {
    display: grid;
    grid-template-columns: 40% minmax(0, 1fr);
    align-items: center;
    min-width: 0;
    color: inherit;
    text-decoration: none;
    scroll-snap-align: start;
  }

  .yv-offer__media {
    display: block;
    height: 120px;
    padding: 6px;
    border: 1px dashed var(--yv-border-color, rgb(0 0 0 / 0.15));
    border-radius: 10px;
  }

  .yv-offer__frame {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 6px;
    background-color: var(--yv-image-bg);
  }

  .yv-offer__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .yv-offer__image {
      transition: transform 0.7s var(--yv-ease-out, ease);
    }

    a.yv-offer:hover .yv-offer__image {
      transform: scale(1.05);
    }
  }

  .yv-offer__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    min-width: 0;
    padding-inline-start: 20px;
  }

  .yv-offer__highlight {
    color: var(--yv-heading-color, currentColor);
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: 700;
    font-size: 24px;
    line-height: 1.1;
    overflow-wrap: anywhere;
  }

  .yv-offer__heading {
    font-size: var(--font-paragraph--size);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.75;
    overflow-wrap: anywhere;
  }

  .yv-offer__link {
    margin-block-start: 4px;
    font-size: var(--font-paragraph--size);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  a.yv-offer:hover .yv-offer__link {
    text-decoration-thickness: 2px;
  }

  @media screen and (max-width: 749px) {
    .yv-offer__media {
      height: 96px;
    }

    .yv-offer__body {
      padding-inline-start: 14px;
    }

    .yv-offer__highlight {
      font-size: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:yv.names.offer",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "info": "t:yv.sidebar_offer.settings.max_10_info",
      "default": "Summer"
    },
    {
      "type": "text",
      "id": "highlighted_text",
      "label": "t:yv.sidebar_offer.settings.highlighted_text",
      "info": "t:yv.sidebar_offer.settings.max_10_info",
      "default": "10% off"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
      "info": "t:yv.sidebar_offer.settings.image_info"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "t:yv.sidebar_offer.settings.link_text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    }
  ],
  "presets": [
    {
      "name": "t:yv.names.offer"
    }
  ]
}
{% endschema %}
