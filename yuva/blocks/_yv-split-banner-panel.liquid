{%- doc -%}
  One panel of the Split banner (sections/yv-split-banner.liquid): a cover image (anchored to the top by
  default) under an overlay, with a heading and a short description pinned to the bottom. The whole panel
  links to `link` when it is set. Heading tag, size, highlight font and highlight colour come from the
  parent section, so every panel matches. On desktop the description is revealed on hover when the
  section's text animation is on (CSS only, see the section's row modifiers).
{%- enddoc -%}

{%- liquid
  assign panel_index = 1
  for item in section.blocks
    if item.id == block.id
      assign panel_index = forloop.index
      break
    endif
  endfor

  assign image_loading = 'lazy'
  assign image_priority = 'auto'
  if section.index == 1
    assign image_loading = 'eager'
    assign image_priority = 'high'
  elsif section.index == 2
    assign image_loading = 'eager'
  endif

  case block.settings.image_position
    when 'center'
      assign object_position = '50% 50%'
    when 'bottom'
      assign object_position = '50% 100%'
    else
      assign object_position = '50% 0%'
  endcase

  case panel_index
    when 2
      assign placeholder_name = 'lifestyle-2'
    when 3
      assign placeholder_name = 'hero-apparel-2'
    when 4
      assign placeholder_name = 'hero-apparel-3'
    else
      assign placeholder_name = 'lifestyle-1'
  endcase

  assign panel_tag = 'div'
  if block.settings.link != blank
    assign panel_tag = 'a'
  endif

  assign heading_text = block.settings.heading
  assign alignment = block.settings.text_alignment | default: 'left'
-%}

<{{ panel_tag }}
  class="yv-split-banner__panel yv-split-banner__panel--{{ alignment }}{% if block.settings.image == blank %} yv-split-banner__panel--placeholder{% endif %}"
  {% if panel_tag == 'a' %}
    href="{{ block.settings.link }}"
  {% endif %}
  style="--yv-split-banner-panel-heading: {{ block.settings.heading_color }}; --yv-split-banner-panel-text: {{ block.settings.text_color }}; --yv-split-banner-panel-position: {{ object_position }};"
  {{ block.shopify_attributes }}
>
  <div class="yv-split-banner__media">
    {%- if block.settings.image != blank -%}
      {{
        block.settings.image
        | image_url: width: 1500
        | image_tag:
          widths: '375, 550, 750, 1000, 1250, 1500',
          sizes: '(min-width: 990px) 40vw, (min-width: 750px) 50vw, 75vw',
          loading: image_loading,
          fetchpriority: image_priority,
          class: 'yv-split-banner__image'
      }}
    {%- else -%}
      {{ placeholder_name | placeholder_svg_tag: 'yv-split-banner__image yv-placeholder' }}
    {%- endif -%}
  </div>
  <div
    class="yv-overlay"
    style="--yv-overlay-color: {{ block.settings.overlay_color }}; --yv-overlay-opacity: {{ block.settings.overlay_opacity }};"
  ></div>

  {%- if heading_text != blank or block.settings.description != blank -%}
    <div
      class="yv-split-banner__content"
      data-yv-reveal
      style="--yv-reveal-delay: 200ms;"
    >
      {% render 'yv-heading',
        text: heading_text,
        tag: section.settings.heading_tag,
        size: section.settings.heading_size,
        highlight_font: section.settings.highlight_font,
        highlight_color: section.settings.highlight_color,
        alignment: alignment,
        class: 'yv-split-banner__heading'
      %}
      {%- if block.settings.description != blank -%}
        <div class="yv-split-banner__reveal">
          <div class="yv-split-banner__reveal-inner">
            <p class="yv-split-banner__text">{{ block.settings.description | escape | newline_to_br }}</p>
          </div>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</{{ panel_tag }}>

{% stylesheet %}
  .yv-split-banner__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: var(--yv-split-banner-height-mobile, 450px);
    overflow: hidden;
    isolation: isolate;
    color: var(--yv-split-banner-panel-text, #fff);
    text-decoration: none;
    background-color: var(--yv-image-bg);
  }

  @media screen and (min-width: 750px) {
    .yv-split-banner__panel {
      height: var(--yv-split-banner-height, 750px);
    }
  }

  .yv-split-banner__panel:focus-visible {
    outline: 2px solid var(--yv-split-banner-panel-heading, #fff);
    outline-offset: -6px;
  }

  .yv-split-banner__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .yv-split-banner__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--yv-split-banner-panel-position, 50% 0%);
  }

  .yv-split-banner__panel--placeholder .yv-split-banner__media {
    background-color: var(--yv-image-bg);
  }

  /* Without an image, a soft scrim keeps the light heading readable on the image background. */
  .yv-split-banner__panel--placeholder .yv-split-banner__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.4), rgb(0 0 0 / 0) 50%);
  }

  .yv-split-banner__panel > .yv-overlay {
    z-index: 1;
  }

  .yv-split-banner__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    padding: 15px;
  }

  @media screen and (min-width: 750px) {
    .yv-split-banner__content {
      padding: 25px;
    }
  }

  .yv-split-banner__panel--center .yv-split-banner__content {
    align-items: center;
    text-align: center;
  }

  .yv-split-banner__panel--right .yv-split-banner__content {
    align-items: flex-end;
    text-align: end;
  }

  .yv-split-banner__content .yv-split-banner__heading .yv-heading__title {
    color: var(--yv-split-banner-panel-heading, #fff);
  }

  .yv-split-banner__reveal {
    display: grid;
    grid-template-rows: 1fr;
    width: 100%;
  }

  .yv-split-banner__reveal-inner {
    min-height: 0;
    overflow: hidden;
  }

  .yv-split-banner__text {
    max-width: 350px;
    margin: 0;
    padding-block-start: 10px;
    font-size: var(--yv-text-base, 0.84rem);
    line-height: var(--line-height--body-normal, 1.4);
    color: var(--yv-split-banner-panel-text, #fff);
  }

  .yv-split-banner__panel--center .yv-split-banner__text {
    margin-inline: auto;
  }

  .yv-split-banner__panel--right .yv-split-banner__text {
    margin-inline-start: auto;
  }

  /* Desktop text animation: only the heading shows at rest; the description slides up on hover. */
  @media screen and (min-width: 990px) and (hover: hover) {
    .yv-split-banner__row--reveal .yv-split-banner__reveal {
      grid-template-rows: 0fr;
    }

    .yv-split-banner__row--reveal .yv-split-banner__text {
      translate: 0 100%;
      opacity: 0;
    }

    .yv-split-banner__row--reveal .yv-split-banner__panel:is(:hover, :focus-visible, :focus-within) .yv-split-banner__reveal {
      grid-template-rows: 1fr;
    }

    .yv-split-banner__row--reveal .yv-split-banner__panel:is(:hover, :focus-visible, :focus-within) .yv-split-banner__text {
      translate: 0 0;
      opacity: 1;
    }
  }

  @media screen and (min-width: 990px) and (hover: hover) and (prefers-reduced-motion: no-preference) {
    .yv-split-banner__row--reveal .yv-split-banner__reveal {
      transition: grid-template-rows 0.4s ease;
    }

    .yv-split-banner__row--reveal .yv-split-banner__text {
      transition: translate 0.4s ease, opacity 0.4s ease;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:yv.names.split_banner_panel",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:yv.common.settings.image",
      "info": "t:yv.split_banner.settings.image_info"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:yv.split_banner.settings.image_position",
      "options": [
        {
          "value": "top",
          "label": "t:yv.common.options.top"
        },
        {
          "value": "center",
          "label": "t:yv.common.options.center"
        },
        {
          "value": "bottom",
          "label": "t:yv.common.options.bottom"
        }
      ],
      "default": "top"
    },
    {
      "type": "header",
      "content": "t:yv.common.content.text"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:yv.common.settings.heading",
      "info": "t:yv.common.settings.heading_info"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:yv.common.settings.description"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:yv.common.settings.link"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:yv.common.settings.text_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:yv.common.options.left"
        },
        {
          "value": "center",
          "label": "t:yv.common.options.center"
        },
        {
          "value": "right",
          "label": "t:yv.common.options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:yv.common.content.colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:yv.common.settings.heading_color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:yv.common.settings.text_color",
      "default": "#D6D6D6"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:yv.common.settings.overlay_color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:yv.common.settings.overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "t:yv.names.split_banner_panel",
      "settings": {
        "heading": "Panel heading",
        "description": "Share a short line about this collection."
      }
    }
  ]
}
{% endschema %}
