{% doc %}
  Rich text > Page: a Yuva highlight heading (falls back to the page title) above the content of
  the chosen Shopify page. With no page selected it shows Horizon's placeholder copy in the theme
  editor only. Alignment follows the parent section's `text_alignment`.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{%- liquid
  assign align = section.settings.text_alignment | default: 'center'
  unless align == 'left' or align == 'right'
    assign align = 'center'
  endunless

  assign page_ref = block.settings.page
  assign heading = block.settings.heading
  if heading == blank and page_ref != blank
    assign heading = page_ref.title | escape
  endif
-%}

<div
  class="yv-rich-text-page"
  {{ block.shopify_attributes }}
>
  {%- if page_ref != blank -%}
    {%- render 'yv-heading',
      text: heading,
      tag: block.settings.heading_tag,
      size: block.settings.heading_size,
      highlight_font: block.settings.highlight_font,
      highlight_color: block.settings.highlight_color,
      alignment: align,
      reveal: settings.yv_enable_animation
    -%}
    {%- if page_ref.content != blank -%}
      <div
        class="yv-rich-text-page__content rte"
        {% if settings.yv_enable_animation %}
          data-yv-reveal
        {% endif %}
      >
        {{ page_ref.content }}
      </div>
    {%- endif -%}
  {%- elsif request.design_mode -%}
    {%- liquid
      assign placeholder_heading = heading
      if placeholder_heading == blank
        assign placeholder_heading = 'content.page_placeholder_title' | t | escape
      endif
    -%}
    {%- render 'yv-heading',
      text: placeholder_heading,
      tag: block.settings.heading_tag,
      size: block.settings.heading_size,
      highlight_font: block.settings.highlight_font,
      highlight_color: block.settings.highlight_color,
      alignment: align
    -%}
    <div class="yv-rich-text-page__content rte">
      <p>{{ 'content.page_placeholder_content' | t }}</p>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .yv-rich-text-page {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
    min-width: 0;
  }

  .yv-rich-text-page:empty {
    display: none;
  }

  .yv-rich-text-page__content {
    font-size: var(--yv-text-lg, 1rem);
    line-height: var(--line-height--body-normal, 1.4);
    overflow-wrap: break-word;
  }

  .yv-rich-text-page__content > :first-child {
    margin-block-start: 0;
  }

  .yv-rich-text-page__content > :last-child {
    margin-block-end: 0;
  }
{% endstylesheet %}

{% schema %}
{
