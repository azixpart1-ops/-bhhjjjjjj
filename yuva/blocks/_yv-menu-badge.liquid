{%- doc -%}
  Yuva menu badge: a small coloured label on a first-level menu item.
  Matched to a first-level menu item by its "Menu label" (case-insensitive) and rendered into that
  item by blocks/_header-menu.liquid (snippets/yv-mega-menu.liquid). This file only outputs a hidden
  marker so the theme editor can select the block (assets/yv-header.js opens the matching item).
{%- enddoc -%}

<div
  class="yv-header-block-marker"
  data-yv-menu-label="{{ block.settings.menu_label | strip | downcase | escape }}"
  data-yv-block-kind="badge"
  {{ block.shopify_attributes }}
></div>

{% schema %}
{
  "name": "t:yv.names.menu_badge",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "menu_label",
      "label": "t:yv.header.settings.menu_label",
      "info": "t:yv.header.settings.menu_label_info"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "t:yv.header.settings.badge_text",
      "default": "t:yv.header.defaults.badge_text"
    },
    {
      "type": "header",
      "content": "t:yv.common.content.colors"
    },
    {
      "type": "color",
      "id": "badge_color_text",
      "label": "t:yv.common.settings.text_color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "badge_color_bg",
      "label": "t:yv.common.settings.background_color",
      "default": "#E4002B"
    }
  ],
  "presets": [
    {
      "name": "t:yv.names.menu_badge",
      "settings": {
        "menu_label": "New products"
      }
    }
  ]
}
{% endschema %}
