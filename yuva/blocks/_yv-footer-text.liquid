{%- doc -%}
  Text column of the Yuva footer (sections/yv-footer.liquid): an optional image (a logo, optionally
  linked) above a heading and a description. Below 750px the heading and description become a "+"
  accordion like the Menu columns; without a heading the column is not shown on phones (Yuva rule:
  "This heading is required to show the description on mobile devices").
{%- enddoc -%}

{%- liquid
  assign heading = block.settings.heading | strip
  assign image = block.settings.image
  assign image_width = block.settings.image_width | default: 100
  assign has_content = false
  if heading != blank or block.settings.description != blank or image != blank
    assign has_content = true
  endif
-%}

{%- if has_content or request.design_mode -%}
  <div
    class="yv-footer-col yv-footer-text{% if heading == blank %} yv-footer-col--no-heading{% endif %}"
    {{ block.shopify_attributes }}
  >
    {%- if image != blank -%}
      {%- liquid
        assign image_width_2x = image_width | times: 2
        assign image_widths = image_width | append: ', ' | append: image_width_2x
        assign image_sizes = image_width | append: 'px'
        assign image_alt = image.alt | default: shop.name
      -%}
      {%- capture image_markup -%}
        {{
          image
          | image_url: width: image_width_2x
          | image_tag:
            widths: image_widths,
            sizes: image_sizes,
            width: image_width,
            loading: 'lazy',
            alt: image_alt,
            class: 'yv-footer-text__image'
        }}
      {%- endcapture -%}
      {%- if block.settings.image_link != blank -%}
        <a
          class="yv-footer-text__media"
          href="{{ block.settings.image_link }}"
          style="--yv-footer-image-width: {{ image_width }}px;"
        >
          {{- image_markup -}}
        </a>
      {%- else -%}
        <div
          class="yv-footer-text__media"
          style="--yv-footer-image-width: {{ image_width }}px;"
        >
          {{- image_markup -}}
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- capture text_details -%}
      <details class="yv-footer-col__details">
        <summary class="yv-footer-col__summary{% if heading == blank %} yv-footer-col__summary--empty{% endif %}">
          <span class="yv-footer-col__heading">{{ heading | escape }}</span>
          <span class="yv-footer-col__toggle svg-wrapper icon-plus">
            {{- 'icon-plus.svg' | inline_asset_content -}}
          </span>
        </summary>
        <div class="details-content yv-footer-col__content">
          {%- if block.settings.description != blank -%}
            <div class="yv-footer-text__description rte">{{ block.settings.description }}</div>
          {%- endif -%}
        </div>
      </details>
    {%- endcapture -%}
    {%- if heading != blank or block.settings.description != blank -%}
      {% render 'accordion-custom-component',
        children: text_details,
        class: 'yv-footer-col__accordion',
        disable_on_desktop: true,
        open_by_default_on_desktop: true
      %}
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .yv-footer-text__media {
    display: block;
    width: var(--yv-footer-image-width, 100px);
    max-width: 100%;
    margin-block-end: 20px;
  }

  .yv-footer-text__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .yv-footer-text__description {
    font-size: var(--font-paragraph--size);
    line-height: 1.6;
  }

  .yv-footer-text__description > :first-child {
    margin-block-start: 0;
  }

  .yv-footer-text__description > :last-child {
    margin-block-end: 0;
  }

  .yv-footer-text__description a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .yv-footer-text__description a:hover {
    color: var(--yv-footer-hover);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:yv.names.footer_text",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "t:yv.footer.settings.image_link"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "t:yv.footer.settings.image_width",
      "min": 50,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 100
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "info": "t:yv.footer.settings.text_heading_info",
      "default": "About us"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:yv.common.settings.description"
    }
  ],
  "presets": [
    {
      "name": "t:yv.names.footer_text"
    }
  ]
}
{% endschema %}
