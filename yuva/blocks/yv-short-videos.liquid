{%- doc -%}
  Yuva short videos:
  the heading, then a row of story circles showing each video's preview image. The first circle wears
  the gradient ring; clicking a circle makes it active and opens the foundation's video modal (9:16,
  sound on, controls). Only filled video slots render; the block hides when none is set (the theme
  editor shows sample circles).
{%- enddoc -%}

{%- liquid
  assign video_count = 0
  for i in (1..4)
    assign key = 'video_' | append: i
    if block.settings[key] != blank
      assign video_count = video_count | plus: 1
    endif
  endfor
  assign heading = block.settings.heading
-%}

{%- if video_count > 0 -%}
  <script
    src="{{ 'yv-product.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
  <yv-short-videos-component
    class="yv-short-videos"
    {{ block.shopify_attributes }}
  >
    {%- if heading != blank -%}
      <p class="yv-short-videos__heading">{{ heading | escape }}</p>
    {%- endif -%}
    <ul
      class="yv-short-videos__list"
      role="list"
    >
      {%- assign rendered = 0 -%}
      {%- for i in (1..4) -%}
        {%- liquid
          assign key = 'video_' | append: i
          assign video = block.settings[key]
          if video == blank
            continue
          endif
          assign rendered = rendered | plus: 1
          assign label = 'yv.product.play_video' | t: index: rendered
          if heading != blank
            assign label = heading | append: ' – ' | append: label
          endif
          capture poster
            echo '<span class="yv-short-videos__thumb">'
            if video.preview_image
              echo video.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', class: 'yv-short-videos__image'
            endif
            echo '</span>'
          endcapture
        -%}
        <li class="yv-short-videos__item{% if rendered == 1 %} is-active{% endif %}">
          {% render 'yv-video-modal',
            video: video,
            label: label,
            title: heading,
            trigger: poster,
            trigger_class: 'yv-short-videos__trigger',
            aspect_ratio: '9 / 16'
          %}
        </li>
      {%- endfor -%}
    </ul>
  </yv-short-videos-component>
{%- elsif request.design_mode -%}
  <div
    class="yv-short-videos yv-short-videos--placeholder"
    {{ block.shopify_attributes }}
  >
    {%- if heading != blank -%}
      <p class="yv-short-videos__heading">{{ heading | escape }}</p>
    {%- endif -%}
    <ul
      class="yv-short-videos__list"
      role="list"
    >
      {%- for i in (1..4) -%}
        <li class="yv-short-videos__item{% if forloop.first %} is-active{% endif %}">
          <span class="yv-short-videos__trigger">
            <span class="yv-short-videos__thumb">{{ 'image' | placeholder_svg_tag: 'yv-short-videos__image' }}</span>
          </span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% stylesheet %}
  .yv-short-videos {
    display: block;
  }

  .yv-short-videos__heading {
    margin: 0 0 10px;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: var(--yv-text-lg, 1rem);
    line-height: 1.3;
  }

  .yv-short-videos__list {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .yv-short-videos__item {
    --yv-story-ring: transparent;

    display: block;
    padding: 2px;
    border-radius: 50%;
    background: var(--yv-story-ring);
  }

  .yv-short-videos__item.is-active {
    --yv-story-ring: linear-gradient(320deg, #3d4eac 16%, #b733ae 46%, #da9f33 87%);
  }

  .yv-short-videos .yv-short-videos__trigger {
    display: block;
    position: relative;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 3px solid var(--color-background);
    border-radius: 50%;
    overflow: hidden;
    background: var(--yv-image-bg, #f3efec);
    cursor: pointer;
  }

  .yv-short-videos__thumb {
    display: block;
    width: 100%;
    height: 100%;
  }

  .yv-short-videos__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .yv-short-videos .yv-video-modal__play {
    display: none;
  }

  .yv-short-videos .yv-short-videos__trigger:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .yv-short-videos__trigger .yv-short-videos__image {
      transition: transform 0.4s var(--yv-ease, ease);
    }

    .yv-short-videos__trigger:hover .yv-short-videos__image {
      transform: scale(1.08);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:yv.names.short_videos",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:yv.common.settings.heading",
      "default": "Short videos"
    },
    {
      "type": "video",
      "id": "video_1",
      "label": "t:yv.product.settings.video_1",
      "info": "t:yv.product.info.short_videos"
    },
    {
      "type": "video",
      "id": "video_2",
      "label": "t:yv.product.settings.video_2"
    },
    {
      "type": "video",
      "id": "video_3",
      "label": "t:yv.product.settings.video_3"
    },
    {
      "type": "video",
      "id": "video_4",
      "label": "t:yv.product.settings.video_4"
    }
  ],
  "presets": [
    {
      "name": "t:yv.names.short_videos",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
