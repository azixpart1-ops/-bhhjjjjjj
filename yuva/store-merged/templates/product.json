    "why": {
      "type": "pln-pdp-why",
      "settings": {
        "show_sizes": true,
        "show_vet": true,
        "schema": false,
        "tone": "page"
      }
    },
    "trial": {
      "type": "pln-trial",
      "blocks": {
        "n1": {
          "type": "night",
          "settings": {
            "night": "Night 1",
            "title": "It arrives",
            "text": "Put it where they already sleep, with a blanket that smells of home on top."
          }
        },
        "n2": {
          "type": "night",
          "settings": {
            "night": "Night [mid]",
            "title": "Give them time",
            "text": "Plenty of dogs claim a new bed the first evening. Some take a fortnight. Both are normal, and you've got [nights]."
          }
        },
        "n3": {
          "type": "night",
          "settings": {
            "night": "Night [nights]",
            "title": "Not right? Tell us",
            "text": "Any time inside the [nights] nights. We collect it free from the UK mainland and refund every penny."
          }
        }
      },
      "block_order": [
        "n1",
        "n2",
        "n3"
      ],
      "settings": {
        "heading": "[nights] nights to be sure. At our risk, not yours.",
        "tone": "calm"
      }
    },
    "timeline": {
      "type": "pln-order-timeline",
      "blocks": {
        "o1": {
          "type": "step",
          "settings": {
            "kind": "plain",
            "when": "Today",
            "title": "You order",
            "text": "A few taps. Card, PayPal, Apple Pay or Google Pay, on a secure checkout."
          }
        },
        "o2": {
          "type": "step",
          "settings": {
            "kind": "plain",
            "when": "Within [dispatch] working days",
            "title": "It's dispatched",
            "text": "Own stock leaves us tracked. The tracking number lands in your inbox the moment it does."
          }
        },
        "o3": {
          "type": "step",
          "settings": {
            "kind": "arrives",
            "when": "[transit] working days after dispatch",
            "title": "It arrives",
            "text": "Free over £[threshold]. Put it where they already sleep."
          }
        },
        "o4": {
          "type": "step",
          "settings": {
            "kind": "plain",
            "when": "Night 1 of [nights]",
            "title": "Your trial starts",
            "text": "Not right? Tell us and we collect it free, slept on, hair and all."
          }
        }
      },
      "block_order": [
        "o1",
        "o2",
        "o3",
        "o4"
      ],
      "settings": {
        "eyebrow": "After you order",
        "heading": "What happens next.",
        "lede": "Own-stock beds leave us in [dispatch] working days and arrive [transit] working days later, tracked.",
        "note": "",
        "tone": "page"
      }
    },
    "faq": {
      "type": "pln-faq",
      "blocks": {
        "f1": {
          "type": "qa",
          "settings": {
            "question": "How do I know which size to get?",
            "answer": "<p>Measure nose to base of tail while they're lying down, then add about 20cm. Between two sizes? Go up. The size cards above list the sleeping area where we've measured it. Still unsure? Send us their breed and weight.</p>"
          }
        },
        "f2": {
          "type": "qa",
          "settings": {
            "question": "What if my dog just won't use it?",
            "answer": "<p>Then it comes back. Put it where they already sleep, with a blanket that smells of home on top. If after a fortnight it still isn't right, tell us any time inside the [nights] nights and we collect it free from the UK mainland and refund every penny.</p>"
          }
        },
        "f3": {
          "type": "qa",
          "settings": {
            "question": "Will it help a dog with arthritis or stiff hips?",
            "answer": "<p>Foam spreads their weight so pressure isn't concentrated on hips, elbows and shoulders, and a low front means stepping in rather than climbing over. A bed is for comfort, not a treatment, so please keep talking to your vet.</p>",
            "foam_only": true
          }
        },
        "f4": {
          "type": "qa",
          "settings": {
            "question": "Can I wash it?",
            "answer": "<p>Where the cover comes off, it washes following the care label sewn into it. Coated covers wipe clean. Foam is never machine washed. See the <a href=\"/pages/care-guide\">care guide</a>.</p>"
          }
        },
        "f5": {
          "type": "qa",
          "settings": {
            "question": "When will it arrive?",
            "answer": "<p>The dates for an order placed today are above the button. Own stock is dispatched in [dispatch] working days and delivered [transit] working days later, free over £[threshold].</p>"
          }
        }
      },
      "block_order": [
        "f1",
        "f2",
        "f3",
        "f4",
        "f5"
      ],
      "settings": {
        "eyebrow": "Before you add it",
        "heading": "Questions about this bed.",
        "heading_level": "h2",
        "schema": false,
        "more_label": "Every question, answered",
        "more_link": "shopify://pages/faq",
        "tone": "oat"
      }
    },
