{
  "sections": {
    "breadcrumbs": {
      "type": "yv-breadcrumbs",
      "settings": {
        "alignment": "left",
        "color_set": "primary",
        "section_visibility": "always",
        "spacing_top_desktop": 8,
        "spacing_bottom_desktop": 8,
        "spacing_top_mobile": 8,
        "spacing_bottom_mobile": 32
      }
    },
    "main": {
      "type": "product-information",
      "blocks": {
        "media-gallery": {
          "type": "_product-media-gallery",
          "static": true,
          "settings": {
            "media_presentation": "grid",
            "media_columns": "two",
            "image_gap": 10,
            "large_first_image": false,
            "icons_style": "arrow",
            "slideshow_controls_style": "dots",
            "slideshow_mobile_controls_style": "hint",
            "thumbnail_position": "bottom",
            "thumbnail_width": 64,
            "thumbnail_radius": 6,
            "aspect_ratio": "1/1.25",
            "constrain_to_viewport": false,
            "media_fit": "cover",
            "media_radius": 10,
            "extend_media": false,
            "zoom": false,
            "video_loop": false,
            "hide_variants": false,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "product-details": {
          "type": "_product-details",
          "static": true,
          "settings": {
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "details_position": "flex-start",
            "gap": 20,
            "sticky_details_desktop": true,
            "background_media": "none",
            "video_position": "cover",
            "background_image_position": "cover",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "title": {
              "type": "yv-product-title",
              "settings": {
                "heading_tag": "h1"
              },
              "blocks": {}
            },
            "subtitle": {
              "type": "text",
              "settings": {
                "text": "<p>{{ closest.product.metafields.descriptors.subtitle.value }}</p>",
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "paragraph",
                "font": "var(--font-body--family)",
                "font_size": "",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "price": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "show_from_price": false,
                "show_installments": false,
                "show_tax_info": false,
                "show_shipping_policy": true,
                "type_preset": "h2",
                "width": "100%",
                "alignment": "left",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "padding-block-start": 0,
                "padding-block-end": 10,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "variant_picker": {
              "type": "variant-picker",
              "settings": {
                "variant_style": "buttons",
                "show_swatches": true,
                "swatch_images": false,
                "alignment": "left",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "quantity": {
              "type": "yv-quantity-selector",
              "settings": {},
              "blocks": {}
            },
            "inventory": {
              "type": "yv-inventory-status",
              "settings": {
                "min_inventory": 100,
                "available_text": "In stock",
                "low_text": "||inventory|| in stock"
              },
              "blocks": {}
            },
            "buy_buttons": {
              "type": "buy-buttons",
              "settings": {
                "stacking": true,
                "show_dynamic_checkout": true,
                "show_selling_plans": false,
                "terms_enable": false,
                "show_pickup_availability": false,
                "gift_card_form": true,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {
                "quantity": {
                  "type": "quantity",
                  "static": true,
                  "settings": {},
                  "blocks": {}
                },
                "add-to-cart": {
                  "type": "add-to-cart",
                  "static": true,
                  "settings": {
                    "style_class": "button"
                  },
                  "blocks": {}
                },
                "accelerated-checkout": {
                  "type": "accelerated-checkout",
                  "static": true,
                  "settings": {},
                  "blocks": {}
                }
              },
              "block_order": []
            },
            "short_videos": {
              "type": "yv-short-videos",
              "settings": {
                "heading": "Short videos"
              },
              "blocks": {}
            },
            "specifications": {
              "type": "yv-product-meta",
              "settings": {
                "show_as_tab": false,
                "heading": "Specifications",
                "show_availability": false,
                "show_sku": false,
                "show_vendor": true,
                "show_type": true,
                "show_collections": true,
                "show_tags": false
              },
              "blocks": {}
            },
            "tabs": {
              "type": "yv-product-tabs",
              "settings": {
                "show_description": true,
                "description_open": true,
                "content_style": "tabs",
                "content_alignment": "left",
                "tab_1_heading": "Explore More",
                "tab_1_content": "<p>Discover thoughtfully made essentials designed to make everyday life easier. Each piece is chosen for lasting comfort, easy care and a design that fits naturally into your home, so you can enjoy it for years to come.</p>"
              },
              "blocks": {}
            },
            "pln_promise": {
              "type": "custom-liquid",
              "settings": {
                "custom_liquid": "{% render 'pln-buybox-promise', product: product %}"
              }
            }
          },
          "block_order": [
            "title",
            "subtitle",
            "price",
            "variant_picker",
            "quantity",
            "inventory",
            "buy_buttons",
            "pln_promise",
            "short_videos",
            "specifications",
            "tabs"
          ]
        }
      },
      "settings": {
        "content_width": "content-center-aligned",
        "desktop_media_position": "left",
        "equal_columns": false,
        "limit_details_width": false,
        "gap": 0,
        "enable_sticky_add_to_cart": true,
        "sticky_atc_position": "bottom",
        "mobile_dividers": "none",
        "padding-block-start": 0,
        "padding-block-end": 40
      }
