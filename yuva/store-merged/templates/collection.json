{
  "sections": {
    "intro": {
      "type": "pln-collection-intro",
      "blocks": {
        "c1": {
          "type": "chip",
          "settings": {
            "collection": "orthopaedic-dog-beds",
            "label": "Orthopaedic"
          }
        },
        "c2": {
          "type": "chip",
          "settings": {
            "collection": "dog-beds-for-older-dogs",
            "label": "For older dogs"
          }
        },
        "c3": {
          "type": "chip",
          "settings": {
            "collection": "low-entry-dog-beds",
            "label": "Low step-in"
          }
        },
        "c4": {
          "type": "chip",
          "settings": {
            "collection": "large-dog-beds",
            "label": "Large"
          }
        },
        "c5": {
          "type": "chip",
          "settings": {
            "collection": "extra-large-dog-beds",
            "label": "XL and XXL"
          }
        },
        "c6": {
          "type": "chip",
          "settings": {
            "collection": "nest-dog-beds",
            "label": "Nests"
          }
        },
        "c7": {
          "type": "chip",
          "settings": {
            "collection": "dog-sofa-beds",
            "label": "Sofas"
          }
        },
        "c8": {
          "type": "chip",
          "settings": {
            "collection": "washable-dog-beds",
            "label": "Washable"
          }
        }
      },
      "block_order": [
        "c1",
        "c2",
        "c3",
        "c4",
        "c5",
        "c6",
        "c7",
        "c8"
      ],
      "settings": {
        "show_image": true,
        "tone": "page"
      }
    },
    "start": {
      "type": "pln-need-chips",
      "blocks": {
        "b1": {
          "type": "bed",
          "settings": {
            "product": "the-elterwater-boucle-high-wall-nest-dog-bed",
            "role": "Best for dogs who curl up"
          }
        },
        "b2": {
          "type": "bed",
          "settings": {
            "product": "the-grasmere-bolster-sofa-dog-bed",
            "role": "Best for dogs who lean"
          }
        },
        "b3": {
          "type": "bed",
          "settings": {
            "product": "ambleside-edge-to-edge-memory-foam-bed",
            "role": "Best for dogs who sprawl"
          }
        },
        "b4": {
          "type": "bed",
          "settings": {
            "product": "coniston-orthopaedic-dog-bed",
            "role": "Best for stiff mornings"
          }
        }
      },
      "block_order": [
        "b1",
        "b2",
        "b3",
        "b4"
      ],
      "settings": {
        "heading": "Start with how they sleep",
        "tone": "page"
      }
    },
    "main": {
      "type": "main-collection",
      "blocks": {
        "filters": {
          "type": "filters",
          "static": true,
          "settings": {
            "enable_filtering": true,
            "filter_style": "vertical",
            "filters_layout": "drawer",
            "filter_box_style": "border",
            "filter_width": "centered",
            "text_label_case": "default",
            "show_swatch_label": false,
            "show_filter_label": false,
            "enable_sorting": true,
            "enable_grid_density": true,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0,
            "facets_margin_bottom": 0,
            "facets_margin_right": 0
          },
          "blocks": {}
        },
        "product-card": {
          "type": "_product-card",
          "static": true,
          "settings": {
            "product_card_gap": 5,
            "border": "none",
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "product-card-gallery": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "square",
                "border": "none",
                "border_radius": 0
              }
            },
            "card-vendor": {
              "type": "_yv-card-vendor",
              "settings": {}
            },
            "product-title": {
              "type": "product-title",
              "settings": {
                "width": "100%",
                "max_width": "none",
                "alignment": "left",
                "type_preset": "paragraph",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false
              }
            },
            "price": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "show_from_price": true,
                "show_installments": false,
                "show_tax_info": false,
                "type_preset": "paragraph",
                "width": "100%",
                "alignment": "left"
              }
            },
            "swatches": {
              "type": "swatches",
              "settings": {
                "product_swatches_alignment": "flex-start",
                "product_swatches_alignment_mobile": "flex-start",
                "hide_padding": false,
                "product_swatches_padding_top": 1,
                "product_swatches_padding_bottom": 0,
                "product_swatches_padding_left": 0,
                "product_swatches_padding_right": 0
              }
            },
            "card-extras": {
              "type": "_yv-card-extras",
              "settings": {}
            }
          },
          "block_order": [
            "product-card-gallery",
            "card-vendor",
            "product-title",
            "price",
            "swatches",
            "card-extras"
          ]
        }
      },
      "settings": {
        "layout_type": "grid",
        "product_card_size": "medium",
        "columns_desktop": 4,
        "mobile_product_card_size": "small",
        "enable_infinite_scroll": false,
        "pagination_type": "paged",
        "products_per_page": 12,
        "product_grid_width": "centered",
        "full_width_on_mobile": false,
        "columns_gap_horizontal": 14,
        "columns_gap_vertical": 40,
        "padding-inline-start": 0,
        "padding-inline-end": 0,
        "padding-block-start": 35,
        "padding-block-end": 40
      }
    },
    "trust": {
      "type": "pln-trust-bar",
      "blocks": {
        "t1": {
          "type": "item",
          "settings": {
            "icon": "moon",
            "title": "[nights] nights to decide",
            "text": "Slept on, hair and all. Free collection if it isn't right.",
            "requires": "trial"
          }
        },
        "t2": {
          "type": "item",
          "settings": {
            "icon": "shield",
            "title": "[years]-year foam guarantee",
            "text": "On our memory foam beds, marked on each bed's page.",
            "requires": "guarantee"
          }
        },
        "t3": {
          "type": "item",
          "settings": {
            "icon": "pin",
            "title": "[origin]",
            "text": "A small business in the Dales, with beds named for the Lakes.",
            "requires": "origin"
          }
        },
        "t4": {
          "type": "item",
          "settings": {
            "icon": "truck",
            "title": "[delivery]",
            "text": "Tracked, with a dated delivery line before you order.",
            "requires": "delivery"
          }
        }
      },
      "block_order": [
        "t1",
        "t2",
        "t3",
        "t4"
      ],
      "settings": {
        "tone": "calm"
      }
    },
    "guide": {
      "type": "pln-collection-seo",
      "settings": {
        "schema": true,
        "tone": "oat"
      }
    },
    "sticky": {
      "type": "pln-sticky-bar",
      "settings": {
        "enable": true,
        "link": "shopify://pages/bed-finder",
        "after": ".pln-collection-intro, #shopify-section-intro"
      }
    }
  },
  "order": [
    "intro",
    "start",
    "main",
    "trust",
    "guide",
    "sticky"
  ]
}