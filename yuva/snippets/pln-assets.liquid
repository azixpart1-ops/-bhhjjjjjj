{%- comment -%}
  Loads pln.css + pln-surface.css + pln.js and the window.PLN config every
  pln-* section needs. Rendered at the top of each pln section. Browsers
  fetch each asset once; pln.js guards itself so it runs once.
  20 Oct 2026: scroll-reveal disabled. pln.css hides .pln-reveal until
  pln.js adds .is-in, which left the trial and order timelines blank for
  anyone whose JS stalled (and in full-page captures). Content is now
  always visible; nothing on a product page should depend on an animation.
{%- endcomment -%}
{{ 'pln.css' | asset_url | stylesheet_tag }}
{{ 'pln-surface.css' | asset_url | stylesheet_tag }}
<style>.pln-reveal{opacity:1 !important;transform:none !important;transition:none !important}</style>
<script src="{{ 'pln.js' | asset_url }}" defer="defer"></script>
<script>
  window.PLN = window.PLN || {
    moneyFormat: {{ shop.money_format | json }},
    guaranteeYears: {{ settings.pln_guarantee_years | default: 5 | json }},
    holidays: {{ settings.pln_holidays | default: '' | newline_to_br | split: '<br />' | json }},
    routes: { cart: {{ routes.cart_url | json }}, cartAdd: {{ routes.cart_add_url | json }}, root: {{ routes.root_url | json }} }
  };
</script>
