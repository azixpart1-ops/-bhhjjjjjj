{%- doc -%}
  Yuva site-wide overlays driven by theme settings. Each overlay renders nothing while its setting is off, and none
  renders on the password template. Behaviour lives in assets/yv-overlays.js (loaded globally by
  snippets/scripts.liquid):
  - `<yv-age-gate>`: full-screen verification card. It is rendered open (a non-modal `<dialog open>`)
    so the store never flashes behind it; an inline script removes it at once when the visitor already
    confirmed (cookie `yv_age_verified=1`), and the module upgrades it to a modal dialog that cannot be
    dismissed without a choice. Theme editor: always shown; approving hides it without a cookie.
  - `<yv-privacy-banner>`: cookie consent bar connected to Shopify's Customer Privacy API; shown only
    when `customerPrivacy.shouldShowBanner()` says so (always in the theme editor).
  - `<yv-stickers-component>`: the idle "screensaver" layer; stickers are drawn by the module.
  - `<yv-scroll-top-component>`: floating back-to-top button with the rotating "Scroll to top" ring.
  The newsletter popup is the static section `yv-newsletter-popup`.

  @param {string} [part] - 'age-gate' renders only the age gate (first child of <body>); anything else
    renders the privacy banner, stickers layer and scroll-to-top button (before </body>).

  @example
  {% render 'yv-global-overlays', part: 'age-gate' %}
  {% render 'yv-global-overlays' %}
{%- enddoc -%}

{%- liquid
  assign overlays_allowed = true
  if template.name == 'password'
    assign overlays_allowed = false
  endif
-%}

{%- if overlays_allowed -%}
  {%- if part == 'age-gate' -%}
    {%- if settings.yv_age_verification -%}
      {%- liquid
        assign age_heading = settings.yv_age_heading
        if age_heading == blank
          assign age_heading = 'yv.overlays.age_gate.label' | t
        endif
        assign age_approve = settings.yv_age_approve_text | default: ''
        if age_approve == blank
          assign age_approve = 'yv.overlays.age_gate.approve' | t
        endif
        assign age_decline = settings.yv_age_decline_text | default: ''
        if age_decline == blank
          assign age_decline = 'yv.overlays.age_gate.decline' | t
        endif
        assign age_under_title = settings.yv_age_under_title
        if age_under_title == blank
          assign age_under_title = 'yv.overlays.age_gate.denied' | t
        endif
        assign age_back = settings.yv_age_under_button | default: ''
        if age_back == blank
          assign age_back = 'yv.overlays.age_gate.back' | t
        endif
      -%}
      <yv-age-gate
        class="yv-age-gate"
        data-days="{{ settings.yv_age_days | default: 7 }}"
        {% if request.design_mode %}
          data-design-mode
        {% endif %}
      >
        <dialog
          ref="dialog"
          class="yv-age-gate__dialog"
          aria-labelledby="YvAgeGateHeading"
          aria-describedby="YvAgeGateText"
          open
        >
          <div class="yv-age-gate__card">
            <div
              class="yv-age-gate__view"
              ref="askView"
            >
              {%- if settings.logo != blank -%}
                {{
                  settings.logo
                  | image_url: width: 240
                  | image_tag: class: 'yv-age-gate__logo', width: 120, alt: shop.name, loading: 'eager'
                }}
              {%- endif -%}
              {%- if settings.yv_age_title != blank -%}
                <p class="yv-age-gate__title">{{ settings.yv_age_title | escape }}</p>
              {%- endif -%}
              <h2
                id="YvAgeGateHeading"
                class="yv-age-gate__heading h3"
              >
                {{- age_heading | escape -}}
              </h2>
              <p
                id="YvAgeGateText"
                class="yv-age-gate__text"
                {% if settings.yv_age_subheading == blank %}
                  hidden
                {% endif %}
              >
                {{- settings.yv_age_subheading | escape | newline_to_br -}}
              </p>
              <div class="yv-age-gate__actions">
                <button
                  type="button"
                  class="button yv-age-gate__button"
                  ref="approveButton"
                  on:click="yv-age-gate/approve"
                >
                  {{- age_approve | escape -}}
                </button>
                <button
                  type="button"
                  class="button-secondary yv-age-gate__button"
                  on:click="yv-age-gate/decline"
                >
                  {{- age_decline | escape -}}
                </button>
              </div>
            </div>

            <div
              class="yv-age-gate__view yv-age-gate__view--denied"
              ref="deniedView"
              hidden
            >
              <h2
                class="yv-age-gate__heading h3"
                ref="deniedHeading"
                tabindex="-1"
              >
                {{- age_under_title | escape -}}
              </h2>
              {%- if settings.yv_age_under_text != blank -%}
                <p class="yv-age-gate__text">{{ settings.yv_age_under_text | escape | newline_to_br }}</p>
              {%- endif -%}
              <div class="yv-age-gate__actions">
                <button
                  type="button"
                  class="button-secondary yv-age-gate__button"
                  on:click="yv-age-gate/back"
                >
                  {{- age_back | escape -}}
                </button>
              </div>
            </div>
          </div>
        </dialog>
      </yv-age-gate>
      <script>
        (function () {
          var gate = document.currentScript && document.currentScript.previousElementSibling;
          if (!gate || gate.hasAttribute('data-design-mode')) return;
          if (/(?:^|;\s*)yv_age_verified=1(?:;|$)/.test(document.cookie)) gate.remove();
        })();
      </script>
    {%- endif -%}
  {%- else -%}
    {%- if settings.yv_privacy_banner -%}
      {%- liquid
        assign privacy_accept = settings.yv_privacy_accept | default: ''
        if privacy_accept == blank
          assign privacy_accept = 'yv.overlays.privacy.accept' | t
        endif
        assign privacy_decline = settings.yv_privacy_decline | default: ''
        if privacy_decline == blank
          assign privacy_decline = 'yv.overlays.privacy.decline' | t
        endif
      -%}
      <yv-privacy-banner
        class="yv-privacy-banner"
        role="region"
        aria-label="{{ 'yv.overlays.privacy.label' | t }}"
        {% if request.design_mode %}
          data-design-mode
        {% endif %}
        hidden
      >
        <div class="yv-privacy-banner__inner">
          <div class="yv-privacy-banner__text rte">
            {{- settings.yv_privacy_text -}}
          </div>
          <div class="yv-privacy-banner__actions">
            <button
              type="button"
              class="button yv-privacy-banner__button"
              on:click="yv-privacy-banner/accept"
            >
              {{- privacy_accept | escape -}}
            </button>
            <button
              type="button"
              class="button-secondary yv-privacy-banner__button"
              on:click="yv-privacy-banner/decline"
            >
              {{- privacy_decline | escape -}}
            </button>
          </div>
        </div>
      </yv-privacy-banner>
    {%- endif -%}

    {%- if settings.yv_stickers -%}
      {%- capture sticker_shapes -%}
        {%- for index in (1..6) -%}
          {%- assign sticker_file = 'yv-sticker-' | append: index | append: '.svg' -%}
          {{ sticker_file | asset_url }}
          {%- unless forloop.last %} {% endunless -%}
        {%- endfor -%}
      {%- endcapture -%}
      <yv-stickers-component
        class="yv-stickers"
        data-shapes="{{ sticker_shapes | strip }}"
        aria-hidden="true"
      ></yv-stickers-component>
    {%- endif -%}

    {%- if settings.yv_scroll_top -%}
      {%- liquid
        assign scroll_label = 'yv.overlays.scroll_to_top' | t
        assign scroll_ring = scroll_label | upcase | append: ' • '
        assign scroll_position = settings.yv_scroll_top_position | default: 'right'
      -%}
      <yv-scroll-top-component class="yv-scroll-top yv-edge-widget yv-scroll-top--{{ scroll_position }}{% if settings.yv_scroll_top_text %} yv-scroll-top--text{% endif %}{% if settings.yv_scroll_top_bg %} yv-scroll-top--bg{% endif %}">
        <button
          type="button"
          class="yv-scroll-top__button"
          aria-label="{{ scroll_label | escape }}"
          on:click="/scrollToTop"
        >
          {%- if settings.yv_scroll_top_text -%}
            <svg
              class="yv-scroll-top__ring"
              viewBox="0 0 100 100"
              aria-hidden="true"
              focusable="false"
            >
              <defs>
                <path
                  id="YvScrollTopRing"
                  d="M13 50a37 37 0 1 1 74 0a37 37 0 1 1 -74 0"
                />
              </defs>
              <text>
                <textPath
                  href="#YvScrollTopRing"
                  textLength="228"
                  lengthAdjust="spacing"
                >
                  {{- scroll_ring | append: scroll_ring | escape -}}
                </textPath>
              </text>
            </svg>
          {%- endif -%}
          <span class="yv-scroll-top__icon">
            {%- if settings.yv_scroll_top_svg != blank -%}
              {{- settings.yv_scroll_top_svg -}}
            {%- else -%}
              {%- render 'yv-icon', name: 'arrow-up', size: 19, stroke: 1.75 -%}
            {%- endif -%}
          </span>
        </button>
      </yv-scroll-top-component>
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  /* ------------------------------------------------------------------ age verification */

  .yv-age-gate__dialog[open] {
    position: fixed;
    inset: 0;
    z-index: 2147483000;
    display: grid;
    place-items: center;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 4vw;
    border: 0;
    background: rgb(0 0 0 / 0.85);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    color: var(--color-foreground);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .yv-age-gate__dialog::backdrop {
    background: transparent;
  }

  html:has(.yv-age-gate__dialog[open]) {
    overflow: hidden;
  }

  @media (min-width: 990px) {
    html:has(.yv-age-gate__dialog[open]) .page-wrapper {
      overflow: hidden;
    }
  }

  .yv-age-gate__card {
    width: min(480px, 100%);
    padding: 40px;
    border-radius: var(--yv-card-radius, 25px);
    background: var(--yv-card-bg, var(--color-background));
    color: var(--color-foreground);
    text-align: center;
    box-shadow: 0 20px 60px rgb(0 0 0 / 0.25);
  }

  .yv-age-gate__view {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .yv-age-gate__view[hidden] {
    display: none;
  }

  .yv-age-gate__logo {
    width: 120px;
    height: auto;
    margin-block-end: 8px;
  }

  .yv-age-gate__title {
    margin: 0;
    color: var(--yv-theme-color, currentColor);
    font-size: var(--yv-text-sm, 12px);
    letter-spacing: 2px;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .yv-age-gate__heading {
    max-width: 100%;
    margin: 0;
    overflow-wrap: anywhere;
    outline: none;
  }

  .yv-age-gate__text {
    max-width: 36ch;
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70, 0.7));
  }

  .yv-age-gate__text[hidden] {
    display: none;
  }

  .yv-age-gate__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    width: 100%;
    margin-block-start: 16px;
  }

  .yv-age-gate__button {
    min-width: 150px;
  }

  .yv-age-gate.is-leaving .yv-age-gate__dialog {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    .yv-age-gate__card {
      animation: yv-overlay-fade-up 0.5s var(--yv-ease-out, ease-out) both;
    }

    .yv-age-gate__view:not([hidden]) {
      animation: yv-overlay-fade 0.3s ease both;
    }
  }

  @media (max-width: 749px) {
    .yv-age-gate__card {
      padding: 32px 20px;
    }

    .yv-age-gate__actions {
      flex-direction: column;
    }

    .yv-age-gate__button {
      width: 100%;
    }
  }

  /* ------------------------------------------------------------------ cookie privacy banner */

  .yv-privacy-banner {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: calc(var(--layer-overlay, 16) + 1);
    padding: 16px 20px calc(16px + var(--safe-area-inset-bottom, 0px));
    background: var(--yv-card-bg, var(--color-background));
    color: var(--color-foreground);
    box-shadow: 0 -4px 16px rgb(0 0 0 / 0.08);
    translate: 0 100%;
    visibility: hidden;
  }

  .yv-privacy-banner[hidden] {
    display: none;
  }

  .yv-privacy-banner.is-open {
    translate: 0 0;
    visibility: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    .yv-privacy-banner {
      transition: translate 0.3s var(--yv-ease, ease), visibility 0s linear 0.3s;
    }

    .yv-privacy-banner.is-open {
      transition: translate 0.3s var(--yv-ease, ease);
    }
  }

  .yv-privacy-banner__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px 30px;
    width: min(100%, var(--narrow-page-width, 1270px));
    margin-inline: auto;
  }

  .yv-privacy-banner__text {
    flex: 1 1 auto;
    min-width: 0;
  }

  .yv-privacy-banner__text > * {
    margin-block: 0;
  }

  .yv-privacy-banner__text > * + * {
    margin-block-start: 0.5em;
  }

  .yv-privacy-banner__actions {
    display: flex;
    flex: none;
    gap: 10px;
  }

  .yv-privacy-banner__button[aria-busy='true'] {
    cursor: progress;
    opacity: 0.6;
  }

  @media (max-width: 749px) {
    .yv-privacy-banner__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
    }

    .yv-privacy-banner__button {
      flex: 1 1 0;
      min-width: 0;
    }
  }

  /* ------------------------------------------------------------------ stickers */

  /* Above the page and the sticky / transparent header group (--layer-menu-drawer), below dialogs
     (top layer) and Horizon's temporary layer. */
  .yv-stickers {
    position: fixed;
    inset: 0;
    z-index: calc(var(--layer-menu-drawer, 18) + 1);
    overflow: hidden;
    pointer-events: none;
  }

  .yv-stickers:empty {
    display: none;
  }

  .yv-sticker {
    position: absolute;
    inset-block-start: var(--yv-sticker-y, 0);
    inset-inline-start: var(--yv-sticker-x, 0);
    width: var(--yv-sticker-size, 100px);
    aspect-ratio: 1;
    rotate: var(--yv-sticker-rotate, 0deg);
    filter: drop-shadow(0 6px 10px rgb(0 0 0 / 0.18));
    animation: yv-sticker-pop 0.5s var(--yv-sticker-delay, 0ms) var(--yv-ease-out, ease-out) both;
  }

  .yv-sticker.is-leaving {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .yv-sticker__shape {
    position: absolute;
    inset: 0;
    background: var(--yv-sticker-bg, #ffd84d);
    -webkit-mask: var(--yv-sticker-mask) center / contain no-repeat;
    mask: var(--yv-sticker-mask) center / contain no-repeat;
  }

  .yv-sticker__shape svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .yv-sticker__edge {
    stroke: #fff;
    stroke-width: 4;
  }

  .yv-sticker__detail {
    stroke: currentColor;
    stroke-width: var(--yv-sticker-line, 5);
  }

  /* ------------------------------------------------------------------ scroll to top */

  .yv-scroll-top {
    --yv-scroll-top-size: 40px;
    --yv-scroll-top-icon: 16px;
    --yv-scroll-top-base: 50px;

    inset-block-end: calc(
      var(--yv-privacy-banner-height, 0px) +
        max(
          var(--yv-scroll-top-base),
          var(--yv-mobile-dock-offset, 0px) + 13px,
          var(--yv-bottom-bar-offset, 0px) + 10px
        )
    );
    inset-inline-end: 20px;
    width: var(--yv-scroll-top-size);
    height: var(--yv-scroll-top-size);
    opacity: 0;
    visibility: hidden;
    translate: 0 10px;
    pointer-events: none;
  }

  .yv-scroll-top[data-visible] {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .yv-scroll-top {
      transition: opacity 0.3s ease, translate 0.3s ease, inset-block-end 0.4s ease, visibility 0s linear 0.3s;
    }

    .yv-scroll-top[data-visible] {
      transition: opacity 0.3s ease, translate 0.3s ease, inset-block-end 0.4s ease;
    }
  }

  .yv-scroll-top--left {
    inset-inline: 20px auto;
  }

  .yv-scroll-top--center {
    inset-inline: 50% auto;
    margin-inline-start: calc(var(--yv-scroll-top-size) / -2);
  }

  @media (min-width: 750px) {
    .yv-scroll-top {
      --yv-scroll-top-size: 50px;
      --yv-scroll-top-icon: 19px;
    }

    .yv-scroll-top--text {
      --yv-scroll-top-size: 60px;
    }
  }

  .yv-scroll-top__button {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--color-foreground);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .yv-scroll-top__button:focus-visible {
    outline: 2px solid var(--yv-theme-color, currentColor);
    outline-offset: 3px;
  }

  .yv-scroll-top:not(.yv-scroll-top--text):not(.yv-scroll-top--bg) .yv-scroll-top__button {
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-15, 0.15));
    background: var(--color-background);
  }

  .yv-scroll-top__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: var(--yv-theme-color, currentColor);
    font-family: var(--font-body--family);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .yv-scroll-top__ring {
      animation: yv-scroll-top-spin 5s linear infinite;
    }
  }

  .yv-scroll-top__icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
  }

  .yv-scroll-top--text .yv-scroll-top__icon {
    width: 58%;
    height: 58%;
  }

  /* Transparent ring, as in Yuva. Over the footer (often dark) a frosted disc in the page colour
     keeps the ring text and arrow legible (assets/yv-overlays.js sets data-over-footer). */
  .yv-scroll-top--text:not(.yv-scroll-top--bg) .yv-scroll-top__button {
    background: transparent;
  }

  .yv-scroll-top--text:not(.yv-scroll-top--bg)[data-over-footer] .yv-scroll-top__button {
    background: rgb(var(--color-background-rgb, 255 255 255) / 0.9);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .yv-scroll-top--text:not(.yv-scroll-top--bg) .yv-scroll-top__button {
      transition: background-color 0.3s ease;
    }
  }

  .yv-scroll-top--bg .yv-scroll-top__icon {
    background: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
  }

  .yv-scroll-top__icon svg {
    width: var(--yv-scroll-top-icon);
    height: var(--yv-scroll-top-icon);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .yv-scroll-top__icon svg {
      transition: translate 0.3s ease;
    }

    .yv-scroll-top__button:hover .yv-scroll-top__icon svg {
      translate: 0 -3px;
    }
  }

  /* ------------------------------------------------------------------ shared motion */

  @keyframes yv-overlay-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes yv-overlay-fade-up {
    from {
      opacity: 0;
      translate: 0 30px;
    }
  }

  @keyframes yv-sticker-pop {
    0% {
      scale: 0;
    }

    60% {
      scale: 1.1;
    }

    100% {
      scale: 1;
    }
  }

  @keyframes yv-scroll-top-spin {
    to {
      rotate: 360deg;
    }
  }

  @media print {
    .yv-privacy-banner,
    .yv-stickers,
    .yv-scroll-top {
      display: none;
    }
  }
{% endstylesheet %}
