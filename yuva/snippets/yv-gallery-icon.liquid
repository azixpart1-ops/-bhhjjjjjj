{%- doc -%}
  Category line icons for the Gallery carousel strip (sections/yv-gallery-carousel.liquid): original
  drawings on the same 24×24 grid as `yv-icon` (1.5 stroke, round caps and joins, `currentColor`).
  Names that are not drawn here (camera, gift, heart, star, leaf, home, store, bag, …) are passed on
  to `yv-icon`, so any Yuva line icon works too. Blank or 'none' renders nothing.

  The SVG is decorative (`aria-hidden="true"`); the item's heading labels the link.

  @param {string} name - Icon name, e.g. 'smartphone', 'watch', 'earbuds', 'drone', 'paw'.
  @param {number} [size] - Width and height in px. Default: 40
  @param {string} [class] - Extra classes for the <svg>.

  @example
  {% render 'yv-gallery-icon', name: block.settings.icon, size: 40, class: 'yv-gallery-item__icon' %}
{%- enddoc -%}

{%- liquid
  assign icon_size = size | default: 40
  assign key = name | default: '' | downcase | strip | replace: '_', '-'

  capture paths
    case key
      when 'smartphone', 'mobile'
        echo '<rect x="6.75" y="2.75" width="10.5" height="18.5" rx="2.25"/><path d="M10.5 5.5h3M11 18.25h2"/>'
      when 'watch', 'smartwatch'
        echo '<rect x="6.25" y="6.25" width="11.5" height="11.5" rx="3"/><path d="M8.75 6.25 9.5 2.75h5l.75 3.5M8.75 17.75l.75 3.5h5l.75-3.5"/><path d="M12 9.25V12l1.75 1.25"/>'
      when 'earbuds'
        echo '<circle cx="7.5" cy="7.25" r="3.25"/><path d="M8.75 10.25v8.5a1.25 1.25 0 0 1-2.5 0v-8.4"/><circle cx="16.5" cy="7.25" r="3.25"/><path d="M15.25 10.25v8.5a1.25 1.25 0 0 0 2.5 0v-8.4"/>'
      when 'headphones'
        echo '<path d="M4.75 15.5V12a7.25 7.25 0 0 1 14.5 0v3.5"/><rect x="3.75" y="13.25" width="4" height="6.75" rx="1.5"/><rect x="16.25" y="13.25" width="4" height="6.75" rx="1.5"/>'
      when 'microphone'
        echo '<rect x="9" y="2.75" width="6" height="11" rx="3"/><path d="M5.75 11a6.25 6.25 0 0 0 12.5 0M12 17.25v4M9 21.25h6"/>'
      when 'mouse'
        echo '<rect x="6.25" y="2.75" width="11.5" height="18.5" rx="5.75"/><path d="M12 6.25v3"/>'
      when 'speaker'
        echo '<rect x="5.75" y="2.75" width="12.5" height="18.5" rx="2.25"/><circle cx="12" cy="14.25" r="3.5"/><circle cx="12" cy="7.25" r="1.25"/>'
      when 'charger'
        echo '<rect x="6.75" y="7.75" width="10.5" height="9.5" rx="2"/><path d="M9.75 7.75v-4M14.25 7.75v-4M12 17.25v4"/><path d="m12.75 9.75-2 2.75h2.5l-2 2.75"/>'
      when 'drone'
        echo '<rect x="9.25" y="9.75" width="5.5" height="4.5" rx="1.25"/><path d="M9.25 10.25 6.5 7.25M14.75 10.25l2.75-3M9.25 13.75 6.5 16.75M14.75 13.75l2.75 3"/><path d="M3.5 6.5H9M15 6.5h5.5M3.5 17.5H9M15 17.5h5.5"/>'
      when 'printer'
        echo '<path d="M7.25 9V3.75h9.5V9"/><path d="M7.25 17H4.75a1.5 1.5 0 0 1-1.5-1.5v-5a1.5 1.5 0 0 1 1.5-1.5h14.5a1.5 1.5 0 0 1 1.5 1.5v5a1.5 1.5 0 0 1-1.5 1.5h-2.5"/><rect x="7.25" y="13.75" width="9.5" height="6.5" rx=".5"/><path d="M17 11.75h.5"/>'
      when 'vacuum', 'robot-vacuum'
        echo '<circle cx="12" cy="12" r="8.75"/><path d="M5.1 9.25a7.6 7.6 0 0 1 13.8 0"/><circle cx="12" cy="13.25" r="2.25"/>'
      when 'household', 'washing-machine'
        echo '<rect x="4.75" y="2.75" width="14.5" height="18.5" rx="2"/><path d="M4.75 7.25h14.5M7.75 5h1.5M15.75 5h.5"/><circle cx="12" cy="14" r="4"/><path d="M9.5 14.75c1-.75 2-.75 2.5 0s1.5.75 2.5 0"/>'
      when 'laptop'
        echo '<rect x="4.75" y="5.25" width="14.5" height="10" rx="1.25"/><path d="M2.75 18.75h18.5"/>'
      when 'tv', 'television'
        echo '<rect x="2.75" y="5.25" width="18.5" height="12" rx="1.5"/><path d="M8.5 20.75h7M12 17.25v3.5"/>'
      when 'gamepad', 'gaming'
        echo '<path d="M7.5 7.75h9a4.75 4.75 0 0 1 4.6 5.9l-.85 3.4a2.4 2.4 0 0 1-4.15.95L14.6 16.25H9.4L7.9 18a2.4 2.4 0 0 1-4.15-.95l-.85-3.4a4.75 4.75 0 0 1 4.6-5.9Z"/><path d="M8 10.75v3M6.5 12.25h3M15.5 11.25h.01M17.25 13h.01"/>'
      when 'shirt', 't-shirt'
        echo '<path d="M8.75 3.75 3.25 6.5l1.75 4 2.25-.75v10.5h9.5V9.75l2.25.75 1.75-4-5.5-2.75a3.25 3.25 0 0 1-6.5 0Z"/>'
      when 'dress'
        echo '<path d="M9.25 2.75v3.5L7.5 9.75l1.5 1.5-4 10h14l-4-10 1.5-1.5-1.75-3.5v-3.5"/><path d="M9.25 6.25c1.5 1 4 1 5.5 0"/>'
      when 'shoe', 'sneaker'
        echo '<path d="M3.25 17.25V8.25l3.5.5 2 2.5 3-1 2.25 2.5 5.25 1.5a2 2 0 0 1 1.5 1.95v1.05a1 1 0 0 1-1 1H4.25a1 1 0 0 1-1-1Z"/><path d="M3.25 15.25h17.5"/>'
      when 'glasses', 'sunglasses'
        echo '<circle cx="6.75" cy="14" r="3.75"/><circle cx="17.25" cy="14" r="3.75"/><path d="M10.5 13.5a2.25 2.25 0 0 1 3 0M3 13l1.25-5.25M21 13l-1.25-5.25"/>'
      when 'paw', 'pet'
        echo '<path d="M12 12.75c-2.6 0-5 2.9-5 5.1 0 1.6 1.2 2.4 2.6 2.4.9 0 1.6-.45 2.4-.45s1.5.45 2.4.45c1.4 0 2.6-.8 2.6-2.4 0-2.2-2.4-5.1-5-5.1Z"/><circle cx="5.25" cy="10.75" r="1.75"/><circle cx="9.25" cy="6.25" r="1.75"/><circle cx="14.75" cy="6.25" r="1.75"/><circle cx="18.75" cy="10.75" r="1.75"/>'
      when 'lamp'
        echo '<path d="M8 3.25h8l2.75 8H5.25Z"/><path d="M12 11.25v8.5M8.25 20.75h7.5"/>'
      when 'sofa', 'furniture'
        echo '<path d="M5.25 10.25V7.5a2.25 2.25 0 0 1 2.25-2.25h9a2.25 2.25 0 0 1 2.25 2.25v2.75"/><path d="M3.25 12.25a2 2 0 0 1 4 0v1.5h9.5v-1.5a2 2 0 0 1 4 0v5.5H3.25Z"/><path d="M5.25 17.75v2M18.75 17.75v2"/>'
      when 'cup', 'coffee'
        echo '<path d="M4.75 8.75h11.5v5.5a5 5 0 0 1-5 5h-1.5a5 5 0 0 1-5-5Z"/><path d="M16.25 10h1.25a2.25 2.25 0 0 1 0 4.5h-1.25M8 2.75v3M11.25 2.75v3"/>'
      when 'ring', 'jewelry'
        echo '<circle cx="12" cy="14.5" r="6.25"/><path d="m9.25 4.75 1.25-2h3l1.25 2-2.75 3.5Z"/>'
    endcase
  endcapture
-%}

{%- if paths != blank -%}
  <svg
    class="yv-icon yv-icon--{{ key }}{% if class != blank %} {{ class }}{% endif %}"
    width="{{ icon_size }}"
    height="{{ icon_size }}"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
    style="--yv-icon-size: {{ icon_size }}px;"
  >
    {{- paths -}}
  </svg>
{%- elsif key != blank and key != 'none' -%}
  {% render 'yv-icon', name: key, size: icon_size, class: class %}
{%- endif -%}
