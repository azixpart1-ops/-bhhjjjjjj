{%- doc -%}
  Yuva line icons: original drawings on a 24×24 grid, 1.5 stroke, round caps and joins,
  `currentColor`. Names accept hyphens or underscores (`shield_check` = `shield-check`) and a few
  aliases (see build/api/core.md for the full list). Social and other brand glyphs (facebook,
  instagram, x, tiktok, youtube, pinterest, …) and any other Horizon icon name fall back to
  Horizon's `icon` snippet (filled, 20×20 grid). Unknown names render nothing.

  The SVG is decorative (`aria-hidden="true"`); label the control that contains it.

  @param {string} name - Icon name, e.g. 'truck', 'shield-check', 'arrow-right', 'facebook'.
  @param {number} [size] - Width and height in px. Default: 24
  @param {string} [class] - Extra classes for the <svg>.
  @param {number} [stroke] - Stroke width in grid units (1.5 by default; line icons only).

  @example
  {% render 'yv-icon', name: 'truck', size: 26, class: 'yv-text-with-icons__icon' %}
{%- enddoc -%}

{%- liquid
  assign icon_size = size | default: 24
  assign icon_stroke = stroke | default: 1.5
  assign raw_key = name | default: '' | downcase | strip
  assign key = raw_key | replace: '_', '-'

  case key
    when 'support', 'headphones'
      assign key = 'headset'
    when 'chat-bubble', 'message'
      assign key = 'chat'
    when 'envelope', 'email', 'newsletter'
      assign key = 'mail'
    when 'location', 'pin'
      assign key = 'map-pin'
    when 'price-tag', 'label'
      assign key = 'tag'
    when 'credit-card', 'payment'
      assign key = 'card'
    when 'account', 'profile'
      assign key = 'user'
    when 'x-mark', 'cross'
      assign key = 'close'
    when 'secure', 'security'
      assign key = 'shield-check'
    when 'shipping', 'delivery'
      assign key = 'truck'
    when 'returns', 'exchange'
      assign key = 'return'
    when 'like', 'wishlist'
      assign key = 'heart'
    when 'view', 'quick-view'
      assign key = 'eye'
    when 'sliders'
      assign key = 'filter'
    when 'money-back', 'money'
      assign key = 'cash'
    when 'package', 'parcel'
      assign key = 'box'
    when 'time'
      assign key = 'clock'
    when 'discount', 'sale'
      assign key = 'percent'
    when 'world', 'international'
      assign key = 'globe'
    when 'sync'
      assign key = 'refresh'
    when 'warning', 'error'
      assign key = 'alert'
    when 'shop'
      assign key = 'store'
  endcase

  capture paths
    case key
      when 'truck'
        echo '<rect x="2.75" y="5.75" width="11" height="9.75" rx="1"/><path d="M13.75 9.25h3.7c.3 0 .6.15.8.4l2.5 3.3v2.55h-7"/><circle cx="7" cy="17.25" r="1.75"/><circle cx="17" cy="17.25" r="1.75"/>'
      when 'return'
        echo '<path d="M4.75 12a7.25 7.25 0 1 0 2.2-5.2"/><path d="M4.5 4.25v3.5H8"/>'
      when 'refresh'
        echo '<path d="M19.25 10.5A7.5 7.5 0 0 0 5.6 7.75M4.75 13.5a7.5 7.5 0 0 0 13.65 2.75"/><path d="M5.25 3.75v4h4M18.75 20.25v-4h-4"/>'
      when 'lock'
        echo '<rect x="4.75" y="10.25" width="14.5" height="10" rx="2"/><path d="M8 10.25V7.5a4 4 0 0 1 8 0v2.75M12 14.25v2"/>'
      when 'headset'
        echo '<path d="M4.75 14v-2a7.25 7.25 0 0 1 14.5 0v2"/><rect x="3.25" y="13" width="3.75" height="5.5" rx="1.25"/><rect x="17" y="13" width="3.75" height="5.5" rx="1.25"/><path d="M18.75 18.5v.5a2.5 2.5 0 0 1-2.5 2.5h-3"/>'
      when 'gift'
        echo '<rect x="3.75" y="8.25" width="16.5" height="4" rx="1"/><path d="M5.25 12.25v7.5a1 1 0 0 0 1 1h11.5a1 1 0 0 0 1-1v-7.5M12 8.25v12.5"/><path d="M12 8.25c-1.5-3.5-5.5-4-5.5-1.5 0 1.5 2.5 1.5 5.5 1.5Zm0 0c1.5-3.5 5.5-4 5.5-1.5 0 1.5-2.5 1.5-5.5 1.5Z"/>'
      when 'chat'
        echo '<path d="M20.25 11.5c0 4-3.7 7.25-8.25 7.25-1.1 0-2.1-.18-3.05-.52l-4.7 1.52 1.3-3.6c-1.15-1.25-1.8-2.85-1.8-4.65 0-4 3.7-7.25 8.25-7.25s8.25 3.25 8.25 7.25Z"/><path d="M8.5 11.5h.01M12 11.5h.01M15.5 11.5h.01"/>'
      when 'phone'
        echo '<path d="M8.6 3.75H6.25a2 2 0 0 0-2 2.15c.7 8.2 5.65 13.15 13.85 13.85a2 2 0 0 0 2.15-2v-2.35a1 1 0 0 0-.72-.96l-3.06-.9a1 1 0 0 0-1 .26l-1.27 1.27a12.1 12.1 0 0 1-5.27-5.27l1.27-1.27a1 1 0 0 0 .26-1l-.9-3.06a1 1 0 0 0-.96-.72Z"/>'
      when 'mail'
        echo '<rect x="3.25" y="5.75" width="17.5" height="12.5" rx="2"/><path d="m4 7.25 8 6 8-6"/>'
      when 'map-pin'
        echo '<path d="M12 21s-6.75-5.6-6.75-11a6.75 6.75 0 0 1 13.5 0c0 5.4-6.75 11-6.75 11Z"/><circle cx="12" cy="10" r="2.5"/>'
      when 'clock'
        echo '<circle cx="12" cy="12" r="8.25"/><path d="M12 7.5V12l3 2"/>'
      when 'stopwatch'
        echo '<circle cx="12" cy="13.5" r="7"/><path d="M12 13.5V10M10 3.25h4M12 3.25v3.25M18.25 7.25l1.25-1.25"/>'
      when 'calendar'
        echo '<rect x="3.75" y="5.25" width="16.5" height="15" rx="2"/><path d="M3.75 9.75h16.5M8 3.25v4M16 3.25v4"/>'
      when 'star'
        echo '<path d="M12 3.35 14.29 9.44 20.8 9.74 15.71 13.81 17.44 20.08 12 16.5 6.56 20.08 8.29 13.81 3.2 9.74 9.71 9.44Z"/>'
      when 'heart'
        echo '<path d="M12 20s-7.5-4.35-7.5-10a4.25 4.25 0 0 1 7.5-2.75A4.25 4.25 0 0 1 19.5 10c0 5.65-7.5 10-7.5 10Z"/>'
      when 'check'
        echo '<path d="m5 12.5 4.5 4.5L19 7.5"/>'
      when 'check-circle'
        echo '<circle cx="12" cy="12" r="8.25"/><path d="m8.25 12.25 2.5 2.5 5-5"/>'
      when 'shield'
        echo '<path d="M12 3.25 4.75 6v5.5c0 4.6 3.1 8 7.25 9.25 4.15-1.25 7.25-4.65 7.25-9.25V6Z"/>'
      when 'shield-check'
        echo '<path d="M12 3.25 4.75 6v5.5c0 4.6 3.1 8 7.25 9.25 4.15-1.25 7.25-4.65 7.25-9.25V6Z"/><path d="m9 12 2.25 2.25L15.25 10"/>'
      when 'leaf'
        echo '<path d="M5 19c0-8.5 5.5-14 15-14 0 9.5-5.5 15-14 15"/><path d="M5 19.75 13 11.5"/>'
      when 'tag'
        echo '<path d="M3.75 12.4V4.75a1 1 0 0 1 1-1h7.65a1 1 0 0 1 .7.3l7.5 7.5a1 1 0 0 1 0 1.4l-7.65 7.65a1 1 0 0 1-1.4 0l-7.5-7.5a1 1 0 0 1-.3-.7Z"/><circle cx="8.25" cy="8.25" r="1.25"/>'
      when 'percent'
        echo '<path d="M18.5 5.5 5.5 18.5"/><circle cx="7.25" cy="7.25" r="2.25"/><circle cx="16.75" cy="16.75" r="2.25"/>'
      when 'card'
        echo '<rect x="2.75" y="5.25" width="18.5" height="13.5" rx="2"/><path d="M2.75 9.75h18.5M6.25 15h3.5"/>'
      when 'cash'
        echo '<rect x="2.75" y="6.25" width="18.5" height="11.5" rx="1.5"/><circle cx="12" cy="12" r="2.5"/><path d="M6 9.5v5M18 9.5v5"/>'
      when 'globe'
        echo '<circle cx="12" cy="12" r="8.25"/><path d="M3.75 12h16.5M12 3.75c2.2 2.3 3.25 5 3.25 8.25S14.2 17.95 12 20.25C9.8 17.95 8.75 15.25 8.75 12S9.8 6.05 12 3.75Z"/>'
      when 'smile'
        echo '<circle cx="12" cy="12" r="8.25"/><path d="M8.5 14.25c.85 1.2 2.1 1.75 3.5 1.75s2.65-.55 3.5-1.75M9.25 9.5v.75M14.75 9.5v.75"/>'
      when 'ruler'
        echo '<rect x="2.75" y="7.75" width="18.5" height="8.5" rx="1"/><path d="M6.75 7.75v3M10 7.75v4.25M13.25 7.75v3M16.5 7.75v4.25"/>'
      when 'box'
        echo '<path d="M12 3.25 20.25 7.5v9L12 20.75 3.75 16.5v-9Z"/><path d="M3.75 7.5 12 11.75l8.25-4.25M12 11.75v9"/>'
      when 'eye'
        echo '<path d="M2.75 12S6 5.75 12 5.75 21.25 12 21.25 12 18 18.25 12 18.25 2.75 12 2.75 12Z"/><circle cx="12" cy="12" r="3"/>'
      when 'play'
        echo '<path d="M8 5.5v13l10.5-6.5Z"/>'
      when 'play-circle'
        echo '<circle cx="12" cy="12" r="8.25"/><path d="M10.25 8.75v6.5l5.25-3.25Z"/>'
      when 'pause'
        echo '<path d="M8.5 5.5v13M15.5 5.5v13"/>'
      when 'arrow-right'
        echo '<path d="M4.5 12h15M13.5 6l6 6-6 6"/>'
      when 'arrow-left'
        echo '<path d="M19.5 12h-15M10.5 6l-6 6 6 6"/>'
      when 'arrow-up'
        echo '<path d="M12 19.5v-15M6 10.5l6-6 6 6"/>'
      when 'arrow-down'
        echo '<path d="M12 4.5v15M6 13.5l6 6 6-6"/>'
      when 'arrow-up-right'
        echo '<path d="M7 17 17 7M8.5 7H17v8.5"/>'
      when 'chevron-down'
        echo '<path d="m6 9 6 6 6-6"/>'
      when 'chevron-up'
        echo '<path d="m6 15 6-6 6 6"/>'
      when 'chevron-left'
        echo '<path d="m15 6-6 6 6 6"/>'
      when 'chevron-right'
        echo '<path d="m9 6 6 6-6 6"/>'
      when 'plus'
        echo '<path d="M12 5v14M5 12h14"/>'
      when 'minus'
        echo '<path d="M5 12h14"/>'
      when 'close'
        echo '<path d="m6 6 12 12M18 6 6 18"/>'
      when 'search'
        echo '<circle cx="10.75" cy="10.75" r="6.5"/><path d="m15.5 15.5 4.75 4.75"/>'
      when 'user'
        echo '<circle cx="12" cy="8" r="4"/><path d="M4.25 20.25c.7-3.9 3.85-6.25 7.75-6.25s7.05 2.35 7.75 6.25"/>'
      when 'bag'
        echo '<path d="M5.25 8.25h13.5l-.9 11.6a1 1 0 0 1-1 .9H7.15a1 1 0 0 1-1-.9Z"/><path d="M8.75 10.5V7a3.25 3.25 0 0 1 6.5 0v3.5"/>'
      when 'cart'
        echo '<path d="M2.75 3.75h2.4l2.1 11h10.5l2-7.75H6.2"/><circle cx="9" cy="19" r="1.5"/><circle cx="17" cy="19" r="1.5"/>'
      when 'grid'
        echo '<rect x="4" y="4" width="6.5" height="6.5" rx="1"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1"/>'
      when 'home'
        echo '<path d="M4.25 10.25 12 4l7.75 6.25v9a1 1 0 0 1-1 1h-4.5v-6h-4.5v6h-4.5a1 1 0 0 1-1-1Z"/>'
      when 'store'
        echo '<path d="M3.5 9.25 5.25 4.25h13.5l1.75 5"/><path d="M3.5 9.25h17a2.85 2.85 0 0 1-5.65 0 2.85 2.85 0 0 1-5.7 0 2.85 2.85 0 0 1-5.65 0"/><path d="M5 12v8h14v-8M10 20v-4.5h4V20"/>'
      when 'filter'
        echo '<path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/>'
      when 'menu'
        echo '<path d="M4 7h16M4 12h16M4 17h16"/>'
      when 'share'
        echo '<circle cx="17.5" cy="5.75" r="2.25"/><circle cx="6.5" cy="12" r="2.25"/><circle cx="17.5" cy="18.25" r="2.25"/><path d="m8.5 10.9 7-4M8.5 13.1l7 4"/>'
      when 'external'
        echo '<path d="M13.5 4.75h5.75v5.75M19.25 4.75l-8 8M17.25 13.75v4.5a1 1 0 0 1-1 1H5.75a1 1 0 0 1-1-1V7.75a1 1 0 0 1 1-1h4.5"/>'
      when 'plane'
        echo '<path d="M20.5 3.5 3.5 10.25l6.75 3.25 3.25 6.75Z"/><path d="m10.25 13.5 4-4"/>'
      when 'info'
        echo '<circle cx="12" cy="12" r="8.25"/><path d="M12 11v5.25M12 7.75v.5"/>'
      when 'alert'
        echo '<circle cx="12" cy="12" r="8.25"/><path d="M12 7.5v5.25M12 15.75v.5"/>'
      when 'sparkle'
        echo '<path d="M12 3.5c.6 4.4 2.1 5.9 6.5 6.5-4.4.6-5.9 2.1-6.5 6.5-.6-4.4-2.1-5.9-6.5-6.5 4.4-.6 5.9-2.1 6.5-6.5Z"/><path d="M18.5 15.5c.25 1.6.9 2.25 2.5 2.5-1.6.25-2.25.9-2.5 2.5-.25-1.6-.9-2.25-2.5-2.5 1.6-.25 2.25-.9 2.5-2.5Z"/>'
      when 'lightning'
        echo '<path d="M13.25 2.75 5.5 13.25h6l-1 8 7.75-10.5h-6Z"/>'
      when 'award'
        echo '<circle cx="12" cy="9" r="5.25"/><path d="m8.75 13.25-1.5 7.25L12 18l4.75 2.5-1.5-7.25"/>'
      when 'camera'
        echo '<path d="M4.75 7.25h2.5l1.5-2.5h6.5l1.5 2.5h2.5a1.5 1.5 0 0 1 1.5 1.5v9.5a1.5 1.5 0 0 1-1.5 1.5H4.75a1.5 1.5 0 0 1-1.5-1.5v-9.5a1.5 1.5 0 0 1 1.5-1.5Z"/><circle cx="12" cy="13" r="3.25"/>'
    endcase
  endcapture
-%}

{%- if paths != blank -%}
  <svg
    class="yv-icon yv-icon--{{ key }}{% if class != blank %} {{ class }}{% endif %}"
    width="{{ icon_size }}"
    height="{{ icon_size }}"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="{{ icon_stroke }}"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
    style="--yv-icon-size: {{ icon_size }}px; --yv-icon-stroke: {{ icon_stroke }};"
  >
    {{- paths -}}
  </svg>
{%- elsif key != blank -%}
  {%- comment -%} Horizon icon names use underscores (paw_print, lightning_bolt). {%- endcomment -%}
  {%- capture horizon_paths -%}{% render 'icon', icon: raw_key %}{%- endcapture -%}
  {%- if horizon_paths != blank -%}
    <svg
      class="yv-icon yv-icon--filled yv-icon--{{ key }}{% if class != blank %} {{ class }}{% endif %}"
      width="{{ icon_size }}"
      height="{{ icon_size }}"
      viewBox="0 0 20 20"
      aria-hidden="true"
      focusable="false"
      style="--yv-icon-size: {{ icon_size }}px;"
    >
      {{- horizon_paths -}}
    </svg>
  {%- endif -%}
{%- endif -%}
