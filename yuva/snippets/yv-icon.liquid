{%- comment -%} One icon family for every yv section. render 'yv-icon', name: 'moon', class: 'yv-icon--success' {%- endcomment -%}
{%- liquid
  assign cls = 'yv-icon'
  if class != blank
    assign cls = cls | append: ' ' | append: class
  endif
-%}
<svg class="{{ cls }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
{%- case name -%}
  {%- when 'moon' -%}<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/>
  {%- when 'shield' -%}<path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6z"/><path d="M9 12l2 2 4-4"/>
  {%- when 'truck' -%}<path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.5"/><circle cx="17" cy="18" r="1.5"/>
  {%- when 'chat' -%}<path d="M4 5h16v11H8l-4 4z"/>
  {%- when 'check' -%}<path d="M5 12.5l4.5 4.5L19 7.5"/>
  {%- when 'home' -%}<path d="M3 11l9-7 9 7v9H3z"/><path d="M10 20v-6h4v6"/>
  {%- when 'lock' -%}<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>
  {%- when 'pin' -%}<path d="M12 21s-6-5.5-6-11a6 6 0 0 1 12 0c0 5.5-6 11-6 11z"/><circle cx="12" cy="10" r="2"/>
  {%- when 'paw' -%}<circle cx="7" cy="9" r="1.6"/><circle cx="11" cy="6" r="1.6"/><circle cx="15" cy="6.5" r="1.6"/><circle cx="18.5" cy="10" r="1.6"/><path d="M12 11c-3 0-6 3-6 5.5S8 20 12 20s6-1 6-3.5-3-5.5-6-5.5z"/>
  {%- when 'stethoscope' -%}<path d="M6 3v6a4 4 0 0 0 8 0V3"/><path d="M10 13v3a5 5 0 0 0 10 0v-2"/><circle cx="20" cy="12" r="2"/>
  {%- when 'ruler' -%}<path d="M3 17L17 3l4 4L7 21z"/><path d="M8 12l2 2M11 9l2 2M14 6l2 2"/>
  {%- when 'leaf' -%}<path d="M4 20C4 10 10 4 20 4c0 10-6 16-16 16z"/><path d="M4 20c4-6 8-9 12-12"/>
  {%- when 'arrow' -%}<path d="M5 12h14M13 6l6 6-6 6"/>
  {%- else -%}<circle cx="12" cy="12" r="8"/>
{%- endcase -%}
</svg>
