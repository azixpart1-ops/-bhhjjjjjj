          <path pathLength="1000" d="M137 39.9 L145 26.1 M174 104 L190 104 M137 168.1 L145 181.9 M63 168.1 L55 181.9 M26 104 L10 104 M63 39.9 L55 26.1"/>
      {%- endcase -%}
    </svg>
  </yv-draw-icon>
{%- endif -%}
