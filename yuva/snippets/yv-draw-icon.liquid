        {%- when 'arrow' -%}
          <path pathLength="1000" d="M26 160 C40 104 74 66 118 62 C140 60 158 68 170 84"/>
          <path pathLength="1000" d="M142 82 L172 88 L176 58"/>
        {%- when 'circle' -%}
