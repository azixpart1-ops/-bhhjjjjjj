{%- doc -%}
  "Icon over section": a hand-drawn stroke icon, absolutely positioned inside
  the closest positioned container, that draws itself once when the section is 30% in view
  (assets/yv-draw-icon.js). Decorative: aria-hidden, no pointer events. Under reduced motion and in
  the theme editor it shows fully drawn.

  Either pass the section's settings object as `icon_settings` (reads the shared ids draw_icon_show, draw_icon,
  draw_icon_x_desktop, draw_icon_y_desktop, draw_icon_x_mobile, draw_icon_y_mobile, draw_icon_color)
  or pass the values one by one. The container it sits in must have `position: relative`
  (add the utility class `yv-draw-icon-host`).

  @param {object} [icon_settings] - A settings object with the shared draw_icon_* ids (section.settings or block.settings).
  @param {string} [icon] - sparkle | star | heart | swirl | arrow | circle | underline | flower. Default: 'sparkle'
  @param {string} [color] - Stroke colour. Default: '#012921'
  @param {number} [x] - Left offset in % of the container (desktop). Default: 0
  @param {number} [y] - Top offset in % of the container (desktop). Default: 0
  @param {number} [x_mobile] - Left offset in % below 750px. Default: 2
  @param {number} [y_mobile] - Top offset in % below 750px. Default: 2
  @param {number} [size] - Icon size in px (desktop). Default: 130
  @param {number} [size_mobile] - Icon size in px below 750px. Default: 90
  @param {string} [class] - Extra classes.

  @example
  <div class="page-width yv-draw-icon-host">
    {% render 'yv-draw-icon', icon_settings: section.settings %}
    …
  </div>
{%- enddoc -%}

{%- liquid
  assign draw_show = true
  if icon_settings != blank
    assign draw_show = icon_settings.draw_icon_show
    assign draw_icon = icon_settings.draw_icon | default: icon | default: 'sparkle'
    assign draw_color = icon_settings.draw_icon_color | default: color | default: '#012921'
    assign draw_x = icon_settings.draw_icon_x_desktop | default: x | default: 0
    assign draw_y = icon_settings.draw_icon_y_desktop | default: y | default: 0
    assign draw_x_mobile = icon_settings.draw_icon_x_mobile | default: x_mobile | default: 2
    assign draw_y_mobile = icon_settings.draw_icon_y_mobile | default: y_mobile | default: 2
  else
    assign draw_icon = icon | default: 'sparkle'
    assign draw_color = color | default: '#012921'
    assign draw_x = x | default: 0
    assign draw_y = y | default: 0
    assign draw_x_mobile = x_mobile | default: 2
    assign draw_y_mobile = y_mobile | default: 2
  endif
  assign draw_size = size | default: 130
  assign draw_size_mobile = size_mobile | default: 90
-%}

{%- if draw_show -%}
  <script
    src="{{ 'yv-draw-icon.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
  <yv-draw-icon
    class="yv-draw-icon yv-draw-icon--{{ draw_icon }}{% if class != blank %} {{ class }}{% endif %}"
    aria-hidden="true"
    style="
      --yv-draw-x: {{ draw_x }}%;
      --yv-draw-y: {{ draw_y }}%;
      --yv-draw-x-mobile: {{ draw_x_mobile }}%;
      --yv-draw-y-mobile: {{ draw_y_mobile }}%;
      --yv-draw-size: {{ draw_size }}px;
      --yv-draw-size-mobile: {{ draw_size_mobile }}px;
      --yv-draw-color: {{ draw_color }};
    "
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 200 200"
      fill="none"
      focusable="false"
    >
      {%- case draw_icon -%}
        {%- when 'star' -%}
          <path pathLength="1000" d="M100 30 L120 80.5 L174.2 83.9 L132.3 118.5 L145.8 171.1 L100 142 L54.2 171.1 L67.7 118.5 L25.8 83.9 L80 80.5 Z"/>
