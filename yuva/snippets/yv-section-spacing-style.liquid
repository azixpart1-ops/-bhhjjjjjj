{%- doc -%}
  Outputs the inline custom properties for the shared Yuva section spacing settings, for use in a
  style attribute on an element with the `yv-section-spacing` class (assets/yv-base.css applies
  them: mobile values below 750px, desktop values from 750px, plus the transparent-header offset
  when the section is first on the page).

  Reads spacing_top_desktop, spacing_bottom_desktop, spacing_top_mobile and spacing_bottom_mobile
  (range 0–200 px, step 4). A blank value outputs 0px.

  @param {object} settings - The section (or block) settings object.

  @example
  <div class="section section--page-width yv-section-spacing" style="{% render 'yv-section-spacing-style', settings: section.settings %}">
{%- enddoc -%}

{%- liquid
  assign top_desktop = settings.spacing_top_desktop | default: 0
  assign bottom_desktop = settings.spacing_bottom_desktop | default: 0
  assign top_mobile = settings.spacing_top_mobile | default: 0
  assign bottom_mobile = settings.spacing_bottom_mobile | default: 0
-%}
--yv-pt-d: {{ top_desktop }}px; --yv-pb-d: {{ bottom_desktop }}px; --yv-pt-m: {{ top_mobile }}px; --yv-pb-m: {{ bottom_mobile }}px;
