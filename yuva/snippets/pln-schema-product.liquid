{%- comment -%}
  Product + BreadcrumbList structured data for the product page. Rendered
  by sections/pln-pdp-why.liquid (or from theme.liquid when template.name ==
  'product'). Switch OFF Yuva's own product JSON-LD and any reviews app's
  rich-snippet output so Google sees one Product entity, not two.

  Never asserts anything the store doesn't say:
    - aggregateRating only with ≥5 genuine reviews AND the setting on.
    - gtin from an 8/12/13/14-digit barcode.
    - MerchantReturnPolicy from the trial when it covers this product.
    - OfferShippingDetails from the delivery settings for qualifying offers.
{%- endcomment -%}
{%- if product != blank -%}
{%- liquid
  assign currency = cart.currency.iso_code | default: shop.currency
  assign base_url = request.origin | append: product.url
  assign description = product.description | strip_html | strip_newlines | strip | truncate: 5000, ''
  assign threshold_cents = settings.pln_free_delivery_threshold | default: 0 | times: 100
  assign h_min = product.metafields.custom.dispatch_days_min.value | default: settings.pln_dispatch_min | default: 1 | plus: 0
  assign h_max = product.metafields.custom.dispatch_days_max.value | default: settings.pln_dispatch_max | default: 2 | plus: 0
  assign t_min = settings.pln_transit_min | default: 4 | plus: 0
  assign t_max = settings.pln_transit_max | default: 6 | plus: 0
  assign h_ok = true
  if product.metafields.custom.ships_from.value == 'Partner warehouse' and product.metafields.custom.dispatch_days_max.value == blank
    assign h_ok = false
  endif
  capture trial_ok
    render 'pln-trial-eligible', product: product
  endcapture
  assign trial_ok = trial_ok | strip
  assign rp_days = 0
  if trial_ok == 'true'
    assign rp_days = settings.pln_trial_nights | default: 100
  elsif product.metafields.custom.return_days.value != blank
    assign rp_days = product.metafields.custom.return_days.value | plus: 0
  endif
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0 | plus: 0
  assign images = ''
  for m in product.media limit: 8
    if m.preview_image
      assign u = m.preview_image | image_url: width: 1600 | prepend: 'https:'
      assign images = images | append: u | append: '|'
    endif
  endfor
  assign images = images | split: '|'
  assign parent = collections['dog-beds']
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "@id": {{ base_url | append: '#product' | json }},
      "name": {{ product.title | json }},
      "url": {{ base_url | json }},
      "description": {{ description | json }},
      {%- if images.size > 0 -%}"image": {{ images | json }},{%- endif -%}
      "brand": { "@type": "Brand", "name": {{ product.vendor | default: shop.name | json }} },
      {%- if settings.pln_origin_enable and settings.pln_origin_region != blank -%}
      "countryOfOrigin": "GB",
      {%- endif -%}
      {%- if product.selected_or_first_available_variant.sku != blank -%}"sku": {{ product.selected_or_first_available_variant.sku | json }},{%- endif -%}
      {%- if product.type != blank -%}"category": {{ product.type | json }},{%- endif -%}
      {%- if settings.pln_show_ratings and rating != blank and rating_count >= 5 -%}
      "aggregateRating": { "@type": "AggregateRating", "ratingValue": {{ rating.rating | json }}, "bestRating": {{ rating.scale_max | default: 5 | json }}, "ratingCount": {{ rating_count | json }} },
      {%- endif -%}
      "offers": [
        {%- for v in product.variants -%}
        {%- liquid
          assign whole = v.price | divided_by: 100
          assign frac = v.price | modulo: 100
          if frac < 10
            assign frac = '0' | append: frac
          endif
          if v.available
            assign availability = 'https://schema.org/InStock'
          else
            assign availability = 'https://schema.org/OutOfStock'
          endif
          assign barcode = v.barcode | default: '' | strip | remove: ' ' | remove: '-'
          assign nondigits = barcode | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
          assign gtin = ''
          if barcode != '' and nondigits == ''
            case barcode.size
              when 8
                assign gtin = 'gtin8'
              when 12
                assign gtin = 'gtin12'
              when 13
                assign gtin = 'gtin13'
              when 14
                assign gtin = 'gtin14'
            endcase
          endif
        -%}
        {
          "@type": "Offer",
          "url": {{ base_url | append: '?variant=' | append: v.id | json }},
          "name": {{ v.title | json }},
          "price": {{ whole | append: '.' | append: frac | json }},
          "priceCurrency": {{ currency | json }},
          "availability": {{ availability | json }},
          "itemCondition": "https://schema.org/NewCondition",
          {%- if v.sku != blank -%}"sku": {{ v.sku | json }},{%- endif -%}
          {%- if gtin != '' -%}{{ gtin | json }}: {{ barcode | json }},{%- endif -%}
          {%- if threshold_cents > 0 and v.price >= threshold_cents and h_ok -%}
          "shippingDetails": {
            "@type": "OfferShippingDetails",
            "shippingRate": { "@type": "MonetaryAmount", "value": "0", "currency": {{ currency | json }} },
            "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "GB" },
            "deliveryTime": {
              "@type": "ShippingDeliveryTime",
              "handlingTime": { "@type": "QuantitativeValue", "minValue": {{ h_min }}, "maxValue": {{ h_max }}, "unitCode": "DAY" },
              "transitTime": { "@type": "QuantitativeValue", "minValue": {{ t_min }}, "maxValue": {{ t_max }}, "unitCode": "DAY" }
            }
          },
          {%- endif -%}
          {%- if rp_days > 0 -%}
          "hasMerchantReturnPolicy": {
            "@type": "MerchantReturnPolicy",
            "applicableCountry": "GB",
            "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
            "merchantReturnDays": {{ rp_days }},
            "returnMethod": "https://schema.org/ReturnByMail",
            "returnFees": "https://schema.org/{% if trial_ok == 'true' and settings.pln_trial_free_collection %}FreeReturn{% else %}ReturnFeesCustomerResponsibility{% endif %}"
          },
          {%- endif -%}
          "seller": { "@id": {{ request.origin | append: '/#organization' | json }} }
        }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": {{ shop.name | json }}, "item": {{ request.origin | append: routes.root_url | json }} }
        {%- if product.type contains 'Dog Beds' and parent.url != blank -%},
        { "@type": "ListItem", "position": 2, "name": {{ parent.title | json }}, "item": {{ request.origin | append: parent.url | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ base_url | json }} }
        {%- else -%},
        { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ base_url | json }} }
        {%- endif -%}
      ]
    }
  ]
}
</script>
{%- endif -%}
