{%- doc -%}
  Yuva terms and conditions checkbox above the add to cart button (buy buttons > Enable terms and
  conditions checkbox). Until it is checked, assets/yv-product.js blocks add to cart and dynamic
  checkout in the same product form, shows "Please accept the terms and conditions." and focuses
  the checkbox. The checked state is not remembered.

  @param {string} text - Terms sentence (inline rich text, may contain a link).
  @param {string} block_id - The buy buttons block id.

  @example
  {% render 'yv-terms', text: block.settings.terms_text, block_id: block.id %}
{%- enddoc -%}

<script
  src="{{ 'yv-product.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<yv-terms-component class="yv-terms">
  <label class="yv-terms__label">
    <input
      type="checkbox"
      class="yv-terms__checkbox"
      id="YvTerms-{{ block_id }}"
      ref="checkbox"
      on:change="/update"
      aria-describedby="YvTermsError-{{ block_id }}"
    >
    <span class="yv-terms__text">{{ text }}</span>
  </label>
  <p
    class="yv-terms__error"
    id="YvTermsError-{{ block_id }}"
    ref="error"
    role="alert"
    hidden
  >
    {{ 'yv.product.terms_error' | t }}
  </p>
</yv-terms-component>
