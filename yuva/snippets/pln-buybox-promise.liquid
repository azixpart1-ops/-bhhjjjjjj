{%- comment -%}
  The promise block that sits DIRECTLY UNDER Yuva's Add to cart button.
  Paste this one line into a "Custom Liquid" block inside Yuva's main
  product section, placed after the Buy buttons block:

      {% render 'pln-buybox-promise', product: product %}

  Risk reversal at the moment of decision (loss aversion works on the
  shopper's side here: the risk of a wrong bed is removed, not added).
  Every line reads from settings or the product's own metafields.
{%- endcomment -%}
{%- liquid
  assign nights = settings.pln_trial_nights | default: 100
  assign years = settings.pln_guarantee_years | default: 5
  capture trial_ok
    render 'pln-trial-eligible', product: product
  endcapture
  assign trial_ok = trial_ok | strip
  assign is_foam = false
  if product.metafields.custom.foam_guarantee.value == true
    assign is_foam = true
  elsif product.metafields.custom.foam_guarantee.value == false
    assign is_foam = false
  elsif product.metafields.custom.core_type.value contains 'foam' or product.title contains 'Memory Foam'
    assign is_foam = true
  endif
  assign partner = false
  if product.metafields.custom.ships_from.value == 'Partner warehouse' and product.metafields.custom.dispatch_days_max.value == blank
    assign partner = true
  endif
  assign h_min = product.metafields.custom.dispatch_days_min.value | default: settings.pln_dispatch_min | default: 1
  assign h_max = product.metafields.custom.dispatch_days_max.value | default: settings.pln_dispatch_max | default: 2
  assign threshold = settings.pln_free_delivery_threshold | default: 0 | plus: 0
  assign threshold_cents = threshold | times: 100
-%}
{{ 'pln.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pln.js' | asset_url }}" defer="defer"></script>
<script>window.PLN = window.PLN || { moneyFormat: {{ shop.money_format | json }}, guaranteeYears: {{ years | json }}, holidays: {{ settings.pln_holidays | default: '' | newline_to_br | split: '<br />' | json }}, routes: { cart: {{ routes.cart_url | json }}, cartAdd: {{ routes.cart_add_url | json }} } };</script>
<div class="pln-promise">
  <p class="pln-promise__head" id="pln-promise-head-{{ product.id }}">Included with this bed</p>
<ul class="pln-promise__list" aria-labelledby="pln-promise-head-{{ product.id }}">
  {%- unless partner -%}
  <li>{% render 'pln-icon', name: 'truck' %}<span class="pln-promise__delivery" data-pln-delivery="Order today, arrives [dates]" data-dispatch-min="{{ h_min }}" data-dispatch-max="{{ h_max }}" data-transit-min="{{ settings.pln_transit_min | default: 4 }}" data-transit-max="{{ settings.pln_transit_max | default: 6 }}" hidden></span><noscript>Dispatched in {{ h_min }} to {{ h_max }} working days, delivered {{ settings.pln_transit_min | default: 4 }} to {{ settings.pln_transit_max | default: 6 }} working days later.</noscript></li>
  {%- else -%}
  <li>{% render 'pln-icon', name: 'truck' %}<span>Ships from our partner warehouse, so it takes longer than our own stock. Message us for the expected date before you order.</span></li>
  {%- endunless -%}
  {%- if product.price_min >= threshold_cents -%}
  <li>{% render 'pln-icon', name: 'check' %}<span><strong>{% render 'pln-delivery-claim' %},</strong> tracked.</span></li>
  {%- endif -%}
  {%- if trial_ok == 'true' -%}
  <li>{% render 'pln-icon', name: 'moon' %}<span><strong>{{ nights }} nights to decide.</strong> Sleep on it. If it isn't right, {% if settings.pln_trial_free_collection %}we collect it free{% else %}send it back{% endif %} and refund every penny.</span></li>
  {%- elsif product.type contains 'Personalised' -%}
  <li>{% render 'pln-icon', name: 'moon' %}<span>Made to order with their name, so it isn't part of the {{ nights }}-night trial. Check the spelling and size before you order.</span></li>
  {%- endif -%}
  {%- if is_foam and settings.pln_guarantee_enable -%}
  <li>{% render 'pln-icon', name: 'shield' %}<span><strong>{{ years }}-year foam guarantee.</strong> <span class="pln-promise__per" data-pln-per-night="{{ product.selected_or_first_available_variant.price }}" hidden>About <span data-value></span> a night over the guarantee.</span></span></li>
  {%- endif -%}
  {%- if settings.pln_origin_enable and settings.pln_origin_line != blank -%}
  <li>{% render 'pln-icon', name: 'pin' %}<span>{{ settings.pln_origin_line }}. Questions answered by {{ settings.pln_owner_name | default: 'Abbas' }}, in the UK.</span></li>
  {%- endif -%}
</ul>
</div>
