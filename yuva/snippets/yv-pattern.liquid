{%- doc -%}
  Decorative background pattern: original
  line artwork drawn in the current text colour at 8% opacity (--yv-pattern-opacity), filling
  its positioned parent behind the content. Renders nothing for 'none' or an unknown pattern.

  @param {string} pattern - 'waves' or 'flowers' ('none' renders nothing).
  @param {string} id - Unique suffix for the SVG pattern id (section.id or block.id).
  @param {string} [class] - Extra classes.

  @example
  {% render 'yv-pattern', pattern: section.settings.background_pattern, id: section.id %}
{%- enddoc -%}

{%- liquid
  assign pattern_name = pattern | default: 'none'
  assign pattern_id = 'yv-pattern-' | append: pattern_name | append: '-' | append: id
-%}

{%- if pattern_name == 'waves' or pattern_name == 'flowers' -%}
  <div
    class="yv-pattern yv-pattern--{{ pattern_name }}{% if class != blank %} {{ class }}{% endif %}"
    aria-hidden="true"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      focusable="false"
      preserveAspectRatio="none"
    >
      <defs>
        {%- if pattern_name == 'waves' -%}
          <pattern
            id="{{ pattern_id }}"
            width="120"
            height="36"
            patternUnits="userSpaceOnUse"
          >
            <path
              d="M0 12c10 0 20-8 30-8s20 8 30 8 20-8 30-8 20 8 30 8M0 30c10 0 20-8 30-8s20 8 30 8 20-8 30-8 20 8 30 8"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
          </pattern>
        {%- else -%}
          <pattern
            id="{{ pattern_id }}"
            width="180"
            height="180"
            patternUnits="userSpaceOnUse"
          >
            <g
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <g transform="translate(40 42)">
                <circle r="5" />
                <path d="M0-6c-5-9 5-9 0 0m6 6c9-5 9 5 0 0m-6 6c5 9-5 9 0 0m-6-6c-9 5-9-5 0 0" transform="rotate(20)" />
              </g>
              <g transform="translate(130 70) scale(.75)">
                <circle r="5" />
                <path d="M0-6c-5-9 5-9 0 0m6 6c9-5 9 5 0 0m-6 6c5 9-5 9 0 0m-6-6c-9 5-9-5 0 0" transform="rotate(-15)" />
              </g>
              <g transform="translate(70 140) scale(1.15)">
                <circle r="5" />
                <path d="M0-6c-5-9 5-9 0 0m6 6c9-5 9 5 0 0m-6 6c5 9-5 9 0 0m-6-6c-9 5-9-5 0 0" transform="rotate(45)" />
              </g>
              <path d="M95 18c4 3 4 7 0 10M160 150c-3 4-7 4-10 0M15 110c3-4 7-4 10 0" />
            </g>
          </pattern>
        {%- endif -%}
      </defs>
      <rect
        width="100%"
        height="100%"
        fill="url(#{{ pattern_id }})"
      />
    </svg>
  </div>
{%- endif -%}
