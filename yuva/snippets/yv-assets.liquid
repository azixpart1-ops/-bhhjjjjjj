{%- comment -%}
  Loads yv.css + yv.js and the window.YV config every yv-* section needs.
  Rendered at the top of each yv section. Browsers fetch each asset once;
  yv.js guards itself so it runs once.
{%- endcomment -%}
{{ 'yv.css' | asset_url | stylesheet_tag }}
<script src="{{ 'yv.js' | asset_url }}" defer="defer"></script>
<script>
  window.YV = window.YV || {
    moneyFormat: {{ shop.money_format | json }},
    guaranteeYears: {{ settings.yv_guarantee_years | default: 5 | json }},
    holidays: {{ settings.yv_holidays | default: '' | newline_to_br | split: '<br />' | json }},
    routes: { cart: {{ routes.cart_url | json }}, cartAdd: {{ routes.cart_add_url | json }}, root: {{ routes.root_url | json }} }
  };
</script>
