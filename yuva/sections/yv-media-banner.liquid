{% comment %}
  Section contract: yv-media-banner
  A full-bleed image or Shopify-hosted video banner (the video wins; the image is its poster) with
  an optional parallax media layer (assets/yv-parallax.js). Height per device: fixed px, full
  screen or adapt to the image. A content box (highlight heading with per-device px sizes,
  description, one button) is placed on the nine-position grid, over a colour overlay.
  When the section is first, media runs under a transparent header and top-placed content clears
  it. Shared: visibility.
  @example
  Theme editor > Add section > Media > "Media banner"
{% endcomment %}

{%- liquid
  assign image = section.settings.image
  assign video = section.settings.video

  assign media_ratio = 2.2588
  if video != blank
    assign media_ratio = video.aspect_ratio | default: 1.7778
  elsif image != blank
    assign media_ratio = image.aspect_ratio | default: 2.2588
  endif

  case section.settings.height_desktop
    when 'adapt'
      assign height_desktop = 'auto'
    when 'full'
      assign height_desktop = '100svh'
    else
      assign height_desktop = section.settings.height_desktop | append: 'px'
  endcase
  case section.settings.height_mobile
    when 'adapt'
      assign height_mobile = 'auto'
    else
      assign height_mobile = section.settings.height_mobile | append: 'px'
  endcase

  assign parallax = false
  if section.settings.parallax and section.settings.height_desktop != 'adapt' and section.settings.height_mobile != 'adapt'
    assign parallax = true
  endif

  assign media_loading = 'lazy'
  assign media_priority = 'auto'
  if section.index == 1
    assign media_loading = 'eager'
    assign media_priority = 'high'
  elsif section.index == 2 or section.index == 3
    assign media_loading = 'eager'
  endif

  assign position = section.settings.content_position | default: 'center'
  assign banner_classes = 'yv-media-banner'
  if section.settings.height_desktop == 'adapt'
    assign banner_classes = banner_classes | append: ' yv-media-banner--adapt-d'
  endif
  if section.settings.height_desktop == 'full'
    assign banner_classes = banner_classes | append: ' yv-media-banner--full-d'
  endif
  if section.settings.height_mobile == 'adapt'
    assign banner_classes = banner_classes | append: ' yv-media-banner--adapt-m'
  endif
-%}

<script
  src="{{ 'yv-parallax.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
{%- if video != blank -%}
  <script
    src="{{ 'yv-autoplay-video.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{%- endif -%}

{% # A first-section banner sizes "full screen" and clears a transparent header with the measured header heights at first paint %}
{%- if section.index == 1 -%}{% render 'measure-header-heights' %}{%- endif -%}

<div class="section-background{% render 'yv-section-classes', settings: section.settings, visibility_only: true %}"></div>
<div
  class="section section--full-width disable-section-top-offset{% render 'yv-section-classes', settings: section.settings %}"
  {% if request.visual_preview_mode %}
    data-shopify-visual-preview
  {% endif %}
  data-testid="yv-media-banner"
>
  <yv-parallax
    class="{{ banner_classes }}"
    data-parallax="{{ parallax }}"
    style="
      --yv-media-banner-h-d: {{ height_desktop }};
      --yv-media-banner-h-m: {{ height_mobile }};
      --yv-media-banner-ratio: {{ media_ratio }};
      --yv-media-banner-heading-d: {{ section.settings.heading_size_desktop }}px;
      --yv-media-banner-heading-m: {{ section.settings.heading_size_mobile }}px;
      --yv-heading-color: {{ section.settings.color_heading }};
      --yv-media-banner-description: {{ section.settings.color_description }};
    "
  >
    <div class="yv-media-banner__layer" ref="layer">
      {%- if video != blank -%}
        {%- assign poster = image | default: video.preview_image -%}
        <yv-autoplay-video-component class="yv-media-banner__video">
          <video
            ref="video"
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
            {% if poster != blank %}
              poster="{{ poster | image_url: width: 1920 }}"
            {% endif %}
          >
            {%- for source in video.sources -%}
              <source
                data-src="{{ source.url }}"
                type="{{ source.mime_type }}"
              >
            {%- endfor -%}
          </video>
        </yv-autoplay-video-component>
      {%- elsif image != blank -%}
        {{
          image
          | image_url: width: 3840
          | image_tag:
            widths: '750, 1100, 1500, 1920, 2560, 3840',
            sizes: '100vw',
            loading: media_loading,
            fetchpriority: media_priority,
            class: 'yv-media-banner__image'
        }}
      {%- else -%}
        {{ 'hero-apparel-2' | placeholder_svg_tag: 'yv-media-banner__image yv-placeholder' }}
      {%- endif -%}
    </div>

    <div
      class="yv-overlay"
      style="--yv-overlay-color: {{ section.settings.color_overlay }}; --yv-overlay-opacity: {{ section.settings.overlay_opacity }};"
    ></div>

    {%- capture button -%}
      {%- render 'yv-button',
        label: section.settings.button_text,
        link: section.settings.button_link,
        size_desktop: section.settings.button_size_desktop,
        size_mobile: section.settings.button_size_mobile,
        bg: section.settings.color_button_bg,
        text: section.settings.color_button_text,
        border: section.settings.color_button_border,
        class: 'yv-media-banner__button'
      -%}
    {%- endcapture -%}
    {%- assign button = button | strip -%}

    {%- if section.settings.heading != blank or section.settings.description != blank or button != blank -%}
      <div class="yv-media-banner__content-wrap yv-pos-d--{{ position }} yv-pos-m--{{ position }}">
        <div class="yv-media-banner__content" data-yv-reveal>
          {% render 'yv-heading',
            text: section.settings.heading,
            tag: section.settings.heading_tag,
            size: '',
            highlight_font: section.settings.highlight_font,
            alignment: 'center',
            class: 'yv-media-banner__heading-wrap',
            title_class: 'yv-media-banner__heading'
          %}
          {%- if section.settings.description != blank -%}
            <div class="yv-media-banner__description rte">{{ section.settings.description }}</div>
          {%- endif -%}
          {{ button }}
        </div>
      </div>
    {%- endif -%}
  </yv-parallax>
</div>

{% stylesheet %}
  .yv-media-banner {
    position: relative;
    display: block;
    grid-column: 1 / -1;
    isolation: isolate;
    overflow: hidden;
    height: var(--yv-media-banner-h-m, 550px);
    background-color: var(--yv-image-bg);
  }

  @media screen and (min-width: 750px) {
    .yv-media-banner {
      height: var(--yv-media-banner-h-d, 750px);
    }
  }

  /* "Full screen" fills the viewport below the header group (a transparent header overlaps it). */
  main > .shopify-section:first-child .yv-media-banner--full-d {
    --yv-media-banner-h-d: calc(100svh - var(--header-group-height, 0px));
  }

  main > .shopify-section:first-child .yv-media-banner {
    --yv-media-banner-header-offset: calc(var(--header-height, 0px) * var(--transparent-header-offset-boolean, 0));
  }

  @media screen and (max-width: 749px) {
    .yv-media-banner--adapt-m {
      height: auto;
      aspect-ratio: var(--yv-media-banner-ratio);
    }
  }

  @media screen and (min-width: 750px) {
    .yv-media-banner--adapt-d {
      height: auto;
      aspect-ratio: var(--yv-media-banner-ratio);
    }
  }

  .yv-media-banner[data-shopify-visual-preview],
  [data-shopify-visual-preview] .yv-media-banner {
    height: 600px;
  }

  .yv-media-banner__layer {
    position: absolute;
    inset: 0;
    z-index: 0;
    will-change: auto;
  }

  /* Parallax: the layer is 120% of the box, offset −10%, and moved by assets/yv-parallax.js. */
  .yv-media-banner[data-parallax-active] .yv-media-banner__layer {
    inset: -10% 0;
    will-change: transform;
  }

  .yv-media-banner__layer :is(.yv-media-banner__image, .yv-media-banner__video, video) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .yv-media-banner__layer svg.yv-media-banner__image {
    color: rgb(var(--color-foreground-rgb) / 0.35);
  }

  .yv-media-banner .yv-overlay {
    z-index: 1;
  }

  /* Content: 60px padding (24px mobile), max 640px, nine-position placement. */
  .yv-media-banner__content-wrap {
    position: absolute;
    inset: 0;
    z-index: 2;
    padding: calc(24px + var(--yv-media-banner-header-offset, 0px)) 24px 24px;
    pointer-events: none;
  }

  @media screen and (min-width: 750px) {
    .yv-media-banner__content-wrap {
      padding: calc(60px + var(--yv-media-banner-header-offset, 0px)) max(60px, var(--util-page-margin-offset, 60px)) 60px;
    }
  }

  .yv-media-banner__content {
    display: flex;
    flex-direction: column;
    align-items: var(--yv-pos-x, center);
    max-width: min(100%, 640px);
    pointer-events: auto;
  }

  @media screen and (min-width: 750px) {
    .yv-media-banner__content {
      max-width: min(100%, 700px);
    }
  }

  .yv-media-banner__content > * {
    max-width: 100%;
  }

  .yv-media-banner .yv-media-banner__heading-wrap {
    --yv-heading-gap: 0;

    width: 100%;
    text-align: inherit;
  }

  /* Three classes: beats the colour-set heading rule (.yv-section :is(h1…h6, .h1…)). */
  .yv-media-banner .yv-media-banner__heading-wrap .yv-media-banner__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: var(--yv-media-banner-heading-m);
    line-height: var(--font-h1--line-height);
    letter-spacing: var(--font-h1--letter-spacing);
    text-transform: var(--font-h1--case);
    color: var(--yv-heading-color, #fff);
    text-align: inherit;
    overflow-wrap: break-word;
    text-wrap: balance;
  }

  @media screen and (min-width: 750px) {
    .yv-media-banner .yv-media-banner__heading-wrap .yv-media-banner__heading {
      font-size: calc(var(--yv-media-banner-heading-d) * 0.65);
    }
  }

  @media screen and (min-width: 1200px) {
    .yv-media-banner .yv-media-banner__heading-wrap .yv-media-banner__heading {
      font-size: calc(var(--yv-media-banner-heading-d) * 0.85);
    }
  }

  @media screen and (min-width: 1441px) {
    .yv-media-banner .yv-media-banner__heading-wrap .yv-media-banner__heading {
      font-size: var(--yv-media-banner-heading-d);
    }
  }

  .yv-media-banner__description {
    margin-block-start: 16px;
    color: var(--yv-media-banner-description, #fff);
    font-size: var(--font-paragraph--size);
    line-height: 1.6;
  }

  .yv-media-banner__description > :first-child {
    margin-block-start: 0;
  }

  .yv-media-banner__description > :last-child {
    margin-block-end: 0;
  }

  .yv-media-banner__content .yv-media-banner__button {
    margin-block-start: 24px;
  }
{% endstylesheet %}

