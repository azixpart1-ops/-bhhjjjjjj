{% comment %}
  Section contract: yv-media-grid
  Yuva "Immersive media grid": a bento grid of tiles. Each tile is a private block that sets its own
  column and row span, separately for desktop and mobile:
  - `_yv-media-grid-media`: an image or video tile with optional shoppable hotspots
    (`_yv-media-grid-hotspot`, shared `yv-hotspot` component);
  - `_yv-media-grid-text`: a dark text tile (heading and description over a colour or image);
  - `_yv-media-grid-content`: a bordered card with media beside, above or below a heading and text.
  The grid has N equal columns and auto rows with a minimum height, so tiles with text grow their
  row while photos fill whatever box they get. Popovers of hotspots may overlap neighbouring tiles
  (the tile with an open hotspot is raised above the others).
  Optional highlight heading with description, either stacked above the grid or split (heading left,
  description right). Shared settings: section border, heading, colour set, visibility, spacing.
  @example
  Theme editor > Add section > Media > "Media grid"
{% endcomment %}

{%- liquid
  render 'yv-color-set', set: section.settings.color_set, section_id: section.id

  assign container = section.settings.container | default: 'page'
  assign heading_layout = section.settings.heading_layout | default: 'stacked'
  assign text_alignment = section.settings.text_alignment | default: 'center'
  if heading_layout == 'split'
    assign heading_alignment = 'left'
  else
    assign heading_alignment = text_alignment
  endif

  assign has_header = false
  if section.settings.heading != blank or section.settings.subheading != blank or section.settings.rotating_text != blank or section.settings.description != blank
    assign has_header = true
  endif

  assign columns = section.settings.columns_desktop | default: 6
  assign columns_mobile = section.settings.columns_mobile | default: 2

  assign needs_autoplay = false
  for tile in section.blocks
    if tile.settings.video != blank and tile.settings.video_autoplay
      assign needs_autoplay = true
      break
    endif
  endfor
-%}

{%- if needs_autoplay -%}
  <script
    src="{{ 'yv-autoplay-video.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{%- endif -%}

<div class="section-background color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings, visibility_only: true %}"></div>
<div
  class="section section--page-width yv-section-spacing yv-media-grid{% if section.settings.image_zoom %} yv-media-grid--zoom{% endif %} color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings %}"
  style="{% render 'yv-section-spacing-style', settings: section.settings %} --yv-mg-cols: {{ columns }}; --yv-mg-cols-m: {{ columns_mobile }}; --yv-mg-row: {{ section.settings.row_height_desktop }}px; --yv-mg-row-m: {{ section.settings.row_height_mobile }}px; --yv-mg-gap: {{ section.settings.grid_gap_desktop }}px; --yv-mg-gap-m: {{ section.settings.grid_gap_mobile }}px; --yv-mg-radius: {{ section.settings.grid_radius_desktop }}px; --yv-mg-radius-m: {{ section.settings.grid_radius_mobile }}px; --yv-hotspot-color: {{ section.settings.hotspot_color }}; --yv-hotspot-pulse: {{ section.settings.hotspot_color }};"
  data-testid="yv-media-grid"
>
  <div class="yv-container yv-container--{{ container }} yv-media-grid__inner">
    {%- if has_header -%}
      <div class="yv-media-grid__header yv-media-grid__header--{{ heading_layout }}">
        {%- if heading_layout == 'split' -%}
          {% render 'yv-heading',
            text: section.settings.heading,
            tag: section.settings.heading_tag,
            size: section.settings.heading_size,
            highlight_font: section.settings.highlight_font,
            highlight_color: section.settings.highlight_color,
            rotating_text: section.settings.rotating_text,
            subheading: section.settings.subheading,
            alignment: 'left',
            class: 'yv-media-grid__heading',
            reveal: true
          %}
          {%- if section.settings.description != blank -%}
            <div
              class="yv-media-grid__description rte"
              data-yv-reveal
            >
              {{ section.settings.description }}
            </div>
          {%- endif -%}
        {%- else -%}
          {% render 'yv-heading',
            text: section.settings.heading,
            tag: section.settings.heading_tag,
            size: section.settings.heading_size,
            highlight_font: section.settings.highlight_font,
            highlight_color: section.settings.highlight_color,
            rotating_text: section.settings.rotating_text,
            subheading: section.settings.subheading,
            description: section.settings.description,
            alignment: heading_alignment,
            class: 'yv-media-grid__heading',
            reveal: true
          %}
        {%- endif -%}
      </div>
    {%- endif -%}

    <div
      class="yv-media-grid__grid"
      data-yv-hotspot-container
    >
      {%- content_for 'blocks' -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .yv-media-grid__inner {
    min-width: 0;
  }

  /* Full width spans the screen but keeps the page gutter, so text and tiles never touch the edges. */
  .yv-media-grid__inner.yv-container--full {
    padding-inline: var(--page-margin, 20px);
  }

  /* Header: stacked (heading over description) or split (heading left, description right). */
  .yv-media-grid__header {
    margin-block-end: 30px;
  }

  .yv-media-grid__header--stacked .yv-heading {
    --yv-heading-gap: 15px;
    --yv-heading-description-width: 640px;
  }

  .yv-media-grid__header--stacked .yv-heading__description {
    font-size: var(--yv-text-lg, 0.96rem);
    line-height: 1.4;
  }

  .yv-media-grid__header--split {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .yv-media-grid__description {
    min-width: 0;
    font-size: var(--yv-text-base, 0.84rem);
    line-height: 1.6;
  }

  @media screen and (min-width: 990px) {
    .yv-media-grid__header--split {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 60px;
      margin-block-end: 30px;
    }

    .yv-media-grid__header--split .yv-media-grid__heading {
      flex: 0 1 44%;
      min-width: 0;
    }

    .yv-media-grid__header--split .yv-media-grid__description {
      flex: 0 1 48%;
      text-align: end;
    }
  }

  /* The grid: N equal columns, auto rows with a minimum height. */
  .yv-media-grid__grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--yv-mg-cols-m, 2), minmax(0, 1fr));
    grid-auto-rows: minmax(var(--yv-mg-row-m, 160px), auto);
    gap: var(--yv-mg-gap-m, 6px);
  }

  @media screen and (min-width: 750px) {
    .yv-media-grid__grid {
      grid-template-columns: repeat(var(--yv-mg-cols, 6), minmax(0, 1fr));
      grid-auto-rows: minmax(var(--yv-mg-row, 100px), auto);
      gap: var(--yv-mg-gap, 14px);
    }
  }

  /* Tiles (shared by the three tile blocks). */
  .yv-media-grid-tile {
    --yv-mg-tile-radius: var(--yv-mg-radius-m, 10px);
    --yv-mg-pad: 15px;

    position: relative;
    grid-column: span var(--yv-mg-col-m, 1);
    grid-row: span var(--yv-mg-row-span-m, 1);
    min-width: 0;
    min-height: 0;
    border-radius: var(--yv-mg-tile-radius);
  }

  @media screen and (min-width: 750px) {
    .yv-media-grid-tile {
      --yv-mg-tile-radius: var(--yv-mg-radius, 10px);
      --yv-mg-pad: 20px;

      grid-column: span var(--yv-mg-col, 1);
      grid-row: span var(--yv-mg-row-span, 1);
    }
  }

  @media screen and (min-width: 1200px) {
    .yv-media-grid-tile {
      --yv-mg-pad: 25px;
    }
  }

  /* Tablets: narrow tiles get tighter padding and smaller tile headings so words never split. */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .yv-media-grid-tile {
      --yv-mg-pad: 12px;
    }

    .yv-media-grid-tile :is(.yv-media-grid-text__heading, .yv-media-grid-content__heading) {
      font-size: min(1.25rem, var(--font-h5--size, 20px));
    }

    .yv-media-grid-tile :is(.yv-media-grid-text__description, .yv-media-grid-content__description) {
      font-size: var(--yv-text-sm, 0.72rem);
    }
  }

  /* A tile whose hotspot is open (or hovered/focused) rises above its neighbours. */
  .yv-media-grid-tile:is(:hover, :focus-within),
  .yv-media-grid-tile:has(yv-hotspot[open]) {
    z-index: 3;
  }

  .yv-media-grid-tile__media {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    background-color: var(--yv-image-bg);
    border-radius: inherit;
  }

  .yv-media-grid-tile__media :is(img, svg, video, picture) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .yv-media-grid-tile__media:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .yv-media-grid__video,
  .yv-media-grid__video video {
    display: block;
    width: 100%;
    height: 100%;
  }

  .yv-media-grid__video video {
    object-fit: cover;
  }

  .yv-media-grid__player {
    position: absolute;
    inset: 0;
  }

  .yv-media-grid__player img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Yuva's round glass play button over the poster. */
  .yv-media-grid-tile deferred-media .deferred-media__poster-icon {
    width: 64px;
    height: 64px;
    color: #fff;
    background: rgb(255 255 255 / 0.18);
    border: 1px solid rgb(255 255 255 / 0.7);
    backdrop-filter: blur(4px);
  }

  .yv-media-grid-tile deferred-media .deferred-media__poster-icon svg {
    width: 28px;
    height: 28px;
    filter: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .yv-media-grid-tile deferred-media .deferred-media__poster-icon {
      animation: yv-media-grid-play 2s ease-out infinite;
    }
  }

  @keyframes yv-media-grid-play {
    0% {
      box-shadow: 0 0 0 0 rgb(255 255 255 / 0.4);
    }

    70% {
      box-shadow: 0 0 0 16px rgb(255 255 255 / 0);
    }

    100% {
      box-shadow: 0 0 0 0 rgb(255 255 255 / 0);
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .yv-media-grid--zoom .yv-media-grid-tile__media :is(img, video) {
      transition: transform 1s ease;
    }

    .yv-media-grid--zoom .yv-media-grid-tile:hover .yv-media-grid-tile__media :is(img, video) {
      transform: scale(1.1);
    }
  }
{% endstylesheet %}

