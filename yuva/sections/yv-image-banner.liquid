{% comment %}
  Section contract: yv-image-banner
  A tall image or background-video banner (Yuva "Image banner"). The copy (eyebrow, highlight heading,
  description, button) sits in a box placed by the nine-position settings, top left by default. An
  optional product strip runs along the bottom of the banner: compact white cards (60px thumbnail,
  title, price) from a collection in a draggable `yv-carousel` with its arrows above the strip.
  Media: an image (with an optional mobile image), or a Shopify-hosted video / video link (YouTube,
  Vimeo or MP4) that plays muted in a loop; on mobile the mobile image replaces the video when set.
  Shared settings: colour set (around a boxed banner), visibility, spacing, highlight heading, button.
  @example
  Theme editor > Add section > Banners > "Image banner"
{% endcomment %}

{%- liquid
  render 'yv-color-set', set: section.settings.color_set, section_id: section.id

  assign media_loading = 'lazy'
  assign media_priority = 'auto'
  if section.index == 1
    assign media_loading = 'eager'
    assign media_priority = 'high'
  elsif section.index == 2
    assign media_loading = 'eager'
  endif
  if settings.yv_enable_lazyload == false
    assign media_loading = 'eager'
  endif

  assign media_type = section.settings.media_type
  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif
  assign has_mobile_image = false
  if section.settings.mobile_image != blank
    assign has_mobile_image = true
  endif

  assign has_video = false
  assign video_kind = ''
  if media_type == 'video'
    if section.settings.video != blank
      assign has_video = true
      assign video_kind = 'shopify'
    elsif section.settings.video_url != blank
      capture video_kind
        render 'yv-video-url', url: section.settings.video_url, output: 'type'
      endcapture
      assign video_kind = video_kind | strip
      if video_kind != blank
        assign has_video = true
      endif
    endif
  endif

  assign box_class = 'yv-image-banner__box'
  if section.settings.full_width
    assign box_class = box_class | append: ' yv-image-banner__box--full yv-container--full'
  else
    assign box_class = box_class | append: ' yv-image-banner__box--boxed'
  endif
-%}

{% # A full-width first section runs under a transparent header; its copy clears the header (`--header-height`) at first paint %}
{%- if section.index == 1 and section.settings.full_width -%}{% render 'measure-header-heights' %}{%- endif -%}

<div class="section-background color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings, visibility_only: true %}"></div>
<div
  class="section section--page-width yv-section-spacing yv-image-banner color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings %}{% if section.settings.full_width %} disable-section-top-offset{% endif %}"
  style="{% render 'yv-section-spacing-style', settings: section.settings %} --yv-image-banner-height: {{ section.settings.height_desktop }}px; --yv-image-banner-height-mobile: {{ section.settings.height_mobile }}px; --yv-image-banner-heading-size: {{ section.settings.heading_font_size }}px; --yv-image-banner-content-width: {{ section.settings.content_width }}%; --yv-image-banner-heading-color: {{ section.settings.heading_color }}; --yv-image-banner-text-color: {{ section.settings.text_color }};"
  data-testid="yv-image-banner"
>
  <div class="{{ box_class }}">
    <div class="yv-image-banner__media{% if has_mobile_image %} yv-image-banner__media--has-mobile{% endif %}">
      {%- if has_video -%}
        <div class="yv-image-banner__video{% if has_mobile_image %} yv-image-banner__video--desktop{% endif %}">
          {%- if video_kind == 'shopify' -%}
            <video-background-component class="yv-image-banner__video-player">
              {%- assign video_poster = section.settings.video.preview_image -%}
              {%- if section.settings.image != blank -%}
                {%- assign video_poster = section.settings.image -%}
              {%- endif -%}
              {%- if video_poster != blank -%}
                {{
                  video_poster
                  | image_url: width: 1920
                  | image_tag:
                    widths: '750, 1100, 1500, 1920',
                    sizes: '100vw',
                    loading: media_loading,
                    fetchpriority: media_priority,
                    class: 'yv-image-banner__poster'
                }}
              {%- endif -%}
              <video
                class="yv-image-banner__video-element"
                playsinline
                muted
                autoplay
                loop
                preload="metadata"
                aria-hidden="true"
                ref="videoElement"
              >
                {%- for source in section.settings.video.sources -%}
                  <source
                    data-video-source="{{ source.url }}"
                    type="{{ source.mime_type }}"
                    ref="videoSources[]"
                  >
                {%- endfor -%}
              </video>
            </video-background-component>
          {%- else -%}
            {% render 'yv-video-url',
              url: section.settings.video_url,
              poster: section.settings.image,
              loading: media_loading
            %}
          {%- endif -%}
        </div>
      {%- elsif has_image -%}
        {{
          section.settings.image
          | image_url: width: 3000
          | image_tag:
            widths: '750, 1100, 1500, 1920, 2400, 3000',
            sizes: '100vw',
            loading: media_loading,
            fetchpriority: media_priority,
            class: 'yv-image-banner__image yv-image-banner__image--desktop'
        }}
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'yv-image-banner__image yv-image-banner__image--desktop yv-placeholder' }}
      {%- endif -%}

      {%- if has_mobile_image -%}
        {{
          section.settings.mobile_image
          | image_url: width: 1200
          | image_tag:
            widths: '390, 600, 800, 1000, 1200',
            sizes: '100vw',
            loading: media_loading,
            fetchpriority: media_priority,
            class: 'yv-image-banner__image yv-image-banner__image--mobile'
        }}
      {%- endif -%}
    </div>

    <div
      class="yv-overlay"
      style="--yv-overlay-color: {{ section.settings.overlay_color }}; --yv-overlay-opacity: {{ section.settings.overlay_opacity }};"
    ></div>

    <div class="yv-image-banner__inner">
      <div class="yv-image-banner__content-area yv-pos-d--{{ section.settings.content_position_desktop }} yv-pos-m--{{ section.settings.content_position_mobile }}">
        <div class="yv-image-banner__content">
          {% render 'yv-heading',
            text: section.settings.heading,
            tag: section.settings.heading_tag,
            size: 'h1',
            highlight_font: section.settings.highlight_font,
            highlight_color: section.settings.highlight_color,
            rotating_text: section.settings.rotating_text,
            subheading: section.settings.subheading,
            description: section.settings.description,
            alignment: section.settings.text_alignment,
            class: 'yv-image-banner__heading',
            title_class: 'yv-image-banner__title',
            reveal: true
          %}
          {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
            <div class="yv-image-banner__actions yv-image-banner__actions--{{ section.settings.text_alignment }}">
              {% render 'yv-button',
                label: section.settings.button_label,
                link: section.settings.button_link,
                variant: section.settings.button_style,
                size_desktop: section.settings.button_size_desktop,
                size_mobile: section.settings.button_size_mobile,
                new_tab: section.settings.button_new_tab,
                bg: section.settings.button_background,
                text: section.settings.button_text_color,
                border: section.settings.button_border,
                reveal: true
              %}
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- content_for 'blocks' -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .yv-image-banner__box {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-width: 0;
    background-color: var(--yv-image-bg);
  }

  .yv-image-banner__box--full {
    display: grid;
    grid-template-columns: var(--full-page-grid-with-margins);
  }

  .yv-image-banner__box--full > .yv-image-banner__inner {
    grid-column: 2;
  }

  .yv-image-banner__box--boxed {
    border-radius: var(--yv-layout-radius, 0);
  }

  .yv-image-banner__box--boxed > .yv-image-banner__inner {
    padding-inline: 20px;
  }

  @media screen and (min-width: 750px) {
    .yv-image-banner__box--boxed > .yv-image-banner__inner {
      padding-inline: 40px;
    }
  }

  .yv-image-banner__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .yv-image-banner__media > :is(img, svg),
  .yv-image-banner__poster,
  .yv-image-banner__video-element {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .yv-image-banner__video,
  .yv-image-banner__video-player {
    position: absolute;
    inset: 0;
    display: block;
  }

  .yv-image-banner__image--mobile {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .yv-image-banner__media--has-mobile .yv-image-banner__image--desktop,
    .yv-image-banner__video--desktop {
      display: none;
    }

    .yv-image-banner__image--mobile {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .yv-image-banner__video-element {
      display: none;
    }
  }

  .yv-image-banner__box > .yv-overlay {
    z-index: 1;
  }

  .yv-image-banner__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: var(--yv-image-banner-height-mobile, 500px);
  }

  @media screen and (min-width: 750px) {
    .yv-image-banner__inner {
      min-height: var(--yv-image-banner-height, 750px);
    }
  }

  .yv-image-banner__content-area {
    flex: 1 1 auto;
    min-width: 0;
    padding-block-start: var(--yv-image-banner-header-offset, 0px);
  }

  /* First section, full width: the banner runs under a transparent header, so the copy starts below it. */
  main > .shopify-section:first-child .yv-image-banner__box--full {
    --yv-image-banner-header-offset: calc(var(--header-height, 0px) * var(--transparent-header-offset-boolean, 0));
  }

  .yv-image-banner__content {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
    min-width: 0;
    padding: 35px 0;
  }

  @media screen and (min-width: 750px) {
    .yv-image-banner__content {
      max-width: 75%;
      padding: 50px 10px;
    }
  }

  @media screen and (min-width: 990px) {
    .yv-image-banner__content {
      max-width: var(--yv-image-banner-content-width, 55%);
    }
  }

  .yv-image-banner__heading {
    --yv-heading-gap: 20px;
    --yv-subheading-color: var(--yv-image-banner-text-color, #f1f1f1);

    color: var(--yv-image-banner-text-color, #f1f1f1);
  }

  .yv-image-banner .yv-image-banner__heading .yv-image-banner__title {
    font-size: min(var(--yv-image-banner-heading-size, 54px), 36px);
    line-height: 1.1;
    color: var(--yv-image-banner-heading-color, #fff);
    overflow-wrap: anywhere;
  }

  @media screen and (min-width: 750px) {
    .yv-image-banner .yv-image-banner__heading .yv-image-banner__title {
      font-size: calc(var(--yv-image-banner-heading-size, 54px) * 0.65);
    }
  }

  @media screen and (min-width: 1200px) {
    .yv-image-banner .yv-image-banner__heading .yv-image-banner__title {
      font-size: calc(var(--yv-image-banner-heading-size, 54px) * 0.85);
    }
  }

  @media screen and (min-width: 1441px) {
    .yv-image-banner .yv-image-banner__heading .yv-image-banner__title {
      font-size: var(--yv-image-banner-heading-size, 54px);
    }
  }

  .yv-image-banner__heading .yv-heading__description {
    color: var(--yv-image-banner-text-color, #f1f1f1);
  }

  .yv-image-banner__heading .yv-heading__description :is(p, ul, ol) {
    margin-block: 0;
  }

  .yv-image-banner__actions {
    display: flex;
    justify-content: flex-start;
  }

  .yv-image-banner__actions--center {
    justify-content: center;
  }

  .yv-image-banner__actions--right {
    justify-content: flex-end;
  }
{% endstylesheet %}

