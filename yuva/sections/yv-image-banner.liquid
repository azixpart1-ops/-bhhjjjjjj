      "type": "select",
      "id": "media_type",
      "label": "t:yv.image_banner.settings.media_type",
      "options": [
        {
          "value": "image",
          "label": "t:yv.common.options.image"
        },
        {
          "value": "video",
          "label": "t:yv.common.options.video"
        }
