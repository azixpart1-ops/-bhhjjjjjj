{%- comment -%}
  PL: Start with sleep. On a collection page, four beds for the
  four most common needs, then the Bed Finder tile. Cuts a 40-bed grid
  down to a first choice (Hick's law) before the grid begins.
{%- endcomment -%}
{%- render 'yv-assets' -%}
<section class="yv yv--tight yv--{{ section.settings.tone }}">
  <div class="yv-wrap">
    <h2 class="yv-sub" style="margin-bottom:1.25rem">{{ section.settings.heading }}</h2>
    <div class="yv-grid yv-grid--4">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p != blank -%}
          <div {{ block.shopify_attributes }}>{% render 'yv-product-card', product: p, role: block.settings.role %}</div>
        {%- endif -%}
      {%- endfor -%}
      <a class="yv-card yv-card--pick" href="/pages/bed-finder" style="display:flex;flex-direction:column;justify-content:center;gap:.5rem;text-decoration:none">
        <span class="yv-eyebrow">Not sure?</span>
        <strong class="yv-sub">{{ section.settings.finder_heading }}</strong>
        <span class="yv-muted">{{ section.settings.finder_text }}</span>
        <span class="yv-btn yv-btn--primary" style="margin-top:.75rem;align-self:flex-start">Find their bed</span>
      </a>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "PL: Start with sleep",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Start with how they sleep" },
    { "type": "text", "id": "finder_heading", "label": "Finder tile heading", "default": "Four questions, one bed." },
    { "type": "text", "id": "finder_text", "label": "Finder tile text", "default": "How they sleep, their joints, their size, their name. About 30 seconds." },
    { "type": "select", "id": "tone", "label": "Surface", "options": [ { "value": "page", "label": "Page" }, { "value": "oat", "label": "Oat" } ], "default": "page" }
  ],
  "blocks": [
    { "type": "bed", "name": "Bed", "limit": 4, "settings": [
      { "type": "product", "id": "product", "label": "Bed" },
      { "type": "text", "id": "role", "label": "Best for", "default": "Best for dogs who curl up" }
    ] }
  ],
  "presets": [ { "name": "PL: Start with sleep", "blocks": [
    { "type": "bed", "settings": { "role": "Best for dogs who curl up" } },
    { "type": "bed", "settings": { "role": "Best for dogs who lean" } },
    { "type": "bed", "settings": { "role": "Best for dogs who sprawl" } },
    { "type": "bed", "settings": { "role": "Best for stiff mornings" } }
  ] } ]
}
{% endschema %}
