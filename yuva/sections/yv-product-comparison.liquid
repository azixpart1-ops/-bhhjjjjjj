{% comment %}
  Section contract: yv-product-comparison
  Yuva "Product comparison grid" (docs part 4, KB): 2–4 Compare product columns side by side.
  Each column is a card whose eight rows (image, title, description, price, buttons, feature image,
  feature heading, feature content) line up across the cards through CSS subgrid. Below 750px the
  cards become a horizontal scroll row at 80% width. Highlight heading + description above.
  Shared settings: highlight heading, colour set, button sizes, visibility, spacing.
{% endcomment %}

{%- liquid
  render 'yv-color-set', set: section.settings.color_set, section_id: section.id
  assign column_count = section.blocks.size | at_least: 1
  assign alignment = section.settings.text_alignment | default: 'center'
-%}

<div class="section-background color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings, visibility_only: true %}"></div>
<div
  class="section section--page-width yv-section-spacing color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings %}"
  style="{% render 'yv-section-spacing-style', settings: section.settings %}"
>
  <div class="yv-container yv-container--page">
    <div class="yv-compare yv-compare--{{ section.settings.content_width | default: 'large' }}">
      {% render 'yv-heading',
        text: section.settings.heading,
        tag: section.settings.heading_tag,
        size: section.settings.heading_size_level,
        highlight_font: section.settings.highlight_font,
        highlight_color: section.settings.highlight_color,
        rotating_text: section.settings.rotating_text,
        description: section.settings.description,
        alignment: alignment,
        class: 'yv-compare__header'
      %}

      <div
        class="yv-compare__grid"
        style="--yv-compare-columns: {{ column_count }};"
      >
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .yv-compare {
    margin-inline: auto;
    max-width: 1270px;
  }

  .yv-compare--small {
    max-width: 800px;
  }

  .yv-compare--medium {
    max-width: 1000px;
  }

  .yv-compare__header {
    margin-block-end: 40px;
  }

  .yv-compare__grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 80%;
    grid-template-rows: repeat(8, auto);
    column-gap: 15px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-block-end: 2px;
  }

  .yv-compare__grid::-webkit-scrollbar {
    display: none;
  }

  .yv-compare__card {
    display: grid;
    grid-row: span 8;
    grid-template-rows: subgrid;
    row-gap: 12px;
    min-width: 0;
    padding: 20px;
    border: 1px solid var(--yv-border-color, rgb(0 0 0 / 0.1));
    border-radius: var(--yv-radius, 10px);
    background: var(--yv-card-bg, var(--color-background));
    scroll-snap-align: start;
  }

  .yv-compare__cell {
    min-width: 0;
  }

  .yv-compare__cell:empty {
    min-height: 0;
  }

  .yv-compare__media {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: calc(var(--yv-radius, 10px) - 4px);
    background: var(--yv-image-bg, #f3efec);
  }

  .yv-compare__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .yv-compare__title {
    margin: 0;
  }

  .yv-compare__title a {
    color: inherit;
    text-decoration: none;
  }

  .yv-compare__title a:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .yv-compare__description p {
    margin: 0;
  }

  .yv-compare__price {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
  }

  .yv-compare__price-current {
    font-family: var(--yv-price-font-family, var(--font-body--family));
    font-weight: 700;
    font-size: var(--yv-text-lg, 1rem);
  }

  .yv-compare__price-compare {
    opacity: 0.7;
    font-size: var(--yv-text-sm, 0.75rem);
  }

  .yv-compare__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .yv-compare__actions > * {
    flex: 1 1 auto;
  }

  .yv-compare__feature-image {
    width: 48px;
    height: 48px;
    object-fit: contain;
  }

  .yv-compare__feature-heading {
    margin: 0;
  }

  .yv-compare__feature-content > :first-child {
    margin-block-start: 0;
  }

  .yv-compare__feature-content > :last-child {
    margin-block-end: 0;
  }

  @media screen and (min-width: 750px) {
    .yv-compare__grid {
      grid-auto-flow: row;
      grid-template-columns: repeat(var(--yv-compare-columns, 3), minmax(0, 1fr));
      grid-auto-columns: auto;
      column-gap: 20px;
      overflow: visible;
    }
  }
{% endstylesheet %}

