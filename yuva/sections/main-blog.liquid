<script
  src="{{ 'blog-posts-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
{%- comment -%}
  yv: Yuva blog. Layout "Grid" (default) renders the Yuva title band (the title block), tags filter,
  3-column card grid and pagination (snippets/yv-blog-posts.liquid, assets/yv-blog.css);
  "Editorial" keeps Horizon's own layout below unchanged.
{%- endcomment -%}
{{ 'yv-blog.css' | asset_url | stylesheet_tag }}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<blog-posts-list section-id="{{ section.id }}">
  <div
    class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  ></div>
  <div
    class="
      section
      {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
      blog-posts
      spacing-style
      size-style
      {% if section.settings.layout != 'editorial' %}yv-blog-section{% endif %}
    "
    data-testid="blog-posts"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {% content_for 'blocks' %}

    {%- if section.settings.layout != 'editorial' -%}
      {%- comment -%} yv: Yuva grid layout. {%- endcomment -%}
      {%- paginate blog.articles by section.settings.posts_per_page -%}
        {% render 'yv-blog-posts', blog: blog, paginate: paginate, section_settings: section.settings %}
      {%- endpaginate -%}
    {%- else -%}
    <div
      ref="grid"
      class="blog-posts-container"
    >
      {% liquid
        assign items_on_page = blog.articles.size
        assign image_index = 0

        # The first two images reach the initial mobile viewport; later images use native lazy-loading.
        assign eager_image_count = 2

        # These sizes mirror --narrow-page-width in theme-styles-variables.liquid,
        # --page-margin in base.css, and --columns-gap plus the mobile breakpoint below.
        # Desktop content uses a 40px page margin on each side, with 36px column gaps.
        # Compact cards use three columns and two gaps, standard cards use two columns and one gap,
        # and the hero image uses 70% of the full-width card after its image-content gap.
        assign compact_image_sizes = '(min-width: 1520px) 456px, (min-width: 750px) calc(33.33vw - 51px), calc(100vw - 32px)'
        assign standard_image_sizes = '(min-width: 1520px) 702px, (min-width: 750px) calc(50vw - 58px), calc(100vw - 32px)'
        assign hero_image_sizes = '(min-width: 1520px) 983px, (min-width: 750px) calc(70vw - 81px), calc(100vw - 32px)'
      %}
      {% for article in blog.articles %}
        {% liquid
          # Defaults for compact layout
          assign col_span = 2
          assign scale = 0.6
          assign is_horizontal = false

          case items_on_page
            when 1
              # Single post: full width hero
              assign col_span = 6
              assign scale = 1
              assign is_horizontal = true
            when 2
              # Two posts: both standard side by side
              assign col_span = 3
              assign scale = 0.8
            when 3
              # Three posts: hero + 2 standard
              if forloop.index == 1
                assign col_span = 6
                assign scale = 1
                assign is_horizontal = true
              else
                assign col_span = 3
                assign scale = 0.8
              endif
            when 4
              # Four posts: all standard in 2x2 grid
              assign col_span = 3
              assign scale = 0.8
            when 5
              # Five posts: hero + 4 standard
              if forloop.index == 1
                assign col_span = 6
                assign scale = 1
                assign is_horizontal = true
              else
                assign col_span = 3
                assign scale = 0.8
              endif
            else
              # 6+ posts: hero, 2 standard, rest compact
              if forloop.index == 1
                assign col_span = 6
                assign scale = 1
                assign is_horizontal = true
              elsif forloop.index <= 3
                assign col_span = 3
                assign scale = 0.8
              else
                assign col_span = 2
                assign scale = 0.6
              endif
          endcase

          case col_span
            when 2
              assign image_sizes = compact_image_sizes
            when 3
              assign image_sizes = standard_image_sizes
            when 6
              assign image_sizes = hero_image_sizes
            else
              # Safe fallback for a future span; add a matching sizes value with any new layout.
              assign image_sizes = '100vw'
          endcase

          assign image_loading = 'lazy'
          assign image_fetch_priority = 'auto'
          if article.image
            assign image_index = image_index | plus: 1

            if image_index <= eager_image_count
              assign image_loading = 'eager'
            endif

            if image_index == 1
              assign image_fetch_priority = 'high'
            endif
          endif
        %}
        {% # Keep the mobile breakpoint in the style block below in sync with the responsive image sizes above. %}
        {% style %}
          [data-blog-index="{{ section.id }}-{{ forloop.index }}"] {
            --col-span: {{ col_span }};
            --blog-post-card-scale: {{ scale }};
          }

          @media screen and (max-width: 749px) {
            [data-blog-index="{{ section.id }}-{{ forloop.index }}"] {
              --col-span: 6;
              --blog-post-card-scale: 0.5;
            }
          }
        {% endstyle %}
        <div
          class="blog-post-item"
          data-testid="blog-post-item"
          data-blog-index="{{ section.id }}-{{ forloop.index }}"
        >
          {% content_for 'block',
            id: 'static-blog-post-card',
            type: '_blog-post-card',
            article: article,
            image_sizes: image_sizes,
            image_loading: image_loading,
            image_fetch_priority: image_fetch_priority,
            is_horizontal: is_horizontal
          %}
        </div>
      {% endfor %}
    </div>
    {%- endif -%}
  </div>
</blog-posts-list>

{% stylesheet %}
  /**
   * Blog posts page layout
   */
  .blog-posts {
    --page-content-width: var(--narrow-page-width);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));

    /* Keep the responsive image sizes above in sync with this gap. */
    --columns-gap: 36px;
    --rows-gap: 36px;
  }

  .blog-posts-container {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1rem;
    width: 100%;
    column-gap: var(--columns-gap);
    row-gap: var(--rows-gap);
  }

  /**
   * Blog post item grid positioning and scaling.
   * Layout is calculated in Liquid based on total article count.
   * Mobile overrides are applied per-item in inline styles for proper specificity.
   */
  .blog-post-item {
    grid-column: span var(--col-span);
    background-color: var(--color-background);
  }

  /**
   * When there's no image, the blog post item has a border.
   */
  .blog-post-item {
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
    padding: 0 1rem 1rem;
  }

  .blog-post-item:has(.blog-post-card__image-container) {
    border: none;
    padding: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_posts",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "t:yv.blog.settings.layout",
      "info": "t:yv.blog.settings.layout_info",
      "options": [
        {
          "value": "grid",
          "label": "t:yv.blog.options.grid"
        },
        {
          "value": "editorial",
          "label": "t:yv.blog.options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "label": "t:yv.blog.settings.posts_per_page",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 9,
      "visible_if": "{{ section.settings.layout != 'editorial' }}"
    },
    {
      "type": "checkbox",
      "id": "show_tags_filter",
      "label": "t:yv.blog.settings.show_tags_filter",
      "info": "t:yv.blog.settings.show_tags_filter_info",
      "default": false,
      "visible_if": "{{ section.settings.layout != 'editorial' }}"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "t:yv.blog.settings.show_date",
      "default": true,
      "visible_if": "{{ section.settings.layout != 'editorial' }}"
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "t:yv.blog.settings.show_tags",
      "info": "t:yv.blog.settings.show_tags_info",
      "default": false,
      "visible_if": "{{ section.settings.layout != 'editorial' }}"
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "t:yv.blog.settings.show_excerpt",
      "default": true,
      "visible_if": "{{ section.settings.layout != 'editorial' }}"
    },
    {
      "type": "checkbox",
      "id": "show_comments_count",
      "label": "t:yv.blog.settings.show_comments_count",
      "default": true,
      "visible_if": "{{ section.settings.layout != 'editorial' }}"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
