{% liquid
  assign section_collections = collections
  assign max_items = 20
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{%- comment -%}
  yv: Yuva collections list page: "Content overlay" tiles (image, centred title, hover
  glass bar with an arrow; list rows on small phones) in assets/yv-collection.css, collections per
  page with pagination, All / Selected collections and six sort orders.
  Shopify caps how many collections a template can read outside pagination; sorts other than A-Z
  read that list first, then paginate only to get the page offset.
  "Selected" lists the Collection blocks (blocks/_yv-list-collection.liquid) in editor order,
  without sorting or pagination. Those blocks print their tile between <!--yv-list-item--> markers;
  the capture below moves the tiles into the grid and keeps the other blocks above it.
{%- endcomment -%}
{{ 'yv-collection.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign yv_per_page = section.settings.per_page | default: 16
  assign yv_selected = false
  if section.settings.show_collections == 'selected'
    assign yv_selected = true
  endif

  assign yv_sorted = collections
  case section.settings.sort_by
    when 'alpha_desc'
      assign yv_sorted = collections | sort_natural: 'title' | reverse
    when 'date_desc'
      assign yv_sorted = collections | sort: 'published_at' | reverse
    when 'date_asc'
      assign yv_sorted = collections | sort: 'published_at'
    when 'count_desc'
      assign yv_sorted = collections | sort: 'products_count' | reverse
    when 'count_asc'
      assign yv_sorted = collections | sort: 'products_count'
  endcase

  assign yv_rows = false
  if section.settings.mobile_columns == '1' and section.settings.layout_type == 'grid' and section.settings.carousel_on_mobile == false
    assign yv_rows = true
  endif
-%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div
  class="
    section
    section--{{ section.settings.section_width }}
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    section-resource-list
    spacing-style
    gap-style
    yv-collection-list
    yv-collection-list--{{ section.settings.card_style | default: 'overlay' }}
    {% if yv_rows %}yv-collection-list--rows{% endif %}
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
>
  {%- capture yv_blocks_html -%}
    {%- content_for 'blocks' -%}
  {%- endcapture -%}
  {%- liquid
    # yv: split the Collection block tiles (between markers) from the other blocks.
    assign yv_header_html = yv_blocks_html
    assign yv_block_items = ''
    assign yv_block_count = 0
    if yv_blocks_html contains '<!--yv-list-item-->'
      assign yv_header_html = ''
      assign yv_chunks = yv_blocks_html | split: '<!--yv-list-item-->'
      for yv_chunk in yv_chunks
        if yv_chunk contains '<!--/yv-list-item-->'
          assign yv_pair = yv_chunk | split: '<!--/yv-list-item-->'
          if yv_block_count > 0
            assign yv_block_items = yv_block_items | append: '<!--@list/split-->'
          endif
          assign yv_block_items = yv_block_items | append: '<div class="resource-list__item">' | append: yv_pair[0] | append: '</div>'
          assign yv_block_count = yv_block_count | plus: 1
          assign yv_header_html = yv_header_html | append: yv_pair[1]
        else
          assign yv_header_html = yv_header_html | append: yv_chunk
        endif
      endfor
    endif
  -%}

  <div class="section-resource-list__content">
    {{- yv_header_html | strip -}}
  </div>

  {% if section_collections == null %}
    {% for i in (1..max_items) %}
      {% assign section_collections = section_collections | append: ', ' %}
    {% endfor %}

    {% assign section_collections = section_collections | split: ',' %}
  {% endif %}

  {%- comment -%} yv: Yuva collection source, sort order and pagination {%- endcomment -%}
  {% paginate collections by yv_per_page %}
    {% liquid
      if yv_selected
        assign yv_offset = 0
        assign yv_limit = 0
      elsif collections.size > 0
        assign section_collections = yv_sorted
        assign yv_offset = paginate.current_offset
        assign yv_limit = yv_per_page
        if section.settings.sort_by == 'alpha_asc' or section.settings.sort_by == blank
          assign section_collections = collections
          assign yv_offset = 0
        endif
      else
        assign yv_offset = 0
        assign yv_limit = max_items
      endif
      assign yv_count = 0
    %}

    {% capture list_items %}
      {% unless yv_selected %}
      {% for collection in section_collections offset: yv_offset limit: yv_limit %}
        {% assign yv_count = yv_count | plus: 1 %}
        <div class="resource-list__item">
          {% content_for 'block', type: '_collection-card', id: 'static-collection-card', closest.collection: collection %}
        </div>
        {% unless forloop.last %}
          <!--@list/split-->
        {% endunless %}
      {% endfor %}
      {% endunless %}
    {% endcapture %}

    {% liquid
      if yv_selected
        assign list_items = yv_block_items
        assign yv_count = yv_block_count
      endif

      # Create an array from the list items to be used for different layout types
      assign list_items_array = list_items | strip | split: '<!--@list/split-->'
    %}

    {% if yv_count > 0 %}
      {% render 'resource-list',
        list_items: list_items,
        list_items_array: list_items_array,
        settings: section.settings,
        carousel_ref: 'mainCollectionList',
        slide_count: yv_count,
        content_type: 'collections',
        test_id: 'collections-list-grid'
      %}
    {% else %}
      <p class="yv-collection-list__empty">{{ 'yv.collection_list.empty' | t }}</p>
    {% endif %}

    {% unless yv_selected %}
      {% render 'pagination-controls', paginate: paginate %}
    {% endunless %}
  {% endpaginate %}
</div>

{% schema %}
{
  "name": "t:names.collection_list",
  "class": "ui-test-collection-list",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "_divider"
    },
    {
      "type": "_yv-list-collection"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.cards_layout"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "t:yv.collection_list.settings.card_style",
      "options": [
        {
          "value": "overlay",
          "label": "t:yv.collection_list.options.overlay"
        },
        {
          "value": "below",
          "label": "t:yv.collection_list.options.below"
        }
      ],
      "default": "overlay"
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "t:yv.collection_list.settings.per_page",
      "info": "t:yv.collection_list.settings.per_page_info",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 16
    },
    {
      "type": "radio",
      "id": "show_collections",
      "label": "t:yv.collection_list.settings.show_collections",
      "info": "t:yv.collection_list.settings.show_collections_info",
      "options": [
        {
          "value": "all",
          "label": "t:yv.collection_list.options.all"
        },
        {
          "value": "selected",
          "label": "t:yv.collection_list.options.selected"
        }
      ],
      "default": "all"
    },
    {
      "type": "select",
      "id": "sort_by",
      "label": "t:yv.collection_list.settings.sort_by",
      "options": [
        {
          "value": "alpha_asc",
          "label": "t:yv.collection_list.options.alpha_asc"
        },
        {
          "value": "alpha_desc",
          "label": "t:yv.collection_list.options.alpha_desc"
        },
        {
          "value": "date_desc",
          "label": "t:yv.collection_list.options.date_desc"
        },
        {
          "value": "date_asc",
          "label": "t:yv.collection_list.options.date_asc"
        },
        {
          "value": "count_desc",
          "label": "t:yv.collection_list.options.count_desc"
        },
        {
          "value": "count_asc",
          "label": "t:yv.collection_list.options.count_asc"
        }
      ],
      "default": "alpha_asc",
      "visible_if": "{{ section.settings.show_collections != 'selected' }}"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.layout_type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "carousel",
          "label": "t:options.carousel"
        },
        {
          "value": "bento",
          "label": "t:options.bento"
        },
        {
          "value": "editorial",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "t:settings.carousel_on_mobile",
      "default": false,
      "visible_if": "{{ section.settings.layout_type != 'carousel' }}"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.layout_type == 'grid' or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "1",
          "label": "t:options.one_number"
        },
        {
          "value": "2",
          "label": "t:options.two_number"
        }
      ],
      "default": "2",
      "visible_if": "{{ section.settings.layout_type == 'grid' and section.settings.carousel_on_mobile == false }}"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.layout_type == 'grid' or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "bento_gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.layout_type == 'bento' }}"
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.layout_type == 'grid'}}"
    },
    {
      "type": "range",
      "id": "max_collections",
      "label": "t:settings.collection_count",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.layout_type == 'editorial' }}"
    },
    {
      "type": "header",
      "content": "t:content.carousel_navigation",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrows"
        },
        {
          "value": "chevron",
          "label": "t:options.chevrons"
        },
        {
          "value": "arrows_large",
          "label": "t:options.arrows_large"
        },
        {
          "value": "chevron_large",
          "label": "t:options.chevron_large"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "t:settings.icon_background",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "circle",
          "label": "t:options.circle"
        },
        {
          "value": "square",
          "label": "t:options.square"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.icons_style != 'none' and section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
