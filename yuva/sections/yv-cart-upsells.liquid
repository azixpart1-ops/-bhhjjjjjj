{% comment %}
  Section contract: yv-cart-upsells (rendering only, never added in the editor)
  Returns the cart upsell product rows for `assets/yv-cart.js`:
    /recommendations/products?product_id=<first cart product>&intent=<related|complementary>&limit=<n>&section_id=yv-cart-upsells
  Source follows Theme settings > Cart drawer > Product upsells: the Search & Discovery
  recommendations for related/complementary, or the chosen Product list. Rows for products already
  in the cart and for the gift-wrap product are left out (snippets/yv-cart-upsells.liquid).
{% endcomment %}

{%- liquid
  if settings.yv_upsell_source == 'list'
    assign upsell_products = settings.yv_upsell_products
  else
    assign upsell_products = recommendations.products
  endif
-%}

<ul
  class="yv-cart-upsells__items"
  role="list"
  data-yv-upsell-items
>
  {%- if settings.yv_upsell_enable and upsell_products != blank -%}
    {% render 'yv-cart-upsells', part: 'items', products: upsell_products %}
  {%- endif -%}
</ul>

{% schema %}
{
  "name": "t:yv.names.cart_upsells",
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
