{% comment %}
  Section contract: yv-news-ticker
  Yuva "News ticker" (the infinite text loop): one or two full-bleed rows of promotional text,
  each an independent seamless marquee (snippets/yv-marquee.liquid) with its own font family,
  direction, sizes and colours. Bold words render as outlined text. Optional separator glyph
  between repeats, hairline top/bottom borders, and a background colour, gradient, image or
  Shopify-hosted video with an overlay and minimum heights.
  Shared settings: visibility, spacing (borders use the shared classes with their own width).
  @example
  Theme editor > Add section > Text > "News ticker"
{% endcomment %}

{%- liquid
  render 'contrast-override', background_color: section.settings.color_bg, text_color: section.settings.color_heading, section_id: section.id

  assign has_image = false
  if section.settings.bg_image != blank
    assign has_image = true
  endif
  assign has_video = false
  if section.settings.bg_video != blank
    assign has_video = true
  endif
  assign has_media = false
  if has_image or has_video
    assign has_media = true
  endif

  case section.settings.border_width
    when 'medium'
      assign border_width = '2px'
    when 'thick'
      assign border_width = '3px'
    else
      assign border_width = '1px'
  endcase

  case section.settings.separator
    when 'dash'
      assign separator_html = '-'
    when 'slash'
      assign separator_html = '/'
    when 'dot'
      assign separator_html = '<svg class="yv-news-ticker__glyph yv-news-ticker__glyph--dot" viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="5"/></svg>'
    when 'star'
      assign separator_html = '<svg class="yv-news-ticker__glyph" viewBox="0 0 24 24" focusable="false"><path d="M12 0c.9 7.4 4.6 11.1 12 12-7.4.9-11.1 4.6-12 12-.9-7.4-4.6-11.1-12-12 7.4-.9 11.1-4.6 12-12z"/></svg>'
    when 'sunburst'
      capture separator_html
        echo '<svg class="yv-news-ticker__glyph" viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="2.6"/>'
        for angle in (0..7)
          assign rotation = angle | times: 45
          echo '<ellipse cx="12" cy="5.2" rx="1.9" ry="4.4" transform="rotate(' | append: rotation | append: ' 12 12)"/>'
        endfor
        echo '</svg>'
      endcapture
    else
      assign separator_html = ''
  endcase

  assign heading_direction = 'left'
  if section.settings.direction_heading == 'ltr'
    assign heading_direction = 'right'
  endif
  assign subheading_direction = 'left'
  if section.settings.direction_subheading == 'ltr'
    assign subheading_direction = 'right'
  endif

  assign heading_stroke = '1px'
  if section.settings.size_heading_desktop >= 60
    assign heading_stroke = '2px'
  endif
  assign subheading_stroke = '1px'
  if section.settings.size_subheading_desktop >= 60
    assign subheading_stroke = '2px'
  endif

  assign bg_gradient = section.settings.color_bg_gradient | append: '' | strip
-%}

{%- capture heading_items -%}
  <span class="yv-news-ticker__text">{{ section.settings.heading }}</span>
  {%- if separator_html != blank -%}
    <span class="yv-news-ticker__separator" aria-hidden="true">{{ separator_html }}</span>
  {%- endif -%}
{%- endcapture -%}

{%- capture subheading_items -%}
  <span class="yv-news-ticker__text">{{ section.settings.subheading }}</span>
  {%- if separator_html != blank -%}
    <span class="yv-news-ticker__separator" aria-hidden="true">{{ separator_html }}</span>
  {%- endif -%}
{%- endcapture -%}

{%- if section.settings.heading != blank or section.settings.subheading != blank -%}
<div
  class="section-background color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings, visibility_only: true %}"
  {% if bg_gradient != blank %}
    style="background: {{ bg_gradient }};"
  {% endif %}
></div>
<div
  class="section section--full-width yv-section-spacing yv-news-ticker color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings %}{% if has_media %} yv-news-ticker--media{% endif %}"
  style="
    {%- render 'yv-section-spacing-style', settings: section.settings -%}
    --yv-section-border-width: {{ border_width }};
    {%- if section.settings.color_border != blank %} --yv-border-color: {{ section.settings.color_border }};{% endif %}
    --yv-news-ticker-spacing-d: {{ section.settings.item_spacing_desktop }}px;
    --yv-news-ticker-spacing-m: {{ section.settings.item_spacing_mobile }}px;
    --yv-news-ticker-min-height-d: {{ section.settings.min_height_desktop }}px;
    --yv-news-ticker-min-height-m: {{ section.settings.min_height_mobile }}px;
  "
  data-testid="yv-news-ticker"
>
  {%- if has_media -%}
    <div
      class="yv-news-ticker__media"
      aria-hidden="true"
    >
      {%- liquid
        assign media_loading = 'lazy'
        if section.index <= 2
          assign media_loading = 'eager'
        endif
        assign poster = section.settings.bg_image
        if poster == blank and has_video
          assign poster = section.settings.bg_video.preview_image
        endif
      -%}
      {%- if poster != blank -%}
        {{
          poster
          | image_url: width: 2400
          | image_tag:
            widths: '750, 1100, 1500, 1920, 2400',
            sizes: '100vw',
            loading: media_loading,
            alt: '',
            class: 'yv-news-ticker__image'
        }}
      {%- endif -%}
      {%- if has_video -%}
        <script
          src="{{ 'yv-autoplay-video.js' | asset_url }}"
          type="module"
          fetchpriority="low"
        ></script>
        <yv-autoplay-video-component class="yv-news-ticker__video">
          <video
            ref="video"
            muted
            loop
            playsinline
            preload="none"
            {% if poster != blank %}
              poster="{{ poster | image_url: width: 1920 }}"
            {% endif %}
          >
            {%- for source in section.settings.bg_video.sources -%}
              <source
                data-src="{{ source.url }}"
                type="{{ source.mime_type }}"
              >
            {%- endfor -%}
          </video>
        </yv-autoplay-video-component>
      {%- endif -%}
      <div
        class="yv-overlay"
        style="--yv-overlay-color: {{ section.settings.color_overlay }}; --yv-overlay-opacity: {{ section.settings.overlay_opacity }};"
      ></div>
    </div>
  {%- endif -%}

  <div class="yv-news-ticker__rows">
    {%- if section.settings.heading != blank -%}
      {%- capture heading_style -%}
        --yv-news-ticker-size-d: {{ section.settings.size_heading_desktop }}px; --yv-news-ticker-size-m: {{ section.settings.size_heading_mobile }}px; --yv-news-ticker-family: var(--font-{{ section.settings.font_heading }}--family); --yv-news-ticker-font-style: var(--font-{{ section.settings.font_heading }}--style); --yv-news-ticker-color: {{ section.settings.color_heading }}; --yv-news-ticker-outline: {{ section.settings.color_heading_outline }}; --yv-news-ticker-stroke: {{ heading_stroke }};
      {%- endcapture -%}
      {%- assign heading_class = 'yv-news-ticker__row yv-news-ticker__row--' | append: section.settings.font_heading -%}
      {% render 'yv-marquee',
        content: heading_items,
        direction: heading_direction,
        speed: section.settings.speed,
        pause_on_hover: section.settings.pause_on_hover,
        class: heading_class,
        style: heading_style
      %}
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      {%- capture subheading_style -%}
        --yv-news-ticker-size-d: {{ section.settings.size_subheading_desktop }}px; --yv-news-ticker-size-m: {{ section.settings.size_subheading_mobile }}px; --yv-news-ticker-family: var(--font-{{ section.settings.font_subheading }}--family); --yv-news-ticker-font-style: var(--font-{{ section.settings.font_subheading }}--style); --yv-news-ticker-color: {{ section.settings.color_subheading }}; --yv-news-ticker-outline: {{ section.settings.color_subheading_outline }}; --yv-news-ticker-stroke: {{ subheading_stroke }};
      {%- endcapture -%}
      {%- assign subheading_class = 'yv-news-ticker__row yv-news-ticker__row--' | append: section.settings.font_subheading -%}
      {% render 'yv-marquee',
        content: subheading_items,
        direction: subheading_direction,
        speed: section.settings.speed,
        pause_on_hover: section.settings.pause_on_hover,
        class: subheading_class,
        style: subheading_style
      %}
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% stylesheet %}
  .yv-news-ticker {
    --yv-news-ticker-spacing: var(--yv-news-ticker-spacing-m, 17px);

    position: relative;
    overflow: hidden;
    user-select: none;
  }

  .yv-news-ticker--media {
    align-content: center;
    min-height: var(--yv-news-ticker-min-height-m, 0px);
  }

  .yv-news-ticker__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background-color: var(--yv-image-bg, transparent);
  }

  .yv-news-ticker__media :is(img, video),
  .yv-news-ticker__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: reduce) {
    .yv-news-ticker__video {
      display: none;
    }
  }

  .yv-news-ticker__rows {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    min-width: 0;
  }

  .yv-news-ticker__rows:empty {
    display: none;
  }

  .yv-news-ticker__row {
    font-family: var(--yv-news-ticker-family, inherit);
    font-style: var(--yv-news-ticker-font-style, normal);
    font-weight: 400;
    font-size: var(--yv-news-ticker-size-m, 18px);
    line-height: 1.2;
    color: var(--yv-news-ticker-color, var(--color-foreground));
    white-space: nowrap;
  }

  .yv-news-ticker__row--heading {
    text-transform: var(--font-h2--case, none);
  }

  .yv-news-ticker__text,
  .yv-news-ticker__separator {
    display: block;
    flex: none;
    padding-inline: var(--yv-news-ticker-spacing);
  }

  .yv-news-ticker__separator {
    display: flex;
    align-items: center;
  }

  /* Bold words are outlined: transparent fill, stroke in the outline colour (1px on phones). */
  .yv-news-ticker__text :is(strong, b) {
    font-weight: 700;
    -webkit-text-fill-color: transparent;
    -webkit-text-stroke: 1px var(--yv-news-ticker-outline, currentColor);
    paint-order: stroke fill;
  }

  .yv-news-ticker__text a {
    color: inherit;
  }

  .yv-news-ticker__glyph {
    display: block;
    width: 0.7em;
    height: 0.7em;
    fill: currentColor;
  }

  .yv-news-ticker__glyph--dot {
    width: 0.4em;
    height: 0.4em;
  }

  @media screen and (min-width: 750px) {
    .yv-news-ticker {
      --yv-news-ticker-spacing: var(--yv-news-ticker-spacing-d, 53px);
    }

    .yv-news-ticker--media {
      min-height: var(--yv-news-ticker-min-height-d, 0px);
    }

    .yv-news-ticker__row {
      font-size: var(--yv-news-ticker-size-d, 14px);
    }

    .yv-news-ticker__text :is(strong, b) {
      -webkit-text-stroke-width: var(--yv-news-ticker-stroke, 1px);
    }
  }
{% endstylesheet %}

