{%- comment -%}
  PL: FAQ. Objections in buying order, each a <details>, with FAQPage
  JSON-LD for rich results. Tokens [nights] [years] [dispatch] [transit]
  [threshold] [owner] [email] [phone] [hours] read from settings. Use this
  instead of Yuva's FAQ section wherever the questions should rank.
  On a product page, pass product-specific answers through the blocks and
  the section skips the arthritis question for non-foam products.
{%- endcomment -%}
{%- render 'pln-assets' -%}
{%- liquid
  assign nights = settings.pln_trial_nights | default: 100
  assign years = settings.pln_guarantee_years | default: 5
  assign threshold = settings.pln_free_delivery_threshold | default: 40
  assign d1 = settings.pln_dispatch_min | default: 1
  assign d2 = settings.pln_dispatch_max | default: 2
  assign t1 = settings.pln_transit_min | default: 4
  assign t2 = settings.pln_transit_max | default: 6
  assign dispatch = d1 | append: ' to ' | append: d2
  assign transit = t1 | append: ' to ' | append: t2
  assign owner = settings.pln_owner_name | default: 'Abbas'
  assign email = settings.pln_contact_email | default: 'our contact page'
  assign phone = settings.pln_contact_phone | default: ''
  assign hours = settings.pln_contact_hours | default: ''
  assign is_foam = true
  if template.name == 'product'
    assign is_foam = false
    if product.metafields.custom.core_type.value contains 'foam' or product.title contains 'Memory Foam'
      assign is_foam = true
    endif
  endif
-%}
<section class="pln pln--{{ section.settings.tone }}" id="faq">
  <div class="pln-wrap">
    <div class="pln-head">
      <span class="pln-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- if section.settings.heading_level == 'h1' -%}<h1 class="pln-title">{{ section.settings.heading }}</h1>{%- else -%}<h2 class="pln-title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.lede != blank -%}<p class="pln-lede">{{ section.settings.lede }}</p>{%- endif -%}
    </div>
    <div class="pln-faq">
      {%- for block in section.blocks -%}
        {%- if block.settings.foam_only and is_foam == false -%}{%- continue -%}{%- endif -%}
        {%- assign answer = block.settings.answer | replace: '[nights]', nights | replace: '[years]', years | replace: '[threshold]', threshold | replace: '[dispatch]', dispatch | replace: '[transit]', transit | replace: '[owner]', owner | replace: '[email]', email | replace: '[phone]', phone | replace: '[hours]', hours -%}
        <details {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary><h3 style="font:inherit;margin:0">{{ block.settings.question }}</h3></summary>
          <div class="pln-rte">{{ answer }}</div>
        </details>
      {%- endfor -%}
    </div>
    {%- if section.settings.more_label != blank -%}
      <div class="pln-actions"><a class="pln-btn pln-btn--ghost" href="{{ section.settings.more_link | default: '/pages/faq' }}">{{ section.settings.more_label }}</a></div>
    {%- endif -%}
  </div>
</section>
{%- if section.settings.schema -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- assign first = true -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.foam_only and is_foam == false -%}{%- continue -%}{%- endif -%}
      {%- assign answer = block.settings.answer | replace: '[nights]', nights | replace: '[years]', years | replace: '[threshold]', threshold | replace: '[dispatch]', dispatch | replace: '[transit]', transit | replace: '[owner]', owner | replace: '[email]', email | replace: '[phone]', phone | replace: '[hours]', hours | strip_html | strip_newlines | strip -%}
      {%- unless first -%},{%- endunless -%}{%- assign first = false -%}
      { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ answer | json }} } }
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
{% schema %}
{
  "name": "PL: FAQ",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Before you decide" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The questions owners ask first." },
    { "type": "select", "id": "heading_level", "label": "Heading level", "options": [ { "value": "h2", "label": "H2 (homepage, product)" }, { "value": "h1", "label": "H1 (the FAQ page)" } ], "default": "h2" },
    { "type": "textarea", "id": "lede", "label": "Lede" },
    { "type": "checkbox", "id": "open_first", "label": "Open the first answer", "default": false },
    { "type": "checkbox", "id": "schema", "label": "Emit FAQPage structured data", "default": true, "info": "Only one FAQPage per page. Leave off on product pages if a reviews or FAQ app already emits one." },
    { "type": "text", "id": "more_label", "label": "More link label", "default": "Every question, answered" },
    { "type": "url", "id": "more_link", "label": "More link" },
    { "type": "select", "id": "tone", "label": "Surface", "options": [ { "value": "page", "label": "Page" }, { "value": "oat", "label": "Oat" } ], "default": "page" }
  ],
  "blocks": [
    { "type": "qa", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p></p>" },
      { "type": "checkbox", "id": "foam_only", "label": "Only on foam beds (product pages)", "default": false }
    ] }
  ],
  "presets": [ { "name": "PL: FAQ", "blocks": [
    { "type": "qa", "settings": { "question": "How do I know which size to get?", "answer": "<p>Measure nose to base of tail while they're lying down, then add about 20cm. Between two sizes? Go up. Every bed's page lists the sleeping area, and the <a href=\"/pages/size-guide\">size guide</a> has breed examples. Still unsure? Send us their breed and weight and we'll tell you honestly which size fits.</p>" } },
    { "type": "qa", "settings": { "question": "What's inside, and isn't firmer better?", "answer": "<p>It depends on the bed, so each page says exactly what's inside: memory foam, egg-crate foam, crumb memory foam, fibre or mesh. Firmness is only how a bed feels on day one. What matters is whether it holds its shape in month six, which is why the orthopaedic beds are built on foam rather than loose filling.</p>" } },
    { "type": "qa", "settings": { "question": "What if my dog just won't use it?", "answer": "<p>Then it comes back. Some dogs claim a new bed the first night; some take a fortnight. Put it where they already sleep, with a blanket that smells of home on top. If after that it still isn't right, tell us any time inside the [nights] nights and we collect it free from the UK mainland and refund every penny.</p>" } },
    { "type": "qa", "settings": { "question": "Will it help a dog with arthritis or stiff hips?", "answer": "<p>A supportive bed spreads their weight so pressure isn't concentrated on hips, elbows and shoulders, and a low front means stepping in rather than climbing over. But a bed is for comfort, not a treatment, and it won't replace veterinary care. Please keep talking to your vet. Our <a href=\"/collections/dog-beds-for-older-dogs\">beds for older dogs</a> and the <a href=\"/pages/older-dog-sleep\">senior sleep guide</a> go further.</p>", "foam_only": true } },
    { "type": "qa", "settings": { "question": "When will it arrive, and what does delivery cost?", "answer": "<p>Our own stock is dispatched in [dispatch] working days, then standard delivery takes [transit] working days, free on orders over £[threshold]. Every product page shows the dates for an order placed today. A few beds ship from our partner warehouse and take longer; their pages say so before you order.</p>" } },
    { "type": "qa", "settings": { "question": "Can I actually wash it?", "answer": "<p>On most of the range the cover comes off and washes, following the care label sewn into it. Beds with a coated, waterproof cover are wiped clean instead. Foam is never machine washed. The <a href=\"/pages/care-guide\">care guide</a> covers covers, liners and the smell that creeps in by February.</p>" } },
    { "type": "qa", "settings": { "question": "Where are the beds made?", "answer": "<p>PawLunova is a small business in Yorkshire. The beds are named after the Lake District places where the walking gets done, and every message is answered here by [owner], not a bot.</p>" } },
    { "type": "qa", "settings": { "question": "Who will I be talking to?", "answer": "<p>[owner]. PawLunova is a small UK business and every message is answered by someone who knows the beds: [email], [hours].</p>" } }
  ] } ]
}
{% endschema %}
