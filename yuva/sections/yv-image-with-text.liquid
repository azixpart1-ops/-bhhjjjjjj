{% comment %}
  Section contract: yv-image-with-text
  Yuva "Image with text": one image beside a column of private blocks (highlight heading, Horizon
  text, icon-with-text rows, button) plus an optional stat box that overlaps the inner bottom
  corner of the image. Image left or right on desktop (always first on phones), Adapt/Small/
  Medium/Large heights, optional offset shadow and hover zoom, md container or full width with
  the image flush to the viewport edge, top/middle/bottom content position and "Icon over
  section". Shared settings: section border, colour set, visibility, spacing.

  The stat box is positioned with pure CSS: the grid is an inline-size container, so the image
  height is known in CSS (`--yv-iwt-h`, from the image's own ratio or the fixed height) and the
  box is placed at the image's bottom edge even when the text column is taller than the image.
  @example
  Theme editor > Add section > Storytelling > "Image with text"
{% endcomment %}

{%- liquid
  render 'yv-color-set', set: section.settings.color_set, section_id: section.id

  assign full_width = section.settings.full_width
  assign image = section.settings.image
  assign image_position = section.settings.image_position | default: 'left'
  assign image_height = section.settings.image_height | default: 'adapt'
  assign content_position = section.settings.content_position | default: 'middle'

  assign image_ratio = 1.124
  if image != blank and image.aspect_ratio > 0
    assign image_ratio = image.aspect_ratio
  endif

  case image_height
    when 'small'
      assign height_desktop = '450px'
      assign height_mobile = '300px'
    when 'medium'
      assign height_desktop = '550px'
      assign height_mobile = '360px'
    when 'large'
      assign height_desktop = '650px'
      assign height_mobile = '420px'
    else
      assign height_desktop = 'calc((var(--yv-iwt-col) - var(--yv-iwt-shadow)) / ' | append: image_ratio | append: ')'
      assign height_mobile = height_desktop
  endcase

  assign shadow_direction = 'left'
  if image_position == 'right'
    assign shadow_direction = 'right'
  endif

  assign container = 'md'
  if full_width
    assign container = 'full'
  endif

  assign image_loading = 'lazy'
  assign image_fetchpriority = 'auto'
  if section.index == 1
    assign image_loading = 'eager'
    assign image_fetchpriority = 'high'
  endif

  assign image_sizes = '(min-width: 1200px) 560px, (min-width: 750px) calc(50vw - 40px), calc(100vw - 40px)'
  if full_width
    assign image_sizes = '(min-width: 750px) 50vw, 100vw'
  endif
-%}

{%- capture image_markup -%}
  <div
    class="yv-media yv-iwt__image{% if section.settings.image_zoom %} yv-hover-zoom{% endif %}"
    data-yv-reveal
  >
    {%- if image != blank -%}
      {{
        image
        | image_url: width: 2000
        | image_tag:
          widths: '375, 550, 750, 1100, 1500, 2000',
          sizes: image_sizes,
          loading: image_loading,
          fetchpriority: image_fetchpriority,
          alt: image.alt
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'yv-placeholder' }}
    {%- endif -%}
  </div>
{%- endcapture -%}

<div class="section-background color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings, visibility_only: true %}"></div>
<div
  class="section section--page-width yv-section-spacing yv-iwt color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings %}"
  style="{% render 'yv-section-spacing-style', settings: section.settings %}"
  data-testid="yv-image-with-text"
>
  <div class="yv-container yv-container--{{ container }} yv-draw-icon-host">
    {% render 'yv-draw-icon', icon_settings: section.settings %}
    <div
      class="yv-iwt__grid yv-iwt__grid--image-{{ image_position }} yv-iwt__grid--{{ content_position }}{% if full_width %} yv-iwt__grid--full{% endif %}{% if section.settings.image_shadow %} yv-iwt__grid--shadow{% endif %}"
      style="--yv-iwt-h: {{ height_desktop }}; --yv-iwt-h-mobile: {{ height_mobile }};"
    >
      <div class="yv-iwt__media">
        {% render 'yv-image-shadow',
          content: image_markup,
          enabled: section.settings.image_shadow,
          color: section.settings.color_shadow,
          direction: shadow_direction,
          class: 'yv-iwt__shadow'
        %}
      </div>

      <div class="yv-iwt__content">
        {%- content_for 'blocks' -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .yv-iwt__grid {
    --yv-iwt-gap: 30px;
    --yv-iwt-shadow: 0px;
    --yv-iwt-col: 100cqw;
    --yv-iwt-radius: calc(var(--yv-layout-radius, 10px) * 2);

    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--yv-iwt-gap);
    container-type: inline-size;
  }

  .yv-iwt__grid--shadow {
    --yv-iwt-shadow: 10px;
  }

  .yv-iwt__media,
  .yv-iwt__content {
    min-width: 0;
  }

  .yv-iwt__image {
    --yv-media-radius: var(--yv-iwt-radius);
    --yv-zoom-scale: 1.1;

    height: var(--yv-iwt-h-mobile);
  }

  .yv-iwt__grid--full .yv-iwt__image {
    --yv-media-radius: 0;
  }

  .yv-iwt__shadow {
    --yv-shadow-radius: var(--yv-iwt-radius);
  }

  .yv-iwt__content {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 20px;
    text-align: start;
  }

  .yv-iwt__content:empty {
    display: none;
  }

  .yv-iwt__content > * {
    max-width: 100%;
    margin-block: 0;
  }

  .yv-iwt__content .text-block.rte:not(.custom-typography) {
    font-size: var(--yv-text-lg, 15.36px);
    line-height: 1.4;
  }

  .yv-iwt__content > .yv-icon-with-text,
  .yv-iwt__content > .yv-button-block {
    margin-block-start: 10px;
  }

  .yv-iwt__content > :first-child {
    margin-block-start: 0;
  }

  /* Stat box: lifted out of the column onto the image's bottom corner. */
  .yv-iwt__content > .yv-stat-box:not(.yv-stat-box--notice) {
    position: absolute;
    z-index: 2;
    inset-block-start: calc(var(--yv-iwt-h-mobile) - 16px);
    inset-inline-start: 16px;
    max-width: calc(100% - 32px);
    margin: 0;
    translate: 0 -100%;
  }

  @media screen and (max-width: 749px) {
    .yv-iwt__grid--full .yv-iwt__content {
      padding-inline: var(--yv-page-gutter, 20px);
    }

    .yv-iwt__grid--shadow.yv-iwt__grid--image-left .yv-iwt__content > .yv-stat-box:not(.yv-stat-box--notice) {
      inset-inline-start: calc(16px + var(--yv-iwt-shadow));
    }
  }

  @media screen and (min-width: 750px) {
    .yv-iwt__grid {
      --yv-iwt-gap: 20px;
      --yv-iwt-col: calc((100cqw - var(--yv-iwt-gap)) / 2);

      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: center;
    }

    .yv-iwt__grid--shadow {
      --yv-iwt-shadow: 20px;
    }

    .yv-iwt__image {
      height: var(--yv-iwt-h);
    }

    .yv-iwt__grid--image-right .yv-iwt__media {
      order: 2;
    }

    .yv-iwt__grid--top .yv-iwt__content {
      align-self: start;
    }

    .yv-iwt__grid--bottom .yv-iwt__content {
      align-self: end;
    }

    .yv-iwt__content {
      padding-inline: 20px;
    }

    .yv-iwt__grid--full .yv-iwt__content {
      padding-inline: 40px max(40px, var(--page-margin, 15px));
    }

    .yv-iwt__grid--full.yv-iwt__grid--image-right .yv-iwt__content {
      padding-inline: max(40px, var(--page-margin, 15px)) 40px;
    }

    /* The image box is vertically centred in the row: its bottom edge sits at 50% + h / 2. */
    .yv-iwt__content > .yv-stat-box:not(.yv-stat-box--notice) {
      inset-block-start: calc(50% + (var(--yv-iwt-h) + var(--yv-iwt-shadow)) / 2 - var(--yv-iwt-shadow) - 24px);
      inset-inline-start: auto;
      inset-inline-end: calc(50% + var(--yv-iwt-gap) / 2 + 24px);
      max-width: calc(50% - var(--yv-iwt-gap) / 2 - 48px);
    }

    .yv-iwt__grid--image-right .yv-iwt__content > .yv-stat-box:not(.yv-stat-box--notice) {
      inset-inline-start: calc(50% + var(--yv-iwt-gap) / 2 + 24px);
      inset-inline-end: auto;
    }

    .yv-iwt__grid--top .yv-iwt__content > .yv-stat-box:not(.yv-stat-box--notice),
    .yv-iwt__grid--bottom .yv-iwt__content > .yv-stat-box:not(.yv-stat-box--notice) {
      inset-block-start: auto;
      inset-block-end: calc(50% - (var(--yv-iwt-h) + var(--yv-iwt-shadow)) / 2 + var(--yv-iwt-shadow) + 24px);
      translate: none;
    }
  }

  @media screen and (min-width: 990px) {
    .yv-iwt__content {
      padding-inline: 40px;
    }
  }
{% endstylesheet %}

{% schema %}
{
