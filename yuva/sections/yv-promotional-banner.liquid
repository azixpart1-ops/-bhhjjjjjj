{% comment %}
  Section contract: yv-promotional-banner
  Yuva "Promotional banner": an optional deal bar (heading, short description and a small button in a
  row) above a row of animated statistic counters (private blocks `_yv-counter`, counting up once when
  they scroll into view). Counters share the width equally, divided by hairlines (stacked with
  horizontal hairlines on phones). The optional hand-drawn "Icon over section" draws itself the first
  time the section is in view.
  Colours are the section's own (text, background, button), not a colour set. "Background" paints the
  banner box: the rounded page-width box holding the deal bar and counters, or the whole section when
  full width. With neither a deal bar nor counters the section renders nothing (an editor hint only).
  Shared settings: visibility, spacing, icon over section.
  @example
  Theme editor > Add section > Promotional > "Promotional banner"
{% endcomment %}

{%- liquid
  render 'contrast-override', background_color: section.settings.color_background, text_color: section.settings.color_text, section_id: section.id

  assign has_bar = false
  if section.settings.heading != blank or section.settings.description != blank
    assign has_bar = true
  endif
  if section.settings.button_text != blank and section.settings.button_link != blank
    assign has_bar = true
  endif

  assign counter_count = section.blocks.size | at_least: 1 | at_most: 4

  assign is_empty = false
  if has_bar == false and section.blocks.size == 0
    assign is_empty = true
  endif

  case section.settings.number_size
    when 'small'
      assign number_size = 60
    when 'large'
      assign number_size = 100
    else
      assign number_size = 80
  endcase

  assign container_class = 'yv-container yv-container--page'
  if section.settings.full_width
    assign container_class = 'yv-container yv-container--full yv-promotional-banner__inner--full'
  endif
-%}

{%- if is_empty and request.design_mode == false -%}
  {%- comment -%} Nothing to show: no deal bar and no counters (no empty spacing on the storefront). {%- endcomment -%}
{%- else -%}
{%- comment -%} Full width: the section takes the background colour; boxed: the rounded banner box does. {%- endcomment -%}
<div class="section-background{% if section.settings.full_width %} color-custom-{{ section.id }}{% endif %}{% render 'yv-section-classes', settings: section.settings, visibility_only: true %}"></div>
<div
  class="section section--page-width yv-section-spacing yv-promotional-banner color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings %}"
  style="{% render 'yv-section-spacing-style', settings: section.settings %} --yv-promotional-banner-radius: {% if section.settings.full_width %}0{% else %}{{ section.settings.border_radius }}{% endif %}px; --yv-promotional-banner-number-size: {{ number_size }}px;"
  data-testid="yv-promotional-banner"
>
  <div class="{{ container_class }} yv-draw-icon-host yv-promotional-banner__inner">
    {% render 'yv-draw-icon', icon_settings: section.settings %}

    {%- if has_bar -%}
      <div class="yv-promotional-banner__bar">
        {%- if section.settings.heading != blank -%}
          <p class="yv-promotional-banner__heading h5">{{ section.settings.heading | escape }}</p>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="yv-promotional-banner__text">{{ section.settings.description | escape }}</p>
        {%- endif -%}
        {%- if section.settings.button_text != blank and section.settings.button_link != blank -%}
          <div class="yv-promotional-banner__action">
            {% render 'yv-button',
              label: section.settings.button_text,
              link: section.settings.button_link,
              size_desktop: 'small',
              size_mobile: 'small',
              bg: section.settings.color_button_bg,
              text: section.settings.color_button_text,
              border: section.settings.color_button_border
            %}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if is_empty -%}
      <p class="yv-promotional-banner__empty">{{ 'yv.promotional_banner.editor_empty' | t }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <script
        src="{{ 'yv-counter.js' | asset_url }}"
        type="module"
        fetchpriority="low"
      ></script>
      <div
        class="yv-promotional-banner__counters{% if has_bar %} yv-promotional-banner__counters--spaced{% endif %}"
        style="--yv-promotional-banner-columns: {{ counter_count }};"
      >
        {%- content_for 'blocks' -%}
      </div>
    {%- else -%}
      {%- content_for 'blocks' -%}
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% stylesheet %}
  .yv-promotional-banner {
    --yv-heading-color: var(--color-foreground);

    color: var(--color-foreground);
  }

  /* The banner box: the section's background colour with the radius (0 when full width). */
  .yv-promotional-banner__inner {
    background-color: var(--color-background);
    border-radius: var(--yv-promotional-banner-radius, 10px);
  }

  .yv-promotional-banner__inner--full .yv-promotional-banner__counters {
    padding-inline: var(--page-margin, 20px);
  }

  .yv-promotional-banner__empty {
    margin: 0;
    padding: 40px 20px;
    border: 1px dashed currentColor;
    border-radius: var(--yv-promotional-banner-radius, 10px);
    text-align: center;
    opacity: 0.6;
  }

  .yv-promotional-banner__bar {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 20px;
    padding: 16px 24px;
    text-align: center;
  }

  .yv-promotional-banner__heading,
  .yv-promotional-banner__text {
    margin: 0;
    min-width: 0;
  }

  .yv-promotional-banner__text {
    font-size: var(--yv-text-md, 0.84rem);
  }

  @media screen and (max-width: 749px) {
    .yv-promotional-banner__text,
    .yv-promotional-banner__action {
      flex: 0 0 100%;
    }

    .yv-promotional-banner__action {
      display: flex;
      justify-content: center;
    }
  }

  .yv-promotional-banner__counters {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .yv-promotional-banner__counters--spaced {
    margin-block-start: 30px;
  }

  @media screen and (min-width: 750px) {
    .yv-promotional-banner__counters {
      grid-template-columns: repeat(var(--yv-promotional-banner-columns, 3), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
