{% comment %}
  Section contract: yv-events-calendar
  Yuva Events calendar (docs part 3 "Events calendar"): a centred highlight heading over a grid of
  event cards (private blocks _yv-event: image with a date pill, title, time, linked location,
  description and button). 3 columns at 990px and up, 2 from 750px, 1 on phones.
  With no heading and no events the section outputs nothing on the storefront (it stays visible in
  the theme editor so events can be added).
  Shared settings: section border, highlight heading, colour set, visibility, spacing.
  @example
  Theme editor > Add section > Storytelling > "Events calendar"
{% endcomment %}

{%- liquid
  assign show_section = true
  if section.blocks.size == 0 and section.settings.heading == blank and request.design_mode == false
    assign show_section = false
  endif
-%}

{%- if show_section -%}
{%- render 'yv-color-set', set: section.settings.color_set, section_id: section.id -%}

<div class="section-background color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings, visibility_only: true %}"></div>
<div
  class="section section--page-width yv-section-spacing color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings %}"
  style="{% render 'yv-section-spacing-style', settings: section.settings %}"
>
  <div class="yv-container yv-container--page yv-events">
    {%- render 'yv-heading',
      text: section.settings.heading,
      tag: section.settings.heading_tag,
      size: section.settings.heading_size,
      highlight_font: section.settings.highlight_font,
      highlight_color: section.settings.highlight_color,
      rotating_text: section.settings.rotating_text,
      alignment: 'center',
      class: 'yv-events__heading',
      reveal: true
    -%}

    <div class="yv-events__grid">
      {%- content_for 'blocks' -%}
    </div>
  </div>
</div>
{%- endif -%}

{% stylesheet %}
  .yv-events {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .yv-events__heading .yv-heading__title {
    margin: 0;
  }

  .yv-events__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  .yv-events__grid:empty {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .yv-events {
      gap: 40px;
    }

    .yv-events__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }
  }

  @media screen and (min-width: 990px) {
    .yv-events__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
