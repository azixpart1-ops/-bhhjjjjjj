{%- comment -%}
  PL: Questions owners ask before buying. The bed's own questions and
  answers from custom.qa (a JSON list of {"q": "...", "a": "..."}), signed
  by the owner, placed straight after "Why this bed" (audit PDP-22: until
  genuine reviews exist, real questions answered by a named person are the
  most believable proof on the page). Renders nothing when the bed has no
  Q&A, so it can sit in the template for every product.

  Never dressed as reviews: no stars, no review markup, no FAQPage schema
  (the PL: FAQ section on the same page owns that decision). Tokens:
  [bed] [name].
{%- endcomment -%}
{%- render 'pln-assets' -%}
{{ 'pln-pdp.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign qa = product.metafields.custom.qa.value
  assign short = product.title | split: ' ' | first
  assign owner = settings.pln_owner_name | default: 'Abbas'
  assign count = 0
  for item in qa
    if item.q != blank and item.a != blank
      assign count = count | plus: 1
    endif
  endfor
-%}
{%- if count > 0 -%}
<section class="pln pln--{{ section.settings.tone }}" id="owners-ask">
  <div class="pln-wrap">
    <div class="pln-head">
      <span class="pln-eyebrow">{{ section.settings.eyebrow | replace: '[bed]', short | replace: '[name]', owner }}</span>
      <h2 class="pln-title">{{ section.settings.heading | replace: '[bed]', short | replace: '[name]', owner }}</h2>
      {%- if section.settings.lede != blank -%}<p class="pln-lede">{{ section.settings.lede | replace: '[bed]', short | replace: '[name]', owner }}</p>{%- endif -%}
    </div>
    <dl class="pln-qa">
      {%- for item in qa -%}
        {%- if item.q != blank and item.a != blank -%}
          <div class="pln-qa__item">
            <dt class="pln-qa__q">{{ item.q }}</dt>
            <dd class="pln-qa__a">{{ item.a }}</dd>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </dl>
    <div class="pln-owner" style="margin-top:2rem">
      {%- if settings.pln_owner_photo != blank -%}{{ settings.pln_owner_photo | image_url: width: 120 | image_tag: class: 'pln-owner__photo', alt: owner }}{%- else -%}<span class="pln-owner__photo" aria-hidden="true"></span>{%- endif -%}
      <p>
        <strong>{{ section.settings.signature | replace: '[name]', owner | replace: '[shop]', shop.name }}</strong>
        {%- if section.settings.owner_line != blank -%}<br><span class="pln-muted">{{ section.settings.owner_line | replace: '[name]', owner | replace: '[bed]', short }}</span>{%- endif -%}
      </p>
    </div>
    {%- if section.settings.show_ask -%}
      <div class="pln-actions">
        {%- if settings.pln_whatsapp != blank -%}
          {%- assign wa_text = 'Hi ' | append: owner | append: ', a question about the ' | append: short | append: ': ' | url_encode -%}
          <a class="pln-btn pln-btn--secondary" href="https://wa.me/{{ settings.pln_whatsapp }}?text={{ wa_text }}" target="_blank" rel="noopener">{{ section.settings.ask_label | replace: '[name]', owner }}</a>
        {%- else -%}
          <a class="pln-btn pln-btn--secondary" href="{{ pages['contact'].url | default: '/pages/contact' }}">{{ section.settings.ask_label | replace: '[name]', owner }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "PL: Owners' questions",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "The bed's own questions and answers from its custom.qa metafield, signed by you. Nothing shows on a bed without any." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow ([bed] = first word of the title, [name] = owner)", "default": "Asked about the [bed]" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions owners ask before buying." },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "Real questions from owners, answered by the person who packs the beds. Ask your own and you'll get the same straight answer." },
    { "type": "text", "id": "signature", "label": "Signature ([name], [shop])", "default": "[name], [shop]" },
    { "type": "text", "id": "owner_line", "label": "Line under the signature", "default": "[shop] is a small UK business. I answer every message myself." },
    { "type": "checkbox", "id": "show_ask", "label": "Show an Ask button", "default": true, "info": "WhatsApp with a message started when Theme settings has a number, otherwise the contact page." },
    { "type": "text", "id": "ask_label", "label": "Ask button", "default": "Ask [name] about this bed" },
    { "type": "select", "id": "tone", "label": "Surface", "options": [ { "value": "page", "label": "Page" }, { "value": "oat", "label": "Oat" }, { "value": "calm", "label": "Calm" } ], "default": "page" }
  ],
  "presets": [ { "name": "PL: Owners' questions" } ]
}
{% endschema %}
