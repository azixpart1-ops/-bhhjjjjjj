{%- comment -%}
  PL: First question. Foot-in-the-door: one tap answers "How does your dog
  sleep?" and the Bed Finder opens on question 2 (or the finder page opens
  with ?style=). Three picture cards, each tied to a real bed for the photo.
{%- endcomment -%}
{%- render 'yv-assets' -%}
<yv-sleep-start data-finder-url="{{ section.settings.finder_url | default: '/pages/bed-finder' }}">
<section class="yv yv--{{ section.settings.tone }}">
  <div class="yv-wrap">
    <div class="yv-head">
      {%- if section.settings.eyebrow != blank -%}<span class="yv-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="yv-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.lede != blank -%}<p class="yv-lede">{{ section.settings.lede }}</p>{%- endif -%}
    </div>
    <div class="yv-grid yv-grid--3">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        <button type="button" class="yv-style yv-reveal" data-style="{{ block.settings.value }}" aria-pressed="false" {{ block.shopify_attributes }}>
          <div class="yv-media yv-media--4x3">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {%- elsif p != blank and p.featured_image -%}
              {{ p.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: p.title }}
            {%- else -%}
              {{ 'product-2' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <h3>{{ block.settings.title }}</h3>
          <p class="yv-muted">{{ block.settings.text }}</p>
          <span class="yv-style__cta">{{ section.settings.card_cta }} →</span>
        </button>
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}<p class="yv-small yv-muted" style="margin-top:1.25rem">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>
</yv-sleep-start>
{% schema %}
{
  "name": "PL: First question",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Start here" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How does your dog sleep?" },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "Think of how you find them at 2am, not how they settle at 9pm. Tap the closest, and we'll take it from there." },
    { "type": "text", "id": "card_cta", "label": "Card call to action", "default": "Start with this" },
    { "type": "text", "id": "note", "label": "Note", "default": "Three more questions after this one, about 30 seconds. No email needed." },
    { "type": "url", "id": "finder_url", "label": "Bed Finder page (used when the finder isn't on this page)" },
    { "type": "select", "id": "tone", "label": "Surface", "options": [ { "value": "page", "label": "Page" }, { "value": "oat", "label": "Oat" } ], "default": "oat" }
  ],
  "blocks": [
    { "type": "style", "name": "Sleeping style", "limit": 3, "settings": [
      { "type": "select", "id": "value", "label": "Style", "options": [ { "value": "curl", "label": "Curls up" }, { "value": "lean", "label": "Leans on something" }, { "value": "sprawl", "label": "Sprawls flat out" } ], "default": "curl" },
      { "type": "text", "id": "title", "label": "Title", "default": "Curled in a ball" },
      { "type": "text", "id": "text", "label": "Text", "default": "Nose tucked under the tail, back pressed into something." },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "product", "id": "product", "label": "Or use this bed's photo" }
    ] }
  ],
  "presets": [ { "name": "PL: First question", "blocks": [
    { "type": "style", "settings": { "value": "curl", "title": "Curled in a ball", "text": "Nose tucked under the tail, back pressed into something." } },
    { "type": "style", "settings": { "value": "lean", "title": "Head on something", "text": "Chin on the sofa arm, a cushion, a wall, or you." } },
    { "type": "style", "settings": { "value": "sprawl", "title": "Stretched flat out", "text": "On their side, legs at full stretch, taking the whole bed." } }
  ] } ]
}
{% endschema %}
