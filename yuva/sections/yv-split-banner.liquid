{% comment %}
  Section contract: yv-split-banner
  A row of 2–4 image panels (private blocks `_yv-split-banner-panel`) that share the width equally.
  On desktop (990px+, hover devices) the hovered or focused panel widens to flex 1.5 over 0.8s and, when
  text animation is on, its description slides up under the heading (0.4s). Below 990px the panels
  become a horizontal scroll-snap row (75% wide on phones, 50% on tablets) with the description
  always visible. Heading tag, size and highlight are shared by every panel and set here.
  Shared settings: colour set, visibility, spacing.
  @example
  Theme editor > Add section > Banners > "Split banner"
{% endcomment %}

{%- liquid
  render 'yv-color-set', set: section.settings.color_set, section_id: section.id

  assign width_class = 'section--page-width'
  if section.settings.full_width
    assign width_class = 'section--full-width disable-section-top-offset'
  endif

  assign row_class = 'yv-split-banner__row'
  if section.settings.text_animation
    assign row_class = row_class | append: ' yv-split-banner__row--reveal'
  endif
  if section.settings.hover_expand
    assign row_class = row_class | append: ' yv-split-banner__row--expand'
  endif
-%}

<div class="section-background color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings, visibility_only: true %}"></div>
<div
  class="section {{ width_class }} yv-section-spacing yv-split-banner color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings %}{% unless section.settings.full_width %} yv-split-banner--boxed{% endunless %}"
  style="{% render 'yv-section-spacing-style', settings: section.settings %} --yv-split-height: {{ section.settings.height_desktop }}px; --yv-split-height-mobile: {{ section.settings.height_mobile }}px;"
  data-testid="yv-split-banner"
>
  <div
    class="{{ row_class }}"
    style="--yv-split-count: {{ section.blocks.size | at_least: 1 }};"
  >
    {%- content_for 'blocks' -%}
  </div>
</div>

{% stylesheet %}
  .yv-split-banner__row {
    display: flex;
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .yv-split-banner__row::-webkit-scrollbar {
    display: none;
  }

  .yv-split-banner__row:empty {
    display: none;
  }

  .yv-split-banner--boxed .yv-split-banner__row {
    border-radius: var(--yv-layout-radius, 0);
  }

  /* Phones: 75% wide panels that snap to the centre, so the next one peeks. */
  .yv-split-banner__row > * {
    flex: 0 0 75%;
    min-width: 0;
    scroll-snap-align: center;
    scroll-snap-stop: always;
  }

  .yv-split-banner__row > :only-child {
    flex-basis: 100%;
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .yv-split-banner__row > * {
      flex-basis: 50%;
    }
  }

  /* Desktop: equal panels in one row; the hovered one grows. */
  @media screen and (min-width: 990px) {
    .yv-split-banner__row {
      overflow: hidden;
      scroll-snap-type: none;
    }

    .yv-split-banner__row > * {
      flex: 1 1 0;
    }
  }

  @media screen and (min-width: 990px) and (prefers-reduced-motion: no-preference) {
    .yv-split-banner__row > * {
      transition: flex-grow 0.8s ease;
    }
  }

  @media screen and (min-width: 990px) and (hover: hover) {
    .yv-split-banner__row--expand > :is(:hover, :focus-within) {
      flex-grow: 1.5;
    }
  }
{% endstylesheet %}

