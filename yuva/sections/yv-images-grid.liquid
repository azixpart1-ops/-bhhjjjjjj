{% comment %}
  Section contract: yv-images-grid
  Yuva "Images grid": a highlight heading, description and button beside an overlapping composition
  of up to three square images (private blocks `_yv-images-grid-image`): a back image on one side,
  a larger image overlapping it near the top and a small one hanging at the bottom corner. The
  composition mirrors when the text takes the other side. On phones the images come first in a
  square box, then the text. Shared settings: heading, button, colour set, visibility, spacing.
  @example
  Theme editor > Add section > Media > "Images grid"
{% endcomment %}

{%- liquid
  render 'yv-color-set', set: section.settings.color_set, section_id: section.id

  assign content_position = section.settings.content_position | default: 'right'
  assign image_count = section.blocks.size | at_most: 3
  assign button_variant = 'secondary'
  if section.settings.button_as_link
    assign button_variant = 'link'
  endif
-%}

<div class="section-background color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings, visibility_only: true %}"></div>
<div
  class="section section--page-width yv-section-spacing yv-images-grid yv-images-grid--content-{{ content_position }} color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings %}"
  style="{% render 'yv-section-spacing-style', settings: section.settings %} --yv-images-grid-size: {{ section.settings.height }}px;"
  data-testid="yv-images-grid"
>
  <div class="yv-container yv-container--{{ section.settings.container | default: 'sm' }} yv-images-grid__inner">
    {%- if image_count > 0 -%}
      <div class="yv-images-grid__media">
        <div class="yv-images-grid__box yv-images-grid__box--{{ image_count }}">
          {%- content_for 'blocks' -%}
        </div>
      </div>
    {%- elsif request.design_mode -%}
      {%- comment -%} Theme editor, no images yet: one placeholder square fills the composition. {%- endcomment -%}
      <div class="yv-images-grid__media">
        <div class="yv-images-grid__box">
          <div class="yv-images-grid__placeholder">
            {{- 'lifestyle-1' | placeholder_svg_tag: 'yv-placeholder' -}}
          </div>
        </div>
      </div>
    {%- endif -%}

    <div
      class="yv-images-grid__content"
      data-yv-reveal
    >
      {% render 'yv-heading',
        text: section.settings.heading,
        tag: section.settings.heading_tag,
        size: section.settings.heading_size,
        highlight_font: section.settings.highlight_font,
        highlight_color: section.settings.highlight_color,
        description: section.settings.description,
        alignment: 'left',
        class: 'yv-images-grid__heading'
      %}
      {% render 'yv-button',
        label: section.settings.button_text,
        link: section.settings.button_link,
        variant: button_variant,
        size_desktop: section.settings.button_size_desktop,
        size_mobile: section.settings.button_size_mobile,
        class: 'yv-images-grid__button'
      %}
    </div>
  </div>
</div>

{% stylesheet %}
  .yv-images-grid__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
    min-width: 0;
  }

  .yv-images-grid__media,
  .yv-images-grid__content {
    min-width: 0;
  }

  .yv-images-grid__box {
    position: relative;
    width: 100%;
    margin-inline: auto;
    aspect-ratio: 1;
  }

  .yv-images-grid__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .yv-images-grid__heading {
    --yv-heading-gap: 20px;
  }

  .yv-images-grid__heading .yv-heading__description {
    font-size: var(--yv-text-md, 0.84rem);
    line-height: 1.6;
  }

  .yv-images-grid__button {
    margin-block-start: 30px;
  }

  @media screen and (min-width: 750px) {
    .yv-images-grid__inner {
      flex-direction: row;
      align-items: center;
      gap: 70px;
    }

    .yv-images-grid--content-left .yv-images-grid__inner {
      flex-direction: row-reverse;
    }

    .yv-images-grid__media,
    .yv-images-grid__content {
      flex: 1 1 0;
    }

    .yv-images-grid__content {
      max-width: 520px;
    }

    .yv-images-grid__box {
      width: min(100%, var(--yv-images-grid-size, 500px));
      margin-inline: auto 0;
    }

    .yv-images-grid--content-left .yv-images-grid__box {
      margin-inline: 0 auto;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .yv-images-grid__inner {
      gap: 40px;
    }
  }

  .yv-images-grid__placeholder {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background-color: var(--yv-image-bg);
    border-radius: var(--yv-layout-radius, 10px);
  }

  .yv-images-grid__placeholder > svg {
    display: block;
    width: 100%;
    height: 100%;
  }
{% endstylesheet %}

