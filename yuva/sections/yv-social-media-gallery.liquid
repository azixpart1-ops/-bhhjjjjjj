{% comment %}
  Section contract: yv-social-media-gallery
  Yuva "Social media gallery": an Instagram-style grid of square images or muted looping videos
  (private blocks `_yv-social-item`) under an optional highlight heading and description. Hovering a
  tile (or focusing its link) fades in a coloured overlay with a social icon and the tile's caption;
  tiles link to the post in a new tab. Six columns on large screens, three on tablets, two on phones.
  Videos load near the viewport and play only while visible (assets/yv-autoplay-video.js).
  Shared settings: heading, colour set, visibility, spacing.
  @example
  Theme editor > Add section > Social > "Social media gallery"
{% endcomment %}

{%- liquid
  render 'yv-color-set', set: section.settings.color_set, section_id: section.id

  assign needs_video = false
  for item in section.blocks
    if item.settings.video != blank
      assign needs_video = true
      break
    endif
  endfor
-%}

{%- if needs_video -%}
  <script
    src="{{ 'yv-autoplay-video.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{%- endif -%}

<div class="section-background color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings, visibility_only: true %}"></div>
<div
  class="section section--page-width yv-section-spacing yv-social-gallery color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings %}"
  style="{% render 'yv-section-spacing-style', settings: section.settings %} --yv-social-gallery-overlay: {{ section.settings.color_overlay }}; --yv-social-gallery-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --yv-social-gallery-overlay-text: {{ section.settings.color_overlay_text }};"
  data-testid="yv-social-media-gallery"
>
  <div class="yv-container yv-container--page yv-social-gallery__inner">
    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      {% render 'yv-heading',
        text: section.settings.heading,
        tag: section.settings.heading_tag,
        size: section.settings.heading_size,
        highlight_font: section.settings.highlight_font,
        highlight_color: section.settings.highlight_color,
        description: section.settings.description,
        alignment: 'center',
        class: 'yv-social-gallery__heading',
        reveal: true
      %}
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="yv-social-gallery__grid">
        {%- content_for 'blocks' -%}
      </div>
    {%- elsif request.design_mode -%}
      {%- comment -%} Theme editor, no posts yet: a row of placeholder tiles. {%- endcomment -%}
      <div class="yv-social-gallery__grid">
        {%- for i in (1..6) -%}
          {%- assign placeholder_index = i | modulo: 2 | plus: 1 -%}
          <div class="yv-social-gallery__placeholder">
            {{- 'lifestyle-' | append: placeholder_index | placeholder_svg_tag: 'yv-placeholder' -}}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .yv-social-gallery__inner {
    min-width: 0;
  }

  .yv-social-gallery__heading {
    margin-block-end: 25px;
  }

  .yv-social-gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  @media screen and (min-width: 750px) {
    .yv-social-gallery__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .yv-social-gallery__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  .yv-social-gallery__placeholder {
    aspect-ratio: 1;
    overflow: hidden;
    background-color: var(--yv-image-bg);
    border-radius: var(--yv-layout-radius, 10px);
  }

  .yv-social-gallery__placeholder > svg {
    display: block;
    width: 100%;
    height: 100%;
  }
{% endstylesheet %}

