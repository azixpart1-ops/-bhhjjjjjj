{% comment %}
  Section contract: yv-testimonials
  Yuva "Testimonials": a highlight heading (+ optional description) over a looping carousel of up
  to five private `_yv-testimonial` quotes (snippets/yv-carousel.liquid). Two looks:
  - Classic: centred quote, big stars, small avatar + "Author / City"; arrows on the sides.
  - Modern: raised cards with a 50px avatar and small stars. With arrows, the heading is
    left-aligned and the arrows sit at the right end of the heading row (Yuva rule, no setting).
  One to three cards per view on desktop (at most two on tablets, one on phones). Arrows always
  sit centred under the slides on phones. Dots: a centred pill row under the slides.
  Shared settings: highlight heading, show top/bottom border, colour set (the Gradient set gives
  the soft glow background), visibility, spacing.
  @example
  Theme editor > Add section > Storytelling > "Testimonials"
{% endcomment %}

{%- liquid
  render 'yv-color-set', set: section.settings.color_set, section_id: section.id

  assign style = section.settings.style | default: 'classic'
  assign columns = section.settings.columns_desktop | default: '1' | plus: 0
  assign columns_tablet = columns | at_most: 2
  assign navigation = section.settings.navigation | default: 'arrows'

  assign heading_left = false
  if style == 'modern' and navigation == 'arrows'
    assign heading_left = true
  endif
  assign heading_alignment = 'center'
  if heading_left
    assign heading_alignment = 'left'
  endif

  assign carousel_id = 'YvTestimonials-' | append: section.id
  assign carousel_label = section.settings.heading | strip_html | strip
  assign show_dots = false
  if navigation == 'dots'
    assign carousel_arrows = 'none'
    assign carousel_arrows_mobile = 'none'
    assign show_dots = true
  elsif heading_left
    assign carousel_arrows = 'none'
    assign carousel_arrows_mobile = 'bottom'
  else
    assign carousel_arrows = 'sides'
    assign carousel_arrows_mobile = 'bottom'
  endif
-%}

{%- capture slides -%}
  {%- content_for 'blocks' -%}
{%- endcapture -%}

<div class="section-background color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings, visibility_only: true %}"></div>
<div
  class="section section--page-width yv-section-spacing color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings %}"
  style="{% render 'yv-section-spacing-style', settings: section.settings %}"
  data-testid="yv-testimonials"
>
  <div class="yv-container yv-container--page yv-testimonials yv-testimonials--{{ style }} yv-testimonials--cols-{{ columns }} yv-testimonials--{{ navigation }}{% if heading_left %} yv-testimonials--heading-left{% endif %}">
    {%- if section.settings.heading != blank or section.settings.description != blank or section.settings.rotating_text != blank or heading_left -%}
      <div class="yv-testimonials__header">
        {% render 'yv-heading',
          text: section.settings.heading,
          tag: section.settings.heading_tag,
          size: section.settings.heading_size,
          highlight_font: section.settings.highlight_font,
          highlight_color: section.settings.highlight_color,
          rotating_text: section.settings.rotating_text,
          description: section.settings.description,
          alignment: heading_alignment,
          class: 'yv-testimonials__heading',
          reveal: true
        %}
        {%- if heading_left and section.blocks.size > 0 -%}
          {% render 'yv-carousel-controls',
            carousel_id: carousel_id,
            outside: true,
            class: 'yv-testimonials__arrows'
          %}
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      {% render 'yv-carousel',
        id: carousel_id,
        slides: slides,
        label: carousel_label,
        per_view: columns,
        per_view_tablet: columns_tablet,
        per_view_mobile: 1,
        gap: 0,
        gap_mobile: 0,
        arrows: carousel_arrows,
        arrows_mobile: carousel_arrows_mobile,
        dots: show_dots,
        loop: true,
        class: 'yv-testimonials__carousel',
        attributes: 'data-yv-reveal'
      %}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .yv-testimonials {
    --yv-carousel-arrow-border: transparent;
  }

  .yv-testimonials .yv-carousel__arrow {
    box-shadow: 0 1px 3px #9a9a9a;
  }

  .yv-testimonials--classic {
    --yv-carousel-arrow-bg: var(--yv-alt-bg, #ececec);
  }

  .yv-testimonials--classic .yv-carousel__arrow:not(:disabled):hover {
    background: #fff;
  }

  .yv-testimonials__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    margin-block-end: 30px;
  }

  .yv-testimonials__heading {
    --yv-heading-description-width: 700px;

    min-width: 0;
    max-width: 100%;
  }

  .yv-testimonials--modern .yv-testimonials__header {
    margin-block-end: 20px;
  }

  .yv-testimonials--heading-left .yv-testimonials__header {
    align-items: stretch;
  }

  .yv-testimonials__arrows {
    display: none;
  }

  .yv-testimonials:has(yv-carousel[data-overflow='false']) .yv-testimonials__arrows {
    visibility: hidden;
  }

  /* Dots: 8px circles, the current page a 30 x 8 pill. */
  .yv-testimonials .yv-carousel__dots {
    gap: 10px;
  }

  .yv-testimonials .yv-carousel__dot {
    width: 8px;
    height: 8px;
    border-radius: 5px;
    background: rgb(var(--color-foreground-rgb) / 0.4);
  }

  .yv-testimonials .yv-carousel__dot[aria-current='true'] {
    width: 30px;
    background: var(--color-foreground);
  }

  .yv-testimonials--dots yv-carousel > .yv-carousel__controls {
    margin-block-start: 30px;
  }

  .yv-testimonials--modern yv-carousel > .yv-carousel__controls {
    margin-block-start: 20px;
  }

  /* Classic, two or three per view: a hairline between the quotes. */
  .yv-testimonials--classic:not(.yv-testimonials--cols-1) .yv-carousel__track > .yv-testimonial + .yv-testimonial {
    border-inline-start: 1px solid var(--yv-border-color, rgb(var(--color-foreground-rgb) / 0.1));
  }

  @media screen and (min-width: 750px) {
    .yv-testimonials--heading-left .yv-testimonials__header {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 30px;
    }

    .yv-testimonials--heading-left .yv-testimonials__arrows {
      display: flex;
      flex: none;
    }

    /* Side arrows sit in a 50px gutter outside the slides (the track clips the neighbours). */
    .yv-testimonials--classic.yv-testimonials--arrows yv-carousel {
      padding-inline: 50px;
    }

    .yv-testimonials--classic .yv-carousel__track {
      padding-block: 20px;
    }
  }
{% endstylesheet %}

