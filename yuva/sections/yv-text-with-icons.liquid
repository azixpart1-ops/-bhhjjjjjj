{% comment %}
  Section contract: yv-text-with-icons
  Yuva "Text with icons" (services strip): up to 4 columns (`_yv-text-with-icon`), each an icon
  (line icon or uploaded image) with a short heading and sub text. Icon on top or to the left,
  optionally in a round background; columns optionally in cards (background, border, radius per
  device) that lift on hover. 4 / 2 / 1-or-2 columns on large / tablet / phone.
  Card text switches to white automatically on a dark column background.
  Shared settings: section border, color set, visibility, spacing.
  @example
  Theme editor > Add section > Text > "Text with icons"
{% endcomment %}

{%- liquid
  render 'yv-color-set', set: section.settings.color_set, section_id: section.id

  assign container = 'page'
  if section.settings.small_container
    assign container = 'sm'
  endif

  assign count = section.blocks.size | at_least: 1 | at_most: 4
  assign tablet_count = count | at_most: 2

  assign has_card = false
  if section.settings.column_background or section.settings.column_border
    assign has_card = true
  endif

  assign card_text = ''
  if section.settings.column_background
    assign card_brightness = section.settings.color_column_bg | color_brightness
    if card_brightness < 128
      assign card_text = '#FFFFFF'
    endif
  endif

  case section.settings.icon_size
    when 'small'
      assign icon_d = 20
      assign icon_m = 18
    when 'large'
      assign icon_d = 40
      assign icon_m = 26
    else
      assign icon_d = 26
      assign icon_m = 24
  endcase

  capture grid_class
    echo 'yv-text-with-icons__grid'
    echo ' yv-text-with-icons--icon-' | append: section.settings.icon_position
    echo ' yv-text-with-icons--align-' | append: section.settings.text_alignment
    if has_card
      echo ' yv-text-with-icons--card'
    endif
    if section.settings.column_background
      echo ' yv-text-with-icons--card-bg'
    endif
    if section.settings.column_border
      echo ' yv-text-with-icons--card-border'
    endif
    if section.settings.icon_background
      echo ' yv-text-with-icons--icon-bg'
    endif
  endcapture
-%}

<div class="section-background color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings, visibility_only: true %}"></div>
<div
  class="section section--page-width yv-section-spacing yv-text-with-icons color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings %}"
  style="{% render 'yv-section-spacing-style', settings: section.settings %}"
  data-testid="yv-text-with-icons"
>
  <div class="yv-container yv-container--{{ container }}">
    <div
      class="{{ grid_class }}"
      style="
        --yv-twi-columns: {{ count }};
        --yv-twi-columns-tablet: {{ tablet_count }};
        --yv-twi-columns-mobile: {{ section.settings.columns_mobile }};
        --yv-twi-gap-icon-d: {{ section.settings.icon_gap_desktop }}px;
        --yv-twi-gap-icon-m: {{ section.settings.icon_gap_mobile }}px;
        --yv-twi-radius-d: {{ section.settings.column_radius_desktop }}px;
        --yv-twi-radius-m: {{ section.settings.column_radius_mobile }}px;
        --yv-twi-card-bg: {{ section.settings.color_column_bg }};
        --yv-twi-card-border: {{ section.settings.color_column_border }};
        --yv-twi-card-border-style: {{ section.settings.column_border_style }};
        --yv-twi-icon-color: {{ section.settings.color_icon }};
        --yv-twi-icon-bg: {{ section.settings.color_icon_bg }};
        --yv-twi-icon-d: {{ icon_d }}px;
        --yv-twi-icon-m: {{ icon_m }}px;
        {%- if card_text != blank %} --yv-twi-card-text: {{ card_text }};{% endif %}
      "
    >
      {%- content_for 'blocks' -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .yv-text-with-icons__grid {
    --yv-twi-gap-icon: var(--yv-twi-gap-icon-m, 16px);
    --yv-twi-radius: var(--yv-twi-radius-m, 10px);
    --yv-twi-icon: var(--yv-twi-icon-m, 24px);
    --yv-twi-icon-box: calc(var(--yv-twi-icon) + 20px);

    display: grid;
    grid-template-columns: repeat(var(--yv-twi-columns-mobile, 1), minmax(0, 1fr));
    gap: 12px;
  }

  .yv-text-with-icons__grid:empty {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .yv-text-with-icons__grid {
      --yv-twi-gap-icon: var(--yv-twi-gap-icon-d, 16px);
      --yv-twi-radius: var(--yv-twi-radius-d, 10px);
      --yv-twi-icon: var(--yv-twi-icon-d, 26px);
      --yv-twi-icon-box: calc(var(--yv-twi-icon) + 26px);

      grid-template-columns: repeat(var(--yv-twi-columns-tablet, 2), minmax(0, 1fr));
      gap: 20px;
    }
  }

  @media screen and (min-width: 990px) {
    .yv-text-with-icons__grid {
      grid-template-columns: repeat(var(--yv-twi-columns, 4), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

