{% comment %}
  Section contract: yv-collage
  A mosaic of image or video tiles at merchant-chosen widths (25–100% of a row), each with overlay
  text (heading, subheading, button or text link) placed on a 3×3 grid separately for desktop and
  mobile. Rows stretch to their tallest tile; on mobile the tiles become a horizontal swipe strip
  (80% wide, the next tile peeking in). Tiles are private `_yv-collage-item` blocks.
  Often the home-page hero: the section opts out of Horizon's transparent-header top offset
  (`disable-section-top-offset`) so the tiles run under a transparent header, as on the Yuva demo.
  Shared settings: color set, visibility, spacing.
  @example
  Theme editor > Add section > Banners > "Collage"
{% endcomment %}

{%- liquid
  render 'yv-color-set', set: section.settings.color_set, section_id: section.id

  assign radius_desktop = 0
  assign radius_mobile = 0
  if section.settings.image_layout == 'rounded'
    assign radius_desktop = section.settings.radius_desktop
    assign radius_mobile = section.settings.radius_mobile
  endif

  assign gap_desktop = 0
  assign gap_mobile = 0
  if section.settings.show_spacing
    assign gap_desktop = section.settings.gap_desktop
    assign gap_mobile = section.settings.gap_mobile
  endif

  assign section_width = 'section--page-width'
  if section.settings.full_width
    assign section_width = 'section--full-width'
  endif

  assign has_video = false
  for child in section.blocks
    if child.settings.video != blank
      assign has_video = true
      break
    endif
  endfor

  assign collage_classes = 'yv-collage'
  if section.settings.full_width
    assign collage_classes = collage_classes | append: ' yv-collage--full'
  endif
  if section.settings.image_hover_animation
    assign collage_classes = collage_classes | append: ' yv-collage--zoom'
  endif
  if section.settings.hover_effect
    assign collage_classes = collage_classes | append: ' yv-collage--frame'
  endif
-%}

{%- if has_video -%}
  <script
    src="{{ 'yv-autoplay-video.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{%- endif -%}

<div class="section-background color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings, visibility_only: true %}"></div>
<div
  class="section {{ section_width }} yv-section-spacing disable-section-top-offset color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings %}"
  style="{% render 'yv-section-spacing-style', settings: section.settings %}"
  data-testid="yv-collage"
>
  <div
    class="{{ collage_classes }}"
    style="--yv-collage-gap: {{ gap_desktop }}px; --yv-collage-gap-mobile: {{ gap_mobile }}px; --yv-collage-radius: {{ radius_desktop }}px; --yv-collage-radius-mobile: {{ radius_mobile }}px;"
  >
    {%- content_for 'blocks' -%}
  </div>
</div>

{% stylesheet %}
  .yv-collage {
    --yv-collage-gutter: 0px;

    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: var(--yv-collage-gap);
    min-width: 0;
  }

  .yv-collage:empty {
    display: none;
  }

  /* Full width keeps the image gap as the outer gutter (Yuva "space around"). */
  .yv-collage--full {
    --yv-collage-gutter: var(--yv-collage-gap);

    padding-inline: var(--yv-collage-gutter);
  }

  @media screen and (max-width: 749px) {
    /* Mobile: one horizontal swipe strip; every tile is 80% wide so the next one peeks in. */
    .yv-collage {
      --yv-collage-gutter: var(--yv-collage-gap-mobile);

      flex-wrap: nowrap;
      gap: var(--yv-collage-gap-mobile);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--yv-collage-gutter);
      scrollbar-width: none;
      padding-inline: var(--yv-collage-gutter);
    }

    .yv-collage::-webkit-scrollbar {
      display: none;
    }

    /* A page-width collage bleeds to the screen edges so the strip can be swiped edge to edge. */
    .section--page-width > .yv-collage {
      --yv-collage-gutter: var(--page-margin);

      grid-column: 1 / -1;
    }

    .yv-collage > :only-child {
      flex-basis: 100%;
    }
  }
{% endstylesheet %}

