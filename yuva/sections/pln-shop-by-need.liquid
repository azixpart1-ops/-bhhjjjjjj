{%- comment -%}
  PL: Shop by need. Collections framed by the dog's need, not by product
  type: each tile is a collection with a one-line "why". Internal links to
  every SEO collection from the homepage, with the collection image.
{%- endcomment -%}
{%- render 'pln-assets' -%}
<section class="pln pln--{{ section.settings.tone }}">
  <div class="pln-wrap">
    <div class="pln-head">
      <span class="pln-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="pln-title">{{ section.settings.heading }}</h2>
    </div>
    <div class="pln-needs">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- if c != blank -%}
        <a class="pln-need pln-reveal" href="{{ c.url }}" {{ block.shopify_attributes }}>
          <div class="pln-media pln-media--4x3" style="border-radius:0">
            {%- if c.image -%}{{ c.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: c.image.alt | default: c.title }}{%- elsif c.products.first.featured_image -%}{{ c.products.first.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: c.title }}{%- else -%}{{ 'collection-1' | placeholder_svg_tag }}{%- endif -%}
          </div>
          <div class="pln-need__body">
            <h3>{{ block.settings.label | default: c.title }}</h3>
            {%- if block.settings.note != blank -%}<p>{{ block.settings.note }}</p>{%- endif -%}
            <span class="pln-need__count">{{ c.all_products_count }} bed{% if c.all_products_count != 1 %}s{% endif %} →</span>
          </div>
        </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "PL: Shop by need",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by what they need" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Start with the dog, not the catalogue." },
    { "type": "select", "id": "tone", "label": "Surface", "options": [ { "value": "oat", "label": "Oat" }, { "value": "page", "label": "Page" } ], "default": "oat" }
  ],
  "blocks": [
    { "type": "need", "name": "Need", "limit": 8, "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "label", "label": "Label (blank = collection title)" },
      { "type": "text", "id": "note", "label": "One line on who it's for" }
    ] }
  ],
  "presets": [ { "name": "PL: Shop by need", "blocks": [
    { "type": "need", "settings": { "label": "Orthopaedic dog beds", "note": "Foam that holds its shape, for joints that don't" } },
    { "type": "need", "settings": { "label": "Beds for older dogs", "note": "Firmer support, easier to rise from" } },
    { "type": "need", "settings": { "label": "Low step-in beds", "note": "Easy in, easy out for stiff legs" } },
    { "type": "need", "settings": { "label": "Large dog beds", "note": "Sized for dogs that flatten ordinary beds" } },
    { "type": "need", "settings": { "label": "Nest and bolster beds", "note": "Walls to lean into for dogs that burrow" } },
    { "type": "need", "settings": { "label": "Dog sofa beds", "note": "A back and arms to lean on, a seat of their own" } },
    { "type": "need", "settings": { "label": "Waterproof dog beds", "note": "Wipe clean after wet walks and muddy paws" } },
    { "type": "need", "settings": { "label": "Raised and cooling beds", "note": "Mesh that lets air move underneath" } }
  ] } ]
}
{% endschema %}
