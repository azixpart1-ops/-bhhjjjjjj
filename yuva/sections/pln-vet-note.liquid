{%- comment -%}
  PL: Vet note. The "vet structure": a short, honest clinical framing of
  what a bed can and can't do, with a checklist the owner can take to their
  own vet. Attribution (name, RCVS number, photo) appears ONLY when Theme
  settings → Vet-informed content is on, which needs the vet's consent.
  Without it, the block still renders as "what to ask your vet" with no
  named endorsement. Never claims treatment or cure.
{%- endcomment -%}
{%- render 'pln-assets' -%}
{%- assign vet_on = false -%}
{%- if settings.pln_vet_enable and settings.pln_vet_name != blank -%}{%- assign vet_on = true -%}{%- endif -%}
<section class="pln pln--{{ section.settings.tone }}">
  <div class="pln-wrap" style="max-width:900px">
    <div class="pln-vet pln-reveal">
      <div class="pln-vet__avatar">
        {%- if vet_on and settings.pln_vet_photo != blank -%}{{ settings.pln_vet_photo | image_url: width: 160 | image_tag: alt: settings.pln_vet_name }}{%- else -%}{% render 'pln-icon', name: 'stethoscope' %}{%- endif -%}
      </div>
      <div>
        <span class="pln-eyebrow">{% if vet_on %}{{ section.settings.eyebrow_vet }}{% else %}{{ section.settings.eyebrow }}{% endif %}</span>
        <h2 class="pln-sub">{{ section.settings.heading }}</h2>
        <div class="pln-rte" style="margin-top:1rem">{{ section.settings.body }}</div>
        {%- if section.blocks.size > 0 -%}
          <p style="margin-top:1rem"><strong>{{ section.settings.checklist_heading }}</strong></p>
          <ul>
            {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>{%- endfor -%}
          </ul>
        {%- endif -%}
        <p class="pln-vet__who">
          {%- if vet_on -%}
            Reviewed by {{ settings.pln_vet_name }}{% if settings.pln_vet_rcvs != blank %}, RCVS {{ settings.pln_vet_rcvs }}{% endif %}{% if settings.pln_vet_practice != blank %}, {{ settings.pln_vet_practice }}{% endif %}. {{ section.settings.disclaimer }}
          {%- else -%}
            {{ section.settings.disclaimer }}
          {%- endif -%}
        </p>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "PL: Vet note",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (no vet attribution)", "default": "Before you ask us, ask your vet" },
    { "type": "text", "id": "eyebrow_vet", "label": "Eyebrow (vet attribution on)", "default": "Vet-reviewed" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What a bed can change, and what it can't." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>A bed is for comfort; it isn't a treatment. If your dog is in pain, recovering, or finding it hard to move, that's a conversation with your vet first. What the right shape and filling can change is effort: how much goes into lying down, and how much into getting back up. Foam that spreads their weight keeps hips and elbows off the floor. A low front means stepping in, not climbing over. A non-slip base stops the bed sliding on a smooth floor.</p>" },
    { "type": "text", "id": "checklist_heading", "label": "Checklist heading", "default": "Three things worth asking at the next check-up" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "General information, not veterinary advice for your dog." },
    { "type": "select", "id": "tone", "label": "Surface", "options": [ { "value": "page", "label": "Page" }, { "value": "oat", "label": "Oat" } ], "default": "page" }
  ],
  "blocks": [
    { "type": "ask", "name": "Question for the vet", "limit": 5, "settings": [ { "type": "text", "id": "text", "label": "Text" } ] }
  ],
  "presets": [ { "name": "PL: Vet note", "blocks": [
    { "type": "ask", "settings": { "text": "Is the slower first step stiffness, or something that needs looking at?" } },
    { "type": "ask", "settings": { "text": "Would a lower step-in or a firmer surface help them get up?" } },
    { "type": "ask", "settings": { "text": "Is their weight where it should be? Extra kilos make every rise harder." } }
  ] } ]
}
{% endschema %}
