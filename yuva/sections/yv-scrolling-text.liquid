{% comment %}
  Section contract: yv-scrolling-text
  Yuva "Scrolling text" (marquee): one full-bleed row of text items (`_yv-marquee-text`: solid,
  outlined, pill or gradient text) and image or doodle-icon items (`_yv-marquee-image`, also
  used for logo tickers) that loops seamlessly (snippets/yv-marquee.liquid). Direction, speed,
  pause on hover, item spacing, an optional strip colour and a slight rotation are set on the
  section; hairline borders top and bottom come from the shared section border.
  Shared settings: section border (+ colour), color set, visibility, spacing.
  @example
  Theme editor > Add section > Text > "Scrolling text"
{% endcomment %}

{%- liquid
  render 'yv-color-set', set: section.settings.color_set, section_id: section.id

  assign rotation = section.settings.rotation | default: 0
  assign is_rotated = false
  if rotation != 0
    assign is_rotated = true
  endif
-%}

{%- capture items -%}
  {%- content_for 'blocks' -%}
{%- endcapture -%}

{%- if section.blocks.size > 0 -%}
<div class="section-background color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings, visibility_only: true %}"></div>
<div
  class="section section--full-width yv-section-spacing yv-scrolling-text color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings %}{% if is_rotated %} yv-scrolling-text--rotated{% endif %}"
  style="
    {%- render 'yv-section-spacing-style', settings: section.settings -%}
    {%- if section.settings.color_border != blank %} --yv-border-color: {{ section.settings.color_border }};{% endif %}
    --yv-scrolling-text-gap-d: {{ section.settings.item_spacing_desktop }}px;
    --yv-scrolling-text-gap-m: {{ section.settings.item_spacing_mobile }}px;
    --yv-scrolling-text-py: {{ section.settings.vertical_spacing }}px;
    --yv-scrolling-text-rotation: {{ rotation }}deg;
    {%- if section.settings.color_strip != blank %} --yv-scrolling-text-strip: {{ section.settings.color_strip }};{% endif %}
  "
  data-testid="yv-scrolling-text"
>
  <div class="yv-scrolling-text__strip{% if section.settings.color_strip != blank %} yv-scrolling-text__strip--filled{% endif %}">
    {% render 'yv-marquee',
      content: items,
      direction: section.settings.direction,
      speed: section.settings.speed,
      pause_on_hover: section.settings.pause_on_hover,
      class: 'yv-scrolling-text__marquee'
    %}
  </div>
</div>
{%- endif -%}

{% stylesheet %}
  .yv-scrolling-text {
    --yv-scrolling-text-gap: var(--yv-scrolling-text-gap-m, 20px);

    overflow-x: clip;
  }

  .yv-scrolling-text__strip {
    min-width: 0;
  }

  .yv-scrolling-text__strip--filled {
    background-color: var(--yv-scrolling-text-strip);
  }

  .yv-scrolling-text--rotated .yv-scrolling-text__strip {
    width: 110%;
    max-width: none;
    margin-inline: -5%;
    transform: rotate(var(--yv-scrolling-text-rotation, 0deg));
  }

  .yv-scrolling-text__marquee .yv-marquee__group > * {
    flex: none;
    padding: var(--yv-scrolling-text-py, 15px) calc(var(--yv-scrolling-text-gap) / 2);
  }

  @media screen and (min-width: 750px) {
    .yv-scrolling-text {
      --yv-scrolling-text-gap: var(--yv-scrolling-text-gap-d, 40px);
    }
  }
{% endstylesheet %}

