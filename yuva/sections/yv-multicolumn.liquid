{% comment %}
  Section contract: yv-multicolumn
  Yuva "Multicolumn": a highlight heading and description above columns (`_yv-column`), each with
  an image or an autoplay video, a heading, a description and a button (or text link). Up to 4
  columns per row on desktop (more wrap, the last row centred with centred columns), 2 on
  tablets, 1 on phones. One media ratio and one button size for every column.
  Shared settings: highlight heading, color set, visibility, spacing.
  @example
  Theme editor > Add section > Text > "Multicolumn"
{% endcomment %}

{%- liquid
  render 'yv-color-set', set: section.settings.color_set, section_id: section.id

  assign count = section.blocks.size | at_least: 1
  assign columns = count | at_most: 4
  assign columns_tablet = count | at_most: 2

  assign heading_align = section.settings.heading_alignment | default: 'center'
  assign column_align = section.settings.column_alignment | default: 'center'

  case column_align
    when 'center'
      assign justify = 'center'
    when 'right'
      assign justify = 'flex-end'
    else
      assign justify = 'flex-start'
  endcase
-%}

<div class="section-background color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings, visibility_only: true %}"></div>
<div
  class="section section--page-width yv-section-spacing yv-multicolumn color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings %}"
  style="{% render 'yv-section-spacing-style', settings: section.settings %}"
  data-testid="yv-multicolumn"
>
  <div class="yv-container yv-container--page yv-multicolumn__inner">
    {% render 'yv-heading',
      text: section.settings.heading,
      tag: section.settings.heading_tag,
      size: section.settings.heading_size,
      highlight_font: section.settings.highlight_font,
      highlight_color: section.settings.highlight_color,
      rotating_text: section.settings.rotating_text,
      description: section.settings.description,
      alignment: heading_align,
      class: 'yv-multicolumn__header',
      reveal: settings.yv_enable_animation
    %}

    <div
      class="yv-multicolumn__grid yv-multicolumn__grid--{{ column_align }}"
      style="--yv-multicolumn-columns: {{ columns }}; --yv-multicolumn-columns-tablet: {{ columns_tablet }}; --yv-multicolumn-justify: {{ justify }};"
    >
      {%- content_for 'blocks' -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .yv-multicolumn__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .yv-multicolumn__header .yv-heading__description {
    max-width: 680px;
    font-size: var(--yv-text-lg, 0.96rem);
  }

  .yv-multicolumn__grid {
    --yv-multicolumn-gap: 20px;
    --yv-multicolumn-per-row: 1;

    display: flex;
    flex-wrap: wrap;
    justify-content: var(--yv-multicolumn-justify, center);
    gap: 40px var(--yv-multicolumn-gap);
  }

  .yv-multicolumn__grid:empty {
    display: none;
  }

  .yv-multicolumn__grid > * {
    flex: 0 0
      calc(
        (100% - (var(--yv-multicolumn-per-row) - 1) * var(--yv-multicolumn-gap)) / var(--yv-multicolumn-per-row)
      );
    min-width: 0;
  }

  @media screen and (min-width: 750px) {
    .yv-multicolumn__grid {
      --yv-multicolumn-gap: 30px;
      --yv-multicolumn-per-row: var(--yv-multicolumn-columns-tablet, 2);
    }
  }

  @media screen and (min-width: 990px) {
    .yv-multicolumn__grid {
      --yv-multicolumn-per-row: var(--yv-multicolumn-columns, 4);
    }
  }
{% endstylesheet %}

