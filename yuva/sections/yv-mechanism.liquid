{%- comment -%}
  PL: What's inside. Specificity and mechanism: a layered cross-section
  makes the invisible visible, so the price stops being compared to a £25
  supermarket bed. Moss surface = authority.
{%- endcomment -%}
{%- render 'yv-assets' -%}
<section class="yv yv--{{ section.settings.tone }}">
  <div class="yv-wrap yv-split">
    <div class="yv-split__body">
      <span class="yv-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="yv-title">{{ section.settings.heading }}</h2>
      <div class="yv-lede yv-rte" style="margin-top:2rem">{{ section.settings.body }}</div>
      <ol class="yv-layers" style="margin-top:2rem">
        {%- for block in section.blocks -%}
          <li class="yv-layer" {{ block.shopify_attributes }}>
            <div>
              <strong>{{ block.settings.title }}{% if block.settings.note != blank %}<em>{{ block.settings.note }}</em>{% endif %}</strong>
              <p>{{ block.settings.text }}</p>
            </div>
          </li>
        {%- endfor -%}
      </ol>
      {%- if section.settings.caption != blank -%}<p class="yv-small yv-muted" style="margin-top:1rem">{{ section.settings.caption }}</p>{%- endif -%}
    </div>
    <div class="yv-split__media">
      {%- if section.settings.image != blank -%}
        <div class="yv-media" style="aspect-ratio:4/5;border-radius:var(--yv-radius-lg)">{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.image_alt | default: 'Cross-section of an orthopaedic dog bed' }}</div>
      {%- else -%}
        <div class="yv-stack" aria-hidden="true" style="padding:2rem;border-radius:var(--yv-radius-lg);background:rgba(241,233,219,.06)"><i></i><i></i><i></i><i></i><i></i></div>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "PL: What's inside",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What's inside the orthopaedic beds" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Foam, not filling." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>A lot of dog beds are filled with loose fibre or shredded offcuts. They feel plump in the shop and are flat by March, at which point your dog is sleeping on the floor with a cover over it.</p><p>Our orthopaedic beds are built on foam instead. On many, memory foam on top contours to hip and shoulder while a profiled egg-crate layer underneath spreads their weight, so it doesn't compress to the floor.</p>" },
    { "type": "image_picker", "id": "image", "label": "Cross-section image (optional)" },
    { "type": "text", "id": "image_alt", "label": "Image alt", "default": "Cross-section of an orthopaedic dog bed, layer by layer" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "A typical orthopaedic bed, top to bottom. Layers vary from bed to bed: each product page lists its own." },
    { "type": "select", "id": "tone", "label": "Surface", "options": [ { "value": "moss", "label": "Moss (dark)" }, { "value": "page", "label": "Page" } ], "default": "moss" }
  ],
  "blocks": [
    { "type": "layer", "name": "Layer", "limit": 6, "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Memory foam" },
      { "type": "text", "id": "note", "label": "Note" },
      { "type": "text", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [ { "name": "PL: What's inside", "blocks": [
    { "type": "layer", "settings": { "title": "Cover that comes off", "text": "Comes off to wash, following the care label sewn into each one." } },
    { "type": "layer", "settings": { "title": "Waterproof inner liner", "note": "on selected beds", "text": "Sits between cover and foam, so a wet coat or an accident stops before the core." } },
    { "type": "layer", "settings": { "title": "Memory foam", "text": "Contours to hip and shoulder, then comes back to shape by morning." } },
    { "type": "layer", "settings": { "title": "Egg-crate support foam", "text": "Profiled foam underneath that spreads their weight rather than compressing flat." } },
    { "type": "layer", "settings": { "title": "Non-slip base", "note": "on many beds", "text": "Grips wood and tile, so the bed stays where you put it." } }
  ] } ]
}
{% endschema %}
