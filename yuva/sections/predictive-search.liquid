{% render 'pills-styles' %}
{% render 'predictive-search-styles' %}

{%- if predictive_search.performed or search.performed -%}
  <div
    id="predictive-search-results"
    class="predictive-search-dropdown"
    role="listbox"
    aria-label="{{ 'content.search_results_label' | t }}"
    data-transition-container
    style="--color-shadow: rgb(var(--color-foreground-rgb) / var(--opacity-10-25));"
  >
    <div
      class="predictive-search-results__inner"
      data-search-results
    >
      {% if predictive_search.performed %}
        {% assign search_results_count = predictive_search.resources.products.size
          | plus: predictive_search.resources.pages.size
          | plus: predictive_search.resources.articles.size
          | plus: predictive_search.resources.collections.size
        %}
      {% else %}
        {% assign search_results_count = search.results_count %}
      {% endif %}

      <div
        class="visually-hidden"
        role="status"
      >
        {%- if predictive_search.performed and search_results_count > 0 -%}
          {{ 'accessibility.search_results_count' | t: count: search_results_count, query: predictive_search.terms }}
        {%- elsif predictive_search.performed and predictive_search.resources.queries.size > 0 -%}
          {{- 'accessibility.search_suggestions_available' | t: query: predictive_search.terms -}}
        {%- elsif predictive_search.performed -%}
          {{ 'accessibility.search_results_no_results' | t: query: predictive_search.terms }}
        {%- endif -%}
      </div>

      {% if predictive_search.performed %}
        {%- comment -%} yv: Theme settings > Search > "Enable suggestions" shows the related queries. {%- endcomment -%}
        {% if predictive_search.resources.queries.size > 0 and settings.yv_search_suggestions != false %}
          <h4 class="predictive-search-results__title yv-search-queries-title">
            {{- 'yv.header.related_queries' | t -}}
          </h4>
          <ul
            class="predictive-search-results__list predictive-search-results__wrapper predictive-search-results__wrapper-queries list-unstyled"
          >
            {%- for resource in predictive_search.resources.queries -%}
              <li
                class="predictive-search-results__card--query"
                ref="resultsItems[]"
                on:keydown="/onSearchKeyDown"
              >
                <a
                  class="pills__pill predictive-search-results__pill"
                  href="{{ resource.url }}"
                  aria-label="{{ resource.text }}"
                >
                  <span>
                    {{ resource.styled_text }}
                  </span>
                </a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}

        {%- if search_results_count > 0 -%}
          {% if predictive_search.resources.products.size > 0 %}
            {%- liquid
              assign title = 'content.search_results_resource_products' | t
              assign products = predictive_search.resources.products
              render 'predictive-search-products-list', title: title, products: products, limit: 6
            -%}
          {% endif %}

          {%- comment -%}
            yv: collections, pages and articles as Yuva link lists under the same tab-style titles
            as "Products" (Theme settings > Search toggles each type).
          {%- endcomment -%}
          {%- assign yv_link_types = 'collection,page,article' | split: ',' -%}
          {%- for yv_type in yv_link_types -%}
            {%- liquid
              case yv_type
                when 'collection'
                  assign yv_resources = predictive_search.resources.collections
                  assign yv_enabled = settings.yv_search_collections
                  assign yv_title = 'content.search_results_resource_collections' | t
                when 'page'
                  assign yv_resources = predictive_search.resources.pages
                  assign yv_enabled = settings.yv_search_pages
                  assign yv_title = 'content.search_results_resource_pages' | t
                else
                  assign yv_resources = predictive_search.resources.articles
                  assign yv_enabled = settings.yv_search_articles
                  assign yv_title = 'content.search_results_resource_articles' | t
              endcase
            -%}
            {%- if yv_resources.size > 0 and yv_enabled != false -%}
              <div class="yv-search-links">
                <h4
                  id="predictive-search-{{ yv_type }}"
                  class="predictive-search-results__title"
                >
                  <span class="yv-search-links__tab">{{ yv_title }}</span>
                </h4>
                <ul
                  class="predictive-search-results__list yv-search-links__list list-unstyled"
                  aria-labelledby="predictive-search-{{ yv_type }}"
                >
                  {%- for resource in yv_resources -%}
                    <li
                      class="yv-search-links__item"
                      ref="resultsItems[]"
                    >
                      <a
                        href="{{ resource.url }}"
                        class="yv-search-links__link"
                      >
                        {{- resource.title | escape -}}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- elsif predictive_search.resources.queries.size == 0 -%}
          <p class="predictive-search-results__no-results">
            {{ 'content.search_results_no_results' | t: terms: predictive_search.terms }}
          </p>
        {% endif %}
      {% else %}
        {%- liquid
          assign title = 'content.recently_viewed_products' | t
          assign products = search.results

          comment
            Searching for recently viewed products by id doesn't preserve the order of the products.
            To work around this, we get the product ids into an array then use that to reorder them.
          endcomment
          if search.terms contains 'id:'
            assign new_products_ids = search.terms | replace: 'id:', '' | split: ' OR '
          endif
          render 'predictive-search-products-list', title: title, products: products, order_ids: new_products_ids, limit: 4
        -%}
      {% endif %}

      {% if predictive_search.performed %}
        {%- if search_results_count > 0 -%}
          {% assign total_results = predictive_search.resources.products.size
            | plus: predictive_search.resources.collections.size
            | plus: predictive_search.resources.pages.size
            | plus: predictive_search.resources.articles.size
          %}
          {% assign single_result_url = null %}
          {% if total_results == 1 %}
            {% if predictive_search.resources.products.size == 1 %}
              {% assign single_result_url = predictive_search.resources.products.first.url %}
            {% elsif predictive_search.resources.collections.size == 1 %}
              {% assign single_result_url = predictive_search.resources.collections.first.url %}
            {% elsif predictive_search.resources.pages.size == 1 %}
              {% assign single_result_url = predictive_search.resources.pages.first.url %}
            {% elsif predictive_search.resources.articles.size == 1 %}
              {% assign single_result_url = predictive_search.resources.articles.first.url %}
            {% endif %}
          {% endif %}

          {% if single_result_url %}
            <div data-single-result-url="{{ single_result_url }}"></div>
          {% endif %}
        {% endif %}
      {% endif %}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  /* yv: collections, pages and articles in the Yuva search modal (snippets/search-modal.liquid):
     plain link lists under the same tab-style title as "Products". */
  .search-modal--yv .yv-search-links > .predictive-search-results__title {
    display: flex;
    margin-block: 40px 20px;
    padding-block-end: 0;
    border-block-end: 1px solid rgb(0 0 0 / 0.1);
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 15.36px;
    letter-spacing: normal;
  }

  .search-modal--yv .yv-search-links > .predictive-search-results__title::after {
    content: none;
  }

  .yv-search-links__tab {
    display: inline-block;
    padding-block: 16px;
    margin-block-end: -1px;
    border-block-end: 3px solid var(--color-foreground);
  }

  .yv-search-links__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 4px 30px;
    margin: 0;
    padding: 0;
  }

  @media screen and (max-width: 749px) {
    .yv-search-links__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .yv-search-links__item {
    min-width: 0;
    border-radius: 4px;
  }

  .yv-search-links__link {
    display: block;
    padding-block: 6px;
    overflow: hidden;
    color: var(--color-foreground);
    font-size: 13.44px;
    line-height: 1.5;
    text-decoration: none;
    white-space: nowrap;
    text-overflow: ellipsis;
    transition: color 0.2s ease;
  }

  .yv-search-links__link:hover,
  .yv-search-links__item[aria-selected='true'] .yv-search-links__link {
    color: #7e7e7e;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .yv-search-links__item.keyboard-focus {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.predictive_search",
  "settings": [],
  "blocks": [
    {
      "type": "@theme"
    }
  ]
}
{% endschema %}
