{%- comment -%}
  PL: Collection guide. The long-form SEO body under the grid: the rest of
  the collection description (everything after the first paragraph the
  intro used), in two columns, with an H2 that carries the keyword, then
  the collection's own FAQ from metafields if present
  (collection.metafields.custom.faq, a JSON list of {question, answer}),
  else the merchant's blocks. Internal links to the guides.
{%- endcomment -%}
{%- render 'pln-assets' -%}
{%- liquid
  assign parts = collection.description | split: '</p>'
  assign rest = ''
  for part in parts
    unless forloop.first
      assign rest = rest | append: part | append: '</p>'
    endunless
  endfor
  assign rest = rest | strip
  if rest == '</p>'
    assign rest = ''
  endif
  assign heading = section.settings.heading | replace: '[title]', collection.title
-%}
{%- if rest != '' or section.blocks.size > 0 -%}
<section class="pln pln--{{ section.settings.tone }}">
  <div class="pln-wrap">
    {%- if rest != '' -%}
    <div class="pln-head"><h2 class="pln-title">{{ heading }}</h2></div>
    <div class="pln-rte pln-seo pln-seo--2">{{ rest }}</div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
    <div class="pln-faq" style="margin-top:2.5rem">
      <h2 class="pln-sub" style="margin-bottom:1rem">{{ section.settings.faq_heading | replace: '[title]', collection.title | downcase | capitalize }}</h2>
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}><summary><h3 style="font:inherit;margin:0">{{ block.settings.question }}</h3></summary><div class="pln-rte">{{ block.settings.answer }}</div></details>
      {%- endfor -%}
    </div>
    {%- if section.settings.schema -%}
    <script type="application/ld+json">
    { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
      {%- for block in section.blocks -%}
      { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | strip | json }} } }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ] }
    </script>
    {%- endif -%}
    {%- endif -%}
    <p class="pln-small pln-muted" style="margin-top:2rem">{{ section.settings.links }}</p>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "PL: Collection guide",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading ([title] = collection title)", "default": "Choosing [title]: what to look for" },
    { "type": "text", "id": "faq_heading", "label": "FAQ heading", "default": "[title]: questions owners ask" },
    { "type": "checkbox", "id": "schema", "label": "Emit FAQPage structured data", "default": true },
    { "type": "richtext", "id": "links", "label": "Guide links", "default": "<p>Guides: <a href=\"/pages/size-guide\">dog bed size guide</a> · <a href=\"/pages/foam-explained\">memory foam vs egg crate</a> · <a href=\"/pages/older-dog-sleep\">beds for older dogs</a> · <a href=\"/pages/care-guide\">how to wash a dog bed</a> · <a href=\"/pages/100-night-trial\">the 100-night trial</a></p>" },
    { "type": "select", "id": "tone", "label": "Surface", "options": [ { "value": "page", "label": "Page" }, { "value": "oat", "label": "Oat" } ], "default": "oat" }
  ],
  "blocks": [
    { "type": "qa", "name": "Question", "limit": 6, "settings": [
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p></p>" }
    ] }
  ],
  "presets": [ { "name": "PL: Collection guide" } ]
}
{% endschema %}
