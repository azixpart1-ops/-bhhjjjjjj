{%- comment -%}
  PL: Good, better, best. Three real beds for the same job; the middle one
  carries the one terracotta border and the only primary button in the row
  (anchoring + the compromise effect, used honestly: it IS the bed most
  owners of a stiffening dog end up with).
{%- endcomment -%}
{%- render 'pln-assets' -%}
<section class="pln pln--{{ section.settings.tone }}">
  <div class="pln-wrap">
    <div class="pln-head">
      {%- if section.settings.eyebrow != blank -%}<span class="pln-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="pln-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.lede != blank -%}<p class="pln-lede">{{ section.settings.lede }}</p>{%- endif -%}
    </div>
    <div class="pln-ladder">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        <article class="pln-card pln-rung pln-reveal{% if block.settings.pick %} pln-card--pick{% endif %}" style="display:flex;flex-direction:column" {{ block.shopify_attributes }}>
          {%- if block.settings.pick -%}<span class="pln-card__tag">{{ section.settings.pick_label }}</span>{%- endif -%}
          <span class="pln-rung__label">{{ block.settings.label }}</span>
          {%- if p != blank -%}
            {% render 'pln-product-card', product: p, show_per_night: true %}
          {%- else -%}
            <div class="pln-media pln-media--4x3">{{ 'product-3' | placeholder_svg_tag }}</div>
          {%- endif -%}
          <p class="pln-rung__why">{{ block.settings.why }}</p>
          {%- if p != blank -%}
            <a class="pln-btn {% if block.settings.pick %}pln-btn--primary{% else %}pln-btn--secondary{% endif %}" href="{{ p.url }}">{{ section.settings.cta_label }}</a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}<p class="pln-small pln-muted" style="margin-top:1.5rem;max-width:60ch">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "PL: Good, better, best",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "For a dog who's slowing down" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three good answers. One is usually the right one." },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "Same job, three ways to do it. The middle bed is the one we'd point most owners of a stiffening dog to; the others are there if budget or size says otherwise." },
    { "type": "text", "id": "pick_label", "label": "Pick label", "default": "The sensible pick" },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "See the bed" },
    { "type": "textarea", "id": "note", "label": "Note", "default": "Not sure between two? Go by their size first, then their joints. The Bed Finder does exactly that in four questions." },
    { "type": "select", "id": "tone", "label": "Surface", "options": [ { "value": "page", "label": "Page" }, { "value": "oat", "label": "Oat" } ], "default": "page" }
  ],
  "blocks": [
    { "type": "rung", "name": "Rung", "limit": 3, "settings": [
      { "type": "product", "id": "product", "label": "Bed" },
      { "type": "text", "id": "label", "label": "Label", "default": "Good" },
      { "type": "textarea", "id": "why", "label": "Who it suits" },
      { "type": "checkbox", "id": "pick", "label": "The sensible pick", "default": false }
    ] }
  ],
  "presets": [ { "name": "PL: Good, better, best", "blocks": [
    { "type": "rung", "settings": { "label": "Good", "why": "A raised foam rim to rest a chin on, at the lowest price in the orthopaedic range." } },
    { "type": "rung", "settings": { "label": "Better", "pick": true, "why": "Memory foam with a low front: easy in, easy out for stiff morning legs." } },
    { "type": "rung", "settings": { "label": "Best", "why": "Deep gel memory foam for the big, old or diagnosed dog who needs the most under them." } }
  ] } ]
}
{% endschema %}
