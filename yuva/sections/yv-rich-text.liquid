{% comment %}
  Section contract: yv-rich-text
  Yuva "Rich text": a column of text blocks in a small (sm, 1000px), medium (md, 1140px) or
  page-wide container, aligned left, centre or right. Text blocks (`_yv-rich-text`) carry a
  highlight heading (bold words switch to the highlight font and colour, optional rotating
  gradient words) and a description; Page blocks (`_yv-rich-text-page`) show a Shopify page;
  Button blocks (`_yv-button`) add a call to action. In the Yuva preset each rich text titles
  the section below it (top spacing only). When no block has anything to show (e.g. only a Page
  block with no page picked) the section renders nothing on the storefront, so it leaves no blank
  band; the theme editor still shows it.
  Shared settings: color set, visibility, spacing.
  @example
  Theme editor > Add section > Text > "Rich text"
{% endcomment %}

{%- liquid
  render 'yv-color-set', set: section.settings.color_set, section_id: section.id

  case section.settings.content_width
    when 'medium'
      assign container = 'md'
    when 'large'
      assign container = 'page'
    else
      assign container = 'sm'
  endcase

  assign align = section.settings.text_alignment | default: 'center'
-%}

{%- capture blocks_html -%}
  {%- content_for 'blocks' -%}
{%- endcapture -%}
{%- assign blocks_trimmed = blocks_html | strip -%}

{%- if blocks_trimmed != blank or request.design_mode -%}
<div class="section-background color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings, visibility_only: true %}"></div>
<div
  class="section section--page-width yv-section-spacing yv-rich-text color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings %}"
  style="{% render 'yv-section-spacing-style', settings: section.settings %}"
  data-testid="yv-rich-text"
>
  <div class="yv-container yv-container--{{ container }} yv-rich-text__inner yv-rich-text__inner--{{ align }}">
    {{- blocks_html -}}
  </div>
</div>
{%- endif -%}

{% stylesheet %}
  .yv-rich-text__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    text-align: start;
  }

  .yv-rich-text__inner--center {
    align-items: center;
    text-align: center;
  }

  .yv-rich-text__inner--right {
    align-items: flex-end;
    text-align: end;
  }

  .yv-rich-text__inner > * {
    max-width: 100%;
    min-width: 0;
  }

  .yv-rich-text__inner:empty {
    display: none;
  }

  /* Yuva insets the rich text container a little more than the page gutter on phones (96% width). */
  @media screen and (max-width: 749px) {
    .yv-rich-text__inner {
      padding-inline: 2%;
    }
  }
{% endstylesheet %}

{% schema %}
{
