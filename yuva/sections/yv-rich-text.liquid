      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:yv.names.rich_text",
      "category": "t:yv.categories.text",
      "settings": {
        "content_width": "small",
        "text_alignment": "center",
