{%- comment -%}
  PL: Real cost. Price framing: price ÷ (guarantee years × 365), rounded
  up, with the basis printed. Compared with small everyday spends the
  merchant enters (no invented "competitor" prices).
{%- endcomment -%}
{%- render 'yv-assets' -%}
{%- liquid
  assign p = section.settings.product
  assign years = settings.yv_guarantee_years | default: 5
  assign price = 0
  if p != blank
    assign price = p.price_min
  endif
  capture per_night_html
    echo '<span data-yv-per-night="' | append: price | append: '" data-years="' | append: years | append: '"><span data-value>a few pence</span></span>'
  endcapture
  assign heading_html = section.settings.heading | replace: '[per_night]', per_night_html
  assign price_text = price | money_without_trailing_zeros
-%}
{%- if p != blank and settings.yv_guarantee_enable -%}
<section class="yv yv--{{ section.settings.tone }}">
  <div class="yv-wrap yv-cost">
    <div>
      <span class="yv-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="yv-title">{{ heading_html }}</h2>
      <div class="yv-lede yv-rte" style="margin-top:2rem">{{ section.settings.body | replace: '[years]', years | replace: '[bed]', p.title | replace: '[price]', price_text }}</div>
      <p class="yv-cost__basis">Worked out as the {{ p.title }} at {{ p.price_min | money_without_trailing_zeros }}, divided by {{ years }} years of nights ({{ years | times: 365 }}). Rounded up, never down.</p>
      <div class="yv-actions"><a class="yv-btn yv-btn--secondary" href="{{ p.url }}">See the {{ p.title | split: ' ' | first }}</a></div>
    </div>
    <div>
      <h3 class="yv-sub" style="margin-bottom:1rem">{{ section.settings.compare_heading }}</h3>
      <ul class="yv-compare">
        <li><span>The {{ p.title | split: ' ' | first }}, per night</span><strong data-yv-per-night="{{ price }}" data-years="{{ years }}"><span data-value></span></strong></li>
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}><span>{{ block.settings.label }}</span><strong>{{ block.settings.price | times: 100 | round | money_without_trailing_zeros }}</strong></li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "PL: Real cost",
  "tag": "div",
  "settings": [
    { "type": "product", "id": "product", "label": "Bed to price (a memory foam bed)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What it really costs" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "About [per_night] a night." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Dogs spend twelve to fourteen hours a day lying down. Spread over the [years] years the foam is guaranteed for, a bed that actually holds them up works out at pennies a night. Worth comparing with a bed that's flat by spring, and the one you buy to replace it.</p>" },
    { "type": "text", "id": "compare_heading", "label": "Comparison heading", "default": "The same money, elsewhere" },
    { "type": "select", "id": "tone", "label": "Surface", "options": [ { "value": "page", "label": "Page" }, { "value": "oat", "label": "Oat" } ], "default": "page" }
  ],
  "blocks": [
    { "type": "compare", "name": "Everyday spend", "limit": 4, "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "A takeaway coffee" },
      { "type": "number", "id": "price", "label": "Price (£)", "default": 3 }
    ] }
  ],
  "presets": [ { "name": "PL: Real cost", "blocks": [
    { "type": "compare", "settings": { "label": "A takeaway coffee", "price": 3 } },
    { "type": "compare", "settings": { "label": "A bag of dog treats", "price": 4 } },
    { "type": "compare", "settings": { "label": "A cinema ticket", "price": 12 } }
  ] } ]
}
{% endschema %}
