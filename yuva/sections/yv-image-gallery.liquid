{% comment %}
  Section contract: yv-image-gallery
  Yuva "Image gallery": up to six linked image boxes (private blocks `_yv-gallery-image`), each with a
  heading and a subheading laid over the bottom of the image, under an optional highlight heading.
  Three columns on large screens, two on tablets, one on phones (or a swipe row of 80% cards when
  "Enable swipe on mobile" is on). Optional dotted outline around each box on desktop, landscape,
  portrait or square boxes, bottom-left or bottom-centre text, a bottom gradient for legibility and
  a slow image zoom on hover. Shared settings: section border, heading, colour set, visibility,
  spacing.
  @example
  Theme editor > Add section > Media > "Image gallery"
{% endcomment %}

{%- liquid
  render 'yv-color-set', set: section.settings.color_set, section_id: section.id

  assign section_class = 'yv-image-gallery yv-image-gallery--' | append: section.settings.image_ratio
  if section.settings.dotted_outline
    assign section_class = section_class | append: ' yv-image-gallery--outline'
  endif
  if section.settings.mobile_swipe
    assign section_class = section_class | append: ' yv-image-gallery--swipe'
  endif

  assign heading_alignment = section.settings.heading_alignment | default: 'center'
-%}

<div class="section-background color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings, visibility_only: true %}"></div>
<div
  class="section section--page-width yv-section-spacing {{ section_class }} color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings %}"
  style="{% render 'yv-section-spacing-style', settings: section.settings %}"
  data-testid="yv-image-gallery"
>
  <div class="yv-container yv-container--page yv-image-gallery__inner">
    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      {% render 'yv-heading',
        text: section.settings.heading,
        tag: section.settings.heading_tag,
        size: section.settings.heading_size,
        highlight_font: section.settings.highlight_font,
        highlight_color: section.settings.highlight_color,
        description: section.settings.description,
        alignment: heading_alignment,
        class: 'yv-image-gallery__heading',
        reveal: true
      %}
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="yv-image-gallery__grid">
        {%- content_for 'blocks' -%}
      </div>
    {%- elsif request.design_mode -%}
      {%- comment -%} Theme editor, no boxes yet: placeholder boxes in the chosen ratio. {%- endcomment -%}
      <div class="yv-image-gallery__grid">
        {%- for i in (1..3) -%}
          <div class="yv-image-gallery__placeholder">
            {{- 'collection-' | append: i | placeholder_svg_tag: 'yv-placeholder' -}}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .yv-image-gallery {
    --yv-image-gallery-gap: 12px;
    --yv-image-gallery-ratio: 484 / 284;
  }

  .yv-image-gallery--portrait {
    --yv-image-gallery-ratio: 5 / 6;
  }

  .yv-image-gallery--square {
    --yv-image-gallery-ratio: 1 / 1;
  }

  .yv-image-gallery__inner {
    min-width: 0;
  }

  .yv-image-gallery__heading {
    --yv-heading-description-width: 760px;

    margin-block-end: 30px;
  }

  .yv-image-gallery__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--yv-image-gallery-gap);
  }

  /* Phones: a swipe row of 80% cards bleeding to the screen edges, no snap and no controls. */
  @media screen and (max-width: 749px) {
    .yv-image-gallery--swipe .yv-image-gallery__grid {
      --yv-image-gallery-gap: 20px;

      display: flex;
      margin-inline: calc(var(--page-margin, 20px) * -1);
      padding-inline: var(--page-margin, 20px);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }

    .yv-image-gallery--swipe .yv-image-gallery__grid::-webkit-scrollbar {
      display: none;
    }

    .yv-image-gallery--swipe .yv-image-gallery__grid > * {
      flex: 0 0 80%;
    }
  }

  @media screen and (min-width: 750px) {
    .yv-image-gallery {
      --yv-image-gallery-gap: 20px;
    }

    .yv-image-gallery__heading {
      margin-block-end: 40px;
    }

    .yv-image-gallery__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Room for the dotted outline that sits 8px outside each box. */
    .yv-image-gallery--outline .yv-image-gallery__grid {
      gap: calc(var(--yv-image-gallery-gap) + 16px);
      padding: 9px;
    }
  }

  @media screen and (min-width: 990px) {
    .yv-image-gallery__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .yv-image-gallery__placeholder {
    aspect-ratio: var(--yv-image-gallery-ratio, 484 / 284);
    overflow: hidden;
    background-color: var(--yv-image-bg);
    border-radius: var(--yv-layout-radius, 10px);
  }

  .yv-image-gallery__placeholder > svg {
    display: block;
    width: 100%;
    height: 100%;
  }
{% endstylesheet %}

