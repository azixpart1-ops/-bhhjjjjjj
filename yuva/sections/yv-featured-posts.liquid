{% comment %}
  Section contract: yv-featured-posts
  Yuva "Featured posts": up to three hand-picked articles (private `_yv-featured-post` blocks)
  under a highlight heading with an optional "View all" text link at the right end of the row.
  Two looks:
  - below the image (default): Yuva blog cards with a date pill on the image, title, two-line
    excerpt and an outlined "Read more" pill; optional card background;
  - overlay: the cards sit flush as one rounded strip, text over a dark scrim, and the
    "Read more" button slides up on hover (always visible on touch screens).
  Columns follow the number of posts from 750px; phones get a swipe row with the next card
  peeking. Image ratio: Theme settings > Images > Post (Auto = the first post's image ratio).
  Shared settings: highlight heading, colour set, visibility, spacing.
  @example
  Theme editor > Add section > Storytelling > "Featured posts"
{% endcomment %}

{%- liquid
  render 'yv-color-set', set: section.settings.color_set, section_id: section.id

  assign overlay = section.settings.content_overlay
  assign post_count = section.blocks.size
  if post_count < 1
    assign post_count = 1
  endif

  assign first_ratio = null
  for block in section.blocks
    if block.settings.article.image != blank
      assign first_ratio = block.settings.article.image.aspect_ratio
      break
    endif
  endfor

  case settings.yv_post_image_ratio
    when 'landscape'
      assign post_ratio = '4 / 3'
    when 'portrait'
      assign post_ratio = '3 / 4'
    when 'square'
      assign post_ratio = '1 / 1'
    else
      assign post_ratio = first_ratio | default: 1.706
  endcase
  if overlay
    assign post_ratio = first_ratio | default: 0.93
  endif

  assign text_alignment = section.settings.text_alignment | default: 'left'
  case text_alignment
    when 'center'
      assign card_align = 'center'
      assign card_justify = 'center'
    when 'right'
      assign card_align = 'end'
      assign card_justify = 'flex-end'
    else
      assign card_align = 'start'
      assign card_justify = 'flex-start'
  endcase

  assign has_link = false
  if section.settings.button_text != blank and section.settings.button_link != blank
    assign has_link = true
  endif
-%}

<div class="section-background color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings, visibility_only: true %}"></div>
<div
  class="section section--page-width yv-section-spacing color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings %}"
  style="{% render 'yv-section-spacing-style', settings: section.settings %}"
  data-testid="yv-featured-posts"
>
  <div class="yv-container yv-container--page yv-featured-posts{% if overlay %} yv-featured-posts--overlay{% endif %}">
    {%- if section.settings.heading != blank or section.settings.rotating_text != blank or has_link -%}
      <div class="yv-featured-posts__header">
        {% render 'yv-heading',
          text: section.settings.heading,
          tag: section.settings.heading_tag,
          size: 'large',
          highlight_font: section.settings.highlight_font,
          highlight_color: section.settings.highlight_color,
          rotating_text: section.settings.rotating_text,
          alignment: 'left',
          class: 'yv-featured-posts__heading',
          reveal: true
        %}
        {%- if has_link -%}
          <a
            class="yv-featured-posts__view-all"
            href="{{ section.settings.button_link }}"
          >
            {{- section.settings.button_text | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div
        class="yv-featured-posts__grid"
        style="--yv-fp-columns: {{ post_count }}; --yv-fp-ratio: {{ post_ratio }}; --yv-fp-align: {{ card_align }}; --yv-fp-justify: {{ card_justify }};"
      >
        {%- content_for 'blocks' -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .yv-featured-posts__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    margin-block-end: 25px;
    text-align: center;
  }

  .yv-featured-posts__heading {
    min-width: 0;
    max-width: 100%;
  }

  .yv-featured-posts__header .yv-heading {
    text-align: center;
  }

  .yv-featured-posts__view-all {
    flex: none;
    color: inherit;
    font-size: var(--yv-text-lg, 15.36px);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.3s ease;
  }

  .yv-featured-posts__view-all:hover {
    color: var(--yv-theme-color, currentColor);
  }

  .yv-featured-posts__grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 83%;
    gap: 20px;
    margin-inline: calc(-1 * var(--yv-page-gutter, 20px));
    padding-inline: var(--yv-page-gutter, 20px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--yv-page-gutter, 20px);
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .yv-featured-posts__grid::-webkit-scrollbar {
    display: none;
  }

  .yv-featured-posts__grid > * {
    scroll-snap-align: start;
  }

  @media screen and (min-width: 750px) {
    .yv-featured-posts__header {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 30px;
      margin-block-end: 15px;
      text-align: start;
    }

    .yv-featured-posts__header .yv-heading {
      text-align: start;
    }

    .yv-featured-posts__grid {
      grid-auto-flow: row;
      grid-template-columns: repeat(var(--yv-fp-columns, 3), minmax(0, 1fr));
      grid-auto-columns: auto;
      gap: 30px;
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
      scroll-snap-type: none;
    }

    .yv-featured-posts--overlay .yv-featured-posts__header {
      margin-block-end: 25px;
    }

    .yv-featured-posts--overlay .yv-featured-posts__grid {
      gap: 0;
      overflow: hidden;
      border-radius: var(--yv-layout-radius, 10px);
    }
  }
{% endstylesheet %}

