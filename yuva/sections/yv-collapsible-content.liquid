{% comment %}
  Section contract: yv-collapsible-content
  Yuva "Collapsible content" (FAQ): an optional highlight heading above up to 6 collapsible rows
  (`_yv-collapsible-row`) in the small (1000px) container. Each row is a shadowed card: a header
  bar in its own colour set with a thin plus that turns into a minus, and the answer on the
  section background. Native <details>/<summary> inside Horizon's accordion-custom (works without
  JS); rows share a `name`, so opening one closes the others, and the first row can start open.
  assets/yv-collapsible-content.js opens a row when it is selected in the theme editor.
  Shared settings: section border, highlight heading, color set (+ row header set), visibility, spacing.
  @example
  Theme editor > Add section > Text > "Collapsible content"
{% endcomment %}

{%- liquid
  render 'yv-color-set', set: section.settings.color_set, section_id: section.id
  assign row_set_id = section.id | append: '-row'
  render 'yv-color-set', set: section.settings.row_color_set, section_id: row_set_id
-%}

<script
  src="{{ 'yv-collapsible-content.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<div class="section-background color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings, visibility_only: true %}"></div>
<div
  class="section section--page-width yv-section-spacing yv-faq color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings %}"
  style="{% render 'yv-section-spacing-style', settings: section.settings %}"
  data-testid="yv-collapsible-content"
>
  <div class="yv-container yv-container--sm yv-faq__inner">
    {% render 'yv-heading',
      text: section.settings.heading,
      tag: section.settings.heading_tag,
      size: section.settings.heading_size,
      highlight_font: section.settings.highlight_font,
      highlight_color: section.settings.highlight_color,
      alignment: 'left',
      class: 'yv-faq__heading',
      reveal: settings.yv_enable_animation
    %}

    <yv-collapsible-content-component class="yv-faq__list">
      {%- content_for 'blocks' -%}
    </yv-collapsible-content-component>
  </div>
</div>

{% stylesheet %}
  .yv-faq__inner {
    display: flex;
    flex-direction: column;
  }

  .yv-faq__list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-block-start: 40px;
  }

  .yv-faq__list:empty {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .yv-faq__list {
      margin-block-start: 20px;
    }
  }

  /* Yuva's accordion is 1000px wide on desktop (x 215–1215 at 1440), wider than the sm container. */
  @media screen and (min-width: 990px) {
    .yv-faq__inner.yv-container--sm {
      max-width: 1000px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:yv.names.collapsible_content",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 6,
