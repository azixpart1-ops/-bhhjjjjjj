{%- comment -%}
  PL: The close. Emotional close on protective pride, then the same two
  calls to action as the hero (consistency). Moss surface so the page slows
  down and the reader decides.
{%- endcomment -%}
{%- render 'pln-assets' -%}
<section class="pln pln--{{ section.settings.tone }}">
  <div class="pln-wrap pln-final">
    <h2 class="pln-display">{{ section.settings.heading }}</h2>
    <p class="pln-lede" style="margin:2rem auto 0">{{ section.settings.lede }}</p>
    <div class="pln-actions">
      <a class="pln-btn pln-btn--primary" href="{{ section.settings.primary_link | default: '/pages/bed-finder' }}">{{ section.settings.primary_label }}</a>
      <a class="pln-btn pln-btn--secondary" href="{{ section.settings.secondary_link | default: '/collections/dog-beds' }}">{{ section.settings.secondary_label }}</a>
    </div>
    {%- if settings.pln_origin_enable and settings.pln_origin_line != blank -%}<p class="pln-small pln-muted" style="margin-top:2rem">{{ settings.pln_origin_line }} · {{ settings.pln_trial_nights | default: 100 }} nights to decide · {% render 'pln-delivery-claim' %}</p>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "PL: The close",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "They've given you every good year they had." },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "The least we can do is make the next ones easier to get up from. Four questions, and we'll point you to the right bed." },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "Find my dog's bed" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Shop all beds" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "select", "id": "tone", "label": "Surface", "options": [ { "value": "moss", "label": "Moss (dark)" }, { "value": "warm", "label": "Warm" } ], "default": "moss" }
  ],
  "presets": [ { "name": "PL: The close" } ]
}
{% endschema %}
