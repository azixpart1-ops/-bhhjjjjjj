{%- comment -%}
  PL: Dead-end rescue. For 404, empty search and empty basket: a warm
  line, the Bed Finder, and four beds. A dead end becomes a next step.
{%- endcomment -%}
{%- render 'pln-assets' -%}
{%- assign c = section.settings.collection | default: collections['dog-beds'] -%}
<section class="pln pln--{{ section.settings.tone }}">
  <div class="pln-wrap">
    <div class="pln-empty">
      {%- if section.settings.as_h1 -%}<h1 class="pln-title">{{ section.settings.heading }}</h1>{%- else -%}<h2 class="pln-title">{{ section.settings.heading }}</h2>{%- endif -%}
      <p class="pln-lede" style="margin:2rem auto 0">{{ section.settings.text }}</p>
      <div class="pln-actions" style="justify-content:center">
        <a class="pln-btn pln-btn--primary" href="/pages/bed-finder">Find their bed</a>
        <a class="pln-btn pln-btn--secondary" href="{{ c.url | default: routes.all_products_collection_url }}">Browse every bed</a>
      </div>
    </div>
    {%- if c != blank and c.products.size > 0 -%}
    <div class="pln-grid pln-grid--4" style="margin-top:3rem">
      {%- for p in c.products limit: 4 -%}<div>{% render 'pln-product-card', product: p %}</div>{%- endfor -%}
    </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "PL: Dead-end rescue",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "That page has wandered off." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Dogs do it too. Four questions will get you to the right bed faster than the back button." },
    { "type": "checkbox", "id": "as_h1", "label": "Heading is the page H1 (404)", "default": true },
    { "type": "collection", "id": "collection", "label": "Beds to show" },
    { "type": "select", "id": "tone", "label": "Surface", "options": [ { "value": "page", "label": "Page" }, { "value": "oat", "label": "Oat" } ], "default": "page" }
  ],
  "presets": [ { "name": "PL: Dead-end rescue" } ]
}
{% endschema %}
