{%- comment -%}
  PL: Sticky finder bar (phones). Keeps the one next step within reach once
  the hero has scrolled away. Hides while the Bed Finder or the footer is
  on screen so it never covers the thing it points at. Desktop: hidden.
{%- endcomment -%}
{%- render 'yv-assets' -%}
{%- if section.settings.enable -%}
<yv-sticky-bar class="yv-sticky" data-show="false" data-after="{{ section.settings.after | default: '#yv-hero' }}" role="complementary" aria-label="Find a bed">
  <span>{{ section.settings.text }}</span>
  <a class="yv-btn" href="{{ section.settings.link | default: '/pages/bed-finder' }}">{{ section.settings.label }}</a>
</yv-sticky-bar>
{%- endif -%}
{% schema %}
{
  "name": "PL: Sticky finder bar",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "Show on phones", "default": true },
    { "type": "text", "id": "text", "label": "Text", "default": "Not sure which bed? 4 questions." },
    { "type": "text", "id": "label", "label": "Button", "default": "Find their bed" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "after", "label": "Show after this element has scrolled away (CSS selector)", "default": "#yv-hero" }
  ],
  "presets": [ { "name": "PL: Sticky finder bar" } ]
}
{% endschema %}
