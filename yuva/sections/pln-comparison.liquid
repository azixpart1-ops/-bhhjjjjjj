{%- comment -%}
  PL: Side by side. Contrast effect: what to check on any bed, ours in the
  highlighted column. Columns are generic categories ("a supermarket bed",
  "a human mattress topper"), never a named competitor.
{%- endcomment -%}
{%- render 'pln-assets' -%}
{%- liquid
  assign nights = settings.pln_trial_nights | default: 100
  assign years = settings.pln_guarantee_years | default: 5
-%}
<section class="pln pln--{{ section.settings.tone }}">
  <div class="pln-wrap">
    <div class="pln-head">
      <span class="pln-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="pln-title">{{ section.settings.heading }}</h2>
    </div>
    <div class="pln-table-scroll">
      <table class="pln-table">
        <thead><tr><th scope="col">{{ section.settings.feature_head }}</th><th scope="col" class="pln-table__ours">{{ shop.name }}</th><th scope="col">{{ section.settings.alt_1 }}</th><th scope="col">{{ section.settings.alt_2 }}</th></tr></thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.feature }}</th>
              <td class="pln-table__ours">{{ block.settings.ours | replace: '[nights]', nights | replace: '[years]', years }}</td>
              <td>{{ block.settings.alt_1 }}</td>
              <td>{{ block.settings.alt_2 }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "PL: Side by side",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Before you buy any bed" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Worth checking on any bed." },
    { "type": "text", "id": "feature_head", "label": "First column", "default": "Check" },
    { "type": "text", "id": "alt_1", "label": "Column 3", "default": "A supermarket bed" },
    { "type": "text", "id": "alt_2", "label": "Column 4", "default": "A human mattress topper" },
    { "type": "select", "id": "tone", "label": "Surface", "options": [ { "value": "page", "label": "Page" }, { "value": "oat", "label": "Oat" } ], "default": "page" }
  ],
  "blocks": [
    { "type": "row", "name": "Row", "settings": [
      { "type": "text", "id": "feature", "label": "Check" },
      { "type": "text", "id": "ours", "label": "Ours" },
      { "type": "text", "id": "alt_1", "label": "Column 3" },
      { "type": "text", "id": "alt_2", "label": "Column 4" }
    ] }
  ],
  "presets": [ { "name": "PL: Side by side", "blocks": [
    { "type": "row", "settings": { "feature": "What's underneath", "ours": "Memory foam or egg-crate foam on the orthopaedic beds; the page says which", "alt_1": "Loose fibre that packs down", "alt_2": "Foam, but thin and sized for a human" } },
    { "type": "row", "settings": { "feature": "Chin rest and sides", "ours": "Bolsters or a raised rim where the bed has them", "alt_1": "Soft sides that collapse", "alt_2": "None" } },
    { "type": "row", "settings": { "feature": "Stepping in", "ours": "Low fronts on the low step-in beds", "alt_1": "Varies", "alt_2": "Flat, but thin at the edges" } },
    { "type": "row", "settings": { "feature": "Accidents", "ours": "Waterproof inner liner on marked beds", "alt_1": "Rarely", "alt_2": "Depends on the cover you buy" } },
    { "type": "row", "settings": { "feature": "Washing", "ours": "Cover comes off and washes", "alt_1": "Often the whole bed, which never quite dries", "alt_2": "Depends on the cover" } },
    { "type": "row", "settings": { "feature": "Trying it", "ours": "[nights] nights, free collection, slept on", "alt_1": "Often 14 to 30 days, you pay postage", "alt_2": "None for dog use" } },
    { "type": "row", "settings": { "feature": "Guarantee", "ours": "[years] years on the memory foam core", "alt_1": "Rarely any", "alt_2": "None for dog use" } }
  ] } ]
}
{% endschema %}
