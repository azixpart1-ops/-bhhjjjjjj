{%- comment -%}
  PL: Three signs. Recognition and self-diagnosis: named behaviours the
  owner can check tonight. Turns a nice-to-have into a now-purchase without
  blame ("none of this is anyone's fault"). This is the emotional engine of
  the page and it runs on protective pride, not guilt.
{%- endcomment -%}
{%- render 'pln-assets' -%}
<section class="pln pln--{{ section.settings.tone }}">
  <div class="pln-wrap">
    <div class="pln-head">
      {%- if section.settings.eyebrow != blank -%}<span class="pln-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="pln-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.lede != blank -%}<p class="pln-lede">{{ section.settings.lede }}</p>{%- endif -%}
    </div>
    <div class="pln-grid pln-grid--3">
      {%- for block in section.blocks -%}
        <article class="pln-card pln-sign pln-reveal" {{ block.shopify_attributes }}>
          <span class="pln-sign__when">Sign {{ forloop.index }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p class="pln-muted">{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}<p class="pln-small pln-muted" style="margin-top:1.5rem;max-width:60ch">{{ section.settings.note }}</p>{%- endif -%}
    <div class="pln-actions">
      <a class="pln-btn pln-btn--primary" href="{{ section.settings.cta_link | default: '/pages/bed-finder' }}">{{ section.settings.cta_label }}</a>
      <a class="pln-btn pln-btn--ghost" href="{{ section.settings.secondary_link | default: '/collections/dog-beds' }}">{{ section.settings.secondary_label }}</a>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "PL: Three signs",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Before you replace it" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three signs their bed has stopped working." },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "None of this is anyone's fault. Beds wear out quietly, and dogs don't complain. Here's what to look for tonight." },
    { "type": "textarea", "id": "note", "label": "Note", "default": "A bed can't undo ageing. What it can change is how much effort goes into lying down, and how much goes into getting back up." },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Find the right bed" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Or browse every bed" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "select", "id": "tone", "label": "Surface", "options": [ { "value": "page", "label": "Page" }, { "value": "oat", "label": "Oat" }, { "value": "warm", "label": "Warm" } ], "default": "page" }
  ],
  "blocks": [
    { "type": "sign", "name": "Sign", "limit": 4, "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "They keep circling after they've lain down." },
      { "type": "textarea", "id": "text", "label": "Text", "default": "A couple of turns before settling is just what dogs do. Turning, resettling, then shifting again ten minutes later usually means no position on that bed takes the weight off." }
    ] }
  ],
  "presets": [ { "name": "PL: Three signs", "blocks": [
    { "type": "sign", "settings": { "title": "They keep circling after they've lain down.", "text": "A couple of turns before settling is just what dogs do. Turning, resettling, then shifting again ten minutes later usually means no position on that bed takes the weight off." } },
    { "type": "sign", "settings": { "title": "They've started choosing the floor.", "text": "Once foam has bottomed out, cold tiles genuinely are the firmer, flatter option. A dog picking the kitchen floor over their own bed has done the comparison and reached a conclusion." } },
    { "type": "sign", "settings": { "title": "There's a dip that doesn't spring back.", "text": "Press a flat hand into the middle where they lie. If you can feel the floor through it, so can their hips and elbows." } }
  ] } ]
}
{% endschema %}
