{% comment %}
  Section contract: yv-newsletter
  Yuva Newsletter: a centred email sign-up band. Highlight heading,
  description and the shared newsletter form (snippets/yv-newsletter-form.liquid: pill email field
  and button side by side, stacked on narrow screens) with section-level button colours that invert
  on hover. Sign-ups create customer profiles tagged "newsletter"; after Shopify's reload the
  success or error message shows under the form.
  Shared settings: section border, highlight heading, colour set, visibility, spacing.
  @example
  Theme editor > Add section > Forms > "Newsletter"
{% endcomment %}

{%- liquid
  render 'yv-color-set', set: section.settings.color_set, section_id: section.id

  assign form_id = 'yv-newsletter-' | append: section.id
-%}

<div class="section-background color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings, visibility_only: true %}"></div>
<div
  class="section section--page-width yv-section-spacing color-custom-{{ section.id }}{% render 'yv-section-classes', settings: section.settings %}"
  style="{% render 'yv-section-spacing-style', settings: section.settings %}"
>
  <div class="yv-container yv-container--page">
    <div class="yv-newsletter">
      {%- render 'yv-heading',
        text: section.settings.heading,
        tag: section.settings.heading_tag,
        size: section.settings.heading_size,
        highlight_font: section.settings.highlight_font,
        highlight_color: section.settings.highlight_color,
        rotating_text: section.settings.rotating_text,
        description: section.settings.description,
        alignment: 'center',
        class: 'yv-newsletter__heading',
        reveal: true
      -%}

      <div
        class="yv-newsletter__form"
        data-yv-reveal
        style="--yv-reveal-delay: 150ms;"
      >
        {%- render 'yv-newsletter-form',
          form_id: form_id,
          placeholder: section.settings.placeholder,
          button_label: section.settings.button_text,
          layout: 'inline',
          button_bg: section.settings.color_button_bg,
          button_text: section.settings.color_button_text,
          button_border: section.settings.color_button_border
        -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .yv-newsletter {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    width: 100%;
    max-width: 640px;
    margin-inline: auto;
    text-align: center;
  }

  .yv-newsletter__heading {
    --yv-heading-description-width: 560px;

    width: 100%;
  }

  .yv-newsletter__heading .yv-heading__title {
    margin: 0;
  }

  .yv-newsletter__heading .yv-heading__description {
    font-size: var(--yv-text-lg, 15.36px);
    line-height: 1.5;
  }

  .yv-newsletter__form {
    width: 100%;
    max-width: 560px;
    text-align: start;
  }

  .yv-newsletter__form .yv-newsletter-form__message {
    justify-content: center;
  }

  @media screen and (max-width: 749px) {
    .yv-newsletter {
      gap: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:yv.names.newsletter",
  "tag": "section",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:yv.common.content.section_border"
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "t:yv.common.settings.border_top",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "border_bottom",
      "label": "t:yv.common.settings.border_bottom",
      "default": false
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "t:yv.common.settings.border_style",
      "options": [
        {
          "value": "solid",
          "label": "t:yv.common.options.solid"
        },
        {
          "value": "dashed",
          "label": "t:yv.common.options.dashed"
        }
      ],
      "default": "solid",
      "visible_if": "{{ section.settings.border_top or section.settings.border_bottom }}"
    },
    {
      "type": "header",
      "content": "t:yv.common.content.heading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:yv.common.settings.heading",
      "info": "t:yv.common.settings.heading_info",
      "default": "t:yv.newsletter.defaults.heading"
    },
    {
      "type": "select",
      "id": "highlight_font",
      "label": "t:yv.common.settings.highlight_font",
      "options": [
        {
          "value": "heading",
          "label": "t:yv.common.options.heading"
        },
        {
          "value": "body",
          "label": "t:yv.common.options.body"
        },
        {
          "value": "accent",
          "label": "t:yv.common.options.accent"
        }
      ],
      "default": "accent"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:yv.common.settings.heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:yv.common.options.h1"
        },
        {
          "value": "h2",
          "label": "t:yv.common.options.h2"
        },
        {
          "value": "h3",
          "label": "t:yv.common.options.h3"
        },
        {
          "value": "h4",
          "label": "t:yv.common.options.h4"
        },
        {
          "value": "h5",
          "label": "t:yv.common.options.h5"
        },
        {
          "value": "h6",
          "label": "t:yv.common.options.h6"
        },
        {
          "value": "p",
          "label": "t:yv.common.options.paragraph"
        }
      ],
      "default": "h2",
      "info": "t:yv.common.settings.heading_tag_info"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:yv.common.settings.heading_size",
      "options": [
        {
          "value": "small",
          "label": "t:yv.common.options.small"
        },
        {
          "value": "medium",
          "label": "t:yv.common.options.medium"
        },
        {
          "value": "large",
          "label": "t:yv.common.options.large"
        }
      ],
      "default": "large"
    },
    {
      "type": "color_background",
      "id": "highlight_color",
      "label": "t:yv.common.settings.highlight_color",
      "default": "linear-gradient(90deg, #A678C8 0%, #718CC7 48.08%, #639A47 100%)",
      "info": "t:yv.common.settings.highlight_color_info"
    },
    {
      "type": "text",
      "id": "rotating_text",
      "label": "t:yv.common.settings.rotating_text",
      "info": "t:yv.common.settings.rotating_text_info"
    },
    {
      "type": "header",
      "content": "t:yv.common.content.content"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:yv.common.settings.description",
      "default": "t:yv.newsletter.defaults.description"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "t:yv.newsletter.settings.placeholder",
      "default": "t:yv.newsletter.defaults.placeholder"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "t:yv.common.settings.button_text",
      "default": "t:yv.newsletter.defaults.button_text"
    },
    {
      "type": "header",
      "content": "t:yv.common.content.colors"
    },
    {
      "type": "select",
      "id": "color_set",
      "label": "t:yv.common.settings.color_set",
      "options": [
        {
          "value": "primary",
          "label": "t:yv.common.options.primary"
        },
        {
          "value": "secondary",
          "label": "t:yv.common.options.secondary"
        },
        {
          "value": "tertiary",
          "label": "t:yv.common.options.tertiary"
        },
        {
          "value": "quaternary",
          "label": "t:yv.common.options.quaternary"
        },
        {
          "value": "gradient",
          "label": "t:yv.common.options.gradient"
        }
      ],
      "default": "secondary",
      "info": "t:yv.common.settings.color_set_info"
    },
    {
      "type": "color",
      "id": "color_button_text",
      "label": "t:yv.common.settings.button_text_color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "color_button_bg",
      "label": "t:yv.common.settings.button_background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "color_button_border",
      "label": "t:yv.common.settings.button_border",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "section_visibility",
      "label": "t:yv.common.settings.section_visibility",
      "options": [
        {
          "value": "always",
          "label": "t:yv.common.options.always"
        },
        {
          "value": "small",
          "label": "t:yv.common.options.small_devices"
        },
        {
          "value": "large",
          "label": "t:yv.common.options.large_devices"
        }
      ],
      "default": "always",
      "info": "t:yv.common.settings.section_visibility_info"
    },
    {
      "type": "header",
      "content": "t:yv.common.content.section_spacing"
    },
    {
      "type": "range",
      "id": "spacing_top_desktop",
      "label": "t:yv.common.settings.top_spacing_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "spacing_bottom_desktop",
      "label": "t:yv.common.settings.bottom_spacing_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "spacing_top_mobile",
      "label": "t:yv.common.settings.top_spacing_mobile",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "spacing_bottom_mobile",
      "label": "t:yv.common.settings.bottom_spacing_mobile",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:yv.names.newsletter",
      "category": "t:yv.categories.forms",
      "settings": {
        "heading": "t:yv.newsletter.defaults.heading",
        "description": "t:yv.newsletter.defaults.description",
        "placeholder": "t:yv.newsletter.defaults.placeholder",
        "button_text": "t:yv.newsletter.defaults.button_text"
      }
    }
  ]
}
{% endschema %}
