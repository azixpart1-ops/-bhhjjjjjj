{%- comment -%}
  PL: The first fortnight. The emotional after-state, sold in the owner's
  own words (night 1, week 1, week 2). Protective pride. Not reviews, and
  never marked up as reviews.
{%- endcomment -%}
{%- render 'pln-assets' -%}
{%- liquid
  assign nights = settings.pln_trial_nights | default: 100
  assign img = section.settings.image
  if img == blank and section.settings.fallback_product != blank
    assign img = section.settings.fallback_product.featured_image
  endif
-%}
<section class="pln pln--{{ section.settings.tone }}">
  <div class="pln-wrap pln-split pln-split--media-{{ section.settings.image_position }}">
    <div class="pln-split__body">
      <span class="pln-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="pln-title">{{ section.settings.heading }}</h2>
      <p class="pln-lede" style="margin-top:2rem">{{ section.settings.lede }}</p>
      <ol class="pln-timeline" style="grid-template-columns:1fr;margin-top:2rem">
        {%- for block in section.blocks -%}
          <li class="pln-tl pln-reveal" {{ block.shopify_attributes }}>
            <span class="pln-tl__when">{{ block.settings.when }}</span>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </li>
        {%- endfor -%}
      </ol>
      <p style="margin-top:1.5rem"><strong>{{ section.settings.close | replace: '[nights]', nights }}</strong></p>
      <div class="pln-actions">
        <a class="pln-btn pln-btn--primary" href="/pages/bed-finder">{{ section.settings.cta_label }}</a>
        <span class="pln-actions__note">{{ section.settings.cta_note }}</span>
      </div>
    </div>
    <div class="pln-split__media">
      <div class="pln-media" style="aspect-ratio:4/5;border-radius:var(--pln-radius-lg)">
        {%- if img != blank -%}{{ img | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.image_alt | default: img.alt | default: '' }}{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag }}{%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "PL: The first fortnight",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The first fortnight" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What you'll be watching for." },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "A bed proves itself at 2am, not in the shop. These are the three things owners of older dogs tell each other to look out for, in the order they usually turn up." },
    { "type": "text", "id": "close", "label": "Closing line", "default": "See none of it? That's what the [nights] nights are for. We collect it free and refund every penny." },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Find their bed" },
    { "type": "text", "id": "cta_note", "label": "Button note", "default": "4 questions · 30 seconds" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "product", "id": "fallback_product", "label": "Or use this bed's photo" },
    { "type": "text", "id": "image_alt", "label": "Image alt", "default": "A dog asleep on a memory foam bed" },
    { "type": "select", "id": "image_position", "label": "Image", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "select", "id": "tone", "label": "Surface", "options": [ { "value": "warm", "label": "Warm" }, { "value": "page", "label": "Page" }, { "value": "oat", "label": "Oat" } ], "default": "warm" }
  ],
  "blocks": [
    { "type": "sign", "name": "Moment", "limit": 4, "settings": [
      { "type": "text", "id": "when", "label": "When", "default": "Night 1" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [ { "name": "PL: The first fortnight", "blocks": [
    { "type": "sign", "settings": { "when": "Night 1", "title": "Straight in.", "text": "Put it where they already sleep, with a blanket that smells of home on top. Most dogs claim it the first evening. A cautious few take a fortnight, and that's normal too." } },
    { "type": "sign", "settings": { "when": "Week 1", "title": "Sleeps right through.", "text": "Fewer laps of the house at 2am, fewer resettles. The circling before lying down gets shorter, because one position finally takes the weight off." } },
    { "type": "sign", "settings": { "when": "Week 2", "title": "Won't get off it.", "text": "The stage owners talk about most: the bed becomes the spot, the sofa loses its appeal, and the cat starts eyeing it up." } }
  ] } ]
}
{% endschema %}
