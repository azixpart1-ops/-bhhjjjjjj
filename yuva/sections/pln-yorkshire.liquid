{%- comment -%}
  PL: Made in Yorkshire. Provenance and brand: the origin line from
  settings, the Lake District naming, the maker's voice. Place names are
  listed as a decorative line (no false claims about where each bed was
  sewn beyond the origin line the owner has set).
{%- endcomment -%}
{%- render 'pln-assets' -%}
{%- liquid
  assign origin = settings.pln_origin_line | default: ''
  assign img = section.settings.image
  if img == blank and section.settings.fallback_product != blank
    assign img = section.settings.fallback_product.featured_image
  endif
-%}
<section class="pln pln--{{ section.settings.tone }}">
  <div class="pln-wrap pln-split pln-split--media-{{ section.settings.image_position }}">
    <div class="pln-split__body">
      <span class="pln-eyebrow">{% if settings.pln_origin_enable and origin != '' %}{{ origin }}{% else %}{{ section.settings.eyebrow }}{% endif %}</span>
      <h2 class="pln-title">{{ section.settings.heading }}</h2>
      <div class="pln-lede pln-rte" style="margin-top:2rem">{{ section.settings.body | replace: '[origin]', origin | replace: '[owner]', settings.pln_owner_name | default: 'Abbas' }}</div>
      {%- if section.settings.places != blank -%}<p class="pln-places">{{ section.settings.places }}</p>{%- endif -%}
      <ul class="pln-prov">
        {%- if settings.pln_origin_enable and origin != '' -%}<li>{% render 'pln-icon', name: 'pin', class: 'pln-icon--success' %}{{ origin }}</li>{%- endif -%}
        <li>{% render 'pln-icon', name: 'paw', class: 'pln-icon--success' %}Named for the Lakes and Dales</li>
        <li>{% render 'pln-icon', name: 'chat', class: 'pln-icon--success' %}Answered by {{ settings.pln_owner_name | default: 'Abbas' }}, not a bot</li>
      </ul>
      <div class="pln-actions"><a class="pln-btn pln-btn--secondary" href="{{ section.settings.link | default: '/pages/our-story' }}">{{ section.settings.link_label }}</a></div>
    </div>
    <div class="pln-split__media">
      <div class="pln-media" style="aspect-ratio:4/5;border-radius:var(--pln-radius-lg)">
        {%- if img != blank -%}{{ img | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.image_alt | default: img.alt | default: '' }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag }}{%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "PL: Made in Yorkshire",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (used when the origin line is off)", "default": "Named for the Lakes" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made in Yorkshire, named for the fells next door." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Borrowdale, Coniston, Grasmere, Windermere. The range takes its names from the places the walking gets done at weekends, which is also where most of the thinking about these beds happened: wet days on the tops, a muddy dog in the boot, and an evening where all anyone wants is somewhere warm to lie down.</p><p>[origin]. Each bed is built around a sleeping style rather than a price point. Curlers get walls. Sprawlers get surface. Old joints get foam that doesn't bottom out. Where a bed is fibre-filled rather than foam, the page says so, because you'd rather know now than in month three.</p>" },
    { "type": "text", "id": "places", "label": "Place names line", "default": "Borrowdale · Coniston · Grasmere · Windermere · Kendal · Ambleside · Wensleydale" },
    { "type": "text", "id": "link_label", "label": "Button", "default": "Read our story" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "image_picker", "id": "image", "label": "Image (the workshop, the Dales, or a bed at home)" },
    { "type": "product", "id": "fallback_product", "label": "Or use this bed's photo" },
    { "type": "text", "id": "image_alt", "label": "Image alt", "default": "A dog bed in a Yorkshire kitchen" },
    { "type": "select", "id": "image_position", "label": "Image", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "select", "id": "tone", "label": "Surface", "options": [ { "value": "oat", "label": "Oat" }, { "value": "page", "label": "Page" }, { "value": "warm", "label": "Warm" } ], "default": "oat" }
  ],
  "presets": [ { "name": "PL: Made in Yorkshire" } ]
}
{% endschema %}
