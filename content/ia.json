  {
   "handle": "bed-finder",
   "title": "Find Your Dog's Bed",
   "template_suffix": "bed-finder",
   "keyword": "which dog bed should i buy",
   "brief": "Short intro above the quiz: 4 questions, sleep style first; reassure; what happens after."
  },
  {
   "handle": "100-night-trial",
   "title": "The 100-Night Sleep Trial",
   "template_suffix": "",
   "keyword": "dog bed trial / dog bed returns",
   "brief": "Risk reversal page. Exactly the terms in the product data (UK mainland free collection + full refund within 100 nights; outdoor dog houses/day beds have a 30-day change-of-mind window at your cost instead; statutory rights unaffected). How it works step by step; why we do it; settling-in tips (give them time). Mark anything not in the data as [CONFIRM]."
  },
  {
   "handle": "delivery-returns",
   "title": "Delivery & Returns",
   "template_suffix": "",
   "keyword": "dog bed delivery uk",
   "brief": "Free standard UK delivery over \u00a340 (data). Dispatch times / couriers / costs under \u00a340 NOT in data -> [CONFIRM] placeholders in claims list and neutral copy ('Delivery options and times are shown at checkout'). Returns: link to the trial page."
  },
  {
   "handle": "choose-orthopaedic-beds",
   "title": "How to Choose an Orthopaedic Dog Bed",
   "template_suffix": "",
   "keyword": "best orthopaedic dog bed uk / how to choose",
   "brief": "Long-form buying guide (keeps the old store's URL). What 'orthopaedic' should mean, memory foam vs egg-crate vs fibre (honest, general), depth, sides and entry height for stiff dogs, sizing, washability, waterproof liners, red flags; links to collections/products; finder CTA. No medical promises; vet line."
  },
  {
   "handle": "dog-bed-guide",
   "title": "Which Dog Bed? Match It to How They Sleep",
   "template_suffix": "",
   "keyword": "what type of dog bed is best",
   "brief": "Sleep-style guide: curlers -> nest/donut, leaners -> bolster/sofa/chaise, sprawlers -> mattress/flat/elevated; plus heat, mess, space; links to collections; finder CTA."
  },
  {
   "handle": "size-guide",
   "title": "Dog Bed Size Guide",
   "template_suffix": "",
   "keyword": "dog bed size guide uk",
   "brief": "How to measure (asleep, stretched out, nose to base of tail, add ~20cm), sizing by sleep style, breed table (general guidance, not product-specific), why sizes differ between beds (check each product's dimensions in its size options), between sizes advice."
  },
  {
   "handle": "foam-explained",
   "title": "Memory Foam, Egg-Crate and Fibre: What's Inside",
   "template_suffix": "",
   "keyword": "memory foam vs egg crate dog bed",
   "brief": "Plain-English explainer of fillings used across the range (memory foam, crumb memory foam, egg-crate foam, fibre fill, mesh). General properties only; NO density figures (none in data); waterproof liners; how to tell if a bed is bottoming out. Replaces the old /pages/our-foam."
  },
  {
   "handle": "care-guide",
   "title": "Dog Bed Care & Washing Guide",
   "template_suffix": "",
   "keyword": "how to wash a dog bed",
   "brief": "Washing covers (follow each product's label; many covers are 30\u00b0C washable per the data), drying, foam care (don't machine-wash foam), waterproof liners, wipe-clean fabrics, elevated beds (hose clean per data), smells, rotating/airing; when to replace."
  },
  {
   "handle": "older-dog-sleep",
   "title": "Helping an Older Dog Sleep Well",
   "template_suffix": "",
   "keyword": "best bed for older dog / senior dog sleep",
   "brief": "Emotional, careful guide: signs a bed has stopped working (circling, choosing the floor, slow rise), what to look for (support, low entry, warmth, non-slip), placement, routine; clear vet line; no treatment claims; links to older-dogs and orthopaedic collections, finder."
  }
