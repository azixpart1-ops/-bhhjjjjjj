            "border": "none",
            "border_width": 1,
            "border_opacity": 100
          },
          "blocks": {
            "eyebrow": {
              "type": "text",
              "settings": {
                "text": "<p>{{ closest.product.type | default: closest.product.vendor }}</p>",
                "type_preset": "h6",
                "alignment": "left",
                "padding-block-start": 0,
                "padding-block-end": 4,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "title": {
              "type": "text",
              "settings": {
                "text": "<h1>{{ closest.product.title }}</h1>",
