    "craft": {
      "type": "cc-split-feature",
      "blocks": {
        "p1": {
          "type": "point",
          "settings": {
            "icon": "hand",
            "text": "Upholstered by hand, one bed at a time"
          }
        },
        "p2": {
          "type": "point",
          "settings": {
            "icon": "check-circle",
            "text": "Kiln-dried hardwood frame, tested to 200kg"
          }
        },
        "p3": {
          "type": "point",
          "settings": {
            "icon": "ruler",
            "text": "Fabric rated to 40,000 rubs — sofa-grade"
          }
        },
        "p4": {
          "type": "point",
          "settings": {
            "icon": "leaf",
            "text": "FSC-certified timber, recyclable packaging"
          }
        }
      },
      "block_order": [
        "p1",
        "p2",
        "p3",
        "p4"
      ],
      "settings": {
        "media_position": "right",
        "image_ratio": "4 / 5",
        "eyebrow": "Inside the build",
        "heading": "What you're actually paying for",
        "text": "<p>Strip the fabric off most beds at this price and you'll find chipboard. Ours start with kiln-dried hardwood, get upholstered by hand and are stress-tested to 200kg before they leave the workshop — which is why the guarantee runs to ten years, not two.</p>",
        "button_label": "Order 5 free swatches",
        "button_link": "/pages/swatches",
        "background_color": "#f7f3ec"
      }
    },
    "related": {
      "type": "product-recommendations",
      "settings": {
        "recommendation_type": "related",
        "layout_type": "grid",
        "carousel_on_mobile": true,
