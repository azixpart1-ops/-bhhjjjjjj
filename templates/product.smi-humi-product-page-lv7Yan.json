                "alignment": "left",
                "font": "var(--font-body--family)",
                "font_size": "1.5rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "padding-block-start": 4,
                "padding-block-end": 8,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "variant_picker": {
              "type": "variant-picker",
              "settings": {
                "variant_style": "buttons",
                "show_swatches": true,
                "variant_style_class": "default",
                "selected_variant_style_class": "default",
                "alignment": "left",
                "padding-block-start": 8,
                "padding-block-end": 8,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "urgency": {
              "type": "cc-product-trust",
              "settings": {
                "show_stock": true,
                "in_stock_text": "In stock — ready to dispatch",
                "low_stock_threshold": 6,
                "low_stock_text": "Only [count] left in this fabric",
                "backorder_text": "Made to order — reserve yours now",
                "show_delivery": true,
                "delivery_label": "Free delivery",
                "dispatch_min_days": 3,
                "dispatch_max_days": 6,
                "delivery_note": "Two-person, to your room, assembled",
                "trial_text": "",
                "guarantee_text": "",
                "returns_text": "",
                "show_payments": false,
                "payments_label": "Secure checkout",
                "padding-block-start": 0,
                "padding-block-end": 4
              }
            },
            "buy_buttons": {
              "type": "buy-buttons",
              "settings": {
                "stacking": true,
                "show_pickup_availability": true,
                "gift_card_form": true,
                "recipient_button_style": "default",
                "selected_recipient_button_style": "default",
                "input_style": "default",
                "border_width": 1,
                "border_radius": 0,
                "padding-block-start": 4,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {
                "add-to-cart": {
                  "type": "add-to-cart",
                  "static": true,
                  "settings": {
                    "style_class": "button"
                  }
                },
                "accelerated-checkout": {
                  "type": "accelerated-checkout",
                  "static": true,
                  "settings": {}
                }
              },
              "block_order": []
            },
            "reassurance": {
              "type": "cc-product-trust",
              "settings": {
                "show_stock": false,
                "in_stock_text": "In stock — ready to dispatch",
                "low_stock_threshold": 6,
                "low_stock_text": "Only [count] left in this fabric",
                "backorder_text": "Made to order — reserve yours now",
                "show_delivery": false,
                "delivery_label": "Free delivery",
                "dispatch_min_days": 3,
                "dispatch_max_days": 6,
                "delivery_note": "Two-person, to your room, assembled",
                "trial_text": "100-night comfort trial — we collect if it isn't right",
                "guarantee_text": "10-year guarantee on the frame and gas-lift mechanism",
                "returns_text": "Free returns collection, no restocking fee",
                "show_payments": true,
                "payments_label": "Secure checkout",
                "padding-block-start": 4,
                "padding-block-end": 0
              }
            },
            "accordion": {
              "type": "accordion",
              "settings": {
                "icon": "plus",
                "dividers": true,
                "type_preset": "paragraph",
                "border": "none",
                "border_width": 1,
                "border_opacity": 100,
                "border_radius": 0,
                "padding-block-start": 8,
                "padding-block-end": 8,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {
                "row_delivery": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Delivery & assembly",
                    "open_by_default": true,
                    "icon": "truck",
                    "width": 20
                  },
                  "blocks": {
                    "text": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Free two-person delivery to the room of your choice anywhere on the UK mainland. We assemble the bed where you want it and take every piece of packaging away with us.</p><p>You choose your delivery date at checkout and we text a two-hour window the evening before. Highlands, islands and Northern Ireland are quoted separately.</p>",
                        "type_preset": "rte",
                        "alignment": "left",
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0,
                        "max_width": "none",
                        "width": "100%",
                        "wrap": "pretty"
                      }
                    }
                  },
                  "block_order": [
                    "text"
                  ]
                },
                "row_specs": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Dimensions & materials",
                    "open_by_default": false,
                    "icon": "ruler",
                    "width": 20
                  },
                  "blocks": {
                    "text": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Kiln-dried hardwood frame, high-resilience foam padding and a slatted sprung base as standard. Fabrics are Martindale-rated to 40,000 rubs — sofa-grade, not curtain-grade.</p><p>Boxed dimensions for every component are listed below. Frames and headboards ship separately and assemble in the room, so tight stairs are rarely a problem.</p>",
                        "type_preset": "rte",
                        "alignment": "left",
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0,
                        "max_width": "none",
                        "width": "100%",
                        "wrap": "pretty"
                      }
                    }
                  },
                  "block_order": [
                    "text"
                  ]
                },
                "row_guarantee": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Guarantee & returns",
                    "open_by_default": false,
                    "icon": "return",
                    "width": 20
                  },
                  "blocks": {
                    "text": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Ten years on the frame and gas-lift mechanism; two years on fabric and stitching. If something fails in normal use we repair or replace it free of charge.</p><p>Sleep on it for 100 nights. If it isn't right we collect it and refund you in full — no restocking fee, and you don't need to have kept the box.</p>",
                        "type_preset": "rte",
                        "alignment": "left",
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0,
                        "max_width": "none",
                        "width": "100%",
                        "wrap": "pretty"
                      }
                    }
                  },
                  "block_order": [
                    "text"
                  ]
                }
              },
              "block_order": [
                "row_delivery",
                "row_specs",
                "row_guarantee"
              ]
            },
            "description": {
              "type": "product-description",
              "settings": {
                "width": "100%",
                "max_width": "none",
                "alignment": "left",
                "type_preset": "rte",
                "font": "var(--font-body--family)",
                "font_size": "",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "corner_radius": 0,
                "padding-block-start": 8,
                "padding-block-end": 8,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "complementary": {
              "type": "product-recommendations",
              "settings": {
                "recommendation_type": "complementary"
              },
              "blocks": {
                "recommendations-header": {
                  "type": "text",
                  "settings": {
                    "text": "<h3>Complete the bedroom</h3>",
                    "type_preset": "h5"
                  }
                }
              },
              "block_order": [
                "recommendations-header"
              ]
            }
          },
          "block_order": [
            "eyebrow",
            "title",
            "rating",
            "price",
            "variant_picker",
            "urgency",
            "buy_buttons",
            "reassurance",
            "accordion",
            "description",
            "complementary"
          ]
        }
