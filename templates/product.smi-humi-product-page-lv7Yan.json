    "reviews": {
      "type": "cc-testimonials",
      "blocks": {
        "r1": {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "headline": "Finally, storage that hides everything",
            "quote": "We swapped a divan for the ottoman and gained a whole wardrobe of space. The gas lift is effortless — I can open it one-handed with a duvet on top.",
            "author": "Hannah W.",
            "location": "Leeds",
            "verified": true
          }
        },
        "r2": {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "headline": "It looks like the photographs",
            "quote": "Ordered swatches first, which I'd recommend to anyone. The bouclé is exactly the shade shown and the frame feels genuinely solid — no creak, no wobble.",
            "author": "Marcus T.",
            "location": "Bristol",
            "verified": true
          }
        },
        "r3": {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "headline": "The delivery made the difference",
            "quote": "Two of their team carried it upstairs, built it where I wanted it and took every scrap of packaging. After a bad experience elsewhere, that alone will bring me back.",
            "author": "Priya S.",
            "location": "London",
            "verified": true
          }
        }
      },
      "block_order": [
        "r1",
        "r2",
        "r3"
      ],
      "settings": {
        "eyebrow": "Verified reviews",
        "heading": "What owners say a year on",
        "show_summary": true,
        "rating_value": 4.8,
        "summary_text": "4.8 out of 5 · 2,412 reviews",
        "summary_note": "96% would buy from us again",
        "background_color": "#fbf8f2"
      }
    },
    "faq": {
      "type": "cc-faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "When will it arrive?",
            "answer": "<p>In-stock beds arrive in 3–5 working days. Made-to-order upholstery takes 3–4 weeks — the lead time for this product is shown next to the add-to-basket button. You pick your delivery date at checkout.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Will it fit up my stairs?",
            "answer": "<p>Frames and headboards ship separately and assemble in the room, so tight landings and turns are rarely a problem. Boxed dimensions for every component are in the specification panel. If you're unsure, send us a photo of the stairwell and we'll check before you order.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Can I see the fabric first?",
            "answer": "<p>Yes — order up to five free swatches and we post them first class the same day. Most customers do this, then buy within a fortnight. It's the single best way to avoid a return.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "What if I change my mind?",
            "answer": "<p>You have 100 nights. If the bed isn't right we collect it and refund you in full — no restocking fee, and you don't need to have kept the original packaging.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Can I pay in instalments?",
            "answer": "<p>Klarna and Clearpay are available at checkout — three interest-free payments, with a soft credit check that won't affect your score.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5"
      ],
      "settings": {
        "eyebrow": "Still deciding?",
        "heading": "Questions about this bed",
        "align": "left",
        "open_first": false,
        "enable_schema": false,
        "footer_text": "Our bed specialists reply in under an hour, 9–6 daily.",
        "button_label": "Ask a question",
        "button_link": "/pages/contact",
        "background_color": "#f7f3ec"
      }
    },
    "guarantee": {
      "type": "cc-guarantee",
      "settings": {
        "icon": "moon",
        "eyebrow": "Risk-free",
        "heading": "Sleep on it for 100 nights",
        "text": "You can't judge a bed in a showroom. Live with yours for 100 nights — if it isn't right, we collect it and refund you in full. No restocking fee, and no need to have kept the box.",
        "button_label": "Read the promise",
        "button_link": "/pages/100-night-trial",
        "background_color": "#2f3d34"
      }
    }
