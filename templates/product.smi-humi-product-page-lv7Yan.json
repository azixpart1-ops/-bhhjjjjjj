                "alignment": "left",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "rating": {
              "type": "review",
              "settings": {
                "stars_style": "shaded",
