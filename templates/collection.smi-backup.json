      "block_order": [
        "p1",
        "p2",
        "p3"
      ],
      "settings": {
        "media_position": "left",
        "image_ratio": "4 / 3",
        "eyebrow": "Not sure where to start?",
        "heading": "How to choose, in about two minutes",
        "text": "<p>Measure the room before the bed: leave around 60cm to walk down each side and 90cm in front of wardrobe doors so they open fully. Then pick by what's missing — an ottoman if the room has no storage, a divan set if you need a mattress too, a base on its own if your current mattress is fine and the base underneath it isn't.</p>",
        "button_label": "See the size guide",
        "button_link": "/pages/faq",
        "background_color": "#f7f3ec"
      }
    },
    "faq": {
      "type": "cc-faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "What size do I need?",
            "answer": "<p>UK sizes are: small single 2ft6, single 3ft (90×190cm), small double 4ft, double 4ft6 (135×190cm), king 5ft (150×200cm) and super king 6ft (180×200cm). Leave around 60cm of walking space each side where the room allows, and 90cm in front of wardrobe doors so they open fully.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "How long will my bed take to arrive?",
            "answer": "<p>Express Dispatch beds are delivered within 1–3 working days of your order; everything else arrives within 1–4 working days. Working days are Monday to Friday, excluding bank holidays. The service for your item is shown at checkout, and we email tracking as soon as it's on its way.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "What does delivery cost?",
            "answer": "<p>Nothing, to any UK mainland address. There's no minimum spend and no delivery charge — the price you see is the price you pay. For Northern Ireland, the Scottish Highlands and UK islands, email us before ordering and we'll confirm your postcode and any additional cost, so there are no surprises afterwards.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "How is a bed actually delivered?",
            "answer": "<p>By a specialist large-item courier, to your front door. They'll contact you in advance with your delivery day, and someone over 18 needs to be in to receive it. Beds arrive flat-packed in protective packaging with clear assembly instructions and all fittings included.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Can I return it if it's not right?",
            "answer": "<p>Yes — you have 30 days from delivery. The item needs to be unused, in its original condition and original packaging, so keep the packaging until you're sure. We'll quote the collection cost before you confirm anything and deduct it from your refund, or you're welcome to arrange your own tracked courier. Refunds are issued within 14 days of the bed reaching us.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5"
      ],
      "settings": {
        "eyebrow": "Buying guide",
        "heading": "Sizes, delivery and returns",
        "align": "left",
        "open_first": true,
        "enable_schema": true,
        "footer_text": "Send us your room measurements on 07598 327268 and we'll tell you what fits.",
        "button_label": "Contact us",
        "button_link": "/pages/contact",
        "background_color": "#fbf8f2"
      }
    },
    "guarantee": {
      "type": "cc-guarantee",
      "settings": {
        "icon": "return",
        "eyebrow": "No small-print surprises",
        "heading": "30 days to change your mind",
        "text": "If the bed isn't right for the room, you have 30 days from delivery to tell us. We'll quote the collection cost before you commit to anything and refund you within 14 days of it reaching us. Anything damaged in transit is collected and replaced at our cost — just send photos within 48 hours.",
        "button_label": "Read the returns policy",
        "button_link": "/policies/refund-policy",
        "background_color": "#2f3d34"
      }
