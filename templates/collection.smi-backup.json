      "type": "cc-split-feature",
      "blocks": {
        "p1": {
          "type": "point",
          "settings": {
            "icon": "ruler",
            "text": "UK sizes from small single 2ft6 to super king 6ft"
          }
        },
        "p2": {
          "type": "point",
          "settings": {
            "icon": "moon",
            "text": "Ottoman, divan set or base only — pick by what the room needs"
          }
        },
        "p3": {
          "type": "point",
          "settings": {
            "icon": "check-circle",
            "text": "Every listing states exactly what's in the box"
