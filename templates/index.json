    "guarantee": {
      "type": "cc-guarantee",
      "settings": {
        "icon": "moon",
        "eyebrow": "Risk-free",
        "heading": "Sleep on it for 100 nights",
        "text": "A bed is not something you can judge in a showroom. Live with yours for 100 nights — if it isn't right, we collect it and refund you in full. No restocking fee, and no need to have kept the box.",
        "button_label": "Read the promise",
        "button_link": "/pages/100-night-trial",
        "background_color": "#2f3d34"
      }
    },
    "faq": {
      "type": "cc-faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "How long does delivery take, and what does it include?",
            "answer": "<p>In-stock beds arrive in 3–5 working days. Made-to-order upholstery takes 3–4 weeks, and the lead time is shown on every product page before you buy. Delivery is two-person, to the room of your choice, with assembly and packaging removal included at no extra cost.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Can I see the fabric before I commit?",
            "answer": "<p>Yes — order up to five free swatches and we post them first class the same day. Most customers order swatches, then buy within a fortnight. It is the single best way to avoid a return.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "What if it doesn't work in the room?",
            "answer": "<p>You have 100 nights to decide. If the bed isn't right we collect it and refund you in full — no restocking fee, and you don't need to have kept the original packaging.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Will it fit up my stairs?",
            "answer": "<p>Every product page lists the boxed dimensions of each component. Frames and headboards ship separately and assemble in the room, so tight landings and turns are rarely a problem. If you're unsure, send us a photo of the stairwell and we'll check before you order.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Can I spread the cost?",
            "answer": "<p>Klarna and Clearpay are available at checkout — pay in three interest-free instalments. The eligibility check is a soft search, so it won't affect your credit score.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "What does the guarantee actually cover?",
            "answer": "<p>Ten years on the frame and the gas-lift mechanism, two years on fabric and stitching. If a strut fails or a joint gives way in normal use, we repair or replace it free of charge.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5",
        "q6"
