                "show_delivery": false,
                "delivery_label": "Free UK mainland delivery",
                "dispatch_min_days": 1,
                "dispatch_max_days": 4,
                "delivery_note": "Tracked courier to your front door",
                "trial_text": "Easy 30-day returns — unused and in its original packaging",
                "guarantee_text": "Damaged in transit? Send photos within 48 hours and we replace it free",
                "returns_text": "Cancel free any time before dispatch",
