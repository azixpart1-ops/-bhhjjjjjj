      "settings": {
        "media_position": "left",
        "image_ratio": "4 / 3",
        "eyebrow": "Not sure where to start?",
        "heading": "How to choose, in about two minutes",
        "text": "<p>Measure the room first, not the bed: leave 60cm to walk down each side and 90cm in front of a wardrobe. Then pick storage if the room has none, and a taller headboard if the wall behind is bare. Order swatches before you commit — it is the single biggest reason our returns are low.</p>",
        "button_label": "Order 5 free swatches",
        "button_link": "/pages/swatches",
        "background_color": "#f7f3ec"
      }
    },
    "faq": {
      "type": "cc-faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "What size do I actually need?",
            "answer": "<p>UK sizes: single 90×190cm, double 135×190cm, king 150×200cm, super king 180×200cm. Leave 60cm of walking space each side where you can, and 90cm in front of wardrobe doors so they open fully.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Is the mattress included?",
            "answer": "<p>Only where the product title says 'set'. Frames and divan bases are sold without a mattress so you can match your own — every product page lists the mattress size it takes.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "How long will delivery take?",
            "answer": "<p>In-stock beds arrive in 3–5 working days. Made-to-order upholstery takes 3–4 weeks. The lead time is shown on each product page before you buy.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Do you take the old bed away?",
            "answer": "<p>Yes — add old-bed removal at checkout and our delivery team will take your existing frame and mattress for recycling on the same visit.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4"
      ],
