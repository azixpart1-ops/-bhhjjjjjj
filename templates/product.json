                    "note": {
                      "type": "text",
                      "settings": {
                        "text": "<p><strong>A mattress is included only where the product title says so.</strong> Everything arrives flat-packed with all fittings and clear assembly instructions.</p>",
                        "type_preset": "rte",
                        "alignment": "left",
                        "width": "100%",
                        "max_width": "none",
                        "wrap": "pretty",
                        "padding-block-start": 0,
