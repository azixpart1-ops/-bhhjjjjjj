{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title",
          "settings": {
            "heading_size": "h2",
            "show_badges": true,
            "trim_title": true
          }
        },
        "rating": {
          "type": "rating",
          "settings": {
            "show_count": true,
            "link_to_reviews": true
          }
        },
        "tagline": {
          "type": "tagline",
          "settings": {
            "text": "Pressure-relieving support for ageing joints, under a cover you can actually wash.",
            "style": "serif"
          }
        },
        "price": {
          "type": "price",
          "settings": {
            "show_per_night": true,
            "show_installments": true,
            "show_tax_note": false
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "show_size_hints": true,
            "show_size_prices": true,
            "show_size_guide_link": false,
            "size_style": "rows"
          }
        },
        "size_guide": {
          "type": "size_guide",
          "settings": {
            "teaser": "Between sizes? Measure nose to base of tail and add about 20cm.",
            "label": "Open the size guide",
            "guide_heading": "Find the right size",
            "measure_text": "<ol><li>Wait until they're asleep and stretched out.</li><li>Measure from nose to the base of the tail.</li><li>Add about 20cm. That's the length of bed they need.</li></ol><p>Between two sizes? Size up. Dogs need more length than owners expect, and no dog has ever complained about too much bed.</p>"
          }
        },
        "finder_prompt": {
          "type": "finder_prompt",
          "settings": {
            "heading": "Not sure which size?",
            "cta_label": "Take the 30-second bed finder"
          }
        },
        "stock": {
          "type": "stock",
          "settings": {
            "show_in_stock": true,
            "in_stock_text": "In stock, ready to dispatch"
          }
        },
        "delivery": {
          "type": "delivery",
          "settings": {
            "show_free_delivery_note": true
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_quantity": false,
            "show_price_in_button": true,
            "show_dynamic_checkout": true,
            "show_payment_terms": true
          }
        },
        "risk_reversal": {
          "type": "risk_reversal",
          "settings": {
            "heading": "Sleep on it for [trial_nights] nights.",
            "text": "If it isn't right, we collect it free and refund every penny.",
            "link_label": "Read our returns policy",
            "show_guarantee": true
          }
        },
        "trust": {
          "type": "trust",
          "settings": {
            "items": "secure,installments,origin",
            "show_payment_icons": true
          }
        },
        "benefits": {
          "type": "benefits",
          "settings": {
            "heading": "",
            "content": "<ul><li>High-density memory foam that holds its shape</li><li>Cover unzips and machine-washes at 30°C</li><li>Waterproof liner keeps accidents out of the foam</li><li>Gripped base stays put on wood and tile</li></ul>"
          }
        },
        "about": {
          "type": "accordion",
          "settings": {
            "heading": "About this bed",
            "source": "description",
            "content": "",
            "icon": "bed",
            "open": false
          }
        },
        "specs": {
          "type": "accordion",
          "settings": {
            "heading": "Specification",
            "source": "specs",
            "content": "",
            "icon": "ruler",
            "open": false
          }
        },
        "delivery_returns": {
          "type": "accordion",
          "settings": {
            "heading": "Delivery and returns",
            "source": "delivery",
            "content": "",
            "icon": "truck",
            "open": false
          }
        },
        "care": {
          "type": "accordion",
          "settings": {
            "heading": "Care and washing",
            "source": "care",
            "content": "<p>The cover unzips completely and machine-washes at 30°C. On our waterproof-lined beds a sealed liner sits under the cover, so wet coats, muddy paws and accidents never reach the foam core. You wash the cover; you never have to wash the bed.</p>",
            "icon": "leaf",
            "open": false
          }
        }
