      "type": "product-timeline",
      "blocks": {
        "order": {
          "type": "step",
          "settings": {
            "icon": "basket",
            "title": "Order today",
            "text": "<p>Pick a size and check out in a couple of minutes. No account needed.</p>",
            "requires": "none"
          }
        },
        "dispatch": {
          "type": "step",
          "settings": {
            "icon": "truck",
            "title": "Dispatched [dispatch_day]",
            "text": "<p>Order by [cutoff], [dispatch_days], and it leaves [dispatch_from] the same day. You get tracking as soon as it's on its way.</p>",
            "requires": "delivery"
          }
        },
        "arrives": {
          "type": "step",
          "settings": {
            "icon": "home",
            "title": "Arrives [arrival]",
            "text": "<p>Delivered to your door. Put it where they already like to sleep and let them find it.</p>",
            "requires": "delivery"
          }
        },
        "trial": {
          "type": "step",
          "settings": {
            "icon": "moon",
            "title": "[trial_nights] nights to decide",
            "text": "<p>Most dogs claim a new bed within the first evening. Some take a fortnight. Both are normal. If it isn't right, we collect it free and refund every penny.</p>",
            "requires": "trial"
          }
        }
      },
