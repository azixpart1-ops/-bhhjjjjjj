{%- comment -%}
  Small pill label.

  Parameters
    text    label text (required; nothing renders when blank)
    style   'accent' | 'sale' | 'muted' | 'match' | blank (neutral)
    icon    optional icon name from the icon snippet
    class   extra classes
    attrs   raw extra attributes (e.g. 'data-finder-match-badge hidden')

  Note: "accent" here is the deep moss "featured" style, not the terracotta
  CTA colour — terracotta is reserved for buying actions.
{%- endcomment -%}
{%- liquid
  assign badge_text = text | default: '' | strip
  assign badge_style = style | default: ''
-%}
{%- if badge_text != '' -%}
  <span class="badge{% if badge_style != '' %} badge--{{ badge_style }}{% endif %}{% if class %} {{ class }}{% endif %}"{% if attrs %} {{ attrs }}{% endif %}>
    {%- if icon -%}{%- render 'icon', name: icon -%}{%- endif -%}
    <span>{{ badge_text | escape }}</span>
  </span>
{%- endif -%}
