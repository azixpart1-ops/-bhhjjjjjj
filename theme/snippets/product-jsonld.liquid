{%- comment -%}
  Structured data for the product page: Product (one Offer per variant) and
  BreadcrumbList. Everything is read from Shopify data or theme settings —
  nothing is asserted that the store doesn't already say.

    - aggregateRating ONLY when a reviews app has written reviews.rating and
      reviews.rating_count (> 0) to the product.
    - gtin from the variant barcode when it is 8, 12, 13 or 14 digits.
    - hasMerchantReturnPolicy from the trial settings when the trial is
      switched on AND covers this product (snippets/trial-eligible):
      FreeReturn only while "We collect returns free" (trial_free_collection)
      is ticked, else the customer pays the return. A product the trial
      doesn't cover (kennels, personalised beds) gets no trial policy: only
      a return window of its own from the custom.return_days metafield
      (customer pays the return), else none at all.
    - shippingDetails only on offers that qualify for free delivery (the one
      shipping rate the theme actually knows), with the handling/transit
      windows from the delivery settings.

  Parameters
    product   required
    variant   optional; the selected variant (its offer comes first in url)
{%- endcomment -%}
{%- if product != blank and product.id != blank -%}
  {%- liquid
    assign currency = cart.currency.iso_code | default: shop.currency
    assign base_url = request.origin | append: product.url
    assign title = product.title | split: ' | ' | first | strip
    assign description = product.description | strip_html | strip_newlines | strip | truncate: 5000, ''
    if description == ''
      assign description = product.metafields.custom.tagline.value | default: title
    endif

    assign threshold_cents = 0
    if settings.free_shipping_enable and settings.free_shipping_threshold > 0
      assign threshold_cents = settings.free_shipping_threshold | times: 100 | round
    endif
    assign d_min = settings.delivery_min_days | default: 0 | plus: 0
    assign d_max = settings.delivery_max_days | default: 0 | plus: 0
    if d_max < d_min
      assign d_max = d_min
    endif
    assign nights = settings.trial_nights | default: 0 | plus: 0
    assign rp_days = 0
    assign rp_free = false
    if settings.trial_enable and nights > 0
      capture rp_trial
        render 'trial-eligible', product: product
      endcapture
      if rp_trial == 'true'
        assign rp_days = nights
        assign rp_free = settings.trial_free_collection
      endif
    endif
    if rp_days == 0
      assign rp_days = product.metafields.custom.return_days.value | default: 0 | plus: 0 | round
    endif

    assign image_urls = ''
    for m in product.media limit: 8
      if m.preview_image
        assign m_url = m.preview_image | image_url: width: 1600
        assign first2 = m_url | slice: 0, 2
        if first2 == '//'
          assign m_url = m_url | prepend: 'https:'
        endif
        assign image_urls = image_urls | append: m_url | append: '<<>>'
      endif
    endfor
    assign image_list = image_urls | split: '<<>>'

    assign rating_value = product.metafields.reviews.rating.value
    assign rating_count = product.metafields.reviews.rating_count.value | default: 0 | plus: 0
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Product",
          "@id": {{ base_url | append: '#product' | json }},
          "name": {{ title | json }},
          "url": {{ base_url | json }},
          "description": {{ description | json }},
          {%- if image_list.size > 0 -%}
          "image": {{ image_list | json }},
          {%- endif -%}
          {%- if product.vendor != blank -%}
          "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
          {%- endif -%}
          {%- if product.selected_or_first_available_variant.sku != blank -%}
          "sku": {{ product.selected_or_first_available_variant.sku | json }},
          {%- endif -%}
          {%- if product.type != blank -%}
          "category": {{ product.type | json }},
          {%- endif -%}
          {%- if rating_value != blank and rating_count > 0 and settings.show_product_ratings -%}
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": {{ rating_value.rating | json }},
            "bestRating": {{ rating_value.scale_max | default: 5 | json }},
            "worstRating": {{ rating_value.scale_min | default: 1 | json }},
            "ratingCount": {{ rating_count | json }}
          },
          {%- endif -%}
          "offers": [
            {%- for v in product.variants -%}
              {%- liquid
                assign v_url = base_url | append: '?variant=' | append: v.id
                assign p_whole = v.price | divided_by: 100
                assign p_frac = v.price | modulo: 100
                if p_frac < 10
                  assign p_frac = '0' | append: p_frac
                endif
                assign price_str = p_whole | append: '.' | append: p_frac
                if v.available
                  if v.inventory_management == 'shopify' and v.inventory_policy == 'continue' and v.inventory_quantity <= 0
                    assign availability = 'https://schema.org/BackOrder'
                  else
                    assign availability = 'https://schema.org/InStock'
                  endif
                else
                  assign availability = 'https://schema.org/OutOfStock'
                endif
                assign barcode = v.barcode | default: '' | strip | remove: ' ' | remove: '-'
                assign barcode_digits = barcode | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
                assign gtin_key = ''
                if barcode != '' and barcode_digits == ''
                  case barcode.size
                    when 8
                      assign gtin_key = 'gtin8'
                    when 12
                      assign gtin_key = 'gtin12'
                    when 13
                      assign gtin_key = 'gtin13'
                    when 14
                      assign gtin_key = 'gtin14'
                  endcase
                endif
              -%}
              {
                "@type": "Offer",
                "url": {{ v_url | json }},
                "name": {{ v.title | json }},
                "price": {{ price_str | json }},
                "priceCurrency": {{ currency | json }},
                "availability": {{ availability | json }},
                "itemCondition": "https://schema.org/NewCondition",
                {%- if v.sku != blank -%}
                "sku": {{ v.sku | json }},
                {%- endif -%}
                {%- if gtin_key != '' -%}
                {{ gtin_key | json }}: {{ barcode | json }},
                {%- endif -%}
                {%- if threshold_cents > 0 and v.price >= threshold_cents and settings.delivery_promise_enable and d_max > 0 -%}
                "shippingDetails": {
                  "@type": "OfferShippingDetails",
                  "shippingRate": { "@type": "MonetaryAmount", "value": "0", "currency": {{ currency | json }} },
                  "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "GB" },
                  "deliveryTime": {
                    "@type": "ShippingDeliveryTime",
                    "handlingTime": { "@type": "QuantitativeValue", "minValue": 0, "maxValue": 1, "unitCode": "DAY" },
                    "transitTime": { "@type": "QuantitativeValue", "minValue": {{ d_min }}, "maxValue": {{ d_max }}, "unitCode": "DAY" }
                  }
                },
                {%- endif -%}
                {%- if rp_days > 0 -%}
                "hasMerchantReturnPolicy": {
                  "@type": "MerchantReturnPolicy",
                  "applicableCountry": "GB",
                  "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
                  "merchantReturnDays": {{ rp_days }},
                  "returnMethod": "https://schema.org/ReturnByMail",
                  "returnFees": "https://schema.org/{% if rp_free %}FreeReturn{% else %}ReturnFeesCustomerResponsibility{% endif %}"
                },
                {%- endif -%}
                "seller": { "@type": "Organization", "name": {{ shop.name | json }} }
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": {{ shop.name | json }},
              "item": {{ request.origin | append: routes.root_url | json }}
            },
            {%- comment -%}
              Home / Dog Beds / {category} / {product}, the same trail as
              sections/product-breadcrumbs: the category comes from the product
              type (snippets/product-parent-handle), not from the collection the
              shopper arrived through, so every product has one stable trail.
            {%- endcomment -%}
            {%- capture pl_parent_handle -%}{%- render 'product-parent-handle', product: product -%}{%- endcapture -%}
            {%- assign pl_parent_handle = pl_parent_handle | strip -%}
            {%- assign pl_parent = collections[pl_parent_handle] -%}
            {%- assign pl_hub = collections['dog-beds'] -%}
            {%- assign pl_pos = 1 -%}
            {%- if product.type contains 'Dog Beds' and pl_hub.url != blank -%}
            {%- assign pl_pos = pl_pos | plus: 1 -%}
            {
              "@type": "ListItem",
              "position": {{ pl_pos }},
              "name": {{ pl_hub.title | split: ' | ' | first | strip | json }},
              "item": {{ request.origin | append: pl_hub.url | json }}
            },
            {%- endif -%}
            {%- if pl_parent_handle != '' and pl_parent.url != blank -%}
            {%- assign pl_pos = pl_pos | plus: 1 -%}
            {
              "@type": "ListItem",
              "position": {{ pl_pos }},
              "name": {{ pl_parent.title | split: ' | ' | first | strip | json }},
              "item": {{ request.origin | append: pl_parent.url | json }}
            },
            {%- endif -%}
            {%- assign pl_pos = pl_pos | plus: 1 -%}
            {
              "@type": "ListItem",
              "position": {{ pl_pos }},
              "name": {{ title | json }},
              "item": {{ base_url | json }}
            }
          ]
        }
      ]
    }
  </script>
{%- endif -%}
