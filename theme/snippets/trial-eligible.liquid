{%- comment -%}
  The one "does the sleep trial cover this?" test. Every per-product trial
  line (buy box, cards, finder result, cart lines, trust rows) asks it, so a
  product the trial doesn't cover never carries the promise.

  A product is covered when the trial is on (trial_enable, trial_nights > 0)
  and it is not excluded. Excluded:
    - tag "trial:no"; or
    - its product type contains a line of settings.trial_excluded, or one of
      its tags equals a line (case-insensitive). Default list:
        Dog Houses      ("Dog Houses > Outdoor Kennels", "… > Outdoor Day Beds")
        Personalised    ("Dog Beds > Personalised Dog Beds": made to order)
        Dog car seat    (tag on the Whinlatter car seat)
  Tag "trial:yes" includes a product whatever the list says; "trial:no" wins
  over "trial:yes".

  Parameters
    product   a product (or a line item's product). On a product page the
              global product is used when you pass none.
    basket    the cart, instead of product: covered when ANY line's product
              is covered (named basket because cart is a global and would
              always be set)
    every     with basket: true → only when EVERY line's product is covered
  With neither (and no global product), the answer is just whether the
  trial is switched on.

  Output: the word "true" when covered, nothing otherwise. Capture it:
    {%- capture trial_ok -%}{%- render 'trial-eligible', product: product -%}{%- endcapture -%}
    {%- if trial_ok == 'true' -%} … {%- endif -%}
    {%- capture basket_trial -%}{%- render 'trial-eligible', basket: cart -%}{%- endcapture -%}

  Keep in step with Lunova.trialEligible() in assets/global.js.
{%- endcomment -%}
{%- liquid
  assign te_nights = settings.trial_nights | default: 0 | plus: 0
  assign te_on = false
  if settings.trial_enable and te_nights > 0
    assign te_on = true
  endif

  assign te_lines = settings.trial_excluded | default: '' | downcase | newline_to_br | split: '<br />'

  comment
    An empty array is truthy in Liquid, so an empty basket still counts as a basket.
  endcomment
  assign te_is_cart = false
  if basket.items
    assign te_is_cart = true
  endif

  assign te_count = 0
  if te_on
    if te_is_cart
      assign te_count = basket.items.size
    elsif product != blank
      assign te_count = 1
    endif
  endif

  assign te_any = false
  assign te_all = true
  if te_on and te_is_cart == false and product == blank
    assign te_any = true
  endif

  if te_count > 0
    for n in (1..te_count)
      if te_is_cart
        assign te_index = n | minus: 1
        assign te_p = basket.items[te_index].product
      else
        assign te_p = product
      endif
      if te_p == blank
        assign te_all = false
        continue
      endif

      assign te_tags = te_p.tags | join: '|' | downcase | prepend: '|' | append: '|'
      assign te_type = te_p.type | default: '' | downcase
      assign te_ok = true
      for te_line in te_lines
        assign te_l = te_line | strip
        if te_l == ''
          continue
        endif
        assign te_tag_key = '|' | append: te_l | append: '|'
        if te_type contains te_l or te_tags contains te_tag_key
          assign te_ok = false
          break
        endif
      endfor
      if te_tags contains '|trial:yes|'
        assign te_ok = true
      endif
      if te_tags contains '|trial:no|'
        assign te_ok = false
      endif

      if te_ok
        assign te_any = true
      else
        assign te_all = false
      endif
    endfor
  endif

  if te_count == 0
    assign te_all = false
  endif

  if every and te_is_cart
    if te_any and te_all
      echo 'true'
    endif
  elsif te_any
    echo 'true'
  endif
-%}
