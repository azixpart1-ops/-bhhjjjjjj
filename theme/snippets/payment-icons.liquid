{%- comment -%}
  The payment methods actually enabled on the store (Settings → Payments),
  as Shopify's own SVG marks. Shown near Checkout / Add to basket to settle
  the "can I pay the way I want?" question before it's asked.

  Parameters
    class   extra classes on the list
    limit   max icons to show (default: all)
{%- endcomment -%}
{%- assign types = shop.enabled_payment_types -%}
{%- if types.size > 0 -%}
  {%- assign max = limit | default: 50 | plus: 0 -%}
  <ul class="payment-icons{% if class %} {{ class }}{% endif %}" role="list" aria-label="{{ 'accessibility.payment_methods' | t }}">
    {%- for type in types limit: max -%}
      <li class="payment-icons__item">{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
    {%- endfor -%}
  </ul>
{%- endif -%}
