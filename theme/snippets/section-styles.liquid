{%- comment -%}
  Per-section vertical spacing from the standard padding_top / padding_bottom
  settings (range 0–120). Sets custom properties on the section's Shopify
  wrapper; base.css `.section` reads them:
    padding-block: var(--section-pt, 56px) var(--section-pb, 56px)

  Phones get 70% of the desktop value (rounded), capped at 48px (the loose
  tier), so long pages don't feel stretched on a small screen and the hero's
  first screen keeps its call to action in view.

  Usage: {% render 'section-styles', section: section %}
{%- endcomment -%}
{%- liquid
  assign pt = section.settings.padding_top | default: 56 | plus: 0
  assign pb = section.settings.padding_bottom | default: 56 | plus: 0
  assign pt_m = pt | times: 0.7 | round | at_most: 48
  assign pb_m = pb | times: 0.7 | round | at_most: 48
-%}
<style>
  #shopify-section-{{ section.id }} { --section-pt: {{ pt_m }}px; --section-pb: {{ pb_m }}px; }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} { --section-pt: {{ pt }}px; --section-pb: {{ pb }}px; }
  }
</style>
