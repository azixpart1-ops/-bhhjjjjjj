{%- comment -%}
  Sticky add-to-basket bar — <sticky-atc>.

  Shown whenever the main Add to basket button is out of view: below the
  fold at first paint (size already chosen, so one tap adds) and after it
  has scrolled up past the top. It steps aside while the main button is on
  screen and near the footer, and never shows below the fold for a sold-out
  or unavailable variant. Shows what you're about to buy (photo,
  name, chosen size, price) so tapping Add here is never a surprise; the
  button submits the main product form, so quantity, errors and the basket
  drawer behave exactly as they do up the page. Full-width bottom bar on
  phones with safe-area padding; inert and hidden from assistive tech while
  it is off screen.

  Parameters
    product   required
    section   required
    variant   selected variant
{%- endcomment -%}
{%- if product != blank and product.id != blank -%}
  {%- liquid
    assign current = variant | default: product.selected_or_first_available_variant
    assign thumb = current.featured_media.preview_image | default: product.featured_media.preview_image
    assign display_title = product.title | split: ' | ' | first
    if current.available
      assign btn_label = 'product.buy.add' | t
    else
      assign btn_label = 'product.buy.sold_out' | t
    endif

    comment
      What is being bought, short: the size by its name, so Large rather
      than Large · 91 × 69 × 24cm, and other options as the picker shows
      them: Large / Dark Grey. product.js keeps it in step.
    endcomment
    assign sa_size_idx = -1
    for option in product.options_with_values
      assign sa_on = option.name | downcase
      if sa_on contains 'size'
        assign sa_size_idx = forloop.index0
        break
      endif
    endfor
    assign sa_title = ''
    for o in current.options
      if forloop.index0 == sa_size_idx
        capture sa_part
          render 'size-hints', value: o, mode: 'size_label'
        endcapture
        assign sa_part = sa_part | strip | default: o | escape
      else
        assign sa_part = o | escape
      endif
      assign sa_lc = sa_part | downcase
      if sa_lc == sa_part
        assign sa_part = sa_part | capitalize
      endif
      if sa_title != ''
        assign sa_title = sa_title | append: ' / '
      endif
      assign sa_title = sa_title | append: sa_part
    endfor
  -%}
  <sticky-atc
    class="sticky-atc scheme-{{ section.settings.color_scheme | default: 'bone' }}"
    data-section-id="{{ section.id }}"
    role="region"
    aria-label="{{ 'product.sticky.label' | t }}"
    aria-hidden="true"
    inert
  >
    <div class="sticky-atc__inner page-width">
      <div class="sticky-atc__media" aria-hidden="true">
        {%- if thumb -%}
          <img
            src="{{ thumb | image_url: width: 160 }}"
            alt=""
            width="80"
            height="80"
            loading="lazy"
            class="sticky-atc__img"
            data-sticky-image
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg sticky-atc__img' }}
        {%- endif -%}
      </div>
      <div class="sticky-atc__info">
        <p class="sticky-atc__title">{{ display_title | escape }}</p>
        <p class="sticky-atc__meta">
          {%- unless product.has_only_default_variant -%}
            <span class="sticky-atc__variant" data-sticky-variant>{{ sa_title }}</span>
            <span class="sticky-atc__sep" aria-hidden="true">·</span>
          {%- endunless -%}
          <span class="sticky-atc__price" data-sticky-price>{{ current.price | money }}</span>
          {%- if current.compare_at_price > current.price and settings.show_compare_savings -%}
            <s class="sticky-atc__compare" data-sticky-compare>{{ current.compare_at_price | money }}</s>
          {%- else -%}
            <s class="sticky-atc__compare" data-sticky-compare hidden></s>
          {%- endif -%}
        </p>
      </div>
      <button
        type="button"
        class="btn btn--primary sticky-atc__btn"
        data-sticky-add
        {%- unless current.available %} disabled{% endunless %}
      >
        <span data-sticky-label>{{ btn_label }}</span>
      </button>
    </div>
    <p class="sticky-atc__error page-width" data-sticky-error role="alert" hidden></p>
  </sticky-atc>
{%- endif -%}
