{%- comment -%}
  Size guide — a native <dialog> (bottom sheet on phones) built from THIS
  product's size option values, in size order (XS → 3XL), so it always
  lines up with the sizes actually on sale.

  Each value is parsed by snippets/size-hints (mode parse):
    "Large · 91 × 69 × 24cm"            Size "Large", Dimensions "91 × 69 × 24cm"
    "Small: Pug | French Bulldog"        Size "Small", Typically suits "Pug, French Bulldog"
  A size variant's custom.size_hint metafield fills "Typically suits" when
  the value carries no breeds. The store-wide breed/weight table (Theme
  settings → Sizing) is only used with hints: true (the variant picker's
  "Fill in breeds and weights" setting), and never for a value that already
  carries its own dimensions or breeds: one table can't be right for beds
  whose "Large" means different dogs. Columns with nothing in them are left
  out.

  Opened by any [data-size-guide-open] button in the same product scope
  (variant picker's "Size guide" link, the size_guide block). Each row has a
  "Choose" button that selects that size in the picker and closes the guide.

  Parameters
    product   required
    section   required (ids are scoped to section.id)
    variant   the selected variant (marks its row "Selected")
    block     optional main-product size_guide block — its heading / measuring
              tip override the defaults
    compact   true inside the quick-add drawer
    hints     true → fill breeds/weights from Theme settings → Sizing for
              values with no detail of their own (default false)
{%- endcomment -%}
{%- if product != blank and product.id != blank -%}
  {%- liquid
    assign current = variant | default: product.selected_or_first_available_variant
    assign size_idx = -1
    assign size_option = nil
    for option in product.options_with_values
      assign oname = option.name | downcase
      if oname contains 'size'
        assign size_idx = forloop.index0
        assign size_option = option
        break
      endif
    endfor

    assign dlg_id = 'SizeGuide-' | append: section.id
    if compact
      assign dlg_id = dlg_id | append: '-c'
    endif

    assign heading = block.settings.guide_heading | default: ''
    if heading == ''
      assign heading = 'product.size_guide.title' | t
    endif
    assign measure_html = block.settings.measure_text | default: ''
    if measure_html == ''
      assign measure_html = 'product.size_guide.measure_html' | t
    endif

    comment
      The trial line only for a product the sleep trial covers.
    endcomment
    assign nights = settings.trial_nights | default: 0 | plus: 0
    assign sg_trial_ok = false
    if settings.trial_enable and nights > 0
      capture sg_trial
        render 'trial-eligible', product: product
      endcapture
      if sg_trial == 'true'
        assign sg_trial_ok = true
      endif
    endif
    assign current_size = ''
    if size_idx >= 0
      assign current_size = current.options[size_idx]
    endif

    comment
      Show the price column only when sizes are priced differently.
    endcomment
    assign show_price = product.price_varies
    assign display_title = product.title | split: ' | ' | first

    comment
      One pass over the sizes: parse each value, collect its row data and a
      sort key (rank, then position) so the rows run smallest to largest
      when every value has a size rank. Rows: value~label~dims~suits~weight.
    endcomment
    assign rows = ''
    assign sort_keys = ''
    assign all_ranked = true
    assign has_dims = false
    assign has_fit = false
    assign has_suits = false
    assign has_weight = false
    if size_idx >= 0
      for value in size_option.values
        assign val = value.name | default: value | append: ''
        capture parsed
          render 'size-hints', value: val, mode: 'parse'
        endcapture
        assign pp = parsed | split: '|'
        assign p_rank = pp[0] | default: 0 | plus: 0
        assign p_label = pp[2] | default: val | strip
        assign p_detail = pp[3] | default: '' | strip
        assign lbl_lc = p_label | downcase
        if lbl_lc == p_label
          assign p_label = p_label | capitalize
        endif
        if p_rank < 1
          assign all_ranked = false
        endif

        comment
          Detail with a digit in it is a measurement; otherwise it names
          the dogs the size suits.
        endcomment
        assign s_dims = ''
        assign s_suits = ''
        assign s_weight = ''
        if p_detail != ''
          assign d_digits = p_detail | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
          if d_digits != p_detail
            assign s_dims = p_detail
          else
            assign s_suits = p_detail
          endif
        endif
        if s_suits == ''
          for v in product.variants
            if v.options[size_idx] == val
              assign mf_hint = v.metafields.custom.size_hint.value | default: '' | strip
              if mf_hint != ''
                assign s_suits = mf_hint
                break
              endif
            endif
          endfor
        endif
        if s_suits == '' and p_detail == '' and hints
          capture s_suits
            render 'size-hints', value: val, mode: 'breeds', breeds: 0
          endcapture
          capture s_weight
            render 'size-hints', value: val, mode: 'weight'
          endcapture
          assign s_suits = s_suits | strip
          assign s_weight = s_weight | strip
        endif
        comment
          Fits dogs up to: the bed length less the measuring rule's
          allowance (Theme settings → Sizing), for sizes with measurements.
        endcomment
        assign s_fit = ''
        assign sg_allow = settings.size_fit_allowance | default: 0 | plus: 0
        if s_dims != '' and sg_allow > 0
          capture sg_len
            render 'size-hints', value: val, mode: 'length'
          endcapture
          assign sg_len = sg_len | strip | plus: 0
          if sg_len > 0
            assign sg_fit = sg_len | minus: sg_allow
            if sg_fit >= 20
              assign s_fit = '~' | append: sg_fit | append: 'cm'
              assign has_fit = true
            endif
          endif
        endif
        if s_dims != ''
          assign has_dims = true
        endif
        if s_suits != ''
          assign has_suits = true
        endif
        if s_weight != ''
          assign has_weight = true
        endif
        assign row = val | append: '~~' | append: p_label | append: '~~' | append: s_dims | append: '~~' | append: s_suits | append: '~~' | append: s_weight | append: '~~' | append: s_fit
        assign rows = rows | append: row | append: '^^'
        assign pos = forloop.index0 | plus: 100
        assign sk = p_rank | plus: 100 | append: '-' | append: pos
        assign sort_keys = sort_keys | append: sk | append: ','
      endfor
    endif
    assign row_list = rows | split: '^^'
    if all_ranked
      assign order_keys = sort_keys | split: ',' | sort
    else
      assign order_keys = sort_keys | split: ','
    endif
  -%}
  <dialog
    class="modal modal--sheet size-guide"
    id="{{ dlg_id }}"
    data-size-guide
    aria-labelledby="{{ dlg_id }}-title"
    style="--modal-width: 760px"
  >
    <div class="modal__header size-guide__header">
      <h2 class="h3 size-guide__title" id="{{ dlg_id }}-title">{{ heading | escape }}</h2>
      <button type="button" class="btn btn--icon size-guide__close" data-dialog-close aria-label="{{ 'product.size_guide.close' | t }}">
        {%- render 'icon', name: 'close' -%}
      </button>
    </div>
    <div class="modal__body size-guide__body">
      {%- if size_idx >= 0 -%}
        <table class="size-guide__table" role="table">
          <caption class="visually-hidden">{{ 'product.size_guide.caption' | t: title: display_title }}</caption>
          <thead role="rowgroup">
            <tr role="row">
              <th scope="col" role="columnheader">{{ 'product.size_guide.col_size' | t }}</th>
              {%- if has_dims -%}
                <th scope="col" role="columnheader">{{ 'product.size_guide.col_dims' | t }}</th>
              {%- endif -%}
              {%- if has_fit -%}
                <th scope="col" role="columnheader">{{ 'product.size_guide.fit_heading' | t }}</th>
              {%- endif -%}
              {%- if has_suits -%}
                <th scope="col" role="columnheader">{{ 'product.size_guide.col_breeds' | t }}</th>
              {%- endif -%}
              {%- if has_weight -%}
                <th scope="col" role="columnheader">{{ 'product.size_guide.col_weight' | t }}</th>
              {%- endif -%}
              {%- if show_price -%}
                <th scope="col" role="columnheader">{{ 'product.size_guide.col_price' | t }}</th>
              {%- endif -%}
              <th scope="col" role="columnheader"><span class="visually-hidden">{{ 'product.size_guide.choose' | t }}</span></th>
            </tr>
          </thead>
          <tbody role="rowgroup">
            {%- for key in order_keys -%}
              {%- liquid
                if key == ''
                  continue
                endif
                assign r_i = key | split: '-' | last | plus: 0 | minus: 100
                assign r = row_list[r_i] | split: '~~'
                assign val = r[0]
                assign s_label = r[1] | default: val
                assign s_dims = r[2] | default: ''
                assign s_suits = r[3] | default: ''
                assign s_weight = r[4] | default: ''
                assign s_fit = r[5] | default: ''

                assign min_price = -1
                assign any_available = false
                for v in product.variants
                  if v.options[size_idx] == val
                    if min_price < 0
                      assign min_price = v.price
                    elsif v.price < min_price
                      assign min_price = v.price
                    endif
                    if v.available
                      assign any_available = true
                    endif
                  endif
                endfor
                assign is_current = false
                if val == current_size
                  assign is_current = true
                endif
              -%}
              <tr role="row" class="size-guide__row{% if is_current %} is-current{% endif %}{% unless any_available %} is-sold-out{% endunless %}" data-size-row data-value="{{ val | escape }}">
                <th scope="row" role="rowheader" class="size-guide__size">
                  <span class="size-guide__value">{{ s_label | escape }}</span>
                </th>
                {%- if has_dims -%}
                  <td role="cell" class="size-guide__dims" data-label="{{ 'product.size_guide.col_dims' | t }}">{{ s_dims | default: '—' | escape }}</td>
                {%- endif -%}
                {%- if has_fit -%}
                  <td role="cell" class="size-guide__fit" data-label="{{ 'product.size_guide.fit_heading' | t }}">{{ s_fit | default: '—' | escape }}</td>
                {%- endif -%}
                {%- if has_suits -%}
                  <td role="cell" class="size-guide__breeds" data-label="{{ 'product.size_guide.col_breeds' | t }}">{{ s_suits | default: '—' | escape }}</td>
                {%- endif -%}
                {%- if has_weight -%}
                  <td role="cell" class="size-guide__weight" data-label="{{ 'product.size_guide.col_weight' | t }}">{{ s_weight | default: '—' | escape }}</td>
                {%- endif -%}
                {%- if show_price -%}
                  <td role="cell" class="size-guide__price" data-label="{{ 'product.size_guide.col_price' | t }}">
                    {%- if min_price >= 0 -%}{{ min_price | money }}{%- endif -%}
                    {%- unless any_available %} <span class="size-guide__sold">{{ 'general.sold_out' | t }}</span>{% endunless -%}
                  </td>
                {%- endif -%}
                <td role="cell" class="size-guide__action">
                  <button
                    type="button"
                    class="btn btn--secondary btn--sm size-guide__choose"
                    data-size-guide-choose
                    data-option-index="{{ size_idx }}"
                    data-value="{{ val | escape }}"
                    aria-pressed="{{ is_current }}"
                    aria-label="{{ 'product.size_guide.choose_label' | t: size: s_label }}"
                  >
                    <span class="size-guide__choose-text">{{ 'product.size_guide.choose' | t }}</span>
                    <span class="size-guide__chosen-text">{%- render 'icon', name: 'check' -%}{{ 'product.size_guide.selected' | t }}</span>
                  </button>
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
        {%- if has_fit -%}
          {%- assign sg_allow_note = settings.size_fit_allowance | default: 0 | plus: 0 -%}
          <p class="size-guide__fit-note small muted">{{ 'product.size_guide.fit_note' | t: cm: sg_allow_note }}</p>
        {%- endif -%}
      {%- else -%}
        <p class="size-guide__single">{{ 'product.size_guide.no_sizes' | t }}</p>
      {%- endif -%}

      <div class="size-guide__measure">
        <div class="size-guide__diagram" aria-hidden="true">
          <svg viewBox="0 0 240 96" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" focusable="false">
            <path d="M38 62c6-15 22-24 44-24h58c14 0 24-5 31-13 4-5 11-6 16-2l9 8c4 4 2 10-3 12l-11 4c-4 2-6 6-6 10v8c0 6-5 10-11 10H74c-20 0-32-5-36-13z" class="size-guide__dog"/>
            <circle cx="186" cy="26" r="1.6" fill="currentColor" stroke="none"/>
            <path d="M38 62c-6-2-12-1-17 3" />
            <path d="M18 84h196" class="size-guide__tape"/>
            <path d="M18 78v12M214 78v12"/>
          </svg>
        </div>
        <div class="size-guide__measure-copy">
          <h3 class="h4 size-guide__measure-heading">{{ 'product.size_guide.measure_heading' | t }}</h3>
          <div class="rte size-guide__measure-text">{{ measure_html }}</div>
        </div>
      </div>

      {%- if sg_trial_ok -%}
        <p class="size-guide__trial">
          {%- render 'icon', name: 'return', class: 'size-guide__trial-icon' -%}
          {%- capture sg_terms -%}{%- render 'trial-terms' -%}{%- endcapture -%}
          <span>{{ 'product.size_guide.trial_note' | t: nights: nights, terms: sg_terms }}</span>
        </p>
      {%- endif -%}

      {%- if settings.finder_enable -%}
        <p class="size-guide__finder">
          <button type="button" class="btn btn--secondary btn--block" data-open-finder data-dialog-close>
            {%- render 'icon', name: 'paw' -%}
            <span>{{ 'product.size_guide.finder_cta' | t }}</span>
          </button>
        </p>
      {%- endif -%}
    </div>
  </dialog>
{%- endif -%}
