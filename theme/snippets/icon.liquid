{%- comment -%}
  Lunova icon set. Inline SVG, 24x24 grid, stroke-based at 1.75 so every
  icon carries the same visual weight. Colour is currentColor; size is 1em
  unless `size` is passed (px).

  Usage:
    {% render 'icon', name: 'truck' %}
    {% render 'icon', name: 'truck', size: 20, class: 'trust-list__icon' %}

  Decorative by default (aria-hidden). Give the surrounding control its own
  accessible name. Unknown names render nothing.
{%- endcomment -%}
{%- liquid
  assign icon_size = size | default: 0 | plus: 0
  assign icon_style = ''
  if icon_size > 0
    assign icon_style = ' style="--icon-size:' | append: icon_size | append: 'px"'
  endif
  assign open = '<svg class="icon icon--' | append: name | append: ' ' | append: class | append: '"' | append: icon_style | append: ' viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">'
  assign close = '</svg>'
-%}
{%- case name -%}
  {%- when 'truck' -%}
    {{ open }}<path d="M5 16.5H3V6.5h11v10"/><path d="M9 16.5h5.75"/><path d="M14 9.5h3.75l2.75 3v4h-1.75"/><circle cx="7" cy="17" r="2"/><circle cx="16.75" cy="17" r="2"/>{{ close }}
