{%- comment -%}
  Accessible pagination for any paginate object (collection, search,
  list-collections).

  Parameters
    paginate      the paginate object (required)
    anchor        optional fragment added to every link, e.g. '#Results-{{ section.id }}'
    show_summary  true → "Showing 25–48 of 120" above the links
    class         extra classes on the <nav>

  Renders nothing when there is only one page.

  Accessibility
    - <nav> landmark with its own name ("Pagination"), a real list of links.
    - Current page is a non-link with aria-current="page".
    - Every number link is named "Page 3", prev/next keep visible text on
      wider screens and are icon + visually-hidden text on phones.
    - Phones under 420px: a row that would not fit on one line at 360px
      shrinks to first, current and last page, with "…" standing in for
      every page left out (prev/next still reach the neighbours). A row
      that fits (e.g. "1 2 3 >") always shows every number, so no page
      silently disappears.

  JS hook: links carry [data-pagination-link]; inside <facet-filters>
  collection.js loads them through the Section Rendering API.
{%- endcomment -%}
{%- if paginate.pages > 1 -%}
  {%- liquid
    assign anchor_str = anchor | default: ''
    assign first_item = paginate.current_offset | plus: 1
    assign last_item = paginate.current_offset | plus: paginate.page_size
    if last_item > paginate.items
      assign last_item = paginate.items
    endif
    assign current = paginate.current_page | plus: 0

    comment
      Compact on phones only when the full row would wrap at 360px: 328px of
      content; page links and prev/next are 44px, a gap marker 24px, with
      4px between items.
    endcomment
    assign row_width = 0
    if paginate.previous.is_link
      assign row_width = row_width | plus: 48
    endif
    if paginate.next.is_link
      assign row_width = row_width | plus: 48
    endif
    for part in paginate.parts
      assign part_num = part.title | plus: 0
      if part_num > 0
        assign row_width = row_width | plus: 48
      else
        assign row_width = row_width | plus: 28
      endif
    endfor
    assign compact = false
    if row_width > 332
      assign compact = true
    endif
    assign shown_num = 0
  -%}
  <nav class="pagination{% if class %} {{ class }}{% endif %}" aria-label="{{ 'collection.pagination.label' | t }}">
    {%- if show_summary -%}
      <p class="pagination__summary">{{ 'collection.pagination.summary' | t: first: first_item, last: last_item, total: paginate.items }}</p>
    {%- endif -%}
    <ul class="pagination__list" role="list">
      {%- if paginate.previous.is_link -%}
        <li class="pagination__item pagination__item--prev">
          <a class="pagination__link pagination__link--step" href="{{ paginate.previous.url }}{{ anchor_str }}" rel="prev" data-pagination-link>
            {%- render 'icon', name: 'chevron-left', class: 'pagination__icon' -%}
            <span class="pagination__step-text">{{ 'collection.pagination.previous' | t }}</span>
          </a>
        </li>
      {%- endif -%}

      {%- for part in paginate.parts -%}
        {%- liquid
          assign part_num = part.title | plus: 0
          assign wide_class = ''
          assign narrow_gap = false
          if compact
            assign keep = false
            if part_num > 0
              if part_num == current or forloop.first or forloop.last
                assign keep = true
              endif
            endif
            if keep
              assign jump = part_num | minus: shown_num
              if shown_num > 0 and jump > 1
                assign narrow_gap = true
              endif
              assign shown_num = part_num
            else
              assign wide_class = ' pagination__item--wide'
            endif
          endif
        -%}
        {%- if narrow_gap -%}
          <li class="pagination__item pagination__item--gap pagination__item--narrow" aria-hidden="true">
            <span class="pagination__gap">…</span>
          </li>
        {%- endif -%}
        {%- if part.is_link -%}
          <li class="pagination__item{{ wide_class }}">
            <a class="pagination__link" href="{{ part.url }}{{ anchor_str }}" aria-label="{{ 'accessibility.page' | t: page: part.title }}" data-pagination-link>{{ part.title }}</a>
          </li>
        {%- elsif part_num == current -%}
          <li class="pagination__item">
            <span class="pagination__link pagination__link--current" aria-current="page" aria-label="{{ 'accessibility.page' | t: page: part.title }}">{{ part.title }}</span>
          </li>
        {%- else -%}
          <li class="pagination__item pagination__item--gap{{ wide_class }}" aria-hidden="true">
            <span class="pagination__gap">…</span>
          </li>
        {%- endif -%}
      {%- endfor -%}

      {%- if paginate.next.is_link -%}
        <li class="pagination__item pagination__item--next">
          <a class="pagination__link pagination__link--step" href="{{ paginate.next.url }}{{ anchor_str }}" rel="next" data-pagination-link>
            <span class="pagination__step-text">{{ 'collection.pagination.next' | t }}</span>
            {%- render 'icon', name: 'chevron-right', class: 'pagination__icon' -%}
          </a>
        </li>
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}
