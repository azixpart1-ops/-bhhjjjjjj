{%- comment -%}
  The description, collapsed (audit PDP-17, S05 "The story"): the words stay
  as written; the first two lines show, then "Read the full description"
  opens the rest (product.js toggles aria-expanded and the is-open class).
  Without JavaScript the whole description shows and the button stays hidden.

  Parameters
    product   the product
    heading   the heading (blank: none)
    section   for ids
{%- endcomment -%}
{%- if product.description != blank -%}
  {%- assign st_id = 'PdpStory-' | append: section.id -%}
  <div class="pdp-story" data-pdp-story>
    {%- if heading != blank -%}
      <h2 class="h4 pdp-story__heading">{{ heading | escape }}</h2>
    {%- endif -%}
    <div class="pdp-story__body rte" id="{{ st_id }}" data-pdp-story-body>
      {{- product.description -}}
    </div>
    <button
      type="button"
      class="link pdp-story__toggle"
      data-pdp-story-toggle
      aria-expanded="false"
      aria-controls="{{ st_id }}"
      data-label-open="{{ 'product.story.less' | t }}"
      hidden
    >
      <span data-pdp-story-label>{{ 'product.story.more' | t }}</span>
      {%- render 'icon', name: 'chevron-down', class: 'pdp-story__chevron' -%}
    </button>
  </div>
{%- endif -%}
