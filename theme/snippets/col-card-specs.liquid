{%- comment -%}
  Up to three spec chips for a product card (audit COL-06, COL-07), each only
  when the bed's own metafield says so: what's inside (custom.core_type),
  then Waterproof liner (has_liner), 30°C wash (wash_temp), Low step-in
  (low_entry), Non-slip base (non_slip), Wipe-clean cover (cover_type
  "Coated, wipe clean"). Nothing when none apply.

  Parameters: product
{%- endcomment -%}
{%- liquid
  comment
    Spec chips (COL-06, COL-07): what's inside first, then features, three
    at most, each only when the bed's own metafield says so.
  endcomment
  assign spec_list = ''
  assign pm = product.metafields.custom
  assign spec_core = pm.core_type.value | default: '' | append: '' | strip
  if spec_core != ''
    assign spec_list = spec_list | append: spec_core | append: '|'
  endif
  if pm.has_liner.value == true
    assign spec_t = 'collection.card.spec_liner' | t
    assign spec_list = spec_list | append: spec_t | append: '|'
  endif
  assign spec_wash = pm.wash_temp.value | append: '' | strip
  if spec_wash != '' and spec_wash != '0'
    assign spec_t = 'collection.card.spec_wash' | t: temp: spec_wash
    assign spec_list = spec_list | append: spec_t | append: '|'
  endif
  if pm.low_entry.value == true
    assign spec_t = 'collection.card.spec_low_entry' | t
    assign spec_list = spec_list | append: spec_t | append: '|'
  endif
  if pm.non_slip.value == true
    assign spec_t = 'collection.card.spec_non_slip' | t
    assign spec_list = spec_list | append: spec_t | append: '|'
  endif
  assign spec_cover = pm.cover_type.value | default: '' | append: '' | downcase
  if spec_cover contains 'wipe'
    assign spec_t = 'collection.card.spec_wipe_clean' | t
    assign spec_list = spec_list | append: spec_t | append: '|'
  endif
  assign spec_items = spec_list | split: '|'
-%}
{%- if spec_items.size > 0 -%}
  <ul class="product-card__specs" role="list" aria-label="{{ 'collection.card.specs_label' | t }}">
    {%- for spec in spec_items limit: 3 -%}
      <li class="product-card__spec">{{ spec | escape_once }}</li>
    {%- endfor -%}
  </ul>
{%- endif -%}
