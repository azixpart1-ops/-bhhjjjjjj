{%- comment -%}
  Prints the handle of the collection a product belongs under in breadcrumbs,
  chosen from its product type. Prints nothing when there is no clear parent.
  Usage: {%- capture h -%}{%- render 'product-parent-handle', product: product -%}{%- endcapture -%}
{%- endcomment -%}
{%- liquid
  assign pl_type = product.type
  assign pl_handle = ''
  if pl_type contains 'Orthopaedic'
    assign pl_handle = 'orthopaedic-dog-beds'
  elsif pl_type contains 'Bolster'
    if product.title contains 'Nest'
      assign pl_handle = 'nest-dog-beds'
    else
      assign pl_handle = 'bolster-dog-beds'
    endif
  elsif pl_type contains 'Mattress'
    assign pl_handle = 'dog-mattresses'
  elsif pl_type contains 'Elevated'
    assign pl_handle = 'elevated-cooling-dog-beds'
  elsif pl_type contains 'Waterproof'
    assign pl_handle = 'waterproof-dog-beds'
  elsif pl_type contains 'Crate'
    assign pl_handle = 'crate-travel-dog-beds'
  elsif pl_type contains 'Dog Houses'
    assign pl_handle = 'outdoor-dog-houses'
  endif
-%}
{{- pl_handle -}}
