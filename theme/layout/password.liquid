<!doctype html>
<html class="no-js{% unless settings.animations %} no-motion{% endunless %}" lang="{{ request.locale.iso_code }}">
  <head>
    {%- render 'meta-tags' -%}

    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif %}

    {%- liquid
      assign heading_font = settings.type_heading_font
      assign body_font = settings.type_body_font
      assign body_font_bold = body_font | font_modify: 'weight', 'bold'
      assign radius = settings.radius | default: 0 | plus: 0
      assign radius_lg = radius | times: 1.57 | round
      case settings.button_shape
        when 'soft'
          assign radius_btn = radius | times: 0.7 | round | append: 'px'
        when 'square'
          assign radius_btn = '2px'
        else
          assign radius_btn = '999px'
      endcase
    -%}
    {%- if body_font != blank %}
      <link rel="preload" as="font" href="{{ body_font | font_url }}" type="font/woff2" crossorigin>
    {%- endif %}

    <style>
      {{ heading_font | font_face: font_display: 'swap' }}
      {{ body_font | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}

      :root {
        --c-bg: {{ settings.color_bg | default: '#FAF6EF' }};
        --c-surface: {{ settings.color_surface | default: '#F1E9DB' }};
        --c-sand: {{ settings.color_sand | default: '#E3D7C3' }};
        --c-ink: {{ settings.color_ink | default: '#17150F' }};
        --c-muted: {{ settings.color_muted | default: '#5E5442' }};
        --c-control-line: {{ settings.color_control_line | default: '#8C7F66' }};
        --c-dark: {{ settings.color_dark | default: '#1A2B24' }};
        --c-on-dark: {{ settings.color_on_dark | default: '#F1E9DB' }};
        --c-on-dark-muted: {{ settings.color_on_dark_muted | default: '#A9BBB1' }};
        --c-accent: {{ settings.color_accent | default: '#B4532A' }};
        --c-accent-text: {{ settings.color_accent_text | default: '#FFFFFF' }};
        --c-accent-hover: {{ settings.color_accent | default: '#B4532A' | color_darken: 6 }};
        --c-highlight: {{ settings.color_highlight | default: '#A87821' }};
        --c-alert: {{ settings.color_alert | default: '#A8340E' }};
        --c-success: {{ settings.color_success | default: '#2E6B4F' }};
        --font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --font-heading-weight: {{ heading_font.weight | default: 400 }};
        --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
        --font-body-weight: {{ body_font.weight | default: 400 }};
        --font-body-weight-bold: {{ body_font_bold.weight | default: 700 }};
        --fs-body: {{ settings.body_size | default: 16 }}px;
        --heading-scale: {{ settings.heading_scale | default: 100 | divided_by: 100.0 }};
        --page-width: {{ settings.page_width | default: '1320' }}px;
        --radius: {{ radius }}px;
        --radius-lg: {{ radius_lg }}px;
        --radius-btn: {{ radius_btn }};
        --logo-width: {{ settings.logo_width | default: 140 }}px;
      }

      .password-layout {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        min-height: 100dvh;
      }
      .password-header,
      .password-footer {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.5rem 1rem;
        padding: 1.5rem var(--gutter);
        text-align: center;
      }
      .password-header__logo img {
        width: var(--logo-width);
        height: auto;
      }
      .password-header__name {
        font-family: var(--font-heading);
        font-size: 1.5rem;
        text-decoration: none;
        color: inherit;
      }
      .password-main {
        flex: 1 0 auto;
      }
      .password-footer {
        font-size: 0.875rem;
        color: var(--fg-muted);
      }
      .password-footer a {
        color: inherit;
      }
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>

    {{ content_for_header }}
  </head>

  <body class="password-layout template-{{ template.name | handle }}">
    <a class="skip-link" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

    <header class="password-header">
      {%- if settings.logo != blank -%}
        <span class="password-header__logo">
          {%- assign logo_alt = settings.logo.alt | default: shop.name -%}
          {%- render 'image',
            image: settings.logo,
            widths: '160,280,520',
            sizes: '260px',
            alt: logo_alt,
            loading: 'eager'
          -%}
        </span>
      {%- else -%}
        <span class="password-header__name">{{ shop.name }}</span>
      {%- endif -%}
    </header>

    <main id="MainContent" class="password-main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <footer class="password-footer">
      <span>{{ 'core.password.powered_by' | t }} {{ powered_by_link }}</span>
      <span>
        {{ 'core.password.owner' | t }}
        <a href="/admin" rel="nofollow">{{ 'core.password.owner_login' | t }}</a>
      </span>
    </footer>
  </body>
</html>
