{%- comment -%}
  "Coniston vs the alternatives" (audit PDP-21, S05): this bed against a
  fibre-filled bed and the forums' favourite DIY swap, a cot mattress plus
  a cover. It replaces "What the price pays for".

  Shown on memory foam beds only (custom.core_type "Memory foam", the
  default "Show on product pages" setting), because the rows describe what a
  foam core with a liner and a guarantee does against the alternatives.

  This bed's column is never typed in: each row names a fact and the cell is
  built from the bed's own data, and the row is left out when that data is
  blank (nothing is guessed):
    core        custom.core_type                    "Memory foam core"
    chin_rest   custom.shape bolster / nest         "Yes" ("Yes, low rim" with low_entry)
    entry       custom.low_entry (+ entry_height)   "Low front, no climb"
    grip        custom.non_slip                     "Non-slip base"
    accidents   custom.has_liner / coated cover     "Waterproof liner"
    washing     custom.cover_type (+ wash_temp)     "Cover off, 30°C"
    trial       snippets/trial-eligible             "100 nights, we collect free"
    guarantee   snippets/foam-bed                   "5 years"
  The two other columns describe kinds of bed, not named competitors, in
  the merchant's own words (the audit's S05 table by default); keep them
  general and fair. Semantic <table>; on phones each row is a card.

  Placeholders in the other columns and the heading: [name] (this bed's
  short name), [trial_nights], [guarantee_years].
{%- endcomment -%}
{%- unless template.name == 'product' -%}
  {{ 'product.css' | asset_url | stylesheet_tag }}
{%- endunless -%}
{%- render 'section-styles', section: section -%}
{%- liquid
  assign ss = section.settings
  assign has_product = false
  if product != blank and product.id != blank
    assign has_product = true
  endif

  assign render_it = true
  if template.name == 'product' and has_product and ss.product_filter != 'always'
    if ss.product_filter == 'guarantee'
      capture pc_foam
        render 'foam-bed', product: product
      endcapture
      if pc_foam != 'true'
        assign render_it = false
      endif
    else
      capture pc_core
        render 'product-fact', product: product, key: 'core_type'
      endcapture
      assign pc_core_lc = pc_core | strip | downcase
      if pc_core_lc != 'memory foam'
        assign render_it = false
      endif
    endif
  endif
  if has_product == false
    assign render_it = false
  endif
-%}
{%- if render_it -%}
{%- liquid
  assign nights = settings.trial_nights | default: 0 | plus: 0
  assign years = settings.guarantee_years | default: 0 | plus: 0
  assign nights_s = nights | append: ''
  assign years_s = years | append: ''

  assign full_title = product.title | split: ' | ' | first | strip
  assign short_name = full_title | remove_first: 'The ' | split: ' ' | first | default: full_title
  assign sn_lc = short_name | downcase
  if sn_lc == 'orthopaedic' or sn_lc == 'dog' or sn_lc == 'memory' or sn_lc == 'personalised' or sn_lc == 'luxury'
    assign short_name = full_title
  endif
  assign name_esc = short_name | escape

  capture f_core
    render 'product-fact', product: product, key: 'core_type'
  endcapture
  capture f_shape
    render 'product-fact', product: product, key: 'shape'
  endcapture
  capture f_low
    render 'product-fact', product: product, key: 'low_entry'
  endcapture
  capture f_height
    render 'product-fact', product: product, key: 'entry_height'
  endcapture
  capture f_slip
    render 'product-fact', product: product, key: 'non_slip'
  endcapture
  capture f_liner
    render 'product-fact', product: product, key: 'liner'
  endcapture
  capture f_cover
    render 'product-fact', product: product, key: 'cover_type'
  endcapture
  capture f_wash
    render 'product-fact', product: product, key: 'wash_temp'
  endcapture
  assign f_shape_lc = f_shape | downcase
  assign f_cover_lc = f_cover | downcase

  assign f_trial = false
  if settings.trial_enable and nights > 0
    capture f_t
      render 'trial-eligible', product: product
    endcapture
    if f_t == 'true'
      assign f_trial = true
    endif
  endif
  assign f_guarantee = false
  if settings.guarantee_enable and years > 0
    capture f_g
      render 'foam-bed', product: product
    endcapture
    if f_g == 'true'
      assign f_guarantee = true
    endif
  endif

  comment
    Pass 1: this bed's cell for every row, or blank (row left out).
    Kept as block-id=cell pairs.
  endcomment
  assign cells = ''
  assign row_count = 0
  for block in section.blocks
    assign cell = ''
    case block.settings.key
      when 'core'
        if f_core != ''
          assign cell = 'product.compare3.core' | t: core: f_core
        endif
      when 'chin_rest'
        if f_shape_lc contains 'bolster' or f_shape_lc == 'nest' or f_shape_lc contains 'corner'
          if f_low == 'true'
            assign cell = 'product.compare3.chin_low' | t
          else
            assign cell = 'product.compare3.yes' | t
          endif
        endif
      when 'entry'
        if f_low == 'true'
          if f_height != ''
            assign cell = 'product.compare3.entry_cm' | t: cm: f_height
          else
            assign cell = 'product.compare3.entry' | t
          endif
        endif
      when 'grip'
        if f_slip == 'true'
          assign cell = 'product.compare3.grip' | t
        endif
      when 'accidents'
        if f_liner == 'true'
          assign cell = 'product.compare3.liner' | t
        elsif f_cover_lc contains 'coated'
          assign cell = 'product.compare3.coated' | t
        endif
      when 'washing'
        if f_cover_lc contains 'zip'
          if f_wash != ''
            assign cell = 'product.compare3.wash_temp' | t: temp: f_wash
          else
            assign cell = 'product.compare3.wash' | t
          endif
        elsif f_cover_lc contains 'coated'
          assign cell = 'product.compare3.wipe' | t
        endif
      when 'trial'
        if f_trial
          if settings.trial_free_collection
            assign cell = 'product.compare3.trial_free' | t: nights: nights
          else
            assign cell = 'product.compare3.trial' | t: nights: nights
          endif
        endif
      when 'guarantee'
        if f_guarantee
          assign cell = 'product.compare3.guarantee' | t: years: years
        endif
    endcase
    if cell != ''
      assign row_count = row_count | plus: 1
      assign cells = cells | append: block.id | append: '=' | append: cell | append: '^^'
    endif
  endfor
  assign cell_list = cells | split: '^^'

  assign heading = ss.heading | default: '' | escape | replace: '[name]', name_esc
  assign alt_1 = ss.alt_1_label | default: '' | escape
  assign alt_2 = ss.alt_2_label | default: '' | escape
-%}
{%- if row_count >= 3 -%}
  <section
    id="{{ section.id }}-wrap"
    class="section scheme-{{ ss.color_scheme }} product-compare product-compare--three"
    aria-labelledby="{{ section.id }}-heading"
  >
    <div class="page-width page-width--narrow">
      <div class="section-head section-head--center">
        {%- if ss.eyebrow != blank -%}
          <p class="eyebrow">{{ ss.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="h2" id="{{ section.id }}-heading">{{ heading }}</h2>
        {%- if ss.intro != blank -%}
          <div class="lede rte">{{ ss.intro | replace: '[name]', name_esc | replace: '[trial_nights]', nights_s | replace: '[guarantee_years]', years_s }}</div>
        {%- endif -%}
      </div>

      <table class="compare3" role="table">
        <caption class="visually-hidden">{{ heading }}</caption>
        <thead role="rowgroup">
          <tr class="compare3__head" role="row">
            <th scope="col" role="columnheader" class="compare3__feature-head"><span class="visually-hidden">{{ 'product.compare.feature' | t }}</span></th>
            <th scope="col" role="columnheader" class="compare3__col compare3__col--ours">{{ name_esc }}</th>
            <th scope="col" role="columnheader" class="compare3__col">{{ alt_1 }}</th>
            <th scope="col" role="columnheader" class="compare3__col">{{ alt_2 }}</th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {%- for block in section.blocks -%}
            {%- liquid
              assign key = block.id | append: '='
              assign ours = ''
              for c in cell_list
                assign c_start = c | slice: 0, key.size
                if c_start == key
                  assign ours = c | remove_first: key
                  break
                endif
              endfor
              if ours == ''
                continue
              endif
              assign b = block.settings
            -%}
            <tr class="compare3__row" role="row" {{ block.shopify_attributes }}>
              <th scope="row" role="rowheader" class="compare3__feature">{{ b.label | escape }}</th>
              <td role="cell" class="compare3__cell compare3__cell--ours">
                <span class="compare3__label" aria-hidden="true">{{ name_esc }}</span>
                <span class="compare3__value">{{ ours }}</span>
              </td>
              <td role="cell" class="compare3__cell">
                <span class="compare3__label" aria-hidden="true">{{ alt_1 }}</span>
                <span class="compare3__value">{{ b.alt_1 | escape | replace: '[trial_nights]', nights_s | replace: '[guarantee_years]', years_s }}</span>
              </td>
              <td role="cell" class="compare3__cell">
                <span class="compare3__label" aria-hidden="true">{{ alt_2 }}</span>
                <span class="compare3__value">{{ b.alt_2 | escape | replace: '[trial_nights]', nights_s | replace: '[guarantee_years]', years_s }}</span>
              </td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>

      {%- if ss.footnote != blank -%}
        <p class="compare__footnote small muted">{{ ss.footnote | escape }}</p>
      {%- endif -%}

      {%- if ss.show_cta and template.name == 'product' -%}
        <p class="compare__cta">
          <a class="btn btn--secondary" href="#ProductBuy">
            <span>{%- if ss.cta_label != blank -%}{{ ss.cta_label | escape }}{%- else -%}{{ 'product.compare.cta' | t }}{%- endif -%}</span>
            {%- render 'icon', name: 'arrow-right' -%}
          </a>
        </p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}
{%- elsif request.design_mode -%}
  <div class="page-width product-compare__empty">
    <p class="small muted">{{ 'product.compare3.editor_hidden' | t }}</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Comparison",
  "tag": "div",
  "class": "product-compare-section",
  "enabled_on": { "templates": ["product"] },
  "max_blocks": 12,
  "settings": [
    {
      "type": "paragraph",
      "content": "This bed's column comes from its own metafields and promises, never typed in; a row whose fact is blank is left out. The two other columns describe kinds of bed, not named brands: keep them general and fair. [name] is the bed's short name."
    },
    {
      "type": "select",
      "id": "product_filter",
      "label": "Show on product pages",
      "options": [
        { "value": "memory_foam", "label": "Memory foam beds (custom.core_type)" },
        { "value": "guarantee", "label": "Beds the foam guarantee covers" },
        { "value": "always", "label": "Every product with three or more rows" }
      ],
      "default": "memory_foam"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Before you decide"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "[name] vs the alternatives"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "text",
      "id": "alt_1_label",
      "label": "Second column",
      "default": "Fibre-filled bed"
    },
    {
      "type": "text",
      "id": "alt_2_label",
      "label": "Third column",
      "default": "Cot mattress + cover"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show a button back to the sizes",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Choose your size"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "bone", "label": "Bone" },
        { "value": "oat", "label": "Oat" },
        { "value": "moss", "label": "Moss" },
        { "value": "white", "label": "White" }
      ],
      "default": "bone"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Row label",
          "default": "They lie on"
        },
        {
          "type": "select",
          "id": "key",
          "label": "This bed's cell comes from",
          "options": [
            { "value": "core", "label": "Core (custom.core_type)" },
            { "value": "chin_rest", "label": "Chin rest (custom.shape)" },
            { "value": "entry", "label": "Getting in (custom.low_entry)" },
            { "value": "grip", "label": "Grip (custom.non_slip)" },
            { "value": "accidents", "label": "Accidents (custom.has_liner)" },
            { "value": "washing", "label": "Washing (custom.cover_type)" },
            { "value": "trial", "label": "Not right? (the trial)" },
            { "value": "guarantee", "label": "Foam guarantee" }
          ],
          "default": "core"
        },
        {
          "type": "text",
          "id": "alt_1",
          "label": "Second column",
          "default": "Polyester fibre that packs down"
        },
        {
          "type": "text",
          "id": "alt_2",
          "label": "Third column",
          "default": "Foam made for a baby, not a 30kg dog"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison",
      "blocks": [
        { "type": "row" },
        { "type": "row", "settings": { "label": "Chin rest", "key": "chin_rest", "alt_1": "Usually", "alt_2": "No" } },
        { "type": "row", "settings": { "label": "Not right?", "key": "trial", "alt_1": "Often 14 to 30 days, you pay postage", "alt_2": "You keep it" } }
      ]
    }
  ]
}
{% endschema %}
