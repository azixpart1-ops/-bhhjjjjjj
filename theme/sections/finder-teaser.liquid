{%- comment -%}
  Bed Finder teaser — the finder's first question, asked right on the page.

  Foot-in-the-door: answering one easy, visual question costs nothing, and a
  tap opens the finder already on question 2 of 4 (the progress bar shows a
  quarter done — goal gradient). Without JavaScript each card is a link to
  /pages/bed-finder?style=…, which resumes on question 2 just the same.

  Returning visitors who already have a match see "Welcome back — Bella's
  match: …" with View and Retake instead of the question (finder.js reads
  the stored result; nothing is rendered server-side for it). Both carry
  data-open-finder, so they open the finder pop-up rather than the page
  (View on the stored result, Retake on question 1); once finder.js knows
  the matched bed's URL, View goes straight to that bed instead.

  The three drawings are the same ones finder.js draws in the finder itself.
{%- endcomment -%}
{%- if settings.finder_enable or request.design_mode -%}
  {%- comment -%}
    The styles are needed before the teaser paints mid-page. finder.js comes
    from the static bed-finder section whenever the finder is on (custom
    elements upgrade whatever the order), so it's only loaded here when the
    finder is off and this is the theme editor.
  {%- endcomment -%}
  {{ 'finder.css' | asset_url | stylesheet_tag }}
  {%- unless settings.finder_enable -%}
    <script src="{{ 'finder.js' | asset_url }}" defer="defer"></script>
  {%- endunless -%}
  {%- render 'section-styles', section: section -%}
  {%- liquid
    assign cs = section.settings.color_scheme | default: 'oat'
    assign sid = section.id
    assign heading_id = 'FinderTeaserHeading-' | append: sid
    assign q_id = 'FinderTeaserQ-' | append: sid
    assign finder_url = routes.root_url | append: '/pages/bed-finder' | replace: '//', '/'
    assign styles = 'curl,lean,sprawl' | split: ','
    assign nights = settings.trial_nights | default: 0 | plus: 0
    assign show_trial = false
    if section.settings.show_trial_note and settings.trial_enable and nights > 0
      assign show_trial = true
    endif
  -%}
  <section class="section scheme-{{ cs }} finder-teaser" id="{{ sid }}-wrap" aria-labelledby="{{ heading_id }}">
    <div class="page-width">
      {%- unless settings.finder_enable -%}
        <p class="finder-teaser__editor-note">{{ 'finder.teaser.disabled' | t }}</p>
      {%- endunless -%}

      <finder-teaser class="finder-teaser__inner" data-section-id="{{ sid }}">
        <div class="finder-teaser__intro">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <h2 class="h2" id="{{ heading_id }}">{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.text != blank -%}
            <p class="lede">{{ section.settings.text | escape }}</p>
          {%- endif -%}
          {%- if section.settings.note_1 != blank or section.settings.note_2 != blank or show_trial -%}
            <ul class="finder-teaser__notes" role="list">
              {%- if section.settings.note_1 != blank -%}
                <li class="finder-teaser__note">{%- render 'icon', name: 'clock' -%}<span>{{ section.settings.note_1 | escape }}</span></li>
              {%- endif -%}
              {%- if section.settings.note_2 != blank -%}
                <li class="finder-teaser__note">{%- render 'icon', name: 'check' -%}<span>{{ section.settings.note_2 | escape }}</span></li>
              {%- endif -%}
              {%- if show_trial -%}
                <li class="finder-teaser__note">{%- render 'icon', name: 'moon' -%}<span>{{ 'core.trust.trial_title' | t: nights: nights }}</span></li>
              {%- endif -%}
            </ul>
          {%- endif -%}
        </div>

        <div class="finder-teaser__panel">
          <div class="finder-teaser__question" data-teaser-question>
            <p class="finder-teaser__progress">
              <span>{{ 'finder.teaser.question' | t }}</span>
              <span class="finder-teaser__segs" aria-hidden="true">
                <span class="finder-teaser__seg is-active"></span>
                <span class="finder-teaser__seg"></span>
                <span class="finder-teaser__seg"></span>
                <span class="finder-teaser__seg"></span>
              </span>
            </p>
            <h3 class="finder-teaser__q h3" id="{{ q_id }}">{{ section.settings.question | default: 'How does your dog sleep?' | escape }}</h3>
            <ul class="finder-opts finder-opts--teaser" role="list" aria-labelledby="{{ q_id }}">
              {%- for st in styles -%}
                {%- liquid
                  assign t_title = 'finder.options.' | append: st | append: '_title'
                  assign t_text = 'finder.options.' | append: st | append: '_text'
                  assign text_id = sid | append: '-' | append: st | append: '-text'
                -%}
                <li>
                  <a
                    class="finder-opt finder-opt--art"
                    href="{{ finder_url }}?style={{ st }}"
                    data-teaser-style="{{ st }}"
                    aria-describedby="{{ text_id }}"
                  >
                    <span class="finder-opt__art" aria-hidden="true">
                      {%- case st -%}
                        {%- when 'curl' -%}
                          <svg class="finder-art" viewBox="0 0 160 100" aria-hidden="true" focusable="false"><ellipse class="finder-art__bed" cx="80" cy="76" rx="68" ry="17"/><path class="finder-art__soft" d="M22 74c10-7 32-11 58-11s48 4 58 11"/><path class="finder-art__dog" d="M44 73c-8-18 8-39 36-39 24 0 40 13 38 30-1 6-6 9-12 9z"/><path class="finder-art__line" d="M84 41c10 1 19 6 23 13"/><path class="finder-art__dog" d="M38 72c-4-11 4-20 15-20 10 0 16 8 14 17l-1 3z"/><path class="finder-art__line" d="M44 56c-3-3-4-7-3-11 4 1 7 4 8 8"/><path class="finder-art__line" d="M49 64c2 1.6 4.6 1.6 6.6 0"/><path class="finder-art__line" d="M112 66c-10 9-33 11-47 6"/><path class="finder-art__z" d="M94 14h9l-9 10h9M108 5h6l-6 7h6"/></svg>
                        {%- when 'lean' -%}
                          <svg class="finder-art" viewBox="0 0 160 100" aria-hidden="true" focusable="false"><rect class="finder-art__bed" x="10" y="66" width="140" height="18" rx="9"/><rect class="finder-art__bed" x="114" y="38" width="36" height="46" rx="15"/><path class="finder-art__line" d="M24 62c-8-1-13-6-15-13"/><path class="finder-art__dog" d="M24 70c-3-13 6-22 22-22h38c10 0 17 3 22 9l4 13z"/><path class="finder-art__dog" d="M94 54c5-11 14-18 26-18 10 0 16 5 15 12-1 4-5 6-10 6h-17z"/><path class="finder-art__line" d="M113 40c-6 1-10 6-10 12"/><path class="finder-art__line" d="M117 46c2 1.5 4.5 1.5 6.5 0"/><path class="finder-art__line" d="M98 69h14"/><path class="finder-art__z" d="M96 14h8l-8 9h8M108 6h5l-5 6h5"/></svg>
                        {%- else -%}
                          <svg class="finder-art" viewBox="0 0 160 100" aria-hidden="true" focusable="false"><rect class="finder-art__bed" x="6" y="70" width="148" height="14" rx="7"/><path class="finder-art__line" d="M96 62l16 9M86 65l10 9M58 64l-16 8M66 66l-9 8"/><path class="finder-art__line" d="M44 55c-9-1-18 1-30-2"/><ellipse class="finder-art__dog" cx="76" cy="56" rx="35" ry="12"/><path class="finder-art__dog" d="M105 53c6-5 15-6 24-4 8 2 12 7 9 12-2 4-8 5-17 5-7 0-13-2-17-6z"/><path class="finder-art__line" d="M115 52c-1-5 2-9 7-10"/><path class="finder-art__line" d="M124 58c2 1.3 4.3 1.3 6.3 0"/><path class="finder-art__z" d="M106 28h8l-8 9h8M118 18h5l-5 6h5"/></svg>
                      {%- endcase -%}
                    </span>
                    <span class="finder-opt__body">
                      <span class="finder-opt__title">{{ t_title | t }}</span>
                      <span class="finder-opt__text" id="{{ text_id }}">{{ t_text | t }}</span>
                    </span>
                    <span class="finder-opt__go" aria-hidden="true">{%- render 'icon', name: 'arrow-right' -%}</span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
            <p class="finder-teaser__foot">{{ 'finder.teaser.foot' | t }}</p>
          </div>

          <div
            class="finder-teaser__welcome"
            data-teaser-welcome
            data-match-named="{{ 'finder.teaser.match_named' | t }}"
            data-match="{{ 'finder.teaser.match' | t }}"
            data-size="{{ 'finder.teaser.size' | t }}"
            data-view-label="{{ 'finder.teaser.view_label' | t }}"
            hidden
          >
            <div class="finder-teaser__media" data-teaser-media hidden></div>
            <div class="finder-teaser__welcome-body">
              <p class="eyebrow">{{ 'finder.teaser.welcome' | t }}</p>
              <p class="finder-teaser__match h3" data-teaser-match></p>
              <p class="finder-teaser__size small muted" data-teaser-size hidden></p>
            </div>
            <div class="finder-teaser__actions">
              <a class="btn btn--secondary" href="{{ finder_url }}" data-teaser-view data-open-finder aria-haspopup="dialog">
                <span>{{ 'finder.teaser.view' | t }}</span>
                {%- render 'icon', name: 'arrow-right', class: 'icon--arrow-right' -%}
              </a>
              <a class="btn btn--ghost" href="{{ finder_url }}" data-teaser-retake data-href="{{ finder_url }}" data-open-finder data-finder-step="1" aria-haspopup="dialog">{{ 'finder.teaser.retake' | t }}</a>
            </div>
          </div>
        </div>
      </finder-teaser>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Bed Finder teaser",
  "class": "section-finder-teaser",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Asks the Bed Finder's first question on the page. A tap opens the finder already on question 2; visitors with a match see it here instead, with View and Retake."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "Bed Finder"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Which bed is right for your dog?"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "4 quick questions. A bed matched to how they actually sleep."
    },
    {
      "type": "text",
      "id": "note_1",
      "label": "Reassurance 1",
      "default": "About 30 seconds"
    },
    {
      "type": "text",
      "id": "note_2",
      "label": "Reassurance 2",
      "default": "No email needed"
    },
    {
      "type": "checkbox",
      "id": "show_trial_note",
      "label": "Mention the sleep trial",
      "default": true,
      "info": "Uses the trial length in Theme settings → Promises, and hides itself when the trial is off."
    },
    {
      "type": "text",
      "id": "question",
      "label": "Question",
      "default": "How does your dog sleep?"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "bone", "label": "Bone" },
        { "value": "oat", "label": "Oat" },
        { "value": "white", "label": "White" },
        { "value": "moss", "label": "Moss" }
      ],
      "default": "oat"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Bed Finder teaser"
    }
  ]
}
{% endschema %}
