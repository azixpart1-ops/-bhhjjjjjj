{%- comment -%}
  Bed Finder page — /pages/bed-finder (template page.bed-finder.json).

  The same <bed-finder> as the pop-up, in mode="inline": it renders from the
  #finder-config island that sections/bed-finder.liquid prints on every page,
  so Match blocks are set up once, in that section. On this page the pop-up
  isn't rendered; header and teaser buttons scroll to this finder instead.

  ?style=curl|lean|sprawl (the teaser's no-JavaScript link) starts it on
  question 2. The page's own content shows above as an optional intro.

  When the finder is switched off, shoppers get a plain route to every bed.
{%- endcomment -%}
{{ 'finder.css' | asset_url | stylesheet_tag }}
<script src="{{ 'finder.js' | asset_url }}" defer="defer"></script>
{%- render 'section-styles', section: section -%}
{%- liquid
  assign cs = section.settings.color_scheme | default: 'bone'
  assign hid = 'FinderPageHeading-' | append: section.id
  assign page_heading = section.settings.heading | default: page.title | default: ''
  if page_heading == ''
    assign page_heading = 'finder.dialog_label' | t
  endif
  assign trust_label = 'finder.page.trust_label' | t
  comment
    No products yet: the finder shows a launch sign-up, not questions, so
    the "4 quick questions" label would promise something that isn't there.
  endcomment
  assign show_eyebrow = section.settings.show_title
  assign shop_total = collections.all.products_count | default: 0 | plus: 0
  if shop_total == 0 and settings.finder_enable and request.design_mode != true
    assign show_eyebrow = false
  endif
-%}
<section class="section scheme-{{ cs }} finder-page" id="{{ section.id }}-wrap" aria-labelledby="{{ hid }}">
  <div class="page-width page-width--narrow">
    <header class="finder-page__head section-head section-head--center">
      {%- if section.settings.eyebrow != blank and show_eyebrow -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="h1{% unless section.settings.show_title %} visually-hidden{% endunless %}" id="{{ hid }}">{{ page_heading | escape }}</h1>
      {%- if section.settings.show_content and page.content != blank -%}
        <div class="rte finder-page__intro">{{ page.content }}</div>
      {%- endif -%}
    </header>

    {%- if settings.finder_enable -%}
      <bed-finder class="finder finder--inline" mode="inline" data-section-id="{{ section.id }}">
        <div class="finder__boot">
          <p class="finder__boot-text">{{ 'finder.loading' | t }}</p>
          <noscript><p class="finder__boot-text">{{ 'finder.no_js' | t }}</p></noscript>
          <a class="btn btn--secondary" href="{{ routes.all_products_collection_url }}">{{ 'finder.browse_all' | t }}</a>
        </div>
      </bed-finder>
      {%- if section.settings.show_trust -%}
        <div class="finder-page__trust">
          {%- render 'trust-list', items: 'trial,guarantee,delivery,secure', layout: 'row', size: 'sm', label: trust_label -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="finder-page__fallback">
        {%- if request.design_mode -%}
          <p class="finder-result__setup">{{ 'finder.page.disabled_editor' | t }}</p>
        {%- endif -%}
        <h2 class="h3">{{ 'finder.page.disabled_heading' | t }}</h2>
        <p class="muted">{{ 'finder.page.disabled_text' | t }}</p>
        <a class="btn btn--secondary btn--lg" href="{{ routes.all_products_collection_url }}">
          <span>{{ 'finder.browse_all' | t }}</span>
          {%- render 'icon', name: 'arrow-right', class: 'icon--arrow-right' -%}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bed Finder page",
  "class": "section-main-finder-page",
  "settings": [
    {
      "type": "paragraph",
      "content": "The questions, matches and copy are set up once in the Bed Finder section (open it from any page's section list). This page shows the same finder in full."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "4 quick questions"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Blank uses the page title."
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_content",
      "label": "Show the page's content as an intro",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_trust",
      "label": "Show promises under the finder",
      "default": true,
      "info": "Trial, guarantee, delivery and secure checkout, each from Theme settings → Promises."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "bone", "label": "Bone" },
        { "value": "oat", "label": "Oat" },
        { "value": "white", "label": "White" },
        { "value": "moss", "label": "Moss" }
      ],
      "default": "bone"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ]
}
{% endschema %}
