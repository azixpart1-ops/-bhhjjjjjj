{%- comment -%}
  Activate account (classic accounts) — customers/activate_account.json.
  Reached from the invitation email. Choose a password (twice), or decline.
{%- endcomment -%}
{{ 'pages.css' | asset_url | stylesheet_tag }}
<script src="{{ 'customer.js' | asset_url }}" defer="defer"></script>
{%- render 'section-styles', section: section -%}
{%- liquid
  assign s = section.settings
  assign f = 'CustomerActivate-' | append: section.id
  assign heading_id = f | append: '-title'
-%}
<section class="section customer main-activate scheme-{{ s.color_scheme | default: 'bone' }}" id="{{ section.id }}-wrap" aria-labelledby="{{ heading_id }}">
  <div class="page-width">
    <div class="customer__layout customer__layout--single">
      <div class="card card--lg customer-auth__panel">
        <h1 class="h2 customer-auth__title" id="{{ heading_id }}">{{ s.heading | default: '' | escape }}</h1>
        {%- if s.text != blank -%}
          <p class="muted customer-auth__lede">{{ s.text | escape }}</p>
        {%- endif -%}

        {%- form 'activate_customer_password', id: f, class: 'customer-form' -%}
          {%- if form.errors -%}
            <div class="form-errors" role="alert" tabindex="-1" autofocus id="{{ f }}-errors">
              <h2 class="form-errors__title">
                {%- render 'icon', name: 'info', size: 20 -%}
                <span>{{ 'pages.forms.error_heading' | t }}</span>
              </h2>
              <ul class="form-errors__list">
                {%- for field in form.errors -%}
                  <li>
                    {%- if field == 'form' -%}
                      {{ form.errors.messages[field] }}
                    {%- else -%}
                      <a href="#{{ f }}-{{ field }}">{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="field">
            <label class="field__label" for="{{ f }}-password">{{ 'pages.customer.password' | t }}</label>
            <div class="password-field">
              <input
                class="input password-field__input"
                type="password"
                id="{{ f }}-password"
                name="customer[password]"
                autocomplete="new-password"
                minlength="5"
                required
                aria-describedby="{{ f }}-password-hint{% if form.errors contains 'password' %} {{ f }}-errors{% endif %}"
                {%- if form.errors contains 'password' %} aria-invalid="true"{% endif %}
              >
              <button
                type="button"
                class="password-field__toggle"
                data-password-toggle
                aria-controls="{{ f }}-password"
                aria-pressed="false"
                data-label-show="{{ 'pages.forms.show_password' | t }}"
                data-label-hide="{{ 'pages.forms.hide_password' | t }}"
                hidden
              >
                {{- 'pages.forms.show_password' | t -}}
              </button>
            </div>
            <p class="field__hint" id="{{ f }}-password-hint">{{ 'pages.customer.register.password_hint' | t }}</p>
          </div>

          <div class="field">
            <label class="field__label" for="{{ f }}-password_confirmation">{{ 'pages.customer.password_confirm' | t }}</label>
            <input
              class="input"
              type="password"
              id="{{ f }}-password_confirmation"
              name="customer[password_confirmation]"
              autocomplete="new-password"
              minlength="5"
              required
              {%- if form.errors contains 'password_confirmation' %} aria-invalid="true" aria-describedby="{{ f }}-errors"{% endif %}
            >
          </div>

          <button type="submit" class="btn btn--lg btn--block pages-submit">{{ 'pages.customer.activate.submit' | t }}</button>
          <button type="submit" class="btn btn--ghost btn--block customer-form__decline" name="decline" value="{{ 'pages.customer.activate.decline' | t }}" formnovalidate>
            {{- 'pages.customer.activate.decline' | t -}}
          </button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Activate account",
  "class": "section-main-activate-account",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "bone", "label": "Bone" },
        { "value": "oat", "label": "Oat" },
        { "value": "moss", "label": "Moss (dark)" },
        { "value": "white", "label": "White" }
      ],
      "default": "bone"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Activate your account"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Choose a password and your orders and addresses will be waiting for you."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}
