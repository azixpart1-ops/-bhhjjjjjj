{%- comment -%}
  Collection grid with Shopify storefront filtering and sorting, rebuilt for
  phones by the October 2026 audit (S06, S07).

  Order on a phone: quick filter chips that apply in place (Low step-in,
  Waterproof liner, Memory foam, XL & XXL, Under £150), then a sticky
  "Filter & sort · 37 beds" bar, then the beds. Honest throughout:
    - Quick chips (blocks) use the store's own Search & Discovery filters
      when they exist on this page and fall back to a real collection
      otherwise (snippets/col-filter-link); a chip with neither is hidden.
    - The filter drawer lists collection.filters in a dog-led order with
      plain names and every true/false filter gathered under "Features"
      (snippets/facets, col-facet-group). Availability can be hidden.
    - Two tiles on page 1 only, never counted as beds: the Bed Finder at
      position 5 (after the first two rows) and the 100-night trial at
      position 12, each only when the page has beds on both sides of it.
      They are list items in reading order, so the keyboard meets them
      where the eye does.
    - "Showing 24 of 37" and "Show more beds (13)": the button appends the
      next page through the Section Rendering API (collection.js), moves
      focus to the first new bed and keeps the URL in step. Without
      JavaScript the numbered pagination shows instead.
    - When filters leave nothing: "No beds match all of those", with Clear
      all, the Bed Finder and a way to message us.
    - No per-night line, no stock count, no stars on cards (product-card).

  JS: <facet-filters> in collection.js (progressive enhancement: every
  control is a real link or GET form first).
{%- endcomment -%}
{{ 'collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'collection.js' | asset_url }}" defer="defer"></script>
{%- render 'section-styles', section: section -%}
{%- liquid
  assign sid = section.id
  assign cs = section.settings.color_scheme | default: 'bone'
  assign per_page = section.settings.products_per_page | default: 24 | plus: 0
  assign fx_layout = section.settings.filter_layout | default: 'sidebar'
  assign cols = section.settings.columns_desktop | default: '4'

  assign ratio_key = section.settings.image_ratio
  if ratio_key == 'theme' or ratio_key == blank
    assign ratio_key = settings.card_image_ratio | default: 'square'
  endif
  case ratio_key
    when 'portrait'
      assign ratio_css = '4 / 5'
    when 'landscape'
      assign ratio_css = '4 / 3'
    else
      assign ratio_css = '1 / 1'
  endcase

  assign raw_title = collection.title | default: ''
  assign title = raw_title | split: ' | ' | first | split: ' – ' | first | strip
  if title == ''
    assign title = raw_title | strip
  endif

  assign has_filters = false
  if section.settings.enable_filtering and collection.filters.size > 0
    assign has_filters = true
  endif

  assign active_count = 0
  if has_filters
    for filter in collection.filters
      if filter.type == 'price_range'
        if filter.min_value.value != nil or filter.max_value.value != nil
          assign active_count = active_count | plus: 1
        endif
      else
        assign active_count = active_count | plus: filter.active_values.size
      endif
    endfor
  endif

  assign clear_url = collection.url
  if collection.sort_by != blank
    assign clear_url = collection.url | append: '?sort_by=' | append: collection.sort_by
  endif

  assign finder_url = routes.root_url | append: '/pages/bed-finder' | replace: '//', '/'
  assign finder_label = settings.finder_cta_label | default: '' | strip | escape
  if finder_label == ''
    assign finder_label = 'collection.finder_tile.cta' | t
  endif
  assign contact_url = ''
  assign contact_page = pages['contact']
  if contact_page.url != blank
    assign contact_url = contact_page.url
  endif

  assign total_in_collection = collection.all_products_count | default: 0 | plus: 0
  assign shop_total = collections.all.products_count | default: 0 | plus: 0

  comment
    Count as beds ("27 beds") only when everything in the collection is a
    bed; a mixed collection (kennels, accessories) counts products.
  endcomment
  assign count_noun = 'beds'
  for type_name in collection.all_types
    assign type_down = type_name | downcase | strip
    if type_down == ''
      continue
    endif
    unless type_down contains 'bed' or type_down contains 'mattress'
      assign count_noun = 'products'
      break
    endunless
  endfor

  assign finder_on = false
  if section.settings.show_finder_tile and settings.finder_enable
    assign finder_on = true
  endif
  assign trial_on = false
  if section.settings.show_trial_tile and settings.trial_enable
    assign trial_on = true
  endif
  assign finder_pos = section.settings.finder_tile_position | default: 5 | plus: 0
  assign trial_pos = section.settings.trial_tile_position | default: 12 | plus: 0

  comment
    No filter bar over an empty collection: there is nothing to filter.
    Kept when filters are active, so they can still be cleared.
  endcomment
  assign show_facets = false
  if total_in_collection > 0 or active_count > 0
    assign show_facets = true
  endif
-%}

{%- paginate collection.products by per_page -%}
  {%- liquid
    assign results_count = collection.products_count | default: 0 | plus: 0
    assign page_items = collection.products.size
    assign first_item = paginate.current_offset | plus: 1
    assign last_item = paginate.current_offset | plus: page_items
    assign remaining = results_count | minus: last_item | at_least: 0
    assign is_first_page = true
    if paginate.current_page > 1
      assign is_first_page = false
    endif
    assign load_more = false
    if section.settings.load_more and paginate.pages > 1
      assign load_more = true
    endif

    comment
      Tiles sit on page 1 only, and only with a bed on each side: the
      finder at position 5 needs at least 5 beds on the page, the trial
      tile at 12 needs 11 (10 beds before it plus the finder tile).
    endcomment
    assign show_finder_tile = false
    assign show_trial_tile = false
    if is_first_page
      assign need = finder_pos
      if finder_on and page_items >= need
        assign show_finder_tile = true
      endif
      assign need = trial_pos | minus: 1
      if show_finder_tile and finder_pos < trial_pos
        assign need = need | minus: 1
      endif
      assign need = need | plus: 1
      if trial_on and page_items >= need
        assign show_trial_tile = true
      endif
    endif

    comment
      Does the trial cover every bed on this page? If not, the trial tile
      says each bed's page shows whether it is covered.
    endcomment
    assign trial_covers_all = true
    if show_trial_tile
      for product in collection.products
        capture page_trial
          render 'trial-eligible', product: product
        endcapture
        if page_trial != 'true'
          assign trial_covers_all = false
          break
        endif
      endfor
    endif

    comment
      Quick filter chips (blocks): where each one goes, worked out once.
    endcomment
    assign chips_html = ''
    if show_facets and section.blocks.size > 0
      capture chips_html
        for block in section.blocks
          if block.type != 'chip'
            continue
          endif
          capture chip_hit
            render 'col-filter-link', results: collection, key: block.settings.filter, price: block.settings.price, fallback: block.settings.collection
          endcapture
          assign chip_hit = chip_hit | strip
          if chip_hit == ''
            continue
          endif
          assign chip_mode = chip_hit | split: '|' | first
          assign chip_url = chip_hit | remove_first: chip_mode | remove_first: '|'
          assign chip_label = block.settings.label | default: '' | strip
          if chip_label == '' and block.settings.collection != blank
            assign chip_label = block.settings.collection.title | split: ' | ' | first
          endif
          if chip_label == ''
            continue
          endif
          assign chip_label_e = chip_label | escape
          assign chip_li = '<li class="quick-chips__item" ' | append: block.shopify_attributes | append: '>'
          echo chip_li
          if chip_mode == 'remove'
            assign chip_remove = 'collection.quick_chips.remove' | t
            echo '<a class="chip quick-chips__chip" href="' | append: chip_url | append: '" aria-current="true" data-facets-link>'
            render 'icon', name: 'check', class: 'quick-chips__icon'
            echo '<span>' | append: chip_label_e | append: '</span>'
            echo '<span class="visually-hidden">' | append: chip_remove | append: '</span>'
          elsif chip_mode == 'add'
            echo '<a class="chip quick-chips__chip" href="' | append: chip_url | append: '" data-facets-link>'
            echo '<span>' | append: chip_label_e | append: '</span>'
          else
            echo '<a class="chip quick-chips__chip" href="' | append: chip_url | append: '">'
            echo '<span>' | append: chip_label_e | append: '</span>'
            render 'icon', name: 'arrow-right', class: 'quick-chips__icon'
          endif
          echo '</a></li>'
        endfor
      endcapture
      assign chips_html = chips_html | strip
    endif
  -%}
  <section
    class="section scheme-{{ cs }} main-collection"
    id="{{ sid }}-wrap"
    aria-labelledby="ResultsHeading-{{ sid }}"
  >
    <div class="page-width">
      <facet-filters
        class="facets-layout facets-layout--{{ fx_layout }}{% if has_filters and show_facets %} has-filters{% endif %}"
        data-section-id="{{ sid }}"
        data-results-url="{{ collection.url }}"
      >
        <h2 class="visually-hidden" id="ResultsHeading-{{ sid }}" tabindex="-1" data-results-heading>{{ 'collection.grid.heading' | t: title: title }}</h2>

        <div class="quick-chips" data-swap="chips">
          {%- if chips_html != '' -%}
            <nav class="quick-chips__nav" aria-label="{{ 'collection.quick_chips.label' | t }}">
              <ul class="quick-chips__list" role="list">{{ chips_html }}</ul>
            </nav>
          {%- endif -%}
        </div>

        {%- if show_facets -%}
          {%- render 'facets',
            part: 'bar',
            results: collection,
            section_id: sid,
            action_url: collection.url,
            layout: fx_layout,
            enable_filtering: section.settings.enable_filtering,
            enable_sorting: section.settings.enable_sorting,
            results_count: results_count,
            noun: count_noun,
            hide_availability: section.settings.hide_availability
          -%}
          {%- render 'facets',
            part: 'panel',
            results: collection,
            section_id: sid,
            action_url: collection.url,
            layout: fx_layout,
            enable_filtering: section.settings.enable_filtering,
            enable_sorting: section.settings.enable_sorting,
            results_count: results_count,
            noun: count_noun,
            hide_availability: section.settings.hide_availability
          -%}
        {%- endif -%}

        <div class="facets-layout__main">
          {%- if show_facets -%}
            {%- render 'facets',
              part: 'toolbar',
              results: collection,
              section_id: sid,
              action_url: collection.url,
              layout: fx_layout,
              enable_filtering: section.settings.enable_filtering,
              enable_sorting: section.settings.enable_sorting,
              results_count: results_count,
              noun: count_noun,
              hide_availability: section.settings.hide_availability
            -%}
          {%- endif -%}

          <div class="collection-results{% if load_more %} collection-results--more{% endif %}{% unless is_first_page %} is-later-page{% endunless %}" id="Results-{{ sid }}" data-swap="results" data-results>
            {%- if results_count > 0 -%}
              <ul
                class="grid collection-grid collection-grid--{{ cols }}{% if has_filters and fx_layout == 'sidebar' %} collection-grid--beside-filters{% endif %}"
                role="list"
                style="--card-ratio: {{ ratio_css }};"
                data-grid
              >
                {%- assign cell = 0 -%}
                {%- for product in collection.products -%}
                  {%- assign cell = cell | plus: 1 -%}
                  {%- if show_finder_tile and cell == finder_pos -%}
                    {%- render 'finder-tile',
                      heading: section.settings.finder_tile_heading,
                      text: section.settings.finder_tile_text,
                      cta: section.settings.finder_tile_cta,
                      eyebrow: 'none',
                      ratio: ratio_css,
                      class: 'collection-grid__tile'
                    -%}
                    {%- assign cell = cell | plus: 1 -%}
                  {%- endif -%}
                  {%- if show_trial_tile and cell == trial_pos -%}
                    {%- render 'col-trial-tile',
                      heading: section.settings.trial_tile_heading,
                      text: section.settings.trial_tile_text,
                      link_label: section.settings.trial_tile_link_label,
                      link: section.settings.trial_tile_link,
                      covers_all: trial_covers_all,
                      ratio: ratio_css,
                      class: 'collection-grid__tile'
                    -%}
                    {%- assign cell = cell | plus: 1 -%}
                  {%- endif -%}
                  {%- liquid
                    assign card_lazy = true
                    if forloop.index <= 2 and is_first_page
                      assign card_lazy = false
                    endif
                    assign stagger = forloop.index0 | modulo: 4 | plus: 1
                  -%}
                  <li class="collection-grid__item" data-grid-item>
                    {%- render 'product-card',
                      product: product,
                      image_ratio: ratio_key,
                      show_quick_add: section.settings.show_quick_add,
                      lazy: card_lazy,
                      heading_level: 'h3',
                      index: stagger,
                      reveal: true
                    -%}
                  </li>
                {%- endfor -%}
              </ul>

              {%- liquid
                if count_noun == 'beds'
                  assign more_key = 'collection.more.button_beds'
                else
                  assign more_key = 'collection.more.button_products'
                endif
                assign tpl_all = 'collection.more.summary' | t: last: '[last]', total: '[total]'
                assign tpl_range = 'collection.more.summary_range' | t: first: '[first]', last: '[last]', total: '[total]'
              -%}
              <div
                class="collection-more"
                data-swap="more"
                data-more
                data-first="{{ first_item }}"
                data-last="{{ last_item }}"
                data-total="{{ results_count }}"
                data-tpl-all="{{ tpl_all }}"
                data-tpl-range="{{ tpl_range }}"
              >
                {%- if paginate.pages > 1 -%}
                  <p class="collection-more__summary" data-more-summary>
                    {%- if first_item == 1 -%}
                      {{- 'collection.more.summary' | t: last: last_item, total: results_count -}}
                    {%- else -%}
                      {{- 'collection.more.summary_range' | t: first: first_item, last: last_item, total: results_count -}}
                    {%- endif -%}
                  </p>
                  {%- if load_more and paginate.next.is_link -%}
                    <a class="btn btn--secondary collection-more__btn" href="{{ paginate.next.url }}" data-load-more>
                      {{- more_key | t: count: remaining -}}
                    </a>
                  {%- endif -%}
                {%- endif -%}
              </div>

              {%- render 'pagination', paginate: paginate, anchor: '', show_summary: false, class: 'collection-results__pagination' -%}

            {%- elsif total_in_collection == 0 and active_count == 0 and request.design_mode -%}
              <p class="collection-results__editor-note">{{ 'collection.empty.editor_note' | t }}</p>
              <ul class="grid collection-grid collection-grid--{{ cols }}" role="list" style="--card-ratio: {{ ratio_css }};">
                {%- for i in (1..8) -%}
                  <li class="collection-grid__item">
                    {%- render 'product-card', product: blank, image_ratio: ratio_key, placeholder_index: i, heading_level: 'h3' -%}
                  </li>
                {%- endfor -%}
              </ul>

            {%- elsif total_in_collection == 0 and active_count == 0 -%}
              {%- liquid
                comment
                  Store with no beds yet: the finder would come back empty,
                  so offer to email them when the first beds land instead.
                endcomment
                assign empty_body = section.settings.empty_text
                if shop_total == 0
                  assign empty_body = section.settings.empty_store_text
                endif
              -%}
              <div class="collection-empty">
                <span class="collection-empty__art" aria-hidden="true">{%- render 'icon', name: 'bed' -%}</span>
                <h3 class="h3 collection-empty__heading">{{ section.settings.empty_heading | escape }}</h3>
                {%- if empty_body != blank -%}
                  <div class="collection-empty__text rte">{{ empty_body }}</div>
                {%- endif -%}
                {%- if shop_total == 0 -%}
                  {%- liquid
                    assign notify_form_id = 'LaunchNotify-' | append: sid
                    assign notify_field_id = 'LaunchNotifyEmail-' | append: sid
                    assign notify_error_id = 'LaunchNotifyError-' | append: sid
                  -%}
                  {%- form 'customer', id: notify_form_id, class: 'collection-empty__form' -%}
                    <input type="hidden" name="contact[tags]" value="newsletter,launch-waitlist">
                    {%- if form.posted_successfully? -%}
                      <p class="collection-empty__success" role="status">
                        {%- render 'icon', name: 'check-circle' -%}
                        <span>{{ 'collection.empty.notify_success' | t }}</span>
                      </p>
                    {%- else -%}
                      <label class="field__label collection-empty__label" for="{{ notify_field_id }}">{{ 'collection.empty.notify_label' | t }}</label>
                      <div class="collection-empty__form-row">
                        <input
                          class="input collection-empty__input"
                          id="{{ notify_field_id }}"
                          type="email"
                          name="contact[email]"
                          value="{{ form.email }}"
                          autocomplete="email"
                          autocapitalize="off"
                          spellcheck="false"
                          required
                          placeholder="{{ 'collection.empty.notify_placeholder' | t }}"
                          {%- if form.errors %} aria-invalid="true" aria-describedby="{{ notify_error_id }}"{% endif %}
                        >
                        <button type="submit" class="btn btn--secondary collection-empty__submit" name="commit">
                          {{- 'collection.empty.notify_submit' | t -}}
                        </button>
                      </div>
                      {%- if form.errors -%}
                        <p class="field__error collection-empty__error" id="{{ notify_error_id }}" role="alert">
                          {%- if form.errors contains 'email' -%}
                            {{ 'collection.empty.notify_error' | t }}
                          {%- else -%}
                            {{ form.errors | default_errors }}
                          {%- endif -%}
                        </p>
                      {%- endif -%}
                    {%- endif -%}
                  {%- endform -%}
                {%- else -%}
                  <div class="collection-empty__actions">
                    {%- if settings.finder_enable -%}
                      <a href="{{ finder_url }}" class="btn btn--secondary" data-open-finder>
                        {%- render 'icon', name: 'paw' -%}
                        <span>{{ finder_label }}</span>
                      </a>
                    {%- endif -%}
                    {%- if collection.handle != 'all' -%}
                      <a href="{{ routes.all_products_collection_url }}" class="collection-empty__link">
                        <span>{{ 'collection.empty.all_beds' | t }}</span>
                        {%- render 'icon', name: 'arrow-right' -%}
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
                {%- render 'trust-list', items: 'trial,guarantee,delivery', layout: 'row', size: 'sm', class: 'collection-empty__trust' -%}
              </div>

            {%- else -%}
              {%- comment -%} Filters left nothing (audit COL-14). {%- endcomment -%}
              <div class="collection-empty collection-empty--filtered">
                <span class="collection-empty__art" aria-hidden="true">{%- render 'icon', name: 'filter' -%}</span>
                <h3 class="h3 collection-empty__heading">{{ 'collection.empty.filtered_heading' | t }}</h3>
                <p class="collection-empty__text">
                  {%- if contact_url != '' -%}
                    {{- 'collection.empty.filtered_text_html' | t: contact_url: contact_url -}}
                  {%- else -%}
                    {{- 'collection.empty.filtered_text_plain' | t -}}
                  {%- endif -%}
                </p>
                <div class="collection-empty__actions">
                  <a href="{{ clear_url }}" class="btn btn--secondary" data-facets-link>{{ 'collection.facets.clear_all' | t }}</a>
                  {%- if settings.finder_enable -%}
                    <a href="{{ finder_url }}" class="btn btn--ghost" data-open-finder>
                      {%- render 'icon', name: 'paw' -%}
                      <span>{{ 'collection.empty.filtered_finder' | t }}</span>
                    </a>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          </div>
        </div>

        <p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-facets-live></p>
      </facet-filters>
    </div>

    {%- if section.settings.show_description and collection.description != blank -%}
      {%- liquid
        assign about = collection.description
        assign about = about | replace: '<h5', '<h6' | replace: '</h5>', '</h6>'
        assign about = about | replace: '<h4', '<h5' | replace: '</h4>', '</h5>'
        assign about = about | replace: '<h3', '<h4' | replace: '</h3>', '</h4>'
        assign about = about | replace: '<h2', '<h3' | replace: '</h2>', '</h3>'
        assign about = about | replace: '<h1', '<h2' | replace: '</h1>', '</h2>'
        assign about_has_heading = false
        if about contains '<h2'
          assign about_first = about | strip | slice: 0, 3
          if about_first == '<h2'
            assign about_has_heading = true
          endif
        endif
      -%}
      <div class="page-width collection-about" data-collection-about>
        <div class="collection-about__inner">
          {%- unless about_has_heading -%}
            <h2 class="h3 collection-about__heading">{{ 'collection.about.heading' | t: title: title }}</h2>
          {%- endunless -%}
          <div class="rte collection-about__body" id="CollectionAbout-{{ sid }}" data-about-body>
            {{ about }}
          </div>
          <button
            type="button"
            class="link collection-about__toggle"
            aria-controls="CollectionAbout-{{ sid }}"
            aria-expanded="false"
            data-about-toggle
            data-label-more="{{ 'collection.about.read_more' | t }}"
            data-label-less="{{ 'collection.about.read_less' | t }}"
            hidden
          >
            {{- 'collection.about.read_more' | t -}}
          </button>
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.enable_schema and results_count > 0 -%}
      {%- assign origin = request.origin | default: shop.url -%}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "CollectionPage",
          "name": {{ title | json }},
          "url": {{ origin | append: collection.url | json }},
          {%- if collection.description != blank -%}
          "description": {{ collection.description | strip_html | strip | truncate: 300 | json }},
          {%- endif -%}
          "mainEntity": {
            "@type": "ItemList",
            "numberOfItems": {{ results_count }},
            "itemListElement": [
              {%- for product in collection.products -%}
              {
                "@type": "ListItem",
                "position": {{ paginate.current_offset | plus: forloop.index }},
                "url": {{ origin | append: product.url | json }},
                "name": {{ product.title | json }}
              }{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ]
          }
        }
      </script>
    {%- endif -%}
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection grid",
  "tag": "div",
  "class": "section-main-collection",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "bone", "label": "Bone" },
        { "value": "oat", "label": "Oat" },
        { "value": "moss", "label": "Moss" },
        { "value": "white", "label": "White" }
      ],
      "default": "bone"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Beds per page",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 24,
      "info": "Tiles are extra and never counted as beds."
    },
    {
      "type": "checkbox",
      "id": "load_more",
      "label": "Show a \"Show more beds\" button",
      "default": true,
      "info": "Adds the next page under the beds already shown. Without JavaScript, numbered pages show instead."
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4",
      "info": "Phones always show 2."
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Card image shape",
      "options": [
        { "value": "theme", "label": "Theme default" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "theme"
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add on cards",
      "default": true,
      "info": "Also needs Theme settings → Cards → Quick add."
    },
    {
      "type": "header",
      "content": "Filtering and sorting"
    },
    {
      "type": "paragraph",
