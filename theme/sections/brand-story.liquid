{%- comment -%}
  Brand story — "Named for the Lakes". The Lake District naming is the
  strongest brand asset the store owns; this explains it, and says what the
  names stand for (a bed per sleeping style, not per price point).

  Origin: no manufacturing claim is made unless Theme settings → Promises →
  Origin line is filled in (then it shows as a small line, e.g. "Made in
  Yorkshire"). The place names are a typographic detail, editable.
{%- endcomment -%}
{{ 'sections.css' | asset_url | stylesheet_tag }}
{%- render 'section-styles', section: section -%}
{%- liquid
  assign s = section.settings
  assign heading_id = section.id | append: '-heading'
  assign img = s.image
  if img == blank and s.image_product != blank
    assign img = s.image_product.featured_media.preview_image
  endif
  case s.image_ratio
    when 'square'
      assign ratio = 1
    when 'landscape'
      assign ratio = 1.3333
    else
      assign ratio = 0.8
  endcase
  assign origin = settings.origin_line | default: '' | strip
  assign places = s.places | default: '' | split: ','
-%}
<section
  class="section media-text{% if img == blank and request.design_mode == false %} media-text--no-media{% endif %} brand-story scheme-{{ s.color_scheme }} media-text--media-{{ s.media_side | default: 'right' }} media-text--shape-{{ s.image_shape | default: 'arch' }} media-text--valign-center"
  id="{{ section.id }}-wrap"
  aria-labelledby="{{ heading_id }}"
>
  <div class="page-width media-text__inner">
    {%- if img != blank or request.design_mode -%}
    <div class="media-text__media" data-reveal>
      <div class="media-text__frame" style="--ratio: {{ ratio }};">
        {%- render 'image',
          image: img,
          widths: '360,540,720,900,1100,1300',
          sizes: '(min-width: 990px) 50vw, 100vw',
          alt: s.image_alt,
          aspect: ratio,
          class: 'media-text__img',
          placeholder: 'lifestyle-1'
        -%}
      </div>
    </div>
    {%- endif -%}
    <div class="media-text__copy">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="{{ heading_id }}" class="h2 media-text__heading">{{ s.heading | default: shop.name | escape }}</h2>
      {%- if s.body != blank -%}
        <div class="rte media-text__body">{{ s.body }}</div>
      {%- endif -%}

      {%- if places.size > 0 -%}
        <p class="brand-story__places">
          {%- for place in places -%}
            {%- assign pl = place | strip -%}
            {%- if pl != blank -%}
              <span class="brand-story__place">{{ pl | escape }}</span>
            {%- endif -%}
          {%- endfor -%}
        </p>
      {%- endif -%}

      {%- if s.show_origin and origin != '' -%}
        <p class="brand-story__origin">{%- render 'icon', name: 'home' -%}<span>{{ origin | escape }}</span></p>
      {%- endif -%}

      {%- if s.button_label != blank and s.button_link != blank -%}
        <div class="media-text__actions">
          <a class="btn btn--secondary" href="{{ s.button_link }}">
            <span>{{ s.button_label | escape }}</span>{%- render 'icon', name: 'arrow-right' -%}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand story",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "bone", "label": "Bone" },
        { "value": "oat", "label": "Oat" },
        { "value": "moss", "label": "Moss (dark)" },
        { "value": "white", "label": "White" }
      ],
      "default": "bone"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "product",
      "id": "image_product",
      "label": "Or use a product's photo"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description (alt text)"
    },
    {
      "type": "select",
      "id": "media_side",
      "label": "Image side (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Image shape",
      "options": [
        { "value": "arch", "label": "Arch" },
        { "value": "rounded", "label": "Rounded" },
        { "value": "square", "label": "Square corners" }
      ],
      "default": "arch"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image proportions",
      "options": [
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "portrait"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Named for the Lakes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why they are named after fells and dales."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Text",
      "default": "<p>Borrowdale, Coniston, Grasmere, Windermere. The range takes its names from the places the walking gets done at weekends, which is also where most of the thinking about these beds happened.</p><p>Each one is built around a sleeping style rather than a price point. Curlers get walls. Sprawlers get surface. Old joints get foam that does not bottom out. Where a bed is fibre-filled rather than foam, the product page says so.</p>"
    },
    {
      "type": "text",
      "id": "places",
      "label": "Place names",
      "default": "Borrowdale, Coniston, Grasmere, Windermere, Kendal, Ambleside",
      "info": "Comma separated. Shown as a quiet typographic line."
    },
    {
      "type": "checkbox",
      "id": "show_origin",
      "label": "Show origin line",
      "default": true,
      "info": "Shows Theme settings → Promises → Origin line, only when it is filled in. Only claim where beds are made if it is true."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Brand story"
    }
  ]
}
{% endschema %}
