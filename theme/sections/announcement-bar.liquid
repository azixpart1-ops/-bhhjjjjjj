{%- comment -%}
  Announcement bar: ONE static line. No rotation, no countdown, no offer
  (the offer lives in the buy box for the size picked, snippets/offer).

  Message "Our promises" (the default) is built from Theme settings, never
  typed in, so the bar can't claim a delivery, trial or collection promise
  the store doesn't make. With the published policies it reads:
    "Free UK delivery over £40 · 100 nights to decide · Free collection"
  Each part drops out when its setting is off:
    Free UK delivery over £X   free_shipping_enable + free_shipping_threshold
                               ("Free UK delivery" when the threshold is 0)
    N nights to decide         trial_enable + trial_nights
    Free collection            trial_free_collection (with the trial on)
  "Custom text" shows the text setting instead. A bar with nothing to say
  renders nothing (an editor note in the theme editor).

  The <announcement-bar> element (assets/cart.js) is inert with one line.
{%- endcomment -%}
{%- liquid
  assign ab = section.settings
  assign ab_msg = ''
  if ab.message == 'custom'
    assign ab_msg = ab.text | default: ''
  else
    assign ab_parts = ''
    if settings.free_shipping_enable
      assign ab_threshold = settings.free_shipping_threshold | default: 0 | times: 100 | round
      if ab_threshold > 0
        assign ab_amount = ab_threshold | money_without_trailing_zeros
        assign ab_part = 'chrome.announcement.part_delivery_over' | t: amount: ab_amount
      else
        assign ab_part = 'chrome.announcement.part_delivery_all' | t
      endif
      assign ab_parts = ab_parts | append: '|' | append: ab_part
    endif
    assign ab_nights = settings.trial_nights | default: 0 | plus: 0
    if settings.trial_enable and ab_nights > 0
      assign ab_part = 'chrome.announcement.part_trial' | t: nights: ab_nights
      assign ab_parts = ab_parts | append: '|' | append: ab_part
      if settings.trial_free_collection
        assign ab_part = 'chrome.announcement.part_collection' | t
        assign ab_parts = ab_parts | append: '|' | append: ab_part
      endif
    endif
    assign ab_list = ab_parts | remove_first: '|' | split: '|'
    assign ab_msg = ab_list | join: ' · '
  endif
  assign ab_check = ab_msg | strip_html | strip
-%}

{%- if ab_check != blank -%}
  <announcement-bar
    class="announcement scheme-{{ ab.color_scheme }}"
    role="region"
    aria-label="{{ 'chrome.announcement.label' | t }}"
    style="--ann-pt: {{ ab.padding_top }}px; --ann-pb: {{ ab.padding_bottom }}px;"
  >
    <div class="page-width announcement__inner">
      <div class="announcement__slides">
        <div class="announcement__slide is-active" data-slide>
          {%- if ab.link != blank -%}
            {%- comment -%} Links inside rich text would nest anchors; flatten them. {%- endcomment -%}
            <a class="announcement__msg announcement__link" href="{{ ab.link }}">
              <div class="announcement__text">{{ ab_msg | replace: '<a ', '<span ' | replace: '</a>', '</span>' }}</div>
              {%- render 'icon', name: 'arrow-right', size: 14, class: 'announcement__arrow-icon' -%}
            </a>
          {%- else -%}
            <div class="announcement__msg"><div class="announcement__text">{{ ab_msg }}</div></div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </announcement-bar>
{%- elsif request.design_mode -%}
  <div class="announcement announcement--empty scheme-{{ ab.color_scheme }}">
    <p class="page-width announcement__inner small">{{ 'chrome.announcement.empty_editor' | t }}</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "div",
  "class": "announcement-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "One line, always on screen. Our promises is built from Theme settings (free delivery threshold, trial nights, free collection), so it changes when they do and never claims a promise that is switched off."
    },
    {
      "type": "select",
      "id": "message",
      "label": "Message",
      "options": [
        { "value": "promises", "label": "Our promises (theme settings)" },
        { "value": "custom", "label": "Custom text" }
      ],
      "default": "promises"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Custom text",
      "default": "Named for the Lakes, built for real sleep",
      "info": "Only used when Message is Custom text. Keep store-wide claims in theme settings, and no countdowns or offers here."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "bone", "label": "Bone" },
        { "value": "oat", "label": "Oat" },
        { "value": "moss", "label": "Moss" },
        { "value": "white", "label": "White" }
      ],
      "default": "moss"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Extra top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Extra bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ]
}
{% endschema %}
