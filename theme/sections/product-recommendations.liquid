{%- comment -%}
  Product recommendations from Shopify's recommendation engine.

  The page renders an empty shell; <product-recommendations> (product.js)
  fetches this same section through
    {{ routes.product_recommendations_url }}?section_id=…&product_id=…&limit=…&intent=…
  when it nears the viewport, and swaps the cards in. No results → the
  section removes itself. Cards are the shared product-card snippet, so the
  "Bella's match" chip, honest stock and quick add all come along.
  A swipe row on phones, a grid on desktop.
{%- endcomment -%}
{{ 'product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product.js' | asset_url }}" defer="defer"></script>
{%- render 'section-styles', section: section -%}
{%- liquid
  assign limit = section.settings.limit | default: 4 | plus: 0
  assign intent = section.settings.intent | default: 'related'
  assign has_product = false
  if product != blank and product.id != blank
    assign has_product = true
  endif
  assign show_quick = true
  if section.settings.show_quick_add == false
    assign show_quick = false
  endif
  assign cols = limit
  if cols > 4
    assign cols = 4
  endif
-%}
{%- if has_product or request.design_mode -%}
<section
  id="{{ section.id }}-wrap"
  class="section scheme-{{ section.settings.color_scheme }} product-recs"
  aria-labelledby="{{ section.id }}-heading"
  {%- if recommendations.performed? == false and has_product and request.design_mode == false %} hidden{% endif %}
>
  <div class="page-width">
    <div class="section-head section-head--split">
      <div class="stack stack--xs">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="h2" id="{{ section.id }}-heading">{{ section.settings.heading | escape }}</h2>
      </div>
    </div>

    <product-recommendations
      class="product-recs__body"
      data-section-id="{{ section.id }}"
      {%- if has_product %}
        data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}&intent={{ intent }}"
      {%- endif %}
    >
      {%- if recommendations.performed? and recommendations.products_count > 0 -%}
        <slider-row class="product-recs__slider" id="{{ section.id }}-slider">
          <ul class="slider-row slider-row--grid-desktop product-recs__list" data-slider-track role="list" style="--slider-cols: {{ cols }}" data-recs-list>
            {%- for rec in recommendations.products -%}
              <li class="product-recs__item">
                {%- render 'product-card',
                  product: rec,
                  show_quick_add: show_quick,
                  heading_level: 'h3',
                  index: forloop.index,
                  sizes: '(min-width: 1320px) 300px, (min-width: 990px) 23vw, (min-width: 750px) 40vw, 78vw'
                -%}
              </li>
            {%- endfor -%}
          </ul>
        </slider-row>
      {%- elsif has_product == false or request.design_mode and recommendations.performed? == false -%}
        {%- if request.design_mode -%}
          <ul class="grid grid--4 product-recs__list" role="list">
            {%- for i in (1..cols) -%}
              <li>{%- render 'product-card', product: nil, placeholder_index: i -%}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      {%- endif -%}
    </product-recommendations>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Product recommendations",
  "tag": "div",
  "class": "product-recs-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Chosen automatically by Shopify from what's bought and viewed together. Tune them with the Search & Discovery app."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "More from the range"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Other beds worth a look"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "Show",
      "options": [
        { "value": "related", "label": "Similar products" },
        { "value": "complementary", "label": "Goes well with (set up in Search & Discovery)" }
      ],
      "default": "related"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Number of products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add",
      "default": true
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "bone", "label": "Bone" },
        { "value": "oat", "label": "Oat" },
        { "value": "moss", "label": "Moss" },
        { "value": "white", "label": "White" }
      ],
      "default": "bone"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Product recommendations"
    }
  ]
}
{% endschema %}
