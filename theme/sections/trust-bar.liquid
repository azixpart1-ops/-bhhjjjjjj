{%- comment -%}
  Trust bar — risk removed before the first price is seen.

  Blocks: icon + title + supporting line (+ optional link). Text may use
  [trial_nights], [guarantee_years], [threshold] (free-delivery amount),
  [cutoff], [origin], [trial_terms_short], [trial_terms] — filled from Theme
  settings, and a block that names a
  promise which is switched off hides itself (so the bar can never claim a
  trial or free delivery the shop isn't offering).

  With no blocks (e.g. added to another template with "settings": {}) the bar
  builds itself from Theme settings: trial, guarantee, free delivery, origin
  line (if set), secure checkout.

  Phones: one swipeable row with an edge peek, or a 2-up grid.
{%- endcomment -%}
{%- unless template.name == 'index' -%}{{ 'sections.css' | asset_url | stylesheet_tag }}{%- endunless -%}
{%- render 'section-styles', section: section -%}
{%- capture ph_cutoff -%}{%- render 'delivery-promise', mode: 'time' -%}{%- endcapture -%}
{%- liquid
  assign s = section.settings
  assign ph_cutoff = ph_cutoff | strip
  assign ph_nights = settings.trial_nights | default: 0 | plus: 0 | append: ''
  assign ph_years = settings.guarantee_years | default: 0 | plus: 0 | append: ''
  assign ph_threshold = settings.free_shipping_threshold | default: 0 | times: 100 | round | money_without_trailing_zeros
  assign ph_origin = settings.origin_line | default: '' | strip | escape
  capture terms_short
    render 'trial-terms', short: true
  endcapture
  capture terms
    render 'trial-terms'
  endcapture
  assign ph_terms_short = terms_short | escape
  assign ph_terms = terms | escape

  assign on_trial = false
  if settings.trial_enable and settings.trial_nights > 0
    assign on_trial = true
  endif
  assign on_guarantee = false
  if settings.guarantee_enable and settings.guarantee_years > 0
    assign on_guarantee = true
  endif
  assign on_free = false
  if settings.free_shipping_enable and settings.free_shipping_threshold > 0
    assign on_free = true
  endif
  assign on_dispatch = false
  if settings.delivery_promise_enable and ph_cutoff != ''
    assign on_dispatch = true
  endif
  assign on_origin = false
  if ph_origin != ''
    assign on_origin = true
  endif

  assign list_label = 'core.trust.label' | t
-%}
<div
  class="section trust-bar scheme-{{ s.color_scheme }} trust-bar--{{ s.style | default: 'dividers' }} trust-bar--mobile-{{ s.mobile_layout | default: 'grid' }} trust-bar--align-{{ s.align | default: 'left' }}"
  id="{{ section.id }}-wrap"
>
  <div class="page-width">
    {%- comment -%} A swipeable row must be reachable by keyboard to scroll it (WCAG 2.1.1). {%- endcomment -%}
    <ul class="trust-bar__list" role="list" aria-label="{{ list_label }}"{% if s.mobile_layout == 'scroll' %} tabindex="0"{% endif %}>
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign raw = b.title | append: ' ' | append: b.text
            assign show = true
            if raw contains '[trial_nights]' and on_trial == false
              assign show = false
            endif
            if raw contains '[trial_terms' and on_trial == false
              assign show = false
            endif
            if raw contains '[guarantee_years]' and on_guarantee == false
              assign show = false
            endif
            if raw contains '[threshold]' and on_free == false
              assign show = false
            endif
            if raw contains '[cutoff]' and on_dispatch == false
              assign show = false
            endif
            if raw contains '[origin]' and on_origin == false
              assign show = false
            endif
            case b.promise
              when 'trial'
                if on_trial == false
                  assign show = false
                endif
              when 'guarantee'
                if on_guarantee == false
                  assign show = false
                endif
              when 'free_delivery'
                if on_free == false
                  assign show = false
                endif
              when 'dispatch'
                if on_dispatch == false
                  assign show = false
                endif
              when 'origin'
                if on_origin == false
                  assign show = false
                endif
            endcase
            if b.title == blank
              assign show = false
            endif

            assign title = b.title | escape | replace: '[trial_nights]', ph_nights | replace: '[guarantee_years]', ph_years | replace: '[threshold]', ph_threshold | replace: '[cutoff]', ph_cutoff | replace: '[origin]', ph_origin | replace: '[trial_terms_short]', ph_terms_short | replace: '[trial_terms]', ph_terms
            assign text = b.text | escape | replace: '[trial_nights]', ph_nights | replace: '[guarantee_years]', ph_years | replace: '[threshold]', ph_threshold | replace: '[cutoff]', ph_cutoff | replace: '[origin]', ph_origin | replace: '[trial_terms_short]', ph_terms_short | replace: '[trial_terms]', ph_terms
          -%}
          {%- if show -%}
            <li class="trust-bar__item" {{ block.shopify_attributes }}>
              <span class="trust-bar__icon">{%- render 'icon', name: b.icon -%}</span>
              <span class="trust-bar__text">
                {%- if b.link != blank -%}
                  <a class="trust-bar__title trust-bar__link" href="{{ b.link }}">{{ title }}</a>
                {%- else -%}
                  <span class="trust-bar__title">{{ title }}</span>
                {%- endif -%}
                {%- if text != blank -%}
                  <span class="trust-bar__sub">{{ text }}</span>
                {%- endif -%}
              </span>
            </li>
          {%- elsif request.design_mode -%}
            <li class="trust-bar__item trust-bar__item--off" {{ block.shopify_attributes }}>
              <span class="trust-bar__icon">{%- render 'icon', name: 'info' -%}</span>
              <span class="trust-bar__text">
                <span class="trust-bar__title">{{ title }}</span>
                <span class="trust-bar__sub">{{ 'home.editor.promise_off' | t }}</span>
              </span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} No blocks: build from Theme settings. {%- endcomment -%}
        {%- if on_trial -%}
          <li class="trust-bar__item">
            <span class="trust-bar__icon">{%- render 'icon', name: 'moon' -%}</span>
            <span class="trust-bar__text">
              <span class="trust-bar__title">{{ 'home.trust.trial_title' | t: nights: ph_nights }}</span>
              <span class="trust-bar__sub">{{ 'home.trust.trial_text' | t: terms_short: terms_short }}</span>
            </span>
          </li>
        {%- endif -%}
        {%- if on_guarantee -%}
          <li class="trust-bar__item">
            <span class="trust-bar__icon">{%- render 'icon', name: 'shield' -%}</span>
            <span class="trust-bar__text">
              <span class="trust-bar__title">{{ 'home.trust.guarantee_title' | t: years: ph_years }}</span>
              <span class="trust-bar__sub">{{ 'home.trust.guarantee_text' | t }}</span>
            </span>
          </li>
        {%- endif -%}
        {%- if on_free -%}
          <li class="trust-bar__item">
            <span class="trust-bar__icon">{%- render 'icon', name: 'truck' -%}</span>
            <span class="trust-bar__text">
              <span class="trust-bar__title">{{ 'home.trust.delivery_title' | t: amount: ph_threshold }}</span>
              <span class="trust-bar__sub">{{ 'home.trust.delivery_text' | t }}</span>
            </span>
          </li>
        {%- endif -%}
        {%- if on_origin -%}
          <li class="trust-bar__item">
            <span class="trust-bar__icon">{%- render 'icon', name: 'home' -%}</span>
            <span class="trust-bar__text">
              <span class="trust-bar__title">{{ ph_origin }}</span>
            </span>
          </li>
        {%- else -%}
          <li class="trust-bar__item">
            <span class="trust-bar__icon">{%- render 'icon', name: 'lock' -%}</span>
            <span class="trust-bar__text">
              <span class="trust-bar__title">{{ 'core.trust.secure_title' | t }}</span>
              <span class="trust-bar__sub">{{ 'home.trust.secure_text' | t }}</span>
            </span>
          </li>
        {%- endif -%}
      {%- endif -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Trust bar",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 6,
  "settings": [
    {
      "type": "paragraph",
      "content": "Text can use [trial_nights], [guarantee_years], [threshold] (free-delivery amount), [cutoff] (dispatch cut-off), [origin] and [trial_terms_short] (e.g. \"Free collection, full refund\", from Theme settings → Promises). They are filled from Theme settings, and a promise that is switched off there hides its block."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "bone", "label": "Bone" },
        { "value": "oat", "label": "Oat" },
        { "value": "moss", "label": "Moss (dark)" },
        { "value": "white", "label": "White" }
      ],
      "default": "oat"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "dividers", "label": "Divided" },
        { "value": "plain", "label": "Plain" },
        { "value": "cards", "label": "Cards" }
      ],
      "default": "dividers"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "On phones",
      "options": [
        { "value": "scroll", "label": "Swipeable row" },
        { "value": "grid", "label": "Two per row" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "moon", "label": "Moon" },
            { "value": "shield", "label": "Shield" },
            { "value": "medal", "label": "Medal" },
            { "value": "truck", "label": "Delivery van" },
            { "value": "return", "label": "Return" },
            { "value": "lock", "label": "Padlock" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "home", "label": "Home" },
            { "value": "heart", "label": "Heart" },
            { "value": "paw", "label": "Paw" },
            { "value": "bed", "label": "Bed" },
            { "value": "ruler", "label": "Ruler" },
            { "value": "clock", "label": "Clock" },
            { "value": "chat", "label": "Chat" },
            { "value": "check-circle", "label": "Tick" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "snowflake", "label": "Snowflake" },
            { "value": "gift", "label": "Gift" }
          ],
          "default": "moon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "[trial_nights]-night sleep trial"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Supporting line",
          "default": "[trial_terms_short]"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "promise",
          "label": "Hide when this promise is off",
          "options": [
            { "value": "none", "label": "Never hide" },
            { "value": "trial", "label": "Sleep trial" },
            { "value": "guarantee", "label": "Guarantee" },
            { "value": "free_delivery", "label": "Free delivery" },
            { "value": "dispatch", "label": "Dispatch cut-off" },
            { "value": "origin", "label": "Origin line" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        { "type": "promise", "settings": { "icon": "moon", "title": "[trial_nights]-night sleep trial", "text": "[trial_terms_short]", "promise": "trial" } },
        { "type": "promise", "settings": { "icon": "shield", "title": "[guarantee_years]-year foam guarantee", "text": "On our orthopaedic memory foam beds, as marked on each bed's page", "promise": "guarantee" } },
        { "type": "promise", "settings": { "icon": "leaf", "title": "Named for the Lakes", "text": "Borrowdale, Coniston, Grasmere, Windermere", "promise": "none" } },
        { "type": "promise", "settings": { "icon": "truck", "title": "Free UK delivery over [threshold]", "text": "Tracked, on every order", "promise": "free_delivery" } }
      ]
    }
  ]
}
{% endschema %}
