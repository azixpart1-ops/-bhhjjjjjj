{%- comment -%}
  Password page — password.json, on layout/password.liquid (which already
  shows the logo or shop name above, and the owner's admin link below).

  "We're getting ready": the message (the Password page message from
  Online Store → Preferences wins when it's filled in), an email sign-up so
  the first visitors aren't lost (tagged "prelaunch" for a launch email; no
  invented discount — any offer is the merchant's own words), the promises
  the shop will make (each from Theme settings, each hidden when off), social
  links, and the store-password form folded away for people who have it.
{%- endcomment -%}
{{ 'pages.css' | asset_url | stylesheet_tag }}
{%- render 'section-styles', section: section -%}
{%- liquid
  assign s = section.settings
  assign heading_id = section.id | append: '-title'
  assign signup_id = section.id | append: '-signup-title'
  assign signup_form_id = 'PasswordSignup-' | append: section.id
  assign pw_form_id = 'PasswordLogin-' | append: section.id
  # Raw merchant text: trust-list escapes it and supplies its own translated default when blank.
  assign promise_label = s.promises_heading | default: '' | strip
-%}

{%- capture password_form -%}
  {%- form 'storefront_password', id: pw_form_id, class: 'main-password__login-form' -%}
    {%- if form.errors -%}
      {%- assign pw_error = true -%}
      <p class="field__error main-password__login-error" id="{{ pw_form_id }}-error" role="alert">
        {%- render 'icon', name: 'info', size: 18 -%}
        <span>{{ 'pages.password.wrong_password' | t }}</span>
      </p>
    {%- endif -%}
    <div class="field">
      <label class="field__label" for="{{ pw_form_id }}-password">{{ 'pages.password.password_label' | t }}</label>
      <div class="main-password__login-row">
        <input
          class="input"
          type="password"
          id="{{ pw_form_id }}-password"
          name="password"
          autocomplete="current-password"
          required
          {%- if form.errors %} aria-invalid="true" aria-describedby="{{ pw_form_id }}-error"{% endif %}
        >
        <button type="submit" class="btn btn--secondary" name="commit">{{ 'pages.password.enter' | t }}</button>
      </div>
    </div>
  {%- endform -%}
{%- endcapture -%}

<section
  class="section main-password scheme-{{ s.color_scheme | default: 'bone' }}"
  id="{{ section.id }}-wrap"
  aria-labelledby="{{ heading_id }}"
>
  <div class="page-width page-width--text">
    {%- if s.image != blank -%}
      <div class="main-password__media media" style="--ratio: 1.6;">
        {%- render 'image',
          image: s.image,
          widths: '360,540,720,960,1200',
          sizes: '(min-width: 750px) 680px, 100vw',
          aspect: 1.6,
          loading: 'eager',
          fetchpriority: 'high'
        -%}
      </div>
    {%- endif -%}

    <header class="pages-header pages-header--center main-password__header">
      {%- if s.eyebrow != blank -%}
        <p class="eyebrow">{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="h1 pages-header__title" id="{{ heading_id }}">{{ s.heading | default: '' | escape }}</h1>
      {%- if shop.password_message != blank -%}
        <div class="rte lede pages-header__lede">{{ shop.password_message }}</div>
      {%- elsif s.text != blank -%}
        <div class="rte lede pages-header__lede">{{ s.text }}</div>
      {%- endif -%}
    </header>

    {%- if s.show_signup -%}
      <div class="card card--lg main-password__signup" role="region" aria-labelledby="{{ signup_id }}">
        <h2 class="h3 main-password__signup-title" id="{{ signup_id }}">{{ s.signup_heading | default: '' | escape }}</h2>
        {%- if s.signup_text != blank -%}
          <p class="muted">{{ s.signup_text | escape }}</p>
        {%- endif -%}
        {%- form 'customer', id: signup_form_id, class: 'main-password__signup-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,prelaunch">
          {%- if form.posted_successfully? -%}
            <p class="form-success form-success--compact" role="status" tabindex="-1" autofocus>
              <span class="form-success__icon">{%- render 'icon', name: 'check-circle', size: 24 -%}</span>
              <span class="form-success__text">{{ s.signup_success | default: '' | escape }}</span>
            </p>
          {%- else -%}
            <div class="field">
              <label class="field__label" for="{{ signup_form_id }}-email">{{ 'pages.password.email_label' | t }}</label>
              <div class="main-password__signup-row">
                <input
                  class="input"
                  type="email"
                  id="{{ signup_form_id }}-email"
                  name="contact[email]"
                  value="{{ form.email | escape }}"
                  autocomplete="email"
                  autocapitalize="off"
                  spellcheck="false"
                  required
                  aria-describedby="{% if form.errors %}{{ signup_form_id }}-error {% endif %}{{ signup_form_id }}-note"
                  {%- if form.errors %} aria-invalid="true"{% endif %}
                >
                <button type="submit" class="btn pages-submit" name="commit">{{ s.signup_button | default: '' | escape }}</button>
              </div>
              {%- if form.errors -%}
                <p class="field__error" id="{{ signup_form_id }}-error" role="alert">
                  {%- render 'icon', name: 'info', size: 16 -%}
                  <span>
                    {%- if form.errors contains 'email' -%}
                      {{ 'pages.password.email_error' | t }}
                    {%- else -%}
                      {{ form.errors | default_errors }}
                    {%- endif -%}
                  </span>
                </p>
              {%- endif -%}
              <p class="field__hint" id="{{ signup_form_id }}-note">{{ s.signup_note | default: '' | escape }}</p>
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}

    {%- if s.show_promises -%}
      <div class="main-password__promises">
        {%- if s.promises_heading != blank -%}
          <h2 class="eyebrow main-password__promises-title">{{ s.promises_heading | escape }}</h2>
        {%- endif -%}
        {%- render 'trust-list', items: 'trial,guarantee,delivery', layout: 'row', size: 'md', label: promise_label -%}
      </div>
    {%- endif -%}

    {%- if s.show_social -%}
      <div class="main-password__social">
        {%- render 'social-icons', size: 22 -%}
      </div>
    {%- endif -%}

    <details class="accordion accordion--boxed main-password__login"{% if pw_error %} open{% endif %}>
      <summary>
        <span class="main-password__login-summary">
          {%- render 'icon', name: 'lock', size: 18 -%}
          <span>{{ 'pages.password.have_password' | t }}</span>
        </span>
      </summary>
      <div class="accordion__content">
        {{ password_form }}
      </div>
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "class": "section-main-password",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "bone", "label": "Bone" },
        { "value": "oat", "label": "Oat" },
        { "value": "moss", "label": "Moss (dark)" },
        { "value": "white", "label": "White" }
      ],
      "default": "bone"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Optional. A calm photo of a dog asleep works well."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Opening soon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We're getting the beds ready."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Message",
      "default": "<p>Orthopaedic memory-foam beds for dogs who have earned a better night's sleep, each named for a corner of the Lakes. We're putting the finishing touches to the shop.</p>",
      "info": "The Password page message in Online Store → Preferences replaces this when it's filled in."
    },
    {
      "type": "header",
      "content": "Email sign-up"
    },
    {
      "type": "checkbox",
      "id": "show_signup",
      "label": "Show email sign-up",
      "default": true,
      "info": "Sign-ups are saved as customers tagged \"prelaunch\" and \"newsletter\"."
    },
    {
      "type": "text",
      "id": "signup_heading",
      "label": "Heading",
      "default": "Be first through the door"
    },
    {
      "type": "text",
      "id": "signup_text",
      "label": "Text",
      "default": "Leave your email and we'll tell you the day we open."
    },
    {
      "type": "text",
      "id": "signup_button",
      "label": "Button label",
      "default": "Tell me"
    },
    {
      "type": "text",
      "id": "signup_note",
      "label": "Note under the field",
      "default": "No spam. Unsubscribe with one click."
    },
    {
      "type": "text",
      "id": "signup_success",
      "label": "Thank-you message",
      "default": "You're on the list. We'll be in touch when the doors open."
    },
    {
      "type": "header",
      "content": "Promises and social"
    },
    {
      "type": "checkbox",
      "id": "show_promises",
      "label": "Show promises",
      "default": true,
      "info": "Trial, guarantee and free delivery, each from Theme settings → Promises."
    },
    {
      "type": "text",
      "id": "promises_heading",
      "label": "Promises heading",
      "default": "What every order will come with"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social links",
      "default": true,
      "info": "From Theme settings → Social."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ]
}
{% endschema %}
