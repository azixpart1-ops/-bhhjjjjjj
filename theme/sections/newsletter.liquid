{%- comment -%}
  Newsletter — reciprocity done plainly: say what they get (sizing help,
  care tips, new beds), how often, and that they can leave any time. An
  optional value offer is merchant-set and off by default. No pre-ticked
  boxes, no confirm-shaming.

  Shopify customer form: signs the visitor up with the "newsletter" tag
  (marketing consent is recorded by Shopify).
{%- endcomment -%}
{%- unless template.name == 'index' -%}{{ 'sections.css' | asset_url | stylesheet_tag }}{%- endunless -%}
{%- render 'section-styles', section: section -%}
{%- liquid
  assign s = section.settings
  assign heading_id = section.id | append: '-heading'
  assign form_id = 'Newsletter-' | append: section.id
  assign field_id = 'NewsletterEmail-' | append: section.id
  assign error_id = 'NewsletterError-' | append: section.id
  assign note_id = 'NewsletterNote-' | append: section.id
  assign success_text = s.success | default: '' | strip | escape
  if success_text == ''
    assign success_text = 'home.newsletter.success' | t
  endif
  assign button_text = s.button_label | default: '' | strip | escape
  if button_text == ''
    assign button_text = 'home.newsletter.submit' | t
  endif
-%}
<section
  class="section newsletter scheme-{{ s.color_scheme }} newsletter--{{ s.layout | default: 'center' }}"
  id="{{ section.id }}-wrap"
  aria-labelledby="{{ heading_id }}"
>
  <div class="page-width">
    <div class="newsletter__inner">
      <div class="newsletter__copy">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        <h2 id="{{ heading_id }}" class="h2">{{ s.heading | default: shop.name | escape }}</h2>
        {%- if s.text != blank -%}<div class="rte newsletter__text">{{ s.text }}</div>{%- endif -%}
        {%- if s.offer != blank -%}
          <p class="newsletter__offer">{%- render 'icon', name: 'gift' -%}<span>{{ s.offer | escape }}</span></p>
        {%- endif -%}
      </div>

      {%- form 'customer', id: form_id, class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="newsletter__success" role="status" tabindex="-1" autofocus>
            {%- render 'icon', name: 'check-circle' -%}<span>{{ success_text }}</span>
          </p>
        {%- else -%}
          <div class="newsletter__field">
            <label class="newsletter__label" for="{{ field_id }}">{{ 'home.newsletter.email_label' | t }}</label>
            <div class="newsletter__row">
              <input
                class="input newsletter__input"
                id="{{ field_id }}"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                autocomplete="email"
                autocapitalize="off"
                spellcheck="false"
                required
                placeholder="{{ 'home.newsletter.email_placeholder' | t }}"
                aria-describedby="{% if form.errors %}{{ error_id }} {% endif %}{{ note_id }}"
                {%- if form.errors %} aria-invalid="true"{% endif %}
              >
              <button type="submit" class="btn btn--secondary newsletter__submit" name="commit">
                {{- button_text -}}
              </button>
            </div>
            {%- if form.errors -%}
              <p class="field__error newsletter__error" id="{{ error_id }}" role="alert">
                {%- if form.errors contains 'email' -%}
                  {{ 'home.newsletter.error_email' | t }}
                {%- else -%}
                  {{ form.errors | default_errors }}
                {%- endif -%}
              </p>
            {%- endif -%}
          </div>
        {%- endif -%}
        <p class="newsletter__note" id="{{ note_id }}">{{ s.note | escape }}</p>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Email sign-up",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "bone", "label": "Bone" },
        { "value": "oat", "label": "Oat" },
        { "value": "moss", "label": "Moss (dark)" },
        { "value": "white", "label": "White" }
      ],
      "default": "oat"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "center", "label": "Centred" },
        { "value": "split", "label": "Text beside form" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "From the dog bed"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sizing help, care tips, the odd new bed."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>An occasional email from us. No daily discounts, no countdowns.</p>"
    },
    {
      "type": "text",
      "id": "offer",
      "label": "Offer (optional)",
      "info": "Only if you really give it, e.g. \"10% off your first bed\"."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Sign up"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small print",
      "default": "Unsubscribe in one click, any time. We never share your address."
    },
    {
      "type": "text",
      "id": "success",
      "label": "Thank-you message",
      "default": "Thanks, you're on the list."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Email sign-up"
    }
  ]
}
{% endschema %}
