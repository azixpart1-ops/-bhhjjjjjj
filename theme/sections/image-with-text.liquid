{%- comment -%}
  Image with text — a photograph beside a short, specific argument.
  Optional checklist (one line per point) for benefits that are easier to
  scan than read. Secondary button only: terracotta is kept for buying.
{%- endcomment -%}
{{ 'sections.css' | asset_url | stylesheet_tag }}
{%- render 'section-styles', section: section -%}
{%- liquid
  assign s = section.settings
  assign heading_id = section.id | append: '-heading'
  assign img = s.image
  if img == blank and s.image_product != blank
    assign img = s.image_product.featured_media.preview_image
  endif
  case s.image_ratio
    when 'square'
      assign ratio = 1
    when 'landscape'
      assign ratio = 1.3333
    else
      assign ratio = 0.8
  endcase
  assign checklist = s.checklist | default: '' | strip | newline_to_br | split: '<br />'
-%}
<section
  class="section media-text{% if img == blank and request.design_mode == false %} media-text--no-media{% endif %} image-with-text scheme-{{ s.color_scheme }} media-text--media-{{ s.media_side | default: 'left' }} media-text--shape-{{ s.image_shape | default: 'rounded' }} media-text--valign-{{ s.valign | default: 'center' }}"
  id="{{ section.id }}-wrap"
  aria-labelledby="{{ heading_id }}"
>
  <div class="page-width media-text__inner">
    {%- if img != blank or request.design_mode -%}
    <div class="media-text__media" data-reveal>
      <div class="media-text__frame" style="--ratio: {{ ratio }};">
        {%- render 'image',
          image: img,
          widths: '360,540,720,900,1100,1300',
          sizes: '(min-width: 990px) 50vw, 100vw',
          alt: s.image_alt,
          aspect: ratio,
          class: 'media-text__img',
          placeholder: 'lifestyle-2'
        -%}
      </div>
    </div>
    {%- endif -%}
    <div class="media-text__copy">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="{{ heading_id }}" class="{{ s.heading_size | default: 'h2' }} media-text__heading">{{ s.heading | default: shop.name | escape }}</h2>
      {%- if s.body != blank -%}
        <div class="rte media-text__body">{{ s.body }}</div>
      {%- endif -%}
      {%- assign has_points = false -%}
      {%- for point in checklist -%}{%- if point != blank -%}{%- assign has_points = true -%}{%- endif -%}{%- endfor -%}
      {%- if has_points -%}
        <ul class="media-text__checklist" role="list">
          {%- for point in checklist -%}
            {%- assign p = point | strip -%}
            {%- if p != blank -%}
              <li>{%- render 'icon', name: 'check' -%}<span>{{ p | escape }}</span></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if s.button_label != blank -%}
        <div class="media-text__actions">
          {%- if s.button_action == 'finder' and settings.finder_enable -%}
            {%- assign finder_url = routes.root_url | append: '/pages/bed-finder' | replace: '//', '/' -%}
            <a href="{{ finder_url }}" class="btn btn--secondary" data-open-finder aria-haspopup="dialog">
              <span>{{ s.button_label | escape }}</span>{%- render 'icon', name: 'arrow-right' -%}
            </a>
          {%- elsif s.button_link != blank -%}
            <a class="btn btn--secondary" href="{{ s.button_link }}">
              <span>{{ s.button_label | escape }}</span>{%- render 'icon', name: 'arrow-right' -%}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "bone", "label": "Bone" },
        { "value": "oat", "label": "Oat" },
        { "value": "moss", "label": "Moss (dark)" },
        { "value": "white", "label": "White" }
      ],
      "default": "bone"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "product",
      "id": "image_product",
      "label": "Or use a product's photo"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description (alt text)"
    },
    {
      "type": "select",
      "id": "media_side",
      "label": "Image side (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Image shape",
      "options": [
        { "value": "rounded", "label": "Rounded" },
        { "value": "arch", "label": "Arch" },
        { "value": "square", "label": "Square corners" }
      ],
      "default": "rounded"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image proportions",
      "options": [
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "valign",
      "label": "Text position",
      "options": [
        { "value": "start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Living with it"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built to be washed, not babied."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "Large" },
        { "value": "h2", "label": "Medium" },
        { "value": "h3", "label": "Small" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Text",
      "default": "<p>Covers zip off and go in the machine at 30°C. On the orthopaedic beds, a waterproof inner liner keeps wet coats, muddy paws and accidents away from the foam.</p><p>That is the difference between a bed you keep and a bed you replace.</p>"
    },
    {
      "type": "textarea",
      "id": "checklist",
      "label": "Checklist",
      "info": "One point per line. Shown with ticks."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop all beds"
    },
    {
      "type": "select",
      "id": "button_action",
      "label": "Button opens",
      "options": [
        { "value": "link", "label": "The link below" },
        { "value": "finder", "label": "The Bed Finder" }
      ],
      "default": "link"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/collections/all"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
