{%- comment -%}
  All collections (/collections). A calm grid of tiles — photo, name, how
  many beds — so a shopper can pick a door by situation. Ends with a Bed
  Finder tile for anyone who would rather be told.

  Source: blocks (hand-picked, in order) when there are any; otherwise every
  collection, sorted by the section setting. Empty collections and the
  "Home page" collection are hidden by default so no tile leads nowhere.
{%- endcomment -%}
{{ 'collection.css' | asset_url | stylesheet_tag }}
{%- render 'section-styles', section: section -%}
{%- liquid
  assign sid = section.id
  assign cs = section.settings.color_scheme | default: 'bone'
  assign cols = section.settings.columns_desktop | default: '3'

  case section.settings.image_ratio
    when 'portrait'
      assign ratio_css = '4 / 5'
    when 'landscape'
      assign ratio_css = '4 / 3'
    else
      assign ratio_css = '1 / 1'
  endcase

  assign use_blocks = false
  if section.blocks.size > 0
    assign use_blocks = true
  endif

  case section.settings.sort
    when 'products_high', 'products_low'
      assign list = collections | sort: 'all_products_count'
    when 'date', 'date_reversed'
      assign list = collections | sort: 'published_at'
    else
      assign list = collections | sort: 'title'
  endcase
  if section.settings.sort == 'products_high' or section.settings.sort == 'date_reversed' or section.settings.sort == 'alphabetical_reversed'
    assign list = list | reverse
  endif

  if use_blocks
    assign source_size = section.blocks.size
  else
    assign source_size = list.size
  endif

  comment
    Count what will actually show, so the empty state is right.
  endcomment
  assign shown = 0
  for i in (1..source_size)
    assign idx = i | minus: 1
    if use_blocks
      assign c = section.blocks[idx].settings.collection
      if c != blank
        assign shown = shown | plus: 1
      endif
    else
      assign c = list[idx]
      if c.handle == 'frontpage' and section.settings.hide_frontpage
        continue
      endif
      if c.all_products_count == 0 and section.settings.hide_empty
        continue
      endif
      assign shown = shown | plus: 1
    endif
  endfor

  assign finder_url = routes.root_url | append: '/pages/bed-finder' | replace: '//', '/'
  assign finder_label = settings.finder_cta_label | default: '' | strip | escape
  if finder_label == ''
    assign finder_label = 'collection.finder_tile.cta' | t
  endif
  assign shop_total = collections.all.products_count | default: 0 | plus: 0
  assign heading = section.settings.heading | default: '' | strip | escape
  if heading == ''
    assign heading = 'collection.list.fallback_heading' | t
  endif
-%}
<section class="section scheme-{{ cs }} main-list-collections" id="{{ sid }}-wrap" aria-labelledby="ListCollectionsTitle-{{ sid }}">
  <div class="page-width">
    <header class="section-head list-collections__head">
      <h1 class="h1" id="ListCollectionsTitle-{{ sid }}">{{ heading }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="lede">{{ section.settings.text }}</div>
      {%- endif -%}
    </header>

    {%- if shown > 0 -%}
      <ul class="grid list-collections__grid list-collections__grid--{{ cols }}" role="list" style="--card-ratio: {{ ratio_css }};">
        {%- assign tile_n = 0 -%}
        {%- for i in (1..source_size) -%}
          {%- liquid
            assign idx = i | minus: 1
            assign blk = nil
            if use_blocks
              assign blk = section.blocks[idx]
              assign c = blk.settings.collection
            else
              assign c = list[idx]
              if c.handle == 'frontpage' and section.settings.hide_frontpage
                continue
              endif
              if c.all_products_count == 0 and section.settings.hide_empty
                continue
              endif
            endif
          -%}
          {%- if c != blank -%}
            {%- liquid
              assign tile_n = tile_n | plus: 1
              assign c_title = c.title | split: ' | ' | first | split: ' – ' | first | split: ' — ' | first | strip
              if c_title == ''
                assign c_title = c.title
              endif
              assign c_image = c.featured_image
              assign c_count = c.all_products_count | default: 0 | plus: 0
              comment
                Beds ("12 beds") only when every product type here names a
                bed or a mattress; kennels or accessories make it products.
              endcomment
              assign c_count_key = 'collection.hero.count'
              for type_name in c.all_types
                assign type_down = type_name | downcase | strip
                if type_down == ''
                  continue
                endif
                unless type_down contains 'bed' or type_down contains 'mattress'
                  assign c_count_key = 'collection.hero.count_products'
                  break
                endunless
              endfor
              assign tile_lazy = 'lazy'
              if tile_n <= 3
                assign tile_lazy = 'eager'
              endif
              assign ph_n = tile_n | minus: 1 | modulo: 6 | plus: 1
              assign ph_name = 'collection-' | append: ph_n
            -%}
            <li class="list-collections__item"{% if blk %} {{ blk.shopify_attributes }}{% endif %}>
              <div class="collection-tile">
                <div class="collection-tile__media">
                  {%- render 'image',
                    image: c_image,
                    widths: '360,480,640,800,1000',
                    sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                    class: 'collection-tile__img',
                    loading: tile_lazy,
                    decorative: true,
                    placeholder: ph_name
                  -%}
                </div>
                <div class="collection-tile__body">
                  <h2 class="collection-tile__title">
                    <a href="{{ c.url }}" class="collection-tile__link">{{ c_title | escape }}</a>
                  </h2>
                  {%- if section.settings.show_count and c_count > 0 -%}
                    <p class="collection-tile__count">{{ c_count_key | t: count: c_count }}</p>
                  {%- endif -%}
                  {%- if section.settings.show_description and c.description != blank -%}
                    <p class="collection-tile__desc">{{ c.description | strip_html | strip | truncatewords: 16, '…' }}</p>
                  {%- endif -%}
                  {%- render 'icon', name: 'arrow-right', class: 'collection-tile__arrow' -%}
                </div>
              </div>
            </li>
          {%- elsif request.design_mode -%}
            <li class="list-collections__item"{% if blk %} {{ blk.shopify_attributes }}{% endif %}>
              <div class="collection-tile collection-tile--placeholder">
                <div class="collection-tile__media">{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg collection-tile__img' }}</div>
                <div class="collection-tile__body">
                  <h2 class="collection-tile__title">{{ 'collection.list.placeholder_title' | t }}</h2>
                  <p class="collection-tile__count">{{ 'collection.list.placeholder_note' | t }}</p>
                </div>
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}

        {%- if section.settings.show_finder_tile -%}
          {%- render 'finder-tile', ratio: ratio_css, heading_level: 'h2', class: 'list-collections__finder' -%}
        {%- endif -%}
      </ul>

    {%- elsif request.design_mode -%}
      <p class="collection-results__editor-note">{{ 'collection.list.editor_note' | t }}</p>
      <ul class="grid list-collections__grid list-collections__grid--{{ cols }}" role="list" style="--card-ratio: {{ ratio_css }};">
        {%- for i in (1..3) -%}
          <li class="list-collections__item">
            <div class="collection-tile collection-tile--placeholder">
              <div class="collection-tile__media">{{ 'collection-' | append: i | placeholder_svg_tag: 'placeholder-svg collection-tile__img' }}</div>
              <div class="collection-tile__body">
                <h2 class="collection-tile__title">{{ 'collection.list.placeholder_title' | t }}</h2>
                <p class="collection-tile__count">{{ 'collection.list.placeholder_note' | t }}</p>
              </div>
            </div>
          </li>
        {%- endfor -%}
        {%- if section.settings.show_finder_tile -%}
          {%- render 'finder-tile', ratio: ratio_css, heading_level: 'h2', class: 'list-collections__finder' -%}
        {%- endif -%}
      </ul>

    {%- else -%}
      <div class="collection-empty">
        <span class="collection-empty__art" aria-hidden="true">{%- render 'icon', name: 'bed' -%}</span>
        <h2 class="h3 collection-empty__heading">{{ 'collection.list.empty_heading' | t }}</h2>
        <p class="collection-empty__text">{{ 'collection.list.empty_text' | t }}</p>
        <div class="collection-empty__actions">
          {%- if settings.finder_enable -%}
            <a href="{{ finder_url }}" class="btn btn--secondary" data-open-finder>
              {%- render 'icon', name: 'paw' -%}
              <span>{{ finder_label }}</span>
            </a>
          {%- endif -%}
          {%- if shop_total > 0 -%}
            <a href="{{ routes.all_products_collection_url }}" class="collection-empty__link">
              <span>{{ 'collection.empty.all_beds' | t }}</span>
              {%- render 'icon', name: 'arrow-right' -%}
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "tag": "div",
  "class": "section-main-list-collections",
  "max_blocks": 24,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by collection"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro",
      "default": "<p>Start with what your dog needs — or let the Bed Finder pick one for you in four quick questions.</p>"
    },
    {
      "type": "paragraph",
      "content": "Add collection blocks to choose which collections show and in what order. With no blocks, every collection shows, sorted below."
    },
    {
      "type": "select",
      "id": "sort",
      "label": "Sort collections by",
      "options": [
        { "value": "alphabetical", "label": "Name, A–Z" },
        { "value": "alphabetical_reversed", "label": "Name, Z–A" },
        { "value": "products_high", "label": "Most beds first" },
        { "value": "products_low", "label": "Fewest beds first" },
        { "value": "date", "label": "Oldest first" },
        { "value": "date_reversed", "label": "Newest first" }
      ],
      "default": "alphabetical"
    },
    {
      "type": "checkbox",
      "id": "hide_empty",
      "label": "Hide collections with no beds",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_frontpage",
      "label": "Hide the \"Home page\" collection",
      "default": true
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "landscape"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show how many products each has",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show a line of each description",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_finder_tile",
      "label": "End with a Bed Finder tile",
      "default": true,
      "info": "Hidden when the Bed Finder is switched off in Theme settings."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "bone", "label": "Bone" },
        { "value": "oat", "label": "Oat" },
        { "value": "moss", "label": "Moss" },
        { "value": "white", "label": "White" }
      ],
      "default": "bone"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ]
}
{% endschema %}
