{%- comment -%}
  Need chips — "Shop by how they sleep, or what they need".

  A row of one-tap shortcuts that let a shopper describe their dog instead
  of decoding product names (choice architecture: name the situation, not
  the SKU). The heading sits above one horizontal row of chips on every
  screen size (swipe on phones, scroll if it ever overflows on desktop), so
  the strip stays a single line and the grid starts higher.

  Each chip goes to its collection once that collection has products, else
  to its link. So a template can name the collection a chip is meant for
  and ship a search link alongside it: the chip runs the search until the
  collection exists and fills, then switches to it with no edit. A chip
  with neither (or only an empty collection) is hidden on the live store
  and shown as a hint in the editor, so the row never contains a dead end.
  The chip for the page you're on is marked aria-current="page".

  Search links can use Shopify's field syntax to stay narrow, e.g.
  /search?q=tag:"nest dog bed"&type=product (URL-encoded in the template);
  main-search shows such a query as its plain value ("nest dog bed"), not
  the syntax. Before the store has any products at all, every chip would
  lead to an empty page, so the row renders nothing on the live store (the
  editor still shows it).
{%- endcomment -%}
{{ 'collection.css' | asset_url | stylesheet_tag }}
{%- render 'section-styles', section: section -%}
{%- liquid
  assign sid = section.id
  assign cs = section.settings.color_scheme | default: 'bone'
  assign current_path = request.path | default: ''
  assign all_url = routes.all_products_collection_url

  comment
    Work out which chips can render, so an empty row renders nothing.
  endcomment
  assign renderable = 0
  for block in section.blocks
    assign chip_collection = block.settings.collection
    if block.settings.link != blank
      assign renderable = renderable | plus: 1
    elsif chip_collection != blank and chip_collection.all_products_count > 0
      assign renderable = renderable | plus: 1
    endif
  endfor
  if section.settings.show_all
    assign renderable = renderable | plus: 1
  endif

  assign show_row = false
  if renderable > 0
    assign show_row = true
  endif
  assign shop_total = collections.all.products_count | default: 0 | plus: 0
  if shop_total == 0
    assign show_row = false
  endif
  if request.design_mode
    assign show_row = true
  endif
-%}
{%- if show_row -%}
  <div class="section scheme-{{ cs }} need-chips" id="{{ sid }}-wrap">
    <nav class="page-width need-chips__inner" aria-labelledby="NeedChipsHeading-{{ sid }}">
      {%- if section.settings.heading != blank -%}
        <h2 class="need-chips__heading" id="NeedChipsHeading-{{ sid }}">{{ section.settings.heading | escape }}</h2>
      {%- else -%}
        <h2 class="visually-hidden" id="NeedChipsHeading-{{ sid }}">{{ 'collection.need_chips.fallback_heading' | t }}</h2>
      {%- endif -%}

      <ul class="need-chips__list" role="list">
        {%- if section.settings.show_all -%}
          {%- liquid
            assign all_current = false
            if current_path == all_url
              assign all_current = true
            endif
          -%}
          <li class="need-chips__item">
            <a class="chip need-chips__chip" href="{{ all_url }}"{% if all_current %} aria-current="page"{% endif %}>
              {%- render 'icon', name: 'bed', class: 'need-chips__icon' -%}
              {%- assign all_label = section.settings.all_label | default: '' | strip | escape -%}
              {%- if all_label == '' -%}{%- assign all_label = 'collection.need_chips.all' | t -%}{%- endif -%}
              <span>{{ all_label }}</span>
            </a>
          </li>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- liquid
            assign chip_collection = block.settings.collection
            assign use_collection = false
            if chip_collection != blank and chip_collection.all_products_count > 0
              assign use_collection = true
            endif
            assign chip_url = ''
            if use_collection
              assign chip_url = chip_collection.url
            elsif block.settings.link != blank
              assign chip_url = block.settings.link
            endif
            assign chip_label = block.settings.label | default: chip_collection.title | default: ''
            assign chip_label = chip_label | split: ' | ' | first | strip

            assign is_current = false
            if chip_url != blank
              assign chip_path = chip_url | split: '?' | first | split: '#' | first
              assign has_query = false
              if chip_url contains '?'
                assign has_query = true
              endif
              if chip_path == current_path and has_query == false
                assign is_current = true
              endif
              if use_collection and collection.handle != blank and chip_collection.handle == collection.handle
                assign is_current = true
              endif
            endif

            assign show_count = false
            if section.settings.show_counts and use_collection
              assign show_count = true
              assign count_key = 'collection.hero.count'
              for type_name in chip_collection.all_types
                assign type_down = type_name | downcase | strip
                if type_down == ''
                  continue
                endif
                unless type_down contains 'bed' or type_down contains 'mattress'
                  assign count_key = 'collection.hero.count_products'
                  break
                endunless
              endfor
            endif
          -%}
          {%- if chip_url != blank and chip_label != '' -%}
            <li class="need-chips__item" {{ block.shopify_attributes }}>
              <a class="chip need-chips__chip" href="{{ chip_url | escape }}"{% if is_current %} aria-current="page"{% endif %}>
                {%- if block.settings.image != blank -%}
                  <span class="need-chips__thumb" aria-hidden="true">
                    {%- render 'image', image: block.settings.image, widths: '64,96', sizes: '32px', class: 'need-chips__img', decorative: true, aspect: 1 -%}
                  </span>
                {%- elsif block.settings.icon != 'none' -%}
                  {%- render 'icon', name: block.settings.icon, class: 'need-chips__icon' -%}
                {%- endif -%}
                <span>{{ chip_label | escape }}</span>
                {%- if show_count -%}
                  <span class="need-chips__count">
                    <span aria-hidden="true">{{ chip_collection.all_products_count }}</span>
                    <span class="visually-hidden">{{ count_key | t: count: chip_collection.all_products_count }}</span>
                  </span>
                {%- endif -%}
              </a>
            </li>
          {%- elsif request.design_mode -%}
            <li class="need-chips__item" {{ block.shopify_attributes }}>
              <span class="chip need-chips__chip need-chips__chip--empty">
                {%- assign hint_label = block.settings.label | default: '' | strip | escape -%}
                {%- if hint_label == '' -%}{%- assign hint_label = 'collection.need_chips.editor_label' | t -%}{%- endif -%}
                <span>{{ hint_label }}</span>
                <span class="need-chips__hint">{{ 'collection.need_chips.editor_hint' | t }}</span>
              </span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Need chips",
  "tag": "div",
  "class": "section-need-chips",
  "max_blocks": 12,
  "settings": [
    {
      "type": "paragraph",
      "content": "One-tap shortcuts by how a dog sleeps or what it needs. Each chip goes to its collection once that has products, otherwise to its link; chips with neither are hidden from shoppers."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by how they sleep, or what they need"
    },
    {
      "type": "checkbox",
      "id": "show_all",
      "label": "Start with an \"All beds\" chip",
      "default": true
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "\"All beds\" chip label",
      "default": "All beds"
    },
    {
      "type": "checkbox",
      "id": "show_counts",
      "label": "Show how many products each collection has",
      "default": false
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "bone", "label": "Bone" },
        { "value": "oat", "label": "Oat" },
        { "value": "moss", "label": "Moss" },
        { "value": "white", "label": "White" }
      ],
      "default": "bone"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Chip",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Curls up tight",
          "info": "Leave blank to use the collection's name."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Used until the collection has products, or when no collection is picked. For example a search such as /search?q=nest, or a narrower one such as /search?q=tag:%22nest%20dog%20bed%22&type=product."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "moon", "label": "Moon" },
            { "value": "paw", "label": "Paw" },
            { "value": "bed", "label": "Bed" },
            { "value": "heart", "label": "Heart" },
            { "value": "shield", "label": "Shield" },
            { "value": "snowflake", "label": "Snowflake" },
            { "value": "ruler", "label": "Ruler" },
            { "value": "weight", "label": "Weight" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "home", "label": "Home" },
            { "value": "bone", "label": "Bone" }
          ],
          "default": "none"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional small round photo. Replaces the icon."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Need chips",
      "blocks": [
        { "type": "chip", "settings": { "label": "Stiff joints", "icon": "heart" } },
        { "type": "chip", "settings": { "label": "Curls up tight", "icon": "moon" } },
        { "type": "chip", "settings": { "label": "Leans on the edge", "icon": "bed" } },
        { "type": "chip", "settings": { "label": "Sprawls out flat", "icon": "ruler" } }
      ]
    }
  ]
}
{% endschema %}
