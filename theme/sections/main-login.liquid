{%- comment -%}
  Customer login (classic accounts) — customers/login.json.

  Log in, and "Forgot your password?" swaps to the recover form in place
  (#recover, pure CSS :target; the server keeps it open after a post, so an
  error or the "check your email" message is never hidden). Guest checkout
  when Shopify offers it. Beside it, the honest reassurance that no account
  is needed to order (friction removal), and what an account is for.
{%- endcomment -%}
{{ 'pages.css' | asset_url | stylesheet_tag }}
<script src="{{ 'customer.js' | asset_url }}" defer="defer"></script>
{%- render 'section-styles', section: section -%}
{%- liquid
  assign s = section.settings
  assign login_id = 'CustomerLogin-' | append: section.id
  assign recover_id = 'CustomerRecover-' | append: section.id
  assign aside_id = section.id | append: '-aside-title'
-%}

{%- capture recover_html -%}
  {%- form 'recover_customer_password', id: recover_id, class: 'customer-form' -%}
    {%- if form.posted_successfully? -%}
      {%- assign recover_open = true -%}
      <div class="form-success form-success--compact" role="status" tabindex="-1" autofocus>
        <span class="form-success__icon">{%- render 'icon', name: 'mail', size: 24 -%}</span>
        <p class="form-success__text">{{ 'pages.customer.recover.success' | t }}</p>
      </div>
    {%- endif -%}
    {%- if form.errors -%}
      {%- assign recover_open = true -%}
      <div class="form-errors" role="alert" tabindex="-1" autofocus id="{{ recover_id }}-errors">
        <h2 class="form-errors__title">
          {%- render 'icon', name: 'info', size: 20 -%}
          <span>{{ 'pages.forms.error_heading' | t }}</span>
        </h2>
        <ul class="form-errors__list">
          {%- for field in form.errors -%}
            <li>
              {%- if field == 'form' -%}
                {{ form.errors.messages[field] }}
              {%- else -%}
                <a href="#{{ recover_id }}-{{ field }}">{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
    <div class="field">
      <label class="field__label" for="{{ recover_id }}-email">{{ 'pages.customer.email' | t }}</label>
      <input
        class="input"
        type="email"
        id="{{ recover_id }}-email"
        name="email"
        autocomplete="email"
        autocapitalize="off"
        spellcheck="false"
        required
        {%- if form.errors %} aria-invalid="true" aria-describedby="{{ recover_id }}-errors"{% endif %}
      >
    </div>
    <button type="submit" class="btn btn--lg btn--block pages-submit">{{ 'pages.customer.recover.submit' | t }}</button>
  {%- endform -%}
{%- endcapture -%}

<section class="section customer main-login scheme-{{ s.color_scheme | default: 'bone' }}" id="{{ section.id }}-wrap">
  <div class="page-width">
    <div class="customer__layout">
      <div class="customer-auth" data-customer-auth>
        <div
          class="card card--lg customer-auth__panel customer-auth__panel--recover{% if recover_open %} is-open{% endif %}"
          id="recover"
          tabindex="-1"
          aria-labelledby="{{ recover_id }}-title"
          role="region"
        >
          <h1 class="h2 customer-auth__title" id="{{ recover_id }}-title" tabindex="-1">{{ 'pages.customer.recover.heading' | t }}</h1>
          <p class="muted customer-auth__lede">{{ 'pages.customer.recover.text' | t }}</p>
          {{ recover_html }}
          <p class="customer-auth__switch">
            <a href="#login" data-auth-show="login">{{ 'pages.customer.recover.back' | t }}</a>
          </p>
        </div>

        <div class="card card--lg customer-auth__panel customer-auth__panel--login" id="login" tabindex="-1" aria-labelledby="{{ login_id }}-title" role="region">
          <h1 class="h2 customer-auth__title" id="{{ login_id }}-title" tabindex="-1">{{ s.heading | default: '' | escape }}</h1>
          {%- if s.text != blank -%}
            <p class="muted customer-auth__lede">{{ s.text | escape }}</p>
          {%- endif -%}

          {%- form 'customer_login', id: login_id, class: 'customer-form' -%}
            {%- if form.errors -%}
              <div class="form-errors" role="alert" tabindex="-1" autofocus id="{{ login_id }}-errors">
                <h2 class="form-errors__title">
                  {%- render 'icon', name: 'info', size: 20 -%}
                  <span>{{ 'pages.forms.error_heading' | t }}</span>
                </h2>
                <ul class="form-errors__list">
                  {%- for field in form.errors -%}
                    <li>
                      {%- if field == 'form' -%}
                        {{ form.errors.messages[field] }}
                      {%- else -%}
                        <a href="#{{ login_id }}-{{ field }}">{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</a>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
            <div class="field">
              <label class="field__label" for="{{ login_id }}-email">{{ 'pages.customer.email' | t }}</label>
              <input
                class="input"
                type="email"
                id="{{ login_id }}-email"
                name="customer[email]"
                autocomplete="email"
                autocapitalize="off"
                spellcheck="false"
                required
                {%- if form.errors %} aria-invalid="true" aria-describedby="{{ login_id }}-errors"{% endif %}
              >
            </div>
            {%- if form.password_needed -%}
              <div class="field">
                <div class="customer-form__label-row">
                  <label class="field__label" for="{{ login_id }}-password">{{ 'pages.customer.password' | t }}</label>
                  <a class="small customer-form__forgot" href="#recover" data-auth-show="recover">{{ 'pages.customer.login.forgot' | t }}</a>
                </div>
                <div class="password-field">
                  <input
                    class="input password-field__input"
                    type="password"
                    id="{{ login_id }}-password"
                    name="customer[password]"
                    autocomplete="current-password"
                    required
                    {%- if form.errors %} aria-invalid="true" aria-describedby="{{ login_id }}-errors"{% endif %}
                  >
                  <button
                    type="button"
                    class="password-field__toggle"
                    data-password-toggle
                    aria-controls="{{ login_id }}-password"
                    aria-pressed="false"
                    data-label-show="{{ 'pages.forms.show_password' | t | escape }}"
                    data-label-hide="{{ 'pages.forms.hide_password' | t | escape }}"
                    hidden
                  >
                    {{- 'pages.forms.show_password' | t -}}
                  </button>
                </div>
              </div>
            {%- endif -%}
            <button type="submit" class="btn btn--lg btn--block pages-submit">{{ 'pages.customer.login.submit' | t }}</button>
          {%- endform -%}

          {%- if shop.checkout.guest_login -%}
            <div class="customer-auth__guest">
              <p class="customer-auth__or"><span>{{ 'pages.customer.login.or' | t }}</span></p>
              {%- form 'guest_login' -%}
                <button type="submit" class="btn btn--secondary btn--lg btn--block">{{ 'pages.customer.login.guest' | t }}</button>
              {%- endform -%}
            </div>
          {%- endif -%}

          <p class="customer-auth__switch">
            {{ 'pages.customer.login.new' | t }}
            <a href="{{ routes.account_register_url }}">{{ 'pages.customer.login.create' | t }}</a>
          </p>
        </div>
      </div>

      {%- if s.show_aside -%}
        <aside class="customer__aside" aria-labelledby="{{ aside_id }}">
          <h2 class="h4" id="{{ aside_id }}">{{ s.aside_heading | default: '' | escape }}</h2>
          {%- if s.aside_text != blank -%}
            <p class="muted">{{ s.aside_text | escape }}</p>
          {%- endif -%}
          <ul class="customer__benefits" role="list">
            <li>{%- render 'icon', name: 'truck', size: 20 -%}<span>{{ 'pages.customer.benefits.track' | t }}</span></li>
            <li>{%- render 'icon', name: 'home', size: 20 -%}<span>{{ 'pages.customer.benefits.addresses' | t }}</span></li>
            <li>{%- render 'icon', name: 'clock', size: 20 -%}<span>{{ 'pages.customer.benefits.faster' | t }}</span></li>
          </ul>
          <a class="btn btn--ghost" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
        </aside>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Log in",
  "class": "section-main-login",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "bone", "label": "Bone" },
        { "value": "oat", "label": "Oat" },
        { "value": "moss", "label": "Moss (dark)" },
        { "value": "white", "label": "White" }
      ],
      "default": "bone"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome back"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Log in to see your orders and tracking."
    },
    {
      "type": "checkbox",
      "id": "show_aside",
      "label": "Show the \"no account needed\" panel",
      "default": true
    },
    {
      "type": "text",
      "id": "aside_heading",
      "label": "Panel heading",
      "default": "No account? No problem."
    },
    {
      "type": "textarea",
      "id": "aside_text",
      "label": "Panel text",
      "default": "You don't need an account to order: checkout works as a guest. An account is just handy for:"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}
