{%- comment -%}
  Quick add — product body. Never placed on a page: it is requested through
  the Section Rendering API by the quick add drawer,
    /products/<handle>?section_id=quick-add-product
  so `product` is the product at that URL. cart.js takes the
  [data-quick-add-product] element out of the response and shows it.

  The buy box is the product area's own snippet in compact mode, so sizes,
  "Recommended for Bella", the per-night line, honest stock and the trial
  promise under the button behave exactly as on the product page.
{%- endcomment -%}
<div
  class="quick-add-product"
  data-quick-add-product
  {%- if product %} data-product-handle="{{ product.handle }}" data-product-id="{{ product.id }}"{% endif %}
>
  {%- if product -%}
    {%- liquid
      assign qa_variant = product.selected_or_first_available_variant
      assign qa_image = qa_variant.featured_image | default: product.featured_image
      assign qa_media_key = 'default'
      if qa_variant.featured_media
        assign qa_media_key = qa_variant.featured_media.id | append: ''
      endif

      comment
        Variant images: a colour that has its own photo should show it here
        too. One pre-rendered thumbnail per distinct variant image (plus the
        product image, for a variant without one), in inert <template>s keyed
        by media id; cart.js swaps the right one in on lunova:variant:change.
        Products whose variants share one image (or have none) get nothing.
      endcomment
      assign qa_media_ids = ','
      assign qa_media_count = 0
      assign qa_media_missing = false
      for v in product.variants
        if v.featured_media
          assign qa_needle = ',' | append: v.featured_media.id | append: ','
          unless qa_media_ids contains qa_needle
            assign qa_media_ids = qa_media_ids | append: v.featured_media.id | append: ','
            assign qa_media_count = qa_media_count | plus: 1
          endunless
        else
          assign qa_media_missing = true
        endif
      endfor
    -%}
    <div class="quick-add-product__summary">
      <a
        href="{{ product.url }}"
        class="quick-add-product__media"
        tabindex="-1"
        aria-hidden="true"
        data-quick-add-media-holder
        data-media-key="{{ qa_media_key }}"
      >
        {%- render 'image',
          image: qa_image,
          widths: '160,240,320,480',
          sizes: '(min-width: 750px) 120px, 96px',
          class: 'quick-add-product__img',
          loading: 'eager',
          decorative: true,
          aspect: 1
        -%}
      </a>
      {%- if qa_media_count > 1 -%}
        {%- assign qa_done = ',' -%}
        {%- for v in product.variants -%}
          {%- if v.featured_media -%}
            {%- assign qa_needle = ',' | append: v.featured_media.id | append: ',' -%}
            {%- unless qa_done contains qa_needle -%}
              {%- assign qa_done = qa_done | append: v.featured_media.id | append: ',' -%}
              <template data-quick-add-media="{{ v.featured_media.id }}">
                {%- render 'image',
                  image: v.featured_media.preview_image,
                  widths: '160,240,320,480',
                  sizes: '(min-width: 750px) 120px, 96px',
                  class: 'quick-add-product__img',
                  loading: 'eager',
                  decorative: true,
                  aspect: 1
                -%}
              </template>
            {%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if qa_media_missing -%}
          <template data-quick-add-media="default">
            {%- render 'image',
              image: product.featured_image,
              widths: '160,240,320,480',
              sizes: '(min-width: 750px) 120px, 96px',
              class: 'quick-add-product__img',
              loading: 'eager',
              decorative: true,
              aspect: 1
            -%}
          </template>
        {%- endif -%}
      {%- endif -%}
      <div class="quick-add-product__info">
        <h2 class="quick-add-product__title" id="QuickAddProductTitle" tabindex="-1">{{ product.title | escape }}</h2>
        {%- if settings.show_product_ratings -%}
          {%- render 'rating', product: product, size: 'sm', show_count: true -%}
        {%- endif -%}
        {%- render 'price', product: product, show_from: true, show_save: true, size: 'md', class: 'quick-add-product__price' -%}
        <a href="{{ product.url }}" class="quick-add-product__details">
          {{- 'chrome.quick_add.view_details' | t -}}
          {%- render 'icon', name: 'arrow-right', size: 14 -%}
        </a>
      </div>
    </div>

    <div class="quick-add-product__buy">
      {%- render 'buy-box', product: product, section: section, compact: true -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Quick add product",
  "class": "quick-add-product-section",
  "settings": []
}
{% endschema %}
