        },
        {
          "type": "checkbox",
          "id": "show_badges",
          "label": "Show badges from tags",
          "default": true,
          "info": "Tag a product badge:Your text to add a badge, e.g. badge:New colour."
        },
        {
          "type": "checkbox",
          "id": "trim_title",
          "label": "Hide anything after \" | \" in the title",
          "default": true,
          "info": "Keeps SEO suffixes like \"| PawLunova\" out of the heading."
