        { "value": "thumbnails", "label": "Large image with thumbnails" },
        { "value": "grid", "label": "Two-column grid" }
      ],
      "default": "thumbnails",
      "info": "Phones always get a swipeable carousel with a counter and dots."
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Image shape",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "adapt", "label": "Match the first image" }
      ],
      "default": "square"
    },
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "label": "Open images full screen with zoom",
      "default": true
    },
    {
      "type": "header",
      "content": "Buying"
    },
    {
      "type": "checkbox",
      "id": "sticky_column",
      "label": "Keep the shorter column in view on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_atc",
      "label": "Show sticky add-to-basket bar",
      "default": true,
