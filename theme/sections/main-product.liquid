{%- comment -%}
  Main product — gallery + the buy column.

  The buy column is a stack of reorderable blocks, set out in the order a
  buyer actually decides: what is it → is it any good → what does it cost
  (and what is that per night) → which size → is it in stock, when will it
  come → add → what if it's wrong → why it's worth it → the detail.
  Each block is drawn by snippets/buy-box.liquid, which the quick-add drawer
  uses too, so the two never drift apart. App blocks (reviews summaries,
  Klarna messaging, bundles) can go anywhere in the column.

  Also here: the size guide dialog, the sticky add-to-basket bar, Product +
  BreadcrumbList structured data, and the "recently viewed" record.
{%- endcomment -%}
{{ 'product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product.js' | asset_url }}" defer="defer"></script>
{%- render 'section-styles', section: section -%}

{%- liquid
  comment
    The selected variant: ?variant= > merchant's "most chosen" > first
    available. (Same rule as snippets/buy-box.liquid; product.js then applies
    the Bed Finder size when there's no ?variant=.)
  endcomment
  assign current = product.selected_or_first_available_variant
  if product != blank and product.selected_variant == blank and product.has_only_default_variant == false
    assign mc_found = false
    for v in product.variants
      if v.available and v.metafields.custom.most_chosen.value == true
        assign current = v
        assign mc_found = true
        break
      endif
    endfor
    assign mc_value = section.settings.most_chosen_value | default: '' | downcase | strip
    if mc_found == false and mc_value != ''
      for v in product.variants
        if v.available
          for o in v.options
            assign od = o | downcase | strip
            if od == mc_value
              assign current = v
              assign mc_found = true
              break
            endif
          endfor
        endif
        if mc_found
          break
        endif
      endfor
    endif
  endif

  assign layout = section.settings.gallery_layout | default: 'thumbnails'
  assign sg_block = section.blocks | where: 'type', 'size_guide' | first
  assign bb_block = section.blocks | where: 'type', 'buy_buttons' | first

  assign has_size = false
  for option in product.options_with_values
    assign oname = option.name | downcase
    if oname contains 'size'
      assign has_size = true
      break
    endif
  endfor
-%}

{%- if product == blank or product.id == blank -%}
  <section
    id="{{ section.id }}-wrap"
    class="section scheme-{{ section.settings.color_scheme }} main-product main-product--placeholder"
    aria-labelledby="ProductTitle-{{ section.id }}"
  >
    <div class="page-width">
      <div class="main-product__grid">
        <div class="main-product__media">
          <div class="gallery gallery--single">
            <div class="gallery__viewer">
              <div class="gallery__track">
                <div class="gallery__slide is-active">
                  <div class="gallery__media" style="--gallery-ratio: 1 / 1">
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg gallery__img' }}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="main-product__info">
          <div class="buy-box">
            <h1 class="h2 buy-box__title" id="ProductTitle-{{ section.id }}">{{ 'product.placeholder.title' | t }}</h1>
            <p class="buy-box__tagline buy-box__tagline--serif">{{ 'product.placeholder.text' | t }}</p>
          </div>
        </div>
      </div>
    </div>
  </section>
{%- else -%}
  <section
    id="{{ section.id }}-wrap"
    class="section scheme-{{ section.settings.color_scheme }} main-product main-product--{{ layout }}{% if section.settings.sticky_column %} main-product--sticky{% endif %}"
    data-product-scope
    data-section-id="{{ section.id }}"
    data-product-id="{{ product.id }}"
    data-record-view="{{ product.handle }}"
    aria-label="{{ product.title | split: ' | ' | first | escape }}"
  >
    <div class="page-width">
      <div class="main-product__grid">
        <div class="main-product__media">
          {%- render 'product-gallery',
            product: product,
            section: section,
            variant: current,
            layout: layout,
            ratio: section.settings.media_ratio,
            zoom: section.settings.enable_zoom
          -%}
        </div>

        <div class="main-product__info" id="ProductBuy">
          <div class="buy-box" data-buy-box>
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when '@app' -%}
                  <div class="pblock pblock--app">
                    {% render block %}
                  </div>
                {%- else -%}
                  {%- render 'buy-box', product: product, section: section, block: block, variant: current -%}
              {%- endcase -%}
            {%- endfor -%}
          </div>
          {%- render 'buy-box', product: product, section: section, part: 'data', variant: current -%}
        </div>
      </div>
    </div>

    {%- if has_size or sg_block -%}
      {%- render 'size-guide', product: product, section: section, variant: current, block: sg_block -%}
    {%- endif -%}

    {%- if section.settings.enable_sticky_atc and bb_block -%}
      {%- render 'sticky-atc', product: product, section: section, variant: current -%}
    {%- endif -%}
  </section>

  {%- render 'product-jsonld', product: product, variant: current -%}
{%- endif -%}

{% schema %}
{
  "name": "Product information",
  "tag": "div",
  "class": "main-product-section",
  "settings": [
    {
      "type": "header",
      "content": "Gallery"
