{%- comment -%}
  Main product, gallery + the buy column.

  The buy column is a stack of reorderable blocks, set out in the order a
  buyer actually decides: what is it → is it any good → what does it cost
  (and what is that per night) → which size → is it in stock, when will it
  come → add → what if it's wrong → why it's worth it → the detail.
  Each block is drawn by snippets/buy-box.liquid, which the quick-add drawer
  uses too, so the two never drift apart. App blocks (reviews summaries,
  Klarna messaging, bundles) can go anywhere in the column.

  Also here: the size guide dialog, the sticky add-to-basket bar, Product +
  BreadcrumbList structured data, and the "recently viewed" record.

  October 2026 audit (docs/PawLunova_Mobile_Conversion_Audit_Oct2026.pdf S05):
  on phones a single back link replaces the breadcrumb (PDP-01); no size is
  pre-selected (PDP-09: "From £109" and "Choose a size" until one is picked,
  unless ?variant= names one, the Bed Finder's stored pick applies, or there
  is only one size); the buy column runs subtitle, price + per-night, size
  cards + size help, offer line, delivery dates, button, trust row with its
  sheets, bullets, "What's inside", "Worth it?", Q&A, the story (collapsed),
  the collapsed rows and "Complete their bed". Every claim comes from the
  product's own data or the published policies (snippets/pdp-*).
{%- endcomment -%}
{{ 'product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product.js' | asset_url }}" defer="defer"></script>
{%- render 'section-styles', section: section -%}

{%- liquid
  comment
    The selected variant: ?variant= > merchant's "most chosen" > the first
    available in size order. snippets/buy-box works it out (its variant_id
    part), so this page and the quick-add drawer always agree; product.js
    then applies the Bed Finder size when there's no ?variant=.
  endcomment
  assign current = product.selected_or_first_available_variant
  if product != blank and product.selected_variant == blank and product.has_only_default_variant == false
    capture cur_id
      render 'buy-box', product: product, section: section, part: 'variant_id'
    endcapture
    assign cur_id = cur_id | strip | plus: 0
    for v in product.variants
      if v.id == cur_id
        assign current = v
        break
      endif
    endfor
  endif

  assign layout = section.settings.gallery_layout | default: 'thumbnails'
  assign sg_block = section.blocks | where: 'type', 'size_guide' | first
  assign bb_block = section.blocks | where: 'type', 'buy_buttons' | first

  comment
    The size guide only earns its place when there's a size to choose: a
    single "One size" value gets a plain line instead (variant-picker).
  endcomment
  assign has_size = false
  for option in product.options_with_values
    assign oname = option.name | downcase
    if oname contains 'size'
      if option.values.size > 1
        assign has_size = true
      endif
      break
    endif
  endfor
  assign vp_block = section.blocks | where: 'type', 'variant_picker' | first

  comment
    No size pre-selected (audit PDP-09) when the product has a size to
    choose, no ?variant= names one and the section setting is on. product.js
    applies the Bed Finder's stored size; "Most chosen" stays a label.
  endcomment
  assign size_pending = false
  if has_size and product.selected_variant == blank and section.settings.preselect_size != true
    assign size_pending = true
  endif
  assign sg_hints = false
  if vp_block and vp_block.settings.show_size_hints
    assign sg_hints = true
  endif
-%}

{%- if product == blank or product.id == blank -%}
  <section
    id="{{ section.id }}-wrap"
    class="section scheme-{{ section.settings.color_scheme }} main-product main-product--placeholder"
    aria-labelledby="ProductTitle-{{ section.id }}"
  >
    <div class="page-width">
      <div class="main-product__grid">
        <div class="main-product__media">
          <div class="gallery gallery--single">
            <div class="gallery__viewer">
              <div class="gallery__track">
                <div class="gallery__slide is-active">
                  <div class="gallery__media" style="--gallery-ratio: 1 / 1">
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg gallery__img' }}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="main-product__info">
          <div class="buy-box">
            <h1 class="h2 buy-box__title" id="ProductTitle-{{ section.id }}">{{ 'product.placeholder.title' | t }}</h1>
            <p class="buy-box__tagline buy-box__tagline--serif">{{ 'product.placeholder.text' | t }}</p>
          </div>
        </div>
      </div>
    </div>
  </section>
{%- else -%}
  <section
    id="{{ section.id }}-wrap"
    class="section scheme-{{ section.settings.color_scheme }} main-product main-product--{{ layout }}{% if section.settings.sticky_column %} main-product--sticky{% endif %}"
    data-product-scope
    data-section-id="{{ section.id }}"
    data-product-id="{{ product.id }}"
    data-record-view="{{ product.handle }}"
    aria-label="{{ product.title | split: ' | ' | first | escape }}"
  >
    <div class="page-width">
      <div class="main-product__grid">
        <div class="main-product__media">
          {%- if section.settings.show_back_link -%}
            {%- render 'pdp-back-link', product: product, collection: collection -%}
          {%- endif -%}
          {%- render 'product-gallery',
            product: product,
            section: section,
            variant: current,
            layout: layout,
            ratio: section.settings.media_ratio,
            zoom: section.settings.enable_zoom
          -%}
        </div>

        <div class="main-product__info" id="ProductBuy">
          <div class="buy-box" data-buy-box>
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when '@app' -%}
                  <div class="pblock pblock--app">
                    {% render block %}
                  </div>
                {%- else -%}
                  {%- render 'buy-box', product: product, section: section, block: block, variant: current, pending: size_pending -%}
              {%- endcase -%}
            {%- endfor -%}
          </div>
          {%- render 'buy-box', product: product, section: section, part: 'data', variant: current, pending: size_pending -%}
        </div>
      </div>
    </div>

    {%- if has_size or sg_block -%}
      {%- render 'size-guide', product: product, section: section, variant: current, block: sg_block, hints: sg_hints, pending: size_pending -%}
    {%- endif -%}

    {%- if section.settings.enable_sticky_atc and bb_block -%}
      {%- render 'sticky-atc', product: product, section: section, variant: current, pending: size_pending -%}
    {%- endif -%}
  </section>

  {%- render 'product-jsonld', product: product, variant: current -%}
{%- endif -%}

