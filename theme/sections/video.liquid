{%- comment -%}
  Video — click to load. Nothing from YouTube or Vimeo is requested until
  the visitor presses play (fast, private). Shopify-hosted videos are
  inserted from a <template> on play. Without JavaScript the play control
  is a plain link to the video (or the hosted file plays from <noscript>).
{%- endcomment -%}
{%- unless template.name == 'index' -%}{{ 'sections.css' | asset_url | stylesheet_tag }}{%- endunless -%}
<script src="{{ 'sections.js' | asset_url }}" defer="defer"></script>
{%- render 'section-styles', section: section -%}
{%- liquid
  assign s = section.settings
  assign heading_id = section.id | append: '-heading'
  case s.ratio
    when '4-3'
      assign ratio_num = '1.3333'
    when '1-1'
      assign ratio_num = '1'
    when '9-16'
      assign ratio_num = '0.5625'
    else
      assign ratio_num = '1.7778'
  endcase

  assign kind = 'none'
  assign embed_url = ''
  assign external_url = ''
  if s.video != blank
    assign kind = 'hosted'
  elsif s.video_url != blank
    if s.video_url.type == 'youtube'
      assign kind = 'youtube'
      assign embed_url = 'https://www.youtube-nocookie.com/embed/' | append: s.video_url.id | append: '?autoplay=1&rel=0&playsinline=1'
      assign external_url = 'https://www.youtube.com/watch?v=' | append: s.video_url.id
    elsif s.video_url.type == 'vimeo'
      assign kind = 'vimeo'
      assign embed_url = 'https://player.vimeo.com/video/' | append: s.video_url.id | append: '?autoplay=1&dnt=1'
      assign external_url = 'https://vimeo.com/' | append: s.video_url.id
    endif
  endif

  assign poster = s.poster
  if poster == blank and kind == 'hosted'
    assign poster = s.video.preview_image
  endif
  assign title = s.video_title | default: s.heading | default: shop.name | strip_html
  assign play_label = 'home.video.play' | t: title: title
-%}
{%- if kind != 'none' or request.design_mode -%}
<section
  class="section video-section scheme-{{ s.color_scheme }}{% if s.full_width %} video-section--full{% endif %}"
  id="{{ section.id }}-wrap"
  {%- if s.heading != blank %} aria-labelledby="{{ heading_id }}"{% endif %}
>
  <div class="page-width">
    {%- if s.heading != blank or s.eyebrow != blank or s.text != blank -%}
      <header class="section-head section-head--center">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 id="{{ heading_id }}" class="h2">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="rte lede muted">{{ s.text }}</div>{%- endif -%}
      </header>
    {%- endif -%}

    <div class="video-section__frame" style="--ratio-num: {{ ratio_num }};" data-video data-video-kind="{{ kind }}">
      {%- if kind == 'none' -%}
        <div class="video-section__poster">
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
        {%- if request.design_mode -%}<p class="editor-note video-section__hint">{{ 'home.editor.video_empty' | t }}</p>{%- endif -%}
      {%- else -%}
        <div class="video-section__poster" aria-hidden="true">
          {%- if poster != blank -%}
            {%- render 'image', image: poster, widths: '480,720,960,1280,1600,1920', sizes: '(min-width: 1360px) 1320px, 100vw', decorative: true, class: 'video-section__poster-img' -%}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        {%- if kind == 'hosted' -%}
          <button type="button" class="video-section__play" data-video-play aria-label="{{ play_label }}">
            <span class="video-section__play-icon">{%- render 'icon', name: 'play' -%}</span>
          </button>
          <template data-video-template>
            {{ s.video | video_tag: controls: true, autoplay: true, playsinline: true, preload: 'metadata', class: 'video-section__media' }}
          </template>
          <noscript>{{ s.video | video_tag: controls: true, preload: 'none', class: 'video-section__media' }}</noscript>
        {%- else -%}
          <a
            class="video-section__play"
            href="{{ external_url }}"
            data-video-play
            data-embed-url="{{ embed_url | escape }}"
            data-embed-title="{{ title | escape }}"
            aria-label="{{ play_label }}"
          >
            <span class="video-section__play-icon">{%- render 'icon', name: 'play' -%}</span>
          </a>
        {%- endif -%}
      {%- endif -%}
    </div>
    {%- if s.caption != blank -%}
      <p class="video-section__caption">{{ s.caption | escape }}</p>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Video",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "bone", "label": "Bone" },
        { "value": "oat", "label": "Oat" },
        { "value": "moss", "label": "Moss (dark)" },
        { "value": "white", "label": "White" }
      ],
      "default": "bone"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See it with a dog on it."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify-hosted video"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Or a YouTube / Vimeo link",
      "accept": ["youtube", "vimeo"],
      "info": "Used when no Shopify-hosted video is chosen. Nothing loads from YouTube or Vimeo until play is pressed."
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Cover image",
      "info": "Strongly recommended for YouTube and Vimeo videos."
    },
    {
      "type": "text",
      "id": "video_title",
      "label": "Video description",
      "info": "Read by screen readers, e.g. \"A Labrador settling onto the Kendal bed\"."
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Proportions",
      "options": [
        { "value": "16-9", "label": "16:9" },
        { "value": "4-3", "label": "4:3" },
        { "value": "1-1", "label": "Square" },
        { "value": "9-16", "label": "Portrait 9:16" }
      ],
      "default": "16-9"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Video"
    }
  ]
}
{% endschema %}
