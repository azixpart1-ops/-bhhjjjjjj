[
  {
    "name": "theme_info",
    "theme_name": "Lunova",
    "theme_version": "1.0.0",
    "theme_author": "PawLunova",
    "theme_documentation_url": "https://pawlunova.co.uk",
    "theme_support_url": "https://pawlunova.co.uk/pages/contact"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 260,
        "step": 2,
        "unit": "px",
        "label": "Logo width",
        "default": 140
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Square image, at least 64 × 64px."
      }
    ]
  },
  {
    "name": "Colours",
    "settings": [
      {
        "type": "paragraph",
        "content": "Defaults are contrast-checked (WCAG 2.2 AA) against the grounds they sit on. If you change them, keep text at 4.5:1 and control borders, stars and focus rings at 3:1."
      },
      {
        "type": "header",
        "content": "Grounds"
      },
      {
        "type": "color",
        "id": "color_bg",
        "label": "Background (bone)",
        "default": "#FAF6EF"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Raised surface (oat)",
        "default": "#F1E9DB"
      },
      {
        "type": "color",
        "id": "color_sand",
        "label": "Hairlines and dividers (sand)",
        "default": "#E3D7C3",
        "info": "Decorative only — never used for text or control borders."
      },
      {
        "type": "color",
        "id": "color_dark",
        "label": "Dark sections (moss)",
        "default": "#1A2B24"
      },
      {
        "type": "header",
        "content": "Text"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Text (ink)",
        "default": "#17150F"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Secondary text",
        "default": "#5E5442"
      },
      {
        "type": "color",
        "id": "color_control_line",
        "label": "Borders on controls",
        "default": "#8C7F66",
        "info": "Inputs, size buttons, chips. Needs 3:1 against the background."
      },
      {
        "type": "color",
        "id": "color_on_dark",
        "label": "Text on dark sections",
        "default": "#F1E9DB"
      },
      {
        "type": "color",
        "id": "color_on_dark_muted",
        "label": "Secondary text on dark sections",
        "default": "#A9BBB1"
      },
      {
        "type": "header",
        "content": "Actions and signals"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Buy buttons (terracotta)",
        "default": "#B4532A",
        "info": "Reserved for buying actions — Add to basket, Checkout, the finder's final Add. Keeping it rare is what makes it stand out."
      },
      {
        "type": "color",
        "id": "color_accent_text",
        "label": "Text on buy buttons",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_highlight",
        "label": "Highlight (stars, small badges)",
        "default": "#A87821"
      },
      {
        "type": "color",
        "id": "color_alert",
        "label": "Low stock",
        "default": "#A8340E",
        "info": "Only ever shown for real low stock."
      },
      {
        "type": "color",
        "id": "color_success",
        "label": "Success (in stock, free delivery unlocked)",
        "default": "#2E6B4F"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Headings",
        "default": "playfair_display_n4"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body",
        "default": "dm_sans_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Heading size",
        "default": 100
      },
      {
        "type": "range",
        "id": "body_size",
        "min": 14,
        "max": 18,
        "step": 1,
        "unit": "px",
        "label": "Body text size",
        "default": 16
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "select",
        "id": "page_width",
        "label": "Page width",
        "options": [
          { "value": "1200", "label": "1200px" },
          { "value": "1320", "label": "1320px" },
          { "value": "1440", "label": "1440px" }
        ],
        "default": "1320"
      },
      {
        "type": "range",
        "id": "radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "label": "Corner radius",
        "default": 14
      },
      {
        "type": "select",
        "id": "button_shape",
        "label": "Button shape",
        "options": [
          { "value": "pill", "label": "Pill" },
          { "value": "soft", "label": "Soft corners" },
          { "value": "square", "label": "Square" }
        ],
        "default": "pill"
      },
      {
        "type": "checkbox",
        "id": "animations",
        "label": "Reveal sections on scroll",
        "info": "Visitors who ask their device for reduced motion never see movement either way.",
        "default": true
      }
    ]
  },
  {
    "name": "Promises",
    "settings": [
      {
        "type": "paragraph",
        "content": "These numbers appear under every Add to basket button, in the basket and across the site. They are promises to customers — make each one match your real policies before you publish."
      },
      {
        "type": "header",
        "content": "Sleep trial"
      },
      {
        "type": "checkbox",
        "id": "trial_enable",
        "label": "Show the sleep trial",
        "default": true
      },
      {
        "type": "number",
        "id": "trial_nights",
        "label": "Trial length (nights)",
        "info": "Must match your real returns policy.",
        "default": 100
      },
      {
        "type": "header",
        "content": "Guarantee"
      },
      {
        "type": "checkbox",
        "id": "guarantee_enable",
        "label": "Show the guarantee",
        "default": true
      },
      {
        "type": "number",
        "id": "guarantee_years",
        "label": "Guarantee length (years)",
        "info": "Must match your written guarantee. Also the basis of the per-night price.",
        "default": 5
      },
      {
        "type": "header",
        "content": "Free delivery"
      },
      {
        "type": "checkbox",
        "id": "free_shipping_enable",
        "label": "Show free delivery threshold",
        "default": true
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free delivery over (£)",
        "info": "Must match your shipping rates in Settings → Shipping and delivery. Drives the progress bar in the basket.",
        "default": 40
      },
      {
        "type": "header",
        "content": "Dispatch countdown"
      },
      {
        "type": "checkbox",
        "id": "delivery_promise_enable",
        "label": "Show dispatch countdown",
        "info": "\"Order within 2h 14m for dispatch today — arrives Thu 8 Oct\". Calculated from the settings below; it never resets or invents a deadline.",
        "default": true
      },
      {
        "type": "text",
        "id": "store_timezone",
        "label": "Store time zone",
        "info": "IANA name, e.g. Europe/London. The cut-off is counted in this time zone, wherever the shopper is.",
        "default": "Europe/London"
      },
      {
        "type": "range",
        "id": "dispatch_cutoff_hour",
        "min": 0,
        "max": 23,
        "step": 1,
        "unit": "h",
        "label": "Same-day dispatch cut-off (24h clock)",
        "info": "Orders before this hour on a dispatch day go out that day. Must be your real cut-off.",
        "default": 15
      },
      {
        "type": "text",
        "id": "dispatch_days",
        "label": "Dispatch days",
        "info": "Comma separated: 0 = Sunday, 1 = Monday … 6 = Saturday.",
        "default": "1,2,3,4,5"
      },
      {
        "type": "number",
        "id": "delivery_min_days",
        "label": "Delivery takes at least (working days)",
        "info": "From dispatch to door. Working days are Monday to Friday, excluding the dates below.",
        "default": 1
      },
      {
        "type": "number",
        "id": "delivery_max_days",
        "label": "Delivery takes at most (working days)",
        "default": 3
      },
      {
        "type": "textarea",
        "id": "holiday_dates",
        "label": "No dispatch or delivery on",
        "info": "One date per line, YYYY-MM-DD. Pre-filled with England & Wales bank holidays to the end of 2027 — add your own closures.",
        "default": "2026-12-25\n2026-12-28\n2027-01-01\n2027-03-26\n2027-03-29\n2027-05-03\n2027-05-31\n2027-08-30\n2027-12-27\n2027-12-28"
      },
      {
        "type": "header",
        "content": "Origin"
      },
      {
        "type": "text",
        "id": "origin_line",
        "label": "Where it's made",
        "info": "e.g. \"Made in Yorkshire\". Only fill this in if it is literally true for every product. Hidden when blank."
      }
    ]
  },
  {
    "name": "Pricing",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_compare_savings",
        "label": "Show savings next to compare-at prices",
        "info": "Only use compare-at prices that were genuinely charged before.",
        "default": true
      },
      {
        "type": "select",
        "id": "savings_format",
        "label": "Show savings as",
        "options": [
          { "value": "amount", "label": "Amount (Save £20)" },
          { "value": "percent", "label": "Percentage (Save 22%)" }
        ],
        "default": "amount"
      },
      {
        "type": "checkbox",
        "id": "show_per_night",
        "label": "Show the per-night price",
        "info": "\"About 9p a night over the 5-year guarantee\", with the sum one tap away. Needs the guarantee switched on.",
        "default": true
      },
      {
        "type": "header",
        "content": "Pay in instalments"
      },
      {
        "type": "checkbox",
        "id": "show_installments",
        "label": "Mention instalments",
        "info": "Only switch on if this is offered at your checkout.",
        "default": false
      },
      {
        "type": "range",
        "id": "installments_count",
        "min": 2,
        "max": 4,
        "step": 1,
        "label": "Number of instalments",
        "default": 3
      },
      {
        "type": "text",
        "id": "installments_provider",
        "label": "Provider name",
        "default": "Klarna"
      }
    ]
  },
  {
    "name": "Social proof",
    "settings": [
      {
        "type": "paragraph",
        "content": "Product star ratings come from your reviews app (any app that writes Shopify's standard review metafields). Nothing shows until there are real reviews."
      },
      {
        "type": "text",
        "id": "store_rating",
        "label": "Store rating",
        "info": "e.g. 4.8 — only from a real, verifiable source such as your reviews app. Leave blank to hide every store-rating line."
      },
      {
        "type": "text",
        "id": "store_review_count",
        "label": "Number of reviews behind it",
        "info": "e.g. 3,900 — the real count. Both fields are needed for the line to show."
      },
      {
        "type": "checkbox",
        "id": "show_product_ratings",
        "label": "Show product star ratings",
        "default": true
      }
    ]
  },
  {
    "name": "Low stock",
    "settings": [
      {
        "type": "checkbox",
        "id": "low_stock_enable",
        "label": "Show low stock",
        "info": "\"Only 3 left in Medium\" — shown only for sizes Shopify tracks that stop selling at zero. Never invented.",
        "default": true
      },
      {
        "type": "range",
        "id": "low_stock_threshold",
        "min": 1,
        "max": 20,
        "step": 1,
        "label": "Show when stock is at or below",
        "default": 5
      }
    ]
  },
  {
    "name": "Sizing",
    "settings": [
      {
        "type": "textarea",
        "id": "size_hints",
        "label": "Size hints",
        "info": "One size per line: VALUE|Label|Weight|Breeds. Matched to your size options by value or label (M or Medium; 2XL and XXL count as XL). Used by the size guide, size buttons and the Bed Finder.",
        "default": "XS|Extra small|Up to 5kg|Chihuahua, Yorkie, Pomeranian\nS|Small|5–10kg|Jack Russell, Dachshund, Pug, Shih Tzu\nM|Medium|10–25kg|Cocker, Springer, Border Collie, Staffie\nL|Large|25–40kg|Labrador, Retriever, Boxer, Pointer\nXL|Extra large|40kg+|German Shepherd, Bernese, Great Dane"
      }
    ]
  },
  {
    "name": "Basket",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "When something is added",
        "options": [
          { "value": "drawer", "label": "Open the basket drawer" },
          { "value": "page", "label": "Go to the basket page" }
        ],
        "default": "drawer"
      },
      {
        "type": "product",
        "id": "cart_upsell_product",
        "label": "Suggested add-on",
        "info": "Offered in the basket, never pre-added."
      },
      {
        "type": "text",
        "id": "cart_upsell_heading",
        "label": "Add-on heading",
        "default": "Complete the set"
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Allow an order note",
        "default": false
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Image shape",
        "options": [
          { "value": "square", "label": "Square" },
          { "value": "portrait", "label": "Portrait" },
          { "value": "landscape", "label": "Landscape" }
        ],
        "default": "square"
      },
      {
        "type": "checkbox",
        "id": "card_show_rating",
        "label": "Show star ratings",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_role",
        "label": "Show \"Best for\" line",
        "info": "From the product's custom.best_for metafield, or a tag like best-for:Stiff mornings.",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_quick_add",
        "label": "Show quick add",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_secondary_image",
        "label": "Show second image on hover",
        "default": true
      }
    ]
  },
  {
    "name": "Bed Finder",
    "settings": [
      {
        "type": "checkbox",
        "id": "finder_enable",
        "label": "Enable the Bed Finder",
        "info": "Four taps to one recommended bed in the right size. Turning it off hides every button that opens it.",
        "default": true
      },
      {
        "type": "text",
        "id": "finder_cta_label",
        "label": "Button label",
        "default": "Find my dog's bed"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "paragraph",
        "content": "A full link or just your handle."
      },
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram",
        "placeholder": "https://www.instagram.com/pawlunova"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook",
        "placeholder": "https://www.facebook.com/pawlunova"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok",
        "placeholder": "https://www.tiktok.com/@pawlunova"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "Pinterest",
        "placeholder": "https://www.pinterest.co.uk/pawlunova"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube",
        "placeholder": "https://www.youtube.com/@pawlunova"
      }
    ]
  },
  {
    "name": "Search",
    "settings": [
      {
        "type": "checkbox",
        "id": "predictive_search_enable",
        "label": "Show suggestions while typing",
        "default": true
      }
    ]
  }
]
