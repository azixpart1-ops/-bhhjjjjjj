{% doc %}
  @prompt
    Create a product review star rating block designed to sit directly below the product title. Display stars with an adjacent numeric rating formatted to one decimal place, ranging from 0.0 to 5.0. Make the rating adjustable from 0.0 to 5.0 and support precise fractional star fills that match the numeric rating. Provide extensive developer-level customization through the editor, including filled and unfilled star colors, numeric text color, star size, spacing between stars, spacing between stars and the number, typography, alignment, padding and margins, and responsive desktop and mobile sizing. Use high-quality developer-level code with accessible rating text and robust behavior at both 0.0 and 5.0. The numeric text represents the star rating, not a review count. also this is a block that goes under product title
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign rating_value = block.settings.rating | plus: 0.0 %}
{% assign rating_percent = rating_value | times: 20 %}

{% style %}
  .ai-rating-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    margin-top: {{ block.settings.margin_top }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
    text-align: {{ block.settings.alignment }};
  }
  .ai-rating-{{ ai_gen_id }}__inner {
    display: inline-flex;
    align-items: center;
    justify-content: {% if block.settings.alignment == 'center' %}center{% elsif block.settings.alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
    gap: {{ block.settings.number_gap }}px;
    max-width: 100%;
    font-family: {{ block.settings.font.family }}, {{ block.settings.font.fallback_families }};
    font-weight: {{ block.settings.font.weight }};
    font-style: {{ block.settings.font.style }};
  }
  .ai-rating-{{ ai_gen_id }}__stars {
    display: inline-flex;
    align-items: center;
    gap: {{ block.settings.star_gap }}px;
    flex: 0 0 auto;
    line-height: 1;
  }
  .ai-rating-{{ ai_gen_id }}__star {
    position: relative;
    display: block;
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    color: {{ block.settings.empty_color }};
  }
  .ai-rating-{{ ai_gen_id }}__star svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
  }
  .ai-rating-{{ ai_gen_id }}__star-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--star-fill);
    overflow: hidden;
    color: {{ block.settings.filled_color }};
  }
  .ai-rating-{{ ai_gen_id }}__value {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.2;
    white-space: nowrap;
  }
  @media screen and (max-width: 749px) {
    .ai-rating-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding_top }}px {{ block.settings.mobile_padding_horizontal }}px {{ block.settings.mobile_padding_bottom }}px;
      margin-top: {{ block.settings.mobile_margin_top }}px;
      margin-bottom: {{ block.settings.mobile_margin_bottom }}px;
    }
    .ai-rating-{{ ai_gen_id }}__star {
      width: {{ block.settings.mobile_star_size }}px;
      height: {{ block.settings.mobile_star_size }}px;
    }
    .ai-rating-{{ ai_gen_id }}__value { font-size: {{ block.settings.mobile_text_size }}px; }
  }
{% endstyle %}

<div class="ai-rating-{{ ai_gen_id }}" style="width: {{ block.settings.desktop_width_percent }}%;" {{ block.shopify_attributes }}>
  <div class="ai-rating-{{ ai_gen_id }}__inner" role="img" aria-label="Rated {{ rating_value }} out of 5">
    <span class="ai-rating-{{ ai_gen_id }}__stars" aria-hidden="true">
      {% for i in (1..5) %}
        {% assign star_start = forloop.index0 %}
        {% assign star_fill = rating_value | minus: star_start | times: 100 %}
        {% if star_fill < 0 %}{% assign star_fill = 0 %}{% endif %}
        {% if star_fill > 100 %}{% assign star_fill = 100 %}{% endif %}
        <span class="ai-rating-{{ ai_gen_id }}__star" style="--star-fill: {{ star_fill }}%;">
          <svg viewBox="0 0 24 24" focusable="false"><path d="M12 2.7l2.85 5.78 6.38.93-4.62 4.5 1.09 6.35L12 17.26l-5.7 3 1.09-6.35-4.62-4.5 6.38-.93L12 2.7z"/></svg>
          <span class="ai-rating-{{ ai_gen_id }}__star-fill"><svg viewBox="0 0 24 24" focusable="false"><path d="M12 2.7l2.85 5.78 6.38.93-4.62 4.5 1.09 6.35L12 17.26l-5.7 3 1.09-6.35-4.62-4.5 6.38-.93L12 2.7z"/></svg></span>
        </span>
      {% endfor %}
    </span>
    <span class="ai-rating-{{ ai_gen_id }}__value">{{ rating_value | round: 1 | prepend: '0' | slice: -3, 3 }}</span>
  </div>
</div>

{% schema %}
{
  "name": "Product rating stars",
  "settings": [
    { "type": "range", "id": "rating", "label": "Rating", "min": 0, "max": 5, "step": 0.1, "default": 4.8 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Stars and rating" },
    { "type": "color", "id": "filled_color", "label": "Filled stars", "default": "#A87821" },
    { "type": "color", "id": "empty_color", "label": "Unfilled stars", "default": "#8C7F66" },
    { "type": "color", "id": "text_color", "label": "Rating text", "default": "#17150F" },
    { "type": "range", "id": "star_size", "label": "Star size", "min": 12, "max": 36, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "mobile_star_size", "label": "Mobile star size", "min": 12, "max": 30, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "star_gap", "label": "Space between stars", "min": 0, "max": 12, "step": 1, "unit": "px", "default": 3 },
    { "type": "range", "id": "number_gap", "label": "Space before rating", "min": 2, "max": 24, "step": 1, "unit": "px", "default": 8 },
    { "type": "font_picker", "id": "font", "label": "Typography", "default": "dm_sans_n4" },
    { "type": "range", "id": "text_size", "label": "Text size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "mobile_text_size", "label": "Mobile text size", "min": 11, "max": 20, "step": 1, "unit": "px", "default": 14 },
    { "type": "select", "id": "alignment", "label": "Alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_horizontal", "label": "Side padding", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_top", "label": "Top margin", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 4 },
    { "type": "range", "id": "margin_bottom", "label": "Bottom margin", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "mobile_padding_top", "label": "Mobile top padding", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Mobile bottom padding", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "mobile_padding_horizontal", "label": "Mobile side padding", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "mobile_margin_top", "label": "Mobile top margin", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 4 },
    { "type": "range", "id": "mobile_margin_bottom", "label": "Mobile bottom margin", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 8 }
  ],
  "presets": [{ "name": "Product rating stars" }],
  "tag": null,
  "class": "product-rating-stars"
}
{% endschema %}