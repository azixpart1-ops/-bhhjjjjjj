{% comment %}
  Section contract.
  The close. One sentence that names what the dog has given, one that names what the owner can do
  about it, then the two ways forward: the Bed Finder as the primary action and the range as the
  quiet alternative. The promises underneath are tokens, so they stay true. It sits on moss by
  default: the dark ground is where the page slows down and the reader decides.
  @example
  <!-- Add from the editor: PL: The close. -->
{% endcomment %}
{%- liquid
  assign s = section.settings
  assign pl_surface = s.background_color
  if pl_surface == blank and s.tone == 'moss'
    assign pl_surface = settings.color_palette.color1
  endif
  assign pl_surface_class = ''
  if pl_surface != blank
    render 'contrast-override', background_color: pl_surface, section_id: section.id
    assign pl_surface_class = ' color-custom-' | append: section.id
    assign pl_surface_brightness = pl_surface | color_brightness
    if pl_surface_brightness < 128
      assign pl_surface_class = pl_surface_class | append: ' pl-on-dark'
    endif
  elsif s.tone != blank and s.tone != 'page'
    assign pl_surface_class = ' pl-tone--' | append: s.tone
  endif
  assign nights = settings.pl_trial_nights | append: ''
  assign years = settings.pl_guarantee_years | append: ''
  assign threshold = settings.pl_free_delivery_threshold | append: ''
-%}
<div class="section-background{{ pl_surface_class }}"></div>
<div
  class="section section--{{ s.section_width }} spacing-style pl-section pl-final{{ pl_surface_class }}"
  style="{% render 'spacing-style', settings: s %}"
>
  {%- render 'pl-section-head', eyebrow: s.eyebrow, heading: s.heading, lede: s.lede, align: 'center' -%}
  <div class="pl-actions pl-final__actions">
    <a class="button" href="{{ s.primary_link | default: settings.pl_finder_url }}">{{ s.primary_label | escape }}</a>
    {%- if s.secondary_label != blank -%}
      <a class="button-secondary" href="{{ s.secondary_link | default: '/collections/dog-beds' }}">{{ s.secondary_label | escape }}</a>
    {%- endif -%}
  </div>
  <ul class="pl-trust-inline pl-final__promises">
    {%- if settings.pl_trial_enable -%}<li>{% render 'pl-icon', name: 'moon' %}{{ nights }} nights to decide</li>{%- endif -%}
    {%- if settings.pl_guarantee_enable -%}<li>{% render 'pl-icon', name: 'shield' %}{{ years }}-year guarantee on memory foam beds</li>{%- endif -%}
    {%- if settings.pl_free_delivery_threshold > 0 -%}<li>{% render 'pl-icon', name: 'truck' %}Free UK delivery over £{{ threshold }}</li>{%- endif -%}
  </ul>
</div>

{% stylesheet %}
  .pl-final {
    align-items: center;
    text-align: center;
    gap: var(--gap-xl);
  }

  .pl-final__actions {
    justify-content: center;
  }

  .pl-final__promises {
    justify-content: center;
  }

  @media screen and (max-width: 749px) {
    .pl-final__actions {
      width: 100%;
      flex-direction: column;
    }

    .pl-final__actions .button,
    .pl-final__actions .button-secondary {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PL: The close",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "paragraph", "content": "The last word on the page. The promises underneath read Theme settings › PawLunova promises." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "They've given you every good year they had." },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "The least we can do is make the next ones easier to get up from. Four questions, and we'll point you to the right bed." },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "Find my dog's bed" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Shop all beds" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "select", "id": "tone", "label": "Surface", "options": [ { "value": "page", "label": "Page" }, { "value": "oat", "label": "Oat, lean in" }, { "value": "calm", "label": "Calm, sage tint" }, { "value": "warm", "label": "Warm, clay tint" }, { "value": "moss", "label": "Moss, dark" } ], "default": "moss", "info": "Named surfaces from the palette. A background colour below overrides it." },
    { "type": "color", "id": "background_color", "label": "Background", "placeholder": "Default" },
    { "type": "select", "id": "section_width", "label": "Width", "options": [ { "value": "page-width", "label": "Page" }, { "value": "full-width", "label": "Full" } ], "default": "page-width" },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 72 }
  ],
  "presets": [{ "name": "PL: The close", "category": "PawLunova" }]
}
{% endschema %}
