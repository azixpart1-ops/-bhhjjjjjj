{% comment %}
  Section contract.
  A compact band that routes an undecided shopper to the Bed Finder: after a grid, on the 404,
  on empty search results and in the basket.
{% endcomment %}
{%- liquid
  assign s = section.settings
  assign pl_surface = s.background_color
  if pl_surface == blank and s.tone == 'moss'
    assign pl_surface = settings.color_palette.color1
  endif
  assign pl_surface_class = ''
  if pl_surface != blank
    render 'contrast-override', background_color: pl_surface, section_id: section.id
    assign pl_surface_class = ' color-custom-' | append: section.id
    assign pl_surface_brightness = pl_surface | color_brightness
    if pl_surface_brightness < 128
      assign pl_surface_class = pl_surface_class | append: ' pl-on-dark'
    endif
  elsif s.tone != blank and s.tone != 'page'
    assign pl_surface_class = ' pl-tone--' | append: s.tone
  endif
-%}
<div class="section-background{{ pl_surface_class }}"></div>
<div
  class="section section--{{ s.section_width }} spacing-style pl-section{{ pl_surface_class }}"
  style="{% render 'spacing-style', settings: s %}"
>
  <div class="pl-banner pl-card pl-card--moss">
    <span class="pl-icon-badge pl-banner__icon">{% render 'pl-icon', name: 'paw' %}</span>
    <div class="pl-banner__copy">
      <p class="pl-banner__heading h4">{{ s.heading | escape }}</p>
      {%- if s.text != blank -%}<p class="pl-banner__text">{{ s.text | escape }}</p>{%- endif -%}
    </div>
    <div class="pl-banner__cta">
      <a class="button" href="{{ s.link | default: settings.pl_finder_url }}">{{ s.label | escape }}</a>
      {%- if s.note != blank -%}<span class="pl-btn-note pl-banner__note">{{ s.note | escape }}</span>{%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .pl-banner {
    display: grid;
    gap: var(--gap-md);
    align-items: center;
    padding: var(--padding-xl);
    border-radius: var(--pl-radius-lg);
  }

  @media screen and (min-width: 750px) {
    .pl-banner {
      grid-template-columns: auto 1fr auto;
      gap: var(--gap-xl);
    }
  }

  .pl-banner__icon {
    background: rgb(var(--pl-bone-rgb) / 0.12);
    color: var(--pl-on-moss);
    width: 3rem;
    height: 3rem;
  }

  .pl-banner__copy {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .pl-banner__heading {
    margin: 0;
    color: var(--pl-on-moss);
  }

  .pl-banner__text {
    margin: 0;
    color: var(--pl-on-moss-muted);
  }

  .pl-banner__cta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .pl-banner__note {
    color: var(--pl-on-moss-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PL: Finder banner",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not sure which bed? Answer four questions." },
    { "type": "text", "id": "text", "label": "Text", "default": "How they sleep, their joints, their size, their name. One bed in the right size, about 30 seconds." },
    { "type": "text", "id": "label", "label": "Button", "default": "Find my dog's bed" },
    { "type": "url", "id": "link", "label": "Link", "info": "Empty: the Bed Finder page." },
    { "type": "text", "id": "note", "label": "Note", "default": "No email needed" },
    { "type": "select", "id": "tone", "label": "Surface", "options": [ { "value": "page", "label": "Page" }, { "value": "oat", "label": "Oat, lean in" }, { "value": "calm", "label": "Calm, sage tint" }, { "value": "warm", "label": "Warm, clay tint" }, { "value": "moss", "label": "Moss, dark" } ], "default": "page", "info": "Named surfaces from the palette. A background colour below overrides it." },
    { "type": "color", "id": "background_color", "label": "Background", "placeholder": "Default" },
    { "type": "select", "id": "section_width", "label": "Width", "options": [ { "value": "page-width", "label": "Page" }, { "value": "full-width", "label": "Full" } ], "default": "page-width" },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 24 }
  ],
  "presets": [{ "name": "PL: Finder banner", "category": "PawLunova" }]
}
{% endschema %}
