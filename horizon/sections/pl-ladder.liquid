{% comment %}
  Section contract.
  Good, better, best: three real beds that answer one need, in price order, with the middle one
  marked as the sensible pick. Adding an option a buyer can rank against makes the middle bed the
  obvious choice (centre-stage effect), and three beds is a decision; seventy is not. Every price,
  photo and claim comes from the product itself: price_min, featured image, custom.best_for,
  custom.core_type, the foam-guarantee and trial verdicts. Nothing is typed in that the product page
  would not also say.
  @example
  <!-- Add from the editor: PL: Good, better, best. Three Bed blocks; tick "The sensible pick" on one. -->
{% endcomment %}
{%- liquid
  assign s = section.settings
  assign pl_surface = s.background_color
  if pl_surface == blank and s.tone == 'moss'
    assign pl_surface = settings.color_palette.color1
  endif
  assign pl_surface_class = ''
  if pl_surface != blank
    render 'contrast-override', background_color: pl_surface, section_id: section.id
    assign pl_surface_class = ' color-custom-' | append: section.id
    assign pl_surface_brightness = pl_surface | color_brightness
    if pl_surface_brightness < 128
      assign pl_surface_class = pl_surface_class | append: ' pl-on-dark'
    endif
  elsif s.tone != blank and s.tone != 'page'
    assign pl_surface_class = ' pl-tone--' | append: s.tone
  endif
  assign nights = settings.pl_trial_nights | append: ''
  assign years = settings.pl_guarantee_years | append: ''
  assign count = 0
  for block in section.blocks
    if block.settings.product != blank
      assign count = count | plus: 1
    endif
  endfor
-%}
{%- if count > 0 -%}
<div class="section-background{{ pl_surface_class }}"></div>
<div
  class="section section--{{ s.section_width }} spacing-style pl-section pl-ladder{{ pl_surface_class }}"
  style="{% render 'spacing-style', settings: s %}"
>
  {%- assign heading = s.heading | replace: '[nights]', nights | replace: '[years]', years -%}
  {%- assign lede = s.lede | replace: '[nights]', nights | replace: '[years]', years -%}
  {%- render 'pl-section-head', eyebrow: s.eyebrow, heading: heading, lede: lede -%}
  <ol class="pl-ladder__list list-unstyled pl-ladder__list--{{ count }}">
    {%- for block in section.blocks -%}
      {%- liquid
        assign p = block.settings.product
        if p == blank
          continue
        endif
        assign mf = p.metafields.custom
        capture foam_ok
          render 'pl-foam-bed', product: p
        endcapture
        capture trial_ok
          render 'pl-trial-eligible', product: p
        endcapture
        assign core = mf.core_type | default: '' | append: ''
        assign best = block.settings.why | default: mf.best_for | default: ''
        assign is_pick = block.settings.pick
      -%}
      <li class="pl-ladder__rung{% if is_pick %} pl-ladder__rung--pick{% endif %}" {{ block.shopify_attributes }}>
        <a class="pl-ladder__media" href="{{ p.url }}" aria-label="{{ p.title | escape }}" tabindex="-1">
          {%- if p.featured_image != blank -%}
            {{ p.featured_image | image_url: width: 900 | image_tag: widths: '320, 480, 640, 900', sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 100vw', loading: 'lazy', class: 'pl-ladder__img', alt: p.featured_image.alt | default: p.title }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'pl-ladder__img placeholder-svg' }}
          {%- endif -%}
          {%- if block.settings.label != blank -%}
            <span class="pl-chip {% if is_pick %}pl-chip--accent{% else %}pl-chip--moss{% endif %} pl-ladder__label">{{ block.settings.label | escape }}</span>
          {%- endif -%}
        </a>
        <div class="pl-ladder__body">
          {%- if is_pick and s.pick_label != blank -%}
            <p class="pl-eyebrow pl-eyebrow--accent pl-ladder__pick">{{ s.pick_label | escape }}</p>
          {%- endif -%}
          <h3 class="h5 pl-ladder__title"><a href="{{ p.url }}">{{ p.title | escape }}</a></h3>
          {%- if best != '' -%}<p class="pl-ladder__why">{{ best | escape }}</p>{%- endif -%}
          <ul class="pl-chips list-unstyled">
            {%- if core != '' -%}<li class="pl-chip">{{ core | escape }}</li>{%- endif -%}
            {%- if mf.low_entry.value == true -%}<li class="pl-chip">{{ 'pl.general.low_entry' | t }}</li>{%- endif -%}
            {%- if mf.has_liner.value == true -%}<li class="pl-chip">{{ 'pl.general.liner' | t }}</li>{%- endif -%}
            {%- if foam_ok == 'true' and settings.pl_guarantee_enable -%}<li class="pl-chip pl-chip--success">{{ years }}-year foam guarantee</li>{%- endif -%}
          </ul>
          <p class="pl-ladder__price">
            {%- if p.has_only_default_variant != true -%}<span class="pl-muted">{{ 'pl.general.from' | t }}</span> {% endif -%}
            <strong>{{ p.price_min | money_without_trailing_zeros }}</strong>
            {%- if p.available == false -%} <span class="pl-small pl-muted">· {{ 'pl.general.sold_out' | t }}</span>{%- endif -%}
          </p>
          {%- render 'pl-per-night', price: p.price_min, product: p, compact: true -%}
          <div class="pl-ladder__cta">
            <a class="{% if is_pick %}button{% else %}button-secondary{% endif %}" href="{{ p.url }}">{{ s.cta_label | replace: '[name]', p.title | escape }}</a>
            {%- if trial_ok == 'true' and settings.pl_trial_enable -%}
              <span class="pl-btn-note">{{ nights }} nights to decide. Free collection if it isn't right.</span>
            {%- endif -%}
          </div>
        </div>
      </li>
    {%- endfor -%}
  </ol>
  {%- if s.note != blank -%}
    <p class="pl-ladder__note pl-small pl-muted">{{ s.note | replace: '[nights]', nights | replace: '[years]', years | escape }}</p>
  {%- endif -%}
</div>
{%- endif -%}

{% stylesheet %}
  .pl-ladder__list {
    display: grid;
    gap: var(--gap-md);
    align-items: stretch;
  }

  @media screen and (min-width: 750px) {
    .pl-ladder__list--2,
    .pl-ladder__list--3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .pl-ladder__list--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--gap-lg);
    }
  }

  .pl-ladder__rung {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: 1px solid var(--pl-line);
    border-radius: var(--pl-radius-lg);
    background: var(--color-background);
    overflow: hidden;
  }

  /* The sensible pick: one louder card, by colour and position, not by size. */
  .pl-ladder__rung--pick {
    border-color: var(--pl-terracotta);
    box-shadow: 0 0 0 1px var(--pl-terracotta), 0 18px 40px -24px rgb(var(--color-foreground-rgb) / 0.4);
    background: var(--pl-terracotta-tint);
  }

  .pl-ladder__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    background: var(--pl-oat);
  }

  .pl-ladder__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pl-ladder__label {
    position: absolute;
    inset-inline-start: 0.75rem;
    inset-block-start: 0.75rem;
  }

  .pl-ladder__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: var(--padding-xl);
    flex: 1;
  }

  .pl-ladder__pick {
    margin: 0;
  }

  .pl-ladder__title {
    margin: 0;
  }

  .pl-ladder__title a {
    color: inherit;
    text-decoration: none;
  }

  .pl-ladder__title a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .pl-ladder__why {
    margin: 0;
    color: var(--color-foreground-muted);
    line-height: 1.5;
  }

  .pl-ladder__price {
    margin: 0.25rem 0 0;
    font-size: 1.125rem;
  }

  .pl-ladder__price strong {
    font-family: var(--font-heading--family);
    font-weight: 600;
    font-size: 1.5rem;
  }

  .pl-ladder__cta {
    margin-top: auto;
    padding-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .pl-ladder__cta .button,
  .pl-ladder__cta .button-secondary {
    width: 100%;
    justify-content: center;
    text-align: center;
  }

  .pl-ladder__note {
    margin: 0;
    max-width: 44rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PL: Good, better, best",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 3,
  "settings": [
    { "type": "paragraph", "content": "Three real beds for one need, lowest price first. Tick \"The sensible pick\" on the middle one. Prices, photos, \"best for\" lines and guarantee chips come from each product; tokens [nights] and [years] read theme settings." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "For a dog who's slowing down" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Three good answers. One is usually the right one." },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "Same job, three ways to do it. The middle bed is the one we'd point most owners of a stiffening dog to; the others are there if budget or size says otherwise." },
    { "type": "text", "id": "pick_label", "label": "Label on the sensible pick", "default": "The sensible pick" },
    { "type": "text", "id": "cta_label", "label": "Button text", "info": "[name] becomes the bed's name.", "default": "See the bed" },
    { "type": "textarea", "id": "note", "label": "Note under the beds", "default": "Not sure between two? Go by their size first, then their joints. The Bed Finder does exactly that in four questions." },
    { "type": "select", "id": "tone", "label": "Surface", "options": [ { "value": "page", "label": "Page" }, { "value": "oat", "label": "Oat, lean in" }, { "value": "calm", "label": "Calm, sage tint" }, { "value": "warm", "label": "Warm, clay tint" }, { "value": "moss", "label": "Moss, dark" } ], "default": "page", "info": "Named surfaces from the palette. A background colour below overrides it." },
    { "type": "color", "id": "background_color", "label": "Background", "placeholder": "Default" },
    { "type": "select", "id": "section_width", "label": "Width", "options": [ { "value": "page-width", "label": "Page" }, { "value": "full-width", "label": "Full" } ], "default": "page-width" },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 64 }
  ],
  "blocks": [
    { "type": "rung", "name": "Bed", "settings": [
      { "type": "product", "id": "product", "label": "Bed" },
      { "type": "text", "id": "label", "label": "Corner label", "default": "Good" },
      { "type": "text", "id": "why", "label": "One line on why", "info": "Empty: the product's \"best for\" metafield." },
      { "type": "checkbox", "id": "pick", "label": "The sensible pick", "default": false }
    ] }
  ],
  "presets": [
    { "name": "PL: Good, better, best", "category": "PawLunova", "blocks": [
      { "type": "rung", "settings": { "label": "Good", "pick": false } },
      { "type": "rung", "settings": { "label": "Better", "pick": true } },
      { "type": "rung", "settings": { "label": "Best", "pick": false } }
    ] }
  ]
}
{% endschema %}
