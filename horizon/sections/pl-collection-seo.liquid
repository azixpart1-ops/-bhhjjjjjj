{% comment %}
  Section contract.
  The collection's full description, below the grid where it helps search without pushing the beds
  down. Headings inside it are demoted one level so the page keeps a single H1.
{% endcomment %}
{%- liquid
  assign s = section.settings
  assign pl_surface = s.background_color
  if pl_surface == blank and s.tone == 'moss'
    assign pl_surface = settings.color_palette.color1
  endif
  assign pl_surface_class = ''
  if pl_surface != blank
    render 'contrast-override', background_color: pl_surface, section_id: section.id
    assign pl_surface_class = ' color-custom-' | append: section.id
    assign pl_surface_brightness = pl_surface | color_brightness
    if pl_surface_brightness < 128
      assign pl_surface_class = pl_surface_class | append: ' pl-on-dark'
    endif
  elsif s.tone != blank and s.tone != 'page'
    assign pl_surface_class = ' pl-tone--' | append: s.tone
  endif
  assign desc = collection.description | default: ''
  assign desc = desc | replace: '<h5', '<h6' | replace: '</h5>', '</h6>' | replace: '<h4', '<h5' | replace: '</h4>', '</h5>' | replace: '<h3', '<h4' | replace: '</h3>', '</h4>' | replace: '<h2', '<h3' | replace: '</h2>', '</h3>' | replace: '<h1', '<h2' | replace: '</h1>', '</h2>'
  assign title = collection.title | split: '|' | first | strip
-%}
{%- if desc != '' -%}
<div class="section-background{{ pl_surface_class }}"></div>
<div
  class="section section--{{ s.section_width }} spacing-style pl-section{{ pl_surface_class }}"
  style="{% render 'spacing-style', settings: s %}"
>
  <details class="pl-details pl-colseo"{% if s.open %} open{% endif %}>
    <summary class="h5 pl-colseo__summary"><span>{{ s.heading | replace: '[title]', title | escape }}</span>{% render 'pl-icon', name: 'chevron', class: 'pl-details__chevron' %}</summary>
    <div class="rte pl-colseo__body">{{ desc }}</div>
  </details>
</div>
{%- endif -%}

{% stylesheet %}
  .pl-colseo {
    max-width: 48rem;
  }

  .pl-colseo__summary {
    margin: 0;
    padding-block: 0.5rem;
  }

  .pl-colseo__body {
    padding-block: 0.5rem 1rem;
    color: var(--color-foreground-muted);
  }

  .pl-colseo__body h2,
  .pl-colseo__body h3,
  .pl-colseo__body h4 {
    color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PL: Collection text",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "[title] becomes the collection's name.", "default": "More about our [title]" },
    { "type": "checkbox", "id": "open", "label": "Open by default", "default": false },
    { "type": "select", "id": "tone", "label": "Surface", "options": [ { "value": "page", "label": "Page" }, { "value": "oat", "label": "Oat, lean in" }, { "value": "calm", "label": "Calm, sage tint" }, { "value": "warm", "label": "Warm, clay tint" }, { "value": "moss", "label": "Moss, dark" } ], "default": "page", "info": "Named surfaces from the palette. A background colour below overrides it." },
    { "type": "color", "id": "background_color", "label": "Background", "placeholder": "Default" },
    { "type": "select", "id": "section_width", "label": "Width", "options": [ { "value": "page-width", "label": "Page" }, { "value": "full-width", "label": "Full" } ], "default": "page-width" },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 24 }
  ],
  "presets": [{ "name": "PL: Collection text", "category": "PawLunova" }]
}
{% endschema %}
