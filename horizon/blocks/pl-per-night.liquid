{%- doc -%}
  Product page: the per-night cost line for the selected size. Memory foam beds only.
{%- enddoc -%}
{%- liquid
  assign product = closest.product
  assign variant = product.selected_or_first_available_variant
-%}
<div class="pl-pdp-block pl-pdp-block--per-night" {{ block.shopify_attributes }}>
  {%- render 'pl-per-night', price: variant.price, product: product -%}
</div>
{% schema %}
{
  "name": "Per-night cost",
  "tag": null,
  "settings": [
    { "type": "paragraph", "content": "Price divided by the nights in the foam guarantee. Shows only on beds the guarantee covers, and only while Theme settings › PawLunova promises › per-night line is on." }
  ],
  "presets": [{ "name": "Per-night cost", "category": "PawLunova" }]
}
{% endschema %}
