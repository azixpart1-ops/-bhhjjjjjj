{%- doc -%}
  The one-line subtitle above the title, from custom.subtitle (or the older custom.tagline).
{%- enddoc -%}
{%- liquid
  assign product = closest.product
  assign line = product.metafields.custom.subtitle | default: product.metafields.custom.tagline | default: ''
-%}
{%- if line != blank -%}
  <p class="pl-pdp-block pl-subtitle pl-eyebrow pl-eyebrow--accent" {{ block.shopify_attributes }}>{{ line | escape }}</p>
{%- endif -%}
{% schema %}
{
  "name": "Subtitle",
  "tag": null,
  "settings": [
    { "type": "paragraph", "content": "Reads the product's custom.subtitle metafield. Nothing shows when it is empty." }
  ],
  "presets": [{ "name": "Subtitle", "category": "PawLunova" }]
}
{% endschema %}
