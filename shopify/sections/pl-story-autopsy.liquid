{% render 'pl-assets' %}
{%- comment -%}
  Why the last bed failed, drawn rather than asserted.

  Each stage renders a cross-section of the bed: a slab whose top edge sags by
  the amount the block specifies, against a dashed line marking the loft it
  arrived with. The path is computed from the settings, so changing the numbers
  changes the drawing – there is no hand-drawn image to fall out of step.
{%- endcomment -%}
{%- liquid
  assign floor_y = 70
  assign origin = section.settings.origin_loft | default: 44
  assign origin_y = floor_y | minus: origin
-%}
<div class="pl">
  <section class="pl-section" id="autopsy">
    <div class="wrap">
      <div class="section-head section-head--center reveal">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="display-2">{{ section.settings.heading | escape | newline_to_br }}</h2>
        {%- if section.settings.standfirst != blank -%}
          <p class="body-lg" style="margin-top:1rem">{{ section.settings.standfirst }}</p>
        {%- endif -%}
      </div>

      <ol class="autopsy">
        {%- for block in section.blocks -%}
          {%- liquid
            assign loft = block.settings.loft
            assign sag = block.settings.sag
            assign top_y = floor_y | minus: loft
            assign ctrl_y = top_y | plus: sag | plus: sag
          -%}
          <li class="autopsy__stage reveal" style="--i:{{ forloop.index }}" {{ block.shopify_attributes }}>
            <div class="autopsy__figure">
              <svg viewBox="0 0 220 80" role="img"
                   aria-label="{{ block.settings.alt | escape | default: block.settings.title | escape }}">
                <line class="autopsy__floor" x1="6" y1="{{ floor_y }}" x2="214" y2="{{ floor_y }}"/>
                {%- if forloop.index > 1 -%}
                  <line class="autopsy__origin" x1="10" y1="{{ origin_y }}" x2="210" y2="{{ origin_y }}"/>
                {%- endif -%}
                <path class="autopsy__slab"
                      d="M10,{{ floor_y }} L10,{{ top_y }} Q110,{{ ctrl_y }} 210,{{ top_y }} L210,{{ floor_y }} Z"/>
              </svg>
              <span class="autopsy__caption">{{ block.settings.measure }}</span>
            </div>
            <div class="autopsy__body">
              <span class="autopsy__when">{{ block.settings.when }}</span>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </li>
        {%- endfor -%}
      </ol>

      {%- if section.settings.punchline != blank -%}
        <p class="autopsy__punch reveal">{{ section.settings.punchline }}</p>
      {%- endif -%}

      {%- if section.settings.cta_text != blank -%}
        <p class="autopsy__cta reveal">
          <a class="btn btn--lg" href="{{ section.settings.cta_link | default: '#pl-finder' }}">
            {{ section.settings.cta_text }}{% render 'pl-icon', icon: 'arrow', class: 'btn__arrow', size: 18 %}
          </a>
        </p>
      {%- endif -%}
    </div>
  </section>
</div>
{% schema %}
{
  "name": "PL – Where padding goes",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The same failure, every time" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Where the padding goes." },
    { "type": "textarea", "id": "standfirst", "label": "Standfirst", "default": "Fibre filling does not wear out. It moves – to the edges, away from the weight – and it takes about a month." },
    { "type": "range", "id": "origin_loft", "label": "Starting loft in the drawing", "min": 20, "max": 60, "step": 2, "default": 44, "unit": "px" },
    { "type": "textarea", "id": "punchline", "label": "Punchline", "default": "By the end he is sleeping on your floorboards with a cover over them. So he shifts – not because he is restless, but because there is nowhere on that bed that stays comfortable for more than an hour." },
    { "type": "text", "id": "cta_text", "label": "Button", "default": "See what replaces it" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "stage", "name": "Stage", "limit": 4, "settings": [
      { "type": "text", "id": "when", "label": "When" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Text" },
      { "type": "text", "id": "measure", "label": "Measurement caption" },
      { "type": "range", "id": "loft", "label": "Loft at this stage", "min": 4, "max": 60, "step": 2, "default": 44, "unit": "px" },
      { "type": "range", "id": "sag", "label": "How far the middle sags", "min": 0, "max": 24, "step": 1, "default": 0, "unit": "px" },
      { "type": "text", "id": "alt", "label": "Diagram description", "info": "Read out by screen readers in place of the drawing." } ] }
  ],
  "presets": [{ "name": "PL – Where padding goes" }]
}
{% endschema %}
