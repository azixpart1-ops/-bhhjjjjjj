{% render 'pl-assets' %}
{% render 'pl-scheme', id: section.id, scheme: section.settings.scheme, bg: section.settings.bg, accent: section.settings.accent, tone: section.settings.tone %}
{%- liquid
  assign threshold = section.settings.free_shipping_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
-%}
<div class="pl">
  <section class="wrap">
    <div class="page-hero reveal">
      <h1>{{ section.settings.heading }}</h1>
    </div>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate class="cart" style="padding-bottom:clamp(2rem,5vw,4rem)">
        <div>
          {%- for pl-line in cart.items -%}
            <div class="pl-line">
              {%- if line.image -%}
                <a href="{{ line.url }}"><img class="pl-line__img" src="{{ line.image | image_url: width: 200 }}" alt="{{ line.title | escape }}" width="84" height="84" loading="lazy"></a>
              {%- else -%}
                <span class="pl-line__img"></span>
              {%- endif -%}
              <div>
                <a class="pl-line__name" href="{{ line.url }}">{{ line.product.title }}</a>
                {%- unless line.product.has_only_default_variant -%}
                  <p class="pl-line__opt">{{ line.variant.title }}</p>
                {%- endunless -%}
                {%- if line.selling_plan_allocation -%}
                  <p class="pl-line__opt">{{ line.selling_plan_allocation.selling_plan.name }}</p>
                {%- endif -%}
                <span class="pl-line__qty">
                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ line.quantity | minus: 1 }}" aria-label="Reduce quantity of {{ line.product.title | escape }}">&minus;</a>
                  <span>{{ line.quantity }}</span>
                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ line.quantity | plus: 1 }}" aria-label="Increase quantity of {{ line.product.title | escape }}">+</a>
                </span>
                <a class="pl-line__remove" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0">Remove</a>
              </div>
              <div class="pl-line__price">
                {{ line.final_line_price | money }}
                {%- if line.original_line_price > line.final_line_price -%}
                  <br><s class="buy__was">{{ line.original_line_price | money }}</s>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>

        <aside class="summary reveal">
          <div class="summary__row"><span>Subtotal</span><span>{{ cart.total_price | money }}</span></div>
          {%- if cart.cart_level_discount_applications.size > 0 -%}
            {%- for d in cart.cart_level_discount_applications -%}
              <div class="summary__row"><span>{{ d.title }}</span><span>&minus;{{ d.total_allocated_amount | money }}</span></div>
            {%- endfor -%}
          {%- endif -%}
          <div class="summary__row"><span>Delivery</span>
            <span>{% if remaining <= 0 %}Free{% else %}Calculated at checkout{% endif %}</span></div>
          <div class="summary__row summary__row--total"><span>Total</span><b>{{ cart.total_price | money }}</b></div>

          {%- if section.settings.show_shipping_bar and threshold > 0 -%}
            <div class="ship-bar">
              {%- if remaining > 0 -%}
                <p>{{ remaining | money }} away from free UK delivery.</p>
              {%- else -%}
                <p><strong>Free UK delivery unlocked.</strong></p>
              {%- endif -%}
              {%- assign pct = cart.total_price | times: 100 | divided_by: threshold -%}
              <div class="ship-bar__track"><div class="ship-bar__fill" style="width:{% if pct > 100 %}100{% else %}{{ pct }}{% endif %}%"></div></div>
            </div>
          {%- endif -%}

          <button class="btn btn--lg" type="submit" name="checkout">{{ section.settings.checkout_label }}</button>

          <div class="buy__trust" style="margin-top:1.25rem">
            {%- for block in section.blocks -%}
              <div {{ block.shopify_attributes }}>
                {% render 'pl-icon', icon: block.settings.icon %}
                <span><b>{{ block.settings.title }}</b> – {{ block.settings.text }}</span>
              </div>
            {%- endfor -%}
          </div>
        </aside>
      </form>
    {%- else -%}
      <div class="cempty">
        <h2 class="display-3">{{ section.settings.empty_heading }}</h2>
        <p class="body-lg" style="margin-top:1rem">{{ section.settings.empty_text }}</p>
        <div class="oops__cta">
          <a class="btn btn--lg" href="{{ section.settings.empty_link | default: '/' }}">{{ section.settings.empty_cta }}</a>
          <a class="btn btn--lg btn--ghost" href="{{ routes.all_products_collection_url }}">Shop all beds</a>
        </div>
      </div>
    {%- endif -%}
  </section>
</div>
{% schema %}
{
  "name": "PL – Cart",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your basket"
    },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "Checkout button",
      "default": "Checkout securely"
    },
    {
      "type": "header",
      "content": "Free delivery bar"
    },
    {
      "type": "checkbox",
      "id": "show_shipping_bar",
      "label": "Show free-delivery progress",
      "default": true
    },
    {
      "type": "number",
      "id": "free_shipping_threshold",
      "label": "Free delivery over (£)",
      "default": 40
    },
    {
      "type": "header",
      "content": "Empty basket"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Heading",
      "default": "Nothing in here yet."
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "Text",
      "default": "Three questions about how your dog sleeps and we'll point you at the right bed."
    },
    {
      "type": "text",
      "id": "empty_cta",
      "label": "Button",
      "default": "Find their bed"
    },
    {
      "type": "url",
      "id": "empty_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colour"
    },
    {
      "type": "paragraph",
      "content": "Text colour is chosen by measuring contrast against the background you pick, so a section cannot end up unreadable. The editor warns you if a background leaves no readable option."
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "cream",
          "label": "Cream, calm"
        },
        {
          "value": "oat",
          "label": "Oat, warm neutral"
        },
        {
          "value": "gold",
          "label": "Gold, warmth"
        },
        {
          "value": "forest",
          "label": "Forest, authority"
        },
        {
          "value": "clay",
          "label": "Deep green, focus"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "info": "Custom scheme only."
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Buttons and links",
      "info": "Custom scheme only."
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Text colour",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Automatic, recommended"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "light",
          "label": "Light"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust line",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "shield",
          "options": [
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "medal",
              "label": "Medal"
            },
            {
              "value": "truck",
              "label": "Delivery"
            },
            {
              "value": "pin",
              "label": "Location"
            }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PL – Cart"
    }
  ]
}
{% endschema %}
