{% render 'pl-assets' %}
<div class="pl">
  <section class="wrap">
    {%- if section.settings.show_breadcrumbs -%}
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a> <span>/</span>
        <span aria-current="page">{{ page.title | default: section.settings.fallback_title }}</span>
      </nav>
    {%- endif -%}
    <div class="page-hero reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1>{{ page.title | default: section.settings.fallback_title }}</h1>
      {%- if section.settings.standfirst != blank -%}<p>{{ section.settings.standfirst }}</p>{%- endif -%}
    </div>
    <div class="page-body reveal" style="--i:1">
      <div class="pl-rte">{{ page.content }}</div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "PL — Page content",
  "tag": "pl-section",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "textarea", "id": "standfirst", "label": "Standfirst", "info": "Optional pl-line under the title." },
    { "type": "text", "id": "fallback_title", "label": "Fallback title", "default": "PawLunova" }
  ],
  "presets": [{ "name": "PL — Page content" }]
}
{% endschema %}
