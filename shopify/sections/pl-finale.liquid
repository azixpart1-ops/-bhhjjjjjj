{% render 'pl-assets' %}
<div class="pl">
  <section class="section section--dark">
    <div class="wrap">
      <div class="finale">
        <h2 class="display-2 reveal">{{ section.settings.heading | escape | newline_to_br }}</h2>
        {%- if section.settings.lede != blank -%}
          <p class="lede reveal" style="--i:1">{{ section.settings.lede }}</p>
        {%- endif -%}
        <div class="finale__cta reveal" style="--i:2">
          {%- if section.settings.cta_1_text != blank -%}
            <a class="btn btn--lg" href="{{ section.settings.cta_1_link | default: '#pl-finder' }}">
              {{ section.settings.cta_1_text }}{% render 'pl-icon', icon: 'arrow', class: 'btn__arrow', size: 18 %}
            </a>
          {%- endif -%}
          {%- if section.settings.cta_2_text != blank -%}
            <a class="btn btn--lg btn--onDark" href="{{ section.settings.cta_2_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_2_text }}</a>
          {%- endif -%}
        </div>
        {%- if section.settings.fine_print != blank -%}
          <p class="finale__fine muted reveal" style="--i:3">{{ section.settings.fine_print }}</p>
        {%- endif -%}
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "PL — Closing CTA",
  "tag": "section",
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "They've given you every good year they had." },
    { "type": "textarea", "id": "lede", "label": "Sub-line", "default": "The least we can do is make the next ones easier to get up from." },
    { "type": "text", "id": "cta_1_text", "label": "Primary button", "default": "Find their bed" },
    { "type": "url", "id": "cta_1_link", "label": "Primary link" },
    { "type": "text", "id": "cta_2_text", "label": "Secondary button", "default": "Shop all beds" },
    { "type": "url", "id": "cta_2_link", "label": "Secondary link" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "100-night sleep trial · 5-year foam guarantee · Free UK delivery over £40" }
  ],
  "presets": [{ "name": "PL — Closing CTA" }]
}
{% endschema %}
