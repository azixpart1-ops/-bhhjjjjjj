{% render 'pl-assets' %}
{% render 'pl-scheme', id: section.id, scheme: section.settings.scheme, bg: section.settings.bg, accent: section.settings.accent, tone: section.settings.tone %}
{% render 'pl-layout', id: section.id, s: section.settings %}
{%- comment -%}
  The arithmetic.

  Every other section on this page argues that the bed is good. This one is
  the only place that argues about the price, and it does it by changing the
  unit rather than by discounting: £169 is a number a shopper compares to a
  £25 supermarket bed and loses on, and 9p a night is a number with nothing
  to compare it to at all.

  The figure is not a marketing claim, which is the point. It is the price
  divided by the guarantee the shop already publishes — so the denominator is
  underwritten by a promise that is already on the page, and the section
  cannot be accused of picking a flattering lifespan. Shorten the guarantee
  in the editor and the per-night figure goes up on its own.

  Nothing here needs a photograph. The section is deliberately typographic:
  it is a sum, and a sum reads better set than illustrated.
{%- endcomment -%}
{%- liquid
  assign st = section.settings

  comment
    The price. A product picker is offered first because a figure read off
    the catalogue cannot go stale, and a typed override second because a shop
    may want to reason about a bed it does not sell yet. The typed field is
    in pounds; everything below works in pence, as Shopify does.
  endcomment
  assign pence = 0
  if st.price_product != blank
    assign pence = st.price_product.price_min
  endif
  assign typed = st.price_override | plus: 0
  if typed > 0
    assign pence = typed | times: 100
  endif

  assign years = st.years | default: 5 | plus: 0
  assign hours_day = st.hours_day | default: 14 | plus: 0

  assign nights = years | times: 365
  assign hours = nights | times: hours_day

  comment
    Guard the division. A guarantee of zero years is a setting somebody can
    reach with the slider, and dividing by it would either error or print an
    infinity, so the whole panel stands down instead.
  endcomment
  assign can_divide = false
  if nights > 0 and pence > 0
    assign can_divide = true
  endif

  if can_divide
    assign per_night = pence | divided_by: nights
    comment
      Under a pound reads as pence, over it as money. Rounding down rather
      than to nearest, deliberately: the figure the shop prints should be one
      it cannot be accused of flattering, and integer division already floors.
    endcomment
    if per_night < 1
      assign per_night = 1
      assign floored_to_a_penny = true
    endif
  endif

  assign panel = 'worth__sum'
  if st.panel == 'plain'
    assign panel = panel | append: ' worth__sum--plain'
  endif

  assign head = 'section-head'
  if st.align == 'center'
    assign head = 'section-head section-head--center'
  endif
-%}
<div class="pl">
  <section class="pl-section"
           {% if st.anchor != blank %}id="{{ st.anchor | handleize }}"{% endif %}
           style="--worth-split:{{ st.split | default: '1fr 1fr' }}">
    <div class="wrap">
      {%- if st.eyebrow != blank or st.heading != blank -%}
        <div class="{{ head }} reveal">
          {%- if st.eyebrow != blank -%}<p class="eyebrow">{{ st.eyebrow }}</p>{%- endif -%}
          {%- if st.heading != blank -%}
            <h2 class="display-2">{{ st.heading | escape | newline_to_br }}</h2>
          {%- endif -%}
          {%- if st.lede != blank -%}
            <p class="body-lg" style="margin-top:1rem">{{ st.lede }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="worth{% if st.sum_side == 'right' %} worth--flip{% endif %}">
        {%- if can_divide -%}
          <div class="{{ panel }} reveal">
            <dl class="worth__rows">
              <div class="worth__row">
                <dt>{{ st.row_hours_label }}</dt>
                <dd>{% render 'pl-num', n: hours_day %}</dd>
              </div>
              <div class="worth__row">
                <dt>{{ st.row_nights_label }}</dt>
                <dd>{% render 'pl-num', n: nights %}</dd>
              </div>
              <div class="worth__row">
                <dt>
                  {{ st.row_price_label }}
                  {%- if st.price_product != blank and st.show_price_name -%}
                    <span class="worth__which">{% render 'pl-title', product: st.price_product %}</span>
                  {%- endif -%}
                </dt>
                <dd>{{ pence | money_without_trailing_zeros }}</dd>
              </div>
              <div class="worth__row worth__row--total">
                <dt>{{ st.row_total_label }}</dt>
                <dd>
                  {%- if per_night < 100 -%}
                    {%- if floored_to_a_penny -%}under {% endif -%}{{ per_night }}p
                  {%- else -%}
                    {{ per_night | money_without_trailing_zeros }}
                  {%- endif -%}
                </dd>
              </div>
            </dl>
            {%- if st.sum_note != blank -%}
              <p class="worth__note">
                {%- comment -%}
                  The hours figure is substituted rather than typed, so the
                  note can never disagree with the sum above it — change the
                  guarantee and the sentence changes with it.
                {%- endcomment -%}
                {%- capture hours_fmt %}{% render 'pl-num', n: hours %}{% endcapture -%}
                {{ st.sum_note | replace: '[hours]', hours_fmt | replace: '[years]', years | replace: '[nights]', nights }}
              </p>
            {%- endif -%}
          </div>
        {%- else -%}
          {%- comment -%}
            No price to divide, so there is no sum. In the editor this says
            why; on the live page it renders nothing at all rather than an
            empty frame.
          {%- endcomment -%}
          {%- if request.design_mode -%}
            <div class="worth__sum worth__sum--empty">
              <p><b>No figure to work from.</b> Pick a bed under “The price this is worked out from”, or type a price. The sum stays hidden on the live page until you do.</p>
            </div>
          {%- endif -%}
        {%- endif -%}

        <div class="worth__say reveal" style="--i:2">
          {%- if st.pull != blank -%}
            <p class="pull">{{ st.pull }}</p>
          {%- endif -%}
          {%- if st.body != blank -%}
            <div class="pl-rte">{{ st.body }}</div>
          {%- endif -%}

          {%- if section.blocks.size > 0 -%}
            <ul class="worth__list">
              {%- for block in section.blocks -%}
                {%- comment -%}
                  The filter runs in an assign rather than on the render
                  argument. A filter applied to a `render` argument is a
                  Liquid syntax error, and it takes the whole section down
                  rather than the one line — this file has been bitten by it
                  before.
                {%- endcomment -%}
                {%- assign point_icon = block.settings.icon | default: 'check' -%}
                <li {{ block.shopify_attributes }}>
                  {% render 'pl-icon', icon: point_icon %}
                  <span>{{ block.settings.text }}</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if st.cta_text != blank -%}
            <div class="worth__cta">
              <a class="btn btn--lg" href="{{ st.cta_link | default: '#pl-finder' }}">
                {{ st.cta_text }}{% render 'pl-icon', icon: 'arrow', class: 'btn__arrow', size: 18 %}
              </a>
              {%- if st.cta_2_text != blank -%}
                <a class="btn btn--lg btn--{{ st.cta_2_style | default: 'ghost' }}" href="{{ st.cta_2_link }}">{{ st.cta_2_text }}</a>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if st.fine_print != blank -%}
            <p class="worth__fine">{{ st.fine_print }}</p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
</div>

