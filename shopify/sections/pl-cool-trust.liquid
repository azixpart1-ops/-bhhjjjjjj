{% render 'pl-assets' %}
{% render 'pl-scheme', id: section.id, scheme: section.settings.scheme, bg: section.settings.bg, accent: section.settings.accent, tone: section.settings.tone %}
{% render 'pl-cool-palette' %}
<div class="pl">
  <section class="cool-trust">
    <div class="wrap">
      <ul class="cool-trust__list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            {% render 'pl-icon', icon: block.settings.icon, size: 17 %}
            <span>{{ block.settings.text }}</span>
          </li>
        {%- endfor -%}
      </ul>
      {%- if section.settings.show_note -%}
        {% render 'pl-cool-note', text: section.settings.note, class: 'cool-note--tight' %}
      {%- endif -%}
    </div>
  </section>
</div>
{% schema %}
{
  "name": "PL – Cooling trust bar",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "Show the safety note",
      "default": false
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Note"
    },
    {
      "type": "header",
      "content": "Colour"
    },
    {
      "type": "paragraph",
      "content": "Text colour is chosen by measuring contrast against the background you pick, so a section cannot end up unreadable. The editor warns you if a background leaves no readable option."
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "cream",
          "label": "Cream, calm"
        },
        {
          "value": "oat",
          "label": "Oat, warm neutral"
        },
        {
          "value": "gold",
          "label": "Gold, warmth"
        },
        {
          "value": "forest",
          "label": "Forest, authority"
        },
        {
          "value": "clay",
          "label": "Deep green, focus"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "info": "Custom scheme only."
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Buttons and links",
      "info": "Custom scheme only."
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Text colour",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Automatic, recommended"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "light",
          "label": "Light"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "check",
          "options": [
            {
              "value": "check",
              "label": "Tick"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "truck",
              "label": "Delivery"
            },
            {
              "value": "drop",
              "label": "Washable"
            },
            {
              "value": "pin",
              "label": "Location"
            },
            {
              "value": "medal",
              "label": "Medal"
            }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PL – Cooling trust bar"
    }
  ]
}
{% endschema %}
