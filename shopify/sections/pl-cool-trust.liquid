{% render 'pl-assets' %}
{% render 'pl-cool-palette' %}
<div class="pl">
  <section class="cool-trust">
    <div class="wrap">
      <ul class="cool-trust__list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            {% render 'pl-icon', icon: block.settings.icon, size: 17 %}
            <span>{{ block.settings.text }}</span>
          </li>
        {%- endfor -%}
      </ul>
      {%- if section.settings.show_note -%}
        {% render 'pl-cool-note', text: section.settings.note, class: 'cool-note--tight' %}
      {%- endif -%}
    </div>
  </section>
</div>
{% schema %}
{
  "name": "PL – Cooling trust bar",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_note", "label": "Show the safety note", "default": false },
    { "type": "textarea", "id": "note", "label": "Note" }
  ],
  "blocks": [
    { "type": "item", "name": "Trust item", "limit": 6, "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "check",
        "options": [
          { "value": "check", "label": "Tick" },
          { "value": "shield", "label": "Shield" },
          { "value": "truck", "label": "Delivery" },
          { "value": "drop", "label": "Washable" },
          { "value": "pin", "label": "Location" },
          { "value": "medal", "label": "Medal" }
        ] },
      { "type": "text", "id": "text", "label": "Text" } ] }
  ],
  "presets": [{ "name": "PL – Cooling trust bar" }]
}
{% endschema %}
