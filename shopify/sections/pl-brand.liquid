{% render 'pl-assets' %}
{% render 'pl-scheme', id: section.id, scheme: section.settings.scheme, bg: section.settings.bg, accent: section.settings.accent, tone: section.settings.tone %}
{% render 'pl-layout', id: section.id, s: section.settings %}
{%- liquid
  assign st = section.settings

  assign img = st.image
  if img == blank and st.image_product != blank
    assign img = st.image_product.featured_image
  endif

  case st.split
    when 'copy'
      assign split = '1.15fr 1fr'
    when 'media'
      assign split = '1fr 1.15fr'
    else
      assign split = '1fr 1fr'
  endcase

  comment
    Copy is first in the source here, so "image on the left" is the flipped
    case for this row and "right" is the default.
  endcomment
  assign brandrow = 'brandrow'
  if st.media_side == 'left'
    assign brandrow = brandrow | append: ' brandrow--flip'
  endif
-%}
<div class="pl">
  <section class="pl-section pl-section--oat"
           {% if st.anchor != blank %}id="{{ st.anchor | handleize }}"{% endif %}
           style="--row-split:{{ split }};--row-ratio:{{ st.ratio | default: '4 / 3' }}">
    <div class="wrap">
      <div class="{{ brandrow }}">
        <div>
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow reveal">{{ section.settings.eyebrow }}</p>{%- endif -%}
          <h2 class="display-2 reveal" style="--i:1">{{ section.settings.heading | escape | newline_to_br }}</h2>
          <div class="body-lg reveal" style="--i:2;margin-top:1.25rem">{{ section.settings.body }}</div>

          <div class="contrast reveal" style="--i:3">
            <div class="contrast__col contrast__col--them">
              <h4>{{ section.settings.them_title }}</h4>
              <ul>
                {%- for block in section.blocks -%}
                  {%- if block.type == 'them' -%}
                    <li {{ block.shopify_attributes }}>{% render 'pl-icon', icon: 'cross' %} {{ block.settings.text }}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
            <div class="contrast__col contrast__col--us">
              <h4>{{ section.settings.us_title }}</h4>
              <ul>
                {%- for block in section.blocks -%}
                  {%- if block.type == 'us' -%}
                    <li {{ block.shopify_attributes }}>{% render 'pl-icon', icon: 'check' %} {{ block.settings.text }}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          </div>
        </div>
        {%- if img != blank -%}
          <img class="brandrow__img reveal" style="--i:2"
               src="{{ img | image_url: width: 900 }}"
               srcset="{{ img | image_url: width: 560 }} 560w, {{ img | image_url: width: 1100 }} 1100w"
               sizes="(min-width: 900px) 45vw, 100vw"
               width="900" height="900" loading="lazy" decoding="async"
               alt="{{ img.alt | escape | default: section.settings.image_alt }}">
        {%- endif -%}
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "PL – Made in Yorkshire",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
