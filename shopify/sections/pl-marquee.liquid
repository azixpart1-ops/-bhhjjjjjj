{% render 'pl-assets' %}
{%- capture items -%}
  {%- for block in section.blocks -%}
    <span class="marquee__item" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
  {%- endfor -%}
{%- endcapture -%}
<div class="pl">
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">{{ items }}</div>
    <div class="marquee__track">{{ items }}</div>
  </div>
</div>
{% schema %}
{
  "name": "PL — Proof marquee",
  "tag": "pl-section",
  "blocks": [
    { "type": "item", "name": "Claim", "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "50kg/m³ high-density memory foam" } ] }
  ],
  "presets": [{ "name": "PL — Proof marquee" }]
}
{% endschema %}
