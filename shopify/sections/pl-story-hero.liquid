{% render 'pl-assets' %}
{%- liquid
  assign img = section.settings.image
  if img == blank and section.settings.image_product != blank
    assign img = section.settings.image_product.featured_image
  endif
-%}
<div class="pl">
  <section class="story-hero">
    <div class="wrap">
      <div class="story-hero__grid">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow reveal">{{ section.settings.eyebrow }}</p>
          {%- endif -%}

          <h1 class="display-1 reveal" style="--i:1">{{ section.settings.heading | escape | newline_to_br }}</h1>

          {%- if section.settings.lede != blank -%}
            <p class="story-hero__lede reveal" style="--i:2">{{ section.settings.lede }}</p>
          {%- endif -%}

          {%- if section.blocks.size > 0 -%}
            <ol class="ledger reveal" style="--i:3">
              {%- for block in section.blocks -%}
                <li {{ block.shopify_attributes }}>
                  <b>{{ block.settings.label }}</b>
                  <span>{{ block.settings.outcome }}</span>
                </li>
              {%- endfor -%}
            </ol>
          {%- endif -%}

          {%- if section.settings.verdict_label != blank -%}
            <p class="ledger__verdict reveal" style="--i:4">
              <span>{{ section.settings.verdict_label }}</span>
              <b>{{ section.settings.verdict }}</b>
            </p>
          {%- endif -%}

          {%- if section.settings.body != blank -%}
            <div class="story-hero__body reveal" style="--i:5">{{ section.settings.body }}</div>
          {%- endif -%}

          <div class="story-hero__cta reveal" style="--i:6">
            {%- if section.settings.cta_1_text != blank -%}
              <a class="btn btn--lg" href="{{ section.settings.cta_1_link | default: '#pl-finder' }}">
                {{ section.settings.cta_1_text }}{% render 'pl-icon', icon: 'arrow', class: 'btn__arrow', size: 18 %}
              </a>
            {%- endif -%}
            {%- if section.settings.cta_2_text != blank -%}
              <a class="btn btn--lg btn--onDark" href="{{ section.settings.cta_2_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_2_text }}</a>
            {%- endif -%}
          </div>

          {%- if section.settings.reassurance != blank -%}
            <p class="story-hero__fine reveal" style="--i:7">{{ section.settings.reassurance }}</p>
          {%- endif -%}
        </div>

        {%- if img != blank -%}
          <div class="reveal" style="--i:2">
            <img class="story-hero__img"
                 src="{{ img | image_url: width: 1000 }}"
                 srcset="{{ img | image_url: width: 560 }} 560w, {{ img | image_url: width: 1000 }} 1000w, {{ img | image_url: width: 1400 }} 1400w"
                 sizes="(min-width: 900px) 45vw, 100vw"
                 width="1000" height="1250"
                 fetchpriority="high" decoding="async"
                 alt="{{ img.alt | escape | default: section.settings.image_alt }}">
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "PL — The beds before",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Before you buy a fourth" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "You have bought him\nbeds before." },
    { "type": "textarea", "id": "lede", "label": "Sub-line", "default": "Good ones. He still gets up in the night." },
    { "type": "text", "id": "verdict_label", "label": "Verdict label", "default": "What they had in common" },
    { "type": "text", "id": "verdict", "label": "Verdict", "default": "Filling that moves." },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "text", "id": "cta_1_text", "label": "Primary button", "default": "Find the one that lasts" },
    { "type": "url", "id": "cta_1_link", "label": "Primary link" },
    { "type": "text", "id": "cta_2_text", "label": "Secondary button", "default": "Shop orthopaedic beds" },
    { "type": "url", "id": "cta_2_link", "label": "Secondary link" },
    { "type": "text", "id": "reassurance", "label": "Fine print", "default": "100-night trial · 5-year foam guarantee · Free UK delivery over £40" },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "product", "id": "image_product", "label": "…or use this product's photo" },
    { "type": "text", "id": "image_alt", "label": "Alt text", "default": "A dog lying on the floor beside an unused bed" }
  ],
  "blocks": [
    { "type": "bed", "name": "A bed before", "limit": 4, "settings": [
      { "type": "text", "id": "label", "label": "Which one" },
      { "type": "textarea", "id": "outcome", "label": "What happened" } ] }
  ],
  "presets": [{ "name": "PL — The beds before" }]
}
{% endschema %}
