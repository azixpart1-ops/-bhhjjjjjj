{% render 'pl-assets' %}
{% render 'pl-scheme', id: section.id, scheme: section.settings.scheme, bg: section.settings.bg, accent: section.settings.accent, tone: section.settings.tone %}
{%- liquid
  assign img = section.settings.image
  if img == blank and section.settings.image_product != blank
    assign img = section.settings.image_product.featured_image
  endif
-%}
<div class="pl">
  <section class="pl-section pl-section--dark">
    <div class="wrap">
      <div class="trial">
        {%- if img != blank -%}
          <img class="trial__img reveal"
               src="{{ img | image_url: width: 900 }}"
               srcset="{{ img | image_url: width: 560 }} 560w, {{ img | image_url: width: 1100 }} 1100w"
               sizes="(min-width: 900px) 45vw, 100vw"
               width="900" height="900" loading="lazy" decoding="async"
               alt="{{ img.alt | escape | default: section.settings.image_alt }}">
        {%- endif -%}
        <div>
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow reveal">{{ section.settings.eyebrow }}</p>{%- endif -%}
          <h2 class="display-2 reveal" style="--i:1">{{ section.settings.heading | escape | newline_to_br }}</h2>
          {%- if section.settings.pull != blank -%}
            <p class="pull reveal" style="--i:2;margin-top:1.75rem">{{ section.settings.pull }}</p>
          {%- endif -%}
          <div class="steps reveal" style="--i:3">
            {%- for block in section.blocks -%}
              <div class="step" {{ block.shopify_attributes }}>
                <span class="step__n"></span>
                <div><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></div>
              </div>
            {%- endfor -%}
          </div>
          {%- if section.settings.fine_print != blank -%}
            <p class="muted reveal" style="--i:4;font-size:.9rem">{{ section.settings.fine_print }}</p>
          {%- endif -%}
          {%- if section.settings.link_text != blank -%}
            <p class="reveal" style="--i:5;margin-top:1.25rem">
              <a class="link-arrow" href="{{ section.settings.link_url }}">
                {{ section.settings.link_text }}{% render 'pl-icon', icon: 'arrow', class: 'btn__arrow', size: 16 %}
              </a>
            </p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "PL – 100-night trial",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our promise"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Try it for 100 nights.\nAt our risk, not yours."
    },
    {
      "type": "textarea",
      "id": "pull",
      "label": "Pull quote",
      "default": "If your dog isn't visibly more comfortable, we collect it free of charge and refund every penny."
    },
    {
      "type": "text",
      "id": "fine_print",
      "label": "Fine print",
      "default": "Every memory foam bed also carries a 5-year foam guarantee."
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Read the returns policy"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "product",
      "id": "image_product",
      "label": "…or use this product's photo"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Alt text",
      "default": "A dog asleep on a PawLunova bed"
    },
    {
      "type": "header",
      "content": "Colour"
    },
    {
      "type": "paragraph",
      "content": "Text colour is chosen by measuring contrast against the background you pick, so a section cannot end up unreadable. The editor warns you if a background leaves no readable option."
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "cream",
          "label": "Cream, calm"
        },
        {
          "value": "oat",
          "label": "Oat, warm neutral"
        },
        {
          "value": "gold",
          "label": "Gold, warmth"
        },
        {
          "value": "forest",
          "label": "Forest, authority"
        },
        {
          "value": "clay",
          "label": "Deep green, focus"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "info": "Custom scheme only."
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Buttons and links",
      "info": "Custom scheme only."
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Text colour",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Automatic, recommended"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "light",
          "label": "Light"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Step description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PL – 100-night trial"
    }
  ]
}
{% endschema %}
