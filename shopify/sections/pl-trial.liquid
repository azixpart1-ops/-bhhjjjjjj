{% render 'pl-assets' %}
{% render 'pl-scheme', id: section.id, scheme: section.settings.scheme, bg: section.settings.bg, accent: section.settings.accent, tone: section.settings.tone %}
{% render 'pl-layout', id: section.id, s: section.settings %}
{%- liquid
  assign st = section.settings

  assign img = st.image
  if img == blank and st.image_product != blank
    assign img = st.image_product.featured_image
  endif

  case st.split
    when 'copy'
      assign split = '1fr 1.15fr'
    when 'media'
      assign split = '1.15fr 1fr'
    else
      assign split = '1fr 1fr'
  endcase

  comment
    The image is first in the source because the section leads with it. Moving
    it to the right is a visual swap only, so the promise still reads before
    the photograph for anyone not seeing the layout.
  endcomment
  assign trial = 'trial'
  if st.media_side == 'right'
    assign trial = trial | append: ' trial--flip'
  endif
-%}
<div class="pl">
  <section class="pl-section pl-section--dark"
           {% if st.anchor != blank %}id="{{ st.anchor | handleize }}"{% endif %}
           style="--row-split:{{ split }};--row-ratio:{{ st.ratio | default: '1 / 1' }}">
    <div class="wrap">
      <div class="{{ trial }}">
        {%- if img != blank -%}
          <img class="trial__img reveal"
               src="{{ img | image_url: width: 900 }}"
               srcset="{{ img | image_url: width: 560 }} 560w, {{ img | image_url: width: 1100 }} 1100w"
               sizes="(min-width: 900px) 45vw, 100vw"
               width="900" height="900" loading="lazy" decoding="async"
               alt="{{ img.alt | escape | default: section.settings.image_alt }}">
        {%- endif -%}
        <div>
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow reveal">{{ section.settings.eyebrow }}</p>{%- endif -%}
          <h2 class="display-2 reveal" style="--i:1">{{ section.settings.heading | escape | newline_to_br }}</h2>
          {%- if section.settings.pull != blank -%}
            <p class="pull reveal" style="--i:2;margin-top:1.75rem">{{ section.settings.pull }}</p>
          {%- endif -%}

          {%- comment -%}
            The date the trial runs to, worked out rather than described.
            "100 nights" is a policy; "you have until the 8th of December" is
            a thing a person can picture, and the whole job of this section is
            to make the risk feel already handled rather than merely covered.

            It is rendered twice over. Liquid does the sum so the line is
            right in the HTML — for a crawler, for a printed page, and for
            anyone with the script blocked. The script then recomputes it in
            the reader's own timezone and overwrites, because Shopify caches
            rendered sections and a cached date is the one thing here that
            could go quietly wrong. See the trial-date note in pl-app.js.
          {%- endcomment -%}
          {%- if st.show_date and st.date_line != blank -%}
            {%- liquid
              assign trial_nights = st.trial_nights | default: 100 | plus: 0
              assign seconds = trial_nights | times: 86400
              assign ends_at = 'now' | date: '%s' | plus: seconds
              assign ends_on = ends_at | date: '%-d %B %Y'
              assign dparts = st.date_line | split: '[date]'
            -%}
            <p class="trial__date reveal" style="--i:3" data-trial-nights="{{ trial_nights }}">
              {{ dparts[0] }}
              {%- if dparts.size > 1 -%}
                <b data-trial-date>{{ ends_on }}</b>{{ dparts[1] }}
              {%- endif -%}
            </p>
          {%- endif -%}

          <div class="steps reveal" style="--i:3">
            {%- for block in section.blocks -%}
              <div class="step" {{ block.shopify_attributes }}>
                <span class="step__n"></span>
                <div><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></div>
              </div>
            {%- endfor -%}
          </div>
          {%- if section.settings.fine_print != blank -%}
            <p class="muted reveal" style="--i:4;font-size:.9rem">{{ section.settings.fine_print }}</p>
          {%- endif -%}
          {%- if section.settings.link_text != blank -%}
            <p class="reveal" style="--i:5;margin-top:1.25rem">
              <a class="link-arrow" href="{{ section.settings.link_url }}">
                {{ section.settings.link_text }}{% render 'pl-icon', icon: 'arrow', class: 'btn__arrow', size: 16 %}
              </a>
            </p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "PL – 100-night trial",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our promise"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Try it for 100 nights.\nAt our risk, not yours."
    },
    {
      "type": "textarea",
      "id": "pull",
      "label": "Pull quote",
      "default": "If your dog isn't visibly more comfortable, we collect it free of charge and refund every penny."
    },
    {
      "type": "header",
      "content": "The date it runs to"
    },
    {
      "type": "paragraph",
      "content": "\"100 nights\" is a policy. \"You have until the 8th of December\" is something a person can picture, and picturing it is what turns a stated return window into a risk that already feels handled. The date is worked out from today every time the page loads — there is nothing to keep up to date."
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show the date the trial runs to",
      "default": true
    },
    {
      "type": "range",
      "id": "trial_nights",
      "label": "How many nights",
      "min": 30,
      "max": 200,
      "step": 5,
      "unit": "n",
      "default": 100,
      "info": "Must match the returns policy. This is the number the date is counted from."
    },
    {
      "type": "text",
      "id": "date_line",
      "label": "The line",
      "default": "Order today and you have until [date] to change your mind.",
      "info": "[date] is replaced with the date the trial ends. Leave the token out and the line prints without a date."
    },
    {
      "type": "text",
      "id": "fine_print",
      "label": "Fine print",
      "default": "Every memory foam bed also carries a 5-year foam guarantee."
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Read the returns policy"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "product",
      "id": "image_product",
      "label": "…or use this product's photo"
    },
    {
      "type": "text",
