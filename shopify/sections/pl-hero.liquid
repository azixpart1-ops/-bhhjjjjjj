{% render 'pl-assets' %}
{%- liquid
  assign img = section.settings.image
  if img == blank and section.settings.image_product != blank
    assign img = section.settings.image_product.featured_image
  endif
-%}
<div class="pl">
  <section class="pl-hero">
    <div class="wrap">
      <div class="pl-hero__grid">
        <div class="pl-hero__copy">
          {%- if section.settings.show_rating -%}
            <p class="pl-hero__badge reveal">
              <span class="pl-stars" aria-hidden="true">
                {% for i in (1..5) %}{% render 'pl-icon', icon: 'star' %}{% endfor %}
              </span>
              <span>{{ section.settings.rating_text }}</span>
            </p>
          {%- endif -%}

          <h1 class="display-1 reveal" style="--i:1">{{ section.settings.heading | escape | newline_to_br }}</h1>

          {%- if section.settings.lede != blank -%}
            <p class="lede reveal" style="--i:2">{{ section.settings.lede }}</p>
          {%- endif -%}

          {%- if section.settings.body != blank -%}
            <div class="body-lg pl-hero__body reveal" style="--i:3">{{ section.settings.body }}</div>
          {%- endif -%}

          <div class="pl-hero__cta reveal" style="--i:4">
            {%- if section.settings.cta_1_text != blank -%}
              <a class="btn btn--lg" href="{{ section.settings.cta_1_link | default: '#pl-finder' }}">
                {{ section.settings.cta_1_text }}{% render 'pl-icon', icon: 'arrow', class: 'btn__arrow', size: 18 %}
              </a>
            {%- endif -%}
            {%- if section.settings.cta_2_text != blank -%}
              <a class="btn btn--lg btn--ghost" href="{{ section.settings.cta_2_link }}">{{ section.settings.cta_2_text }}</a>
            {%- endif -%}
          </div>
        </div>

        <div class="pl-hero__media reveal" style="--i:2">
          {%- if img != blank -%}
            <img class="pl-hero__img"
                 src="{{ img | image_url: width: 1200 }}"
                 srcset="{{ img | image_url: width: 560 }} 560w, {{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1400 }} 1400w"
                 sizes="(min-width: 900px) 50vw, 100vw"
                 width="1200" height="1200"
                 fetchpriority="high" decoding="async"
                 alt="{{ img.alt | escape | default: section.settings.image_alt }}">
          {%- endif -%}
          {%- if section.settings.proof_number != blank -%}
            <div class="pl-hero__proof">
              <strong>{{ section.settings.proof_number }}</strong>
              <span>{{ section.settings.proof_text }}</span>
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="trust-strip reveal">
        {%- for block in section.blocks -%}
          <div class="trust-strip__item" {{ block.shopify_attributes }}>
            {% render 'pl-icon', icon: block.settings.icon %}
            <div><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "PL — Hero",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_rating", "label": "Show star rating", "default": true },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "<strong>4.8</strong>/5 from 3,900+ UK owners" },
    { "type": "textarea", "id": "heading", "label": "Heading (line breaks are kept)", "default": "The sleep they'd choose,\nif they could choose." },
    { "type": "textarea", "id": "lede", "label": "Emotional pl-line", "default": "You notice it before they do. The pause at the bottom of the stairs. The longer stretch before the first step." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>PawLunova beds are built on <strong>50kg/m³ high-density memory foam</strong> — dense enough to cradle hips, elbows and spine, and to still be doing it in year five. Designed, made and dispatched from our Yorkshire workshop.</p>" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "cta_1_text", "label": "Primary button", "default": "Find their bed" },
    { "type": "url", "id": "cta_1_link", "label": "Primary link" },
    { "type": "text", "id": "cta_2_text", "label": "Secondary button", "default": "Shop orthopaedic beds" },
    { "type": "url", "id": "cta_2_link", "label": "Secondary link" },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "product", "id": "image_product", "label": "…or use this product's photo" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "A dog asleep on a PawLunova bed" },
    { "type": "header", "content": "Floating proof pl-card" },
    { "type": "html", "id": "proof_number", "label": "Number", "default": "50<span style=\"font-size:.55em\">kg/m³</span>" },
    { "type": "text", "id": "proof_text", "label": "Caption", "default": "High-density memory foam core. Guaranteed for 5 years." }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust item",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "shield",
          "options": [
            { "value": "shield", "label": "Shield" }, { "value": "medal", "label": "Medal" },
            { "value": "pin", "label": "Location pin" }, { "value": "truck", "label": "Delivery" },
            { "value": "leaf", "label": "Leaf" }, { "value": "drop", "label": "Waterproof" }
          ] },
        { "type": "text", "id": "title", "label": "Title", "default": "100-night sleep trial" },
        { "type": "text", "id": "text", "label": "Subtitle", "default": "Free collection, full refund" }
      ]
    }
  ],
  "presets": [{ "name": "PL — Hero" }]
}
{% endschema %}
