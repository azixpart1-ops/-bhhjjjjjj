{% render 'pl-assets' %}
{% render 'pl-scheme', id: section.id, scheme: section.settings.scheme, bg: section.settings.bg, accent: section.settings.accent, tone: section.settings.tone %}
{% render 'pl-layout', id: section.id, s: section.settings %}
{%- liquid
  assign st = section.settings

  assign img = st.image
  if img == blank and st.image_product != blank
    assign img = st.image_product.featured_image
  endif

  comment
    Class list is built once rather than inline, so the markup below reads as
    markup. Every modifier is additive: with no settings changed this resolves
    to the single class the section shipped with.
  endcomment
  assign hero_class = 'pl-hero'
  if st.layout == 'stacked'
    assign hero_class = hero_class | append: ' pl-hero--stacked'
  elsif st.media_side == 'left'
    assign hero_class = hero_class | append: ' pl-hero--media-left'
  endif
  case st.image_shape
    when 'arch'
      assign hero_class = hero_class | append: ' pl-hero--arch'
    when 'square'
      assign hero_class = hero_class | append: ' pl-hero--square'
  endcase
  if st.image_shadow == false
    assign hero_class = hero_class | append: ' pl-hero--flat'
  endif

  case st.split
    when 'even'
      assign split = '1fr 1fr'
    when 'media'
      assign split = '1fr 1.15fr'
    else
      assign split = '1.02fr 1fr'
  endcase

  assign trust_class = 'trust-strip'
  case st.trust_style
    when 'cards'
      assign trust_class = trust_class | append: ' trust-strip--cards'
    when 'plain'
      assign trust_class = trust_class | append: ' trust-strip--plain'
  endcase
  if st.trust_scroll
    assign trust_class = trust_class | append: ' trust-strip--scroll'
  endif
-%}
<div class="pl">
  <section class="{{ hero_class }}"
           {% if st.anchor != blank %}id="{{ st.anchor | handleize }}"{% endif %}
           style="--hero-split:{{ split }};--hero-ratio:{{ st.image_ratio | default: '5 / 6' }};--trust-cols:{{ st.trust_cols | default: 4 }}">
    <div class="wrap">
      <div class="pl-hero__grid">
        <div class="pl-hero__copy">
          {%- if section.settings.show_rating -%}
            <p class="pl-hero__badge reveal">
              <span class="pl-stars" aria-hidden="true">
                {% for i in (1..5) %}{% render 'pl-icon', icon: 'star' %}{% endfor %}
              </span>
              <span>{{ section.settings.rating_text }}</span>
            </p>
          {%- endif -%}

          <h1 class="display-1 reveal" style="--i:1">{{ section.settings.heading | escape | newline_to_br }}</h1>

          {%- if section.settings.lede != blank -%}
            <p class="lede reveal" style="--i:2">{{ section.settings.lede }}</p>
          {%- endif -%}

          {%- if section.settings.body != blank -%}
            <div class="body-lg pl-hero__body reveal" style="--i:3">{{ section.settings.body }}</div>
          {%- endif -%}

          <div class="pl-hero__cta reveal" style="--i:4">
            {%- if section.settings.cta_1_text != blank -%}
              <a class="btn btn--lg" href="{{ section.settings.cta_1_link | default: '#pl-finder' }}">
                {{ section.settings.cta_1_text }}{% render 'pl-icon', icon: 'arrow', class: 'btn__arrow', size: 18 %}
              </a>
            {%- endif -%}
            {%- if section.settings.cta_2_text != blank -%}
              <a class="btn btn--lg btn--{{ section.settings.cta_2_style | default: 'soft' }}" href="{{ section.settings.cta_2_link }}">{{ section.settings.cta_2_text }}{% if section.settings.cta_2_style != 'ghost' %}{% render 'pl-icon', icon: 'arrow', class: 'btn__arrow', size: 18 %}{% endif %}</a>
            {%- endif -%}
          </div>
        </div>

        <div class="pl-hero__media reveal" style="--i:2">
          {%- if img != blank -%}
            <img class="pl-hero__img"
                 src="{{ img | image_url: width: 1200 }}"
                 srcset="{{ img | image_url: width: 560 }} 560w, {{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1400 }} 1400w"
                 sizes="(min-width: 900px) 50vw, 100vw"
                 width="1200" height="1200"
                 fetchpriority="high" decoding="async"
                 alt="{{ img.alt | escape | default: section.settings.image_alt }}">
          {%- endif -%}
          {%- if section.settings.proof_number != blank -%}
            <div class="pl-hero__proof">
              <strong>{{ section.settings.proof_number }}</strong>
              <span>{{ section.settings.proof_text }}</span>
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="{{ trust_class }} reveal">
        {%- for block in section.blocks -%}
          <div class="trust-strip__item" {{ block.shopify_attributes }}>
            {% render 'pl-icon', icon: block.settings.icon %}
            <div><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "PL – Hero",
  "tag": "section",
  "settings": [
    {
