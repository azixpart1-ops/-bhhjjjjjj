{% render 'pl-assets' %}
<div class="pl">
  <section class="wrap">
    <div class="page-hero reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1>{{ section.settings.heading | default: blog.title }}</h1>
      {%- if section.settings.standfirst != blank -%}<p>{{ section.settings.standfirst }}</p>{%- endif -%}
    </div>
    {%- paginate blog.articles by 12 -%}
      <div class="posts" style="padding-bottom:clamp(2rem,5vw,4rem)">
        {%- for a in blog.articles -%}
          <a class="post reveal" style="--i:{{ forloop.index0 | modulo: 3 | plus: 1 }}" href="{{ a.url }}">
            <div class="post__media">
              {%- if a.image -%}
                <img src="{{ a.image | image_url: width: 700 }}" alt="{{ a.image.alt | escape | default: a.title | escape }}" width="700" height="466" loading="lazy" decoding="async">
              {%- endif -%}
            </div>
            <span class="post__meta">{{ a.published_at | date: '%-d %B %Y' }}</span>
            <h2>{{ a.title }}</h2>
            <p>{{ a.excerpt_or_content | strip_html | truncate: 140 }}</p>
          </a>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="pager" aria-label="Pagination">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" rel="prev">Previous</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}<span {% if part.title == paginate.current_page %}aria-current="page"{% endif %}>{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}" rel="next">Next</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </section>
</div>
{% schema %}
{
  "name": "PL — Blog",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Guides" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "standfirst", "label": "Standfirst" }
  ],
  "presets": [{ "name": "PL — Blog" }]
}
{% endschema %}
