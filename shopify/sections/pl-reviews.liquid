{% render 'pl-assets' %}
{% render 'pl-scheme', id: section.id, scheme: section.settings.scheme, bg: section.settings.bg, accent: section.settings.accent, tone: section.settings.tone %}
{% render 'pl-layout', id: section.id, s: section.settings %}
{%- liquid
  comment
    Count first. With no matching reviews the section would otherwise render a
    heading and an aggregate score above an empty grid, which is worse than
    showing nothing at all.
  endcomment
  assign matches = 0
  for block in section.blocks
    if section.settings.scope == 'product'
      if block.settings.product != blank and block.settings.product.id == product.id
        assign matches = matches | plus: 1
      endif
    else
      assign matches = matches | plus: 1
    endif
  endfor

  assign st = section.settings

  assign revs = 'reviews'
  if st.card == 'plain'
    assign revs = revs | append: ' reviews--plain'
  endif
  if st.mobile == 'scroll'
    assign revs = revs | append: ' reviews--scroll'
  endif
-%}
{%- if matches > 0 -%}
<div class="pl">
  <section class="pl-section"
           {% if st.anchor != blank %}id="{{ st.anchor | handleize }}"{% endif %}
           style="--rev-cols:{{ st.cols | default: 4 }}">
    <div class="wrap">
      <div class="review-head">
        <div class="reveal">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          <h2 class="display-2">{{ section.settings.heading | escape | newline_to_br }}</h2>
        </div>
        {%- if st.show_score -%}
        <div class="score reveal" style="--i:1">
          <div class="score__n" data-count="{{ section.settings.score }}" data-decimals="1">{{ section.settings.score }}<small>/5</small></div>
          <div>
            <span class="pl-stars" aria-hidden="true">{% for i in (1..5) %}{% render 'pl-icon', icon: 'star' %}{% endfor %}</span>
            <p class="score__meta">{{ section.settings.score_meta }}</p>
          </div>
        </div>
        {%- endif -%}
      </div>
      <div class="{{ revs }}">
        {%- comment -%}
          Product scoping. On a PDP the section is set to "this product only",
          and a review renders only if its block names this product. A review
          about the Harrogate was appearing on every product page, which is the
          kind of detail a customer notices and stops trusting you over.

          There are currently no per-product reviews in the catalogue, so on a
          PDP this loop renders nothing rather than borrowing the site-wide
          ones. It starts working the day real ones are attached.
        {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if section.settings.scope == 'product' -%}
            {%- unless block.settings.product != blank and block.settings.product.id == product.id -%}
              {%- continue -%}
            {%- endunless -%}
          {%- endif -%}
          <blockquote class="review reveal" style="--i:{{ forloop.index }}" {{ block.shopify_attributes }}>
            <span class="pl-stars" aria-label="{{ block.settings.stars }} out of 5">
              {% for i in (1..block.settings.stars) %}{% render 'pl-icon', icon: 'star' %}{% endfor %}
            </span>
            <p>&ldquo;{{ block.settings.quote }}&rdquo;</p>
            <footer class="review__who">
              <b>{{ block.settings.name }}</b>
              {%- if block.settings.verified -%}
                <span class="review__verified">{% render 'pl-icon', icon: 'check' %} Verified</span>
              {%- endif -%}
            </footer>
          </blockquote>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>
{%- endif -%}
{% schema %}
