{% render 'pl-assets' %}
{% render 'pl-scheme', id: section.id, scheme: section.settings.scheme, bg: section.settings.bg, accent: section.settings.accent, tone: section.settings.tone %}
{% render 'pl-layout', id: section.id, s: section.settings %}
{%- liquid
  comment
    Count first. With no matching reviews the section would otherwise render a
    heading and an aggregate score above an empty grid, which is worse than
    showing nothing at all.
  endcomment
  assign matches = 0
  for block in section.blocks
    if section.settings.scope == 'product'
      if block.settings.product != blank and block.settings.product.id == product.id
        assign matches = matches | plus: 1
      endif
    else
      assign matches = matches | plus: 1
    endif
  endfor

  assign st = section.settings

  assign revs = 'reviews'
  if st.card == 'plain'
    assign revs = revs | append: ' reviews--plain'
  endif
  if st.mobile == 'scroll'
    assign revs = revs | append: ' reviews--scroll'
  endif
-%}
{%- if matches > 0 -%}
<div class="pl">
  <section class="pl-section"
           {% if st.anchor != blank %}id="{{ st.anchor | handleize }}"{% endif %}
           style="--rev-cols:{{ st.cols | default: 4 }}">
    <div class="wrap">
      <div class="review-head">
        <div class="reveal">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          <h2 class="display-2">{{ section.settings.heading | escape | newline_to_br }}</h2>
        </div>
        {%- liquid
          assign d5 = st.dist_5 | default: 0 | plus: 0
          assign d4 = st.dist_4 | default: 0 | plus: 0
          assign d3 = st.dist_3 | default: 0 | plus: 0
          assign d2 = st.dist_2 | default: 0 | plus: 0
          assign d1 = st.dist_1 | default: 0 | plus: 0
          assign dist_total = d5 | plus: d4 | plus: d3 | plus: d2 | plus: d1

          assign draw_dist = false
          if st.show_dist and dist_total > 0
            assign draw_dist = true
          endif
        -%}
        {%- if st.show_score or draw_dist -%}
        <div class="score-col">
        {%- endif -%}
        {%- if st.show_score -%}
        <div class="score reveal" style="--i:1">
          <div class="score__n" data-count="{{ section.settings.score }}" data-decimals="1">{{ section.settings.score }}<small>/5</small></div>
          <div>
            <span class="pl-stars" aria-hidden="true">{% for i in (1..5) %}{% render 'pl-icon', icon: 'star' %}{% endfor %}</span>
            <p class="score__meta">{{ section.settings.score_meta }}</p>
            {%- comment -%}
              Where the reviews were collected, as an attributed line rather
              than an assertion. An aggregate score with no source behind it
              is the one number on a shop that a careful buyer discounts
              entirely, and it is discounted hardest by exactly the buyer who
              is weighing up £150. Blank renders nothing: a source that is not
              named is better than one that is invented.
            {%- endcomment -%}
            {%- if st.source_name != blank -%}
              <p class="score__source">
                {{ st.source_prefix }}
                {%- if st.source_url != blank -%}
                  <a href="{{ st.source_url }}" rel="nofollow noopener"{% if st.source_new_tab %} target="_blank"{% endif %}>{{ st.source_name }}{% if st.source_new_tab %}<span class="pl-vh"> (opens in a new tab)</span>{% endif %}</a>
                {%- else -%}
                  <b>{{ st.source_name }}</b>
                {%- endif -%}
              </p>
            {%- endif -%}
          </div>
        </div>
        {%- endif -%}

        {%- comment -%}
          The distribution. A single average is the weakest form a rating can
          take: it is one number, unfalsifiable from the outside, and it reads
          the same whether it came from eleven reviews or eleven thousand.
          The shape underneath it is what a buyer actually reads for honesty —
          a real distribution has a tail, and showing the tail is what makes
          the head believable.

          Every figure is typed in the editor and the bars are drawn from
          those figures, so the section can only ever show what the shop has
          entered. Leave them at zero and the panel does not render.
        {%- endcomment -%}
        {%- if draw_dist -%}
          <div class="dist reveal" style="--i:2">
            {%- assign rows = '5,4,3,2,1' | split: ',' -%}
            {%- for row in rows -%}
              {%- liquid
                case row
                  when '5'
                    assign n = d5
                  when '4'
                    assign n = d4
                  when '3'
                    assign n = d3
                  when '2'
                    assign n = d2
                  else
                    assign n = d1
                endcase
                comment
                  Rounded to a whole percent for the label and kept at one
                  decimal for the bar, so a 0.4% row still draws a sliver
                  rather than vanishing into the track.
                endcomment
                assign pct = n | times: 100.0 | divided_by: dist_total
                assign pct_label = pct | round
              -%}
              <div class="dist__row">
                <span class="dist__star">{{ row }}{% render 'pl-icon', icon: 'star' %}</span>
                <span class="dist__track"><i style="width:{{ pct }}%"></i></span>
                <span class="dist__pct">{{ pct_label }}%</span>
              </div>
            {%- endfor -%}
            {%- if st.dist_note != blank -%}
              <p class="dist__note">{{ st.dist_note }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if st.show_score or draw_dist -%}
        </div>
        {%- endif -%}
      </div>
      <div class="{{ revs }}">
        {%- comment -%}
          Product scoping. On a PDP the section is set to "this product only",
          and a review renders only if its block names this product. A review
          about the Harrogate was appearing on every product page, which is the
          kind of detail a customer notices and stops trusting you over.

          There are currently no per-product reviews in the catalogue, so on a
          PDP this loop renders nothing rather than borrowing the site-wide
          ones. It starts working the day real ones are attached.
        {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if section.settings.scope == 'product' -%}
            {%- unless block.settings.product != blank and block.settings.product.id == product.id -%}
              {%- continue -%}
            {%- endunless -%}
          {%- endif -%}
          <blockquote class="review reveal" style="--i:{{ forloop.index }}" {{ block.shopify_attributes }}>
            <span class="pl-stars" aria-label="{{ block.settings.stars }} out of 5">
              {% for i in (1..block.settings.stars) %}{% render 'pl-icon', icon: 'star' %}{% endfor %}
            </span>
            <p>&ldquo;{{ block.settings.quote }}&rdquo;</p>
            <footer class="review__who">
              <b>{{ block.settings.name }}</b>
              {%- if block.settings.verified -%}
                <span class="review__verified">{% render 'pl-icon', icon: 'check' %} Verified</span>
              {%- endif -%}
            </footer>
            {%- comment -%}
              What they bought and when. Both are optional and both render
              nothing when empty, but together they are what separates a
              quotation from a review: a named bed and a date are checkable,
              and a wall of undated praise is not. The bed name is trimmed the
              same way it is on a card, so a review does not print a search
              tail the rest of the page hides.
            {%- endcomment -%}
            {%- if block.settings.product != blank or block.settings.date != blank -%}
              <p class="review__meta">
                {%- if block.settings.product != blank -%}
                  <a href="{{ block.settings.product.url }}">{% render 'pl-title', product: block.settings.product %}</a>
                {%- endif -%}
                {%- if block.settings.date != blank -%}
                  <span>{{ block.settings.date }}</span>
                {%- endif -%}
              </p>
            {%- endif -%}
          </blockquote>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>
{%- endif -%}
{% schema %}
{
  "name": "PL – Reviews",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "What owners tell us"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "3,900 dogs have already moved in."
    },
    {
      "type": "select",
      "id": "scope",
      "label": "Which reviews to show",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "All reviews (site-wide)"
        },
        {
          "value": "product",
          "label": "Only reviews about this product"
        }
      ],
      "info": "Set to product on the product template. Never mix the two."
    },
    {
      "type": "text",
      "id": "score",
      "label": "Score out of 5",
      "default": "4.8"
    },
    {
      "type": "html",
      "id": "score_meta",
      "label": "Score caption",
      "default": "Based on 3,900+<br>verified reviews"
    },
    {
      "type": "header",
      "content": "Where the reviews came from"
    },
    {
      "type": "paragraph",
      "content": "An aggregate score with nothing behind it is the one number on a shop that a careful buyer discounts entirely — and it is discounted hardest by the buyer weighing up £150. Naming the platform is the single cheapest credibility gain on this page. Leave the name empty and the line does not render at all, which is better than a source that is not real."
    },
    {
      "type": "text",
      "id": "source_prefix",
      "label": "Lead-in",
      "default": "Collected on"
    },
    {
      "type": "text",
      "id": "source_name",
      "label": "Platform name",
      "info": "For example Trustpilot, Judge.me, Google or Reviews.io. Empty hides the whole line."
    },
    {
      "type": "url",
      "id": "source_url",
      "label": "Link to the profile",
      "info": "Optional. With a link the name becomes clickable, which is what makes it checkable."
    },
    {
      "type": "checkbox",
      "id": "source_new_tab",
      "label": "Open the link in a new tab",
      "default": true
    },
    {
      "type": "header",
      "content": "Score distribution"
    },
    {
      "type": "paragraph",
      "content": "How many reviews sit on each star. A real distribution has a tail, and showing the tail is what makes the average believable — it is the difference between a claim and a record. Enter the counts from your review platform; the percentages and bars are worked out from them. Leave them all at zero and the panel does not render."
    },
    {
      "type": "checkbox",
      "id": "show_dist",
      "label": "Show the distribution",
      "default": true
    },
    {
      "type": "number",
      "id": "dist_5",
      "label": "5-star reviews"
    },
    {
      "type": "number",
      "id": "dist_4",
      "label": "4-star reviews"
    },
    {
      "type": "number",
      "id": "dist_3",
      "label": "3-star reviews"
    },
    {
      "type": "number",
      "id": "dist_2",
      "label": "2-star reviews"
    },
    {
      "type": "number",
      "id": "dist_1",
      "label": "1-star reviews"
    },
    {
      "type": "text",
      "id": "dist_note",
      "label": "Note under the bars"
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "select",
      "id": "cols",
      "label": "Columns",
      "default": "4",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ]
    },
    {
      "type": "select",
      "id": "card",
      "label": "Card style",
      "default": "framed",
      "options": [
        {
          "value": "framed",
          "label": "Framed"
        },
        {
          "value": "plain",
          "label": "No frame"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile",
      "label": "On mobile",
      "default": "stack",
      "options": [
        {
          "value": "stack",
          "label": "Stacked"
        },
        {
          "value": "scroll",
          "label": "One swipeable row"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_score",
      "label": "Show the score panel",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout and spacing"
    },
    {
      "type": "paragraph",
      "content": "These control the section's geometry only. Colour is the group below."
    },
    {
      "type": "select",
      "id": "eyebrow_style",
      "label": "Section label",
      "default": "rule",
      "options": [
        {
          "value": "rule",
          "label": "With a leading rule"
        },
        {
          "value": "plain",
          "label": "Plain"
        }
      ],
      "info": "A short rule before the small uppercase label. It gives every section the same entry note, which is most of what makes a page read as designed rather than assembled."
    },
    {
      "type": "range",
      "id": "eyebrow_rule",
      "label": "Rule length",
      "min": 16,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "select",
      "id": "width",
      "label": "Content width",
      "default": "normal",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow — 1040px"
        },
        {
          "value": "normal",
          "label": "Normal — 1240px"
        },
        {
          "value": "wide",
          "label": "Wide — 1440px"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_scale",
      "label": "Heading size",
      "min": 70,
      "max": 130,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Scales this section's headings only. Body copy stays put."
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "pad_top_m",
      "label": "Top padding, mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "pad_bottom_m",
      "label": "Bottom padding, mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "checkbox",
      "id": "divider_top",
      "label": "Hairline above",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "divider_bottom",
      "label": "Hairline below",
      "default": false
    },
    {
      "type": "select",
      "id": "corners",
      "label": "Corners",
      "default": "soft",
      "options": [
        {
          "value": "soft",
          "label": "Soft"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "round",
          "label": "Rounded"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor link id",
      "info": "Lets a button elsewhere jump here, e.g. an id of bed-finder is reached by a link to #bed-finder."
    },
    {
      "type": "header",
      "content": "Colour"
    },
    {
      "type": "paragraph",
      "content": "Text colour is chosen by measuring contrast against the background you pick, so a section cannot end up unreadable. The editor warns you if a background leaves no readable option."
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "cream",
          "label": "Cream, calm"
        },
        {
          "value": "oat",
          "label": "Oat, warm neutral"
        },
        {
          "value": "gold",
          "label": "Gold, warmth"
        },
        {
          "value": "forest",
          "label": "Forest, authority"
        },
        {
          "value": "clay",
          "label": "Deep green, focus"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "info": "Custom scheme only."
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Buttons and links",
      "info": "Custom scheme only."
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Text colour",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Automatic, recommended"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "light",
          "label": "Light"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Which product is this review about?",
          "info": "Required when the section is scoped to a single product. Wherever it is set, the bed is also named and linked under the review, which is what lets a reader check it."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "date",
          "label": "When",
          "info": "Typed as you want it read, for example \"March 2026\". A dated review is checkable; an undated one is a quotation."
        },
        {
          "type": "range",
          "id": "stars",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show \"Verified\"",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PL – Reviews"
    }
  ]
}
{% endschema %}
