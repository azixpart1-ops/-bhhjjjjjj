{% render 'pl-assets' %}
{% render 'pl-scheme', id: section.id, scheme: section.settings.scheme, bg: section.settings.bg, accent: section.settings.accent, tone: section.settings.tone %}
{% render 'pl-layout', id: section.id, s: section.settings %}
{{ 'pl-pdp-plus.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pl-pdp-plus.js' | asset_url }}" defer></script>
{%- comment -%}
  Product buy block. Deliberately generic: works for 1-12 variants, 1-3 option
  sets, any number of images, and sold-out products. Every value is read from
  the product itself.

  Order in the buy column follows the order the questions actually arrive in:
  what is it, what do people think, what does it cost, can I spread it, which
  size, when does it come, buy. Delivery sits immediately above the button
  because "when will it get here" is the last unanswered question for most
  people, and sending them to a policy page to find it loses them.

  Rendered from the first PDP section so a cooling product is the right colour
  on first paint rather than repainting further down the page.
{%- endcomment -%}
{% render 'pl-cool-palette', product: product %}
{%- liquid
  assign st = section.settings

  comment
    Which column stays put while the other scrolls. The default is the media,
    which is a change from how this shipped: the buy column is the tall one
    here — title, rating, tagline, price, instalments, options, stock,
    delivery, button, assurances, payment methods, footnotes — so sticking it
    barely moves anything while the square gallery scrolls out of sight. By
    the size picker the customer could no longer see the bed.
  endcomment
  assign pdp_class = 'pdp'
  case st.sticky_side
    when 'buy'
      assign pdp_class = pdp_class | append: ' pdp--stick-buy'
    when 'none'
      assign pdp_class = pdp_class | append: ' pdp--stick-none'
    else
      assign pdp_class = pdp_class | append: ' pdp--stick-media'
  endcase

  case st.media_split
    when 'even'
      assign pdp_split = '1fr 1fr'
    when 'buy'
      assign pdp_split = '1fr 1.1fr'
    when 'media_wide'
      assign pdp_split = '1.3fr 0.7fr'
    else
      assign pdp_split = '1.15fr 0.85fr'
  endcase

  assign buy_class = 'buy'
  if st.frame_assurance
    assign buy_class = buy_class | append: ' buy--framed'
  endif

  assign eyebrow_class = 'buy__eyebrow'
  if st.eyebrow_rule
    assign eyebrow_class = eyebrow_class | append: ' eyebrow--rule'
  endif

  assign p = product
  assign v = p.selected_or_first_available_variant
  assign has_options = true
  if p.has_only_default_variant
    assign has_options = false
  endif
  assign tagline = p.metafields.vitals.tagline.value
  assign b1 = p.metafields.vitals.top_benefit_1.value
  assign b2 = p.metafields.vitals.top_benefit_2.value
  assign b3 = p.metafields.vitals.top_benefit_3.value

  assign crumb = collection
  unless crumb
    for c in p.collections
      if crumb == blank and c.handle != 'all' and c.handle != 'frontpage'
        assign crumb = c
      endif
    endfor
  endunless
-%}
<div class="pl">
  <section class="wrap">
    {%- if section.settings.show_breadcrumbs -%}
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a> <span>/</span>
        {%- if crumb -%}
          <a href="{{ crumb.url }}">{{ crumb.title | split: '|' | first | strip }}</a> <span>/</span>
        {%- endif -%}
        <span aria-current="page">{{ p.title | split: '|' | first | strip | truncate: 45 }}</span>
      </nav>
    {%- endif -%}

    <div class="{{ pdp_class }}"
         style="--pdp-split:{{ pdp_split }};--gal-ratio:{{ st.gallery_ratio | default: '1 / 1' }};--price-scale:{{ st.price_size | default: 100 | divided_by: 100.0 }};--atc-height:{{ st.atc_height | default: 56 }}px">
      {% render 'pl-pdp-gallery', p: p, v: v %}

      <!-- Buy column -->
      <div class="{{ buy_class }}" id="plBuy">
        {%- if p.type != blank -%}<p class="{{ eyebrow_class }}">{{ p.type }}</p>{%- endif -%}
        <h1 class="buy__title">{{ p.title }}</h1>

        {%- comment -%}
          This product's own score when it has one, the shop-wide figure when
          it does not. The per-product row wins, because a score for the bed in
          front of you beats an average across the catalogue.
        {%- endcomment -%}
        {%- liquid
          assign own_rating = p.metafields.reviews.rating.value.rating | default: 0 | plus: 0.0
          assign own_count = p.metafields.reviews.rating_count.value | default: 0 | plus: 0
        -%}
        {%- if own_rating > 0 and own_count > 0 -%}
          <p class="buy__rating">
            {% render 'pl-rating', product: p, min_count: 1, size: 17 %}
            <a href="#pl-reviews">{{ own_count }} {% if own_count == 1 %}review{% else %}reviews{% endif %}</a>
          </p>
        {%- elsif section.settings.show_rating and section.settings.rating_text != blank -%}
          <p class="buy__rating">
            <span class="pl-stars" aria-hidden="true">{% for i in (1..5) %}{% render 'pl-icon', icon: 'star' %}{% endfor %}</span>
            <span>{{ section.settings.rating_text }}</span>
          </p>
        {%- endif -%}

        {%- if tagline != blank -%}<p class="buy__tagline">{{ tagline }}</p>{%- endif -%}

        <div class="buy__price">
          <span class="buy__now" id="plPrice">{{ v.price | money }}</span>
          <s class="buy__was" id="plWas" {% unless v.compare_at_price > v.price %}hidden{% endunless %}>{{ v.compare_at_price | money }}</s>
          {%- if v.compare_at_price > v.price -%}
            <span class="buy__save" id="plSave">Save {{ v.compare_at_price | minus: v.price | money }}</span>
          {%- else -%}
            <span class="buy__save" id="plSave" hidden></span>
          {%- endif -%}
        </div>
        {%- if section.settings.price_note != blank -%}
          <p class="buy__tax">{{ section.settings.price_note }}</p>
        {%- endif -%}

        {%- if section.settings.show_bnpl -%}
          {% render 'pl-bnpl', price: v.price, min: section.settings.bnpl_min, max: section.settings.bnpl_max, force: section.settings.bnpl_force %}
        {%- endif -%}

        {%- comment -%}
          This has to be Shopify's own product form tag, not a hand-written
          one. payment_button and payment_terms both read the `form` object
          that only the product form tag creates: with a plain form element
          that object does not exist, both filters output nothing, and Apple
          Pay, Shop Pay and Google Pay silently never appear.
        {%- endcomment -%}
        {%- form 'product', p, id: 'plForm', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" id="plVariantId" value="{{ v.id }}">
          <input type="hidden" name="quantity" value="1">

          {% render 'pl-pdp-options', p: p, has_options: has_options, section: section %}

          <p class="buy__stock" id="plStock" hidden></p>

          {%- if section.settings.show_delivery -%}
            {% render 'pl-delivery',
               std_label: section.settings.del_std_label, std_min: section.settings.del_std_min, std_max: section.settings.del_std_max, std_note: section.settings.del_std_note,
               exp_label: section.settings.del_exp_label, exp_min: section.settings.del_exp_min, exp_max: section.settings.del_exp_max, exp_note: section.settings.del_exp_note %}
          {%- endif -%}

          {%- if section.settings.app_position != 'below_button' -%}
            {%- comment -%}
              App blocks. The section declared only its own three block types,
              so no app could be placed in the buy column at all — a discount
              widget, a volume table, a reviews summary, a bundle offer all had
              nowhere to render, however the app was configured. Any app block
              the merchant adds renders here, in the order they arrange them.
            {%- endcomment -%}
            {%- for block in section.blocks -%}
              {%- if block.type == '@app' -%}
                <div class="buy__app" {{ block.shopify_attributes }}>{% render block %}</div>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          <p class="atc-msg" id="plMsg" role="status" aria-live="polite"></p>

          <button class="btn btn--lg atc" type="submit" id="plAtc" {% unless v.available %}disabled{% endunless %}>
            <span id="plAtcText">{% if v.available %}{{ section.settings.atc_label }}{% else %}{{ section.settings.sold_out_label }}{% endif %}</span>
          </button>

          {%- comment -%}
            The risk-reversal strip, immediately under the button, where every
            premium competitor puts it. It is the last thing a hesitant buyer
            reads before deciding.
          {%- endcomment -%}
          {%- if section.settings.show_assurance -%}
            {%- assign assure_blocks = 0 -%}
            {%- for block in section.blocks -%}{%- if block.type == 'assure' -%}{%- assign assure_blocks = assure_blocks | plus: 1 -%}{%- endif -%}{%- endfor -%}
            <ul class="buy__assure">
              {%- if assure_blocks > 0 -%}
                {%- for block in section.blocks -%}
                  {%- if block.type == 'assure' -%}
                    <li {{ block.shopify_attributes }}>{% render 'pl-icon', icon: block.settings.icon, default: 'check' %}<span>{{ block.settings.text }}</span></li>
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                <li>{% render 'pl-icon', icon: 'medal' %}<span>{{ section.settings.assure_1 }}</span></li>
                <li>{% render 'pl-icon', icon: 'truck' %}<span>{{ section.settings.assure_2 }}</span></li>
                <li>{% render 'pl-icon', icon: 'shield' %}<span>{{ section.settings.assure_3 }}</span></li>
              {%- endif -%}
            </ul>
          {%- endif -%}

          {%- if section.settings.app_position == 'below_button' -%}
            {%- comment -%}
              App blocks. The section declared only its own three block types,
              so no app could be placed in the buy column at all — a discount
              widget, a volume table, a reviews summary, a bundle offer all had
              nowhere to render, however the app was configured. Any app block
              the merchant adds renders here, in the order they arrange them.
            {%- endcomment -%}
            {%- for block in section.blocks -%}
              {%- if block.type == '@app' -%}
                <div class="buy__app" {{ block.shopify_attributes }}>{% render block %}</div>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          {%- if section.settings.show_dynamic_checkout -%}
            {%- comment -%}
              Shopify renders whichever accelerated methods the shop actually
              has switched on, so this stays truthful on its own.
            {%- endcomment -%}
            {{ form | payment_button }}
            {{ form | payment_terms }}
          {%- endif -%}
        {%- endform -%}

        {% render 'pl-pdp-footnotes', p: p, section: section, b1: b1, b2: b2, b3: b3 %}
      </div>
    </div>
  </section>

  {%- if section.settings.show_buybar -%}
    <div class="buybar{% if st.buybar_wide %} buybar--wide{% endif %}" id="plBuyBar">
      {%- if p.featured_image -%}
        <img class="buybar__img" src="{{ p.featured_image | image_url: width: 120 }}" alt="" width="42" height="42" loading="lazy">
      {%- endif -%}
      <div class="buybar__txt">
        <b>{{ p.title }}</b>
        <span id="plBarPrice">{{ v.price | money }}</span>
      </div>
      <button class="btn" type="button" id="plBarAtc" {% unless p.available %}disabled{% endunless %}>
        {% if p.available %}{{ section.settings.atc_label }}{% else %}{{ section.settings.sold_out_label }}{% endif %}
      </button>
    </div>
  {%- endif -%}
</div>

{%- comment -%} Live variant data - price, stock and image, straight from the catalogue. {%- endcomment -%}
{% render 'pl-pdp-variants-json', p: p, section: section %}

{% render 'pl-pdp-jsonld', p: p, v: v, crumb: crumb %}

{% schema %}
{
  "name": "PL – Product buy block",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "header",
      "content": "Rating"
    },
    {
      "type": "paragraph",
      "content": "A product with real reviews in the reviews.rating metafield always shows its own score and ignores the line below. Connect a review app and every reviewed product switches over on its own."
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show a store-wide rating where a product has no reviews of its own",
      "default": false
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Store-wide rating text",
      "info": "This is a store-wide figure, not this product's score. Word it that way, and only use a number you could evidence if asked."
    },
    {
      "type": "header",
      "content": "Price"
    },
    {
      "type": "text",
      "id": "price_note",
      "label": "Note under price",
      "default": "Free UK delivery on every order. 100 nights to change your mind."
    },
    {
      "type": "header",
      "content": "Instalments"
    },
    {
      "type": "paragraph",
      "content": "The Klarna line appears only when Klarna is actually switched on in Settings > Payments. Until then it stays hidden, whatever this is set to, so the page cannot offer a split the customer would not be given at checkout."
    },
    {
      "type": "checkbox",
      "id": "show_bnpl",
      "label": "Show the Klarna instalment line",
      "default": true
    },
    {
      "type": "number",
      "id": "bnpl_min",
      "label": "Lowest order Klarna will split, in pence",
      "default": 3500
    },
    {
      "type": "number",
      "id": "bnpl_max",
      "label": "Highest order Klarna will split, in pence",
      "default": 100000
    },
    {
      "type": "checkbox",
      "id": "bnpl_force",
      "label": "Show it even though Klarna is not detected",
      "default": false,
      "info": "Only for a provider that does not register a payment type of its own. Leave off otherwise – it overrides the safety check above."
    },
    {
      "type": "header",
      "content": "Delivery"
    },
    {
      "type": "paragraph",
      "content": "Shown directly above the Add to basket button. Working days are counted from today in the visitor's browser and skip weekends, so the dates are never stale. Set a range you can hit every time, not your best case."
    },
    {
      "type": "checkbox",
      "id": "show_delivery",
      "label": "Show the delivery window",
      "default": true
    },
    {
      "type": "text",
      "id": "del_std_label",
      "label": "Free option label",
      "default": "Free UK delivery"
    },
    {
      "type": "range",
      "id": "del_std_min",
      "label": "Free option, fastest working days",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "del_std_max",
      "label": "Free option, slowest working days",
      "min": 0,
      "max": 14,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "del_std_note",
      "label": "Free option note",
      "default": "On every order, no minimum spend."
    },
    {
      "type": "text",
      "id": "del_exp_label",
      "label": "Paid option label",
      "info": "Leave blank to hide the paid option entirely.",
      "default": "Express £6.99"
    },
    {
      "type": "range",
      "id": "del_exp_min",
      "label": "Paid option, fastest working days",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "del_exp_max",
      "label": "Paid option, slowest working days",
      "min": 0,
      "max": 14,
      "step": 1,
      "default": 2
    },
    {
      "type": "text",
      "id": "del_exp_note",
      "label": "Paid option note",
      "default": "Chosen at checkout."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "atc_label",
      "label": "Add to cart label",
      "default": "Add to basket"
    },
    {
      "type": "select",
      "id": "after_add",
      "label": "After adding to basket",
      "default": "drawer",
      "info": "Choose 'my cart app' if you have a cart slider app installed.",
      "options": [
        {
          "value": "drawer",
          "label": "Open the built-in slide-out basket"
        },
        {
          "value": "app",
          "label": "Let my cart app open its own drawer"
        },
        {
          "value": "cart",
          "label": "Go to the cart page"
        }
      ]
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "unavailable_label",
      "label": "Unavailable combination label",
      "default": "Unavailable"
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show Shop Pay / express checkout",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_buybar",
      "label": "Show sticky buy bar",
      "default": true
    },
    {
      "type": "header",
      "content": "Stock"
    },
    {
      "type": "range",
      "id": "low_stock_threshold",
      "label": "Show \"only N left\" at or below",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 3,
      "info": "Set to 0 to never show a low-stock message. Numbers come from live inventory."
    },
    {
      "type": "header",
      "content": "Size guide"
    },
    {
      "type": "checkbox",
      "id": "show_size_helper",
      "label": "Show the size helper panel",
      "default": true
    },
    {
      "type": "text",
      "id": "size_helper_title",
      "label": "Size helper title",
      "default": "Not sure which size?"
    },
    {
      "type": "richtext",
      "id": "size_helper_body",
      "label": "Size helper body",
      "default": "<p>Measure your dog nose to base of tail while they are lying down, then add 15–20cm. If they are between two sizes, size up.</p>"
    },
    {
      "type": "url",
      "id": "size_guide_url",
      "label": "Size guide link"
    },
    {
      "type": "text",
      "id": "size_guide_label",
      "label": "Size guide label",
      "default": "Which size?"
    },
    {
      "type": "header",
      "content": "Reassurance strip"
    },
    {
      "type": "paragraph",
      "content": "Shown directly under the Add to basket button, where it does the most to remove a hesitant buyer's risk. Add 'Assurance line' blocks to override the three defaults."
    },
    {
      "type": "checkbox",
      "id": "show_assurance",
      "label": "Show the reassurance strip",
      "default": true
    },
    {
      "type": "text",
      "id": "assure_1",
      "label": "Line 1",
      "default": "100-night sleep trial"
    },
    {
      "type": "text",
      "id": "assure_2",
      "label": "Line 2",
      "default": "Free returns, we collect"
    },
    {
      "type": "text",
      "id": "assure_3",
      "label": "Line 3",
      "default": "5-year foam guarantee"
    },
    {
      "type": "header",
      "content": "Payment methods"
    },
    {
      "type": "checkbox",
      "id": "show_pay_methods",
      "label": "Show accepted payment methods",
      "default": true,
      "info": "Lists only the methods your shop actually accepts. Add Klarna in Settings > Payments and it appears here automatically."
    },
    {
      "type": "text",
      "id": "pay_label",
      "label": "Payment row label",
      "default": "Pay with"
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "select",
      "id": "app_position",
      "label": "Where app blocks render",
      "default": "above_button",
      "options": [
        {
          "value": "above_button",
          "label": "Above the Add to basket button"
        },
        {
          "value": "below_button",
          "label": "Under the assurances"
        }
      ],
      "info": "Apps you add to this section — discounts, volume tables, bundles, reviews — appear here. Above the button is the default because a discount belongs where the price decision is made."
    },
    {
      "type": "select",
      "id": "sticky_side",
      "label": "Which column stays put",
      "default": "media",
      "options": [
        {
