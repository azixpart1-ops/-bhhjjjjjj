{% render 'pl-assets' %}
{% render 'pl-scheme', id: section.id, scheme: section.settings.scheme, bg: section.settings.bg, accent: section.settings.accent, tone: section.settings.tone %}
{%- comment -%}
  Product buy block. Deliberately generic: works for 1–12 variants, 1–3 option
  sets, any number of images, and sold-out products. Nothing here is specific
  to a single product – every value is read from the product itself.
{%- endcomment -%}
{%- comment -%}
  Rendered from the first PDP section so a cooling product is already the right
  colour on first paint, rather than repainting when the details section further
  down the page is parsed. The snippet decides for itself whether it applies.
{%- endcomment -%}
{% render 'pl-cool-palette', product: product %}
{%- liquid
  assign p = product
  assign v = p.selected_or_first_available_variant
  assign has_options = true
  if p.has_only_default_variant
    assign has_options = false
  endif
  assign tagline = p.metafields.vitals.tagline.value
  assign b1 = p.metafields.vitals.top_benefit_1.value
  assign b2 = p.metafields.vitals.top_benefit_2.value
  assign b3 = p.metafields.vitals.top_benefit_3.value
-%}
<div class="pl">
  <section class="wrap">
    {%- if section.settings.show_breadcrumbs -%}
      {%- comment -%}
        The middle crumb used to read the product type but link to
        /collections/all, so it never matched the path it claimed. Fall back to
        the product's own first real collection instead, and only render a link
        when there is somewhere true to send them.
      {%- endcomment -%}
      {%- liquid
        assign crumb = collection
        unless crumb
          for c in p.collections
            if crumb == blank and c.handle != 'all' and c.handle != 'frontpage'
              assign crumb = c
            endif
          endfor
        endunless
      -%}
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a> <span>/</span>
        {%- if crumb -%}
          <a href="{{ crumb.url }}">{{ crumb.title | split: '|' | first | strip }}</a> <span>/</span>
        {%- endif -%}
        <span aria-current="page">{{ p.title | split: '|' | first | strip | truncate: 45 }}</span>
      </nav>
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} }
            {%- if crumb -%},
            { "@type": "ListItem", "position": 2, "name": {{ crumb.title | split: '|' | first | strip | json }}, "item": {{ shop.url | append: crumb.url | json }} }
            {%- endif -%},
            { "@type": "ListItem", "position": {% if crumb %}3{% else %}2{% endif %}, "name": {{ p.title | split: '|' | first | strip | json }} }
          ]
        }
      </script>
    {%- endif -%}

    <div class="pdp">
      <!-- Gallery -->
      <div class="gal">
        <div class="gal__stage">
          {%- unless p.available -%}
            <span class="gal__flag gal__flag--out">Sold out</span>
          {%- else -%}
            {%- if v.compare_at_price > v.price -%}
              {%- assign pct = v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round -%}
              <span class="gal__flag">Save {{ pct }}%</span>
            {%- endif -%}
          {%- endunless -%}
          <div class="gal__slides" id="plGalSlides">
            {%- if p.media.size > 0 -%}
              {%- for m in p.media -%}
                <div class="gal__slide" data-index="{{ forloop.index0 }}">
                  <img src="{{ m | image_url: width: 900 }}"
                       srcset="{{ m | image_url: width: 560 }} 560w, {{ m | image_url: width: 1100 }} 1100w"
                       sizes="(min-width: 900px) 52vw, 100vw"
                       alt="{{ m.alt | escape | default: p.title | escape }}"
                       width="900" height="900"
                       {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
                       decoding="async">
                </div>
              {%- endfor -%}
            {%- else -%}
              <div class="gal__slide">{{ 'product-1' | placeholder_svg_tag }}</div>
            {%- endif -%}
          </div>
        </div>

        {%- if p.media.size > 1 -%}
          <div class="gal__thumbs" role="tablist" aria-label="Product images">
            {%- for m in p.media -%}
              <button class="gal__thumb" type="button" role="tab"
                      data-goto="{{ forloop.index0 }}"
                      aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                      aria-label="Image {{ forloop.index }} of {{ p.media.size }}">
                <img src="{{ m | image_url: width: 160 }}" alt="" width="160" height="160" loading="lazy" decoding="async">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Buy column -->
      <div class="buy" id="plBuy">
        {%- if p.type != blank -%}<p class="buy__eyebrow">{{ p.type }}</p>{%- endif -%}
        <h1 class="buy__title">{{ p.title }}</h1>

        {%- comment -%}
          This product's own score when it has one, the shop-wide figure when
          it does not, so every product page carries stars rather than only
          the reviewed ones. The per-product row wins because a score for the
          bed in front of you beats an average across the catalogue.
        {%- endcomment -%}
        {%- liquid
          assign own_rating = p.metafields.reviews.rating.value.rating | default: 0 | plus: 0.0
          assign own_count = p.metafields.reviews.rating_count.value | default: 0 | plus: 0
        -%}
        {%- if own_rating > 0 and own_count > 0 -%}
          <p class="buy__rating">
            {% render 'pl-rating', product: p, min_count: 1, size: 17 %}
            <a href="#pl-reviews">{{ own_count }} {% if own_count == 1 %}review{% else %}reviews{% endif %}</a>
          </p>
        {%- elsif section.settings.show_rating -%}
          <p class="buy__rating">
            <span class="pl-stars" aria-hidden="true">{% for i in (1..5) %}{% render 'pl-icon', icon: 'star' %}{% endfor %}</span>
            <span>{{ section.settings.rating_text }}</span>
          </p>
        {%- endif -%}

        {%- if tagline != blank -%}<p class="buy__tagline">{{ tagline }}</p>{%- endif -%}

        <div class="buy__price">
          <span class="buy__now" id="plPrice">{{ v.price | money }}</span>
          <s class="buy__was" id="plWas" {% unless v.compare_at_price > v.price %}hidden{% endunless %}>{{ v.compare_at_price | money }}</s>
          {%- if v.compare_at_price > v.price -%}
            <span class="buy__save" id="plSave">Save {{ v.compare_at_price | minus: v.price | money }}</span>
          {%- else -%}
            <span class="buy__save" id="plSave" hidden></span>
          {%- endif -%}
        </div>
        {%- if section.settings.price_note != blank -%}
          <p class="buy__tax">{{ section.settings.price_note }}</p>
        {%- endif -%}

        {%- comment -%}
          This has to be Shopify's own product form tag, not a hand-written
          one. payment_button and payment_terms both read the `form` object
          that only the product form tag creates: with a plain form element
          that object does not exist, both filters output nothing, and Apple
          Pay, Shop Pay and Google Pay silently never appear. The tag also
          emits form_type and utf8 itself, so neither is written by hand now.
        {%- endcomment -%}
        {%- form 'product', p, id: 'plForm', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" id="plVariantId" value="{{ v.id }}">
          <input type="hidden" name="quantity" value="1">

          {%- if has_options -%}
            <div class="opts">
              {%- for opt in p.options_with_values -%}
                {%- assign is_size = false -%}
                {%- assign lower = opt.name | downcase -%}
                {%- if lower contains 'size' -%}{%- assign is_size = true -%}{%- endif -%}
                <div class="opt-group" data-option-index="{{ forloop.index0 }}">
                  <div class="opt-group__head">
                    <span class="opt-group__name">
                      {%- comment -%}
                        The catalogue names this option "Accessory size", which
                        is supplier vocabulary, not the customer's.
                      {%- endcomment -%}
                      {{ opt.name | remove_first: 'Accessory ' | remove_first: 'accessory ' | capitalize }}<b data-selected-for="{{ forloop.index0 }}">{{ opt.selected_value }}</b>
                    </span>
                    {%- if is_size and section.settings.size_guide_url != blank -%}
                      <a class="opt-group__help" href="{{ section.settings.size_guide_url }}">{{ section.settings.size_guide_label }}</a>
                    {%- endif -%}
                  </div>
                  {%- comment -%}
                    Where a size already carries its measurements, as the
                    Kendal's do ("S · 45 × 29.5cm"), the two are split so the
                    code stays scannable and the centimetres sit under it.
                    Nobody can judge whether "L" fits their dog; 83 × 66cm they
                    can. Sizes without measurements simply render as they are,
                    so this needs no data the catalogue does not already hold.
                  {%- endcomment -%}
                  <div class="opt-values{% if is_size %} opt-values--size{% endif %}">
                    {%- for value in opt.values -%}
                      {%- liquid
                        assign oidx = forloop.parentloop.index0
                        assign uid = 'opt-' | append: oidx | append: '-' | append: forloop.index0
                        assign vcode = value
                        assign vdims = ''

                        comment
                          Preferred source: the variant's own Dimensions
                          metafield, filled from the size table already
                          published in the product description. Falls back to
                          splitting the option label for the beds that carry
                          their measurements inline.
                        endcomment
                        for v in p.variants
                          if vdims == '' and v.options[oidx] == value
                            assign vdims = v.metafields.custom.dimensions.value | default: '' | strip
                          endif
                        endfor
                        comment
                          Two conventions live in the catalogue: the Kendal
                          writes "S · 45 × 29.5cm", the Windermere Calming
                          writes "Large (110 x 75 cm)". Both mean the same
                          thing, so both are split.
                        endcomment
                        if value contains '·'
                          assign vparts = value | split: '·'
                          assign vcode = vparts[0] | strip
                          if vdims == ''
                            assign vdims = value | remove_first: vparts[0] | remove_first: '·' | strip
                          endif
                        elsif value contains '('
                          assign vparts = value | split: '('
                          assign vcode = vparts[0] | strip
                          if vdims == ''
                            assign vdims = vparts[1] | default: '' | replace: ')', '' | strip
                          endif
                        endif
                      -%}
                      <input type="radio" id="{{ uid }}" name="pl-option-{{ forloop.parentloop.index0 }}"
                             value="{{ value | escape }}" data-option-index="{{ forloop.parentloop.index0 }}"
                             {% if value == opt.selected_value %}checked{% endif %}>
                      <label for="{{ uid }}"{% if vdims != '' %} class="has-dims"{% endif %}>
                        <span class="opt-values__code">{{ vcode }}</span>
                        {%- if vdims != '' -%}<span class="opt-values__dims">{{ vdims }}</span>{%- endif -%}
                      </label>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}


          {%- if section.settings.show_size_helper and has_options -%}
            <div class="sizehelp" id="plSizeHelp">
              <button class="sizehelp__q" type="button" aria-expanded="false">
                {{ section.settings.size_helper_title }}<span class="faq__icon" aria-hidden="true"></span>
              </button>
              <div class="sizehelp__body"><div><div class="sizehelp__inner">
                {{ section.settings.size_helper_body }}

                {%- comment -%}
                  The size table, built from the product's own variants rather
                  than written out by hand: measurements come from each
                  variant's Dimensions field, price and availability from the
                  variant itself, so it can never drift from what is actually
                  for sale. Rows with no measurement still list price and
                  stock, and the whole table is skipped when no size carries
                  measurements at all.
                {%- endcomment -%}
                {%- liquid
                  assign size_ix = -1
                  for opt in p.options_with_values
                    assign onm = opt.name | downcase
                    if size_ix == -1 and onm contains 'size'
                      assign size_ix = forloop.index0
                      assign size_opt = opt
                    endif
                  endfor
                  assign any_dims = false
                  if size_ix > -1
                    for value in size_opt.values
                      for v in p.variants
                        if v.options[size_ix] == value and any_dims == false
                          if v.metafields.custom.dimensions.value != blank
                            assign any_dims = true
                          endif
                        endif
                      endfor
                    endfor
                  endif
                -%}
                {%- if any_dims -%}
                  <table class="sizetable">
                    <thead>
                      <tr><th scope="col">Size</th><th scope="col">Bed measures</th><th scope="col">Price</th></tr>
                    </thead>
                    <tbody>
                      {%- for value in size_opt.values -%}
                        {%- liquid
                          assign row = nil
                          for v in p.variants
                            if row == nil and v.options[size_ix] == value
                              assign row = v
                            endif
                          endfor
                          assign rdims = row.metafields.custom.dimensions.value | default: '' | strip
                          assign rcode = value
                          if value contains '·'
                            assign rcode = value | split: '·' | first | strip
                            if rdims == ''
                              assign rdims = value | split: '·' | last | strip
                            endif
                          elsif value contains '('
                            assign rcode = value | split: '(' | first | strip
                            if rdims == ''
                              assign rdims = value | split: '(' | last | replace: ')', '' | strip
                            endif
                          endif
                        -%}
                        <tr{% unless row.available %} class="sizetable__out"{% endunless %}>
                          <th scope="row">{{ rcode }}</th>
                          <td>{{ rdims | default: '—' }}</td>
                          <td>{% if row.available %}{{ row.price | money }}{% else %}Sold out{% endif %}</td>
                        </tr>
                      {%- endfor -%}
                    </tbody>
                  </table>
                {%- endif -%}

                {%- if section.settings.size_guide_url != blank -%}
                  <p><a class="link-arrow" href="{{ section.settings.size_guide_url }}">Full size &amp; firmness guide{% render 'pl-icon', icon: 'arrow', class: 'btn__arrow', size: 14 %}</a></p>
                {%- endif -%}
              </div></div></div>
            </div>
          {%- endif -%}

          <p class="buy__stock" id="plStock" hidden></p>

          {%- if section.settings.show_cutoff -%}
            {%- comment -%}
              Real urgency, not manufactured urgency. This is the workshop's
              actual dispatch cut-off, counted in UK time, and it says nothing
              at all once the cut-off has passed or at a weekend rather than
              inventing a deadline. Empty until the script fills it, so it can
              never show a stale time.
            {%- endcomment -%}
            <p class="buy__cutoff" id="plCutoff" hidden
               data-hour="{{ section.settings.cutoff_hour }}"
               data-text="{{ section.settings.cutoff_text | escape }}"
               {%- if section.settings.show_eta %}
               data-transit="{{ section.settings.eta_transit_days }}"
               data-eta="{{ section.settings.eta_text | escape }}"{% endif %}></p>
          {%- endif -%}

          <p class="atc-msg" id="plMsg" role="status" aria-live="polite"></p>

          <button class="btn btn--lg atc" type="submit" id="plAtc" {% unless v.available %}disabled{% endunless %}>
            <span id="plAtcText">{% if v.available %}{{ section.settings.atc_label }}{% else %}{{ section.settings.sold_out_label }}{% endif %}</span>
          </button>

          {%- comment -%}
            The risk-reversal strip, immediately under the button, where every
            premium competitor puts it. It is the last thing a hesitant buyer
            reads before deciding, so the three promises that remove the risk
            of buying sit exactly here rather than only further down the page.
            Blocks of type 'assure' drive it; a sensible default set renders
            when none are configured.
          {%- endcomment -%}
          {%- if section.settings.show_assurance -%}
            {%- assign assure_blocks = 0 -%}
            {%- for block in section.blocks -%}{%- if block.type == 'assure' -%}{%- assign assure_blocks = assure_blocks | plus: 1 -%}{%- endif -%}{%- endfor -%}
            <ul class="buy__assure">
              {%- if assure_blocks > 0 -%}
                {%- for block in section.blocks -%}
                  {%- if block.type == 'assure' -%}
                    {%- comment -%}
                      The filter has to run before the render, not inside it:
                      Liquid rejects a filter applied to a render argument, and
                      it fails as a syntax error that takes the whole section
                      down rather than just this line.
                    {%- endcomment -%}
                    {%- assign assure_icon = block.settings.icon | default: 'check' -%}
                    <li {{ block.shopify_attributes }}>{% render 'pl-icon', icon: assure_icon %}<span>{{ block.settings.text }}</span></li>
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                <li>{% render 'pl-icon', icon: 'medal' %}<span>{{ section.settings.assure_1 }}</span></li>
                <li>{% render 'pl-icon', icon: 'truck' %}<span>{{ section.settings.assure_2 }}</span></li>
                <li>{% render 'pl-icon', icon: 'shield' %}<span>{{ section.settings.assure_3 }}</span></li>
              {%- endif -%}
            </ul>
          {%- endif -%}

          {%- if section.settings.show_dynamic_checkout -%}
            {%- comment -%}
              The buy-now button. Shopify renders whichever accelerated methods
              the shop actually has switched on, so it stays truthful on its
              own: turn Klarna on in payments and it appears here, turn it off
              and it goes. payment_terms is the instalment line that belongs
              with it, and prints nothing where instalments are unavailable.
            {%- endcomment -%}
            {{ form | payment_button }}
            {{ form | payment_terms }}
          {%- endif -%}
        {%- endform -%}

        {%- if section.settings.show_pay_methods -%}
          {%- comment -%}
            Drawn from shop.enabled_payment_types, so the row can only ever
            show methods the customer can genuinely pay with. A badge for a
            method the shop does not accept is a promise broken at checkout,
            which is the worst possible place to break one.
          {%- endcomment -%}
          <div class="buy__pay">
            {%- if section.settings.pay_label != blank -%}
              <span class="buy__pay-label">{{ section.settings.pay_label }}</span>
            {%- endif -%}
            <span class="buy__pay-icons">
              {%- for type in shop.enabled_payment_types -%}
                {{ type | payment_type_svg_tag: class: 'buy__pay-icon' }}
              {%- endfor -%}
            </span>
          </div>
        {%- endif -%}

        <div class="buy__trust">
          {%- for block in section.blocks -%}
            {%- if block.type == 'trust' -%}
              <div {{ block.shopify_attributes }}>
                {% render 'pl-icon', icon: block.settings.icon %}
                <span><b>{{ block.settings.title }}</b> – {{ block.settings.text }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if b1 != blank or b2 != blank or b3 != blank or section.blocks.size > 0 -%}
          <div class="benefits">
            <ul>
              {%- if b1 != blank -%}<li>{% render 'pl-icon', icon: 'check' %}<span>{{ b1 }}</span></li>{%- endif -%}
              {%- if b2 != blank -%}<li>{% render 'pl-icon', icon: 'check' %}<span>{{ b2 }}</span></li>{%- endif -%}
              {%- if b3 != blank -%}<li>{% render 'pl-icon', icon: 'check' %}<span>{{ b3 }}</span></li>{%- endif -%}
              {%- if b1 == blank and b2 == blank and b3 == blank -%}
                {%- for block in section.blocks -%}
                  {%- if block.type == 'benefit' -%}
                    <li {{ block.shopify_attributes }}>{% render 'pl-icon', icon: 'check' %}<span>{{ block.settings.text }}</span></li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- if section.settings.show_buybar -%}
    <div class="buybar" id="plBuyBar">
      {%- if p.featured_image -%}
        <img class="buybar__img" src="{{ p.featured_image | image_url: width: 120 }}" alt="" width="42" height="42" loading="lazy">
      {%- endif -%}
      <div class="buybar__txt">
        <b>{{ p.title }}</b>
        <span id="plBarPrice">{{ v.price | money }}</span>
      </div>
      <button class="btn" type="button" id="plBarAtc" {% unless p.available %}disabled{% endunless %}>
        {% if p.available %}{{ section.settings.atc_label }}{% else %}{{ section.settings.sold_out_label }}{% endif %}
      </button>
    </div>
  {%- endif -%}
</div>

{%- comment -%} Live variant data – price, stock and image, straight from the catalogue. {%- endcomment -%}
<script type="application/json" id="pl-variants">
{
  "cartUrl": {{ routes.cart_url | json }},
  "lowStockAt": {{ section.settings.low_stock_threshold | default: 3 | json }},
  "soldOutLabel": {{ section.settings.sold_out_label | json }},
  "atcLabel": {{ section.settings.atc_label | json }},
  "afterAdd": {{ section.settings.after_add | default: 'drawer' | json }},
  "unavailableLabel": {{ section.settings.unavailable_label | json }},
  "variants": [
    {%- for var in p.variants -%}
      {
        "id": {{ var.id }},
        "options": {{ var.options | json }},
        "available": {{ var.available | json }},
        "price": {{ var.price | money | strip_html | json }},
        "compareAt": {%- if var.compare_at_price > var.price -%}{{ var.compare_at_price | money | strip_html | json }}{%- else -%}null{%- endif -%},
        "save": {%- if var.compare_at_price > var.price -%}{{ var.compare_at_price | minus: var.price | money | strip_html | json }}{%- else -%}null{%- endif -%},
        "qty": {{ var.inventory_quantity | default: 0 | json }},
        "policy": {{ var.inventory_policy | json }},
        "managed": {{ var.inventory_management | json }},
        "mediaIndex": {%- if var.featured_media -%}{{ var.featured_media.position | minus: 1 }}{%- else -%}null{%- endif -%}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>

{%- comment -%} Structured data so Google can show price, availability and reviews. {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "@id": {{ p.url | prepend: request.origin | append: '#product' | json }},
      "name": {{ p.title | json }},
      "description": {{ p.description | strip_html | truncate: 500 | json }},
      "url": {{ p.url | prepend: request.origin | json }},
      "sku": {{ v.sku | default: v.id | json }},
      "brand": { "@type": "Brand", "name": {{ p.vendor | default: 'PawLunova' | json }} },
      {%- if p.featured_image -%}
      "image": [
        {%- for m in p.media limit: 5 -%}
          {{ m | image_url: width: 1200 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ],
      {%- endif -%}
      {%- if p.type != blank -%}"category": {{ p.type | json }},{%- endif -%}
      "offers": [
        {%- for var in p.variants -%}
        {
          "@type": "Offer",
          "url": {{ var.url | prepend: request.origin | json }},
          "sku": {{ var.sku | default: var.id | json }},
          "price": {{ var.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "availability": {%- if var.available -%}"https://schema.org/InStock"{%- else -%}"https://schema.org/OutOfStock"{%- endif -%},
          "itemCondition": "https://schema.org/NewCondition",
          {%- unless p.has_only_default_variant -%}"name": {{ var.title | json }},{%- endunless -%}
          "seller": { "@type": "Organization", "name": "PawLunova" }
        }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ request.origin | append: routes.root_url | json }} },
        {%- if collection -%}
        { "@type": "ListItem", "position": 2, "name": {{ collection.title | strip_html | json }}, "item": {{ collection.url | prepend: request.origin | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ p.title | json }} }
        {%- else -%}
        { "@type": "ListItem", "position": 2, "name": {{ p.title | json }} }
        {%- endif -%}
      ]
    }
  ]
}
</script>

