{% render 'pl-assets' %}
<div class="pl">
  <section class="wrap">
    <div class="oops reveal">
      <h1>{{ section.settings.heading }}</h1>
      <p class="lede">{{ section.settings.text }}</p>
      <div class="oops__cta">
        <a class="btn btn--lg" href="{{ section.settings.cta_1_link | default: '/' }}">
          {{ section.settings.cta_1_text }}{% render 'pl-icon', icon: 'arrow', class: 'btn__arrow', size: 18 %}
        </a>
        <a class="btn btn--lg btn--ghost" href="{{ section.settings.cta_2_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_2_text }}</a>
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "PL — 404",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "This page has wandered off." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Nothing here — but the beds are all still where we left them." },
    { "type": "text", "id": "cta_1_text", "label": "Primary button", "default": "Find their bed" },
    { "type": "url", "id": "cta_1_link", "label": "Primary link" },
    { "type": "text", "id": "cta_2_text", "label": "Secondary button", "default": "Shop all beds" },
    { "type": "url", "id": "cta_2_link", "label": "Secondary link" }
  ],
  "presets": [{ "name": "PL — 404" }]
}
{% endschema %}
