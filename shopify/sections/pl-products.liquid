{% render 'pl-assets' %}
{% render 'pl-scheme', id: section.id, scheme: section.settings.scheme, bg: section.settings.bg, accent: section.settings.accent, tone: section.settings.tone %}
<div class="pl">
  <section class="pl-section">
    <div class="wrap">
      <div class="section-head reveal" style="display:flex;flex-wrap:wrap;gap:1.5rem;justify-content:space-between;align-items:flex-end;max-width:none">
        <div style="max-width:36rem">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          <h2 class="display-2">{{ section.settings.heading | escape | newline_to_br }}</h2>
        </div>
        {%- if section.settings.link_text != blank -%}
          <a class="link-arrow" href="{{ section.settings.link_url | default: routes.all_products_collection_url }}">
            {{ section.settings.link_text }}{% render 'pl-icon', icon: 'arrow', class: 'btn__arrow', size: 16 %}
          </a>
        {%- endif -%}
      </div>

      <div class="products">
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          {%- if p != blank -%}
            {% render 'pl-product-card',
                 product: p,
                 index: forloop.index,
                 title: block.settings.display_title,
                 desc: block.settings.description,
                 show_desc: true,
                 role: block.settings.role,
                 show_rating: true,
                 rating_min: 3,
                 rating_show_count: true,
                 fallback_rating: section.settings.rating,
                 fallback_label: section.settings.rating_label,
                 attrs: block.shopify_attributes %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "PL – Featured beds",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The beds owners come back for"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Four beds, four different dogs."
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Shop all beds"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Shop rating shown on cards",
      "default": "4.8",
      "info": "Used for beds with no reviews of their own. Leave blank to show no stars on those."
    },
    {
      "type": "text",
      "id": "rating_label",
      "label": "Shop rating label",
      "default": "across all beds",
      "info": "Printed beside the score so it never reads as this bed's own review count."
    },
    {
      "type": "header",
      "content": "Colour"
    },
    {
      "type": "paragraph",
      "content": "Text colour is chosen by measuring contrast against the background you pick, so a section cannot end up unreadable. The editor warns you if a background leaves no readable option."
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "cream",
          "label": "Cream, calm"
        },
        {
          "value": "oat",
          "label": "Oat, warm neutral"
        },
        {
          "value": "gold",
          "label": "Gold, warmth"
        },
        {
          "value": "forest",
          "label": "Forest, authority"
        },
        {
          "value": "clay",
          "label": "Deep green, focus"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "info": "Custom scheme only."
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Buttons and links",
      "info": "Custom scheme only."
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Text colour",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Automatic, recommended"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "light",
          "label": "Light"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Bed",
      "limit": 8,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role label",
          "info": "e.g. \"Stiff mornings\""
        },
        {
          "type": "text",
          "id": "display_title",
          "label": "Display name",
          "info": "Leave blank to use the product title."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PL – Featured beds"
    }
  ]
}
{% endschema %}
