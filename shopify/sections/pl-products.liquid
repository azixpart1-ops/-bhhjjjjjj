{% render 'pl-assets' %}
<div class="pl">
  <section class="pl-section">
    <div class="wrap">
      <div class="section-head reveal" style="display:flex;flex-wrap:wrap;gap:1.5rem;justify-content:space-between;align-items:flex-end;max-width:none">
        <div style="max-width:36rem">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          <h2 class="display-2">{{ section.settings.heading | escape | newline_to_br }}</h2>
        </div>
        {%- if section.settings.link_text != blank -%}
          <a class="link-arrow" href="{{ section.settings.link_url | default: routes.all_products_collection_url }}">
            {{ section.settings.link_text }}{% render 'pl-icon', icon: 'arrow', class: 'btn__arrow', size: 16 %}
          </a>
        {%- endif -%}
      </div>

      <div class="products">
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          {%- if p != blank -%}
            {% render 'pl-product-card',
                 product: p,
                 index: forloop.index,
                 title: block.settings.display_title,
                 desc: block.settings.description,
                 show_desc: true,
                 role: block.settings.role,
                 stars: section.settings.rating,
                 attrs: block.shopify_attributes %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "PL – Featured beds",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The beds owners come back for" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Four beds, four different dogs." },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "Shop all beds" },
    { "type": "url", "id": "link_url", "label": "Link URL" },
    { "type": "text", "id": "rating", "label": "Star rating shown on cards", "default": "4.8" }
  ],
  "blocks": [
    { "type": "product", "name": "Bed", "limit": 8, "settings": [
      { "type": "product", "id": "product", "label": "Product" },
      { "type": "text", "id": "role", "label": "Role label", "info": "e.g. \"Stiff mornings\"" },
      { "type": "text", "id": "display_title", "label": "Display name", "info": "Leave blank to use the product title." },
      { "type": "textarea", "id": "description", "label": "Description" } ] }
  ],
  "presets": [{ "name": "PL – Featured beds" }]
}
{% endschema %}
