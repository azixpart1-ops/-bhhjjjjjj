{% render 'pl-assets' %}
{% render 'pl-scheme', id: section.id, scheme: section.settings.scheme, bg: section.settings.bg, accent: section.settings.accent, tone: section.settings.tone %}
{% render 'pl-layout', id: section.id, s: section.settings %}
{%- liquid
  assign st = section.settings

  assign cols = st.cols | default: '4'
  assign grid = 'products'
  if st.card == 'framed'
    assign grid = grid | append: ' products--framed'
  endif
  if st.mobile == 'scroll'
    assign grid = grid | append: ' products--scroll'
  endif

  comment
    The `sizes` hint has to follow the column count or the browser downloads a
    quarter-width file for a card drawn at a third of the page. Worked out from
    the setting rather than hardcoded to the four-up default.
  endcomment
  case cols
    when '2'
      assign card_sizes = '(min-width: 900px) 50vw, 45vw'
    when '3'
      assign card_sizes = '(min-width: 900px) 33vw, 45vw'
    when '5'
      assign card_sizes = '(min-width: 900px) 20vw, 45vw'
    else
      assign card_sizes = '(min-width: 1100px) 25vw, (min-width: 760px) 33vw, 45vw'
  endcase
  if st.mobile == 'scroll'
    assign card_sizes = card_sizes | replace: '45vw', '70vw'
  endif

  assign hide_role = true
  if st.show_role
    assign hide_role = false
  endif
  assign hide_price = true
  if st.show_price
    assign hide_price = false
  endif
  assign hide_cta = true
  if st.show_cta
    assign hide_cta = false
  endif
-%}
<div class="pl">
  <section class="pl-section"
           {% if st.anchor != blank %}id="{{ st.anchor | handleize }}"{% endif %}
           style="--prod-cols:{{ cols }};--card-ratio:{{ st.ratio | default: '1 / 1' }}">
    <div class="wrap">
      <div class="section-head reveal" style="display:flex;flex-wrap:wrap;gap:1.5rem;justify-content:space-between;align-items:flex-end;max-width:none">
        <div style="max-width:36rem">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          <h2 class="display-2">{{ section.settings.heading | escape | newline_to_br }}</h2>
        </div>
        {%- if section.settings.link_text != blank -%}
          <a class="link-arrow" href="{{ section.settings.link_url | default: routes.all_products_collection_url }}">
            {{ section.settings.link_text }}{% render 'pl-icon', icon: 'arrow', class: 'btn__arrow', size: 16 %}
          </a>
        {%- endif -%}
      </div>

      <div class="{{ grid }}">
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          {%- if p != blank -%}
            {% render 'pl-product-card',
                 product: p,
                 index: forloop.index,
                 title: block.settings.display_title,
                 desc: block.settings.description,
                 show_desc: true,
                 role: block.settings.role,
                 show_rating: true,
                 rating_min: 3,
                 rating_show_count: true,
                 fallback_rating: section.settings.rating,
                 fallback_label: section.settings.rating_label,
                 img_sizes: card_sizes,
                 hide_badge: hide_role,
                 hide_price: hide_price,
                 hide_cta: hide_cta,
                 attrs: block.shopify_attributes %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "PL – Featured beds",
  "tag": "section",
  "settings": [
