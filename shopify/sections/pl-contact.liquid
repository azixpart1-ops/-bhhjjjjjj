{% render 'pl-assets' %}
<div class="pl">
  <section class="wrap">
    <div class="page-hero reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1>{{ section.settings.heading | default: page.title }}</h1>
      {%- if section.settings.standfirst != blank -%}<p>{{ section.settings.standfirst }}</p>{%- endif -%}
    </div>

    <div class="contact" style="padding-bottom:clamp(2rem,5vw,4rem)">
      <div class="reveal">
        {%- form 'contact', id: 'plContactForm' -%}
          {%- if form.posted_successfully? -%}
            <p class="form-ok">{{ section.settings.success_text }}</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="form-ok atc-msg--error" style="display:block">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <div class="pl-field">
            <label for="plcName">Your name</label>
            <input type="text" id="plcName" name="contact[name]" autocomplete="name" value="{{ form.name }}" required>
          </div>
          <div class="pl-field">
            <label for="plcEmail">Email</label>
            <input type="email" id="plcEmail" name="contact[email]" autocomplete="email" value="{{ form.email }}" required>
          </div>
          <div class="pl-field">
            <label for="plcDog">Your dog's breed and rough weight <span class="muted">(optional, but it helps us answer properly)</span></label>
            <input type="text" id="plcDog" name="contact[dog]" placeholder="Labrador, about 32kg">
          </div>
          <div class="pl-field">
            <label for="plcBody">How can we help?</label>
            <textarea id="plcBody" name="contact[body]" required>{{ form.body }}</textarea>
          </div>
          <button class="btn btn--lg" type="submit">{{ section.settings.submit_label }}</button>
          {%- if section.settings.form_note != blank -%}
            <p class="form-note">{{ section.settings.form_note }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>

      <div class="reveal" style="--i:1">
        {%- if page.content != blank -%}
          <div class="pl-rte" style="margin-bottom:2rem">{{ page.content }}</div>
        {%- endif -%}
        <div class="specs">
          <h3>{{ section.settings.panel_title }}</h3>
          <dl>
            {%- for block in section.blocks -%}
              <div class="specs__row" {{ block.shopify_attributes }}>
                <dt>{{ block.settings.label }}</dt><dd>{{ block.settings.value }}</dd>
              </div>
            {%- endfor -%}
          </dl>
        </div>
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "PL — Contact",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Talk to us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tell us about your dog." },
    { "type": "textarea", "id": "standfirst", "label": "Standfirst", "default": "Sizing, firmness, whether a bed will suit a dog with hip trouble — we answer these every day, and we'd rather you asked before you buy than after." },
    { "type": "text", "id": "submit_label", "label": "Submit button", "default": "Send it" },
    { "type": "textarea", "id": "form_note", "label": "Note under the form", "default": "We answer every message ourselves, usually the same working day." },
    { "type": "textarea", "id": "success_text", "label": "Success message", "default": "Thanks — that's with us. We'll come back to you shortly, usually the same working day." },
    { "type": "text", "id": "panel_title", "label": "Side panel title", "default": "The short answers" }
  ],
  "blocks": [
    { "type": "row", "name": "Detail row", "settings": [
      { "type": "text", "id": "label", "label": "Label" },
      { "type": "text", "id": "value", "label": "Value" } ] }
  ],
  "presets": [{ "name": "PL — Contact" }]
}
{% endschema %}
