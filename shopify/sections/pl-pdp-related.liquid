{% render 'pl-assets' %}
{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = product.collections.first
  endif
  assign limit = section.settings.count | default: 4
-%}
{%- if source != blank -%}
<div class="pl">
  <section class="pl-section">
    <div class="wrap">
      <div class="section-head reveal" style="display:flex;flex-wrap:wrap;gap:1.5rem;justify-content:space-between;align-items:flex-end;max-width:none">
        <div style="max-width:34rem">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          <h2 class="display-2">{{ section.settings.heading }}</h2>
        </div>
        <a class="link-arrow" href="{{ source.url }}">
          {{ section.settings.link_text }}{% render 'pl-icon', icon: 'arrow', class: 'btn__arrow', size: 16 %}
        </a>
      </div>
      <div class="related">
        {%- assign shown = 0 -%}
        {%- for item in source.products -%}
          {%- if item.id != product.id and shown < limit -%}
            {%- assign shown = shown | plus: 1 -%}
            {% render 'pl-product-card', product: item, index: shown, show_desc: true %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>
{%- endif -%}
{% schema %}
{
  "name": "PL – Related beds",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Other beds owners consider" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "If this one isn't quite right." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave blank to use the product's own collection." },
    { "type": "range", "id": "count", "label": "How many", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "See them all" }
  ],
  "presets": [{ "name": "PL – Related beds" }]
}
{% endschema %}
