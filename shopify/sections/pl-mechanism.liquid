{% render 'pl-assets' %}
<div class="pl">
  <section class="pl-section pl-section--oat">
    <div class="wrap">
      <div class="mech">
        <div>
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow reveal">{{ section.settings.eyebrow }}</p>{%- endif -%}
          <h2 class="display-2 reveal" style="--i:1">{{ section.settings.heading | escape | newline_to_br }}</h2>
          <div class="body-lg reveal" style="--i:2;margin-top:1.5rem">{{ section.settings.body }}</div>

          {%- if section.settings.density_number != blank -%}
            <div class="density reveal" style="--i:3">
              <div class="density__num">{{ section.settings.density_number }}</div>
              <p class="density__cap">{{ section.settings.density_caption }}</p>
            </div>
          {%- endif -%}

          <div class="proofs reveal" style="--i:4">
            {%- for block in section.blocks -%}
              {%- if block.type == 'proof' -%}
                <div class="proof" {{ block.shopify_attributes }}>
                  {% render 'pl-icon', icon: block.settings.icon %}
                  <div><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

        <div class="layers">
          {%- assign n = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'layer' -%}
              {%- assign n = n | plus: 1 -%}
              <div class="layer {% if block.settings.highlight %}layer--core{% endif %} reveal" style="--i:{{ n }}" {{ block.shopify_attributes }}>
                <span class="layer__swatch" style="background:{{ block.settings.colour }}"></span>
                <div><b>{{ n }} &middot; {{ block.settings.title }}</b><span>{{ block.settings.text }}</span></div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "PL — Why it costs this",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why it costs what it costs" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Density isn't firmness. It's how much foam is actually in the foam." },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "header", "content": "Density callout" },
    { "type": "html", "id": "density_number", "label": "Number", "default": "50<sup>kg/m³</sup>" },
    { "type": "text", "id": "density_caption", "label": "Caption", "default": "High-density memory foam core, CertiPUR-US certified and free from harmful chemicals." }
  ],
  "blocks": [
    { "type": "layer", "name": "Bed layer", "settings": [
      { "type": "text", "id": "title", "label": "Layer" },
      { "type": "textarea", "id": "text", "label": "Description" },
      { "type": "color", "id": "colour", "label": "Swatch", "default": "#DED3BF" },
      { "type": "checkbox", "id": "highlight", "label": "Highlight this layer", "default": false } ] },
    { "type": "proof", "name": "Proof point", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "leaf",
        "options": [ { "value": "leaf", "label": "Leaf" }, { "value": "medal", "label": "Medal" },
                     { "value": "drop", "label": "Waterproof" }, { "value": "shield", "label": "Shield" } ] },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "text", "label": "Subtitle" } ] }
  ],
  "presets": [{ "name": "PL — Why it costs this" }]
}
{% endschema %}
