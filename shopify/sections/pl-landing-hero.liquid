{% render 'pl-assets' %}
{% render 'pl-scheme', id: section.id, scheme: section.settings.scheme, bg: section.settings.bg, accent: section.settings.accent, tone: section.settings.tone %}
{%- liquid
  assign img = section.settings.image
  if img == blank and section.settings.image_product != blank
    assign img = section.settings.image_product.featured_image
  endif
-%}
<div class="pl">
  <section class="lp-hero">
    <div class="wrap">
      <div class="lp-hero__grid">
        <div>
          {%- if section.settings.badge != blank -%}
            <p class="lp-badge reveal">
              {% render 'pl-icon', icon: 'shield', size: 15 %}
              <span>{{ section.settings.badge }}</span>
            </p>
          {%- endif -%}

          <h1 class="reveal" style="--i:1">{{ section.settings.heading | escape | newline_to_br }}</h1>

          {%- if section.settings.lede != blank -%}
            <p class="lp-hero__lede reveal" style="--i:2">{{ section.settings.lede }}</p>
          {%- endif -%}

          {%- if section.settings.body != blank -%}
            <p class="lp-hero__body reveal" style="--i:3">{{ section.settings.body }}</p>
          {%- endif -%}

          <div class="lp-cta reveal" style="--i:4">
            {%- if section.settings.cta_1_text != blank -%}
              <a class="btn btn--lg" href="{{ section.settings.cta_1_link | default: '#pl-finder' }}">
                {{ section.settings.cta_1_text }}{% render 'pl-icon', icon: 'arrow', class: 'btn__arrow', size: 18 %}
              </a>
            {%- endif -%}
            {%- if section.settings.cta_2_text != blank -%}
              <a class="btn btn--lg btn--onDark" href="{{ section.settings.cta_2_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_2_text }}</a>
            {%- endif -%}
          </div>

          {%- if section.blocks.size > 0 -%}
            <p class="lp-reassure reveal" style="--i:5">
              {%- for block in section.blocks -%}
                <span {{ block.shopify_attributes }}>
                  {% render 'pl-icon', icon: 'check', size: 15 %}{{ block.settings.text }}
                </span>
              {%- endfor -%}
            </p>
          {%- endif -%}
        </div>

        {%- if img != blank -%}
          <div class="reveal" style="--i:2">
            <img class="lp-hero__img"
                 src="{{ img | image_url: width: 1000 }}"
                 srcset="{{ img | image_url: width: 560 }} 560w, {{ img | image_url: width: 1000 }} 1000w, {{ img | image_url: width: 1400 }} 1400w"
                 sizes="(min-width: 900px) 45vw, 100vw"
                 width="1000" height="1250"
                 fetchpriority="high" decoding="async"
                 alt="{{ img.alt | escape | default: section.settings.image_alt }}">
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "PL – Landing hero",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "100 nights to change your mind"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "He used to drop.\nNow he lowers himself."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Emotional line",
      "default": "Front legs first. A pause you didn't used to hear. Then the back end, lowered like it costs him something."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "It isn't the bed he's moving away from. It's the floor underneath it. Fibre filling migrates – it packs down exactly where his weight goes, until what arrived as 15cm of padding is the thickness of a folded tea towel. A solid memory foam core can't migrate. It's one continuous piece."
    },
    {
      "type": "text",
      "id": "cta_1_text",
      "label": "Primary button",
      "default": "Find his bed in 30 seconds"
    },
    {
      "type": "url",
      "id": "cta_1_link",
      "label": "Primary link"
    },
    {
      "type": "text",
      "id": "cta_2_text",
      "label": "Secondary button",
      "default": "Shop all beds"
    },
    {
      "type": "url",
      "id": "cta_2_link",
      "label": "Secondary link"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "product",
      "id": "image_product",
      "label": "…or use this product's photo"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Alt text",
      "default": "A large dog asleep on a PawLunova memory foam bed"
    },
    {
      "type": "header",
      "content": "Colour"
    },
    {
      "type": "paragraph",
      "content": "Text colour is chosen by measuring contrast against the background you pick, so a section cannot end up unreadable. The editor warns you if a background leaves no readable option."
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "cream",
          "label": "Cream, calm"
        },
        {
          "value": "oat",
          "label": "Oat, warm neutral"
        },
        {
          "value": "gold",
          "label": "Gold, warmth"
        },
        {
          "value": "forest",
          "label": "Forest, authority"
        },
        {
          "value": "clay",
          "label": "Deep green, focus"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "info": "Custom scheme only."
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Buttons and links",
      "info": "Custom scheme only."
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Text colour",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Automatic, recommended"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "light",
          "label": "Light"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "reassurance",
      "name": "Reassurance",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PL – Landing hero"
    }
  ]
}
{% endschema %}
