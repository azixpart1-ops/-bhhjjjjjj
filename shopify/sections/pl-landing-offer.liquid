{% render 'pl-assets' %}
<div class="pl">
  {%- if section.settings.quote != blank -%}
    <section class="pl-section pl-section--oat">
      <div class="wrap">
        <blockquote class="lp-quote reveal">
          <p>{{ section.settings.quote }}</p>
          {%- if section.settings.quote_source != blank -%}
            <footer>{{ section.settings.quote_source }}</footer>
          {%- endif -%}
        </blockquote>
      </div>
    </section>
  {%- endif -%}

  <section class="pl-section pl-section--dark">
    <div class="wrap">
      <div class="section-head section-head--center reveal">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="display-2">{{ section.settings.heading | escape | newline_to_br }}</h2>
      </div>

      <div class="lp-stack reveal" style="--i:1">
        {%- for block in section.blocks -%}
          <div class="lp-stack__row" {{ block.shopify_attributes }}>
            <b>{{ block.settings.title }}</b>
            <span>{{ block.settings.value }}</span>
          </div>
        {%- endfor -%}

        {%- if section.settings.total_title != blank -%}
          <div class="lp-stack__row lp-stack__row--total">
            <b>{{ section.settings.total_title }}</b>
            <span>{{ section.settings.total_value }}</span>
          </div>
        {%- endif -%}
      </div>

      <div class="lp-maths reveal" style="--i:2;margin-top:3rem">
        {%- if section.settings.cta_text != blank -%}
          <a class="btn btn--lg" href="{{ section.settings.cta_link | default: '#pl-finder' }}">
            {{ section.settings.cta_text }}{% render 'pl-icon', icon: 'arrow', class: 'btn__arrow', size: 18 %}
          </a>
        {%- endif -%}
        {%- if section.settings.fine_print != blank -%}
          <p class="muted" style="margin-top:1.25rem;font-size:.88rem">{{ section.settings.fine_print }}</p>
        {%- endif -%}
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "PL — What you actually get",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Quote" },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "He has never asked you for a single thing. This is one of the very few you can give back that he will actually use." },
    { "type": "text", "id": "quote_source", "label": "Attribution", "default": "From The Borrowdale" },
    { "type": "header", "content": "The stack" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Everything that comes with it" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "You are not risking the money.\nYou are risking one delivery." },
    { "type": "text", "id": "total_title", "label": "Final row title", "default": "What you actually risk" },
    { "type": "text", "id": "total_value", "label": "Final row value", "default": "One afternoon in, if it's wrong" },
    { "type": "text", "id": "cta_text", "label": "Button", "default": "Find his bed in 30 seconds" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "100-night sleep trial · 5-year foam guarantee · Free UK delivery over £40" }
  ],
  "blocks": [
    { "type": "item", "name": "Included", "settings": [
      { "type": "text", "id": "title", "label": "What it is" },
      { "type": "text", "id": "value", "label": "Detail" } ] }
  ],
  "presets": [{ "name": "PL — What you actually get" }]
}
{% endschema %}
