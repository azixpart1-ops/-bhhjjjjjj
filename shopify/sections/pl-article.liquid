{% render 'pl-assets' %}
<div class="pl">
  <section class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a> <span>/</span>
      <a href="{{ blog.url }}">{{ blog.title }}</a> <span>/</span>
      <span aria-current="page">{{ article.title | truncate: 50 }}</span>
    </nav>
    <article class="article">
      <div class="article__head reveal">
        <p class="eyebrow">{{ article.published_at | date: '%-d %B %Y' }}</p>
        <h1>{{ article.title }}</h1>
      </div>
      {%- if article.image -%}
        <img class="article__img reveal" src="{{ article.image | image_url: width: 1200 }}"
             alt="{{ article.image.alt | escape | default: article.title | escape }}"
             width="1200" height="675" loading="eager" decoding="async">
      {%- endif -%}
      <div class="rte reveal" style="--i:1;padding-bottom:clamp(2rem,5vw,4rem)">{{ article.content }}</div>
    </article>
  </section>
</div>
{% schema %}
{ "name": "PL — Article", "tag": "section", "settings": [], "presets": [{ "name": "PL — Article" }] }
{% endschema %}
