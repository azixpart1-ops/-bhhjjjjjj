{% render 'pl-assets' %}
{% render 'pl-cool-palette' %}
<div class="pl">
  <section class="pl-section pl-section--oat" id="cool-how">
    <div class="wrap">
      <div class="section-head section-head--center reveal">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="display-2">{{ section.settings.heading | escape | newline_to_br }}</h2>
      </div>

      <div class="cool-how">
        {%- for block in section.blocks -%}
          <article class="cool-card reveal" style="--i:{{ forloop.index }}" {{ block.shopify_attributes }}>
            <span class="cool-card__icon">{% render 'pl-icon', icon: block.settings.icon %}</span>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
            {%- if block.settings.spec != blank -%}
              <p class="cool-card__spec">{{ block.settings.spec }}</p>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>

      {%- if section.settings.show_note -%}
        <div class="cool-how__note reveal">
          {% render 'pl-cool-note', text: section.settings.note %}
        </div>
      {%- endif -%}
    </div>
  </section>
</div>
{% schema %}
{
  "name": "PL — How cooling works",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "No freezing, no plugs, no batteries" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "How cooling actually works." },
    { "type": "header", "content": "Safety note" },
    { "type": "checkbox", "id": "show_note", "label": "Show the safety note", "default": true,
      "info": "Keep this on. It is what keeps the cooling claims defensible." },
    { "type": "textarea", "id": "note", "label": "Note" }
  ],
  "blocks": [
    { "type": "pillar", "name": "Pillar", "limit": 4, "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "drop",
        "options": [
          { "value": "drop", "label": "Gel" },
          { "value": "leaf", "label": "Airflow" },
          { "value": "shield", "label": "Shield" },
          { "value": "medal", "label": "Medal" },
          { "value": "check", "label": "Tick" }
        ] },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Text" },
      { "type": "text", "id": "spec", "label": "Spec line", "info": "The measurable bit. Only put a number here if a supplier spec sheet backs it." } ] }
  ],
  "presets": [{ "name": "PL — How cooling works" }]
}
{% endschema %}
