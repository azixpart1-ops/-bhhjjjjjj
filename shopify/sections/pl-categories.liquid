{% render 'pl-assets' %}
{% render 'pl-scheme', id: section.id, scheme: section.settings.scheme, bg: section.settings.bg, accent: section.settings.accent, tone: section.settings.tone %}
{% render 'pl-layout', id: section.id, s: section.settings %}
{%- comment -%}
  Category shortcuts.

  Most shoppers arrive already knowing the category they want, and were
  reaching it through the Shop menu because the hero's category button sits
  second to the quiz. This gives that majority a one-click route without
  demoting the quiz for the people who do want guiding.

  Each tile counts its own collection, so a category that empties stops
  advertising beds it cannot show.
{%- endcomment -%}
{%- liquid
  assign st = section.settings

  comment
    Image tiles need images. A tile whose collection has no image and no
    override is a large empty box, so the style only applies once at least one
    block can actually produce a picture — otherwise it falls back to the
    compact row, which is designed to work without one. This is checked here
    rather than left to the merchant to notice on the live site.
  endcomment
  assign has_image = false
  for block in section.blocks
    if block.settings.image != blank or block.settings.collection.image != blank
      assign has_image = true
      break
    endif
  endfor

  assign cats = 'cats'
  if st.style == 'tiles' and has_image
    assign cats = cats | append: ' cats--tiles'
  endif
  if st.cols != blank and st.cols != 'auto'
    assign cats = cats | append: ' cats--fixed'
  endif

  comment
    Tiles want a bigger image than the compact row's 52px thumbnail, so the
    request width is chosen from the style rather than fixed. Asking for a
    1200px file to draw it at 52 is the sort of thing that quietly costs a
    second on a phone.
  endcomment
  assign img_w = 240
  assign img_sizes = '80px'
  if st.style == 'tiles' and has_image
    assign img_w = 800
    assign img_sizes = '(min-width: 760px) 26vw, 46vw'
  endif
-%}
<div class="pl">
  <section class="pl-section pl-section--tight"
           {% if st.anchor != blank %}id="{{ st.anchor | handleize }}"{% endif %}
           style="--cat-cols:{{ st.cols | default: 3 }};--cat-ratio:{{ st.ratio | default: '4 / 3' }}">
    <div class="wrap">
      {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
        <div class="cats__head reveal">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="display-3">{{ section.settings.heading }}</h2>{%- endif -%}
        </div>
      {%- endif -%}

      <ul class="{{ cats }}">
        {%- for block in section.blocks -%}
          {%- liquid
            comment
              Everything optional is coerced to a string before it is tested.
              An unset picker is nil, and "nil != blank" does not mean the same
              thing in every Liquid implementation: read one way, an empty
              block renders a tile that links nowhere.
            endcomment
            assign col = block.settings.collection
            assign label = block.settings.label | default: '' | strip
            assign href = block.settings.link | default: '' | strip
            assign note = block.settings.note | default: '' | strip
            if col != blank
              if label == ''
                assign label = col.title | split: '|' | first | strip
              endif
              if href == ''
                assign href = col.url
              endif
            endif
            assign href = href | default: '' | strip
          -%}
          {%- if href != '' and label != '' -%}
            <li class="reveal" style="--i:{{ forloop.index0 | modulo: 6 | plus: 1 }}" {{ block.shopify_attributes }}>
              <a class="cat" href="{{ href }}">
                {%- liquid
                  assign tile = block.settings.image
                  if tile == blank
                    assign tile = col.image
                  endif
                -%}
                {%- if tile != blank -%}
                  <img class="cat__img" src="{{ tile | image_url: width: img_w }}"
                       srcset="{{ tile | image_url: width: 160 }} 160w, {{ tile | image_url: width: 320 }} 320w, {{ tile | image_url: width: 640 }} 640w, {{ tile | image_url: width: 900 }} 900w"
                       sizes="{{ img_sizes }}" width="{{ img_w }}" height="{{ img_w }}" loading="lazy" decoding="async"
                       alt="{{ tile.alt | escape | default: label | escape }}">
                {%- endif -%}
                <span class="cat__body">
                  <span class="cat__name">{{ label }}</span>
                  {%- if note != '' -%}
                    <span class="cat__note">{{ note }}</span>
                  {%- elsif col != blank and section.settings.show_counts -%}
                    <span class="cat__note">{{ col.products_count }} {% if col.products_count == 1 %}bed{% else %}beds{% endif %}</span>
                  {%- endif -%}
                </span>
                {%- if st.show_arrow -%}
                  {% render 'pl-icon', icon: 'arrow', class: 'cat__arrow', size: 16 %}
                {%- endif -%}
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </section>
</div>
{% schema %}
