{% render 'pl-assets' %}
{% render 'pl-scheme', id: section.id, scheme: section.settings.scheme, bg: section.settings.bg, accent: section.settings.accent, tone: section.settings.tone %}
{%- comment -%}
  Collection page. Works for any collection: uses its own title, description,
  image and products. The promo tile is injected into the grid at a chosen
  position so the finder is reachable without leaving the listing.
{%- endcomment -%}
{%- liquid
  assign per = section.settings.per_page | default: 24
  assign sort = collection.sort_by | default: collection.default_sort_by

  assign display_title = collection.title | strip_html
  if section.settings.trim_title_at_pipe
    assign display_title = display_title | split: '|' | first | strip
  endif

  comment
    Descriptions here are structured with headings, so strip_html alone welds
    them into one run-on sentence. Take the first real paragraph instead.
  endcomment
  assign paras = collection.description | split: '<p>'
  if paras.size > 1
    assign intro_txt = paras[1] | split: '</p>' | first | strip_html | strip
  else
    assign intro_txt = collection.description | replace: '</h1>', ' ' | replace: '</h2>', ' ' | replace: '</h3>', ' ' | replace: '</p>', ' ' | strip_html | strip
  endif
  assign intro_txt = intro_txt | truncate: 300
-%}
<div class="pl">
  <section class="wrap">
    {%- if section.settings.show_breadcrumbs -%}
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a> <span>/</span>
        <span aria-current="page">{{ display_title | truncate: 60 }}</span>
      </nav>
    {%- endif -%}

    {%- comment -%}
      Turned off when a bespoke hero section already carries the H1 – the
      cooling collection does – so the page never ships two of them.
    {%- endcomment -%}
    {%- if section.settings.show_header -%}
    <div class="chero">
      <div class="chero__grid">
        <div class="reveal">
          <h1>{{ display_title }}</h1>
          {%- if section.settings.intro != blank -%}
            <div class="chero__intro">{{ section.settings.intro }}</div>
          {%- elsif intro_txt != blank -%}
            <div class="chero__intro">{{ intro_txt }}</div>
          {%- endif -%}
          <p class="chero__count">{{ collection.products_count }} {% if collection.products_count == 1 %}bed{% else %}beds{% endif %} · 100-night trial on every one</p>
        </div>
        {%- if collection.image and section.settings.show_image -%}
          <img class="chero__img reveal" style="--i:1"
               src="{{ collection.image | image_url: width: 900 }}"
               srcset="{{ collection.image | image_url: width: 560 }} 560w, {{ collection.image | image_url: width: 1100 }} 1100w"
               sizes="(min-width: 900px) 45vw, 100vw"
               width="900" height="562" loading="eager" decoding="async"
               alt="{{ collection.image.alt | escape | default: display_title | escape }}">
        {%- endif -%}
      </div>
    </div>
    {%- endif -%}

    {%- if section.settings.show_filters -%}
      <div class="filters" id="plFilters">
        <div class="filters__top">
          <button class="filters__toggle" type="button" id="plFiltersToggle" aria-expanded="false" aria-controls="plFiltersBody">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M7 12h10M10 18h4"/></svg>
            Filter
            <b id="plFilterCount" hidden>0</b>
          </button>
          <span class="filters__count" id="plFilterResults"></span>
        </div>
        <div class="filters__body" id="plFiltersBody"><div><div class="filters__inner">
          <div class="fgroup">
            <h3>Who it's for</h3>
            <div class="fgroup__opts" data-facet="fit">
              <button class="fchip" type="button" data-value="small" aria-pressed="false">Small dog</button>
              <button class="fchip" type="button" data-value="medium" aria-pressed="false">Medium dog</button>
              <button class="fchip" type="button" data-value="large" aria-pressed="false">Large dog</button>
            </div>
          </div>
          <div class="fgroup">
            <h3>What they need</h3>
            <div class="fgroup__opts" data-facet="need">
              <button class="fchip" type="button" data-value="orthopaedic" aria-pressed="false">Joint support</button>
              <button class="fchip" type="button" data-value="nest" aria-pressed="false">Walls to lean on</button>
              <button class="fchip" type="button" data-value="waterproof" aria-pressed="false">Waterproof</button>
            </div>
          </div>
          {%- comment -%}
            Material is how the premium competitors let people browse, and it
            is the thing shoppers use to judge which bed is the good one. The
            options are built from the products actually in this collection,
            so the filter can never offer a fabric that returns nothing.
          {%- endcomment -%}
          {%- liquid
            assign mats = ''
            assign known = 'corduroy,memory foam,boucle,velvet,sherpa,felt,fleece,plush,rattan,wicker,quilted'  | split: ','
            for item in collection.products
              assign hay = item.tags | join: ',' | append: ',' | append: item.type | append: ',' | append: item.title | downcase
              for word in known
                unless mats contains word
                  if hay contains word
                    assign mats = mats | append: word | append: ','
                  endif
                endunless
              endfor
            endfor
            assign mat_list = mats | split: ','
          -%}
          {%- if mat_list.size > 1 -%}
            <div class="fgroup">
              <h3>Material</h3>
              <div class="fgroup__opts" data-facet="material">
                {%- for m in mat_list -%}
                  <button class="fchip" type="button" data-value="{{ m }}" aria-pressed="false">{{ m | capitalize }}</button>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
          <div class="fgroup">
            <h3>Budget</h3>
            <div class="fgroup__opts" data-facet="price">
              <button class="fchip" type="button" data-value="under-75" aria-pressed="false">Under £75</button>
              <button class="fchip" type="button" data-value="75-125" aria-pressed="false">£75 &ndash; £125</button>
              <button class="fchip" type="button" data-value="over-125" aria-pressed="false">£125+</button>
            </div>
          </div>
        </div>
        <p style="margin-top:1.25rem"><button class="filters__clear" type="button" id="plFiltersClear" hidden>Clear all filters</button></p>
        </div></div>
      </div>
    {%- endif -%}

    <div class="ctoolbar">
      <span class="ctoolbar__count">Showing {{ collection.products.size }} of {{ collection.products_count }}</span>
      {%- if section.settings.show_sort -%}
        <form method="get" id="plSortForm">
          {%- for f in collection.filters -%}
            {%- for v in f.active_values -%}
              <input type="hidden" name="{{ v.param_name }}" value="{{ v.value | escape }}">
            {%- endfor -%}
          {%- endfor -%}
          <label for="plSort">Sort</label>
          <select name="sort_by" id="plSort" onchange="this.form.submit()">
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == sort %}selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </form>
      {%- endif -%}
    </div>

    {%- paginate collection.products by per -%}
      {%- if collection.products.size > 0 -%}
        <div class="cgrid">
          {%- for item in collection.products -%}
            {%- if section.settings.show_promo and forloop.index == section.settings.promo_after -%}
              <div class="promo reveal">
                <h3>{{ section.settings.promo_heading }}</h3>
                <p>{{ section.settings.promo_text }}</p>
                <a class="btn" href="{{ section.settings.promo_link | default: '/' }}">
                  {{ section.settings.promo_cta }}{% render 'pl-icon', icon: 'arrow', class: 'btn__arrow', size: 18 %}
                </a>
              </div>
            {%- endif -%}
            {%- liquid
              assign lazy = true
              if forloop.index <= 4
                assign lazy = false
              endif
              assign stagger = forloop.index0 | modulo: 4 | plus: 1
            -%}
            {% render 'pl-product-card',
                 product: item,
                 index: stagger,
                 heading: 'h2',
                 show_desc: true,
                 show_type: section.settings.show_type,
                 show_material: section.settings.show_material,
                 show_rating: section.settings.show_rating,
                 fallback_rating: section.settings.rating_fallback,
                 fallback_label: section.settings.rating_fallback_label,
                 rating_min: section.settings.rating_min,
                 rating_show_count: section.settings.rating_show_count,
                 facets: true,
                 lazy: lazy %}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pager" aria-label="Pagination">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" rel="prev">Previous</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}
                <span {% if part.title == paginate.current_page %}aria-current="page"{% endif %}>{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}" rel="next">Next</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <div class="cempty">
          <h2 class="display-3">{{ section.settings.empty_heading }}</h2>
          <p class="body-lg" style="margin-top:1rem">{{ section.settings.empty_text }}</p>
          <p style="margin-top:1.5rem"><a class="btn btn--lg" href="{{ routes.all_products_collection_url }}">Shop all beds</a></p>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </section>

  {%- if section.settings.show_full_description and collection.description != blank -%}
    <section class="pl-section pl-section--oat">
      <div class="wrap">
        <div class="page-body reveal">
          <div class="pl-rte">{{ collection.description | replace: '<h1>', '<h2>' | replace: '</h1>', '</h2>' }}</div>
        </div>
      </div>
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "PL – Collection",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show the title and intro",
      "default": true,
      "info": "Turn off when a hero section above already carries the page's H1."
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show collection image",
      "default": true
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro override",
      "info": "Leave blank to use the collection's own description."
    },
    {
      "type": "checkbox",
      "id": "trim_title_at_pipe",
      "label": "Trim the heading at the first \"|\"",
      "default": true,
      "info": "Keeps SEO-stuffed collection titles out of the on-page heading. Titles without a pipe are unchanged."
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show filters",
      "default": true,
      "info": "Filters run in the browser across the products on this page, so nothing reloads."
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show sort dropdown",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_type",
      "label": "Show product type on cards",
      "default": false
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24,
      "info": "The filters narrow the products already on the page, so keep this at or above the size of your largest collection."
    },
    {
      "type": "header",
      "content": "Star ratings"
    },
    {
      "type": "paragraph",
      "content": "Ratings come from each product's own review data. A product with no reviews shows no stars rather than a default score. Connect a reviews app, or fill in Rating and Rating count on the product in admin."
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star ratings on cards",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "rating_show_count",
      "label": "Show the score and review count",
      "default": true
    },
    {
      "type": "range",
      "id": "rating_min",
      "label": "Hide until this many reviews",
      "min": 1,
      "max": 50,
      "step": 1,
      "default": 3,
      "info": "A score built on one or two reviews swings too far to be worth leading with."
    },
    {
      "type": "text",
      "id": "rating_fallback",
      "label": "Shop rating for products with no reviews",
      "default": "4.8",
      "info": "Shown on cards for products with no rating of their own, so every card carries stars. Leave blank to show nothing on those. Must be a figure you can stand behind."
    },
    {
      "type": "text",
      "id": "rating_fallback_label",
      "label": "Shop rating label",
      "default": "across all beds",
      "info": "Printed beside the score so it never reads as this product's own review count."
    },
    {
      "type": "checkbox",
      "id": "show_full_description",
      "label": "Show the full collection description below the grid",
      "default": true,
      "info": "Good for SEO copy that would otherwise push the products down the page."
    },
    {
      "type": "header",
      "content": "In-grid promo"
    },
    {
      "type": "checkbox",
      "id": "show_promo",
      "label": "Show promo tile in the grid",
      "default": true
    },
    {
      "type": "range",
      "id": "promo_after",
      "label": "Insert before product number",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 5
    },
    {
      "type": "text",
      "id": "promo_heading",
      "label": "Heading",
      "default": "Not sure which one?"
    },
    {
      "type": "textarea",
      "id": "promo_text",
      "label": "Text",
      "default": "Three questions about how your dog sleeps, and we'll point you at one bed instead of twenty."
    },
    {
      "type": "text",
      "id": "promo_cta",
      "label": "Button",
      "default": "Find their bed"
    },
    {
      "type": "url",
      "id": "promo_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Empty state"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Heading",
      "default": "Nothing here just yet."
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "Text",
      "default": "Every bed we make is in the full collection – have a look there instead."
    },
    {
      "type": "header",
      "content": "Colour"
    },
    {
      "type": "paragraph",
      "content": "Text colour is chosen by measuring contrast against the background you pick, so a section cannot end up unreadable. The editor warns you if a background leaves no readable option."
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "cream",
          "label": "Cream, calm"
        },
        {
          "value": "oat",
          "label": "Oat, warm neutral"
        },
        {
          "value": "gold",
          "label": "Gold, warmth"
        },
        {
          "value": "forest",
          "label": "Forest, authority"
        },
        {
          "value": "clay",
          "label": "Deep green, focus"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "info": "Custom scheme only."
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Buttons and links",
      "info": "Custom scheme only."
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Text colour",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Automatic, recommended"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "light",
          "label": "Light"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PL – Collection"
    }
  ]
}
{% endschema %}
