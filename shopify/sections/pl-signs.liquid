{% render 'pl-assets' %}
{% render 'pl-scheme', id: section.id, scheme: section.settings.scheme, bg: section.settings.bg, accent: section.settings.accent, tone: section.settings.tone %}
{% render 'pl-layout', id: section.id, s: section.settings %}
{%- liquid
  assign st = section.settings

  assign signs = 'signs'
  case st.card
    when 'plain'
      assign signs = signs | append: ' signs--plain'
    when 'rules'
      assign signs = signs | append: ' signs--rules'
  endcase
-%}
<div class="pl">
  <section class="pl-section pl-section--dark"
           {% if st.anchor != blank %}id="{{ st.anchor | handleize }}"{% endif %}
           style="--signs-cols:{{ st.cols | default: 3 }}">
    <div class="wrap">
      <div class="section-head reveal">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="display-2">{{ section.settings.heading | escape | newline_to_br }}</h2>
      </div>
      <div class="{{ signs }}">
        {%- for block in section.blocks -%}
          <article class="sign reveal" style="--i:{{ forloop.index }}" {{ block.shopify_attributes }}>
            <span class="sign__num"{% unless st.show_numbers %} hidden{% endunless %}>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </article>
        {%- endfor -%}
      </div>
      {%- if section.settings.note != blank -%}
        <div class="signs-note reveal">
          <p class="lede">{{ section.settings.note }}</p>
          {%- if section.settings.cta_text != blank -%}
            <a class="btn btn--onDark btn--lg" href="{{ section.settings.cta_link | default: '#pl-finder' }}">
              {{ section.settings.cta_text }}{% render 'pl-icon', icon: 'arrow', class: 'btn__arrow', size: 18 %}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>
</div>
{% schema %}
{
  "name": "PL – Three signs",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
