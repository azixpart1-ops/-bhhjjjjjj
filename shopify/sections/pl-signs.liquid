{% render 'pl-assets' %}
<div class="pl">
  <section class="pl-section pl-section--dark">
    <div class="wrap">
      <div class="section-head reveal">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="display-2">{{ section.settings.heading | escape | newline_to_br }}</h2>
      </div>
      <div class="signs">
        {%- for block in section.blocks -%}
          <article class="sign reveal" style="--i:{{ forloop.index }}" {{ block.shopify_attributes }}>
            <span class="sign__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </article>
        {%- endfor -%}
      </div>
      {%- if section.settings.note != blank -%}
        <div class="signs-note reveal">
          <p class="lede">{{ section.settings.note }}</p>
          {%- if section.settings.cta_text != blank -%}
            <a class="btn btn--onDark btn--lg" href="{{ section.settings.cta_link | default: '#pl-finder' }}">
              {{ section.settings.cta_text }}{% render 'pl-icon', icon: 'arrow', class: 'btn__arrow', size: 18 %}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>
</div>
{% schema %}
{
  "name": "PL — Three signs",
  "tag": "pl-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Before you buy another bed" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Dogs don't tell you the bed has stopped working.\nThey show you." },
    { "type": "textarea", "id": "note", "label": "Closing pl-line", "default": "Ageing isn't something a bed can undo. What a bed can change is how much work it takes to lie down — and to get back up again." },
    { "type": "text", "id": "cta_text", "label": "Button", "default": "Find the right bed" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "sign", "name": "Sign", "limit": 3, "settings": [
      { "type": "text", "id": "title", "label": "Sign" },
      { "type": "textarea", "id": "text", "label": "Explanation" } ] }
  ],
  "presets": [{ "name": "PL — Three signs" }]
}
{% endschema %}
