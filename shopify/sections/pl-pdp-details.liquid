{% render 'pl-assets' %}
{%- liquid
  assign p = product

  comment
    Cooling products carry the safety line automatically, off their own tags and
    type – so a new cooling bed is compliant the day it is added, with nobody
    having to remember to tick a box. The colourway uses the same test, inside
    the snippet.
  endcomment
  assign cool_hay = p.tags | join: ',' | append: ',' | append: p.type | downcase
  assign is_cool = false
  if cool_hay contains 'cooling' or cool_hay contains 'elevated'
    assign is_cool = true
  endif

  comment
    The descriptions open with an italic line that is the real headline for
    this section ("For the dog whose mornings have got slower."). Lift it out
    and use it as the H2 instead of a generic settings heading, then hand the
    rest to pl-rte-clean to strip the framework scaffolding.
  endcomment
  assign desc = p.description | strip
  assign lifted = ''
  assign opener = desc | slice: 0, 7
  if opener == '<p><em>'
    assign segs = desc | split: '</em></p>'
    assign lifted = segs[0] | remove: '<p><em>' | strip_html | strip
    assign desc = desc | remove_first: segs[0] | remove_first: '</em></p>' | strip
  endif

  assign k1t = p.metafields.vitals.key_benefit_1_title.value
  assign k1d = p.metafields.vitals.key_benefit_1_description.value
  assign k2t = p.metafields.vitals.key_benefit_2_title.value
  assign k2d = p.metafields.vitals.key_benefit_2_description.value
  assign k3t = p.metafields.vitals.key_benefit_3_title.value
  assign k3d = p.metafields.vitals.key_benefit_3_description.value
-%}
<div class="pl">
  <section class="pl-section pl-section--oat">
    <div class="wrap">
      <div class="pl-details">
        <div>
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow reveal">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- assign lead = lifted | default: section.settings.heading -%}
          {%- if lead != blank -%}
            <h2 class="display-3 reveal" style="--i:1;margin-bottom:1.25rem">{{ lead }}</h2>
          {%- endif -%}
          <div class="pl-rte reveal" style="--i:2">
            {% render 'pl-rte-clean', html: desc, drop: section.settings.drop_headings %}
          </div>

          {%- if is_cool -%}
            <div class="reveal" style="--i:2;margin-top:1.75rem">
              {% render 'pl-cool-note', text: section.settings.cool_note %}
            </div>
          {%- endif -%}

          {%- if k1t != blank -%}
            <div class="layers reveal" style="--i:3;margin-top:2rem">
              {%- if k1t != blank -%}
                <div class="layer"><span class="layer__swatch" style="background:#DED3BF"></span>
                  <div><b>{{ k1t }}</b><span>{{ k1d }}</span></div></div>
              {%- endif -%}
              {%- if k2t != blank -%}
                <div class="layer"><span class="layer__swatch" style="background:#B8C6BC"></span>
                  <div><b>{{ k2t }}</b><span>{{ k2d }}</span></div></div>
              {%- endif -%}
              {%- if k3t != blank -%}
                <div class="layer"><span class="layer__swatch" style="background:#C98B63"></span>
                  <div><b>{{ k3t }}</b><span>{{ k3d }}</span></div></div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        <div class="specs reveal" style="--i:2">
          <h3>{{ section.settings.specs_title }}</h3>
          <dl>
            {%- unless p.has_only_default_variant -%}
              {%- for opt in p.options_with_values -%}
                <div class="specs__row">
                  <dt>{{ opt.name | remove_first: 'Accessory ' | remove_first: 'accessory ' | capitalize }}</dt>
                  <dd>{{ opt.values | join: ' · ' }}</dd>
                </div>
              {%- endfor -%}
            {%- endunless -%}
            {%- if p.type != blank -%}
              <div class="specs__row"><dt>Type</dt><dd>{{ p.type }}</dd></div>
            {%- endif -%}
            {%- comment -%}
              Labelled "Price range" when it varies. The buy block above shows
              the selected variant's price, so an unlabelled range here read as
              a contradiction rather than as extra information.
            {%- endcomment -%}
            <div class="specs__row">
              <dt>{% if p.price_varies %}Price range{% else %}Price{% endif %}</dt>
              <dd>{% if p.price_varies %}{{ p.price_min | money }} – {{ p.price_max | money }}{% else %}{{ p.price | money }}{% endif %}</dd>
            </div>
            {%- for block in section.blocks -%}
              <div class="specs__row" {{ block.shopify_attributes }}>
                <dt>{{ block.settings.label }}</dt><dd>{{ block.settings.value }}</dd>
              </div>
            {%- endfor -%}
          </dl>
        </div>
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "PL – Description & specs",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The detail" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "specs_title", "label": "Specs panel title", "default": "At a glance" },
    { "type": "header", "content": "Description clean-up" },
    { "type": "paragraph", "content": "The opening italic line becomes this section's heading. The framework headings below are stripped; every other heading is sentence-cased and demoted to H3. The product copy itself is never edited." },
    { "type": "text", "id": "drop_headings", "label": "Headings to remove",
      "info": "Lower case, comma separated, no spaces after the commas.",
      "default": "the moment,the promise,the close,feature to benefit" },
    { "type": "header", "content": "Cooling products" },
    { "type": "paragraph", "content": "Products tagged or typed as cooling or elevated automatically get the cool colourway and the safety note below. Nothing to switch on per product." },
    { "type": "textarea", "id": "cool_note", "label": "Cooling safety note" }
  ],
  "blocks": [
    { "type": "spec", "name": "Spec row", "settings": [
      { "type": "text", "id": "label", "label": "Label" },
      { "type": "text", "id": "value", "label": "Value" } ] }
  ],
  "presets": [{ "name": "PL – Description & specs" }]
}
{% endschema %}
