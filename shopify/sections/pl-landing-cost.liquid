{% render 'pl-assets' %}
<div class="pl">
  <section class="pl-section">
    <div class="wrap">
      <div class="section-head section-head--center reveal">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="display-2">{{ section.settings.heading | escape | newline_to_br }}</h2>
      </div>

      <div class="lp-cost reveal" style="--i:1">
        <div class="lp-cost__col lp-cost__col--wait">
          <h3>{{ section.settings.wait_title }}</h3>
          <ul>
            {%- for block in section.blocks -%}
              {%- if block.type == 'wait' -%}
                <li {{ block.shopify_attributes }}>
                  {% render 'pl-icon', icon: 'cross', size: 16 %}
                  <span>{{ block.settings.text }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>

        <div class="lp-cost__col lp-cost__col--now">
          <h3>{{ section.settings.now_title }}</h3>
          <ul>
            {%- for block in section.blocks -%}
              {%- if block.type == 'now' -%}
                <li {{ block.shopify_attributes }}>
                  {% render 'pl-icon', icon: 'check', size: 16 %}
                  <span>{{ block.settings.text }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>

      {%- if section.settings.maths_figure != blank -%}
        <div class="lp-maths reveal" style="--i:2">
          <p class="lp-maths__figure">{{ section.settings.maths_figure }}</p>
          {%- if section.settings.maths_caption != blank -%}
            <p class="lp-maths__cap">{{ section.settings.maths_caption }}</p>
          {%- endif -%}
          {%- if section.settings.cta_text != blank -%}
            <p style="margin-top:2rem">
              <a class="btn btn--lg" href="{{ section.settings.cta_link | default: '#pl-finder' }}">
                {{ section.settings.cta_text }}{% render 'pl-icon', icon: 'arrow', class: 'btn__arrow', size: 18 %}
              </a>
            </p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>
</div>
{% schema %}
{
  "name": "PL – The cost of waiting",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Two versions of the next six months" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Doing nothing is also a decision.\nIt just doesn't feel like one." },
    { "type": "text", "id": "wait_title", "label": "Left column title", "default": "If it waits until spring" },
    { "type": "text", "id": "now_title", "label": "Right column title", "default": "If it changes this week" },
    { "type": "header", "content": "The maths" },
    { "type": "text", "id": "maths_figure", "label": "Figure", "default": "9p a night" },
    { "type": "textarea", "id": "maths_caption", "label": "Caption", "default": "That's what a £169 bed comes to across the five years its foam core is guaranteed for. He sleeps twelve to fourteen hours a day. There is no other thing you buy him that he will use for that long." },
    { "type": "text", "id": "cta_text", "label": "Button", "default": "Find his bed in 30 seconds" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "wait", "name": "If it waits", "settings": [
      { "type": "textarea", "id": "text", "label": "Text" } ] },
    { "type": "now", "name": "If it changes", "settings": [
      { "type": "textarea", "id": "text", "label": "Text" } ] }
  ],
  "presets": [{ "name": "PL – The cost of waiting" }]
}
{% endschema %}
