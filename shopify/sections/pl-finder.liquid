{% render 'pl-assets' %}
{% render 'pl-scheme', id: section.id, scheme: section.settings.scheme, bg: section.settings.bg, accent: section.settings.accent, tone: section.settings.tone %}
{% render 'pl-layout', id: section.id, s: section.settings %}
{%- comment -%}
  Bed finder. Each block maps one answer combination to a real product.
  Price, stock, image and URL are read from the catalogue at render time, so
  nothing here goes stale – including the "only N left" badge.
{%- endcomment -%}
{%- liquid
  assign st = section.settings

  comment
    The anchor defaults to pl-finder because the hero, the signs section, the
    finale, the sticky bar and the empty cart all link to #pl-finder. A
    merchant renaming it here has to update those links too, which is why the
    field says so rather than silently breaking five buttons.
  endcomment
  assign finder_id = st.anchor | default: 'pl-finder' | handleize

  assign head = 'section-head section-head--center'
  if st.align == 'left'
    assign head = 'section-head'
  endif

  assign panel = 'finder'
  if st.panel == 'plain'
    assign panel = panel | append: ' finder--plain'
  endif
-%}
<div class="pl">
  <section class="pl-section" id="{{ finder_id }}">
    <div class="wrap">
      <div class="{{ head }} reveal">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="display-2">{{ section.settings.heading | escape | newline_to_br }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="body-lg" style="margin-top:1rem">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>

      <div class="{{ panel }} reveal" id="plFinder">
        <div class="finder__progress"{% unless st.show_progress %} hidden{% endunless %}>
          <span id="plFinderStepLabel">Question 1 of 3</span>
          <span class="finder__bar"><i id="plFinderBar" style="width:33%"></i></span>
        </div>

        <div class="finder__step" data-step="0" data-active>
          <h3 class="finder__q">{{ section.settings.q1 }}</h3>
          <p class="finder__hint">{{ section.settings.q1_hint }}</p>
          <div class="finder__options" role="group" aria-label="Sleeping style">
            <button class="opt" type="button" data-q="style" data-value="nest" aria-pressed="false">
              {% render 'pl-icon', icon: 'curl' %}
              <b>Curls up tight</b><span>Circles, tucks their nose under, presses their back into something solid.</span>
            </button>
            <button class="opt" type="button" data-q="style" data-value="bolster" aria-pressed="false">
              {% render 'pl-icon', icon: 'lean' %}
              <b>Leans on something</b><span>Chin hooked over an edge, spine against a wall, an arm or a cushion.</span>
            </button>
            <button class="opt" type="button" data-q="style" data-value="flat" aria-pressed="false">
              {% render 'pl-icon', icon: 'flat' %}
              <b>Sprawls flat out</b><span>On their side, legs at full stretch, taking up the entire bed and then some.</span>
            </button>
          </div>
        </div>

        <div class="finder__step" data-step="1">
          <h3 class="finder__q">{{ section.settings.q2 }}</h3>
          <p class="finder__hint">{{ section.settings.q2_hint }}</p>
          <div class="finder__options" role="group" aria-label="Joint condition">
            <button class="opt" type="button" data-q="joints" data-value="fine" aria-pressed="false">
              <b>No concerns yet</b><span>Young or middle-aged. Up and down the stairs without a second thought.</span>
            </button>
            <button class="opt" type="button" data-q="joints" data-value="slowing" aria-pressed="false">
              <b>Slowing down</b><span>Stiff first thing. A pause before the stairs. Not quite what they were.</span>
            </button>
            <button class="opt" type="button" data-q="joints" data-value="diagnosed" aria-pressed="false">
              <b>Diagnosed or recovering</b><span>Arthritis, hip or elbow dysplasia, or coming back from surgery.</span>
            </button>
          </div>
          <button class="finder__back" type="button" data-back>&larr; Back</button>
        </div>

        <div class="finder__step" data-step="2">
          <h3 class="finder__q">{{ section.settings.q3 }}</h3>
          <p class="finder__hint">{{ section.settings.q3_hint }}</p>
          <div class="finder__options" role="group" aria-label="Dog size">
            <button class="opt" type="button" data-q="size" data-value="small" aria-pressed="false">
              <b>Small</b>
              <span class="opt__eg">Dachshund · Cavalier · Shih Tzu · Jack Russell</span>
              <span class="opt__kg">Up to 10kg</span>
            </button>
            <button class="opt" type="button" data-q="size" data-value="medium" aria-pressed="false">
              <b>Medium</b>
              <span class="opt__eg">Cocker · Border Collie · Springer · Staffie</span>
              <span class="opt__kg">10 &ndash; 25kg</span>
            </button>
            <button class="opt" type="button" data-q="size" data-value="large" aria-pressed="false">
              <b>Large</b>
              <span class="opt__eg">Labrador · Golden Retriever · German Shepherd</span>
              <span class="opt__kg">25kg and up</span>
            </button>
          </div>
          {%- if section.settings.measure_note != blank -%}
            <p class="finder__measure">{{ section.settings.measure_note }}</p>
          {%- endif -%}
          <button class="finder__back" type="button" data-back>&larr; Back</button>
        </div>

        <div class="finder__step" data-step="3">
          <div class="result">
            <img class="result__img" id="plResultImg" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E" alt="" width="700" height="700" loading="lazy" decoding="async">
            <div>
              <span class="result__label">{{ section.settings.result_label }}</span>
              <h3 id="plResultName">&ndash;</h3>
              <p class="result__why" id="plResultWhy">&ndash;</p>
              <p class="result__dims" id="plResultDims" hidden></p>
              <div class="result__meta">
                <span class="result__price" id="plResultPrice">&ndash;</span>
                <span class="result__size" id="plResultSize"></span>
                <span class="stock-pill" id="plResultStock" hidden></span>
              </div>
              <div class="result__actions">
                <a class="btn btn--lg" id="plResultLink" href="{{ routes.all_products_collection_url }}">
                  <span id="plResultLinkText">See the bed</span>
                  {% render 'pl-icon', icon: 'arrow', class: 'btn__arrow', size: 18 %}
                </a>
                <button class="finder__back" type="button" id="plFinderRestart">Start again</button>
              </div>
              {%- if section.settings.reassurance != blank -%}
                <p class="muted" style="font-size:.85rem;margin-top:1.25rem">{{ section.settings.reassurance }}</p>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {%- if section.settings.show_sticky -%}
    <div class="sticky-cta" id="plStickyCta">
      <div class="sticky-cta__txt">
        <b>{{ section.settings.sticky_title }}</b>
        <span>{{ section.settings.sticky_text }}</span>
      </div>
      <a class="btn" href="#{{ finder_id }}">{{ section.settings.sticky_cta }}</a>
    </div>
  {%- endif -%}
</div>

{%- comment -%} Live catalogue data for the finder. {%- endcomment -%}
<script type="application/json" id="pl-beds">
{
{%- assign first = true -%}
{%- for block in section.blocks -%}
  {%- assign p = block.settings.product -%}
  {%- if p != blank and block.settings.slot != blank -%}
    {%- unless first -%},{%- endunless -%}
    {%- assign first = false -%}
    "{{ block.settings.slot }}": {
      "title": {{ block.settings.display_title | default: p.title | json }},
      "short": {{ block.settings.short | default: p.title | json }},
      "why": {{ block.settings.why | json }},
      "url": {{ p.url | json }},
      "img": {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 700 | json }}{%- else -%}""{%- endif -%},
      "bands": {
        {%- assign bands = 'small|medium|large' | split: '|' -%}
        {%- for band in bands -%}
          {%- liquid
            case band
              when 'small'
                assign want = block.settings.size_small
                assign dims = block.settings.dims_small
              when 'medium'
                assign want = block.settings.size_medium
                assign dims = block.settings.dims_medium
              else
                assign want = block.settings.size_large
                assign dims = block.settings.dims_large
            endcase
            assign wlower = want | downcase | strip
            assign vid = ''
            assign fallback_used = false
          -%}
          {%- comment -%}
            Match the wanted option value against the variant's option tokens
            exactly. 'contains' would let 'l' match 'large', which silently
            picks the wrong size.

            Sizes are also matched on their leading code, because some beds
            label the option with the dimensions attached: the Kendal's sizes
            read "S · 45 × 29.5cm". Comparing only the whole string meant every
            band missed and every shopper was handed the smallest variant, so
            "s" is now allowed to match "s · 45 × 29.5cm" while still refusing
            to match "small" or "large". A variant relabelled with its
            measurements can no longer silently break the quiz.
          {%- endcomment -%}
          {%- if wlower != '' -%}
            {%- for v in p.variants -%}
              {%- if vid == '' -%}
                {%- assign parts = v.title | downcase | split: ' / ' -%}
                {%- for part in parts -%}
                  {%- assign ptoken = part | strip -%}
                  {%- assign pshort = ptoken | split: ' ' | first | strip -%}
                  {%- if ptoken == wlower or pshort == wlower -%}{%- assign hit = true -%}{%- else -%}{%- assign hit = false -%}{%- endif -%}
                  {%- if hit and vid == '' -%}
                    {%- assign vid = v.id -%}
                    {%- comment -%}
                      Store the matched option token, not the whole variant
                      title – on a two-option bed that would read
                      "Size GREEN / 2XL".
                    {%- endcomment -%}
                    {%- assign vtitle = ptoken -%}
                    {%- assign vprice = v.price | money | strip_html -%}
                    {%- assign vavail = v.available -%}
                    {%- assign vurl = v.url -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          {%- if vid == '' -%}
            {%- assign fallback_used = true -%}
            {%- assign fv = p.selected_or_first_available_variant -%}
            {%- assign vid = fv.id -%}
            {%- assign vtitle = fv.title -%}
            {%- assign vprice = fv.price | money | strip_html -%}
            {%- assign vavail = fv.available -%}
            {%- assign vurl = fv.url -%}
          {%- endif -%}
          {%- comment -%}
            "matched" records whether the wanted size token actually found a
            variant, or whether this fell back to the first available one. A
            bed that only comes in Large must not be presented to someone with
            a medium dog as though it were their size.
          {%- endcomment -%}
          {%- assign band_matched = true -%}
          {%- if wlower == '' or vid == '' -%}{%- assign band_matched = false -%}{%- endif -%}
          {%- if fallback_used -%}{%- assign band_matched = false -%}{%- endif -%}
          {%- comment -%}
            Collect the misses so the editor can report them. A size setting
            that matches nothing fails silently: the quiz still answers, it
            just answers with the wrong variant, which is the hardest kind of
            fault to notice from the outside.
          {%- endcomment -%}
          {%- if fallback_used and wlower != '' and p.has_only_default_variant == false -%}
            {%- capture miss -%}{{ miss }}{{ block.settings.slot }} · {{ band }} is set to "{{ want }}", which no size on {{ p.title }} matches. |{%- endcapture -%}
          {%- endif -%}
          "{{ band }}": {
            "id": {{ vid | json }},
            "size": {{ vtitle | json }},
            "price": {{ vprice | json }},
            "url": {{ vurl | json }},
            "available": {{ vavail | json }},
            "matched": {{ band_matched | json }},
            "dims": {{ dims | default: '' | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      }
    }
  {%- endif -%}
{%- endfor -%}
}
</script>

{%- if request.design_mode and miss != blank -%}
  <div style="margin:0;padding:.75rem 1rem;background:#7A1F1F;color:#fff;font:14px/1.5 system-ui">
    <b>Bed finder size check</b>
    <ul style="margin:.4rem 0 0;padding-left:1.1rem">
      {%- assign misses = miss | split: '|' -%}
      {%- for m in misses -%}
        {%- assign m = m | strip -%}
        {%- if m != blank -%}<li>{{ m }}</li>{%- endif -%}
      {%- endfor -%}
    </ul>
    <p style="margin:.5rem 0 0">Those answers currently hand the shopper the bed's first size instead. Set each one to the size exactly as it appears on the product.</p>
  </div>
{%- endif -%}

{% schema %}
