              "label": "Sprawls · Slowing down"
            },
            {
              "value": "flat_diagnosed",
              "label": "Sprawls · Diagnosed"
            }
          ]
        },
        {
          "type": "product",
          "id": "product",
          "label": "Bed to recommend"
        },
        {
          "type": "text",
          "id": "display_title",
          "label": "Display name",
          "info": "Leave blank to use the product title."
        },
        {
          "type": "text",
          "id": "short",
