          "default": "nest_fine",
          "options": [
            {
              "value": "nest_fine",
              "label": "Curls up · No concerns"
            },
            {
              "value": "nest_slowing",
              "label": "Curls up · Slowing down · small & medium"
            },
            {
              "value": "nest_slowing_lg",
              "label": "Curls up · Slowing down · large"
            },
            {
              "value": "nest_diagnosed",
              "label": "Curls up · Diagnosed"
            },
            {
              "value": "bolster_fine",
              "label": "Leans · No concerns"
            },
            {
              "value": "bolster_slowing",
              "label": "Leans · Slowing down"
