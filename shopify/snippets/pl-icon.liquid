{%- comment -%}
  PawLunova icon set. Inlined per use rather than a <symbol> sprite so that
  every pl-section stays self-contained — no shared IDs to collide or go missing
  when a merchant reorders or removes a section.

  Usage: {% render 'pl-icon', icon: 'arrow', class: 'btn__arrow', size: 18 %}
{%- endcomment -%}
{%- liquid
  assign cls = class | default: ''
  if size != blank
    assign dims = 'width="' | append: size | append: '" height="' | append: size | append: '"'
  else
    assign dims = ''
  endif
-%}
{%- case icon -%}
  {%- when 'star' -%}
    <svg class="pl-i {{ cls }}" {{ dims }} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2l2.9 6.2 6.6.9-4.8 4.7 1.2 6.7L12 17.3 6.1 20.5l1.2-6.7L2.5 9.1l6.6-.9z"/></svg>
  {%- when 'arrow' -%}
    <svg class="pl-i {{ cls }}" {{ dims }} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h13M13 6l6 6-6 6"/></svg>
  {%- when 'shield' -%}
    <svg class="pl-i {{ cls }}" {{ dims }} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
  {%- when 'medal' -%}
    <svg class="pl-i {{ cls }}" {{ dims }} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="9" r="5.5"/><path d="M8.5 13.5L7 21l5-2.5L17 21l-1.5-7.5"/></svg>
  {%- when 'pin' -%}
    <svg class="pl-i {{ cls }}" {{ dims }} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 21s7-5.7 7-11a7 7 0 10-14 0c0 5.3 7 11 7 11z"/><circle cx="12" cy="10" r="2.6"/></svg>
  {%- when 'truck' -%}
    <svg class="pl-i {{ cls }}" {{ dims }} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2 7h11v9H2zM13 10h4.5l3 3.2V16H13z"/><circle cx="6.5" cy="18" r="1.9"/><circle cx="17.5" cy="18" r="1.9"/></svg>
  {%- when 'check' -%}
    <svg class="pl-i {{ cls }}" {{ dims }} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12.5l5 5L20 6.5"/></svg>
  {%- when 'cross' -%}
    <svg class="pl-i {{ cls }}" {{ dims }} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg>
  {%- when 'leaf' -%}
    <svg class="pl-i {{ cls }}" {{ dims }} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 4C10 4 4 9 4 16c0 2 .6 3.4.6 3.4S9 12 19 9c0 0-6.5 2.6-9.5 8.5 0 0 8.5 2 10.5-13z"/></svg>
  {%- when 'drop' -%}
    <svg class="pl-i {{ cls }}" {{ dims }} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3s6 6.5 6 10.5A6 6 0 016 13.5C6 9.5 12 3 12 3z"/></svg>
  {%- when 'curl' -%}
    <svg class="opt__icon {{ cls }}" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path d="M5 33c0-7.7 8.5-13 19-13s19 5.3 19 13"/><path d="M5 33c0 3.9 8.5 6.5 19 6.5S43 36.9 43 33"/><path d="M32 30a7.5 7.5 0 10-10.4 6.9"/><circle cx="19.5" cy="35.5" r="2.4"/></svg>
  {%- when 'lean' -%}
    <svg class="opt__icon {{ cls }}" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path d="M4 26.5a5 5 0 0110 0V38H4z"/><path d="M14 38V31a3.5 3.5 0 013.5-3.5h23A3.5 3.5 0 0144 31v7z"/><path d="M18 27.5c3.5-4 8-6 13-6"/><circle cx="16.5" cy="21.5" r="3.5"/></svg>
  {%- when 'flat' -%}
    <svg class="opt__icon {{ cls }}" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><rect x="4" y="28" width="40" height="11" rx="5"/><path d="M9 28c1.5-5 6-8 12-8 5 0 7 2 11 2 3.5 0 5.5-1.5 7-3.5"/><circle cx="38.5" cy="15" r="3.2"/></svg>
{%- endcase -%}
