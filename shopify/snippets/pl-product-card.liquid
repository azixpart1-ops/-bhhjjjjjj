{%- comment -%}
  The product card. One implementation, used by the collection grid, the
  homepage lineup, related products and search, so a fix to the card is a fix
  everywhere rather than three near-identical blocks drifting apart.

  Required
    product   a product object

  Optional
    index     1-based position, drives the reveal stagger (--i)
    heading   'h2' or 'h3'. Defaults to h3; the collection grid passes h2.
    role      overrides the corner badge. Otherwise: sold out, then saving,
              then the product type if show_type is on.
    show_type show the product type as the badge when there is nothing else
    desc      overrides the description line
    show_desc show the size / option line. Off unless asked for.
    stars     a rating out of 5. Draws the star row when set.
    facets    emit the data-* attributes the collection filters read
    lazy      lazy-load the image. Pass false for the first screenful.
    attrs     block.shopify_attributes, for theme editor selection
{%- endcomment -%}
{%- liquid
  assign p = product
  assign lvl = heading | default: 'h3'
  assign is_lazy = true
  if lazy == false
    assign is_lazy = false
  endif

  comment
    Coerce the optional arguments to strings up front. An argument the caller
    left off is nil, and "nil != blank" is the kind of comparison that quietly
    means different things in different Liquid implementations, so nothing
    below is allowed to depend on it.
  endcomment
  assign badge = role | default: '' | strip
  assign star = stars | default: '' | strip
  assign body_desc = desc | default: '' | strip

  comment
    The size option is the one customers scan a card for. Finding it by name
    rather than taking whichever option happens to be first keeps a
    colour-first bed from advertising "green - gray - bronze" as its sizes.
  endcomment
  assign sizes = ''
  assign size_label = ''
  for opt in p.options_with_values
    assign nm = opt.name | downcase
    if nm contains 'size'
      assign sizes = opt.values | join: ',' | downcase
      assign size_label = opt.values | join: ' · '
    endif
  endfor

  comment
    The material is what shoppers use to judge whether a bed is the premium
    one before they click, so it belongs on the card. It comes from the
    owner's own data: the custom.material metafield first, otherwise the
    first material word already present in the product's tags or type. Only
    words the catalogue actually uses are listed, and each is shown as
    written rather than dressed up, so the card cannot claim a fabric the
    product does not have.
  endcomment
  assign material = p.metafields.custom.material.value | default: '' | strip
  if material == ''
    assign mat_hay = p.tags | join: ',' | append: ',' | append: p.type | append: ',' | append: p.title | downcase
    assign known = 'corduroy,memory foam,boucle,velvet,sherpa,felt,fleece,plush,rattan,wicker,quilted,corduroy'  | split: ','
    for word in known
      if material == '' and mat_hay contains word
        assign material = word | capitalize
      endif
    endfor
  endif

  assign band = 'under-75'
  if p.price_min >= 7500 and p.price_min < 12500
    assign band = '75-125'
  elsif p.price_min >= 12500
    assign band = 'over-125'
  endif
-%}
<a class="pl-card reveal"{% if index %} style="--i:{{ index }}"{% endif %} href="{{ p.url }}"
   {%- if facets %} data-price-band="{{ band }}"
   data-material="{{ material | downcase | escape }}"
   data-sizes="{{ sizes | escape }}"
   data-type="{{ p.type | downcase | escape }}"
   data-tags="{{ p.tags | join: ',' | downcase | escape }}"
   data-title="{{ p.title | downcase | escape }}"
   data-available="{{ p.available }}"{% endif %} {{ attrs }}>
  <div class="pl-card__media">
    {%- if p.featured_image -%}
      <img src="{{ p.featured_image | image_url: width: 560 }}"
           srcset="{{ p.featured_image | image_url: width: 400 }} 400w, {{ p.featured_image | image_url: width: 760 }} 760w"
           sizes="(min-width: 1100px) 25vw, (min-width: 760px) 33vw, 45vw"
           alt="{{ p.featured_image.alt | escape | default: p.title | escape }}"
           width="560" height="560"
           {% if is_lazy %}loading="lazy"{% endif %} decoding="async">
    {%- endif -%}
    {%- liquid
      comment
        Low-stock badge on the card, from real inventory: sum the units of the
        available, Shopify-tracked variants. It only shows a scarcity flag on
        a product Shopify is genuinely counting down, and it never overrides a
        sold-out or a saving, which the customer needs to see first.
      endcomment
      assign low_flag = ''
      assign floor_units = low_stock | default: 0 | plus: 0
      if floor_units > 0 and p.available
        assign units = 0
        assign is_tracked = false
        for var in p.variants
          if var.inventory_management == 'shopify' and var.available
            assign is_tracked = true
            if var.inventory_quantity > 0
              assign units = units | plus: var.inventory_quantity
            endif
          endif
        endfor
        if is_tracked and units > 0 and units <= floor_units
          assign low_flag = 'Low stock'
        endif
      endif

      if badge == ''
        unless p.available
          assign badge = 'Sold out'
        else
          if p.compare_at_price_min > p.price_min
            assign saving = p.compare_at_price_min | minus: p.price_min | money
            assign badge = 'Save ' | append: saving
          elsif low_flag != ''
            assign badge = low_flag
          elsif show_type and p.type != blank
            assign badge = p.type
          endif
        endunless
      endif
    -%}
    {%- assign badge_class = 'pl-card__role' -%}
    {%- if badge == 'Low stock' -%}{%- assign badge_class = 'pl-card__role pl-card__role--low' -%}{%- endif -%}
    {%- unless badge == '' -%}<span class="{{ badge_class }}">{{ badge }}</span>{%- endunless -%}
  </div>
  <div class="pl-card__body">
    {%- comment -%}
      Two different things, deliberately kept apart. `rating` draws this
      product's own review score off its metafields and prints nothing when
      the product has none. `stars` is the older row a caller can hard-set,
      still used by the homepage lineup for the site-wide score.
    {%- endcomment -%}
    {%- if show_rating -%}
      {%- comment -%}
        A product with its own verified score shows it. A product without one
        falls back to the shop-wide figure, clearly labelled as the shop's
        rating rather than this bed's, so every card carries stars without any
        card claiming reviews it has not had.
      {%- endcomment -%}
      {%- liquid
        assign own_r = p.metafields.reviews.rating.value.rating | default: 0 | plus: 0.0
        assign own_n = p.metafields.reviews.rating_count.value | default: 0 | plus: 0
        assign floor = rating_min | default: 1 | plus: 0
        assign fb = fallback_rating | default: '' | strip
      -%}
      {%- if own_r > 0 and own_n >= floor -%}
        {% render 'pl-rating', product: p, min_count: rating_min, show_count: rating_show_count %}
      {%- elsif fb != '' -%}
        {% render 'pl-rating', product: p, rating: fb, count: 1, min_count: 1, label: fallback_label %}
      {%- endif -%}
    {%- elsif star != '' -%}
      <span class="pl-stars" aria-label="Rated {{ star }} out of 5">
        {% for i in (1..5) %}{% render 'pl-icon', icon: 'star' %}{% endfor %}
      </span>
    {%- endif -%}
    {%- if show_material and material != '' -%}
      <p class="pl-card__material">{{ material }}</p>
    {%- endif -%}
    <{{ lvl }} class="pl-card__name">{{ title | default: p.title }}</{{ lvl }}>
    {%- unless body_desc == '' -%}
      <p class="pl-card__desc">{{ body_desc }}</p>
    {%- endunless -%}
    {%- if body_desc == '' and show_desc -%}
      {%- if size_label != blank -%}
        <p class="pl-card__desc"><span class="pl-card__key">Sizes</span> {{ size_label }}</p>
      {%- elsif p.has_only_default_variant -%}
        <p class="pl-card__desc"><span class="pl-card__key">One size</span></p>
      {%- else -%}
        <p class="pl-card__desc"><span class="pl-card__key">{{ p.options_with_values.first.name }}</span> {{ p.options_with_values.first.values | join: ' · ' }}</p>
      {%- endif -%}
    {%- endif -%}
    <div class="pl-card__foot">
      <span class="pl-card__price">
        {%- if p.price_varies -%}<small>From</small> {% endif %}{{ p.price_min | money }}
      </span>
      <span class="pl-card__buy">View {% render 'pl-icon', icon: 'arrow', class: 'btn__arrow', size: 14 %}</span>
    </div>
  </div>
</a>
