{%- comment -%}
  Shared stylesheet and script for the PawLunova homepage sections.
  Rendered by every pl-* section so any section works on its own and survives
  being reordered or removed. The browser fetches each URL once, and pl-app.js
  guards against running twice.
{%- endcomment -%}
{{ 'pl-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pl-app.js' | asset_url }}" defer></script>
