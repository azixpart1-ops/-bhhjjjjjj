{%- comment -%}
  Shared stylesheet and script for the PawLunova sections.
  Rendered by every pl-* section so any section works on its own and survives
  being reordered or removed. The browser fetches each URL once, and pl-app.js
  guards against running twice.

  pl-pdp-plus.css is loaded here rather than only from the product page: the
  instalment line it styles also renders on collection cards, the homepage
  lineup and search results, and a card carrying unstyled markup on those
  pages is worse than the extra request.
{%- endcomment -%}
{{ 'pl-styles.css' | asset_url | stylesheet_tag }}
{{ 'pl-pdp-plus.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pl-app.js' | asset_url }}" defer></script>
