{% assign c = block.settings %}

<style>
  .blocko-footer-title-{{ block.id }} {
    font-size: {{ c.font_size }}px;
    display: flex;
    align-items: center;
    line-height:1.2;
    justify-content: {% if c.alignment == 'center' %}center{% elsif c.alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
    font-weight: {{ c.font_weight }};
    font-style: {{ c.font_style }};
    color: {{ c.color }};
    
  }


  @media (max-width: 768px) {
    .blocko-footer-title-{{ block.id }} {
      {% if   c.use_font_mb == true%}
    font-size: {{c.font_size_mb }}px;
      {% else %}
    font-size: {{c.font_size | times:0.9 }}px;
        {% endif %}
    }
  }
</style>

<div class="blocko-footer-title blocko-footer-title-{{ block.id }}" {{ block.shopify_attributes }}>
    {{ c.text }}
</div>
{% schema %}
{
  "name": "Title",
  "tag": null,
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Enter text here"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "checkbox",
      "id": "use_font_mb",
      "label": "Use font size mobile",
      "info": "Use this when you want specify font size in mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "font_size_mb",
      "label": "Font size mobile",
      "min": 10,
      "max": 100,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ block.settings.use_font_mb == true}}"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "lighter",
          "label": "Lighter"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "normal"
    },
    {
      "type": "select",
      "id": "font_style",
      "label": "Font style",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "italic",
          "label": "Italic"
        }
      ],
      "default": "normal"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Title"
    }
  ]
}
{% endschema %}
