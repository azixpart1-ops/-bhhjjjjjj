{% assign c = block.settings %}
<a style="text-decoration: none;" href="{{ c.link | default: '#' }}"
   class="blocko-menu-item-{{ block.id }} blocko-footer-item" {{ block.shopify_attributes }}>
  <span class="blocko-item-text">{{ c.label }}</span>
</a>

{% schema %}
{
  "name": "Footer menu item",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Menu link"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Footer menu item"
    }
  ]
}
{% endschema %}
