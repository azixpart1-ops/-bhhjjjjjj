{%- doc -%}
  Shows "Recommended for Bella: Medium" when the shopper arrives from the Bed Finder with this bed as their match.
{%- enddoc -%}
{%- assign product = closest.product -%}
<span class="pl-chip pl-chip--accent pl-finder-chip" data-pl-finder-chip data-handle="{{ product.handle }}" {{ block.shopify_attributes }}></span>
{% schema %}
{
  "name": "Finder match chip",
  "tag": null,
  "settings": [
    { "type": "paragraph", "content": "Appears only for a shopper whose Bed Finder result was this bed, naming their dog and the recommended size." }
  ],
  "presets": [{ "name": "Finder match chip", "category": "PawLunova" }]
}
{% endschema %}
