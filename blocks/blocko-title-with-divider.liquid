{% assign c = block.settings %}

<style>
  .blocko-footer-title-{{ block.id }} {
    font-size: {{ c.font_size }}px;
    display: flex;
    align-items: center;
    line-height:1.2;
    font-weight: {{ c.font_weight }};
    font-style: {{ c.font_style }};
    color: {{ c.color }};
    width:100%;
    flex:1
  }
  .line-{{ block.id }} {
    width: 100%;
    border-top: {{block.settings.line_thickness}}px {{ block.settings.line_style }} {{ block.settings.line_color | default: '#000000' }};
    height: 0;
    display:block !important;
  }
  .title-text-{{ block.id }} {
  text-align: center;
  white-space: nowrap;
  padding: 0 64px;
}


  @media (max-width: 768px) {
    .blocko-footer-title-{{ block.id }} {
      {% if   c.use_font_mb == true%}
    font-size: {{c.font_size_mb }}px;
      {% else %}
    font-size: {{c.font_size | times:0.9 }}px;
        {% endif %}

    }
    .title-text-{{ block.id }} {
  text-align: center;
  white-space: nowrap;
  padding: 0 14px;
}
  }
</style>

<div class="blocko-footer-title blocko-footer-title-{{ block.id }}" {{ block.shopify_attributes }}>
      <div class="line-{{ block.id }}"></div>
      <div class="title-text-{{ block.id }}">{{ c.text }}</div>
  <div class="line-{{ block.id }}"></div>

</div>
{% schema %}
{
  "name": "Title",
  "tag": null,
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Enter text here"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 100,
      "unit": "px",
      "default": 32
    },
    {
      "type": "checkbox",
      "id": "use_font_mb",
      "label": "Use font size mobile",
      "info": "Use this when you want specify font size in mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "font_size_mb",
      "label": "Font size mobile",
      "min": 10,
      "max": 100,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.use_font_mb == true}}"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "lighter",
          "label": "Lighter"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "normal"
    },
    {
      "type": "select",
      "id": "font_style",
      "label": "Font style",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "italic",
          "label": "Italic"
        }
      ],
      "default": "normal"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Line"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Line color",
      "default": "#e0e0e0"
    },
    {
      "type": "range",
      "id": "line_thickness",
      "label": "Thickness px",
      "min": 1,
      "max": 10,
      "default": 1,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "line_style",
      "label": "Line style",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        }
      ],
      "default": "solid"
    }
  ],
  "presets": [
    {
      "name": "Title"
    }
  ]
}
{% endschema %}
