{% assign c = block.settings %}

<style>
  .blocko-icon-group-{{ block.id }} {
    display: flex;
    flex-wrap: wrap;
    justify-content:{{ c.layout_alignment }};
    gap: {{ c.gap }}px;
  }
  @media (max-width: 768px) {
    .blocko-icon-group-{{ block.id }} {
      max-width: 100%;
      width: 100%;
      gap: {{ c.gap | times:0.5 }}px;
      grid-column: 12;
    justify-content:{{ c.layout_alignment_mb }};

    }
  }
</style>

<div class="blocko-icon-group blocko-icon-group-{{ block.id }}" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Icon group",
  "tag": null,
  "blocks": [
    {
      "type": "blocko-footer-icon-link"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_alignment",
      "label": "Align items",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "layout_alignment_mb",
      "label": "Align items mobile",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Icon group",
      "blocks": [
        {
          "type": "blocko-footer-icon-link"
        },
        {
          "type": "blocko-footer-icon-link"
        },
        {
          "type": "blocko-footer-icon-link"
        }
      ]
    }
  ]
}
{% endschema %}
