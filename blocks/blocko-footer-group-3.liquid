{% assign c = block.settings %}

<style>
  .blocko-footer-group-{{ block.id }} {
    display: flex;
    flex-direction: {{ c.layout_display }};
    gap: {{ c.gap }}px;
    flex-wrap: wrap;
    background-color: {{ c.bg_color }};
    padding: {{ c.vertical_padding }}px {{ c.horizontal_padding }}px;
    flex: 1;
    width: 100%;
  }

  @media (max-width: 768px) {
    .blocko-footer-group-{{ block.id }} {
      gap: {{ c.gap | times:0.8 }}px;
      flex-direction: column;
      align-items: {{ c.layout_alignment }};
      justify-content: {{ c.vertical_alignment }};
      padding: {{ c.vertical_padding_mb }}px {{ c.horizontal_padding_mb }}px;
    }
  }
</style>

<div class="blocko-footer-group blocko-footer-group-{{ block.id }}" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Footer Group",
  "tag": null,
  "blocks": [
    {
      "type": "blocko-footer-group-3"
    },
    {
      "type": "blocko-footer-title"
    },
    {
      "type": "blocko-icon-group"
    },
    {
      "type": "blocko-footer-menu-group"
    },
    {
      "type": "blocko-footer-cta-download"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_display",
      "label": "Display",
      "options": [
        {
          "value": "row",
          "label": "Horizontal"
        },
        {
          "value": "column",
          "label": "Vertical"
        }
      ],
      "default": "column"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 12
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "horizontal_padding",
      "label": "Horizontal padding",
      "min": 0,
      "max": 400,
      "step": 10,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 400,
      "step": 10,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "horizontal_padding_mb",
      "label": "Horizontal padding mobile",
      "min": 0,
      "max": 400,
      "step": 10,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "vertical_padding_mb",
      "label": "Vertical padding mobile",
      "min": 0,
      "max": 400,
      "step": 10,
      "default": 0,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Footer group"
    }
  ]
}
{% endschema %}
