{% assign c = block.settings %}

<style>
  .blocko-footer-icon-link-{{ block.id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.3s ease;
    color: {{ c.icon_color }};
  }

  .blocko-footer-icon-link-{{ block.id }}:hover {
    opacity: 0.7;
    transform: translateY(-2px);
  }

  .blocko-footer-icon-link-{{ block.id }} svg,
  .blocko-footer-icon-link-{{ block.id }} img {
    width: {{ c.icon_size }}px;
    height: {{ c.icon_size }}px;
    display: block;
    object-fit: contain;
  }

  .blocko-footer-icon-link-{{ block.id }} svg {
    fill: currentColor;
  }
  @media (max-width: 768px) {
     .blocko-footer-icon-link-{{ block.id }} svg,
  .blocko-footer-icon-link-{{ block.id }} img {
    width: {{ c.icon_size |times: 0.9}}px;
    height: {{ c.icon_size |times: 0.9}}px;
    display: block;
    object-fit: contain;
  }
  }
</style>

<a
  href="{{ c.link | default: '#' }}"
  class="blocko-footer-icon-link-{{ block.id }}"
  target="_blank"
  {{ block.shopify_attributes }}
>
  {%- if c.use_custom_icon and c.custom_icon_image != blank -%}
    <img
      src="{{ c.custom_icon_image | image_url: width: 100 }}"
      alt="{{ c.custom_icon_image.alt | escape }}"
      loading="lazy"
    >
  {%- else -%}
    {%- case c.icon_select -%}
      {%- when 'facebook' -%}
        <svg width="23" height="23" viewBox="0 0 23 23" fill="none" xmlns="http://www.w3.org/2000/svg">
