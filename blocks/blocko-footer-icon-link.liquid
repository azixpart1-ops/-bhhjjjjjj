      {%- when 'pinterest' -%}
        <svg viewBox="0 0 24 24">
          <path d="M12 0c-6.627 0-12 5.372-12 12 0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345-.091.375-.293 1.199-.334 1.363-.053.215-.174.26-.401.154-1.495-.697-2.43-2.886-2.43-4.643 0-3.78 2.746-7.252 7.92-7.252 4.158 0 7.392 2.963 7.392 6.923 0 4.131-2.607 7.456-6.224 7.456-1.215 0-2.356-.63-2.746-1.377l-.747 2.848c-.27 1.029-1.001 2.321-1.488 3.117 1.125.347 2.32.535 3.56.535 6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/>
        </svg>
    {%- endcase -%}
  {%- endif -%}
</a>

{% schema %}
{
  "name": "Footer icon link",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_custom_icon",
      "label": "Use custom",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "custom_icon_image",
      "label": "Upload icon",
      "info": "PNG or SVG recommended",
      "visible_if": "{{ block.settings.use_custom_icon }}"
    },
    {
      "type": "select",
      "id": "icon_select",
      "label": "Select icon",
      "options": [
        { "value": "facebook", "label": "Facebook" },
        { "value": "instagram", "label": "Instagram" },
        { "value": "x", "label": "X (Twitter)" },
        { "value": "tiktok", "label": "TikTok" },
        { "value": "youtube", "label": "YouTube" },
        { "value": "pinterest", "label": "Pinterest" },
        { "value": "linkedin", "label": "LinkedIn" }
      ],
      "default": "facebook",
      "visible_if": "{{ block.settings.use_custom_icon == false}}"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Color",
      "default": "#1A1A1A",
      "visible_if": "{{ block.settings.use_custom_icon == false }}"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Size",
      "min": 10,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link URL"
    }
  ],
  "presets": [
    {
      "name": "Footer icon link"
    }
  ]
}
{% endschema %}
