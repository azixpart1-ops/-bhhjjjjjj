{% assign c = block.settings %}

<div class="blocko-footer-menu-{{ block.id }} blocko-footer-menu" {{ block.shopify_attributes }}>
  {% if c.title != blank %}
    <span class="blocko-menu-title js-accordion-header">
      {{ c.title }}
      <span class="accordion-icon" onclick="toggleMobileMenu('{{ block.id }}')">
        <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
      </span>
    </span>
  {% endif %}
  
  <div class="blocko-menu-content js-accordion-content">
    {% content_for 'blocks' %}
  </div>
</div>
  <script>
  if (typeof toggleMobileMenu !== 'function') {
    function toggleMobileMenu(blockId) {
      if (window.innerWidth > 768) return;
      const el = document.querySelector('.blocko-footer-menu-' + blockId);
      if (el) {
        el.classList.toggle('is-active');
      }
    }
  }
</script>

{% schema %}
{
  "name": "Footer menu",
  "tag":null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Menu title",
      "default": "Quick links"
    }
  ],
  "blocks": [
    {
      "type": "blocko-footer-menu-item"
    }
  ],
  "presets": [
    {
      "name": "Footer menu"
    }
  ]
}
{% endschema %}