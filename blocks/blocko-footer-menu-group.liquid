{% assign c = block.settings %}
{% comment %} Menu group {% endcomment %}
<style>
  .blocko-footer-menu-group-{{ block.id }} {
    display: flex;
    flex-direction: {{ c.layout_display }};
    gap: {{ c.gap }}px;
    flex-wrap: wrap;
    background-color: {{ c.bg_color }};
  {% if c.layout_display == 'row' %} justify-content: {{ c.layout_alignment }};
    align-items: {{ c.vertical_alignment }};
  {% else%} align-items: {{ c.layout_alignment }};
    justify-content: {{ c.vertical_alignment }};
  {% endif %} padding: {{ c.vertical_padding }}px {{ c.horizontal_padding }}px;
    flex: 1;
    box-sizing: border-box;
    width: 100%;
  }

  @media (max-width: 768px) {
    .blocko-footer-menu-group-{{ block.id }} {
      gap: {{ c.gap | times:0.8 }}px;
      flex-direction: column;
      align-items: {{ c.layout_alignment }};
      justify-content: {{ c.vertical_alignment }};
      padding: {{ c.vertical_padding_mb }}px {{ c.horizontal_padding_mb }}px;
    }
  }

</style>
{% comment %} Menu {% endcomment %}
<style>
  .blocko-footer-menu-group-{{ block.id }} .blocko-footer-menu {
    display: flex;
    flex-direction: column;
    align-items:{{ c.align_item }};
    flex:1;
    width:100%;
  }

  .blocko-footer-menu-group-{{ block.id }} .blocko-menu-title {
    font-size: {{ c.title_size }}px;
    font-weight: {{ c.title_weight }};
    color: {{ c.title_color }};
    margin-bottom: {{ c.title_margin }}px;
    display: flex;
    flex-direction: column;
    align-items:{{ c.align_item }};

  }

  .blocko-footer-menu-group-{{ block.id }} .blocko-menu-content{
    display: flex;
    flex-direction: column;
    align-items:{{ c.align_item }};
    gap: {{ c.item_gap }}px;
  }
  .blocko-footer-menu-group-{{ block.id }}  .accordion-icon {
    opacity:0.6;
    display: none;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  @media (max-width: 768px) {
    .blocko-footer-menu-group-{{ block.id }} .blocko-footer-menu {
        padding: {{ c.vertical_padding |times:0.5}}px {{ c.horizontal_padding |times:0.5}}px;
    }

    .blocko-footer-menu-group-{{ block.id }} .blocko-menu-content{
        gap: {{ c.item_gap | times:0.8}}px;
    }
    .blocko-footer-menu-group-{{ block.id }} .blocko-menu-title {
    font-size: {{ c.title_size |times:0.9}}px;
    }
  }


@media (max-width: 768px) {
  .blocko-footer-menu-group-{{ block.id }} .blocko-menu-title {
    cursor: pointer;
    display: flex !important;
    flex-direction: row !important;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    z-index: 2;
  }

  .blocko-footer-menu-group-{{ block.id }}  .accordion-icon { display: flex; }

  .blocko-footer-menu-group-{{ block.id }} .blocko-menu-content {
    display: flex;
    height: 0;
    overflow: hidden;
    transition: height 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.4s ease,
                padding 0.4s ease;
    opacity: 0;
    padding-top: 0;
    padding-bottom: 0;
  }

  .blocko-footer-menu.is-active .blocko-menu-content {
    height: auto;
    opacity: 1;
    padding-top: 2px;
    padding-bottom: 2px;
  }

  .blocko-footer-menu.is-active .accordion-icon {
    transform: rotate(180deg);
  }
}

</style>

<style>
  .blocko-footer-menu-group-{{ block.id }} .blocko-menu-item {
    display: flex;
    align-items: center;
    text-decoration: none;
    padding: {{ c.padding_v }}px 0;
  }

  .blocko-footer-menu-group-{{ block.id }} .blocko-item-text {
    font-size: {{ c.font_size }}px;
    color: {{ c.color }};
    font-weight: {{ c.font_weight }};
    transition: all 0.3s ease;
  }

  .blocko-footer-menu-group-{{ block.id }} .blocko-item-text:hover {
    color: {{ c.hover_color }} !important;
  }


   @media (max-width: 768px) {
    .blocko-footer-menu-group-{{ block.id }} .blocko-item-text {
    font-size: {{ c.font_size |times:0.9}}px;
    }
  }
</style>


<div class="blocko-footer-menu-group blocko-footer-menu-group-{{ block.id }}" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Footer menu group",
  "tag": null,
  "blocks": [
    {
      "type": "blocko-footer-menu"
    }
