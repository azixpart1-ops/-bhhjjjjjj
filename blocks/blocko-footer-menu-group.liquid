        },
        {
          "value": "lighter",
          "label": "Lighter"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "title_margin",
      "label": "Title margin bottom",
      "min": 0,
      "max": 40,
      "default": 15,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Gap",
      "min": 0,
      "max": 30,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Menu items"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "hover_color",
