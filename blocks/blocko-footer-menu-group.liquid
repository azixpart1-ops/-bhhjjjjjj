      "unit": "px"
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 400,
      "step": 10,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "horizontal_padding_mb",
      "label": "Horizontal padding mobile",
      "min": 0,
      "max": 400,
      "step": 10,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "vertical_padding_mb",
      "label": "Vertical padding mobile",
      "min": 0,
      "max": 400,
      "step": 10,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Menu"
    },
    {
      "type": "select",
      "id": "align_item",
      "label": "Align items",
      "default": "flex-start",
