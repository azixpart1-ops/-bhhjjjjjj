      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "lighter",
          "label": "Lighter"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "normal"
    }
  ],
  "presets": [
    {
      "name": "Footer menu group"
    }
  ]
