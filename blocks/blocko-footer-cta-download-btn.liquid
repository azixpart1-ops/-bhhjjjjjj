{% assign c = block.settings %}
{% assign shop_path = "https://cdn.shopify.com/s/files/1/0738/9465/8234/files/" %}
{% assign icon_url = shop_path | append: c.cta-type %}
<style>
  .blocko-footer-icon-link-{{ block.id }} {
    display: flex;
    align-items: center;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .blocko-footer-icon-link-{{ block.id }}:hover {
    opacity: 0.8;
  }

  .blocko-footer-icon-link-{{ block.id }} .blocko-footer-icon {
    display: inline-block;
    width: {{ c.icon_size }}px;
    height: auto;
    object-fit: contain;
    flex-shrink: 0;
  }
</style>


<a href="{{ c.link | default: '#' }}"
   class="blocko-footer-icon-link blocko-footer-icon-link-{{ block.id }}"
   {{ block.shopify_attributes }}>
    <img
      src="{{ icon_url }}"
      alt="{{ c.icon_image.alt | escape }}"
      loading="lazy"
      class="blocko-footer-icon"
      width="{{ c.icon_size }}"
      height="{{ c.icon_size }}"
    >
</a>
{% schema %}
{
  "name": "Footer icon link",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "cta-type",
      "label": "Type",
      "options": [
        {
          "value": "Frame_18.svg",
          "label": "Google play"
        },
        {
          "value": "Frame_17.svg",
          "label": "Apple store"
        }
      ],
      "default": "Frame_18.svg"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Size",
      "min": 10,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 150
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link URL"
    }
  ],
  "presets": [
    {
      "name": "Footer icon link"
    }
  ]
}
{% endschema %}
